= \"--tap-target\" && i+1 < len(args):\n89\t\t\t\ti++\n90\t\t\t\ttapTarget = args[i]\n91\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n92\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n93\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n94\t\t\t\ti++\n95\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n96\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n97\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n98\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n99\t\t\t\ti++\n100\t\t\t\ttapOutputDir = args[i]\n101\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n102\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n103\t\t\tcase arg == \"--tap-verbose\":\n104\t\t\t\ttapVerbose = true\n105\t\t\tcase arg == \"--\", arg == \"--claude\":\n106\t\t\t\t// Everything after -- (or --claude) goes to claude.\n107\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n108\t\t\t\ti = len(args) // stop parsing\n109\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n110\t\t\t\t// Unknown tap flag, skip.\n111\t\t\tdefault:\n112\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n113\t\t\t}\n114\t\t}\n115\t\n116\t\tif tapOutputDir == \"\" {\n117\t\t\ttapOutputDir = trace.DefaultTraceDir()\n118\t\t}\n119\t\n120\t\t// Detect upstream target.\n121\t\ttarget := tapTarget\n122\t\tif target == \"\" {\n123\t\t\ttarget = config.DetectTarget(&config.ClaudeClient)\n124\t\t}\n125\t\tif tapVerbose {\n126\t\t\tlog.Printf(\"upstream target: %s\", target)\n127\t\t}\n128\t\n129\t\t// Setup trace writer.\n130\t\ttracePath := trace.NewTracePath(tapOutputDir)\n131\t\twriter, err := trace.NewTraceWriter(tracePath)\n132\t\tif err != nil {\n133\t\t\tlog.Fatalf(\"create trace writer: %v\", err)\n134\t\t}\n135\t\tdefer writer.Close()\n136\t\n137\t\tif tapVerbose {\n138\t\t\tlog.Printf(\"trace file: %s\", tracePath)\n139\t\t}\n140\t\n141\t\t// Start reverse proxy.\n142\t\trp := proxy.NewReverseProxy(target, writer)\n143\t\tport := tapPort\n144\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n145\t\tif err != nil {\n146\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n147\t\t}\n148\t\tdefer rp.Stop()\n149\t\n150\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n151\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n152\t\n153\t\t// Resolve claude binary.\n154\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n155\t\tif err != nil {\n156\t\t\tlog.Fatal(err)\n157\t\t}\n158\t\n159\t\t// Build child environment.\n160\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n161\t\n162\t\t// Inject --settings for clients that need it (e.g. Claude Code).\n163\t\tfinalArgs := claudeArgs\n164\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n165\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n166\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n167\t\t}\n168\t\n169\t\t// Launch claude as child process.\n170\t\tcmd := exec.Command(claudePath, finalArgs...)\n171\t\tcmd.Env = childEnv\n172\t\tcmd.Stdin = os.Stdin\n173\t\tcmd.Stdout = os.Stdout\n174\t\tcmd.Stderr = os.Stderr\n175\t\n176\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n177\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n178\t\n179\t\tif err := cmd.Start(); err != nil {\n180\t\t\tlog.Fatalf(\"start claude: %v\", err)\n181\t\t}\n182\t\n183\t\t// Handle signals: forward to child process.\n184\t\tsigChan := make(chan os.Signal, 2)\n185\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n186\t\n187\t\tgo func() {\n188\t\t\tsigCount := 0\n189\t\t\tfor sig := range sigChan {\n190\t\t\t\tsigCount++\n191\t\t\t\tif sigCount == 1 {\n192\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n193\t\t\t\t\t_ = cmd.Process.Signal(sig)\n194\t\t\t\t} else {\n195\t\t\t\t\t_ = cmd.Process.Kill()\n196\t\t\t\t}\n197\t\t\t}\n198\t\t}()\n199\t\n200\t\t// Wait for child to exit.\n201\t\twaitErr := cmd.Wait()\n202\t\n203\t\t// Stop signal handler.\n204\t\tsignal.Stop(sigChan)\n205\t\tclose(sigChan)\n206\t\n207\t\t// Print summary.\n208\t\tsummary := writer.Summary()\n209\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n210\t\tif waitErr != nil {\n211\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n212\t\t}\n213\t\tfmt.Printf(\"\\n\")\n214\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n215\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n216\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n217\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n218\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n219\t\tfmt.Printf(\"   Trace: %s\\n\", tracePath)\n220\t}\n221\t\n222\tfunc runSessionPush(args []string) {\n223\t\tvar opts session.PushOptions\n224\t\tfor i := 0; i < len(args); i++ {\n225\t\t\targ := args[i]\n226\t\t\tswitch {\n227\t\t\tcase arg == \"--all\":\n228\t\t\t\topts.All = true\n229\t\t\tcase arg == \"--force\":\n230\t\t\t\topts.Force = true\n231\t\t\tcase arg == \"--dry-run\":\n232\t\t\t\topts.DryRun = true\n233\t\t\tcase arg == \"--project\" && i+1 < len(args):\n234\t\t\t\ti++\n235\t\t\t\topts.Project = args[i]\n236\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n237\t\t\t\topts.Project = arg[len(\"--project=\"):]\n238\t\t\t}\n239\t\t}\n240\t\n241\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n242\t\tresults, err := session.SessionPush(opts)\n243\t\tif err != nil {\n244\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n245\t\t\tos.Exit(1)\n246\t\t}\n247\t\n248\t\tfmt.Println()\n249\t\ttotalNew, totalSkipped := 0, 0\n250\t\tfor _, r := range results {\n251\t\t\ttotalNew += r.SessionsNew\n252\t\t\ttotalSkipped += r.SessionsSkipped\n253\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n254\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n255\t\t\t}\n256\t\t}\n257\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n258\t}\n259\t\n260\tfunc runSessionPull(args []string) {\n261\t\tvar opts session.PullOptions\n262\t\tfor i := 0; i < len(args); i++ {\n263\t\t\targ := args[i]\n264\t\t\tswitch {\n265\t\t\tcase arg == \"--all\":\n266\t\t\t\topts.All = true\n267\t\t\tcase arg == \"--dry-run\":\n268\t\t\t\topts.DryRun = true\n269\t\t\tcase arg == \"--project\" && i+1 < len(args):\n270\t\t\t\ti++\n271\t\t\t\topts.Project = args[i]\n272\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n273\t\t\t\topts.Project = arg[len(\"--project=\"):]\n274\t\t\t}\n275\t\t}\n276\t\n277\t\tfmt.Println(\"📤 Restoring sessions...\")\n278\t\tresults, err := session.SessionPull(opts)\n279\t\tif err != nil {\n280\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n281\t\t\tos.Exit(1)\n282\t\t}\n283\t\n284\t\tfmt.Println()\n285\t\ttotalRestored, totalSkipped := 0, 0\n286\t\tfor _, r := range results {\n287\t\t\ttotalRestored += r.SessionsRestored\n288\t\t\ttotalSkipped += r.SessionsSkipped\n289\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n290\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n291\t\t\t}\n292\t\t}\n293\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n294\t}\n295\t\n296\tfunc runSessionStatus(args []string) {\n297\t\tvar opts session.StatusOptions\n298\t\tfor i := 0; i < len(args); i++ {\n299\t\t\targ := args[i]\n300\t\t\tswitch {\n301\t\t\tcase arg == \"--verbose\":\n302\t\t\t\topts.Verbose = true\n303\t\t\t}\n304\t\t}\n305\t\n306\t\tif err := session.SessionStatus(opts); err != nil {\n307\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n308\t\t\tos.Exit(1)\n309\t\t}\n310\t}\n311\t\n312\tfunc formatArgs(args []string) string {\n313\t\tresult := \"\"\n314\t\tfor _, a := range args {\n315\t\t\tif containsSpace(a) {\n316\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n317\t\t\t} else {\n318\t\t\t\tresult += \" \" + a\n319\t\t\t}\n320\t\t}\n321\t\treturn strings.TrimSpace(result)\n322\t}\n323\t\n324\tfunc containsSpace(s string) bool {\n325\t\tfor _, c := range s {\n326\t\t\tif c == ' ' || c == '\\t' {\n327\t\t\t\treturn true\n328\t\t\t}\n329\t\t}\n330\t\treturn false\n331\t}\n332\t"}]}
