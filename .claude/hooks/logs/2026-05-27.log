laimed\" | jq -r '.[] | \"#\\(.number) [\\([.labels[].name] | join(\",\"))] \\(.title)\\n  状态: 未领取\\n  请回复 /003-4-issue-claim #\\(.number) 来领取\\n\"'\n    else\n      echo \"(暂无 open issues)\"\n    fi\n  else\n    echo \"gh CLI 不可用，请先安装 GitHub CLI\"\n    echo \"请指定 issue 编号，例如: /003-4-issue-claim #5\"\n  fi\nfi\n\nskill_log \"INFO\" \"[inject] issue-claim context injected for #$ISSUE_NUM\"\n","numLines":45,"startLine":1,"totalLines":45}},"tool_use_id":"call_71b5cf9f75a64d818553f9d1","duration_ms":4}
