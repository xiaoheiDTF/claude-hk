───────────────────────────────────────│\n134\t         │                │ pr    │                 │\n135\t         │                ▼       │                 │\n136\t         │           ┌────────────────────────────────────────────────────────────────│\n137\t         │           │pr-created│ │                 │\n138\t         │           └─────┬──────────────────────────────────────────────────────────│\n139\t         │                 │ test │                 │\n140\t         │                 ▼      │                 │\n141\t         │            ┌─────────── │                 │\n142\t         │            │ testing │ │                 │\n143\t         │            └────┬───────────────────────────────────────────────────────────│\n144\t         │                 │ review                   │\n145\t         │                 ▼      │                 │\n146\t         │           ┌────────────────────────────────────────────────────────────────│\n147\t         │           │ reviewing ├────────────────────────────────────────────────────────────────│\n148\t         │           └─────┬──────────────────────────────────────────────────────────│\n149\t         │                 │ merge                   │\n150\t         │                 ▼                         │\n151\t         │            ┌────────────────────────────────────────────────────────────────│\n152\t         │            │ merged  │────────────────────────────────────────────────────────────────│\n153\t         │            └────────────────────────────────────────────────────────────────│\n154\t         │\n155\t         └─ ──: rejected ──── SessionEnd ──── idle（可重新领取）\n156\t```\n157\t\n158\t---\n159\t\n160\t## 五、实现方案\n161\t"}]}
