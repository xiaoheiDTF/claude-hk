"$tmp\" \"$STATE_FILE\"\n47\t  else\n48\t    echo \"${key}=${val}\" >> \"$STATE_FILE\"\n49\t  fi\n50\t}\n51\t\n52\t_state_init() {\n53\t  mkdir -p \"$(dirname \"$STATE_FILE\")\"\n54\t  [ -f \"$STATE_FILE\" ] || cat > \"$STATE_FILE\" << 'EOF'\n55\tstatus=not_tried\n56\tpath=\n57\tattempts=0\n58\tlast_attempt=\n59\tversion=\n60\tEOF\n61\t}\n62\t\n63\t# ---- Python 路径解析 ----\n64\t_resolve_embed() {\n65\t  local os=$(_detect_os)\n66\t  case \"$os\" in\n67\t    windows) echo \"$LOCAL_LANG_DIR/python/python.exe\" ;;\n68\t    linux)   echo \"$LOCAL_LANG_DIR/python/bin/python3\" ;;\n69\t    macos)   echo \"$LOCAL_LANG_DIR/python/bin/python3\" ;;\n70\t  esac\n71\t}\n72\t\n73\t_resolve_python() {\n74\t  # 1. 嵌入版\n75\t  local embed=$(_resolve_embed)\n76\t  if [ -x \"$embed\" ]; then\n77\t    echo \"$embed\"\n78\t    return\n79\t  fi\n80\t  # 2. 系统 Python\n81\t  for cmd in python3 python; do\n82\t    if command -v \"$cmd\" &>/dev/null && \"$cmd\" -c \"pass\" 2>/dev/null; then\n83\t      echo \"$cmd\"\n84\t      return\n85\t    fi\n86\t  done\n87\t  echo \"\"\n88\t}\n89\t\n90\t# ---- 下载源配置 ----\n91\t_get_download_urls() {\n92\t  local os=$(_detect_os)\n93\t  case \"$os\" in\n94\t    windows)\n95\t      # Python 嵌入版（多镜像源）\n96\t      echo \"https://www.python.org/ftp/python/3.13.9/python-3.13.9-embed-amd64.zip\"\n97\t      echo \"https://registry.npmmirror.com/-/binary/python/3.13.9/python-3.13.9-embed-amd64.zip\"\n98\t      ;;\n99\t    linux)\n100\t      # python-build-standalone (x86_64)\n101\t      local ver=\"20250417\"\n102\t      local tag=\"cpython-3.13.3+${ver}-x86_64-unknown-linux-gnu-install_only.tar.gz\"\n103\t      echo \"https://github.com/indygreg/python-build-standalone/releases/download/${ver}/${tag}\"\n104\t      ;;\n105\t    macos)\n106\t      # python-build-standalone (arm64 + x86_64)\n107\t      local ver=\"20250417\"\n108\t      local arch=$(uname -m)\n109\t      local platform=\"aarch64-apple-darwin\"\n110\t      [ \"$arch\" = \"x86_64\" ] && platform=\"x86_64-apple-darwin\"\n111\t      local tag=\"cpython-3.13.3+${ver}-${platform}-install_only.tar.gz\"\n112\t      echo \"https://github.com/indygreg/python-build-standalone/releases/download/${ver}/${tag}\"\n113\t      ;;\n114\t  esac\n115\t}\n116\t\n117\t# ---- 下载并安装 ----\n118\t_download_python() {\n119\t  local python_dir=\"$LOCAL_LANG_DIR/python\"\n120\t  mkdir -p \"$python_dir\"\n121\t\n122\t  _state_set status \"downloading\"\n123\t  _state_set last_attempt \"$(date +%Y-%m-%dT%H:%M:%S)\"\n124\t\n125\t  local os=$(_detect_os)\n126\t  local urls\n127\t  urls=$(_get_download_urls)\n128\t\n129\t  while IFS= read -r url; do\n130\t    [ -z \"$url\" ] && continue\n131\t    local filename=$(basename \"$url\")\n132\t    local tmpfile=\"$python_dir/$filename\"\n133\t\n134\t    echo \"[ensure_python] 尝试下载: $url\"\n135\t\n136\t    if curl -L --connect-timeout 15 --max-time 300 -o \"$tmpfile\" \"$url\" 2>/dev/null; then\n137\t      # 验证下载文件不为空\n138\t      if [ -s \"$tmpfile\" ]; then\n139\t        echo \"[ensure_python] 下载成功，开始安装...\"\n140\t\n141\t        case \"$os\" in\n142\t          windows)\n143\t            cd \"$python_dir\" && unzip -o \"$filename\" 2>/dev/null && rm -f \"$filename\"\n144\t            # 修复 pip：移除 import 限制\n145\t            local pth_file=\"$python_dir/python313._pth\"\n146\t            [ -f \"$pth_file\" ] && echo \"import site\" >> \"$pth_file\"\n147\t            ;;\n148\t          linux|macos)\n149\t            cd \"$python_dir\" && tar xzf \"$filename\" --strip-components=1 2>/dev/null && rm -f \"$filename\"\n150\t            ;;\n151\t        esac\n152\t\n153\t        # 验证安装结果\n154\t        local embed=$(_resolve_embed)\n155\t        if [ -x \"$embed\" ]; then\n156\t          local ver=$(\"$embed\" --version 2>&1 | head -1)\n157\t          _state_set status \"ready\"\n158\t          _state_set path \"$embed\"\n159\t          _state_set version \"$ver\"\n160\t          echo \"[ensure_python] 安装成功: $embed ($ver)\"\n161\t          return 0\n162\t        else\n163\t          echo \"[ensure_python] 安装后验证失败\"\n164\t          rm -f \"$tmpfile\"\n165\t        fi\n166\t      else\n167\t        echo \"[ensure_python] 下载文件为空\"\n168\t        rm -f \"$tmpfile\"\n169\t      fi\n170\t    else\n171\t      echo \"[ensure_python] 下载失败: $url\"\n172\t      rm -f \"$tmpfile\"\n173\t    fi\n174\t  done <<< \"$urls\"\n175\t\n176\t  return 1\n177\t}\n178\t\n179\t# ---- 主入口 ----\n180\tensure_python() {\n181\t  _state_init\n182\t\n183\t  # 先尝试解析\n184\t  local found=$(_resolve_python)\n185\t  if [ -n \"$found\" ]; then\n186\t    # 更新状态（可能之前是系统 Python，不是嵌入版）\n187\t    [ \"$(_state_get status)\" != \"ready\" ] && {\n188\t      _state_set status \"ready\"\n189\t      _state_set path \"$found\"\n190\t      local ver=$(\"$found\" --version 2>&1 | head -1)\n191\t      _state_set version \"$ver\"\n192\t    }\n193\t    echo \"$found\"\n194\t    return 0\n195\t  fi\n196\t\n197\t  # 未找到 → 检查是否应该重试\n198\t  local status=$(_state_get status)\n199\t  local attempts=$(_state_get attempts)\n200\t  attempts=${attempts:-0}\n201\t\n202\t  case \"$status\" in\n203\t    ready)\n204\t      # 状态说是 ready 但实际找不到 → 重置\n205\t      _state_set status \"not_tried\"\n206\t      _state_set attempts \"0\"\n207\t      ;;\n208\t    failed_permanent)\n209\t      echo \"[ensure_python] 已达最大重试次数，请手动安装 Python\"\n210\t      echo \"\"\n211\t      return 1\n212\t      ;;\n213\t    downloading)\n214\t      # 可能上次中断了 → 允许重试\n215\t      ;;\n216\t  esac\n217\t\n218\t  # 超过最大次数\n219\t  if [ \"$attempts\" -ge \"$MAX_ATTEMPTS\" ]; then\n220\t    _state_set status \"failed_permanent\"\n221\t    echo \"[ensure_python] 已尝试 $attempts 次，停止重试\"\n222\t    echo \"[ensure_python] 请手动安装 Python 并重启 Claude Code\"\n223\t    echo \"\"\n224\t    return 1\n225\t  fi\n226\t\n227\t  # 尝试下载\n228\t  _state_set attempts \"$((attempts + 1))\"\n229\t  echo \"[ensure_python] Python 未找到，尝试自动下载 (第 $((attempts + 1))/$MAX_ATTEMPTS 次)...\"\n230\t\n231\t  if _download_python; then\n232\t    _resolve_python\n233\t    return 0\n234\t  else\n235\t    _state_set status \"failed\"\n236\t    echo \"[ensure_python] 本次下载失败，下次会话将重试\"\n237\t    echo \"\"\n238\t    return 1\n239\t  fi\n240\t}\n241\t"}]}
