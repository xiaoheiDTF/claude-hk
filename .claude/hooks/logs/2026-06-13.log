(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n898\t\t\tif s[10] != \"idle\" {\n899\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n900\t\t\t}\n901\t\t})\n902\t\n903\t\tt.Run(\"full_lifecycle_to_testing\", func(t *testing.T) {\n904\t\t\te := setup(t)\n905\t\n906\t\t\t// idle\n907\t\t\te.post(t, \"/api/issue/check\",\n908\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[45]}`)\n909\t\n910\t\t\t// claim → fixing → ready-for-pr → pr-created → testing\n911\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 45, \"sess_test_lc\")\n912\t\t\te.post(t, \"/api/issue/status\",\n913\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"fixing\"}`)\n914\t\t\te.post(t, \"/api/issue/status\",\n915\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"ready-for-pr\"}`)\n916\t\t\te.post(t, \"/api/issue/status\",\n917\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"pr-created\"}`)\n918\t\t\te.post(t, \"/api/issue/status\",\n919\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"testing\"}`)\n920\t\n921\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{45})\n922\t\t\tif s[45] != \"testing\" {\n923\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[45])\n924\t\t\t}\n925\t\n926\t\t\t// session end 释放 testing\n927\t\t\te.post(t, \"/api/issue/release-session\",\n928\t\t\t\t`{\"session_id\":\"sess_test_lc\"}`)\n929\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{45})\n930\t\t\tif s[45] != \"idle\" {\n931\t\t\t\tt.Fatalf(\"expected idle after session end, got %s\", s[45])\n932\t\t\t}\n933\t\n934\t\t\t// re-claim\n935\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 45, \"sess_new\")\n936\t\t\tif code != http.StatusOK || !ok {\n937\t\t\t\tt.Fatalf(\"re-claim failed\")\n938\t\t\t}\n939\t\t})\n940\t}\n941\t\n942\t// --- D6: 001-9-issue-review 技能集成测试 ---\n943\t// 验收标准：\n944\t//   - testing → reviewing → merged 完整流程\n945\t//   - merged 终态不被 session end 释放\n946\t//   - rejected 终态不被 session end 释放\n947\t//   - rejected issue 释放后可被重新 claim\n948\t\n949\t// TestIssueReviewFlow 验证 issue-review 技能的完整流程。\n950\tfunc TestIssueReviewFlow(t *testing.T) {\n951\t\tt.Run(\"merge_full_flow\", func(t *testing.T) {\n952\t\t\te := setup(t)\n953\t\n954\t\t\t// claim → fixing → ready-for-pr → pr-created → testing → reviewing → merged\n955\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 50, \"sess_merge\")\n956\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n957\t\t\t\te.post(t, \"/api/issue/status\",\n958\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":50,\"session_id\":\"sess_merge\",\"status\":\"%s\"}`, s))\n959\t\t\t}\n960\t\n961\t\t\tresp := e.post(t, \"/api/issue/status\",\n962\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":50,\"session_id\":\"sess_merge\",\"status\":\"merged\"}`)\n963\t\t\tvar result struct {\n964\t\t\t\tSuccess        bool   `json:\"success\"`\n965\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n966\t\t\t\tNewStatus      string `json:\"new_status\"`\n967\t\t\t}\n968\t\t\treadJSON(t, resp, &result)\n969\t\t\tif !result.Success {\n970\t\t\t\tt.Fatal(\"merged update failed\")\n971\t\t\t}\n972\t\t\tif result.PreviousStatus != \"reviewing\" {\n973\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n974\t\t\t}\n975\t\n976\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{50})\n977\t\t\tif s[50] != \"merged\" {\n978\t\t\t\tt.Fatalf(\"expected merged, got %s\", s[50])\n979\t\t\t}\n980\t\t})\n981\t\n982\t\tt.Run(\"merged_not_released_on_session_end\", func(t *testing.T) {\n983\t\t\t// 验收：merged 终态不被 session end 释放\n984\t\t\te := setup(t)\n985\t\t\tdb := e.store.DB()\n986\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_merged\", \"2026-05-27T10:00:00Z\")\n987\t\n988\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n989\t\t\t\t`{\"session_id\":\"sess_merged\"}`)\n990\t\t\tvar rel struct{ Count int `json:\"count\"` }\n991\t\t\treadJSON(t, resp, &rel)\n992\t\t\tif rel.Count != 0 {\n993\t\t\t\tt.Fatalf(\"merged should not be released, got count=%d\", rel.Count)\n994\t\t\t}\n995\t\n996\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n997\t\t\tif s[10] != \"merged\" {\n998\t\t\t\tt.Errorf(\"expected merged unchanged, got %s\", s[10])\n999\t\t\t}\n1000\t\t})\n1001\t\n1002\t\tt.Run(\"reject_full_flow\", func(t *testing.T) {\n1003\t\t\te := setup(t)\n1004\t\n1005\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 55, \"sess_reject\")\n1006\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n1007\t\t\t\te.post(t, \"/api/issue/status\",\n1008\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":55,\"session_id\":\"sess_reject\",\"status\":\"%s\"}`, s))\n1009\t\t\t}\n1010\t\n1011\t\t\tresp := e.post(t, \"/api/issue/status\",\n1012\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":55,\"session_id\":\"sess_reject\",\"status\":\"rejected\"}`)\n1013\t\t\tvar result struct {\n1014\t\t\t\tSuccess        bool   `json:\"success\"`\n1015\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1016\t\t\t\tNewStatus      string `json:\"new_status\"`\n1017\t\t\t}\n1018\t\t\treadJSON(t, resp, &result)\n1019\t\t\tif !result.Success {\n1020\t\t\t\tt.Fatal(\"rejected update failed\")\n1021\t\t\t}\n1022\t\t\tif result.PreviousStatus != \"reviewing\" {\n1023\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1024\t\t\t}\n1025\t\n1026\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{55})\n1027\t\t\tif s[55] != \"rejected\" {\n1028\t\t\t\tt.Fatalf(\"expected rejected, got %s\", s[55])\n1029\t\t\t}\n1030\t\t})\n1031\t\n1032\t\tt.Run(\"rejected_not_released_on_session_end\", func(t *testing.T) {\n1033\t\t\t// 验收：rejected 终态不被 session end 释放\n1034\t\t\te := setup(t)\n1035\t\t\tdb := e.store.DB()\n1036\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"rejected\", \"sess_rejected\", \"2026-05-27T10:00:00Z\")\n1037\t\n1038\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1039\t\t\t\t`{\"session_id\":\"sess_rejected\"}`)\n1040\t\t\tvar rel struct{ Count int `json:\"count\"` }\n1041\t\t\treadJSON(t, resp, &rel)\n1042\t\t\tif rel.Count != 0 {\n1043\t\t\t\tt.Fatalf(\"rejected should not be released, got count=%d\", rel.Count)\n1044\t\t\t}\n1045\t\n1046\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{11})\n1047\t\t\tif s[11] != \"rejected\" {\n1048\t\t\t\tt.Errorf(\"expected rejected unchanged, got %s\", s[11])\n1049\t\t\t}\n1050\t\t})\n1051\t\n1052\t\tt.Run(\"non_terminal_reviewing_released_on_session_end\", func(t *testing.T) {\n1053\t\t\t// reviewing（非终态）在 session end 时应被释放\n1054\t\t\te := setup(t)\n1055\t\t\tdb := e.store.DB()\n1056\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 12, \"reviewing\", \"sess_rev\", \"2026-05-27T10:00:00Z\")\n1057\t\n1058\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1059\t\t\t\t`{\"session_id\":\"sess_rev\"}`)\n1060\t\t\tvar rel struct{ Count int `json:\"count\"` }\n1061\t\t\treadJSON(t, resp, &rel)\n1062\t\t\tif rel.Count != 1 {\n1063\t\t\t\tt.Fatalf(\"reviewing should be released, got count=%d\", rel.Count)\n1064\t\t\t}\n1065\t\n1066\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{12})\n1067\t\t\tif s[12] != \"idle\" {\n1068\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[12])\n1069\t\t\t}\n1070\t\t})\n1071\t\n1072\t\tt.Run(\"complete_lifecycle_merge\", func(t *testing.T) {\n1073\t\t\t// 完整生命周期：idle → claimed → ... → merged，session end 不影响\n1074\t\t\te := setup(t)\n1075\t\n1076\t\t\te.post(t, \"/api/issue/check\",\n1077\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[60]}`)\n1078\t\n1079\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 60, \"sess_full_merge\")\n1080\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\", \"merged\"} {\n1081\t\t\t\te.post(t, \"/api/issue/status\",\n1082\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":60,\"session_id\":\"sess_full_merge\",\"status\":\"%s\"}`, s))\n1083\t\t\t}\n1084\t\n1085\t\t\t// session end 不释放 merged\n1086\t\t\te.post(t, \"/api/issue/release-session\",\n1087\t\t\t\t`{\"session_id\":\"sess_full_merge\"}`)\n1088\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{60})\n1089\t\t\tif s[60] != \"merged\" {\n1090\t\t\t\tt.Fatalf(\"expected merged preserved after session end, got %s\", s[60])\n1091\t\t\t}\n1092\t\t})\n1093\t\n1094\t\tt.Run(\"complete_lifecycle_reject_then_reclaim\", func(t *testing.T) {\n1095\t\t\t// 完整生命周期：... → rejected，手动 release 后可重新 claim\n1096\t\t\te := setup(t)\n1097\t\n1098\t\t\te.post(t, \"/api/issue/check\",\n1099\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[65]}`)\n1100\t\n1101\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 65, \"sess_rej\")\n1102\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\", \"rejected\"} {\n1103\t\t\t\te.post(t, \"/api/issue/status\",\n1104\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":65,\"session_id\":\"sess_rej\",\"status\":\"%s\"}`, s))\n1105\t\t\t}\n1106\t\n1107\t\t\t// rejected 是终态，session end 不释放\n1108\t\t\te.post(t, \"/api/issue/release-session\",\n1109\t\t\t\t`{\"session_id\":\"sess_rej\"}`)\n1110\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{65})\n1111\t\t\tif s[65] != \"rejected\" {\n1112\t\t\t\tt.Fatalf(\"expected rejected preserved, got %s\", s[65])\n1113\t\t\t}\n1114\t\n1115\t\t\t// 手动 release（由新的 fixing 周期触发）\n1116\t\t\te.post(t, \"/api/issue/release\",\n1117\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":65,\"session_id\":\"sess_rej\"}`)\n1118\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{65})\n1119\t\t\tif s[65] != \"rejected\" {\n1120\t\t\t\tt.Fatalf(\"rejected should not be releasable by owner either, got %s\", s[65])\n1121\t\t\t}\n1122\t\t})\n1123\t}\n1124\t\n1125\t// --- D7: SessionEnd Hook 自动释放集成测试 ---\n1126\t// 验收标准：\n1127\t//   - 会话结束时释放该 session 所有非终态 issue\n1128\t//   - merged 不被释放\n1129\t//   - rejected 不被释放\n1130\t//   - 无领取记录的 session 不报错\n1131\t//   - 释放后 issue 可被重新 claim\n1132\t\n1133\t// TestSessionEndRelease 验证 SessionEnd 自动释放的边界条件。\n1134\tfunc TestSessionEndRelease(t *testing.T) {\n1135\t\tt.Run(\"releases_fixing_ready_for_pr_pr_created_testing_reviewing\", func(t *testing.T) {\n1136\t\t\t// 验收：所有非终态（fixing/ready-for-pr/pr-created/testing/reviewing）都被释放\n1137\t\t\te := setup(t)\n1138\t\t\tdb := e.store.DB()\n1139\t\n1140\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"fixing\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1141\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"ready-for-pr\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1142\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 12, \"pr-created\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1143\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 13, \"testing\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1144\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 14, \"reviewing\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1145\t\n1146\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1147\t\t\t\t`{\"session_id\":\"sess_d7\"}`)\n1148\t\t\tvar result struct {\n1149\t\t\t\tReleased []int `json:\"released\"`\n1150\t\t\t\tCount    int   `json:\"count\"`\n1151\t\t\t}\n1152\t\t\treadJSON(t, resp, &result)\n1153\t\n1154\t\t\tif result.Count != 5 {\n1155\t\t\t\tt.Fatalf(\"expected 5 released, got %d\", result.Count)\n1156\t\t\t}\n1157\t\n1158\t\t\t// 验证所有 issue 都回到 idle\n1159\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11, 12, 13, 14})\n1160\t\t\tfor _, n := range []int{10, 11, 12, 13, 14} {\n1161\t\t\t\tif s[n] != \"idle\" {\n1162\t\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", n, s[n])\n1163\t\t\t\t}\n1164\t\t\t}\n1165\t\t})\n1166\t\n1167\t\tt.Run(\"merged_not_released\", func(t *testing.T) {\n1168\t\t\t// 验收：merged 终态不被释放\n1169\t\t\te := setup(t)\n1170\t\t\tdb := e.store.DB()\n1171\t\n1172\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_d7_m\", \"2026-05-27T10:00:00Z\")\n1173\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"fixing\", \"sess_d7_m\", \"2026-05-27T10:00:00Z\")\n1174\t\n1175\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1176\t\t\t\t`{\"session_id\":\"sess_d7_m\"}`)\n1177\t\t\tvar result struct {\n1178\t\t\t\tReleased []int `json:\"released\"`\n1179\t\t\t\tCount    int   `json:\"count\"`\n1180\t\t\t}\n1181\t\t\treadJSON(t, resp, &result)\n1182\t\n1183\t\t\tif result.Count != 1 {\n1184\t\t\t\tt.Fatalf(\"expected 1 released (fixing only), got %d\", result.Count)\n1185\t\t\t}\n1186\t\t\tif len(result.Released) != 1 || result.Released[0] != 11 {\n1187\t\t\t\tt.Fatalf(\"expected [11], got %v\", result.Released)\n1188\t\t\t}\n1189\t\n1190\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11})\n1191\t\t\tif s[10] != \"merged\" {\n1192\t\t\t\tt.Errorf(\"merged should stay, got %s\", s[10])\n1193\t\t\t}\n1194\t\t\tif s[11] != \"idle\" {\n1195\t\t\t\tt.Errorf(\"fixing should be idle, got %s\", s[11])\n1196\t\t\t}\n1197\t\t})\n1198\t\n1199\t\tt.Run(\"rejected_not_released\", func(t *testing.T) {\n1200\t\t\t// 验收：rejected 终态不被释放\n1201\t\t\te := setup(t)\n1202\t\t\tdb := e.store.DB()\n1203\t\n1204\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"rejected\", \"sess_d7_r\", \"2026-05-27T10:00:00Z\")\n1205\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"claimed\", \"sess_d7_r\", \"2026-05-27T10:00:00Z\")\n1206\t\n1207\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1208\t\t\t\t`{\"session_id\":\"sess_d7_r\"}`)\n1209\t\t\tvar result struct{ Count int `json:\"count\"` }\n1210\t\t\treadJSON(t, resp, &result)\n1211\t\n1212\t\t\tif result.Count != 1 {\n1213\t\t\t\tt.Fatalf(\"expected 1 released (claimed only), got %d\", result.Count)\n1214\t\t\t}\n1215\t\n1216\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11})\n1217\t\t\tif s[10] != \"rejected\" {\n1218\t\t\t\tt.Errorf(\"rejected should stay, got %s\", s[10])\n1219\t\t\t}\n1220\t\t\tif s[11] != \"idle\" {\n1221\t\t\t\tt.Errorf(\"claimed should be idle, got %s\", s[11])\n1222\t\t\t}\n1223\t\t})\n1224\t\n1225\t\tt.Run(\"released_issue_can_be_reclaimed\", func(t *testing.T) {\n1226\t\t\t// 验收：释放后 issue 可被重新 claim\n1227\t\t\te := setup(t)\n1228\t\t\tdb := e.store.DB()\n1229\t\n1230\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"fixing\", \"sess_old\", \"2026-05-27T10:00:00Z\")\n1231\t\n1232\t\t\t// 释放\n1233\t\t\te.post(t, \"/api/issue/release-session\",\n1234\t\t\t\t`{\"session_id\":\"sess_old\"}`)\n1235\t\n1236\t\t\t// 新 session claim\n1237\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 10, \"sess_new\")\n1238\t\t\tif code != http.StatusOK || !ok {\n1239\t\t\t\tt.Fatalf(\"re-claim should succeed: code=%d ok=%v\", code, ok)\n1240\t\t\t}\n1241\t\n1242\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n1243\t\t\tif s[10] != \"claimed\" {\n1244\t\t\t\tt.Fatalf(\"expected claimed after re-claim, got %s\", s[10])\n1245\t\t\t}\n1246\t\t})\n1247\t\n1248\t\tt.Run(\"no_backend_issues_returns_ok\", func(t *testing.T) {\n1249\t\t\t// 验收：无领取记录的 session 返回成功\n1250\t\t\te := setup(t)\n1251\t\n1252\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1253\t\t\t\t`{\"session_id\":\"sess_empty_d7\"}`)\n1254\t\n1255\t\t\tif resp.StatusCode != http.StatusOK {\n1256\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n1257\t\t\t}\n1258\t\t})\n1259\t}\n1260\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\reverse.go"},"tool_use_id":"call_e28381f1bc7a45d0b35382dd","tool_response":"1\t// Package proxy 提供 HTTP 代理功能，包括请求转发、SSE 流式处理与 Trace 记录。\n2\tpackage proxy\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"compress/gzip\"\n7\t\t\"compress/zlib\"\n8\t\t\"encoding/json\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"net/http\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\t\"sync/atomic\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n19\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n20\t)\n21\t\n22\t// ReverseProxy 拦截 HTTP 请求并转发到上游 API，同时记录请求/响应到 JSONL Trace，并处理 SSE 流式响应。\n23\ttype ReverseProxy struct {\n24\t\ttarget             string              // 上游 API 目标地址\n25\t\tbaseDir            string              // Trace 文件存放的基础目录\n26\t\twriter             *trace.TraceWriter  // 当前会话的 Trace 写入器（由 _internal/trace-init 创建）\n27\t\tclient             *http.Client        // 转发请求的 HTTP 客户端\n28\t\tturn               atomic.Int64        // 请求计数器，用于标记 Turn 编号\n29\t\tserver             *http.Server        // 本地代理 HTTP 服务器\n30\t\tstartOnce          sync.Once           // 确保 Start 只执行一次\n31\t\tsessionID          string              // 当前会话 ID（由 trace-init 设置）\n32\t\tprojectSlug        string              // 当前项目标识（由 trace-init 设置）\n33\t\tOnSessionInit      func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\n34\t\tmodel              string              // 强制替换的模型名（空=不改写）\n35\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n36\t\tfallbackConfig     *FallbackConfig      // 兜底配置（上游不可用时切换）\n37\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfig 的并发安全\n38\t\tactualAddr         string              // 实际监听地址（启动后设置）\n39\t\treasoningCache     *ReasoningCache     // reasoning_content 缓存（仅 kimi 模式）\n40\t\tkimiMode           bool                // 是否为 kimi 上游\n41\t}\n42\t\n43\t// FallbackConfig 存储上游不可用时的兜底配置。\n44\ttype FallbackConfig struct {\n45\t\tBaseURL   string // 兜底上游 API 地址\n46\t\tModel     string // 兜底模型名\n47\t\tAuthToken string // 兜底认证 Token\n48\t\tAPIKey    string // 兜底 API Key\n49\t}\n50\t\n51\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n52\t// traceDir 为 Trace 文件存放的基础目录。\n53\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n54\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n55\t\treturn &ReverseProxy{\n56\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n57\t\t\tbaseDir:           traceDir,\n58\t\t\tupstreamAvailable: true,\n59\t\t\tclient: &http.Client{\n60\t\t\t\tTimeout: 0, // 流式场景不设超时\n61\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n62\t\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n63\t\t\t\t},\n64\t\t\t},\n65\t\t}\n66\t}\n67\t\n68\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n69\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n70\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n71\t\tmux := http.NewServeMux()\n72\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n73\t\tp.server = &http.Server{\n74\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n75\t\t\tHandler: mux,\n76\t\t}\n77\t\n78\t\tlistener, err := ioListener(p.server.Addr)\n79\t\tif err != nil {\n80\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n81\t\t}\n82\t\n83\t\t// 在后台 goroutine 中启动服务\n84\t\tgo func() {\n85\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n86\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n87\t\t\t}\n88\t\t}()\n89\t\n90\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n91\t\tp.actualAddr = fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n92\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n93\t\treturn actualPort, nil\n94\t}\n95\t\n96\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n97\tfunc (p *ReverseProxy) Stop() {\n98\t\tlogger.Info(\"proxy\", \"stopping\")\n99\t\tif p.writer != nil {\n100\t\t\tp.writer.Close()\n101\t\t}\n102\t\tif p.server != nil {\n103\t\t\t_ = p.server.Close()\n104\t\t}\n105\t}\n106\t\n107\t// URL 返回代理服务器的 HTTP 地址（如 http://127.0.0.1:8080）。\n108\tfunc (p *ReverseProxy) URL() string {\n109\t\treturn p.actualAddr\n110\t}\n111\t\n112\t// serveHTTP 是代理的核心 HTTP 处理函数。\n113\t// 处理流程：内部端点 → 路径白名单检查 → 读取请求体 → 构建上游请求 → 转发 → 流式/非流式处理。\n114\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n115\t\t// 处理内部端点（绕过路径白名单）\n116\t\tif strings.HasPrefix(r.URL.Path, \"/_internal/\") {\n117\t\t\tp.handleInternal(w, r)\n118\t\t\treturn\n119\t\t}\n120\t\n121\t\t// 拒绝未知路径\n122\t\tif !IsAllowedPath(r.URL.Path) {\n123\t\t\thttp.NotFound(w, r)\n124\t\t\treturn\n125\t\t}\n126\t\n127\t\t// 读取请求体\n128\t\tbodyBytes, err := io.ReadAll(r.Body)\n129\t\tif err != nil {\n130\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n131\t\t\treturn\n132\t\t}\n133\t\t_ = r.Body.Close()\n134\t\n135\t\t// 解析请求体为 JSON（用于后续提取 model、stream 等字段）\n136\t\tvar reqBody any\n137\t\tif len(bodyBytes) > 0 {\n138\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n139\t\t}\n140\t\n141\t\t// 请求体 model 改写（契约 3）\n142\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, p.model)\n143\t\n144\t\t// 重新解析改写后的请求体\n145\t\treqBody = nil\n146\t\tif len(bodyBytes) > 0 {\n147\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n148\t\t}\n149\t\n150\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n151\t\tbodyBytes = injectReasoningContentCached(bodyBytes, reqBody, p.reasoningCache, p.kimiMode)\n152\t\treqBody = nil\n153\t\tif len(bodyBytes) > 0 {\n154\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n155\t\t}\n156\t\n157\t\t// 生成请求 ID 与 Turn 编号\n158\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n159\t\tturn := int(p.turn.Add(1))\n160\t\tt0 := time.Now()\n161\t\n162\t\tlogger.Debug(\"proxy\", \"[Turn %d] request: %s %s (%d bytes)\", turn, r.Method, r.URL.Path, len(bodyBytes))\n163\t\n164\t\t// 确定上游目标：检查是否需要走兜底配置（契约 4）\n165\t\tp.availableMu.Lock()\n166\t\tuseFallback := !p.upstreamAvailable && p.fallbackConfig != nil\n167\t\tactiveTarget := p.target\n168\t\tvar fallbackModel string\n169\t\tif useFallback {\n170\t\t\tactiveTarget = p.fallbackConfig.BaseURL\n171\t\t\tfallbackModel = p.fallbackConfig.Model\n172\t\t}\n173\t\tp.availableMu.Unlock()\n174\t\n175\t\t// 兜底模式下重新改写 model\n176\t\tif useFallback && fallbackModel != \"\" {\n177\t\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, fallbackModel)\n178\t\t\treqBody = nil\n179\t\t\tif len(bodyBytes) > 0 {\n180\t\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n181\t\t\t}\n182\t\n183\t\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n184\t\t\tbodyBytes = injectReasoningContentCached(bodyBytes, reqBody, p.reasoningCache, IsKimiURL(activeTarget))\n185\t\t\treqBody = nil\n186\t\t\tif len(bodyBytes) > 0 {\n187\t\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n188\t\t\t}\n189\t\t}\n190\t\n191\t\t// 构建上游请求 URL\n192\t\tupstreamURL := activeTarget + r.URL.Path\n193\t\tif r.URL.RawQuery != \"\" {\n194\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n195\t\t}\n196\t\n197\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n198\t\tif err != nil {\n199\t\t\thttp.Error(w, \"create upstream request: \"+err.Error(), http.StatusBadGateway)\n200\t\t\treturn\n201\t\t}\n202\t\n203\t\t// 复制请求头，过滤逐跳头\n204\t\tfor k, vals := range r.Header {\n205\t\t\tlower := strings.ToLower(k)\n206\t\t\tif hopByHopHeaders[lower] {\n207\t\t\t\tcontinue\n208\t\t\t}\n209\t\t\tfor _, v := range vals {\n210\t\t\t\tupstreamReq.Header.Add(k, v)\n211\t\t\t}\n212\t\t}\n213\t\tupstreamReq.Header.Del(\"Host\")\n214\t\n215\t\t// 兜底模式下替换认证头\n216\t\tif useFallback && p.fallbackConfig != nil {\n217\t\t\tif p.fallbackConfig.APIKey != \"\" {\n218\t\t\t\tupstreamReq.Header.Set(\"x-api-key\", p.fallbackConfig.APIKey)\n219\t\t\t}\n220\t\t\tif p.fallbackConfig.AuthToken != \"\" {\n221\t\t\t\tupstreamReq.Header.Set(\"Authorization\", \"Bearer \"+p.fallbackConfig.AuthToken)\n222\t\t\t}\n223\t\t}\n224\t\n225\t\t// 向上游发送请求\n226\t\tupstreamResp, err := p.client.Do(upstreamReq)\n227\t\tif err != nil {\n228\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error: %v\", turn, err)\n229\t\t\tp.markUnavailable()\n230\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n231\t\t\treturn\n232\t\t}\n233\t\tdefer upstreamResp.Body.Close()\n234\t\n235\t\t// 响应错误（4xx/5xx）→ 标记上游不可用（契约 4）\n236\t\tif upstreamResp.StatusCode >= 400 {\n237\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error response: %d\", turn, upstreamResp.StatusCode)\n238\t\t\tp.markUnavailable()\n239\t\t}\n240\t\n241\t\tduration := time.Since(t0).Milliseconds()\n242\t\n243\t\t// 从请求体中提取 model 字段\n244\t\tmodel := \"\"\n245\t\tif m, ok := reqBody.(map[string]any); ok {\n246\t\t\tif v, ok := m[\"model\"].(string); ok {\n247\t\t\t\tmodel = v\n248\t\t\t}\n249\t\t}\n250\t\n251\t\t// 检测是否为流式请求\n252\t\tisStreaming := false\n253\t\tif m, ok := reqBody.(map[string]any); ok {\n254\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n255\t\t\t\tisStreaming = s\n256\t\t\t}\n257\t\t}\n258\t\n259\t\t// 根据是否流式分发到对应处理器\n260\t\tif isStreaming {\n261\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n262\t\t} else {\n263\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n264\t\t}\n265\t}\n266\t\n267\t// handleStreaming 处理 SSE 流式响应：\n268\t//   - 复制响应头并写入客户端\n269\t//   - 逐块读取上游响应体并实时转发给客户端\n270\t//   - 使用 SSE 重组器收集完整事件\n271\t//   - 将重组后的结果写入 Trace\n272\tfunc (p *ReverseProxy) handleStreaming(\n273\t\tw http.ResponseWriter,\n274\t\tupstreamResp *http.Response,\n275\t\treqID string, turn, durationMs int,\n276\t\tr *http.Request, reqBody any,\n277\t\tt0 time.Time, model string,\n278\t) {\n279\t\t// 复制响应头\n280\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n281\t\tfor k, vals := range respHeaders {\n282\t\t\tfor _, v := range vals {\n283\t\t\t\tw.Header().Add(k, v)\n284\t\t\t}\n285\t\t}\n286\t\tw.WriteHeader(upstreamResp.StatusCode)\n287\t\n288\t\tflusher, canFlush := w.(http.Flusher)\n289\t\treassembler := sse.NewSSEReassembler()\n290\t\n291\t\t// 逐块读取并转发流式数据\n292\t\tbuf := make([]byte, 32*1024)\n293\t\tfor {\n294\t\t\tn, err := upstreamResp.Body.Read(buf)\n295\t\t\tif n > 0 {\n296\t\t\t\t_, _ = w.Write(buf[:n])\n297\t\t\t\tif canFlush {\n298\t\t\t\t\tflusher.Flush()\n299\t\t\t\t}\n300\t\t\t\treassembler.FeedBytes(buf[:n])\n301\t\t\t}\n302\t\t\tif err != nil {\n303\t\t\t\tbreak\n304\t\t\t}\n305\t\t}\n306\t\n307\t\tdurationMs = int(time.Since(t0).Milliseconds())\n308\t\treconstructed := reassembler.Reconstruct()\n309\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n310\t\n311\t\t// kimi 模式下缓存 SSE 响应中的 reasoning_content\n312\t\tif p.kimiMode && reconstructed != nil {\n313\t\t\tp.cacheFromResponse(reconstructed)\n314\t\t}\n315\t\n316\t\t// 构建 Trace 记录\n317\t\trecord := buildRecord(\n318\t\t\treqID, turn, durationMs,\n319\t\t\tr.Method, r.URL.RequestURI(),\n320\t\t\tr.Header, reqBody,\n321\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n322\t\t\treconstructed,\n323\t\t\treassembler.Events,\n324\t\t\tp.target,\n325\t\t)\n326\t\n327\t\tif w := p.getWriter(); w != nil {\n328\t\t\tif err := w.Write(record); err != nil {\n329\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n330\t\t\t}\n331\t\t} else {\n332\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n333\t\t}\n334\t\n335\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n336\t}\n337\t\n338\t// handleNonStreaming 处理普通（非流式）响应：\n339\t//   - 读取完整响应体\n340\t//   - 按需解压（gzip / deflate）\n341\t//   - 解析 JSON 响应体\n342\t//   - 写入 Trace 并返回给客户端\n343\tfunc (p *ReverseProxy) handleNonStreaming(\n344\t\tw http.ResponseWriter,\n345\t\tupstreamResp *http.Response,\n346\t\treqID string, turn, durationMs int,\n347\t\tr *http.Request, reqBody any, model string,\n348\t) {\n349\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n350\t\tif err != nil {\n351\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n352\t\t\treturn\n353\t\t}\n354\t\n355\t\t// 按需解压响应体\n356\t\tdecodeBytes := respBytes\n357\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n358\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n359\t\t\tvar reader io.ReadCloser\n360\t\t\tif encoding == \"gzip\" {\n361\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n362\t\t\t} else {\n363\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n364\t\t\t}\n365\t\t\tif reader != nil {\n366\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n367\t\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n368\t\t\t\t\tdecodeBytes = decoded\n369\t\t\t\t}\n370\t\t\t\t_ = reader.Close()\n371\t\t\t}\n372\t\t}\n373\t\n374\t\t// 解析解压后的 JSON 响应体\n375\t\tvar respBody any\n376\t\tif len(decodeBytes) > 0 {\n377\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n378\t\t}\n379\t\n380\t\t// kimi 模式下缓存响应中的 reasoning_content\n381\t\tif p.kimiMode {\n382\t\t\tif respMap, ok := respBody.(map[string]any); ok {\n383\t\t\t\tp.cacheFromResponse(respMap)\n384\t\t\t}\n385\t\t}\n386\t\n387\t\t// 构建 Trace 记录\n388\t\trecord := buildRecord(\n389\t\t\treqID, turn, durationMs,\n390\t\t\tr.Method, r.URL.RequestURI(),\n391\t\t\tr.Header, reqBody,\n392\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n393\t\t\trespBody,\n394\t\t\tnil,\n395\t\t\tp.target,\n396\t\t)\n397\t\n398\t\tif w := p.getWriter(); w != nil {\n399\t\t\tif err := w.Write(record); err != nil {\n400\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n401\t\t\t}\n402\t\t} else {\n403\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n404\t\t}\n405\t\n406\t\t// 将响应返回给客户端\n407\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n408\t\tfor k, vals := range respHeaders {\n409\t\t\tfor _, v := range vals {\n410\t\t\t\tw.Header().Add(k, v)\n411\t\t\t}\n412\t\t}\n413\t\tw.WriteHeader(upstreamResp.StatusCode)\n414\t\t_, _ = w.Write(respBytes)\n415\t\n416\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n417\t}\n418\t\n419\t// buildRecord 构建一条 Trace 记录，包含请求/响应的完整信息。\n420\tfunc buildRecord(\n421\t\treqID string, turn, durationMs int,\n422\t\tmethod, path string,\n423\t\treqHeaders http.Header, reqBody any,\n424\t\tstatus int, respHeaders http.Header,\n425\t\trespBody any,\n426\t\tsseEvents []map[string]any,\n427\t\tupstreamBaseURL string,\n428\t) map[string]any {\n429\t\trecord := map[string]any{\n430\t\t\t\"timestamp\":   time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n431\t\t\t\"request_id\":  reqID,\n432\t\t\t\"session_id\":  extractSessionID(reqBody),\n433\t\t\t\"turn\":        turn,\n434\t\t\t\"duration_ms\": durationMs,\n435\t\t\t\"request\": map[string]any{\n436\t\t\t\t\"method\":  method,\n437\t\t\t\t\"path\":    path,\n438\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n439\t\t\t\t\"body\":    reqBody,\n440\t\t\t},\n441\t\t\t\"response\": map[string]any{\n442\t\t\t\t\"status\":  status,\n443\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n444\t\t\t\t\"body\":    respBody,\n445\t\t\t},\n446\t\t}\n447\t\tif len(sseEvents) > 0 {\n448\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n449\t\t}\n450\t\tif upstreamBaseURL != \"\" {\n451\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n452\t\t}\n453\t\treturn record\n454\t}\n455\t\n456\t// extractSessionID 从请求体的 metadata.user_id 字段中提取 session_id。\n457\t// Claude Code 发送的格式为：metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n458\tfunc extractSessionID(reqBody any) string {\n459\t\tbody, ok := reqBody.(map[string]any)\n460\t\tif !ok {\n461\t\t\treturn \"\"\n462\t\t}\n463\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n464\t\tif metadata == nil {\n465\t\t\treturn \"\"\n466\t\t}\n467\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n468\t\tif userIDRaw == \"\" {\n469\t\t\treturn \"\"\n470\t\t}\n471\t\tvar userData map[string]string\n472\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n473\t\t\treturn \"\"\n474\t\t}\n475\t\treturn userData[\"session_id\"]\n476\t}\n477\t\n478\t// handleInternal 分发内部代理端点请求。\n479\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n480\t\tswitch r.URL.Path {\n481\t\tcase \"/_internal/trace-init\":\n482\t\t\tp.handleTraceInit(w, r)\n483\t\tdefault:\n484\t\t\thttp.NotFound(w, r)\n485\t\t}\n486\t}\n487\t\n488\t// handleTraceInit 接收 SessionStart 钩子传来的会话信息，创建 Trace 写入器。\n489\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n490\t\tif r.Method != http.MethodPost {\n491\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n492\t\t\treturn\n493\t\t}\n494\t\n495\t\tvar req struct {\n496\t\t\tSessionID      string `json:\"session_id\"`\n497\t\t\tMachineID      string `json:\"machine_id\"`\n498\t\t\tProjectSlug    string `json:\"project_slug\"`\n499\t\t\tTranscriptPath string `json:\"transcript_path\"`\n500\t\t}\n501\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n502\t\t\tlogger.Warn(\"proxy\", \"trace-init: invalid JSON: %v\", err)\n503\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n504\t\t\treturn\n505\t\t}\n506\t\n507\t\tif req.SessionID == \"\" {\n508\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n509\t\t\treturn\n510\t\t}\n511\t\n512\t\t// 允许 session 重新绑定（/clear 后新 session 取代旧 session）\n513\t\tif p.sessionID != \"\" && p.sessionID != req.SessionID {\n514\t\t\tlogger.Debug(\"proxy\", \"trace-init: rebinding session %s -> %s\", p.sessionID, req.SessionID)\n515\t\t}\n516\t\n517\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n518\t\n519\t\t// 若请求中未提供，则通过 trace 包自动检测\n520\t\tmachineID := req.MachineID\n521\t\tif machineID == \"\" {\n522\t\t\tmachineID = trace.MachineID()\n523\t\t}\n524\t\n525\t\tprojectSlug := req.ProjectSlug\n526\t\tif projectSlug == \"\" {\n527\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n528\t\t\tif projectSlug == \"\" {\n529\t\t\t\tprojectSlug = trace.DetectProjectName()\n530\t\t\t}\n531\t\t}\n532\t\n533\t\t// 创建会话专属的 Trace 写入器\n534\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n535\t\twriter, err := trace.NewTraceWriter(tracePath)\n536\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n537\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n538\t\tif err != nil {\n539\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n540\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n541\t\t\treturn\n542\t\t}\n543\t\n544\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n545\t\t\tif p.writer != nil {\n546\t\t\t\tp.writer.Close()\n547\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n548\t\t\t}\n549\t\tp.writer = writer\n550\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n551\t\n552\t\t// 通知外部注册 proxy.json\n553\t\tif p.OnSessionInit != nil {\n554\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n555\t\t}\n556\t\n557\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n558\t\tjson.NewEncoder(w).Encode(map[string]string{\n559\t\t\t\"status\":     \"ok\",\n560\t\t\t\"trace_path\": tracePath,\n561\t\t})\n562\t}\n563\t\n564\t// getWriter 返回当前会话的 Trace 写入器。\n565\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n566\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n567\t\treturn p.writer\n568\t}\n569\t\n570\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n571\t// 若无有效写入器，返回零值统计。\n572\tfunc (p *ReverseProxy) Summary() map[string]any {\n573\t\tif w := p.getWriter(); w != nil {\n574\t\t\treturn w.Summary()\n575\t\t}\n576\t\treturn map[string]any{\n577\t\t\t\"api_calls\":           0,\n578\t\t\t\"input_tokens\":        int64(0),\n579\t\t\t\"output_tokens\":       int64(0),\n580\t\t\t\"cache_read_tokens\":   int64(0),\n581\t\t\t\"cache_create_tokens\": int64(0),\n582\t\t}\n583\t}\n584\t\n585\t// SessionID 返回当前会话的 session_id。\n586\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n587\tfunc (p *ReverseProxy) SessionID() string {\n588\t\tif p.sessionID != \"\" {\n589\t\t\treturn p.sessionID\n590\t\t}\n591\t\tif w := p.getWriter(); w != nil {\n592\t\t\treturn w.SessionID()\n593\t\t}\n594\t\treturn \"\"\n595\t}\n596\t\n597\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n598\tfunc (p *ReverseProxy) ProjectSlug() string {\n599\t\treturn p.projectSlug\n600\t}\n601\t\n602\t// TracePath 返回当前追踪文件的完整路径。\n603\tfunc (p *ReverseProxy) TracePath() string {\n604\t\tif w := p.getWriter(); w != nil {\n605\t\t\treturn w.Path()\n606\t\t}\n607\t\treturn \"\"\n608\t}\n609\t\n610\t// markUnavailable 标记上游不可用（契约 4）。\n611\t// 首次失败后置 upstreamAvailable = false，进程生命周期内不再恢复。\n612\tfunc (p *ReverseProxy) markUnavailable() {\n613\t\tp.availableMu.Lock()\n614\t\tdefer p.availableMu.Unlock()\n615\t\tif p.upstreamAvailable {\n616\t\t\tp.upstreamAvailable = false\n617\t\t\tlogger.Warn(\"proxy\", \"upstream marked unavailable, switching to fallback\")\n618\t\t}\n619\t}\n620\t\n621\t// SetModel 设置强制替换的模型名。\n622\tfunc (p *ReverseProxy) SetModel(model string) {\n623\t\tp.model = model\n624\t}\n625\t\n626\t// SetFallbackConfig 设置兜底配置。\n627\tfunc (p *ReverseProxy) SetFallbackConfig(cfg *FallbackConfig) {\n628\t\tp.fallbackConfig = cfg\n629\t}\n630\t\n631\t// SetKimiMode 启用或禁用 kimi 模式。\n632\t// 启用时会自动创建 reasoning_content 缓存。\n633\tfunc (p *ReverseProxy) SetKimiMode(kimi bool) {\n634\t\tp.kimiMode = kimi\n635\t\tif kimi && p.reasoningCache == nil {\n636\t\t\tp.reasoningCache = NewReasoningCache()\n637\t\t\tlogger.Info(\"proxy\", \"kimi mode enabled, reasoning_content caching active\")\n638\t\t}\n639\t}\n640\t\n641\t// IsKimiURL 判断 URL 是否为 kimi/moonshot 上游。\n642\tfunc IsKimiURL(url string) bool {\n643\t\tlower := strings.ToLower(url)\n644\t\treturn strings.Contains(lower, \"kimi\") || strings.Contains(lower, \"moonshot\")\n645\t}\n646\t\n647\t// cacheFromResponse 从 API 响应快照中提取 reasoning_content 并存入缓存。\n648\t//\n649\t// 同时处理两种响应格式：\n650\t//   - OpenAI Chat Completions: snap[\"choices\"][0][\"message\"] 包含 reasoning_content/content/tool_calls\n651\t//   - Anthropic: snap[\"content\"] 包含 thinking 块和 tool_use 块\n652\t//\n653\t// 仅在 kimi 模式下调用。\n654\tfunc (p *ReverseProxy) cacheFromResponse(snap map[string]any) {\n655\t\tif p.reasoningCache == nil || snap == nil {\n656\t\t\treturn\n657\t\t}\n658\t\n659\t\t// 提取 reasoning_content 和消息内容\n660\t\tvar reasoningContent string\n661\t\tvar msgContent string    // 文本内容（用于 full key）\n662\t\tvar toolCallsJSON string // tool_calls JSON（用于 tc key 和 full key）\n663\t\n664\t\t// 路径 1: OpenAI Chat Completions 格式\n665\t\tchoices, _ := snap[\"choices\"].([]any)\n666\t\tif len(choices) > 0 {\n667\t\t\tchoice, _ := choices[0].(map[string]any)\n668\t\t\tif choice != nil {\n669\t\t\t\tmsg, _ := choice[\"message\"].(map[string]any)\n670\t\t\t\tif msg != nil {\n671\t\t\t\t\treasoningContent, _ = msg[\"reasoning_content\"].(string)\n672\t\t\t\t\tmsgContent, _ = msg[\"content\"].(string)\n673\t\t\t\t\tif tc, ok := msg[\"tool_calls\"]; ok && tc != nil {\n674\t\t\t\t\t\tif tcBytes, err := json.Marshal(tc); err == nil {\n675\t\t\t\t\t\t\ttoolCallsJSON = string(tcBytes)\n676\t\t\t\t\t\t}\n677\t\t\t\t\t}\n678\t\t\t\t}\n679\t\t\t}\n680\t\t}\n681\t\n682\t\t// 路径 2: Anthropic 格式（从 content 数组中的 thinking 块提取）\n683\t\tif reasoningContent == \"\" {\n684\t\t\tcontentArr, _ := snap[\"content\"].([]any)\n685\t\t\tfor _, blockRaw := range contentArr {\n686\t\t\t\tblock, ok := blockRaw.(map[string]any)\n687\t\t\t\tif !ok {\n688\t\t\t\t\tcontinue\n689\t\t\t\t}\n690\t\t\t\tif blockType, _ := block[\"type\"].(string); blockType == \"thinking\" {\n691\t\t\t\t\tif thinking, ok := block[\"thinking\"].(string); ok && thinking != \"\" {\n692\t\t\t\t\t\treasoningContent = thinking\n693\t\t\t\t\t\tbreak\n694\t\t\t\t\t}\n695\t\t\t\t}\n696\t\t\t}\n697\t\t\t// 同时从 Anthropic 格式提取 tool_use 块用于 key 计算\n698\t\t\tif toolCallsJSON == \"\" {\n699\t\t\t\tvar toolUseBlocks []any\n700\t\t\t\tfor _, blockRaw := range contentArr {\n701\t\t\t\t\tblock, ok := blockRaw.(map[string]any)\n702\t\t\t\t\tif !ok {\n703\t\t\t\t\t\tcontinue\n704\t\t\t\t\t}\n705\t\t\t\t\tif blockType, _ := block[\"type\"].(string); blockType == \"tool_use\" {\n706\t\t\t\t\t\ttoolUseBlocks = append(toolUseBlocks, block)\n707\t\t\t\t\t}\n708\t\t\t\t}\n709\t\t\t\tif len(toolUseBlocks) > 0 {\n710\t\t\t\t\tif tcBytes, err := json.Marshal(toolUseBlocks); err == nil {\n711\t\t\t\t\t\ttoolCallsJSON = string(tcBytes)\n712\t\t\t\t\t}\n713\t\t\t\t}\n714\t\t\t}\n715\t\t}\n716\t\n717\t\tif reasoningContent == \"\" {\n718\t\t\treturn // 无 reasoning_content 可缓存\n719\t\t}\n720\t\n721\t\tfullKey := MakeFullKey(msgContent, toolCallsJSON)\n722\t\ttcKey := MakeToolcallKey(toolCallsJSON)\n723\t\tp.reasoningCache.Store(fullKey, tcKey, reasoningContent)\n724\t\n725\t\tf, t := p.reasoningCache.Len()\n726\t\tlogger.Debug(\"proxy\", \"cached reasoning_content: rc_len=%d full=%d tc=%d\", len(reasoningContent), f, t)\n727\t}\n728\t\n729\t// rewriteModel 改写请求体 JSON 中的 model 字段（契约 3）。\n730\t// 如果 model 为空、body 为空、body 非 JSON 或 body 为 JSON 非对象，原样返回。\n731\tfunc rewriteModel(body []byte, parsed any, model string) []byte {\n732\t\tif model == \"\" || len(body) == 0 {\n733\t\t\treturn body\n734\t\t}\n735\t\n736\t\tm, ok := parsed.(map[string]any)\n737\t\tif !ok {\n738\t\t\treturn body // 非 JSON 或非对象\n739\t\t}\n740\t\n741\t\tm[\"model\"] = model\n742\t\trewritten, err := json.Marshal(m)\n743\t\tif err != nil {\n744\t\t\treturn body // 改写失败，原样返回\n745\t\t}\n746\t\treturn rewritten\n747\t}\n748\t\n749\t// injectReasoningContentCached 为 assistant tool_call 消息注入 reasoning_content 补丁。\n750\t//\n751\t// Kimi 等兼容 Anthropic 的端点要求：assistant tool_call 消息必须携带顶层字段 reasoning_content，\n752\t// 以及 content 数组中的 thinking 块。Claude Code 发送 tool_call 消息时不包含这些字段，导致上游 400 错误：\n753\t//\n754\t//\t400 thinking is enabled but reasoning_content is missing in assistant tool call message at index N\n755\t//\n756\t// 行为随 isKimi 参数变化：\n757\t//   - isKimi=false: 不做任何修改，直接透传\n758\t//   - isKimi=true + cache!=nil: 使用缓存的三级查找回填真实 reasoning_content\n759\t//   - isKimi=true + cache==nil: 注入空字符串（兜底行为，空字符串无害但能防止报错）\n760\tfunc injectReasoningContentCached(body []byte, parsed any, cache *ReasoningCache, isKimi bool) []byte {\n761\t\tif !isKimi {\n762\t\t\treturn body // 非 kimi 上游不做任何注入\n763\t\t}\n764\t\n765\t\tif len(body) == 0 {\n766\t\t\treturn body\n767\t\t}\n768\t\n769\t\tm, ok := parsed.(map[string]any)\n770\t\tif !ok {\n771\t\t\treturn body // 非 JSON 或非对象\n772\t\t}\n773\t\n774\t\t// 获取 messages 数组（无 messages 则无需处理）\n775\t\tmessages, ok := m[\"messages\"].([]any)\n776\t\tif !ok || len(messages) == 0 {\n777\t\t\treturn body\n778\t\t}\n779\t\n780\t\tmodified := false\n781\t\tfor i, msgRaw := range messages {\n782\t\t\tmsg, ok := msgRaw.(map[string]any)\n783\t\t\tif !ok {\n784\t\t\t\tcontinue\n785\t\t\t}\n786\t\n787\t\t\t// 只处理 assistant 消息\n788\t\t\trole, _ := msg[\"role\"].(string)\n789\t\t\tif role != \"assistant\" {\n790\t\t\t\tcontinue\n791\t\t\t}\n792\t\n793\t\t\t// 检查 content 是否为数组\n794\t\t\tcontent, ok := msg[\"content\"].([]any)\n795\t\t\tif !ok || len(content) == 0 {\n796\t\t\t\tcontinue\n797\t\t\t}\n798\t\n799\t\t\t// 检查是否有 tool_use 块、thinking 块、reasoning_content 字段\n800\t\t\thasToolUse := false\n801\t\t\thasThinking := false\n802\t\t\tfor _, blockRaw := range content {\n803\t\t\t\tblock, ok := blockRaw.(map[string]any)\n804\t\t\t\tif !ok {\n805\t\t\t\t\tcontinue\n806\t\t\t\t}\n807\t\t\t\tblockType, _ := block[\"type\"].(string)\n808\t\t\t\tif blockType == \"tool_use\" {\n809\t\t\t\t\thasToolUse = true\n810\t\t\t\t}\n811\t\t\t\tif blockType == \"thinking\" {\n812\t\t\t\t\thasThinking = true\n813\t\t\t\t}\n814\t\t\t}\n815\t\n816\t\t\t// 检查已有的 reasoning_content\n817\t\t\texistingRC, hasReasoningContent := msg[\"reasoning_content\"].(string)\n818\t\n819\t\t\t// 只处理含 tool_use 的 assistant 消息\n820\t\t\tif !hasToolUse {\n821\t\t\t\tcontinue\n822\t\t\t}\n823\t\n824\t\t\tneedPatch := false\n825\t\n826\t\t\t// 如果已有非空的 reasoning_content，用它刷新缓存\n827\t\t\tif hasReasoningContent && existingRC != \"\" && cache != nil {\n828\t\t\t\tfullKey := MakeFullKeyFromMsg(msg)\n829\t\t\t\ttcKey := MakeToolcallKeyFromMsg(msg)\n830\t\t\t\tcache.Store(fullKey, tcKey, existingRC)\n831\t\t\t\t// 已有完整 reasoning_content，不需要补丁\n832\t\t\t\t// 但仍需确保 thinking 块存在\n833\t\t\t}\n834\t\n835\t\t\t// 补丁 1: content 数组缺少 thinking 块 → 在开头插入\n836\t\t\tif !hasThinking {\n837\t\t\t\tthinkingBlock := map[string]any{\n838\t\t\t\t\t\"type\":     \"thinking\",\n839\t\t\t\t\t\"thinking\": \"\",\n840\t\t\t\t}\n841\t\t\t\tnewContent := make([]any, 0, len(content)+1)\n842\t\t\t\tnewContent = append(newContent, thinkingBlock)\n843\t\t\t\tnewContent = append(newContent, content...)\n844\t\t\t\tmsg[\"content\"] = newContent\n845\t\t\t\tneedPatch = true\n846\t\t\t}\n847\t\n848\t\t\t// 补丁 2: 消息缺少顶层 reasoning_content 字段 → 尝试从缓存回填\n849\t\t\tif !hasReasoningContent {\n850\t\t\t\trcValue := \"\" // 兜底空字符串\n851\t\t\t\tif cache != nil {\n852\t\t\t\t\tfullKey := MakeFullKeyFromMsg(msg)\n853\t\t\t\t\ttcKey := MakeToolcallKeyFromMsg(msg)\n854\t\t\t\t\tif cached, found := cache.Lookup(fullKey, tcKey, true); found {\n855\t\t\t\t\t\trcValue = cached\n856\t\t\t\t\t}\n857\t\t\t\t}\n858\t\t\t\tmsg[\"reasoning_content\"] = rcValue\n859\t\t\t\tneedPatch = true\n860\t\t\t}\n861\t\n862\t\t\tif needPatch {\n863\t\t\t\tmessages[i] = msg\n864\t\t\t\tmodified = true\n865\t\t\t}\n866\t\t}\n867\t\n868\t\tif !modified {\n869\t\t\treturn body\n870\t\t}\n871\t\n872\t\tm[\"messages\"] = messages\n873\t\trewritten, err := json.Marshal(m)\n874\t\tif err != nil {\n875\t\t\treturn body\n876\t\t}\n877\t\treturn rewritten\n878\t}\n879\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\tests\\backend\\session_api_test.go"},"tool_use_id":"call_d0c1163c253c43fbb3843d07","tool_response":"1\t// Package backend_test 包含后端 Session API 的验收测试，覆盖注册、关闭、列表、详情等接口。\n2\tpackage backend_test\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"database/sql\"\n7\t\t\"encoding/json\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"net/http\"\n11\t\t\"net/http/httptest\"\n12\t\t\"os\"\n13\t\t\"strings\"\n14\t\t\"testing\"\n15\t\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n19\t)\n20\t\n21\t// --- Session test helpers ---\n22\t\n23\t// sessionTestEnv 是 Session 测试的专用环境，包含测试服务器、存储和数据库连接。\n24\ttype sessionTestEnv struct {\n25\t\tsrv   *httptest.Server\n26\t\tstore *store.SQLiteStore\n27\t\tdb    *sql.DB\n28\t}\n29\t\n30\t// setupSessionTest 创建 Session 测试环境，自动注册 Issue 和 Session 路由。\n31\tfunc setupSessionTest(t *testing.T) *sessionTestEnv {\n32\t\tt.Helper()\n33\t\n34\t\tf, err := os.CreateTemp(\"\", \"test-session-*.db\")\n35\t\tif err != nil {\n36\t\t\tt.Fatal(err)\n37\t\t}\n38\t\tdbPath := f.Name()\n39\t\tf.Close()\n40\t\n41\t\ts, err := store.NewSQLiteStore(dbPath)\n42\t\tif err != nil {\n43\t\t\tos.Remove(dbPath)\n44\t\t\tt.Fatal(err)\n45\t\t}\n46\t\n47\t\tt.Cleanup(func() {\n48\t\t\ts.Close()\n49\t\t\tos.Remove(dbPath)\n50\t\t})\n51\t\n52\t\tissueSvc := service.NewIssueService(s.Issues())\n53\t\tsessionSvc := service.NewSessionService(s.Sessions())\n54\t\trouter := api.NewRouter(api.Handlers{\n55\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n56\t\t\tSession: api.NewSessionHandler(sessionSvc, issueSvc, service.NewTokenService(s.Sessions()), service.NewTraceService(s.Sessions())),\n57\t\t})\n58\t\n59\t\tsrv := httptest.NewServer(router)\n60\t\tt.Cleanup(srv.Close)\n61\t\n62\t\treturn &sessionTestEnv{srv: srv, store: s, db: s.DB()}\n63\t}\n64\t\n65\t// post 发送 POST 请求到 Session 测试环境。\n66\tfunc (e *sessionTestEnv) post(t *testing.T, path, body string) *http.Response {\n67\t\tt.Helper()\n68\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n69\t\tif err != nil {\n70\t\t\tt.Fatal(err)\n71\t\t}\n72\t\treturn resp\n73\t}\n74\t\n75\t// get 发送 GET 请求到 Session 测试环境。\n76\tfunc (e *sessionTestEnv) get(t *testing.T, path string) *http.Response {\n77\t\tt.Helper()\n78\t\tresp, err := http.Get(e.srv.URL + path)\n79\t\tif err != nil {\n80\t\t\tt.Fatal(err)\n81\t\t}\n82\t\treturn resp\n83\t}\n84\t\n85\t// sessionReadJSON 读取 HTTP 响应并解析为 JSON。\n86\tfunc sessionReadJSON(t *testing.T, resp *http.Response, v any) {\n87\t\tt.Helper()\n88\t\tdefer resp.Body.Close()\n89\t\tb, err := io.ReadAll(resp.Body)\n90\t\tif err != nil {\n91\t\t\tt.Fatal(err)\n92\t\t}\n93\t\tif err := json.Unmarshal(b, v); err != nil {\n94\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n95\t\t}\n96\t}\n97\t\n98\t// --- Register tests ---\n99\t\n100\t// TestSessionRegister 验证 Session 注册接口。\n101\t// 覆盖成功写入 machines/projects/sessions 三张表、重复注册返回 409、必填字段校验、JSON 格式校验、方法限制。\n102\tfunc TestSessionRegister(t *testing.T) {\n103\t\tt.Run(\"success_writes_three_tables\", func(t *testing.T) {\n104\t\t\tenv := setupSessionTest(t)\n105\t\n106\t\t\tresp := env.post(t, \"/api/session/register\", `{\n107\t\t\t\t\"session_id\": \"sess-001\",\n108\t\t\t\t\"machine_id\": \"admin@host1\",\n109\t\t\t\t\"os\": \"windows\",\n110\t\t\t\t\"project_slug\": \"test-project\",\n111\t\t\t\t\"project_cwd\": \"C:\\\\Projects\\\\test\",\n112\t\t\t\t\"transcript_path\": \"C:\\\\Users\\\\.claude\\\\transcript.jsonl\",\n113\t\t\t\t\"model\": \"GLM-5.1\",\n114\t\t\t\t\"source\": \"startup\"\n115\t\t\t}`)\n116\t\n117\t\t\tvar result map[string]string\n118\t\t\tsessionReadJSON(t, resp, &result)\n119\t\n120\t\t\tif resp.StatusCode != http.StatusOK {\n121\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n122\t\t\t}\n123\t\t\tif result[\"status\"] != \"registered\" {\n124\t\t\t\tt.Errorf(\"expected status=registered, got %s\", result[\"status\"])\n125\t\t\t}\n126\t\n127\t\t\t// 验证 machines 表\n128\t\t\tvar machineCount int\n129\t\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM machines WHERE machine_id = 'admin@host1'\").Scan(&machineCount)\n130\t\t\tif machineCount != 1 {\n131\t\t\t\tt.Errorf(\"expected 1 machine row, got %d\", machineCount)\n132\t\t\t}\n133\t\t\tvar username, hostname string\n134\t\t\tenv.db.QueryRow(\"SELECT username, hostname FROM machines WHERE machine_id = 'admin@host1'\").Scan(&username, &hostname)\n135\t\t\tif username != \"admin\" {\n136\t\t\t\tt.Errorf(\"expected username=admin, got %s\", username)\n137\t\t\t}\n138\t\t\tif hostname != \"host1\" {\n139\t\t\t\tt.Errorf(\"expected hostname=host1, got %s\", hostname)\n140\t\t\t}\n141\t\n142\t\t\t// 验证 projects 表\n143\t\t\tvar projectCount int\n144\t\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM projects WHERE project_slug = 'test-project'\").Scan(&projectCount)\n145\t\t\tif projectCount != 1 {\n146\t\t\t\tt.Errorf(\"expected 1 project row, got %d\", projectCount)\n147\t\t\t}\n148\t\n149\t\t\t// 验证 sessions 表\n150\t\t\tvar sessionStatus, sessMachineID, sessProject string\n151\t\t\tenv.db.QueryRow(\"SELECT status, machine_id, project_slug FROM sessions WHERE session_id = 'sess-001'\").\n152\t\t\t\tScan(&sessionStatus, &sessMachineID, &sessProject)\n153\t\t\tif sessionStatus != \"active\" {\n154\t\t\t\tt.Errorf(\"expected active, got %s\", sessionStatus)\n155\t\t\t}\n156\t\t\tif sessMachineID != \"admin@host1\" {\n157\t\t\t\tt.Errorf(\"expected admin@host1, got %s\", sessMachineID)\n158\t\t\t}\n159\t\t\tif sessProject != \"test-project\" {\n160\t\t\t\tt.Errorf(\"expected test-project, got %s\", sessProject)\n161\t\t\t}\n162\t\t})\n163\t\n164\t\tt.Run(\"duplicate_returns_409\", func(t *testing.T) {\n165\t\t\tenv := setupSessionTest(t)\n166\t\n167\t\t\tbody := `{\"session_id\":\"sess-dup\",\"machine_id\":\"admin@host1\",\"os\":\"windows\",\"project_slug\":\"proj\",\"project_cwd\":\"/proj\",\"transcript_path\":\"/t.jsonl\"}`\n168\t\t\tenv.post(t, \"/api/session/register\", body)\n169\t\n170\t\t\tresp := env.post(t, \"/api/session/register\", body)\n171\t\n172\t\t\tvar errResp struct {\n173\t\t\t\tCode    string `json:\"error\"`\n174\t\t\t\tMessage string `json:\"message\"`\n175\t\t\t}\n176\t\t\tsessionReadJSON(t, resp, &errResp)\n177\t\n178\t\t\tif resp.StatusCode != http.StatusConflict {\n179\t\t\t\tt.Fatalf(\"expected 409, got %d\", resp.StatusCode)\n180\t\t\t}\n181\t\t\tif errResp.Code != \"session_exists\" {\n182\t\t\t\tt.Errorf(\"expected error=session_exists, got %s\", errResp.Code)\n183\t\t\t}\n184\t\t})\n185\t\n186\t\tt.Run(\"missing_required_fields_returns_400\", func(t *testing.T) {\n187\t\t\tenv := setupSessionTest(t)\n188\t\n189\t\t\tcases := []struct {\n190\t\t\t\tname string\n191\t\t\t\tbody string\n192\t\t\t}{\n193\t\t\t\t{\"missing_session_id\", `{\"machine_id\":\"m\",\"os\":\"windows\",\"project_slug\":\"p\",\"project_cwd\":\"/p\",\"transcript_path\":\"/t\"}`},\n194\t\t\t\t{\"missing_machine_id\", `{\"session_id\":\"s\",\"os\":\"windows\",\"project_slug\":\"p\",\"project_cwd\":\"/p\",\"transcript_path\":\"/t\"}`},\n195\t\t\t\t{\"missing_project_slug\", `{\"session_id\":\"s\",\"machine_id\":\"m\",\"os\":\"windows\",\"project_cwd\":\"/p\",\"transcript_path\":\"/t\"}`},\n196\t\t\t\t{\"missing_transcript_path\", `{\"session_id\":\"s\",\"machine_id\":\"m\",\"os\":\"windows\",\"project_slug\":\"p\",\"project_cwd\":\"/p\"}`},\n197\t\t\t}\n198\t\n199\t\t\tfor _, tc := range cases {\n200\t\t\t\tt.Run(tc.name, func(t *testing.T) {\n201\t\t\t\t\tresp := env.post(t, \"/api/session/register\", tc.body)\n202\t\t\t\t\tif resp.StatusCode != http.StatusBadRequest {\n203\t\t\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n204\t\t\t\t\t}\n205\t\t\t\t})\n206\t\t\t}\n207\t\t})\n208\t\n209\t\tt.Run(\"invalid_json_returns_400\", func(t *testing.T) {\n210\t\t\tenv := setupSessionTest(t)\n211\t\t\tresp := env.post(t, \"/api/session/register\", \"not json\")\n212\t\t\tif resp.StatusCode != http.StatusBadRequest {\n213\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n214\t\t\t}\n215\t\t})\n216\t\n217\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n218\t\t\tenv := setupSessionTest(t)\n219\t\t\tresp, err := http.Get(env.srv.URL + \"/api/session/register\")\n220\t\t\tif err != nil {\n221\t\t\t\tt.Fatal(err)\n222\t\t\t}\n223\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n224\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n225\t\t\t}\n226\t\t})\n227\t\n228\t\tt.Run(\"machine_id_update_last_seen\", func(t *testing.T) {\n229\t\t\tenv := setupSessionTest(t)\n230\t\n231\t\t\t// 注册第一个 session\n232\t\t\tenv.post(t, \"/api/session/register\", `{\n233\t\t\t\t\"session_id\":\"sess-a\",\"machine_id\":\"admin@host1\",\"os\":\"windows\",\n234\t\t\t\t\"project_slug\":\"proj-a\",\"project_cwd\":\"/a\",\"transcript_path\":\"/ta.jsonl\"}`)\n235\t\n236\t\t\t// 用相同 machine_id 注册第二个 session\n237\t\t\tenv.post(t, \"/api/session/register\", `{\n238\t\t\t\t\"session_id\":\"sess-b\",\"machine_id\":\"admin@host1\",\"os\":\"windows\",\n239\t\t\t\t\"project_slug\":\"proj-b\",\"project_cwd\":\"/b\",\"transcript_path\":\"/tb.jsonl\"}`)\n240\t\n241\t\t\t// machine 表应只有 1 行\n242\t\t\tvar count int\n243\t\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM machines WHERE machine_id = 'admin@host1'\").Scan(&count)\n244\t\t\tif count != 1 {\n245\t\t\t\tt.Errorf(\"expected 1 machine row, got %d\", count)\n246\t\t\t}\n247\t\n248\t\t\t// last_seen_at 应被更新\n249\t\t\tvar lastSeen sql.NullString\n250\t\t\tenv.db.QueryRow(\"SELECT last_seen_at FROM machines WHERE machine_id = 'admin@host1'\").Scan(&lastSeen)\n251\t\t\tif !lastSeen.Valid {\n252\t\t\t\tt.Error(\"expected last_seen_at to be set\")\n253\t\t\t}\n254\t\t})\n255\t}\n256\t\n257\t// --- Close tests ---\n258\t\n259\t// TestSessionClose 验证 Session 关闭接口。\n260\t// 覆盖成功关闭、不存在返回 404、重复关闭返回 404、缺少参数返回 400、方法限制。\n261\tfunc TestSessionClose(t *testing.T) {\n262\t\tt.Run(\"success\", func(t *testing.T) {\n263\t\t\tenv := setupSessionTest(t)\n264\t\t\tregisterSession(t, env, \"sess-close-1\")\n265\t\n266\t\t\tresp := env.post(t, \"/api/session/close\",\n267\t\t\t\t`{\"session_id\":\"sess-close-1\",\"reason\":\"prompt_input_exit\"}`)\n268\t\n269\t\t\tvar result map[string]string\n270\t\t\tsessionReadJSON(t, resp, &result)\n271\t\n272\t\t\tif resp.StatusCode != http.StatusOK {\n273\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n274\t\t\t}\n275\t\t\tif result[\"status\"] != \"closed\" {\n276\t\t\t\tt.Errorf(\"expected status=closed, got %s\", result[\"status\"])\n277\t\t\t}\n278\t\n279\t\t\t// 验证数据库\n280\t\t\tvar status, reason string\n281\t\t\tenv.db.QueryRow(\"SELECT status, close_reason FROM sessions WHERE session_id = 'sess-close-1'\").Scan(&status, &reason)\n282\t\t\tif status != \"closed\" {\n283\t\t\t\tt.Errorf(\"expected closed, got %s\", status)\n284\t\t\t}\n285\t\t\tif reason != \"prompt_input_exit\" {\n286\t\t\t\tt.Errorf(\"expected prompt_input_exit, got %s\", reason)\n287\t\t\t}\n288\t\t})\n289\t\n290\t\tt.Run(\"not_found_returns_404\", func(t *testing.T) {\n291\t\t\tenv := setupSessionTest(t)\n292\t\n293\t\t\tresp := env.post(t, \"/api/session/close\",\n294\t\t\t\t`{\"session_id\":\"nonexistent\",\"reason\":\"exit\"}`)\n295\t\n296\t\t\tif resp.StatusCode != http.StatusNotFound {\n297\t\t\t\tt.Fatalf(\"expected 404, got %d\", resp.StatusCode)\n298\t\t\t}\n299\t\t})\n300\t\n301\t\tt.Run(\"already_closed_returns_404\", func(t *testing.T) {\n302\t\t\tenv := setupSessionTest(t)\n303\t\t\tregisterSession(t, env, \"sess-dbl-close\")\n304\t\n305\t\t\tenv.post(t, \"/api/session/close\",\n306\t\t\t\t`{\"session_id\":\"sess-dbl-close\",\"reason\":\"first\"}`)\n307\t\n308\t\t\tresp := env.post(t, \"/api/session/close\",\n309\t\t\t\t`{\"session_id\":\"sess-dbl-close\",\"reason\":\"second\"}`)\n310\t\n311\t\t\tif resp.StatusCode != http.StatusNotFound {\n312\t\t\t\tt.Fatalf(\"expected 404, got %d\", resp.StatusCode)\n313\t\t\t}\n314\t\t})\n315\t\n316\t\tt.Run(\"missing_session_id_returns_400\", func(t *testing.T) {\n317\t\t\tenv := setupSessionTest(t)\n318\t\t\tresp := env.post(t, \"/api/session/close\", `{}`)\n319\t\t\tif resp.StatusCode != http.StatusBadRequest {\n320\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n321\t\t\t}\n322\t\t})\n323\t\n324\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n325\t\t\tenv := setupSessionTest(t)\n326\t\t\tresp, err := http.Get(env.srv.URL + \"/api/session/close\")\n327\t\t\tif err != nil {\n328\t\t\t\tt.Fatal(err)\n329\t\t\t}\n330\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n331\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n332\t\t\t}\n333\t\t})\n334\t}\n335\t\n336\t// --- List tests ---\n337\t\n338\t// TestSessionList 验证 Session 列表查询接口。\n339\t// 覆盖全部查询、按 machine_id 过滤、按 status 过滤、按 project_slug 过滤、空结果、方法限制。\n340\tfunc TestSessionList(t *testing.T) {\n341\t\tseedSessions := func(t *testing.T, env *sessionTestEnv) {\n342\t\t\tregisterSession(t, env, \"sess-list-1\")\n343\t\t\tregisterSessionWith(t, env, \"sess-list-2\", \"other@host2\", \"linux\", \"proj-b\", \"/b\")\n344\t\t\tregisterSessionWith(t, env, \"sess-list-3\", \"admin@host1\", \"windows\", \"proj-a\", \"/a\")\n345\t\t\t// 关闭第三个 session\n346\t\t\tenv.post(t, \"/api/session/close\", `{\"session_id\":\"sess-list-3\",\"reason\":\"done\"}`)\n347\t\t}\n348\t\n349\t\tt.Run(\"all_sessions\", func(t *testing.T) {\n350\t\t\tenv := setupSessionTest(t)\n351\t\t\tseedSessions(t, env)\n352\t\n353\t\t\tresp := env.get(t, \"/api/sessions\")\n354\t\n355\t\t\tvar result struct {\n356\t\t\t\tSessions []struct {\n357\t\t\t\t\tSessionID string `json:\"session_id\"`\n358\t\t\t\t\tStatus    string `json:\"status\"`\n359\t\t\t\t} `json:\"sessions\"`\n360\t\t\t}\n361\t\t\tsessionReadJSON(t, resp, &result)\n362\t\n363\t\t\tif resp.StatusCode != http.StatusOK {\n364\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n365\t\t\t}\n366\t\t\tif len(result.Sessions) != 3 {\n367\t\t\t\tt.Fatalf(\"expected 3 sessions, got %d\", len(result.Sessions))\n368\t\t\t}\n369\t\t})\n370\t\n371\t\tt.Run(\"filter_by_machine_id\", func(t *testing.T) {\n372\t\t\tenv := setupSessionTest(t)\n373\t\t\tseedSessions(t, env)\n374\t\n375\t\t\tresp := env.get(t, \"/api/sessions?machine_id=other@host2\")\n376\t\n377\t\t\tvar result struct {\n378\t\t\t\tSessions []struct {\n379\t\t\t\t\tSessionID string `json:\"session_id\"`\n380\t\t\t\t} `json:\"sessions\"`\n381\t\t\t}\n382\t\t\tsessionReadJSON(t, resp, &result)\n383\t\n384\t\t\tif len(result.Sessions) != 1 {\n385\t\t\t\tt.Fatalf(\"expected 1 session, got %d\", len(result.Sessions))\n386\t\t\t}\n387\t\t\tif result.Sessions[0].SessionID != \"sess-list-2\" {\n388\t\t\t\tt.Errorf(\"expected sess-list-2, got %s\", result.Sessions[0].SessionID)\n389\t\t\t}\n390\t\t})\n391\t\n392\t\tt.Run(\"filter_by_status_active\", func(t *testing.T) {\n393\t\t\tenv := setupSessionTest(t)\n394\t\t\tseedSessions(t, env)\n395\t\n396\t\t\tresp := env.get(t, \"/api/sessions?status=active\")\n397\t\n398\t\t\tvar result struct {\n399\t\t\t\tSessions []struct {\n400\t\t\t\t\tSessionID string `json:\"session_id\"`\n401\t\t\t\t\tStatus    string `json:\"status\"`\n402\t\t\t\t} `json:\"sessions\"`\n403\t\t\t}\n404\t\t\tsessionReadJSON(t, resp, &result)\n405\t\n406\t\t\tif len(result.Sessions) != 2 {\n407\t\t\t\tt.Fatalf(\"expected 2 active sessions, got %d\", len(result.Sessions))\n408\t\t\t}\n409\t\t\tfor _, s := range result.Sessions {\n410\t\t\t\tif s.Status != \"active\" {\n411\t\t\t\t\tt.Errorf(\"expected active, got %s\", s.Status)\n412\t\t\t\t}\n413\t\t\t}\n414\t\t})\n415\t\n416\t\tt.Run(\"filter_by_project_slug\", func(t *testing.T) {\n417\t\t\tenv := setupSessionTest(t)\n418\t\t\tseedSessions(t, env)\n419\t\n420\t\t\tresp := env.get(t, \"/api/sessions?project_slug=proj-b\")\n421\t\n422\t\t\tvar result struct {\n423\t\t\t\tSessions []struct {\n424\t\t\t\t\tSessionID string `json:\"session_id\"`\n425\t\t\t\t} `json:\"sessions\"`\n426\t\t\t}\n427\t\t\tsessionReadJSON(t, resp, &result)\n428\t\n429\t\t\tif len(result.Sessions) != 1 {\n430\t\t\t\tt.Fatalf(\"expected 1 session, got %d\", len(result.Sessions))\n431\t\t\t}\n432\t\t})\n433\t\n434\t\tt.Run(\"empty_result\", func(t *testing.T) {\n435\t\t\tenv := setupSessionTest(t)\n436\t\n437\t\t\tresp := env.get(t, \"/api/sessions\")\n438\t\n439\t\t\tvar result struct {\n440\t\t\t\tSessions []any `json:\"sessions\"`\n441\t\t\t}\n442\t\t\tsessionReadJSON(t, resp, &result)\n443\t\n444\t\t\tif len(result.Sessions) != 0 {\n445\t\t\t\tt.Fatalf(\"expected 0 sessions, got %d\", len(result.Sessions))\n446\t\t\t}\n447\t\t})\n448\t\n449\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n450\t\t\tenv := setupSessionTest(t)\n451\t\t\tresp := env.post(t, \"/api/sessions\", \"\")\n452\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n453\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n454\t\t\t}\n455\t\t})\n456\t}\n457\t\n458\t// --- Get tests ---\n459\t\n460\t// TestSessionGet 验证 Session 详情查询接口。\n461\t// 覆盖现有 session 查询、不存在返回 404、已关闭 session 包含关闭字段、方法限制。\n462\tfunc TestSessionGet(t *testing.T) {\n463\t\tt.Run(\"existing_session\", func(t *testing.T) {\n464\t\t\tenv := setupSessionTest(t)\n465\t\t\tregisterSession(t, env, \"sess-get-1\")\n466\t\n467\t\t\tresp := env.get(t, \"/api/session/sess-get-1\")\n468\t\n469\t\t\tvar result struct {\n470\t\t\t\tSessionID      string `json:\"session_id\"`\n471\t\t\t\tMachineID      string `json:\"machine_id\"`\n472\t\t\t\tOS             string `json:\"os\"`\n473\t\t\t\tProjectSlug    string `json:\"project_slug\"`\n474\t\t\t\tProjectCwd     string `json:\"project_cwd\"`\n475\t\t\t\tTranscriptPath string `json:\"transcript_path\"`\n476\t\t\t\tModel          string `json:\"model\"`\n477\t\t\t\tSource         string `json:\"source\"`\n478\t\t\t\tStatus         string `json:\"status\"`\n479\t\t\t}\n480\t\t\tsessionReadJSON(t, resp, &result)\n481\t\n482\t\t\tif resp.StatusCode != http.StatusOK {\n483\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n484\t\t\t}\n485\t\t\tif result.SessionID != \"sess-get-1\" {\n486\t\t\t\tt.Errorf(\"expected sess-get-1, got %s\", result.SessionID)\n487\t\t\t}\n488\t\t\tif result.Status != \"active\" {\n489\t\t\t\tt.Errorf(\"expected active, got %s\", result.Status)\n490\t\t\t}\n491\t\t\tif result.MachineID != \"admin@host1\" {\n492\t\t\t\tt.Errorf(\"expected admin@host1, got %s\", result.MachineID)\n493\t\t\t}\n494\t\t\tif result.TranscriptPath == \"\" {\n495\t\t\t\tt.Error(\"expected non-empty transcript_path\")\n496\t\t\t}\n497\t\t})\n498\t\n499\t\tt.Run(\"not_found\", func(t *testing.T) {\n500\t\t\tenv := setupSessionTest(t)\n501\t\t\tresp := env.get(t, \"/api/session/nonexistent\")\n502\t\n503\t\t\tif resp.StatusCode != http.StatusNotFound {\n504\t\t\t\tt.Fatalf(\"expected 404, got %d\", resp.StatusCode)\n505\t\t\t}\n506\t\t})\n507\t\n508\t\tt.Run(\"closed_session_has_close_fields\", func(t *testing.T) {\n509\t\t\tenv := setupSessionTest(t)\n510\t\t\tregisterSession(t, env, \"sess-closed-detail\")\n511\t\t\tenv.post(t, \"/api/session/close\",\n512\t\t\t\t`{\"session_id\":\"sess-closed-detail\",\"reason\":\"prompt_input_exit\"}`)\n513\t\n514\t\t\tresp := env.get(t, \"/api/session/sess-closed-detail\")\n515\t\n516\t\t\tvar result struct {\n517\t\t\t\tStatus      string  `json:\"status\"`\n518\t\t\t\tCloseReason string  `json:\"close_reason\"`\n519\t\t\t\tClosedAt    *string `json:\"closed_at\"`\n520\t\t\t}\n521\t\t\tsessionReadJSON(t, resp, &result)\n522\t\n523\t\t\tif result.Status != \"closed\" {\n524\t\t\t\tt.Errorf(\"expected closed, got %s\", result.Status)\n525\t\t\t}\n526\t\t\tif result.CloseReason != \"prompt_input_exit\" {\n527\t\t\t\tt.Errorf(\"expected prompt_input_exit, got %s\", result.CloseReason)\n528\t\t\t}\n529\t\t\tif result.ClosedAt == nil {\n530\t\t\t\tt.Error(\"expected closed_at to be set\")\n531\t\t\t}\n532\t\t})\n533\t\n534\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n535\t\t\tenv := setupSessionTest(t)\n536\t\t\tresp := env.post(t, \"/api/session/some-id\", \"\")\n537\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n538\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n539\t\t\t}\n540\t\t})\n541\t}\n542\t\n543\t// --- Timeout cleanup tests ---\n544\t\n545\t// TestCleanupTimedOutSessions 验证：超时会话自动清理功能。\n546\t// 注册超过 24 小时的 stale session 应被标记为 closed，新 session 不受影响。\n547\tfunc TestCleanupTimedOutSessions(t *testing.T) {\n548\t\tt.Run(\"marks_stale_sessions_closed\", func(t *testing.T) {\n549\t\t\tenv := setupSessionTest(t)\n550\t\n551\t\t\t// 插入一个 25 小时前的 session\n552\t\t\tenv.db.Exec(`INSERT INTO sessions (session_id, machine_id, os, project_slug, project_cwd,\n553\t\t\t\ttranscript_path, status, registered_at)\n554\t\t\t\tVALUES ('stale-sess', 'admin@host', 'linux', 'proj', '/p', '/t.jsonl', 'active',\n555\t\t\t\tdatetime('now', '-25 hours'))`)\n556\t\n557\t\t\tsvc := service.NewCleanupService(env.store.Sessions())\n558\t\t\tsvc.CleanupTimedOutSessions(context.Background())\n559\t\n560\t\t\tvar status, reason string\n561\t\t\tenv.db.QueryRow(\"SELECT status, close_reason FROM sessions WHERE session_id = 'stale-sess'\").Scan(&status, &reason)\n562\t\t\tif status != \"closed\" {\n563\t\t\t\tt.Errorf(\"expected closed, got %s\", status)\n564\t\t\t}\n565\t\t\tif reason != \"timeout_cleanup\" {\n566\t\t\t\tt.Errorf(\"expected timeout_cleanup, got %s\", reason)\n567\t\t\t}\n568\t\t})\n569\t\n570\t\tt.Run(\"recent_sessions_untouched\", func(t *testing.T) {\n571\t\t\tenv := setupSessionTest(t)\n572\t\t\tregisterSession(t, env, \"fresh-sess\")\n573\t\n574\t\t\tsvc := service.NewCleanupService(env.store.Sessions())\n575\t\t\tsvc.CleanupTimedOutSessions(context.Background())\n576\t\n577\t\t\tvar status string\n578\t\t\tenv.db.QueryRow(\"SELECT status FROM sessions WHERE session_id = 'fresh-sess'\").Scan(&status)\n579\t\t\tif status != \"active\" {\n580\t\t\t\tt.Errorf(\"expected active, got %s\", status)\n581\t\t\t}\n582\t\t})\n583\t}\n584\t\n585\t// --- Full lifecycle test ---\n586\t\n587\t// TestSessionFullLifecycle 验证 Session 的完整生命周期。\n588\t// 覆盖注册 → 获取详情 → 列表过滤 → 关闭 → 验证关闭 → 重复关闭。\n589\tfunc TestSessionFullLifecycle(t *testing.T) {\n590\t\tenv := setupSessionTest(t)\n591\t\n592\t\t// 1. 注册\n593\t\tresp := env.post(t, \"/api/session/register\", fmt.Sprintf(`{\n594\t\t\t\"session_id\": \"lifecycle-1\",\n595\t\t\t\"machine_id\": \"admin@host1\",\n596\t\t\t\"os\": \"windows\",\n597\t\t\t\"project_slug\": \"proj-lifecycle\",\n598\t\t\t\"project_cwd\": \"/proj\",\n599\t\t\t\"transcript_path\": \"/t.jsonl\",\n600\t\t\t\"model\": \"GLM-5.1\",\n601\t\t\t\"source\": \"startup\",\n602\t\t\t\"local_trace_path\": \"/traces/lifecycle-1.jsonl\"\n603\t\t}`))\n604\t\tif resp.StatusCode != http.StatusOK {\n605\t\t\tt.Fatalf(\"step 1 register: expected 200, got %d\", resp.StatusCode)\n606\t\t}\n607\t\n608\t\t// 2. 获取详情\n609\t\tresp = env.get(t, \"/api/session/lifecycle-1\")\n610\t\tvar detail struct {\n611\t\t\tStatus         string `json:\"status\"`\n612\t\t\tModel          string `json:\"model\"`\n613\t\t\tLocalTracePath string `json:\"local_trace_path\"`\n614\t\t}\n615\t\tsessionReadJSON(t, resp, &detail)\n616\t\tif detail.Status != \"active\" {\n617\t\t\tt.Fatalf(\"step 2 get: expected active, got %s\", detail.Status)\n618\t\t}\n619\t\tif detail.Model != \"GLM-5.1\" {\n620\t\t\tt.Errorf(\"step 2 get: expected model=GLM-5.1, got %s\", detail.Model)\n621\t\t}\n622\t\tif detail.LocalTracePath != \"/traces/lifecycle-1.jsonl\" {\n623\t\t\tt.Errorf(\"step 2 get: expected local_trace_path set, got %s\", detail.LocalTracePath)\n624\t\t}\n625\t\n626\t\t// 3. 带过滤条件的列表查询\n627\t\tresp = env.get(t, \"/api/sessions?status=active&machine_id=admin@host1\")\n628\t\tvar list struct {\n629\t\t\tSessions []struct {\n630\t\t\t\tSessionID string `json:\"session_id\"`\n631\t\t\t} `json:\"sessions\"`\n632\t\t}\n633\t\tsessionReadJSON(t, resp, &list)\n634\t\tif len(list.Sessions) != 1 {\n635\t\t\tt.Fatalf(\"step 3 list: expected 1, got %d\", len(list.Sessions))\n636\t\t}\n637\t\n638\t\t// 4. 关闭 session\n639\t\tresp = env.post(t, \"/api/session/close\",\n640\t\t\t`{\"session_id\":\"lifecycle-1\",\"reason\":\"prompt_input_exit\"}`)\n641\t\tif resp.StatusCode != http.StatusOK {\n642\t\t\tt.Fatalf(\"step 4 close: expected 200, got %d\", resp.StatusCode)\n643\t\t}\n644\t\n645\t\t// 5. 验证已关闭\n646\t\tresp = env.get(t, \"/api/session/lifecycle-1\")\n647\t\tsessionReadJSON(t, resp, &detail)\n648\t\tif detail.Status != \"closed\" {\n649\t\t\tt.Fatalf(\"step 5 verify: expected closed, got %s\", detail.Status)\n650\t\t}\n651\t\n652\t\t// 6. 重复关闭返回 404\n653\t\tresp = env.post(t, \"/api/session/close\",\n654\t\t\t`{\"session_id\":\"lifecycle-1\",\"reason\":\"again\"}`)\n655\t\tif resp.StatusCode != http.StatusNotFound {\n656\t\t\tt.Fatalf(\"step 6 double close: expected 404, got %d\", resp.StatusCode)\n657\t\t}\n658\t}\n659\t\n660\t// --- Helpers ---\n661\t\n662\t// registerSession 用默认参数注册一个 session。\n663\tfunc registerSession(t *testing.T, env *sessionTestEnv, sessionID string) {\n664\t\tt.Helper()\n665\t\tregisterSessionWith(t, env, sessionID, \"admin@host1\", \"windows\", \"proj-a\", \"/a\")\n666\t}\n667\t\n668\t// registerSessionWith 使用指定参数注册一个 session。\n669\tfunc registerSessionWith(t *testing.T, env *sessionTestEnv, sessionID, machineID, osName, projectSlug, projectCwd string) {\n670\t\tt.Helper()\n671\t\tbody := fmt.Sprintf(`{\n672\t\t\t\"session_id\": \"%s\",\n673\t\t\t\"machine_id\": \"%s\",\n674\t\t\t\"os\": \"%s\",\n675\t\t\t\"project_slug\": \"%s\",\n676\t\t\t\"project_cwd\": \"%s\",\n677\t\t\t\"transcript_path\": \"/transcripts/%s.jsonl\"\n678\t\t}`, sessionID, machineID, osName, projectSlug, projectCwd, sessionID)\n679\t\tresp := env.post(t, \"/api/session/register\", body)\n680\t\tif resp.StatusCode != http.StatusOK {\n681\t\t\tt.Fatalf(\"register session %s: expected 200, got %d\", sessionID, resp.StatusCode)\n682\t\t}\n683\t}\n684\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\main.go"},"tool_use_id":"call_69ac9cd79c484049b048f1a9","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"log\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"os/signal\"\n9\t\t\"strconv\"\n10\t\t\"strings\"\n11\t\t\"syscall\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/config\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/proxy\"\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/session\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n19\t)\n20\t\n21\t// main 是 claude-tap-plus 的入口函数，负责解析子命令并分发到对应处理函数。\n22\t//\n23\t// 支持的子命令：\n24\t//   session-push    收集本地 Claude 会话到存储\n25\t//   session-pull    从存储恢复会话到 ~/.claude/\n26\t//   session-status  显示会话存储状态\n27\t//   backend         启动后端服务器模式\n28\t//   help            显示使用帮助\n29\t//\n30\t// 无子命令时默认进入代理模式（拦截 Claude Code API 流量）。\n31\tfunc main() {\n32\t\t// 设置日志格式：仅显示时间（含微秒）\n33\t\tlog.SetFlags(log.Ltime | log.Lmicroseconds)\n34\t\n35\t\t// 初始化文件日志器（使用默认 trace 目录）\n36\t\tlogDir := trace.DefaultTraceDir()\n37\t\tif err := logger.Init(logDir, false, logger.INFO); err != nil {\n38\t\t\tlog.Printf(\"warning: logger init failed: %v\", err)\n39\t\t}\n40\t\tdefer logger.Close()\n41\t\n42\t\t// 检测子命令，如果第一个参数是已知子命令则分发执行\n43\t\tif len(os.Args) > 1 {\n44\t\t\tswitch os.Args[1] {\n45\t\t\tcase \"session-push\":\n46\t\t\t\trunSessionPush(os.Args[2:])\n47\t\t\t\treturn\n48\t\t\tcase \"session-pull\":\n49\t\t\t\trunSessionPull(os.Args[2:])\n50\t\t\t\treturn\n51\t\t\tcase \"session-status\":\n52\t\t\t\trunSessionStatus(os.Args[2:])\n53\t\t\t\treturn\n54\t\t\tcase \"backend\":\n55\t\t\t\trunBackend(os.Args[2:])\n56\t\t\t\treturn\n57\t\t\tcase \"help\", \"--help\", \"-h\":\n58\t\t\t\tprintUsage()\n59\t\t\t\treturn\n60\t\t\t}\n61\t\t}\n62\t\n63\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n64\t\trunProxy(os.Args[1:])\n65\t}\n66\t\n67\t// printUsage 打印命令行使用帮助信息到标准输出。\n68\tfunc printUsage() {\n69\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n70\t\tfmt.Println()\n71\t\tfmt.Println(\"Usage:\")\n72\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n73\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n74\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n75\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n76\t\tfmt.Println()\n77\t\tfmt.Println(\"Proxy flags:\")\n78\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n79\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n80\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n81\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n82\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n83\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n84\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n85\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n86\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n87\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n88\t\tfmt.Println()\n89\t\tfmt.Println(\"Session-push flags:\")\n90\t\tfmt.Println(\"  --all                  Collect all projects\")\n91\t\tfmt.Println(\"  --force                Overwrite existing files\")\n92\t\tfmt.Println(\"  --dry-run              Preview only\")\n93\t\tfmt.Println(\"  --project NAME         Override project name\")\n94\t\tfmt.Println()\n95\t\tfmt.Println(\"Session-pull flags:\")\n96\t\tfmt.Println(\"  --all                  Restore all projects\")\n97\t\tfmt.Println(\"  --project NAME         Override project name\")\n98\t\tfmt.Println(\"  --dry-run              Preview only\")\n99\t\tfmt.Println()\n100\t\tfmt.Println(\"Session-status flags:\")\n101\t\tfmt.Println(\"  --verbose              Show file-level details\")\n102\t}\n103\t\n104\t// runProxy 是默认的代理模式主逻辑。\n105\t//\n106\t// 工作流程：\n107\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n108\t//  2. 自动探测上游 API 目标地址\n109\t//  3. 启动本地反向代理监听指定端口\n110\t//  4. 解析 Claude Code 可执行文件路径\n111\t//  5. 构建子进程环境变量（注入代理地址）\n112\t//  6. 启动 Claude Code 作为子进程\n113\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n114\t//  8. 子进程退出后打印 API 调用统计摘要\n115\tfunc runProxy(args []string) {\n116\t\t// 记录原始命令行参数，用于生成 resume 命令\n117\t\toriginalArgs := append([]string{}, args...)\n118\t\n119\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n120\t\tvar (\n121\t\t\ttapTarget    string // 上游 API 目标地址\n122\t\t\ttapPort      int    // 本地代理监听端口\n123\t\t\ttapOutputDir string // 追踪记录输出目录\n124\t\t\ttapVerbose   bool   // 是否启用详细日志\n125\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n126\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n127\t\t\ttapAPIKey    string // 直接传入 API Key\n128\t\t\ttapAuthToken string // 直接传入 OAuth Token\n129\t\t\ttapBaseURL   string // 直接传入上游地址\n130\t\t)\n131\t\n132\t\tvar claudeArgs []string\n133\t\tfor i := 0; i < len(args); i++ {\n134\t\t\targ := args[i]\n135\t\t\tswitch {\n136\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n137\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n138\t\t\t\ti++\n139\t\t\t\ttapTarget = args[i]\n140\t\t\t// 解析 --tap-target=URL 形式\n141\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n142\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n143\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n144\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n145\t\t\t\ti++\n146\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n147\t\t\t// 解析 --tap-port=PORT 形式\n148\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n149\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n150\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n151\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n152\t\t\t\ti++\n153\t\t\t\ttapOutputDir = args[i]\n154\t\t\t// 解析 --tap-output-dir=DIR 形式\n155\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n156\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n157\t\t\t// 启用详细日志\n158\t\t\tcase arg == \"--tap-verbose\":\n159\t\t\t\ttapVerbose = true\n160\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n161\t\t\tcase arg == \"--tap-console\":\n162\t\t\t\ttapConsole = true\n163\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n164\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n165\t\t\t\ti++\n166\t\t\t\ttapProfile = args[i]\n167\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n168\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n169\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n170\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n171\t\t\t\ti++\n172\t\t\t\ttapAPIKey = args[i]\n173\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n174\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n175\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n176\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n177\t\t\t\ti++\n178\t\t\t\ttapAuthToken = args[i]\n179\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n180\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n181\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n182\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n183\t\t\t\ti++\n184\t\t\t\ttapBaseURL = args[i]\n185\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n186\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n187\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n188\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n189\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n190\t\t\t\ti = len(args) // 停止解析\n191\t\t\t// 未知的 --tap-* 标志，直接忽略\n192\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n193\t\t\t// 其他参数视为 Claude Code 的参数\n194\t\t\tdefault:\n195\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n196\t\t\t}\n197\t\t}\n198\t\n199\t\t// 如果未指定输出目录，使用默认追踪目录\n200\t\tif tapOutputDir == \"\" {\n201\t\t\ttapOutputDir = trace.DefaultTraceDir()\n202\t\t}\n203\t\n204\t\t// 校验：--tap-console 必须配合 --tap-verbose\n205\t\tif tapConsole && !tapVerbose {\n206\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n207\t\t\tos.Exit(1)\n208\t\t}\n209\t\n210\t\t// 根据详细程度重新初始化日志器\n211\t\tif tapVerbose {\n212\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n213\t\t} else {\n214\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n215\t\t}\n216\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n217\t\n218\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n219\t\tresolved, err := config.ResolveTargetConfig(\n220\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n221\t\t\ttapAPIKey,\n222\t\t\ttapAuthToken,\n223\t\t\ttapProfile,\n224\t\t\t&config.ClaudeClient,\n225\t\t)\n226\t\tif err != nil {\n227\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n228\t\t}\n229\t\ttarget := resolved.BaseURL\n230\t\tif tapVerbose {\n231\t\t\tlog.Printf(\"upstream target: %s\", target)\n232\t\t}\n233\t\n234\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n235\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n236\t\n237\t\t// 设置 model 改写（契约 2：resolved.Model 优先级链）\n238\t\trp.SetModel(resolved.Model)\n239\t\n240\t\t// 检测是否为 kimi 上游，启用 reasoning_content 缓存\n241\t\tif proxy.IsKimiURL(resolved.BaseURL) {\n242\t\t\trp.SetKimiMode(true)\n243\t\t}\n244\t\n245\t\t// 加载兜底配置（契约 4：从 Claude settings 读取）\n246\t\tif fallback := loadFallbackConfig(); fallback != nil {\n247\t\t\trp.SetFallbackConfig(fallback)\n248\t\t}\n249\t\n250\t\tport := tapPort\n251\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n252\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n253\t\tif err != nil {\n254\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n255\t\t}\n256\t\t// 函数退出时停止代理\n257\t\tdefer rp.Stop()\n258\t\n259\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n260\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n261\t\n262\t\t// 自动检测并启动后端服务（如果未运行）\n263\t\tensureBackend()\n264\t\n265\t\t// 向后端注册本代理（hooks 通过环境变量直连 proxy，backend 用于 session/issue 管理）\n266\t\tregisterProxyWithBackend(proxyURL)\n267\t\t// 代理退出时注销\n268\t\tdefer unregisterProxyFromBackend()\n269\t\n270\t\t// 设置会话初始化回调：注册到 proxy.json\n271\t\trp.OnSessionInit = func(sessionID, projectSlug string) {\n272\t\t\tkey := ProxySessionKey(projectSlug, sessionID)\n273\t\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\n274\t\t\t\tlogger.Warn(\"main\", \"register proxy session failed: %v\", err)\n275\t\t\t}\n276\t\t}\n277\t\t// 代理退出时注销 proxy.json 中的会话\n278\t\tdefer func() {\n279\t\t\tif sid := rp.SessionID(); sid != \"\" {\n280\t\t\t\tslug := rp.ProjectSlug()\n281\t\t\t\tkey := ProxySessionKey(slug, sid)\n282\t\t\t\tif err := UnregisterProxySession(key); err != nil {\n283\t\t\t\t\tlogger.Warn(\"main\", \"unregister proxy session failed: %v\", err)\n284\t\t\t\t}\n285\t\t\t}\n286\t\t}()\n287\t\n288\t\t// 解析 Claude Code 可执行文件路径\n289\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n290\t\tif err != nil {\n291\t\t\tlog.Fatal(err)\n292\t\t}\n293\t\n294\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n295\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n296\t\n297\t\t// 注入代理 PID 和 URL 到子进程环境（hook 直接 curl proxy，无需 backend 中转）\n298\t\tchildEnv = append(childEnv, \"CLAUDE_TAP_PROXY_PID=\"+strconv.Itoa(os.Getpid()))\n299\t\tchildEnv = append(childEnv, \"CLAUDE_TAP_PROXY_URL=\"+proxyURL)\n300\t\n301\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n302\t\tif resolved.APIKey != \"\" {\n303\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n304\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n305\t\t} else if resolved.AuthToken != \"\" {\n306\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n307\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n308\t\t}\n309\t\n310\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n311\t\tfinalArgs := claudeArgs\n312\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n313\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n314\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n315\t\t}\n316\t\n317\t\t// 启动 Claude Code 作为子进程\n318\t\tcmd := exec.Command(claudePath, finalArgs...)\n319\t\tcmd.Env = childEnv\n320\t\tcmd.Stdin = os.Stdin\n321\t\tcmd.Stdout = os.Stdout\n322\t\tcmd.Stderr = os.Stderr\n323\t\n324\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n325\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n326\t\n327\t\tif err := cmd.Start(); err != nil {\n328\t\t\tlog.Fatalf(\"start claude: %v\", err)\n329\t\t}\n330\t\n331\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n332\t\tsigChan := make(chan os.Signal, 2)\n333\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n334\t\n335\t\tgo func() {\n336\t\t\tsigCount := 0\n337\t\t\tfor sig := range sigChan {\n338\t\t\t\tsigCount++\n339\t\t\t\tif sigCount == 1 {\n340\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n341\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n342\t\t\t\t\t_ = cmd.Process.Signal(sig)\n343\t\t\t\t} else {\n344\t\t\t\t\t// 再次收到信号：强制终止子进程\n345\t\t\t\t\t_ = cmd.Process.Kill()\n346\t\t\t\t}\n347\t\t\t}\n348\t\t}()\n349\t\n350\t\t// 等待子进程结束\n351\t\twaitErr := cmd.Wait()\n352\t\n353\t\t// 停止信号处理器，释放资源\n354\t\tsignal.Stop(sigChan)\n355\t\tclose(sigChan)\n356\t\n357\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n358\t\tsummary := rp.Summary()\n359\t\ttracePath := rp.TracePath()\n360\t\n361\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n362\t\tif waitErr != nil {\n363\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n364\t\t}\n365\t\tfmt.Printf(\"\\n\")\n366\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n367\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n368\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n369\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n370\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n371\t\tif tracePath != \"\" {\n372\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n373\t\t}\n374\t\tfmt.Printf(\"\\n\")\n375\t\n376\t\t// 生成 Resume 命令（仅在有 session_id 时）\n377\t\tsessionID := rp.SessionID()\n378\t\tif sessionID != \"\" {\n379\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n380\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n381\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n382\t\t}\n383\t}\n384\t\n385\t// loadFallbackConfig 从 Claude settings 加载兜底配置（契约 4）。\n386\t// 读取 ~/.claude/settings.json 中的 base_url、model、认证信息作为 fallback。\n387\tfunc loadFallbackConfig() *proxy.FallbackConfig {\n388\t\ts, err := config.ReadClaudeSettings()\n389\t\tif err != nil || s == nil {\n390\t\t\treturn nil\n391\t\t}\n392\t\n393\t\tbaseURL := s.Env.AnthropicBaseURL\n394\t\tif baseURL == \"\" {\n395\t\t\tbaseURL = config.ClaudeClient.DefaultTarget\n396\t\t}\n397\t\n398\t\treturn &proxy.FallbackConfig{\n399\t\t\tBaseURL:   baseURL,\n400\t\t\tModel:     s.Model,\n401\t\t\tAuthToken: s.Env.AnthropicAuthToken,\n402\t\t\tAPIKey:    s.Env.AnthropicAPIKey,\n403\t\t}\n404\t}\n405\t\n406\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n407\t//\n408\t// 支持的参数：\n409\t//   --all       收集所有项目的会话\n410\t//   --force     覆盖已存在的会话文件\n411\t//   --dry-run   仅预览，不实际执行\n412\t//   --project   指定项目名称，覆盖自动检测\n413\tfunc runSessionPush(args []string) {\n414\t\tvar opts session.PushOptions\n415\t\tfor i := 0; i < len(args); i++ {\n416\t\t\targ := args[i]\n417\t\t\tswitch {\n418\t\t\tcase arg == \"--all\":\n419\t\t\t\topts.All = true\n420\t\t\tcase arg == \"--force\":\n421\t\t\t\topts.Force = true\n422\t\t\tcase arg == \"--dry-run\":\n423\t\t\t\topts.DryRun = true\n424\t\t\tcase arg == \"--project\" && i+1 < len(args):\n425\t\t\t\ti++\n426\t\t\t\topts.Project = args[i]\n427\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n428\t\t\t\topts.Project = arg[len(\"--project=\"):]\n429\t\t\t}\n430\t\t}\n431\t\n432\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n433\t\tresults, err := session.SessionPush(opts)\n434\t\tif err != nil {\n435\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n436\t\t\tos.Exit(1)\n437\t\t}\n438\t\n439\t\t// 汇总各项目的收集结果\n440\t\tfmt.Println()\n441\t\ttotalNew, totalSkipped := 0, 0\n442\t\tfor _, r := range results {\n443\t\t\ttotalNew += r.SessionsNew\n444\t\t\ttotalSkipped += r.SessionsSkipped\n445\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n446\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n447\t\t\t}\n448\t\t}\n449\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n450\t}\n451\t\n452\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n453\t//\n454\t// 支持的参数：\n455\t//   --all       恢复所有项目的会话\n456\t//   --dry-run   仅预览，不实际执行\n457\t//   --project   指定项目名称，覆盖自动检测\n458\tfunc runSessionPull(args []string) {\n459\t\tvar opts session.PullOptions\n460\t\tfor i := 0; i < len(args); i++ {\n461\t\t\targ := args[i]\n462\t\t\tswitch {\n463\t\t\tcase arg == \"--all\":\n464\t\t\t\topts.All = true\n465\t\t\tcase arg == \"--dry-run\":\n466\t\t\t\topts.DryRun = true\n467\t\t\tcase arg == \"--project\" && i+1 < len(args):\n468\t\t\t\ti++\n469\t\t\t\topts.Project = args[i]\n470\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n471\t\t\t\topts.Project = arg[len(\"--project=\"):]\n472\t\t\t}\n473\t\t}\n474\t\n475\t\tfmt.Println(\"📤 Restoring sessions...\")\n476\t\tresults, err := session.SessionPull(opts)\n477\t\tif err != nil {\n478\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n479\t\t\tos.Exit(1)\n480\t\t}\n481\t\n482\t\t// 汇总各项目的恢复结果\n483\t\tfmt.Println()\n484\t\ttotalRestored, totalSkipped := 0, 0\n485\t\tfor _, r := range results {\n486\t\t\ttotalRestored += r.SessionsRestored\n487\t\t\ttotalSkipped += r.SessionsSkipped\n488\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n489\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n490\t\t\t}\n491\t\t}\n492\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n493\t}\n494\t\n495\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n496\t//\n497\t// 支持的参数：\n498\t//   --verbose   显示文件级别的详细信息\n499\tfunc runSessionStatus(args []string) {\n500\t\tvar opts session.StatusOptions\n501\t\tfor i := 0; i < len(args); i++ {\n502\t\t\targ := args[i]\n503\t\t\tswitch {\n504\t\t\tcase arg == \"--verbose\":\n505\t\t\t\topts.Verbose = true\n506\t\t\t}\n507\t\t}\n508\t\n509\t\tif err := session.SessionStatus(opts); err != nil {\n510\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n511\t\t\tos.Exit(1)\n512\t\t}\n513\t}\n514\t\n515\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n516\t// 如果参数中包含空格或制表符，则使用引号包裹。\n517\tfunc formatArgs(args []string) string {\n518\t\tresult := \"\"\n519\t\tfor _, a := range args {\n520\t\t\tif containsSpace(a) {\n521\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n522\t\t\t} else {\n523\t\t\t\tresult += \" \" + a\n524\t\t\t}\n525\t\t}\n526\t\treturn strings.TrimSpace(result)\n527\t}\n528\t\n529\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n530\tfunc containsSpace(s string) bool {\n531\t\tfor _, c := range s {\n532\t\t\tif c == ' ' || c == '\\t' {\n533\t\t\t\treturn true\n534\t\t\t}\n535\t\t}\n536\t\treturn false\n537\t}\n538\t\n539\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n540\tfunc firstNonEmpty(ss ...string) string {\n541\t\tfor _, s := range ss {\n542\t\t\tif s != \"\" {\n543\t\t\t\treturn s\n544\t\t\t}\n545\t\t}\n546\t\treturn \"\"\n547\t}\n548\t\n549\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n550\t//\n551\t// 逻辑：\n552\t//  1. 复制原始参数\n553\t//  2. 移除已有的 --resume <old-id>（如果存在）\n554\t//  3. 追加 --resume <new-session-id>\n555\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n556\t\tfiltered := make([]string, 0, len(originalArgs))\n557\t\tskip := false\n558\t\tfor i, arg := range originalArgs {\n559\t\t\tif skip {\n560\t\t\t\tskip = false\n561\t\t\t\tcontinue\n562\t\t\t}\n563\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n564\t\t\t\tskip = true // 跳过 --resume 及其值\n565\t\t\t\tcontinue\n566\t\t\t}\n567\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n568\t\t\t\tcontinue // 跳过 --resume=id 形式\n569\t\t\t}\n570\t\t\tfiltered = append(filtered, arg)\n571\t\t}\n572\t\tfiltered = append(filtered, \"--resume\", sessionID)\n573\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n574\t}\n575\t\n576\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n577\tfunc shortenPath(path string) string {\n578\t\thome, err := os.UserHomeDir()\n579\t\tif err != nil {\n580\t\t\treturn path\n581\t\t}\n582\t\tif strings.HasPrefix(path, home) {\n583\t\t\treturn \"~\" + path[len(home):]\n584\t\t}\n585\t\treturn path\n586\t}\n587\t\n588\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n589\tfunc removeEnvVar(env []string, name string) []string {\n590\t\tprefix := name + \"=\"\n591\t\tresult := make([]string, 0, len(env))\n592\t\tfor _, e := range env {\n593\t\t\tif !strings.HasPrefix(e, prefix) {\n594\t\t\t\tresult = append(result, e)\n595\t\t\t}\n596\t\t}\n597\t\treturn result\n598\t}\n599\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\sse\\reassembler.go"},"tool_use_id":"call_9194b99c89094d85921808d3","tool_response":"1\tpackage sse\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/usage\"\n11\t)\n12\t\n13\t// SSEReassembler 解析原始 SSE（Server-Sent Events）字节流，并将流式片段重组成完整的 API 响应。\n14\t//\n15\t// 支持的协议：\n16\t//   - Anthropic Messages API Streaming\n17\t//   - OpenAI Chat Completions Streaming\n18\t//   - OpenAI Responses API Streaming\n19\t//\n20\t// 使用方式：\n21\t//\n22\t//\tr := sse.NewSSEReassembler()\n23\t//\tr.FeedBytes(chunk)       // 多次调用，分块送入 SSE 数据\n24\t//\tsnapshot := r.Reconstruct() // 获取当前累积的完整响应快照\n25\t//\tevents := r.Events       // 获取所有解析出的原始事件列表\n26\ttype SSEReassembler struct {\n27\t\tEvents   []map[string]any // 解析出的所有原始 SSE 事件列表\n28\t\tbuf      []byte           // 未处理完的 SSE 字节缓冲区\n29\t\tcurEv    *string          // 当前正在解析的事件类型（event: xxx）\n30\t\tcurData  []string         // 当前事件的 data 行累积（支持多行 data）\n31\t\tsnap     map[string]any   // 重建后的完整响应快照\n32\t\tfedOnce  bool             // 是否已接收过首块数据（用于首次日志）\n33\t}\n34\t\n35\t// NewSSEReassembler 创建一个新的 SSE 重组器实例。\n36\tfunc NewSSEReassembler() *SSEReassembler {\n37\t\treturn &SSEReassembler{}\n38\t}\n39\t\n40\t// FeedBytes 追加原始 SSE 字节数据并处理已完整的行。\n41\t//\n42\t// 该方法按 \\n 分割输入数据，逐行解析 SSE 协议中的 event、data 字段，\n43\t// 遇到空行时触发事件生成并调用累积逻辑更新快照。\n44\t// 可以多次调用以处理分块传输的数据。\n45\tfunc (r *SSEReassembler) FeedBytes(chunk []byte) {\n46\t\tif !r.fedOnce {\n47\t\t\tlogger.Debug(\"sse\", \"FeedBytes: first chunk size=%d\", len(chunk))\n48\t\t\tr.fedOnce = true\n49\t\t}\n50\t\tr.buf = append(r.buf, chunk...)\n51\t\tfor {\n52\t\t\tidx := bytes.IndexByte(r.buf, '\\n')\n53\t\t\tif idx < 0 {\n54\t\t\t\tbreak\n55\t\t\t}\n56\t\t\tline := r.buf[:idx]\n57\t\t\tr.buf = r.buf[idx+1:]\n58\t\t\tr.feedLine(string(line))\n59\t\t}\n60\t}\n61\t\n62\t// Reconstruct 返回当前累积的消息快照。\n63\t//\n64\t// 如果尚未收到足够的事件来构建快照（如仅收到部分 SSE 帧），则返回 nil。\n65\tfunc (r *SSEReassembler) Reconstruct() map[string]any {\n66\t\treturn r.snap\n67\t}\n68\t\n69\t// feedLine 处理单条 SSE 文本行，解析 event、data 和空行分隔符。\n70\t//\n71\t// SSE 协议规则：\n72\t//   - 以 \"event:\" 开头的行设置当前事件类型\n73\t//   - 以 \"data:\" 开头的行追加到当前事件的数据 payload\n74\t//   - 空行表示当前事件结束，触发事件生成\n75\t//   - \"[DONE]\" 是 OpenAI 的流结束标记，直接忽略\n76\tfunc (r *SSEReassembler) feedLine(line string) {\n77\t\tline = strings.TrimRight(line, \"\\r\")\n78\t\n79\t\tif strings.HasPrefix(line, \"event:\") {\n80\t\t\tev := strings.TrimSpace(line[len(\"event:\"):])\n81\t\t\tr.curEv = &ev\n82\t\t\tr.curData = nil\n83\t\t} else if strings.HasPrefix(line, \"data:\") {\n84\t\t\tr.curData = append(r.curData, strings.TrimSpace(line[len(\"data:\"):]))\n85\t\t} else if line == \"\" {\n86\t\t\t// 空行触发事件：如果既没有 event 也没有 data 则跳过\n87\t\t\tif r.curEv == nil && len(r.curData) == 0 {\n88\t\t\t\treturn\n89\t\t\t}\n90\t\t\traw := strings.Join(r.curData, \"\\n\")\n91\t\n92\t\t\t// 跳过 OpenAI 的 [DONE] 哨兵标记\n93\t\t\tif raw == \"[DONE]\" && r.curEv == nil {\n94\t\t\t\tr.curEv = nil\n95\t\t\t\tr.curData = nil\n96\t\t\t\treturn\n97\t\t\t}\n98\t\n99\t\t\tvar data any\n100\t\t\tif err := json.Unmarshal([]byte(raw), &data); err != nil {\n101\t\t\t\tdata = raw\n102\t\t\t}\n103\t\n104\t\t\tevType := \"message\"\n105\t\t\tif r.curEv != nil {\n106\t\t\t\tevType = *r.curEv\n107\t\t\t}\n108\t\t\tr.addEvent(evType, data)\n109\t\t\tr.curEv = nil\n110\t\t\tr.curData = nil\n111\t\t}\n112\t}\n113\t\n114\t// addEvent 将解析出的单个 SSE 事件追加到事件列表，并触发累积更新。\n115\tfunc (r *SSEReassembler) addEvent(eventType string, data any) {\n116\t\tr.Events = append(r.Events, map[string]any{\"event\": eventType, \"data\": data})\n117\t\tr.accumulate(eventType, data)\n118\t}\n119\t\n120\t// accumulate 按事件类型将流式片段累积到响应快照中。\n121\t//\n122\t// 支持的事件类型及处理逻辑：\n123\t//   - message_start:      初始化快照为 message 对象\n124\t//   - response.created/completed/done: OpenAI Responses API，初始化或更新快照\n125\t//   - message:            OpenAI Chat Completions 流，调用 accumulateChatCompletionChunk\n126\t//   - content_block_start: 向快照 content 数组添加新的内容块\n127\t//   - content_block_delta: 更新指定索引的内容块（文本、推理、JSON 片段）\n128\t//   - content_block_stop:  将累积的 partial_json 解析为 input 字段\n129\t//   - message_delta:       更新 message 级别的 delta（如 stop_reason）和 usage\n130\tfunc (r *SSEReassembler) accumulate(eventType string, data any) {\n131\t\tm, ok := data.(map[string]any)\n132\t\tif !ok {\n133\t\t\treturn\n134\t\t}\n135\t\n136\t\tswitch eventType {\n137\t\tcase \"message_start\":\n138\t\t\tif msg, ok := m[\"message\"].(map[string]any); ok {\n139\t\t\t\tr.snap = deepCopy(msg)\n140\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_start, model=%v\", msg[\"model\"])\n141\t\t\t}\n142\t\n143\t\tcase \"response.created\", \"response.completed\", \"response.done\":\n144\t\t\tif resp, ok := m[\"response\"].(map[string]any); ok {\n145\t\t\t\tr.snap = deepCopy(resp)\n146\t\t\t} else if eventType == \"response.completed\" || eventType == \"response.done\" {\n147\t\t\t\tr.snap = deepCopy(m)\n148\t\t\t}\n149\t\n150\t\tcase \"message\":\n151\t\t\tif _, hasChoices := m[\"choices\"]; hasChoices {\n152\t\t\t\tr.accumulateChatCompletionChunk(m)\n153\t\t\t\treturn\n154\t\t\t}\n155\t\n156\t\tcase \"content_block_start\":\n157\t\t\tif r.snap == nil {\n158\t\t\t\treturn\n159\t\t\t}\n160\t\t\tblock := deepCopy(m[\"content_block\"].(map[string]any))\n161\t\t\tidx := int(float64Val(m[\"index\"]))\n162\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_start idx=%d type=%v\", idx, block[\"type\"])\n163\t\t\tif _, ok := r.snap[\"content\"]; !ok {\n164\t\t\t\tr.snap[\"content\"] = []any{}\n165\t\t\t}\n166\t\t\tcontent := r.snap[\"content\"].([]any)\n167\t\t\tfor len(content) <= idx {\n168\t\t\t\tcontent = append(content, map[string]any{})\n169\t\t\t}\n170\t\t\tcontent[idx] = block\n171\t\t\tr.snap[\"content\"] = content\n172\t\n173\t\tcase \"content_block_delta\":\n174\t\t\tif r.snap == nil {\n175\t\t\t\treturn\n176\t\t\t}\n177\t\t\tidx := int(float64Val(m[\"index\"]))\n178\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n179\t\t\tif delta == nil {\n180\t\t\t\treturn\n181\t\t\t}\n182\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n183\t\t\tif idx >= len(content) {\n184\t\t\t\treturn\n185\t\t\t}\n186\t\t\tblock, _ := content[idx].(map[string]any)\n187\t\t\tif block == nil {\n188\t\t\t\treturn\n189\t\t\t}\n190\t\t\tswitch delta[\"type\"] {\n191\t\t\tcase \"text_delta\":\n192\t\t\t\tblock[\"text\"] = strVal(block[\"text\"]) + strVal(delta[\"text\"])\n193\t\t\tcase \"thinking_delta\":\n194\t\t\t\tblock[\"thinking\"] = strVal(block[\"thinking\"]) + strVal(delta[\"thinking\"])\n195\t\t\tcase \"input_json_delta\":\n196\t\t\t\tblock[\"_partial_json\"] = strVal(block[\"_partial_json\"]) + strVal(delta[\"partial_json\"])\n197\t\t\t}\n198\t\n199\t\tcase \"content_block_stop\":\n200\t\t\tif r.snap == nil {\n201\t\t\t\treturn\n202\t\t\t}\n203\t\t\tidx := int(float64Val(m[\"index\"]))\n204\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n205\t\t\tif idx >= len(content) {\n206\t\t\t\treturn\n207\t\t\t}\n208\t\t\tblock, _ := content[idx].(map[string]any)\n209\t\t\tif block == nil {\n210\t\t\t\treturn\n211\t\t\t}\n212\t\t\t// 将累积的 JSON 字符串片段解析为结构化的 input 字段\n213\t\t\tif pj, ok := block[\"_partial_json\"]; ok {\n214\t\t\t\tvar parsed any\n215\t\t\t\tif json.Unmarshal([]byte(strVal(pj)), &parsed) == nil {\n216\t\t\t\t\tblock[\"input\"] = parsed\n217\t\t\t\t}\n218\t\t\t\tdelete(block, \"_partial_json\")\n219\t\t\t}\n220\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_stop idx=%d\", idx)\n221\t\n222\t\tcase \"message_delta\":\n223\t\t\tif r.snap == nil {\n224\t\t\t\treturn\n225\t\t\t}\n226\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n227\t\t\tif delta != nil {\n228\t\t\t\tfor k, v := range delta {\n229\t\t\t\t\tr.snap[k] = v\n230\t\t\t\t}\n231\t\t\t}\n232\t\t\tif u, ok := m[\"usage\"].(map[string]any); ok {\n233\t\t\t\tif _, exists := r.snap[\"usage\"]; !exists {\n234\t\t\t\t\tr.snap[\"usage\"] = map[string]any{}\n235\t\t\t\t}\n236\t\t\t\texisting := r.snap[\"usage\"].(map[string]any)\n237\t\t\t\tfor k, v := range u {\n238\t\t\t\t\texisting[k] = v\n239\t\t\t\t}\n240\t\t\t}\n241\t\t\tif delta != nil {\n242\t\t\t\tif sr, ok := delta[\"stop_reason\"]; ok && sr != nil {\n243\t\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_delta stop_reason=%v\", sr)\n244\t\t\t\t}\n245\t\t\t}\n246\t\t}\n247\t}\n248\t\n249\t// --- OpenAI Chat Completions 流式累积 ---\n250\t\n251\t// accumulateChatCompletionChunk 处理 OpenAI Chat Completions Streaming 的单个 chunk。\n252\t//\n253\t// 该函数将 choices[0].delta 中的内容逐块累积，同时处理：\n254\t//   - role、content、reasoning_content 的拼接\n255\t//   - tool_calls 的渐进式构建（id、name、arguments 分块到达）\n256\t//   - usage 信息的合并\n257\t//   - finish_reason 的更新\n258\t//\n259\t// 快照结构兼容 Anthropic 格式，content 数组中会同时维护文本块和工具调用块。\n260\tfunc (r *SSEReassembler) accumulateChatCompletionChunk(data map[string]any) {\n261\t\tchoices, _ := data[\"choices\"].([]any)\n262\t\trawUsage, _ := data[\"usage\"]\n263\t\n264\t\tif len(choices) == 0 {\n265\t\t\tif u, ok := rawUsage.(map[string]any); ok && r.snap != nil {\n266\t\t\t\tr.mergeChatUsage(u)\n267\t\t\t}\n268\t\t\treturn\n269\t\t}\n270\t\n271\t\tchoice, _ := choices[0].(map[string]any)\n272\t\tif choice == nil {\n273\t\t\treturn\n274\t\t}\n275\t\tdelta, _ := choice[\"delta\"].(map[string]any)\n276\t\tfinishReason := choice[\"finish_reason\"]\n277\t\tchoiceUsage, _ := choice[\"usage\"].(map[string]any)\n278\t\n279\t\t// 首个 chunk 时初始化快照\n280\t\tif r.snap == nil {\n281\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk init, model=%s\", strVal(data[\"model\"]))\n282\t\t\tr.snap = map[string]any{\n283\t\t\t\t\"id\":     strVal(data[\"id\"]),\n284\t\t\t\t\"object\": \"chat.completion\",\n285\t\t\t\t\"model\":  strVal(data[\"model\"]),\n286\t\t\t\t\"choices\": []any{\n287\t\t\t\t\tmap[string]any{\n288\t\t\t\t\t\t\"index\":         0,\n289\t\t\t\t\t\t\"message\":       map[string]any{\"role\": strVal(fieldStr(delta, \"role\")), \"content\": \"\"},\n290\t\t\t\t\t\t\"finish_reason\": nil,\n291\t\t\t\t\t},\n292\t\t\t\t},\n293\t\t\t\t\"content\": []any{map[string]any{\"type\": \"text\", \"text\": \"\"}},\n294\t\t\t}\n295\t\t\tif role := strVal(fieldStr(delta, \"role\")); role == \"\" {\n296\t\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)[\"role\"] = \"assistant\"\n297\t\t\t}\n298\t\t}\n299\t\n300\t\tmsg := r.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n301\t\ttextBlock := r.chatTextBlock()\n302\t\n303\t\tif role := strVal(fieldStr(delta, \"role\")); role != \"\" {\n304\t\t\tmsg[\"role\"] = role\n305\t\t}\n306\t\tif rc := strVal(fieldStr(delta, \"reasoning_content\")); rc != \"\" {\n307\t\t\tmsg[\"reasoning_content\"] = strVal(msg[\"reasoning_content\"]) + rc\n308\t\t\tr.mirrorReasoning(strVal(msg[\"reasoning_content\"]))\n309\t\t}\n310\t\tif c := strVal(fieldStr(delta, \"content\")); c != \"\" {\n311\t\t\tmsg[\"content\"] = strVal(msg[\"content\"]) + c\n312\t\t\ttextBlock[\"text\"] = strVal(textBlock[\"text\"]) + c\n313\t\t}\n314\t\n315\t\t// 工具调用增量处理\n316\t\tfor _, tcRaw := range sliceField(delta, \"tool_calls\") {\n317\t\t\ttcDelta, _ := tcRaw.(map[string]any)\n318\t\t\tif tcDelta == nil {\n319\t\t\t\tcontinue\n320\t\t\t}\n321\t\t\tidx := int(float64Val(tcDelta[\"index\"]))\n322\t\t\ttoolCalls, _ := msg[\"tool_calls\"].([]any)\n323\t\t\tif toolCalls == nil {\n324\t\t\t\ttoolCalls = []any{}\n325\t\t\t}\n326\t\t\tfor len(toolCalls) <= idx {\n327\t\t\t\ttoolCalls = append(toolCalls, map[string]any{\n328\t\t\t\t\t\"id\":   \"\",\n329\t\t\t\t\t\"type\": \"function\",\n330\t\t\t\t\t\"function\": map[string]any{\n331\t\t\t\t\t\t\"name\":      \"\",\n332\t\t\t\t\t\t\"arguments\": \"\",\n333\t\t\t\t\t},\n334\t\t\t\t})\n335\t\t\t}\n336\t\t\texisting := toolCalls[idx].(map[string]any)\n337\t\t\tif id := strVal(tcDelta[\"id\"]); id != \"\" {\n338\t\t\t\texisting[\"id\"] = id\n339\t\t\t}\n340\t\t\tif t := strVal(tcDelta[\"type\"]); t != \"\" {\n341\t\t\t\texisting[\"type\"] = t\n342\t\t\t}\n343\t\t\tif fnDelta, ok := tcDelta[\"function\"].(map[string]any); ok {\n344\t\t\t\tfn, _ := existing[\"function\"].(map[string]any)\n345\t\t\t\tif fn == nil {\n346\t\t\t\t\tfn = map[string]any{\"name\": \"\", \"arguments\": \"\"}\n347\t\t\t\t}\n348\t\t\t\tif n := strVal(fnDelta[\"name\"]); n != \"\" {\n349\t\t\t\t\tfn[\"name\"] = strVal(fn[\"name\"]) + n\n350\t\t\t\t}\n351\t\t\t\tif a := strVal(fnDelta[\"arguments\"]); a != \"\" {\n352\t\t\t\t\tfn[\"arguments\"] = strVal(fn[\"arguments\"]) + a\n353\t\t\t\t}\n354\t\t\t\texisting[\"function\"] = fn\n355\t\t\t}\n356\t\t\ttoolCalls[idx] = existing\n357\t\t\tmsg[\"tool_calls\"] = toolCalls\n358\t\t\tr.mirrorToolCall(idx, existing)\n359\t\t}\n360\t\n361\t\tif finishReason != nil && finishReason != \"\" {\n362\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"finish_reason\"] = finishReason\n363\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk finish_reason=%v\", finishReason)\n364\t\t}\n365\t\n366\t\tif u, ok := rawUsage.(map[string]any); ok {\n367\t\t\tr.mergeChatUsage(u)\n368\t\t}\n369\t\tif choiceUsage != nil {\n370\t\t\tr.mergeChatUsage(choiceUsage)\n371\t\t}\n372\t}\n373\t\n374\t// chatTextBlock 获取或创建快照中的文本内容块。\n375\t// 返回 content 数组中第一个 type=\"text\" 的块；如果不存在则新建一个。\n376\tfunc (r *SSEReassembler) chatTextBlock() map[string]any {\n377\t\tcontent := r.snap[\"content\"].([]any)\n378\t\tfor _, b := range content {\n379\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"text\" {\n380\t\t\t\treturn block\n381\t\t\t}\n382\t\t}\n383\t\tblock := map[string]any{\"type\": \"text\", \"text\": \"\"}\n384\t\tr.snap[\"content\"] = append(content, block)\n385\t\treturn block\n386\t}\n387\t\n388\t// mirrorReasoning 将 reasoning_content 同步到 content 数组中的 thinking 块。\n389\t// 如果 content 中不存在 thinking 块，则在开头插入一个。\n390\tfunc (r *SSEReassembler) mirrorReasoning(reasoning string) {\n391\t\tcontent := r.snap[\"content\"].([]any)\n392\t\tfor _, b := range content {\n393\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n394\t\t\t\tblock[\"thinking\"] = reasoning\n395\t\t\t\treturn\n396\t\t\t}\n397\t\t}\n398\t\tblock := map[string]any{\"type\": \"thinking\", \"thinking\": reasoning}\n399\t\tr.snap[\"content\"] = append([]any{block}, content...)\n400\t}\n401\t\n402\t// mirrorToolCall 将 Chat Completions 的 tool_call 同步到 Anthropic 格式的 content 数组中。\n403\t//\n404\t// 同步规则：\n405\t//   - 在 content 数组中查找或创建对应的 tool_use 块\n406\t//   - 将 function name 映射为 tool_use 的 name\n407\t//   - 将 arguments JSON 解析后映射为 tool_use 的 input\n408\t//   - thinking 块的存在会影响工具调用块在 content 中的索引偏移\n409\tfunc (r *SSEReassembler) mirrorToolCall(idx int, tc map[string]any) {\n410\t\tcontent := r.snap[\"content\"].([]any)\n411\t\t// 如果存在 thinking 块，工具调用的位置需要偏移 1\n412\t\toffset := 1\n413\t\tfor _, b := range content {\n414\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n415\t\t\t\toffset = 2\n416\t\t\t\tbreak\n417\t\t\t}\n418\t\t}\n419\t\ttarget := idx + offset\n420\t\tfor len(content) <= target {\n421\t\t\tcontent = append(content, map[string]any{\"type\": \"tool_use\", \"id\": \"\", \"name\": \"\", \"input\": map[string]any{}})\n422\t\t}\n423\t\tblock := content[target].(map[string]any)\n424\t\tif id := strVal(tc[\"id\"]); id != \"\" {\n425\t\t\tblock[\"id\"] = id\n426\t\t}\n427\t\tif fn, ok := tc[\"function\"].(map[string]any); ok {\n428\t\t\tif n := strVal(fn[\"name\"]); n != \"\" {\n429\t\t\t\tblock[\"name\"] = n\n430\t\t\t}\n431\t\t\tif args := strVal(fn[\"arguments\"]); args != \"\" {\n432\t\t\t\tvar parsed any\n433\t\t\t\tif json.Unmarshal([]byte(args), &parsed) == nil {\n434\t\t\t\t\tblock[\"input\"] = parsed\n435\t\t\t\t}\n436\t\t\t}\n437\t\t}\n438\t\tr.snap[\"content\"] = content\n439\t}\n440\t\n441\t// mergeChatUsage 将 OpenAI Chat Completions 的 usage 数据标准化后合并到快照。\n442\tfunc (r *SSEReassembler) mergeChatUsage(u map[string]any) {\n443\t\tr.snap[\"usage\"] = usage.NormalizeUsage(u)\n444\t}\n445\t\n446\t// --- 辅助函数 ---\n447\t\n448\t// deepCopy 通过 JSON 序列化/反序列化实现 map 的深拷贝。\n449\tfunc deepCopy(m map[string]any) map[string]any {\n450\t\tif m == nil {\n451\t\t\treturn nil\n452\t\t}\n453\t\tdata, _ := json.Marshal(m)\n454\t\tresult := make(map[string]any)\n455\t\t_ = json.Unmarshal(data, &result)\n456\t\treturn result\n457\t}\n458\t\n459\t// float64Val 将任意数值类型转换为 float64。\n460\t// 支持 float64、int、int64；不支持的类型返回 0。\n461\tfunc float64Val(v any) float64 {\n462\t\tswitch n := v.(type) {\n463\t\tcase float64:\n464\t\t\treturn n\n465\t\tcase int:\n466\t\t\treturn float64(n)\n467\t\tcase int64:\n468\t\t\treturn float64(n)\n469\t\t}\n470\t\treturn 0\n471\t}\n472\t\n473\t// strVal 将任意值转换为字符串。\n474\t// nil 返回空字符串，string 类型直接返回，其他类型使用 fmt.Sprintf 格式化。\n475\tfunc strVal(v any) string {\n476\t\tif v == nil {\n477\t\t\treturn \"\"\n478\t\t}\n479\t\tif s, ok := v.(string); ok {\n480\t\t\treturn s\n481\t\t}\n482\t\treturn fmt.Sprintf(\"%v\", v)\n483\t}\n484\t\n485\t// fieldStr 从 map 中安全获取字段值。\n486\tfunc fieldStr(m map[string]any, key string) any {\n487\t\tv, _ := m[key]\n488\t\treturn v\n489\t}\n490\t\n491\t// sliceField 从 map 中获取 []any 类型的字段，如果不存在或类型不匹配则返回 nil。\n492\tfunc sliceField(m map[string]any, key string) []any {\n493\t\tv, _ := m[key].([]any)\n494\t\tif v == nil {\n495\t\t\treturn nil\n496\t\t}\n497\t\treturn v\n498\t}\n499\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\tests\\integration\\sr5_integration_test.go"},"tool_use_id":"call_59a3f95a42a7443c9caf4ba3","tool_response":"1\t// Package integration_test 包含 SR-5（配置与集成）的端到端测试。\n2\t// 验证会话注册、机器去重、状态保持、端到端完整流程等功能。\n3\tpackage integration_test\n4\t\n5\timport (\n6\t\t\"database/sql\"\n7\t\t\"encoding/json\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"net/http\"\n11\t\t\"net/http/httptest\"\n12\t\t\"os\"\n13\t\t\"strings\"\n14\t\t\"testing\"\n15\t\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n19\t)\n20\t\n21\t// --- SR-5: 配置与集成测试 ---\n22\t// 验证矩阵覆盖：\n23\t//   - 会话注册 → 机器/项目自动创建\n24\t//   - 多会话同机器 → machine 去重\n25\t//   - 会话注销 → closed 状态\n26\t//   - 后端重启 → 状态保持\n27\t//   - 端到端完整流程：register → 操作 → close\n28\t\n29\t// sr5Env 是 SR-5 集成测试环境，支持 session 相关路由。\n30\ttype sr5Env struct {\n31\t\tsrv   *httptest.Server\n32\t\tstore *store.SQLiteStore\n33\t\tdb    *sql.DB\n34\t}\n35\t\n36\t// setupSR5 创建支持 session 的集成测试环境。\n37\tfunc setupSR5(t *testing.T) *sr5Env {\n38\t\tt.Helper()\n39\t\n40\t\tf, err := os.CreateTemp(\"\", \"sr5-test-*.db\")\n41\t\tif err != nil {\n42\t\t\tt.Fatal(err)\n43\t\t}\n44\t\tdbPath := f.Name()\n45\t\tf.Close()\n46\t\n47\t\ts, err := store.NewSQLiteStore(dbPath)\n48\t\tif err != nil {\n49\t\t\tos.Remove(dbPath)\n50\t\t\tt.Fatal(err)\n51\t\t}\n52\t\n53\t\tt.Cleanup(func() {\n54\t\t\ts.Close()\n55\t\t\tos.Remove(dbPath)\n56\t\t})\n57\t\n58\t\tissueSvc := service.NewIssueService(s.Issues())\n59\t\tsessionSvc := service.NewSessionService(s.Sessions())\n60\t\trouter := api.NewRouter(api.Handlers{\n61\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n62\t\t\tSession: api.NewSessionHandler(sessionSvc, service.NewIssueService(s.Issues()), service.NewTokenService(s.Sessions()), service.NewTraceService(s.Sessions())),\n63\t\t})\n64\t\n65\t\tsrv := httptest.NewServer(router)\n66\t\tt.Cleanup(srv.Close)\n67\t\n68\t\treturn &sr5Env{srv: srv, store: s, db: s.DB()}\n69\t}\n70\t\n71\t// post 发送 POST 请求到 SR-5 测试环境。\n72\tfunc (e *sr5Env) post(t *testing.T, path, body string) *http.Response {\n73\t\tt.Helper()\n74\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n75\t\tif err != nil {\n76\t\t\tt.Fatal(err)\n77\t\t}\n78\t\treturn resp\n79\t}\n80\t\n81\t// get 发送 GET 请求到 SR-5 测试环境。\n82\tfunc (e *sr5Env) get(t *testing.T, path string) *http.Response {\n83\t\tt.Helper()\n84\t\tresp, err := http.Get(e.srv.URL + path)\n85\t\tif err != nil {\n86\t\t\tt.Fatal(err)\n87\t\t}\n88\t\treturn resp\n89\t}\n90\t\n91\t// sr5ReadJSON 读取 HTTP 响应并解析为 JSON。\n92\tfunc sr5ReadJSON(t *testing.T, resp *http.Response, v any) {\n93\t\tt.Helper()\n94\t\tdefer resp.Body.Close()\n95\t\tb, err := io.ReadAll(resp.Body)\n96\t\tif err != nil {\n97\t\t\tt.Fatal(err)\n98\t\t}\n99\t\tif err := json.Unmarshal(b, v); err != nil {\n100\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n101\t\t}\n102\t}\n103\t\n104\t// --- 验证：会话注册 + 机器/项目自动创建 ---\n105\t\n106\t// TestSR5_RegisterCreatesMachineAndProject 验证：注册 session 时自动创建机器和项目记录。\n107\tfunc TestSR5_RegisterCreatesMachineAndProject(t *testing.T) {\n108\t\tenv := setupSR5(t)\n109\t\n110\t\tresp := env.post(t, \"/api/session/register\", `{\n111\t\t\t\"session_id\": \"sr5-sess-1\",\n112\t\t\t\"machine_id\": \"alice@devbox\",\n113\t\t\t\"os\": \"linux\",\n114\t\t\t\"project_slug\": \"my-app\",\n115\t\t\t\"project_cwd\": \"/home/alice/my-app\",\n116\t\t\t\"transcript_path\": \"/home/alice/.claude/transcripts/sr5-sess-1.jsonl\",\n117\t\t\t\"model\": \"GLM-5.1\",\n118\t\t\t\"source\": \"startup\"\n119\t\t}`)\n120\t\tif resp.StatusCode != http.StatusOK {\n121\t\t\tt.Fatalf(\"register: expected 200, got %d\", resp.StatusCode)\n122\t\t}\n123\t\n124\t\t// 验证机器自动创建\n125\t\tvar machineCount int\n126\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM machines WHERE machine_id = 'alice@devbox'\").Scan(&machineCount)\n127\t\tif machineCount != 1 {\n128\t\t\tt.Errorf(\"expected 1 machine, got %d\", machineCount)\n129\t\t}\n130\t\n131\t\t// 验证项目自动创建\n132\t\tvar projectCount int\n133\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM projects WHERE project_slug = 'my-app'\").Scan(&projectCount)\n134\t\tif projectCount != 1 {\n135\t\t\tt.Errorf(\"expected 1 project, got %d\", projectCount)\n136\t\t}\n137\t\n138\t\t// 验证 session 状态活跃且元数据正确\n139\t\tvar status, model, source string\n140\t\tenv.db.QueryRow(\"SELECT status, model, source FROM sessions WHERE session_id = 'sr5-sess-1'\").Scan(&status, &model, &source)\n141\t\tif status != \"active\" {\n142\t\t\tt.Errorf(\"expected active, got %s\", status)\n143\t\t}\n144\t\tif model != \"GLM-5.1\" {\n145\t\t\tt.Errorf(\"expected model=GLM-5.1, got %s\", model)\n146\t\t}\n147\t\tif source != \"startup\" {\n148\t\t\tt.Errorf(\"expected source=startup, got %s\", source)\n149\t\t}\n150\t}\n151\t\n152\t// --- 验证：多会话同机器 → machine 去重，project 累积 ---\n153\t\n154\t// TestSR5_MultipleSessionsSameMachine 验证：同一机器注册多个 session 时机器表去重，项目表累积。\n155\tfunc TestSR5_MultipleSessionsSameMachine(t *testing.T) {\n156\t\tenv := setupSR5(t)\n157\t\n158\t\tfor i := 0; i < 3; i++ {\n159\t\t\tbody := fmt.Sprintf(`{\n160\t\t\t\t\"session_id\": \"sr5-sess-%d\",\n161\t\t\t\t\"machine_id\": \"bob@laptop\",\n162\t\t\t\t\"os\": \"windows\",\n163\t\t\t\t\"project_slug\": \"proj-%d\",\n164\t\t\t\t\"project_cwd\": \"/proj-%d\",\n165\t\t\t\t\"transcript_path\": \"/t/%d.jsonl\"\n166\t\t\t}`, i, i, i, i)\n167\t\t\tresp := env.post(t, \"/api/session/register\", body)\n168\t\t\tif resp.StatusCode != http.StatusOK {\n169\t\t\t\tt.Fatalf(\"register %d: expected 200, got %d\", i, resp.StatusCode)\n170\t\t\t}\n171\t\t\tresp.Body.Close()\n172\t\t}\n173\t\n174\t\t// 机器表应只有 1 行（去重）\n175\t\tvar machineCount int\n176\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM machines WHERE machine_id = 'bob@laptop'\").Scan(&machineCount)\n177\t\tif machineCount != 1 {\n178\t\t\tt.Errorf(\"expected 1 machine (deduplicated), got %d\", machineCount)\n179\t\t}\n180\t\n181\t\t// 项目表应有 3 行\n182\t\tvar projectCount int\n183\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM projects\").Scan(&projectCount)\n184\t\tif projectCount != 3 {\n185\t\t\tt.Errorf(\"expected 3 projects, got %d\", projectCount)\n186\t\t}\n187\t\n188\t\t// sessions 表应有 3 行\n189\t\tvar sessionCount int\n190\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM sessions WHERE machine_id = 'bob@laptop'\").Scan(&sessionCount)\n191\t\tif sessionCount != 3 {\n192\t\t\tt.Errorf(\"expected 3 sessions, got %d\", sessionCount)\n193\t\t}\n194\t}\n195\t\n196\t// --- 验证：端到端完整流程（register → issue 操作 → close）---\n197\t\n198\t// TestSR5_EndToEndSessionWithIssueOps 验证：从注册到 issue 领取、状态更新、session 释放、关闭的完整流程。\n199\tfunc TestSR5_EndToEndSessionWithIssueOps(t *testing.T) {\n200\t\tenv := setupSR5(t)\n201\t\n202\t\t// 1. 注册 session\n203\t\tresp := env.post(t, \"/api/session/register\", `{\n204\t\t\t\"session_id\": \"sr5-e2e\",\n205\t\t\t\"machine_id\": \"e2e@test\",\n206\t\t\t\"os\": \"linux\",\n207\t\t\t\"project_slug\": \"e2e-proj\",\n208\t\t\t\"project_cwd\": \"/e2e\",\n209\t\t\t\"transcript_path\": \"/e2e.jsonl\",\n210\t\t\t\"model\": \"GLM-5.1\",\n211\t\t\t\"source\": \"startup\"\n212\t\t}`)\n213\t\tif resp.StatusCode != http.StatusOK {\n214\t\t\tt.Fatalf(\"step 1 register: expected 200, got %d\", resp.StatusCode)\n215\t\t}\n216\t\tresp.Body.Close()\n217\t\n218\t\t// 2. 领取 issue（模拟 001-4-issue-claim）\n219\t\tresp = env.post(t, \"/api/issue/claim\", `{\n220\t\t\t\"repo_full_name\": \"test/sr5\",\n221\t\t\t\"issue_number\": 1,\n222\t\t\t\"session_id\": \"sr5-e2e\"\n223\t\t}`)\n224\t\tvar claimResult struct {\n225\t\t\tSuccess bool `json:\"success\"`\n226\t\t}\n227\t\tsr5ReadJSON(t, resp, &claimResult)\n228\t\tif !claimResult.Success {\n229\t\t\tt.Fatal(\"step 2 claim: expected success\")\n230\t\t}\n231\t\n232\t\t// 3. 更新状态（模拟 001-5-issue-fix）\n233\t\tresp = env.post(t, \"/api/issue/status\", `{\n234\t\t\t\"repo_full_name\": \"test/sr5\",\n235\t\t\t\"issue_number\": 1,\n236\t\t\t\"session_id\": \"sr5-e2e\",\n237\t\t\t\"status\": \"fixing\"\n238\t\t}`)\n239\t\tvar statusResult struct {\n240\t\t\tSuccess bool `json:\"success\"`\n241\t\t}\n242\t\tsr5ReadJSON(t, resp, &statusResult)\n243\t\tif !statusResult.Success {\n244\t\t\tt.Fatal(\"step 3 status: expected success\")\n245\t\t}\n246\t\n247\t\t// 4. 验证 session 仍活跃\n248\t\tresp = env.get(t, \"/api/session/sr5-e2e\")\n249\t\tvar sessionDetail struct {\n250\t\t\tStatus string `json:\"status\"`\n251\t\t}\n252\t\tsr5ReadJSON(t, resp, &sessionDetail)\n253\t\tif sessionDetail.Status != \"active\" {\n254\t\t\tt.Fatalf(\"step 4: expected active, got %s\", sessionDetail.Status)\n255\t\t}\n256\t\n257\t\t// 5. 释放 session 关联的 issue（模拟 SessionEnd）\n258\t\tresp = env.post(t, \"/api/issue/release-session\", `{\"session_id\": \"sr5-e2e\"}`)\n259\t\tvar releaseResult struct {\n260\t\t\tCount int `json:\"count\"`\n261\t\t}\n262\t\tsr5ReadJSON(t, resp, &releaseResult)\n263\t\tif releaseResult.Count != 1 {\n264\t\t\tt.Fatalf(\"step 5 release: expected 1, got %d\", releaseResult.Count)\n265\t\t}\n266\t\n267\t\t// 6. 关闭 session（模拟 SR-3 unregister）\n268\t\tresp = env.post(t, \"/api/session/close\", `{\n269\t\t\t\"session_id\": \"sr5-e2e\",\n270\t\t\t\"reason\": \"prompt_input_exit\"\n271\t\t}`)\n272\t\tvar closeResult struct {\n273\t\t\tStatus string `json:\"status\"`\n274\t\t}\n275\t\tsr5ReadJSON(t, resp, &closeResult)\n276\t\tif closeResult.Status != \"closed\" {\n277\t\t\tt.Fatalf(\"step 6 close: expected closed, got %s\", closeResult.Status)\n278\t\t}\n279\t\n280\t\t// 7. 验证最终状态\n281\t\tresp = env.get(t, \"/api/session/sr5-e2e\")\n282\t\tvar finalDetail struct {\n283\t\t\tStatus      string  `json:\"status\"`\n284\t\t\tCloseReason string  `json:\"close_reason\"`\n285\t\t\tClosedAt    *string `json:\"closed_at\"`\n286\t\t}\n287\t\tsr5ReadJSON(t, resp, &finalDetail)\n288\t\tif finalDetail.Status != \"closed\" {\n289\t\t\tt.Errorf(\"step 7: expected closed, got %s\", finalDetail.Status)\n290\t\t}\n291\t\tif finalDetail.CloseReason != \"prompt_input_exit\" {\n292\t\t\tt.Errorf(\"step 7: expected reason=prompt_input_exit, got %s\", finalDetail.CloseReason)\n293\t\t}\n294\t\tif finalDetail.ClosedAt == nil {\n295\t\t\tt.Error(\"step 7: expected closed_at to be set\")\n296\t\t}\n297\t\n298\t\t// 8. 验证 issue 已回到 idle\n299\t\tresp = env.post(t, \"/api/issue/check\", `{\"repo_full_name\":\"test/sr5\",\"issue_numbers\":[1]}`)\n300\t\tvar checkResult struct {\n301\t\t\tIssues []struct {\n302\t\t\t\tNumber int    `json:\"number\"`\n303\t\t\t\tStatus string `json:\"status\"`\n304\t\t\t} `json:\"issues\"`\n305\t\t}\n306\t\tsr5ReadJSON(t, resp, &checkResult)\n307\t\tif len(checkResult.Issues) != 1 || checkResult.Issues[0].Status != \"idle\" {\n308\t\t\tt.Errorf(\"step 8: expected issue idle, got %v\", checkResult.Issues)\n309\t\t}\n310\t}\n311\t\n312\t// --- 验证：后端重启后状态保持 ---\n313\t\n314\t// TestSR5_StatePreservedAcrossRestart 验证：关闭后重新启动服务，session 状态保持不变。\n315\tfunc TestSR5_StatePreservedAcrossRestart(t *testing.T) {\n316\t\t// 阶段 1：创建数据库、注册 session、关闭服务\n317\t\tf, err := os.CreateTemp(\"\", \"sr5-restart-*.db\")\n318\t\tif err != nil {\n319\t\t\tt.Fatal(err)\n320\t\t}\n321\t\tdbPath := f.Name()\n322\t\tf.Close()\n323\t\n324\t\ts, err := store.NewSQLiteStore(dbPath)\n325\t\tif err != nil {\n326\t\t\tos.Remove(dbPath)\n327\t\t\tt.Fatal(err)\n328\t\t}\n329\t\n330\t\tissueSvc := service.NewIssueService(s.Issues())\n331\t\tsessionSvc := service.NewSessionService(s.Sessions())\n332\t\trouter := api.NewRouter(api.Handlers{\n333\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n334\t\t\tSession: api.NewSessionHandler(sessionSvc, service.NewIssueService(s.Issues()), service.NewTokenService(s.Sessions()), service.NewTraceService(s.Sessions())),\n335\t\t})\n336\t\tsrv := httptest.NewServer(router)\n337\t\n338\t\t// 注册并关闭 session\n339\t\tresp, _ := http.Post(srv.URL+\"/api/session/register\", \"application/json\",\n340\t\t\tstrings.NewReader(`{\"session_id\":\"sr5-restart\",\"machine_id\":\"test@test\",\"os\":\"linux\",\"project_slug\":\"proj\",\"project_cwd\":\"/p\",\"transcript_path\":\"/t.jsonl\"}`))\n341\t\tresp.Body.Close()\n342\t\n343\t\tresp, _ = http.Post(srv.URL+\"/api/session/close\", \"application/json\",\n344\t\t\tstrings.NewReader(`{\"session_id\":\"sr5-restart\",\"reason\":\"prompt_input_exit\"}`))\n345\t\tresp.Body.Close()\n346\t\n347\t\t// 关闭服务\n348\t\tsrv.Close()\n349\t\ts.Close()\n350\t\n351\t\t// 阶段 2：使用同一数据库重新启动服务\n352\t\ts2, err := store.NewSQLiteStore(dbPath)\n353\t\tif err != nil {\n354\t\t\tt.Fatal(err)\n355\t\t}\n356\t\tt.Cleanup(func() {\n357\t\t\ts2.Close()\n358\t\t\tos.Remove(dbPath)\n359\t\t})\n360\t\n361\t\tsessionSvc2 := service.NewSessionService(s2.Sessions())\n362\t\trouter2 := api.NewRouter(api.Handlers{\n363\t\t\tIssue:   api.NewIssueHandler(service.NewIssueService(s2.Issues())),\n364\t\t\tSession: api.NewSessionHandler(sessionSvc2, service.NewIssueService(s2.Issues()), service.NewTokenService(s2.Sessions()), service.NewTraceService(s2.Sessions())),\n365\t\t})\n366\t\tsrv2 := httptest.NewServer(router2)\n367\t\tt.Cleanup(srv2.Close)\n368\t\n369\t\t// 验证 session 仍关闭\n370\t\tresp, _ = http.Get(srv2.URL + \"/api/session/sr5-restart\")\n371\t\tif err != nil {\n372\t\t\tt.Fatal(err)\n373\t\t}\n374\t\tvar detail struct {\n375\t\t\tStatus      string  `json:\"status\"`\n376\t\t\tCloseReason string  `json:\"close_reason\"`\n377\t\t\tClosedAt    *string `json:\"closed_at\"`\n378\t\t}\n379\t\tsr5ReadJSON(t, resp, &detail)\n380\t\n381\t\tif detail.Status != \"closed\" {\n382\t\t\tt.Errorf(\"expected closed after restart, got %s\", detail.Status)\n383\t\t}\n384\t\tif detail.CloseReason != \"prompt_input_exit\" {\n385\t\t\tt.Errorf(\"expected reason preserved, got %s\", detail.CloseReason)\n386\t\t}\n387\t\tif detail.ClosedAt == nil {\n388\t\t\tt.Error(\"expected closed_at preserved\")\n389\t\t}\n390\t}\n391\t\n392\t// --- 验证：重复注册返回 409 ---\n393\t\n394\t// TestSR5_DuplicateRegisterReturns409 验证：重复注册返回 409 Conflict。\n395\tfunc TestSR5_DuplicateRegisterReturns409(t *testing.T) {\n396\t\tenv := setupSR5(t)\n397\t\n398\t\tbody := `{\"session_id\":\"sr5-dup\",\"machine_id\":\"test@test\",\"os\":\"linux\",\"project_slug\":\"proj\",\"project_cwd\":\"/p\",\"transcript_path\":\"/t.jsonl\"}`\n399\t\tresp := env.post(t, \"/api/session/register\", body)\n400\t\tresp.Body.Close()\n401\t\n402\t\tresp = env.post(t, \"/api/session/register\", body)\n403\t\tvar errResp struct {\n404\t\t\tCode string `json:\"error\"`\n405\t\t}\n406\t\tsr5ReadJSON(t, resp, &errResp)\n407\t\n408\t\tif resp.StatusCode != http.StatusConflict {\n409\t\t\tt.Fatalf(\"expected 409, got %d\", resp.StatusCode)\n410\t\t}\n411\t\tif errResp.Code != \"session_exists\" {\n412\t\t\tt.Errorf(\"expected session_exists, got %s\", errResp.Code)\n413\t\t}\n414\t}\n415\t\n416\t// --- 验证：session list 过滤 ---\n417\t\n418\t// TestSR5_SessionListFilters 验证：session 列表支持按状态和 machine_id 过滤。\n419\tfunc TestSR5_SessionListFilters(t *testing.T) {\n420\t\tenv := setupSR5(t)\n421\t\n422\t\t// 准备数据：2 个活跃 session（machine_a），1 个已关闭（machine_b）\n423\t\tfor i, s := range []struct {\n424\t\t\tsid, machine, slug, cwd string\n425\t\t}{\n426\t\t\t{\"sa1\", \"ma\", \"proj-a\", \"/a\"},\n427\t\t\t{\"sa2\", \"ma\", \"proj-b\", \"/b\"},\n428\t\t\t{\"sb1\", \"mb\", \"proj-c\", \"/c\"},\n429\t\t} {\n430\t\t\tbody := fmt.Sprintf(`{\"session_id\":\"%s\",\"machine_id\":\"%s\",\"os\":\"linux\",\"project_slug\":\"%s\",\"project_cwd\":\"%s\",\"transcript_path\":\"/t%d.jsonl\"}`,\n431\t\t\t\ts.sid, s.machine, s.slug, s.cwd, i)\n432\t\t\tresp := env.post(t, \"/api/session/register\", body)\n433\t\t\tresp.Body.Close()\n434\t\t}\n435\t\n436\t\t// 关闭 sb1\n437\t\tresp := env.post(t, \"/api/session/close\", `{\"session_id\":\"sb1\",\"reason\":\"done\"}`)\n438\t\tresp.Body.Close()\n439\t\n440\t\t// 过滤：status=active\n441\t\tresp = env.get(t, \"/api/sessions?status=active\")\n442\t\tvar activeList struct {\n443\t\t\tSessions []struct {\n444\t\t\t\tSessionID string `json:\"session_id\"`\n445\t\t\t} `json:\"sessions\"`\n446\t\t}\n447\t\tsr5ReadJSON(t, resp, &activeList)\n448\t\tif len(activeList.Sessions) != 2 {\n449\t\t\tt.Errorf(\"active filter: expected 2, got %d\", len(activeList.Sessions))\n450\t\t}\n451\t\n452\t\t// 过滤：machine_id=ma\n453\t\tresp = env.get(t, \"/api/sessions?machine_id=ma\")\n454\t\tvar machineList struct {\n455\t\t\tSessions []struct {\n456\t\t\t\tSessionID string `json:\"session_id\"`\n457\t\t\t} `json:\"sessions\"`\n458\t\t}\n459\t\tsr5ReadJSON(t, resp, &machineList)\n460\t\tif len(machineList.Sessions) != 2 {\n461\t\t\tt.Errorf(\"machine filter: expected 2, got %d\", len(machineList.Sessions))\n462\t\t}\n463\t\n464\t\t// 过滤：status=closed\n465\t\tresp = env.get(t, \"/api/sessions?status=closed\")\n466\t\tvar closedList struct {\n467\t\t\tSessions []struct {\n468\t\t\t\tSessionID string `json:\"session_id\"`\n469\t\t\t} `json:\"sessions\"`\n470\t\t}\n471\t\tsr5ReadJSON(t, resp, &closedList)\n472\t\tif len(closedList.Sessions) != 1 {\n473\t\t\tt.Errorf(\"closed filter: expected 1, got %d\", len(closedList.Sessions))\n474\t\t}\n475\t\tif len(closedList.Sessions) > 0 && closedList.Sessions[0].SessionID != \"sb1\" {\n476\t\t\tt.Errorf(\"closed filter: expected sb1, got %s\", closedList.Sessions[0].SessionID)\n477\t\t}\n478\t}\n479\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\thinking_inject_test.go"},"tool_use_id":"call_3029b1abe7f04e0499cbf2f4","tool_response":"1\tpackage proxy\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"net/http/httptest\"\n9\t\t\"testing\"\n10\t)\n11\t\n12\t// TestInjectReasoningContentCached_Unit 直接测试 injectReasoningContentCached 函数的各种场景。\n13\tfunc TestInjectReasoningContentCached_Unit(t *testing.T) {\n14\t\ttests := []struct {\n15\t\t\tname     string\n16\t\t\treqBody  string\n17\t\t\tisKimi   bool\n18\t\t\twantSame bool // true = 输出应与输入完全一致\n19\t\t\twantLen  int  // 目标 assistant 消息的 content 数组期望长度\n20\t\t}{\n21\t\t\t{\n22\t\t\t\tname:     \"无 tool_use 的 assistant - 原样透传\",\n23\t\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}]}`,\n24\t\t\t\tisKimi:   true,\n25\t\t\t\twantSame: true,\n26\t\t\t},\n27\t\t\t{\n28\t\t\t\tname:     \"tool_use 无 thinking - 注入\",\n29\t\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n30\t\t\t\tisKimi:   true,\n31\t\t\t\twantSame: false,\n32\t\t\t\twantLen:  2,\n33\t\t\t},\n34\t\t\t{\n35\t\t\t\tname:     \"已有 thinking 块和 reasoning_content - 原样透传\",\n36\t\t\t\treqBody:  `{\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"reasoning\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}],\"reasoning_content\":\"reasoning\"}]}`,\n37\t\t\t\tisKimi:   true,\n38\t\t\t\twantSame: true,\n39\t\t\t},\n40\t\t\t{\n41\t\t\t\tname:     \"空 body - 原样透传\",\n42\t\t\t\treqBody:  \"\",\n43\t\t\t\tisKimi:   true,\n44\t\t\t\twantSame: true,\n45\t\t\t},\n46\t\t\t{\n47\t\t\t\tname:     \"非 JSON body - 原样透传\",\n48\t\t\t\treqBody:  \"this is not json\",\n49\t\t\t\tisKimi:   true,\n50\t\t\t\twantSame: true,\n51\t\t\t},\n52\t\t\t{\n53\t\t\t\tname:     \"JSON 数组 body - 原样透传\",\n54\t\t\t\treqBody:  `[1,2,3]`,\n55\t\t\t\tisKimi:   true,\n56\t\t\t\twantSame: true,\n57\t\t\t},\n58\t\t\t{\n59\t\t\t\tname:     \"纯 user 消息 - 原样透传\",\n60\t\t\t\treqBody:  `{\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}`,\n61\t\t\t\tisKimi:   true,\n62\t\t\t\twantSame: true,\n63\t\t\t},\n64\t\t\t{\n65\t\t\t\tname:     \"非 kimi 模式 - 原样透传（不注入）\",\n66\t\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n67\t\t\t\tisKimi:   false,\n68\t\t\t\twantSame: true,\n69\t\t\t},\n70\t\t}\n71\t\n72\t\tfor _, tt := range tests {\n73\t\t\tt.Run(tt.name, func(t *testing.T) {\n74\t\t\t\tvar parsed any\n75\t\t\t\tif tt.reqBody != \"\" {\n76\t\t\t\t\t_ = json.Unmarshal([]byte(tt.reqBody), &parsed)\n77\t\t\t\t}\n78\t\t\t\tresult := injectReasoningContentCached([]byte(tt.reqBody), parsed, nil, tt.isKimi)\n79\t\t\t\tif tt.wantSame {\n80\t\t\t\t\tif string(result) != tt.reqBody {\n81\t\t\t\t\t\tt.Errorf(\"expected passthrough, got: %s\", string(result))\n82\t\t\t\t\t}\n83\t\t\t\t} else {\n84\t\t\t\t\tvar m map[string]any\n85\t\t\t\t\tif err := json.Unmarshal(result, &m); err != nil {\n86\t\t\t\t\t\tt.Fatalf(\"result is not valid JSON: %v\", err)\n87\t\t\t\t\t}\n88\t\t\t\t\tmsgs := m[\"messages\"].([]any)\n89\t\t\t\t\tmsg := msgs[0].(map[string]any)\n90\t\t\t\t\tcontent := msg[\"content\"].([]any)\n91\t\t\t\t\tif len(content) != tt.wantLen {\n92\t\t\t\t\t\tt.Errorf(\"content length = %d, want %d\", len(content), tt.wantLen)\n93\t\t\t\t\t}\n94\t\t\t\t\t// 验证注入的 thinking 块在第一位\n95\t\t\t\t\tfirst := content[0].(map[string]any)\n96\t\t\t\t\tif first[\"type\"] != \"thinking\" {\n97\t\t\t\t\t\tt.Errorf(\"first block type = %q, want %q\", first[\"type\"], \"thinking\")\n98\t\t\t\t\t}\n99\t\t\t\t\t// 验证顶层 reasoning_content 字段被注入（无缓存时为空字符串）\n100\t\t\t\t\tif rc, ok := msg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n101\t\t\t\t\t\tt.Errorf(\"reasoning_content = %v, want empty string\", msg[\"reasoning_content\"])\n102\t\t\t\t\t}\n103\t\t\t\t}\n104\t\t\t})\n105\t\t}\n106\t}\n107\t\n108\t// TestInjectReasoningContentCached_MixedMessages 测试混合消息场景：只有 tool_call 消息被注入。\n109\tfunc TestInjectReasoningContentCached_MixedMessages(t *testing.T) {\n110\t\treqBody := `{\n111\t\t\t\"messages\": [\n112\t\t\t\t{\"role\": \"user\", \"content\": \"read the file\"},\n113\t\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"sure\"}]},\n114\t\t\t\t{\"role\": \"user\", \"content\": \"do it\"},\n115\t\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"Read\", \"input\": {\"file\": \"/tmp/x\"}}]},\n116\t\t\t\t{\"role\": \"user\", \"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"t1\", \"content\": \"file data\"}]},\n117\t\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"thinking\", \"thinking\":\"let me think\"},{\"type\": \"tool_use\", \"id\": \"t2\", \"name\": \"Bash\", \"input\": {\"cmd\": \"ls\"}}]}\n118\t\t\t]\n119\t\t}`\n120\t\n121\t\tvar parsed any\n122\t\t_ = json.Unmarshal([]byte(reqBody), &parsed)\n123\t\tresult := injectReasoningContentCached([]byte(reqBody), parsed, nil, true)\n124\t\n125\t\tvar m map[string]any\n126\t\tif err := json.Unmarshal(result, &m); err != nil {\n127\t\t\tt.Fatalf(\"parse result: %v\", err)\n128\t\t}\n129\t\tmsgs := m[\"messages\"].([]any)\n130\t\n131\t\t// user 消息不变\n132\t\tif msgs[0].(map[string]any)[\"role\"] != \"user\" {\n133\t\t\tt.Error(\"msg[0] should be user\")\n134\t\t}\n135\t\n136\t\t// 纯文本 assistant (msg[1]) 不变\n137\t\tassistantText := msgs[1].(map[string]any)[\"content\"].([]any)\n138\t\tif len(assistantText) != 1 {\n139\t\t\tt.Errorf(\"assistant text content length = %d, want 1\", len(assistantText))\n140\t\t}\n141\t\n142\t\t// tool_call 无 thinking (msg[3]) → 注入 thinking 块 + reasoning_content\n143\t\tassistantTool := msgs[3].(map[string]any)\n144\t\tcontent := assistantTool[\"content\"].([]any)\n145\t\tif len(content) != 2 {\n146\t\t\tt.Errorf(\"assistant tool content length = %d, want 2 (thinking + tool_use)\", len(content))\n147\t\t}\n148\t\tif content[0].(map[string]any)[\"type\"] != \"thinking\" {\n149\t\t\tt.Error(\"first block should be thinking\")\n150\t\t}\n151\t\tif content[1].(map[string]any)[\"type\"] != \"tool_use\" {\n152\t\t\tt.Error(\"second block should be tool_use\")\n153\t\t}\n154\t\tif rc, ok := assistantTool[\"reasoning_content\"].(string); !ok || rc != \"\" {\n155\t\t\tt.Errorf(\"msg[3] reasoning_content = %v, want empty string\", assistantTool[\"reasoning_content\"])\n156\t\t}\n157\t\n158\t\t// 已有 thinking 的 tool_call (msg[5]) → 不重复注入 thinking 块，但仍注入 reasoning_content（如果缺失）\n159\t\tassistantWithThinking := msgs[5].(map[string]any)\n160\t\tthinkingContent := assistantWithThinking[\"content\"].([]any)\n161\t\tif len(thinkingContent) != 2 {\n162\t\t\tt.Errorf(\"assistant with thinking content length = %d, want 2 (no duplicate)\", len(thinkingContent))\n163\t\t}\n164\t\tif rc, ok := assistantWithThinking[\"reasoning_content\"].(string); !ok || rc != \"\" {\n165\t\t\tt.Errorf(\"msg[5] reasoning_content = %v, want empty string\", assistantWithThinking[\"reasoning_content\"])\n166\t\t}\n167\t}\n168\t\n169\t// TestInjectReasoningContentCached_CacheHit 测试缓存命中时回填真实的 reasoning_content。\n170\tfunc TestInjectReasoningContentCached_CacheHit(t *testing.T) {\n171\t\tcache := NewReasoningCache()\n172\t\n173\t\t// 预缓存：模拟之前 API 响应中的 reasoning_content\n174\t\tassistantContent := \"I will read the file\"\n175\t\ttoolCalls := `[{\"type\":\"tool_use\",\"id\":\"tu_1\",\"name\":\"Read\",\"input\":{\"file_path\":\"/tmp/test.txt\"}}]`\n176\t\tfullKey := MakeFullKey(assistantContent, toolCalls)\n177\t\ttcKey := MakeToolcallKey(toolCalls)\n178\t\tcache.Store(fullKey, tcKey, \"Let me think about this step by step. The user wants to read a file.\")\n179\t\n180\t\t// 构造请求体：assistant 消息有 tool_use 但无 reasoning_content\n181\t\treqBody := map[string]any{\n182\t\t\t\"model\": \"kimi-for-coding\",\n183\t\t\t\"messages\": []any{\n184\t\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"read the file\"},\n185\t\t\t\tmap[string]any{\n186\t\t\t\t\t\"role\": \"assistant\",\n187\t\t\t\t\t\"content\": []any{\n188\t\t\t\t\t\tmap[string]any{\"type\": \"text\", \"text\": \"I will read the file\"},\n189\t\t\t\t\t\tmap[string]any{\"type\": \"tool_use\", \"id\": \"tu_1\", \"name\": \"Read\", \"input\": map[string]any{\"file_path\": \"/tmp/test.txt\"}},\n190\t\t\t\t\t},\n191\t\t\t\t},\n192\t\t\t},\n193\t\t}\n194\t\tbodyBytes, _ := json.Marshal(reqBody)\n195\t\n196\t\tvar parsed any\n197\t\t_ = json.Unmarshal(bodyBytes, &parsed)\n198\t\tresult := injectReasoningContentCached(bodyBytes, parsed, cache, true)\n199\t\n200\t\tvar m map[string]any\n201\t\tif err := json.Unmarshal(result, &m); err != nil {\n202\t\t\tt.Fatalf(\"parse result: %v\", err)\n203\t\t}\n204\t\n205\t\tmsgs := m[\"messages\"].([]any)\n206\t\tassistantMsg := msgs[1].(map[string]any)\n207\t\n208\t\t// reasoning_content 应该是缓存的值，不是空字符串\n209\t\trc, _ := assistantMsg[\"reasoning_content\"].(string)\n210\t\tif rc == \"\" {\n211\t\t\tt.Error(\"expected cached reasoning_content, got empty string\")\n212\t\t}\n213\t\tif rc != \"Let me think about this step by step. The user wants to read a file.\" {\n214\t\t\tt.Errorf(\"reasoning_content = %q, want cached value\", rc)\n215\t\t}\n216\t\n217\t\t// thinking 块应被注入\n218\t\tcontent := assistantMsg[\"content\"].([]any)\n219\t\tfirstBlock := content[0].(map[string]any)\n220\t\tif firstBlock[\"type\"] != \"thinking\" {\n221\t\t\tt.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")\n222\t\t}\n223\t}\n224\t\n225\t// TestInjectReasoningContentCached_CacheMissFallbackToEmpty 测试缓存未命中时回退到空字符串。\n226\tfunc TestInjectReasoningContentCached_CacheMissFallbackToEmpty(t *testing.T) {\n227\t\tcache := NewReasoningCache()\n228\t\t// 不存任何缓存\n229\t\n230\t\treqBody := `{\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"Read\",\"input\":{}}]}]}`\n231\t\tvar parsed any\n232\t\t_ = json.Unmarshal([]byte(reqBody), &parsed)\n233\t\n234\t\tresult := injectReasoningContentCached([]byte(reqBody), parsed, cache, true)\n235\t\n236\t\tvar m map[string]any\n237\t\tjson.Unmarshal(result, &m)\n238\t\tmsg := m[\"messages\"].([]any)[0].(map[string]any)\n239\t\n240\t\trc, _ := msg[\"reasoning_content\"].(string)\n241\t\tif rc != \"\" {\n242\t\t\tt.Errorf(\"cache miss should fallback to empty string, got %q\", rc)\n243\t\t}\n244\t}\n245\t\n246\t// TestInjectReasoningContentCached_NonKimiPassthrough 测试非 kimi 模式不做任何修改。\n247\tfunc TestInjectReasoningContentCached_NonKimiPassthrough(t *testing.T) {\n248\t\tcache := NewReasoningCache()\n249\t\tcache.Store(\"some-key\", \"tc-key\", \"should not be used\")\n250\t\n251\t\treqBody := `{\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"Read\",\"input\":{}}]}]}`\n252\t\tvar parsed any\n253\t\t_ = json.Unmarshal([]byte(reqBody), &parsed)\n254\t\n255\t\tresult := injectReasoningContentCached([]byte(reqBody), parsed, cache, false)\n256\t\n257\t\tif string(result) != reqBody {\n258\t\t\tt.Errorf(\"non-kimi mode should passthrough, got: %s\", string(result))\n259\t\t}\n260\t}\n261\t\n262\t// TestInjectReasoningContentCached_ExistingRCRefreshesCache 测试已有 reasoning_content 时刷新缓存。\n263\tfunc TestInjectReasoningContentCached_ExistingRCRefreshesCache(t *testing.T) {\n264\t\tcache := NewReasoningCache()\n265\t\n266\t\treqBody := map[string]any{\n267\t\t\t\"messages\": []any{\n268\t\t\t\tmap[string]any{\n269\t\t\t\t\t\"role\": \"assistant\",\n270\t\t\t\t\t\"content\": []any{\n271\t\t\t\t\t\tmap[string]any{\"type\": \"text\", \"text\": \"hello\"},\n272\t\t\t\t\t\tmap[string]any{\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"Read\", \"input\": map[string]any{}},\n273\t\t\t\t\t},\n274\t\t\t\t\t\"reasoning_content\": \"I am thinking deeply about this\",\n275\t\t\t\t},\n276\t\t\t},\n277\t\t}\n278\t\tbodyBytes, _ := json.Marshal(reqBody)\n279\t\n280\t\tvar parsed any\n281\t\t_ = json.Unmarshal(bodyBytes, &parsed)\n282\t\tresult := injectReasoningContentCached(bodyBytes, parsed, cache, true)\n283\t\n284\t\t// 缓存应该被刷新\n285\t\tf, _ := cache.Len()\n286\t\tif f == 0 {\n287\t\t\tt.Error(\"expected cache to be refreshed from existing reasoning_content\")\n288\t\t}\n289\t\n290\t\t// 结果应该是原样透传（已有 reasoning_content + 无 thinking 块 → 只注入 thinking 块）\n291\t\tvar m map[string]any\n292\t\tjson.Unmarshal(result, &m)\n293\t\tmsg := m[\"messages\"].([]any)[0].(map[string]any)\n294\t\tcontent := msg[\"content\"].([]any)\n295\t\n296\t\t// thinking 块被注入\n297\t\tif content[0].(map[string]any)[\"type\"] != \"thinking\" {\n298\t\t\tt.Error(\"expected thinking block to be injected\")\n299\t\t}\n300\t\n301\t\t// reasoning_content 保持原值\n302\t\trc, _ := msg[\"reasoning_content\"].(string)\n303\t\tif rc != \"I am thinking deeply about this\" {\n304\t\t\tt.Errorf(\"reasoning_content changed: got %q\", rc)\n305\t\t}\n306\t}\n307\t\n308\t// TestInjectReasoningContentCached_Integration 通过完整代理链路测试，验证上游收到注入后的请求体。\n309\tfunc TestInjectReasoningContentCached_Integration(t *testing.T) {\n310\t\tvar capturedBody []byte\n311\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n312\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n313\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n314\t\t\tw.WriteHeader(http.StatusOK)\n315\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n316\t\t}))\n317\t\tdefer mockUpstream.Close()\n318\t\n319\t\ttraceDir := t.TempDir()\n320\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n321\t\trp.model = \"kimi-for-coding\"\n322\t\trp.SetKimiMode(true) // 启用 kimi 模式\n323\t\n324\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n325\t\tif err != nil {\n326\t\t\tt.Fatalf(\"start proxy: %v\", err)\n327\t\t}\n328\t\tdefer rp.Stop()\n329\t\n330\t\t// 模拟 Kimi 场景：无 thinking 字段，但有 tool_call 消息\n331\t\treqBody := map[string]any{\n332\t\t\t\"model\":  \"kimi-for-coding\",\n333\t\t\t\"stream\": true,\n334\t\t\t\"messages\": []any{\n335\t\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"read the file\"},\n336\t\t\t\tmap[string]any{\n337\t\t\t\t\t\"role\": \"assistant\",\n338\t\t\t\t\t\"content\": []any{\n339\t\t\t\t\t\tmap[string]any{\n340\t\t\t\t\t\t\t\"type\":  \"tool_use\",\n341\t\t\t\t\t\t\t\"id\":    \"toolu_123\",\n342\t\t\t\t\t\t\t\"name\":  \"Read\",\n343\t\t\t\t\t\t\t\"input\": map[string]any{\"file_path\": \"/tmp/test.txt\"},\n344\t\t\t\t\t\t},\n345\t\t\t\t\t},\n346\t\t\t\t},\n347\t\t\t\tmap[string]any{\n348\t\t\t\t\t\"role\": \"user\",\n349\t\t\t\t\t\"content\": []any{\n350\t\t\t\t\t\tmap[string]any{\n351\t\t\t\t\t\t\t\"type\":        \"tool_result\",\n352\t\t\t\t\t\t\t\"tool_use_id\": \"toolu_123\",\n353\t\t\t\t\t\t\t\"content\":     \"file contents\",\n354\t\t\t\t\t\t},\n355\t\t\t\t\t},\n356\t\t\t\t},\n357\t\t\t},\n358\t\t}\n359\t\tbodyBytes, _ := json.Marshal(reqBody)\n360\t\n361\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n362\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n363\t\n364\t\tresp, err := http.DefaultClient.Do(req)\n365\t\tif err != nil {\n366\t\t\tt.Fatalf(\"send request: %v\", err)\n367\t\t}\n368\t\tresp.Body.Close()\n369\t\n370\t\t// 验证上游收到的请求体\n371\t\tvar upstreamBody map[string]any\n372\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n373\t\t\tt.Fatalf(\"parse upstream body: %v\", err)\n374\t\t}\n375\t\n376\t\t// model 被改写为 kimi-for-coding\n377\t\tif m, _ := upstreamBody[\"model\"].(string); m != \"kimi-for-coding\" {\n378\t\t\tt.Errorf(\"model = %q, want %q\", m, \"kimi-for-coding\")\n379\t\t}\n380\t\n381\t\t// assistant 消息被注入 thinking 块 + reasoning_content\n382\t\tmessages := upstreamBody[\"messages\"].([]any)\n383\t\tassistantMsg := messages[1].(map[string]any)\n384\t\tcontent := assistantMsg[\"content\"].([]any)\n385\t\n386\t\tif len(content) != 2 {\n387\t\t\tt.Fatalf(\"assistant content blocks = %d, want 2\", len(content))\n388\t\t}\n389\t\n390\t\t// thinking 块在第一位\n391\t\tfirstBlock := content[0].(map[string]any)\n392\t\tif firstBlock[\"type\"] != \"thinking\" {\n393\t\t\tt.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")\n394\t\t}\n395\t\n396\t\t// 顶层 reasoning_content 被注入（首次请求无缓存，应为空字符串）\n397\t\tif rc, ok := assistantMsg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n398\t\t\tt.Errorf(\"reasoning_content = %v, want empty string\", assistantMsg[\"reasoning_content\"])\n399\t\t}\n400\t\n401\t\t// 原 tool_use 块保持不变\n402\t\tsecondBlock := content[1].(map[string]any)\n403\t\tif secondBlock[\"type\"] != \"tool_use\" {\n404\t\t\tt.Errorf(\"second block type = %q, want %q\", secondBlock[\"type\"], \"tool_use\")\n405\t\t}\n406\t}\n407\t\n408\t// TestInjectReasoningContentCached_IntegrationWithCache 测试完整链路的缓存回填。\n409\tfunc TestInjectReasoningContentCached_IntegrationWithCache(t *testing.T) {\n410\t\tvar capturedBodies [][]byte\n411\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n412\t\t\tbody, _ := io.ReadAll(r.Body)\n413\t\t\tcapturedBodies = append(capturedBodies, body)\n414\t\t\t// 返回包含 reasoning_content 的响应\n415\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n416\t\t\tw.WriteHeader(http.StatusOK)\n417\t\t\tw.Write([]byte(`{\n418\t\t\t\t\"id\": \"msg_test\",\n419\t\t\t\t\"type\": \"message\",\n420\t\t\t\t\"role\": \"assistant\",\n421\t\t\t\t\"model\": \"test\",\n422\t\t\t\t\"content\": [{\"type\": \"text\", \"text\": \"done\"}],\n423\t\t\t\t\"stop_reason\": \"end_turn\",\n424\t\t\t\t\"usage\": {\"input_tokens\": 10, \"output_tokens\": 5}\n425\t\t\t}`))\n426\t\t}))\n427\t\tdefer mockUpstream.Close()\n428\t\n429\t\ttraceDir := t.TempDir()\n430\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n431\t\trp.model = \"kimi-for-coding\"\n432\t\trp.SetKimiMode(true)\n433\t\n434\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n435\t\tif err != nil {\n436\t\t\tt.Fatalf(\"start proxy: %v\", err)\n437\t\t}\n438\t\tdefer rp.Stop()\n439\t\n440\t\t// 请求 1：带 tool_use 的 assistant 消息（无 reasoning_content）\n441\t\treqBody1 := map[string]any{\n442\t\t\t\"model\": \"kimi-for-coding\",\n443\t\t\t\"messages\": []any{\n444\t\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"hello\"},\n445\t\t\t\tmap[string]any{\n446\t\t\t\t\t\"role\": \"assistant\",\n447\t\t\t\t\t\"content\": []any{\n448\t\t\t\t\t\tmap[string]any{\"type\": \"text\", \"text\": \"I will help\"},\n449\t\t\t\t\t\tmap[string]any{\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"Read\", \"input\": map[string]any{\"file\": \"a.go\"}},\n450\t\t\t\t\t},\n451\t\t\t\t},\n452\t\t\t},\n453\t\t}\n454\t\tbodyBytes1, _ := json.Marshal(reqBody1)\n455\t\treq1, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes1))\n456\t\treq1.Header.Set(\"Content-Type\", \"application/json\")\n457\t\tresp1, err := http.DefaultClient.Do(req1)\n458\t\tif err != nil {\n459\t\t\tt.Fatalf(\"request 1: %v\", err)\n460\t\t}\n461\t\tresp1.Body.Close()\n462\t\n463\t\t// 验证请求 1：reasoning_content 为空字符串（首次无缓存）\n464\t\tvar body1 map[string]any\n465\t\tjson.Unmarshal(capturedBodies[0], &body1)\n466\t\tmsg1 := body1[\"messages\"].([]any)[1].(map[string]any)\n467\t\trc1, _ := msg1[\"reasoning_content\"].(string)\n468\t\tif rc1 != \"\" {\n469\t\t\tt.Errorf(\"request 1 reasoning_content should be empty, got %q\", rc1)\n470\t\t}\n471\t}\n472\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\tests\\backend\\issue_list_api_test.go"},"tool_use_id":"call_220cf7228ae6435b94c05c21","tool_response":"1\t// Package backend_test 包含 GET /api/issues 接口的 BDD + TDD 验收测试。\n2\t// 覆盖：获取全部、按仓库/状态/session_id 过滤、组合过滤、分页、空列表、方法限制。\n3\t// 所有测试数据均通过系统自身 API（claim、release、status）产生，不直接操作数据库。\n4\tpackage backend_test\n5\t\n6\timport (\n7\t\t\"encoding/json\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"net/http\"\n11\t\t\"testing\"\n12\t)\n13\t\n14\t// --- response types for list API ---\n15\t\n16\t// listResponse 是 GET /api/issues 的响应结构。\n17\ttype listResponse struct {\n18\t\tIssues     []listItem `json:\"issues\"`\n19\t\tTotal      int        `json:\"total\"`\n20\t\tPage       int        `json:\"page\"`\n21\t\tPageSize   int        `json:\"page_size\"`\n22\t\tTotalPages int        `json:\"total_pages\"`\n23\t}\n24\t\n25\t// listItem 是列表中的单个 Issue 条目。\n26\ttype listItem struct {\n27\t\tID           int64   `json:\"id\"`\n28\t\tRepoFullName string  `json:\"repo_full_name\"`\n29\t\tIssueNumber  int     `json:\"issue_number\"`\n30\t\tIssueTitle   string  `json:\"issue_title\"`\n31\t\tStatus       string  `json:\"status\"`\n32\t\tSessionID    *string `json:\"session_id\"`\n33\t\tClaimedAt    *string `json:\"claimed_at\"`\n34\t\tUpdatedAt    string  `json:\"updated_at\"`\n35\t}\n36\t\n37\t// --- helpers ---\n38\t\n39\t// get 发送 GET 请求到测试环境。\n40\tfunc (e *testEnv) get(t *testing.T, path string) *http.Response {\n41\t\tt.Helper()\n42\t\tresp, err := http.Get(e.srv.URL + path)\n43\t\tif err != nil {\n44\t\t\tt.Fatal(err)\n45\t\t}\n46\t\treturn resp\n47\t}\n48\t\n49\t// readListResponse 读取并解析列表响应。\n50\tfunc readListResponse(t *testing.T, resp *http.Response) listResponse {\n51\t\tt.Helper()\n52\t\tdefer resp.Body.Close()\n53\t\tb, err := io.ReadAll(resp.Body)\n54\t\tif err != nil {\n55\t\t\tt.Fatal(err)\n56\t\t}\n57\t\tvar result listResponse\n58\t\tif err := json.Unmarshal(b, &result); err != nil {\n59\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n60\t\t}\n61\t\treturn result\n62\t}\n63\t\n64\t// apiClaim 通过 POST /api/issue/claim 创建一条 claimed 记录。\n65\tfunc apiClaim(t *testing.T, env *testEnv, repo string, number int, sessionID string) {\n66\t\tt.Helper()\n67\t\tbody := fmt.Sprintf(\n68\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n69\t\t\trepo, number, sessionID)\n70\t\tresp := env.post(t, \"/api/issue/claim\", body)\n71\t\tdefer resp.Body.Close()\n72\t\tif resp.StatusCode != http.StatusOK {\n73\t\t\tt.Fatalf(\"apiClaim failed: repo=%s #%d status=%d\", repo, number, resp.StatusCode)\n74\t\t}\n75\t}\n76\t\n77\t// apiRelease 通过 POST /api/issue/release 释放一条记录，使其回到 idle。\n78\tfunc apiRelease(t *testing.T, env *testEnv, repo string, number int, sessionID string) {\n79\t\tt.Helper()\n80\t\tbody := fmt.Sprintf(\n81\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n82\t\t\trepo, number, sessionID)\n83\t\tresp := env.post(t, \"/api/issue/release\", body)\n84\t\tdefer resp.Body.Close()\n85\t\tif resp.StatusCode != http.StatusOK {\n86\t\t\tt.Fatalf(\"apiRelease failed: repo=%s #%d status=%d\", repo, number, resp.StatusCode)\n87\t\t}\n88\t}\n89\t\n90\t// apiUpdateStatus 通过 POST /api/issue/status 更新 issue 状态。\n91\tfunc apiUpdateStatus(t *testing.T, env *testEnv, repo string, number int, sessionID, newStatus string) {\n92\t\tt.Helper()\n93\t\tbody := fmt.Sprintf(\n94\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\",\"status\":\"%s\"}`,\n95\t\t\trepo, number, sessionID, newStatus)\n96\t\tresp := env.post(t, \"/api/issue/status\", body)\n97\t\tdefer resp.Body.Close()\n98\t\tif resp.StatusCode != http.StatusOK {\n99\t\t\tt.Fatalf(\"apiUpdateStatus failed: repo=%s #%d -> %s status=%d\", repo, number, newStatus, resp.StatusCode)\n100\t\t}\n101\t}\n102\t\n103\t// seedBackgroundData 通过 API 预置 BDD Background 中的 5 条数据：\n104\t//   - #42 idle, no session        → claim + release\n105\t//   - #45 claimed, sess-abc123    → claim\n106\t//   - #38 fixing, sess-def456     → claim + status → fixing\n107\t//   - #10 idle, no session        → claim + release\n108\t//   - #11 merged, sess-abc123     → claim + status → merged\n109\tfunc seedBackgroundData(t *testing.T, env *testEnv) {\n110\t\tt.Helper()\n111\t\n112\t\t// #42: idle（claim 后 release，回到 idle 且 session_id=null）\n113\t\tapiClaim(t, env, \"xiaoheiDTF/claude-hk\", 42, \"sess-tmp-42\")\n114\t\tapiRelease(t, env, \"xiaoheiDTF/claude-hk\", 42, \"sess-tmp-42\")\n115\t\n116\t\t// #45: claimed by sess-abc123\n117\t\tapiClaim(t, env, \"xiaoheiDTF/claude-hk\", 45, \"sess-abc123\")\n118\t\n119\t\t// #38: fixing by sess-def456（claim → status=fixing）\n120\t\tapiClaim(t, env, \"xiaoheiDTF/claude-hk\", 38, \"sess-def456\")\n121\t\tapiUpdateStatus(t, env, \"xiaoheiDTF/claude-hk\", 38, \"sess-def456\", \"fixing\")\n122\t\n123\t\t// #10: idle（claim 后 release）\n124\t\tapiClaim(t, env, \"other/repo\", 10, \"sess-tmp-10\")\n125\t\tapiRelease(t, env, \"other/repo\", 10, \"sess-tmp-10\")\n126\t\n127\t\t// #11: merged by sess-abc123（claim → status=merged）\n128\t\tapiClaim(t, env, \"other/repo\", 11, \"sess-abc123\")\n129\t\tapiUpdateStatus(t, env, \"other/repo\", 11, \"sess-abc123\", \"merged\")\n130\t}\n131\t\n132\t// --- BDD Scenario tests ---\n133\t\n134\t// TestListIssues_GetAll 验证：获取所有 Issue 列表。\n135\t// BDD: @positive Scenario: 获取所有 Issue 列表\n136\tfunc TestListIssues_GetAll(t *testing.T) {\n137\t\tenv := setupTest(t)\n138\t\tseedBackgroundData(t, env)\n139\t\n140\t\tresp := env.get(t, \"/api/issues\")\n141\t\tresult := readListResponse(t, resp)\n142\t\n143\t\tif resp.StatusCode != http.StatusOK {\n144\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n145\t\t}\n146\t\tif len(result.Issues) != 5 {\n147\t\t\tt.Fatalf(\"expected 5 issues, got %d\", len(result.Issues))\n148\t\t}\n149\t\n150\t\t// 验证每个 Issue 包含必要字段\n151\t\tfor _, item := range result.Issues {\n152\t\t\tif item.ID == 0 {\n153\t\t\t\tt.Error(\"expected non-zero id\")\n154\t\t\t}\n155\t\t\tif item.RepoFullName == \"\" {\n156\t\t\t\tt.Error(\"expected non-empty repo_full_name\")\n157\t\t\t}\n158\t\t\tif item.IssueNumber == 0 {\n159\t\t\t\tt.Error(\"expected non-zero issue_number\")\n160\t\t\t}\n161\t\t\tif item.Status == \"\" {\n162\t\t\t\tt.Error(\"expected non-empty status\")\n163\t\t\t}\n164\t\t\tif item.UpdatedAt == \"\" {\n165\t\t\t\tt.Error(\"expected non-empty updated_at\")\n166\t\t\t}\n167\t\t}\n168\t}\n169\t\n170\t// TestListIssues_FilterByRepo 验证：按仓库过滤 Issue。\n171\t// BDD: @positive Scenario: 按仓库过滤 Issue\n172\tfunc TestListIssues_FilterByRepo(t *testing.T) {\n173\t\tenv := setupTest(t)\n174\t\tseedBackgroundData(t, env)\n175\t\n176\t\tresp := env.get(t, \"/api/issues?repo=xiaoheiDTF/claude-hk\")\n177\t\tresult := readListResponse(t, resp)\n178\t\n179\t\tif resp.StatusCode != http.StatusOK {\n180\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n181\t\t}\n182\t\tif len(result.Issues) != 3 {\n183\t\t\tt.Fatalf(\"expected 3 issues, got %d\", len(result.Issues))\n184\t\t}\n185\t\tfor _, item := range result.Issues {\n186\t\t\tif item.RepoFullName != \"xiaoheiDTF/claude-hk\" {\n187\t\t\t\tt.Errorf(\"expected repo_full_name=xiaoheiDTF/claude-hk, got %s\", item.RepoFullName)\n188\t\t\t}\n189\t\t}\n190\t}\n191\t\n192\t// TestListIssues_FilterByStatus 验证：按状态过滤 Issue。\n193\t// BDD: @positive Scenario: 按状态过滤 Issue\n194\tfunc TestListIssues_FilterByStatus(t *testing.T) {\n195\t\tenv := setupTest(t)\n196\t\tseedBackgroundData(t, env)\n197\t\n198\t\tresp := env.get(t, \"/api/issues?status=idle\")\n199\t\tresult := readListResponse(t, resp)\n200\t\n201\t\tif resp.StatusCode != http.StatusOK {\n202\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n203\t\t}\n204\t\tif len(result.Issues) != 2 {\n205\t\t\tt.Fatalf(\"expected 2 issues, got %d\", len(result.Issues))\n206\t\t}\n207\t\tfor _, item := range result.Issues {\n208\t\t\tif item.Status != \"idle\" {\n209\t\t\t\tt.Errorf(\"expected status=idle, got %s\", item.Status)\n210\t\t\t}\n211\t\t}\n212\t}\n213\t\n214\t// TestListIssues_FilterBySessionID 验证：按 session_id 过滤 Issue。\n215\t// BDD: @positive Scenario: 按 session_id 过滤 Issue\n216\tfunc TestListIssues_FilterBySessionID(t *testing.T) {\n217\t\tenv := setupTest(t)\n218\t\tseedBackgroundData(t, env)\n219\t\n220\t\tresp := env.get(t, \"/api/issues?session_id=sess-abc123\")\n221\t\tresult := readListResponse(t, resp)\n222\t\n223\t\tif resp.StatusCode != http.StatusOK {\n224\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n225\t\t}\n226\t\tif len(result.Issues) != 2 {\n227\t\t\tt.Fatalf(\"expected 2 issues, got %d\", len(result.Issues))\n228\t\t}\n229\t\tfor _, item := range result.Issues {\n230\t\t\tif item.SessionID == nil || *item.SessionID != \"sess-abc123\" {\n231\t\t\t\tt.Errorf(\"expected session_id=sess-abc123, got %v\", item.SessionID)\n232\t\t\t}\n233\t\t}\n234\t}\n235\t\n236\t// TestListIssues_CombinedFilter 验证：组合过滤条件。\n237\t// BDD: @positive Scenario: 组合过滤条件\n238\tfunc TestListIssues_CombinedFilter(t *testing.T) {\n239\t\tenv := setupTest(t)\n240\t\tseedBackgroundData(t, env)\n241\t\n242\t\tresp := env.get(t, \"/api/issues?repo=xiaoheiDTF/claude-hk&status=idle\")\n243\t\tresult := readListResponse(t, resp)\n244\t\n245\t\tif resp.StatusCode != http.StatusOK {\n246\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n247\t\t}\n248\t\tif len(result.Issues) != 1 {\n249\t\t\tt.Fatalf(\"expected 1 issue, got %d\", len(result.Issues))\n250\t\t}\n251\t\tif result.Issues[0].RepoFullName != \"xiaoheiDTF/claude-hk\" {\n252\t\t\tt.Errorf(\"expected repo_full_name=xiaoheiDTF/claude-hk, got %s\", result.Issues[0].RepoFullName)\n253\t\t}\n254\t\tif result.Issues[0].Status != \"idle\" {\n255\t\t\tt.Errorf(\"expected status=idle, got %s\", result.Issues[0].Status)\n256\t\t}\n257\t\tif result.Issues[0].IssueNumber != 42 {\n258\t\t\tt.Errorf(\"expected issue_number=42, got %d\", result.Issues[0].IssueNumber)\n259\t\t}\n260\t}\n261\t\n262\t// TestListIssues_Pagination 验证：分页查询。\n263\t// BDD: @positive Scenario: 分页查询\n264\tfunc TestListIssues_Pagination(t *testing.T) {\n265\t\tenv := setupTest(t)\n266\t\tseedBackgroundData(t, env)\n267\t\n268\t\tresp := env.get(t, \"/api/issues?page=1&page_size=2\")\n269\t\tresult := readListResponse(t, resp)\n270\t\n271\t\tif resp.StatusCode != http.StatusOK {\n272\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n273\t\t}\n274\t\tif len(result.Issues) != 2 {\n275\t\t\tt.Fatalf(\"expected 2 issues on page, got %d\", len(result.Issues))\n276\t\t}\n277\t\tif result.Total != 5 {\n278\t\t\tt.Errorf(\"expected total=5, got %d\", result.Total)\n279\t\t}\n280\t\tif result.Page != 1 {\n281\t\t\tt.Errorf(\"expected page=1, got %d\", result.Page)\n282\t\t}\n283\t\tif result.PageSize != 2 {\n284\t\t\tt.Errorf(\"expected page_size=2, got %d\", result.PageSize)\n285\t\t}\n286\t\tif result.TotalPages != 3 {\n287\t\t\tt.Errorf(\"expected total_pages=3, got %d\", result.TotalPages)\n288\t\t}\n289\t}\n290\t\n291\t// TestListIssues_EmptyResult 验证：无 Issue 时返回空数组。\n292\t// BDD: @positive Scenario: 无 Issue 时返回空数组\n293\tfunc TestListIssues_EmptyResult(t *testing.T) {\n294\t\tenv := setupTest(t)\n295\t\n296\t\tresp := env.get(t, \"/api/issues\")\n297\t\tresult := readListResponse(t, resp)\n298\t\n299\t\tif resp.StatusCode != http.StatusOK {\n300\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n301\t\t}\n302\t\tif len(result.Issues) != 0 {\n303\t\t\tt.Fatalf(\"expected empty issues array, got %d items\", len(result.Issues))\n304\t\t}\n305\t\tif result.Total != 0 {\n306\t\t\tt.Errorf(\"expected total=0, got %d\", result.Total)\n307\t\t}\n308\t}\n309\t\n310\t// TestListIssues_MethodNotAllowed 验证：使用非 GET 方法请求返回 405。\n311\t// BDD: @negative Scenario: 使用非 GET 方法请求\n312\tfunc TestListIssues_MethodNotAllowed(t *testing.T) {\n313\t\tenv := setupTest(t)\n314\t\n315\t\tresp := env.post(t, \"/api/issues\", \"\")\n316\t\tdefer resp.Body.Close()\n317\t\n318\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n319\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n320\t\t}\n321\t\n322\t\tvar errResp struct {\n323\t\t\tCode    string `json:\"error\"`\n324\t\t\tMessage string `json:\"message\"`\n325\t\t}\n326\t\treadJSON(t, resp, &errResp)\n327\t\tif errResp.Code != \"method_not_allowed\" {\n328\t\t\tt.Errorf(\"expected error=method_not_allowed, got %s\", errResp.Code)\n329\t\t}\n330\t}\n331\t\n332\t// --- TDD additional edge-case tests ---\n333\t\n334\t// TestListIssues_DefaultPagination 验证：不传分页参数时使用默认值。\n335\tfunc TestListIssues_DefaultPagination(t *testing.T) {\n336\t\tenv := setupTest(t)\n337\t\tseedBackgroundData(t, env)\n338\t\n339\t\tresp := env.get(t, \"/api/issues\")\n340\t\tresult := readListResponse(t, resp)\n341\t\n342\t\tif resp.StatusCode != http.StatusOK {\n343\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n344\t\t}\n345\t\tif result.Page != 1 {\n346\t\t\tt.Errorf(\"expected default page=1, got %d\", result.Page)\n347\t\t}\n348\t\tif result.PageSize != 20 {\n349\t\t\tt.Errorf(\"expected default page_size=20, got %d\", result.PageSize)\n350\t\t}\n351\t}\n352\t\n353\t// TestListIssues_PaginationPage2 验证：第二页数据正确。\n354\tfunc TestListIssues_PaginationPage2(t *testing.T) {\n355\t\tenv := setupTest(t)\n356\t\tseedBackgroundData(t, env)\n357\t\n358\t\tresp := env.get(t, \"/api/issues?page=2&page_size=2\")\n359\t\tresult := readListResponse(t, resp)\n360\t\n361\t\tif resp.StatusCode != http.StatusOK {\n362\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n363\t\t}\n364\t\tif len(result.Issues) != 2 {\n365\t\t\tt.Fatalf(\"expected 2 issues on page 2, got %d\", len(result.Issues))\n366\t\t}\n367\t\tif result.Page != 2 {\n368\t\t\tt.Errorf(\"expected page=2, got %d\", result.Page)\n369\t\t}\n370\t}\n371\t\n372\t// TestListIssues_PaginationLastPage 验证：最后一页可能不满。\n373\tfunc TestListIssues_PaginationLastPage(t *testing.T) {\n374\t\tenv := setupTest(t)\n375\t\tseedBackgroundData(t, env)\n376\t\n377\t\t// 5 条数据，page_size=2，最后一页（page=3）应有 1 条\n378\t\tresp := env.get(t, \"/api/issues?page=3&page_size=2\")\n379\t\tresult := readListResponse(t, resp)\n380\t\n381\t\tif resp.StatusCode != http.StatusOK {\n382\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n383\t\t}\n384\t\tif len(result.Issues) != 1 {\n385\t\t\tt.Fatalf(\"expected 1 issue on last page, got %d\", len(result.Issues))\n386\t\t}\n387\t\tif result.TotalPages != 3 {\n388\t\t\tt.Errorf(\"expected total_pages=3, got %d\", result.TotalPages)\n389\t\t}\n390\t}\n391\t\n392\t// TestListIssues_FilterByNonexistentRepo 验证：过滤不存在的仓库返回空。\n393\tfunc TestListIssues_FilterByNonexistentRepo(t *testing.T) {\n394\t\tenv := setupTest(t)\n395\t\tseedBackgroundData(t, env)\n396\t\n397\t\tresp := env.get(t, \"/api/issues?repo=nonexistent/repo\")\n398\t\tresult := readListResponse(t, resp)\n399\t\n400\t\tif resp.StatusCode != http.StatusOK {\n401\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n402\t\t}\n403\t\tif len(result.Issues) != 0 {\n404\t\t\tt.Fatalf(\"expected 0 issues, got %d\", len(result.Issues))\n405\t\t}\n406\t\tif result.Total != 0 {\n407\t\t\tt.Errorf(\"expected total=0, got %d\", result.Total)\n408\t\t}\n409\t}\n410\t\n411\t// TestListIssues_SessionIDNullForIdle 验证：idle 状态的 issue session_id 为 null。\n412\t// 通过 claim → release 产生 idle 记录，验证 session_id 被清空。\n413\tfunc TestListIssues_SessionIDNullForIdle(t *testing.T) {\n414\t\tenv := setupTest(t)\n415\t\tapiClaim(t, env, \"test/repo\", 1, \"sess-temp\")\n416\t\tapiRelease(t, env, \"test/repo\", 1, \"sess-temp\")\n417\t\n418\t\tresp := env.get(t, \"/api/issues\")\n419\t\tresult := readListResponse(t, resp)\n420\t\n421\t\tif len(result.Issues) != 1 {\n422\t\t\tt.Fatalf(\"expected 1 issue, got %d\", len(result.Issues))\n423\t\t}\n424\t\tif result.Issues[0].Status != \"idle\" {\n425\t\t\tt.Errorf(\"expected status=idle, got %s\", result.Issues[0].Status)\n426\t\t}\n427\t\tif result.Issues[0].SessionID != nil {\n428\t\t\tt.Errorf(\"expected session_id=null for idle issue, got %v\", *result.Issues[0].SessionID)\n429\t\t}\n430\t}\n431\t\n432\t// TestListIssues_ClaimedAtPopulated 验证：claimed 状态的 issue claimed_at 非空。\n433\tfunc TestListIssues_ClaimedAtPopulated(t *testing.T) {\n434\t\tenv := setupTest(t)\n435\t\tseedBackgroundData(t, env)\n436\t\n437\t\tresp := env.get(t, \"/api/issues?status=claimed\")\n438\t\tresult := readListResponse(t, resp)\n439\t\n440\t\tif len(result.Issues) != 1 {\n441\t\t\tt.Fatalf(\"expected 1 claimed issue, got %d\", len(result.Issues))\n442\t\t}\n443\t\tif result.Issues[0].ClaimedAt == nil {\n444\t\t\tt.Error(\"expected claimed_at to be non-nil for claimed issue\")\n445\t\t}\n446\t}\n447\t\n448\t// TestListIssues_StatusFlowViaAPI 验证：通过 API 完整流转产生多种状态的 issue。\n449\t// 端到端：claim → fixing → ready-for-pr，验证列表中状态正确。\n450\tfunc TestListIssues_StatusFlowViaAPI(t *testing.T) {\n451\t\tenv := setupTest(t)\n452\t\n453\t\t// 通过 API 创建一条 issue 并推到 fixing 状态\n454\t\tapiClaim(t, env, \"flow/repo\", 100, \"sess-flow\")\n455\t\tapiUpdateStatus(t, env, \"flow/repo\", 100, \"sess-flow\", \"fixing\")\n456\t\n457\t\tresp := env.get(t, \"/api/issues?repo=flow/repo\")\n458\t\tresult := readListResponse(t, resp)\n459\t\n460\t\tif len(result.Issues) != 1 {\n461\t\t\tt.Fatalf(\"expected 1 issue, got %d\", len(result.Issues))\n462\t\t}\n463\t\tif result.Issues[0].Status != \"fixing\" {\n464\t\t\tt.Errorf(\"expected status=fixing, got %s\", result.Issues[0].Status)\n465\t\t}\n466\t\tif result.Issues[0].SessionID == nil || *result.Issues[0].SessionID != \"sess-flow\" {\n467\t\t\tt.Errorf(\"expected session_id=sess-flow, got %v\", result.Issues[0].SessionID)\n468\t\t}\n469\t}\n470\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\tests\\e2e\\proxy_trace_test.go"},"tool_use_id":"call_1000fe709c794a6d8be3826b","tool_response":"1\t// Package e2e_test 包含代理层的端到端测试，覆盖请求转发、流式响应、追踪记录等完整链路。\n2\tpackage e2e_test\n3\t\n4\timport (\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"net/http\"\n9\t\t\"net/http/httptest\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"testing\"\n14\t\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/proxy\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/testutil\"\n17\t)\n18\t\n19\t// setupProxyWithTrace 创建带追踪初始化的代理，返回代理 URL、追踪文件路径。\n20\t// 通过调用内部 /_internal/trace-init 端点初始化 session 追踪。\n21\tfunc setupProxyWithTrace(t *testing.T, mockServerURL string) (string, string) {\n22\t\tt.Helper()\n23\t\n24\t\ttraceDir := t.TempDir()\n25\t\trp := proxy.NewReverseProxy(mockServerURL, traceDir)\n26\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n27\t\tif err != nil {\n28\t\t\tt.Fatalf(\"start proxy: %v\", err)\n29\t\t}\n30\t\tt.Cleanup(func() { rp.Stop() })\n31\t\n32\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n33\t\n34\t\t// 通过内部端点初始化追踪\n35\t\tsessionID := \"test-session-001\"\n36\t\tmachineID := \"testuser@testhost\"\n37\t\tprojectSlug := \"test-project\"\n38\t\tinitBody := fmt.Sprintf(\n39\t\t\t`{\"session_id\":\"%s\",\"machine_id\":\"%s\",\"project_slug\":\"%s\"}`,\n40\t\t\tsessionID, machineID, projectSlug,\n41\t\t)\n42\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(initBody))\n43\t\tif err != nil {\n44\t\t\tt.Fatalf(\"trace-init: %v\", err)\n45\t\t}\n46\t\tdefer resp.Body.Close()\n47\t\n48\t\tvar initResult struct {\n49\t\t\tStatus    string `json:\"status\"`\n50\t\t\tTracePath string `json:\"trace_path\"`\n51\t\t}\n52\t\tif err := json.NewDecoder(resp.Body).Decode(&initResult); err != nil {\n53\t\t\tt.Fatalf(\"parse trace-init response: %v\", err)\n54\t\t}\n55\t\tif initResult.Status != \"ok\" {\n56\t\t\tt.Fatalf(\"trace-init failed: %s\", initResult.Status)\n57\t\t}\n58\t\n59\t\ttracePath := initResult.TracePath\n60\t\n61\t\treturn proxyURL, tracePath\n62\t}\n63\t\n64\t// TestNonStreamingRequest 验证：非流式请求正常转发，响应正确，且追踪记录包含脱敏后的请求头。\n65\tfunc TestNonStreamingRequest(t *testing.T) {\n66\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n67\t\tmockServer := testutil.CreateMockServer(t, fx)\n68\t\tdefer mockServer.Close()\n69\t\n70\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n71\t\n72\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n73\t\ttestutil.AssertResponseStatus(t, resp, 200)\n74\t\n75\t\tbody := testutil.DrainAndClose(t, resp)\n76\t\tvar respBody map[string]any\n77\t\tif err := json.Unmarshal(body, &respBody); err != nil {\n78\t\t\tt.Fatalf(\"parse response: %v\", err)\n79\t\t}\n80\t\n81\t\tif respBody[\"type\"] != \"message\" {\n82\t\t\tt.Errorf(\"response type: got %v, want message\", respBody[\"type\"])\n83\t\t}\n84\t\tif respBody[\"stop_reason\"] != \"tool_use\" {\n85\t\t\tt.Errorf(\"stop_reason: got %v, want tool_use\", respBody[\"stop_reason\"])\n86\t\t}\n87\t\n88\t\t// 验证追踪记录\n89\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n90\t\tif len(records) != 1 {\n91\t\t\tt.Fatalf(\"expected 1 trace record, got %d\", len(records))\n92\t\t}\n93\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n94\t\n95\t\t// 验证请求头中的敏感信息已被脱敏\n96\t\treqHeaders, _ := records[0][\"request\"].(map[string]any)[\"headers\"].(map[string]any)\n97\t\tif auth, ok := reqHeaders[\"Authorization\"].(string); ok {\n98\t\t\tif auth == \"Bearer sk-ant-test-key-12345678\" {\n99\t\t\t\tt.Error(\"Authorization header not redacted in trace\")\n100\t\t\t}\n101\t\t}\n102\t\tif apiKey, ok := reqHeaders[\"X-Api-Key\"].(string); ok {\n103\t\t\tif apiKey == \"sk-ant-test-key-12345678\" {\n104\t\t\t\tt.Error(\"X-Api-Key not redacted in trace\")\n105\t\t\t}\n106\t\t}\n107\t}\n108\t\n109\t// TestStreamingSSE 验证：SSE 流式请求正常转发，响应包含所有事件，且追踪记录正确。\n110\tfunc TestStreamingSSE(t *testing.T) {\n111\t\tfx := testutil.LoadFixture(t, \"streaming_anthropic.json\")\n112\t\tmockServer := testutil.CreateMockServer(t, fx)\n113\t\tdefer mockServer.Close()\n114\t\n115\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n116\t\n117\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n118\t\ttestutil.AssertResponseStatus(t, resp, 200)\n119\t\n120\t\tbody := testutil.DrainAndClose(t, resp)\n121\t\tbodyStr := string(body)\n122\t\n123\t\t// 验证响应中包含所有 SSE 事件\n124\t\tif !strings.Contains(bodyStr, \"message_start\") {\n125\t\t\tt.Error(\"response missing message_start event\")\n126\t\t}\n127\t\tif !strings.Contains(bodyStr, \"content_block_delta\") {\n128\t\t\tt.Error(\"response missing content_block_delta event\")\n129\t\t}\n130\t\tif !strings.Contains(bodyStr, \"message_stop\") {\n131\t\t\tt.Error(\"response missing message_stop event\")\n132\t\t}\n133\t\n134\t\t// 验证追踪记录\n135\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n136\t\tif len(records) != 1 {\n137\t\t\tt.Fatalf(\"expected 1 trace record, got %d\", len(records))\n138\t\t}\n139\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n140\t\n141\t\trespMap, _ := records[0][\"response\"].(map[string]any)\n142\t\tif sseEvents, ok := respMap[\"sse_events\"].([]any); ok {\n143\t\t\tif len(sseEvents) == 0 {\n144\t\t\t\tt.Error(\"trace has no sse_events for streaming response\")\n145\t\t\t}\n146\t\t}\n147\t}\n148\t\n149\t// TestMultiTurn 验证：多轮对话请求会在追踪文件中生成多条记录，且 turn 编号递增。\n150\tfunc TestMultiTurn(t *testing.T) {\n151\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n152\t\tmockServer := testutil.CreateMockServer(t, fx)\n153\t\tdefer mockServer.Close()\n154\t\n155\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n156\t\n157\t\t// 发送 3 轮请求\n158\t\tfor i := 0; i < 3; i++ {\n159\t\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n160\t\t\ttestutil.AssertResponseStatus(t, resp, 200)\n161\t\t\tio.ReadAll(resp.Body)\n162\t\t\tresp.Body.Close()\n163\t\t}\n164\t\n165\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n166\t\tif len(records) != 3 {\n167\t\t\tt.Fatalf(\"expected 3 trace records, got %d\", len(records))\n168\t\t}\n169\t\n170\t\t// 验证每轮记录的 turn 编号和 session_id\n171\t\tfor i, rec := range records {\n172\t\t\tturn, _ := rec[\"turn\"].(float64)\n173\t\t\tif int(turn) != i+1 {\n174\t\t\t\tt.Errorf(\"record %d: turn = %v, want %d\", i, turn, i+1)\n175\t\t\t}\n176\t\t\tsid, _ := rec[\"session_id\"].(string)\n177\t\t\tif sid != \"test-session-001\" {\n178\t\t\t\tt.Errorf(\"record %d: session_id = %q, want test-session-001\", i, sid)\n179\t\t\t}\n180\t\t}\n181\t}\n182\t\n183\t// TestSessionIDExtraction 验证：追踪记录中正确提取了 session_id。\n184\tfunc TestSessionIDExtraction(t *testing.T) {\n185\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n186\t\tmockServer := testutil.CreateMockServer(t, fx)\n187\t\tdefer mockServer.Close()\n188\t\n189\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n190\t\n191\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n192\t\tio.ReadAll(resp.Body)\n193\t\tresp.Body.Close()\n194\t\n195\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n196\t\tif len(records) == 0 {\n197\t\t\tt.Fatal(\"no trace records\")\n198\t\t}\n199\t\n200\t\tsid, _ := records[0][\"session_id\"].(string)\n201\t\tif sid != \"test-session-001\" {\n202\t\t\tt.Errorf(\"session_id: got %q, want %q\", sid, \"test-session-001\")\n203\t\t}\n204\t}\n205\t\n206\t// TestTokenStats 验证：代理正确统计 API 调用次数和输入/输出 token 数量。\n207\tfunc TestTokenStats(t *testing.T) {\n208\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n209\t\tmockServer := testutil.CreateMockServer(t, fx)\n210\t\tdefer mockServer.Close()\n211\t\n212\t\ttraceDir := t.TempDir()\n213\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n214\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n215\t\tif err != nil {\n216\t\t\tt.Fatalf(\"start proxy: %v\", err)\n217\t\t}\n218\t\tdefer rp.Stop()\n219\t\n220\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n221\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n222\t\tio.ReadAll(resp.Body)\n223\t\tresp.Body.Close()\n224\t\n225\t\tsummary := rp.Summary()\n226\t\n227\t\t// 验证 API 调用次数\n228\t\tapiCalls, _ := summary[\"api_calls\"].(int)\n229\t\tif apiCalls != 1 {\n230\t\t\tt.Errorf(\"api_calls: got %d, want 1\", apiCalls)\n231\t\t}\n232\t\n233\t\t// 验证输入 token 数\n234\t\tinputTokens, _ := summary[\"input_tokens\"].(int64)\n235\t\tif inputTokens != 1234 {\n236\t\t\tt.Errorf(\"input_tokens: got %d, want 1234\", inputTokens)\n237\t\t}\n238\t\n239\t\t// 验证输出 token 数\n240\t\toutputTokens, _ := summary[\"output_tokens\"].(int64)\n241\t\tif outputTokens != 56 {\n242\t\t\tt.Errorf(\"output_tokens: got %d, want 56\", outputTokens)\n243\t\t}\n244\t}\n245\t\n246\t// TestHeaderRedaction 验证：追踪记录中的敏感请求头（Authorization、X-Api-Key）已被脱敏。\n247\tfunc TestHeaderRedaction(t *testing.T) {\n248\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n249\t\tmockServer := testutil.CreateMockServer(t, fx)\n250\t\tdefer mockServer.Close()\n251\t\n252\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n253\t\n254\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n255\t\tio.ReadAll(resp.Body)\n256\t\tresp.Body.Close()\n257\t\n258\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n259\t\tif len(records) == 0 {\n260\t\t\tt.Fatal(\"no trace records\")\n261\t\t}\n262\t\n263\t\treqMap, _ := records[0][\"request\"].(map[string]any)\n264\t\theaders, _ := reqMap[\"headers\"].(map[string]any)\n265\t\n266\t\t// 验证 X-Api-Key 被脱敏\n267\t\tif apiKey, ok := headers[\"X-Api-Key\"].(string); ok {\n268\t\t\tif apiKey == \"sk-ant-test-key-12345678\" {\n269\t\t\t\tt.Error(\"X-Api-Key not redacted in trace\")\n270\t\t\t}\n271\t\t}\n272\t\t// 验证 Authorization 被脱敏\n273\t\tif auth, ok := headers[\"Authorization\"].(string); ok {\n274\t\t\tif auth == \"Bearer sk-ant-test-key-12345678\" {\n275\t\t\t\tt.Error(\"Authorization not redacted in trace\")\n276\t\t\t}\n277\t\t}\n278\t}\n279\t\n280\t// TestBlockedPath 验证：被屏蔽的路径（如 /admin/config）返回 404，不会转发到上游。\n281\tfunc TestBlockedPath(t *testing.T) {\n282\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n283\t\t\tw.WriteHeader(200)\n284\t\t\tw.Write([]byte(\"should not reach\"))\n285\t\t})\n286\t\tmockServer := httptest.NewServer(mockHandler)\n287\t\tdefer mockServer.Close()\n288\t\n289\t\ttraceDir := t.TempDir()\n290\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n291\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n292\t\tif err != nil {\n293\t\t\tt.Fatalf(\"start proxy: %v\", err)\n294\t\t}\n295\t\tdefer rp.Stop()\n296\t\n297\t\tresp, err := http.Get(\"http://127.0.0.1:\" + fmt.Sprint(port) + \"/admin/config\")\n298\t\tif err != nil {\n299\t\t\tt.Fatalf(\"send request: %v\", err)\n300\t\t}\n301\t\tdefer resp.Body.Close()\n302\t\n303\t\tif resp.StatusCode != 404 {\n304\t\t\tt.Errorf(\"blocked path status: got %d, want 404\", resp.StatusCode)\n305\t\t}\n306\t}\n307\t\n308\t// TestGzipResponse 验证：代理能正确处理 gzip 压缩的响应并解压。\n309\tfunc TestGzipResponse(t *testing.T) {\n310\t\tfx := testutil.LoadFixture(t, \"gzip_response.json\")\n311\t\tmockServer := testutil.CreateMockServer(t, fx)\n312\t\tdefer mockServer.Close()\n313\t\n314\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n315\t\n316\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n317\t\ttestutil.AssertResponseStatus(t, resp, 200)\n318\t\n319\t\tbody := testutil.DrainAndClose(t, resp)\n320\t\tvar respBody map[string]any\n321\t\tif err := json.Unmarshal(body, &respBody); err != nil {\n322\t\t\tt.Fatalf(\"parse response (should be decompressed): %v\", err)\n323\t\t}\n324\t\tif respBody[\"type\"] != \"message\" {\n325\t\t\tt.Errorf(\"response type: got %v, want message\", respBody[\"type\"])\n326\t\t}\n327\t\n328\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n329\t\tif len(records) == 0 {\n330\t\t\tt.Fatal(\"no trace records\")\n331\t\t}\n332\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n333\t}\n334\t\n335\t// TestTraceInitEndpoint 验证：/_internal/trace-init 端点能正确初始化追踪文件并返回路径。\n336\tfunc TestTraceInitEndpoint(t *testing.T) {\n337\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n338\t\t\tw.WriteHeader(200)\n339\t\t\tw.Write([]byte(`{\"id\":\"msg_test\"}`))\n340\t\t})\n341\t\tmockServer := httptest.NewServer(mockHandler)\n342\t\tdefer mockServer.Close()\n343\t\n344\t\ttraceDir := t.TempDir()\n345\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n346\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n347\t\tif err != nil {\n348\t\t\tt.Fatalf(\"start proxy: %v\", err)\n349\t\t}\n350\t\tdefer rp.Stop()\n351\t\n352\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n353\t\n354\t\t// 调用 trace-init\n355\t\tbody := `{\"session_id\":\"sess-abc\",\"machine_id\":\"user@host\",\"project_slug\":\"my-project\"}`\n356\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(body))\n357\t\tif err != nil {\n358\t\t\tt.Fatalf(\"trace-init: %v\", err)\n359\t\t}\n360\t\tdefer resp.Body.Close()\n361\t\n362\t\tif resp.StatusCode != 200 {\n363\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n364\t\t}\n365\t\n366\t\tvar result struct {\n367\t\t\tStatus    string `json:\"status\"`\n368\t\t\tTracePath string `json:\"trace_path\"`\n369\t\t}\n370\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n371\t\t\tt.Fatalf(\"parse response: %v\", err)\n372\t\t}\n373\t\n374\t\tif result.Status != \"ok\" {\n375\t\t\tt.Errorf(\"status: got %q, want ok\", result.Status)\n376\t\t}\n377\t\n378\t\t// 验证追踪文件路径以 session_id 结尾\n379\t\tif !strings.HasSuffix(filepath.ToSlash(result.TracePath), \"sess-abc.jsonl\") {\n380\t\t\tt.Errorf(\"trace_path suffix: got %q, want ending with sess-abc.jsonl\", result.TracePath)\n381\t\t}\n382\t\n383\t\t// 验证追踪文件已被创建\n384\t\tif _, err := os.Stat(result.TracePath); os.IsNotExist(err) {\n385\t\t\tt.Errorf(\"trace file not created: %s\", result.TracePath)\n386\t\t}\n387\t\n388\t\t// 验证目录结构：{machine_id}/{project_slug}/{session_id}.jsonl\n389\t\trel, _ := filepath.Rel(traceDir, result.TracePath)\n390\t\tparts := strings.Split(filepath.ToSlash(rel), \"/\")\n391\t\tif len(parts) != 3 {\n392\t\t\tt.Errorf(\"expected 3 path components (machine/project/file), got %d: %v\", len(parts), parts)\n393\t\t}\n394\t\tif parts[0] != \"user@host\" {\n395\t\t\tt.Errorf(\"machine_id dir: got %q, want user@host\", parts[0])\n396\t\t}\n397\t\tif parts[1] != \"my-project\" {\n398\t\t\tt.Errorf(\"project_slug dir: got %q, want my-project\", parts[1])\n399\t\t}\n400\t}\n401\t\n402\t// TestTraceInitMissingSessionID 验证：trace-init 请求缺少 session_id 时返回 400。\n403\tfunc TestTraceInitMissingSessionID(t *testing.T) {\n404\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n405\t\t\tw.WriteHeader(200)\n406\t\t})\n407\t\tmockServer := httptest.NewServer(mockHandler)\n408\t\tdefer mockServer.Close()\n409\t\n410\t\ttraceDir := t.TempDir()\n411\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n412\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n413\t\tif err != nil {\n414\t\t\tt.Fatalf(\"start proxy: %v\", err)\n415\t\t}\n416\t\tdefer rp.Stop()\n417\t\n418\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n419\t\n420\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(`{\"session_id\":\"\"}`))\n421\t\tif err != nil {\n422\t\t\tt.Fatalf(\"trace-init: %v\", err)\n423\t\t}\n424\t\tdefer resp.Body.Close()\n425\t\n426\t\tif resp.StatusCode != 400 {\n427\t\t\tt.Errorf(\"expected 400, got %d\", resp.StatusCode)\n428\t\t}\n429\t}\n430\t"}]}
