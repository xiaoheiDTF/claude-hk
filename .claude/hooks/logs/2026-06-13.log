tif err != nil {\n44\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to query logs\")\n45\t\t\treturn\n46\t\t}\n47\t\n48\t\titems := make([]LogItem, len(entries))\n49\t\tfor i, e := range entries {\n50\t\t\titems[i] = LogItem{\n51\t\t\t\tTimestamp: e.Timestamp,\n52\t\t\t\tLevel:     e.Level,\n53\t\t\t\tSource:    e.Source,\n54\t\t\t\tMessage:   e.Message,\n55\t\t\t}\n56\t\t}\n57\t\n58\t\t// 确保返回空数组而非 null\n59\t\tif items == nil {\n60\t\t\titems = []LogItem{}\n61\t\t}\n62\t\n63\t\twriteJSON(w, http.StatusOK, LogsResponse{Logs: items})\n64\t}\n65\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/config_handler.go","limit":100},"tool_use_id":"call_93162bac8b7547fbb1fb21ef","tool_response":"1\tpackage api\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"net/http\"\n6\t\t\"strings\"\n7\t\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t)\n11\t\n12\t// ConfigHandler 处理系统配置管理的 HTTP 请求。\n13\ttype ConfigHandler struct {\n14\t\tsvc *service.ConfigService\n15\t}\n16\t\n17\t// NewConfigHandler 创建新的 ConfigHandler 实例。\n18\tfunc NewConfigHandler(svc *service.ConfigService) *ConfigHandler {\n19\t\treturn &ConfigHandler{svc: svc}\n20\t}\n21\t\n22\t// ServeHTTP 处理 /api/config 的 GET 和 PUT 请求。\n23\tfunc (h *ConfigHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n24\t\tswitch r.Method {\n25\t\tcase http.MethodGet:\n26\t\t\th.get(w, r)\n27\t\tcase http.MethodPut:\n28\t\t\th.update(w, r)\n29\t\tdefault:\n30\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET or PUT\")\n31\t\t}\n32\t}\n33\t\n34\t// get 处理 GET /api/config，返回当前所有配置项。\n35\tfunc (h *ConfigHandler) get(w http.ResponseWriter, r *http.Request) {\n36\t\tlogger.Debug(\"api.config\", \"GET /api/config\")\n37\t\n38\t\tconfig, err := h.svc.Get(r.Context())\n39\t\tif err != nil {\n40\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get config\")\n41\t\t\treturn\n42\t\t}\n43\t\n44\t\twriteJSON(w, http.StatusOK, ConfigResponse{Config: config})\n45\t}\n46\t\n47\t// update 处理 PUT /api/config，更新指定的配置项。\n48\tfunc (h *ConfigHandler) update(w http.ResponseWriter, r *http.Request) {\n49\t\t// 解析为通用 map 以支持部分更新\n50\t\tvar raw map[string]interface{}\n51\t\tif err := json.NewDecoder(r.Body).Decode(&raw); err != nil {\n52\t\t\twriteError(w, http.StatusBadRequest, \"invalid_json\", err.Error())\n53\t\t\treturn\n54\t\t}\n55\t\n56\t\tlogger.Debug(\"api.config\", \"PUT /api/config: %v\", raw)\n57\t\n58\t\tif len(raw) == 0 {\n59\t\t\twriteError(w, http.StatusBadRequest, \"no_updates\", \"no valid fields to update\")\n60\t\t\treturn\n61\t\t}\n62\t\n63\t\tif err := h.svc.Update(r.Context(), raw); err != nil {\n64\t\t\t// 根据错误类型返回不同错误码\n65\t\t\terrMsg := err.Error()\n66\t\t\tcode := \"internal_error\"\n67\t\t\tstatus := http.StatusInternalServerError\n68\t\t\tif strings.Contains(errMsg, \"unknown config key\") {\n69\t\t\t\tcode = \"unknown_config_key\"\n70\t\t\t\tstatus = http.StatusBadRequest\n71\t\t\t} else if strings.Contains(errMsg, \"invalid\") {\n72\t\t\t\tcode = \"invalid_config\"\n73\t\t\t\tstatus = http.StatusBadRequest\n74\t\t\t}\n75\t\t\twriteError(w, status, code, errMsg)\n76\t\t\treturn\n77\t\t}\n78\t\n79\t\t// 返回更新后的完整配置\n80\t\tconfig, err := h.svc.Get(r.Context())\n81\t\tif err != nil {\n82\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get updated config\")\n83\t\t\treturn\n84\t\t}\n85\t\n86\t\twriteJSON(w, http.StatusOK, ConfigResponse{Config: config})\n87\t}\n88\t"}]}
