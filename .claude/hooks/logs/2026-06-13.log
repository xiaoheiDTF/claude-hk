l required\", http.StatusBadRequest)\n95\t\t\treturn\n96\t\t}\n97\t\n98\t\th.mu.Lock()\n99\t\th.proxies[req.PID] = req.ProxyURL\n100\t\th.mu.Unlock()\n101\t\n102\t\tlogger.Info(\"api.proxy\", \"registered: pid=%s url=%s\", req.PID, req.ProxyURL)\n103\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n104\t}\n105\t\n106\t// Unregister 处理代理注销请求。\n107\t// POST /api/proxy/unregister\n108\t// Body: {\"pid\": \"28364\"}\n109\tfunc (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request) {\n110\t\tif r.Method != http.MethodPost {\n111\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n112\t\t\treturn\n113\t\t}\n114\t\n115\t\tvar req struct {\n116\t\t\tPID string `json:\"pid\"`\n117\t\t}\n118\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n119\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n120\t\t\treturn\n121\t\t}\n122\t\n123\t\th.mu.Lock()\n124\t\th.unbindProxySessions(req.PID)\n125\t\tdelete(h.proxies, req.PID)\n126\t\th.mu.Unlock()\n127\t\n128\t\tlogger.Info(\"api.proxy\", \"unregistered: pid=%s\", req.PID)\n129\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n130\t}\n131\t\n132\t// TraceInit 转发 trace-init 请求到指定代理。\n133\t// POST /api/proxy/trace-init\n134\t// 路由逻辑：通过 proxy_pid（环境变量注入）精确路由到目标代理。\n135\t// PID 来自 CLAUDE_TAP_PROXY_PID 环境变量，由 proxy 启动时注入子进程，/clear 后仍然有效。\n136\tfunc (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request) {\n137\t\tif r.Method != http.MethodPost {\n138\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n139\t\t\treturn\n140\t\t}\n141\t\n142\t\t// 读取请求体\n143\t\tbody, err := io.ReadAll(r.Body)\n144\t\tif err != nil {\n145\t\t\thttp.Error(w, \"read body failed\", http.StatusBadRequest)\n146\t\t\treturn\n147\t\t}\n148\t\n149\t\t// 解析请求\n150\t\tvar tiReq TraceInitRequest\n151\t\tif err := json.Unmarshal(body, &tiReq); err != nil {\n152\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n153\t\t\treturn\n154\t\t}\n155\t\tif tiReq.SessionID == \"\" {\n156\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n157\t\t\treturn\n158\t\t}\n159\t\tif tiReq.ProxyPID == \"\" {\n160\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: no proxy_pid provided for session=%s\", tiReq.SessionID)\n161\t\t\thttp.Error(w, \"proxy_pid is required\", http.StatusBadRequest)\n162\t\t\treturn\n163\t\t}\n164\t\n165\t\t// 查找目标代理\n166\t\th.mu.RLock()\n167\t\tproxyURL, found := h.proxies[tiReq.ProxyPID]\n168\t\th.mu.RUnlock()\n169\t\n170\t\tif !found {\n171\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: proxy pid=%s not registered\", tiReq.ProxyPID)\n172\t\t\thttp.Error(w, \"proxy not found: \"+tiReq.ProxyPID, http.StatusNotFound)\n173\t\t\treturn\n174\t\t}\n175\t\n176\t\t// 转发到目标代理\n177\t\tresp, err := relayTraceInit(proxyURL, body)\n178\t\tif err != nil {\n179\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: relay to pid=%s failed: %v\", tiReq.ProxyPID, err)\n180\t\t\thttp.Error(w, \"proxy unreachable: \"+err.Error(), http.StatusBadGateway)\n181\t\t\treturn\n182\t\t}\n183\t\n184\t\t// 绑定会话（用于注销时清理）\n185\t\th.mu.Lock()\n186\t\th.bindSession(tiReq.ProxyPID, tiReq.SessionID, proxyURL)\n187\t\th.mu.Unlock()\n188\t\n189\t\tlogger.Info(\"api.proxy\", \"trace-init: session=%s routed to proxy pid=%s\", tiReq.SessionID, tiReq.ProxyPID)\n190\t\twriteJSON(w, http.StatusOK, resp)\n191\t}\n192\t\n193\t// List 处理获取代理列表的请求。\n194\t// GET /api/proxies\n195\t// 查询参数：status（可选）、project（可选）\n196\tfunc (h *ProxyHandler) List(w http.ResponseWriter, r *http.Request) {\n197\t\tif r.Method != http.MethodGet {\n198\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n199\t\t\treturn\n200\t\t}\n201\t\n202\t\tvar filter store.ProxyFilter\n203\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\n204\t\t\tfilter.Status = &v\n205\t\t}\n206\t\tif v := r.URL.Query().Get(\"project\"); v != \"\" {\n207\t\t\tfilter.Project = &v\n208\t\t}\n209\t\n210\t\tlogger.Debug(\"api.proxy\", \"GET /api/proxies status=%v project=%v\", filter.Status, filter.Project)\n211\t\n212\t\tproxies, err := h.svc.List(r.Context(), filter)\n213\t\tif err != nil {\n214\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list proxies\")\n215\t\t\treturn\n216\t\t}\n217\t\n218\t\t// 确保返回空数组而非 null\n219\t\tif proxies == nil {\n220\t\t\tproxies = []store.Proxy{}\n221\t\t}\n222\t\n223\t\titems := make([]ProxyItem, len(proxies))\n224\t\tfor i, p := range proxies {\n225\t\t\titems[i] = ProxyItem{\n226\t\t\t\tProxyID:      p.ProxyID,\n227\t\t\t\tProjectSlug:  p.ProjectSlug,\n228\t\t\t\tStatus:       p.Status,\n229\t\t\t\tRegisteredAt: p.RegisteredAt,\n230\t\t\t\tLastPingAt:   p.LastPingAt,\n231\t\t\t}\n232\t\t}\n233\t\n234\t\twriteJSON(w, http.StatusOK, ProxiesResponse{\n235\t\t\tProxies: items,\n236\t\t\tTotal:   len(items),\n237\t\t})\n238\t}\n239\t\n240\t// relayTraceInit 将 trace-init 请求转发到指定代理。\n241\tfunc relayTraceInit(proxyURL string, body []byte) (map[string]any, error) {\n242\t\tclient := &http.Client{}\n243\t\treq, err := http.NewRequest(\"POST\", proxyURL+\"/_internal/trace-init\", bytes.NewReader(body))\n244\t\tif err != nil {\n245\t\t\treturn nil, err\n246\t\t}\n247\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n248\t\n249\t\tresp, err := client.Do(req)\n250\t\tif err != nil {\n251\t\t\treturn nil, err\n252\t\t}\n253\t\tdefer resp.Body.Close()\n254\t\n255\t\tif resp.StatusCode != http.StatusOK {\n256\t\t\trespBody, _ := io.ReadAll(resp.Body)\n257\t\t\treturn nil, fmt.Errorf(\"proxy returned %d: %s\", resp.StatusCode, string(respBody))\n258\t\t}\n259\t\n260\t\tvar result map[string]any\n261\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n262\t\t\treturn nil, fmt.Errorf(\"decode proxy response: %w\", err)\n263\t\t}\n264\t\treturn result, nil\n265\t}\n266\t"}]}
