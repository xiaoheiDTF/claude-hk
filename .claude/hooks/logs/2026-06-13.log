[2026-06-13 18:18:53] [INFO] [PostToolBatch] Input: {"session_id":"32d40bdf-3481-40af-a99d-16267c06647a","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\32d40bdf-3481-40af-a99d-16267c06647a.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"default","effort":{"level":"medium"},"hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\tests\\backend\\issue_api_test.go"},"tool_use_id":"call_79287e007924482b8f8df1cc","tool_response":"1\t// Package backend_test 包含后端 Issue API 的验收测试，覆盖 check、claim、release、status 等接口。\n2\tpackage backend_test\n3\t\n4\timport (\n5\t\t\"database/sql\"\n6\t\t\"fmt\"\n7\t\t\"encoding/json\"\n8\t\t\"io\"\n9\t\t\"net/http\"\n10\t\t\"net/http/httptest\"\n11\t\t\"os\"\n12\t\t\"strings\"\n13\t\t\"testing\"\n14\t\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n18\t)\n19\t\n20\t// --- helpers ---\n21\t\n22\t// testEnv 是后端测试的通用环境，包含测试服务器和 SQLite 存储。\n23\ttype testEnv struct {\n24\t\tsrv   *httptest.Server\n25\t\tstore *store.SQLiteStore\n26\t}\n27\t\n28\t// setupTest 创建后端测试环境，自动清理临时数据库。\n29\tfunc setupTest(t *testing.T) *testEnv {\n30\t\tt.Helper()\n31\t\n32\t\tf, err := os.CreateTemp(\"\", \"test-check-*.db\")\n33\t\tif err != nil {\n34\t\t\tt.Fatal(err)\n35\t\t}\n36\t\tdbPath := f.Name()\n37\t\tf.Close()\n38\t\n39\t\ts, err := store.NewSQLiteStore(dbPath)\n40\t\tif err != nil {\n41\t\t\tos.Remove(dbPath)\n42\t\t\tt.Fatal(err)\n43\t\t}\n44\t\n45\t\tt.Cleanup(func() {\n46\t\t\ts.Close()\n47\t\t\tos.Remove(dbPath)\n48\t\t})\n49\t\n50\t\tissueSvc := service.NewIssueService(s.Issues())\n51\t\tsessionSvc := service.NewSessionService(s.Sessions())\n52\t\tmachineSvc := service.NewMachineService(s.Machines())\n53\t\tprojectSvc := service.NewProjectService(s.Projects())\n54\t\trouter := api.NewRouter(api.Handlers{\n55\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n56\t\t\tSession: api.NewSessionHandler(sessionSvc, issueSvc, service.NewTokenService(s.Sessions()), service.NewTraceService(s.Sessions())),\n57\t\t\tMachine: api.NewMachineHandler(machineSvc),\n58\t\t\tProject: api.NewProjectHandler(projectSvc),\n59\t\t})\n60\t\n61\t\tsrv := httptest.NewServer(router)\n62\t\tt.Cleanup(srv.Close)\n63\t\n64\t\treturn &testEnv{srv: srv, store: s}\n65\t}\n66\t\n67\t// post 发送 POST 请求到测试环境。\n68\tfunc (e *testEnv) post(t *testing.T, path, body string) *http.Response {\n69\t\tt.Helper()\n70\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n71\t\tif err != nil {\n72\t\t\tt.Fatal(err)\n73\t\t}\n74\t\treturn resp\n75\t}\n76\t\n77\t// readJSON 读取 HTTP 响应并解析为 JSON。\n78\tfunc readJSON(t *testing.T, resp *http.Response, v any) {\n79\t\tt.Helper()\n80\t\tdefer resp.Body.Close()\n81\t\tb, err := io.ReadAll(resp.Body)\n82\t\tif err != nil {\n83\t\t\tt.Fatal(err)\n84\t\t}\n85\t\tif err := json.Unmarshal(b, v); err != nil {\n86\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n87\t\t}\n88\t}\n89\t\n90\t// seedIssue 在数据库中预置一条 issue 记录。\n91\tfunc seedIssue(db *sql.DB, repo string, number int, status, sessionID, claimedAt string) {\n92\t\tdb.Exec(\n93\t\t\t`INSERT INTO issue_claims (repo_full_name, issue_number, status, session_id, claimed_at, updated_at)\n94\t\t\t VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)`,\n95\t\t\trepo, number, status,\n96\t\t\tnilIfEmpty(sessionID), nilIfEmpty(claimedAt),\n97\t\t)\n98\t}\n99\t\n100\t// nilIfEmpty 将空字符串转为 nil，用于数据库插入。\n101\tfunc nilIfEmpty(s string) any {\n102\t\tif s == \"\" {\n103\t\t\treturn nil\n104\t\t}\n105\t\treturn s\n106\t}\n107\t\n108\t// --- tests ---\n109\t\n110\t// TestHealth 验证：/health 健康检查接口返回 200 和 {\"status\":\"ok\"}。\n111\tfunc TestHealth(t *testing.T) {\n112\t\tenv := setupTest(t)\n113\t\n114\t\tresp, err := http.Get(env.srv.URL + \"/health\")\n115\t\tif err != nil {\n116\t\t\tt.Fatal(err)\n117\t\t}\n118\t\tdefer resp.Body.Close()\n119\t\n120\t\tif resp.StatusCode != http.StatusOK {\n121\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n122\t\t}\n123\t\n124\t\tvar result map[string]string\n125\t\treadJSON(t, resp, &result)\n126\t\tif result[\"status\"] != \"ok\" {\n127\t\t\tt.Errorf(\"expected status=ok, got %s\", result[\"status\"])\n128\t\t}\n129\t}\n130\t\n131\t// TestCheckIssues_EmptyArray 验证：传入空 issue 数组时返回空结果。\n132\tfunc TestCheckIssues_EmptyArray(t *testing.T) {\n133\t\tenv := setupTest(t)\n134\t\n135\t\tresp := env.post(t, \"/api/issue/check\",\n136\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[]}`)\n137\t\n138\t\tvar result struct {\n139\t\t\tIssues []any `json:\"issues\"`\n140\t\t}\n141\t\treadJSON(t, resp, &result)\n142\t\n143\t\tif resp.StatusCode != http.StatusOK {\n144\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n145\t\t}\n146\t\tif len(result.Issues) != 0 {\n147\t\t\tt.Fatalf(\"expected empty issues, got %d\", len(result.Issues))\n148\t\t}\n149\t}\n150\t\n151\t// TestCheckIssues_NewIssuesAutoCreatedAsIdle 验证：首次出现的 issue 自动创建为 idle 状态。\n152\tfunc TestCheckIssues_NewIssuesAutoCreatedAsIdle(t *testing.T) {\n153\t\tenv := setupTest(t)\n154\t\n155\t\tresp := env.post(t, \"/api/issue/check\",\n156\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2,3]}`)\n157\t\n158\t\tvar result struct {\n159\t\t\tIssues []struct {\n160\t\t\t\tNumber    int     `json:\"number\"`\n161\t\t\t\tStatus    string  `json:\"status\"`\n162\t\t\t\tSessionID *string `json:\"session_id\"`\n163\t\t\t\tClaimedAt *string `json:\"claimed_at\"`\n164\t\t\t} `json:\"issues\"`\n165\t\t}\n166\t\treadJSON(t, resp, &result)\n167\t\n168\t\tif resp.StatusCode != http.StatusOK {\n169\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n170\t\t}\n171\t\tif len(result.Issues) != 3 {\n172\t\t\tt.Fatalf(\"expected 3 issues, got %d\", len(result.Issues))\n173\t\t}\n174\t\n175\t\tfor _, issue := range result.Issues {\n176\t\t\tif issue.Status != \"idle\" {\n177\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", issue.Number, issue.Status)\n178\t\t\t}\n179\t\t\tif issue.SessionID != nil {\n180\t\t\t\tt.Errorf(\"issue %d: expected null session_id, got %v\", issue.Number, *issue.SessionID)\n181\t\t\t}\n182\t\t\tif issue.ClaimedAt != nil {\n183\t\t\t\tt.Errorf(\"issue %d: expected null claimed_at, got %v\", issue.Number, *issue.ClaimedAt)\n184\t\t\t}\n185\t\t}\n186\t}\n187\t\n188\t// TestCheckIssues_ClaimedAndMerged 验证：check 接口返回不同状态 issue 的正确信息。\n189\t// 覆盖 idle、claimed（有 session_id 和 claimed_at）、merged 三种状态。\n190\tfunc TestCheckIssues_ClaimedAndMerged(t *testing.T) {\n191\t\tenv := setupTest(t)\n192\t\tdb := env.store.DB()\n193\t\n194\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n195\t\tseedIssue(db, \"test/repo\", 11, \"merged\", \"\", \"\")\n196\t\n197\t\tresp := env.post(t, \"/api/issue/check\",\n198\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[9,10,11,12]}`)\n199\t\n200\t\tvar result struct {\n201\t\t\tIssues []struct {\n202\t\t\t\tNumber    int     `json:\"number\"`\n203\t\t\t\tStatus    string  `json:\"status\"`\n204\t\t\t\tSessionID *string `json:\"session_id\"`\n205\t\t\t\tClaimedAt *string `json:\"claimed_at\"`\n206\t\t\t} `json:\"issues\"`\n207\t\t}\n208\t\treadJSON(t, resp, &result)\n209\t\n210\t\tif resp.StatusCode != http.StatusOK {\n211\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n212\t\t}\n213\t\tif len(result.Issues) != 4 {\n214\t\t\tt.Fatalf(\"expected 4 issues, got %d\", len(result.Issues))\n215\t\t}\n216\t\n217\t\tbyNumber := map[int]*struct {\n218\t\t\tNumber    int     `json:\"number\"`\n219\t\t\tStatus    string  `json:\"status\"`\n220\t\t\tSessionID *string `json:\"session_id\"`\n221\t\t\tClaimedAt *string `json:\"claimed_at\"`\n222\t\t}{}\n223\t\tfor i := range result.Issues {\n224\t\t\tbyNumber[result.Issues[i].Number] = &result.Issues[i]\n225\t\t}\n226\t\n227\t\t// #9: 新 issue → idle\n228\t\tif byNumber[9].Status != \"idle\" {\n229\t\t\tt.Errorf(\"issue 9: expected idle, got %s\", byNumber[9].Status)\n230\t\t}\n231\t\n232\t\t// #10: claimed\n233\t\tif byNumber[10].Status != \"claimed\" {\n234\t\t\tt.Errorf(\"issue 10: expected claimed, got %s\", byNumber[10].Status)\n235\t\t}\n236\t\tif byNumber[10].SessionID == nil || *byNumber[10].SessionID != \"sess_abc\" {\n237\t\t\tt.Errorf(\"issue 10: expected session_id=sess_abc, got %v\", byNumber[10].SessionID)\n238\t\t}\n239\t\tif byNumber[10].ClaimedAt == nil {\n240\t\t\tt.Error(\"issue 10: expected non-nil claimed_at\")\n241\t\t}\n242\t\n243\t\t// #11: merged\n244\t\tif byNumber[11].Status != \"merged\" {\n245\t\t\tt.Errorf(\"issue 11: expected merged, got %s\", byNumber[11].Status)\n246\t\t}\n247\t\tif byNumber[11].SessionID != nil {\n248\t\t\tt.Errorf(\"issue 11: expected null session_id, got %v\", byNumber[11].SessionID)\n249\t\t}\n250\t\n251\t\t// #12: 新 issue → idle\n252\t\tif byNumber[12].Status != \"idle\" {\n253\t\t\tt.Errorf(\"issue 12: expected idle, got %s\", byNumber[12].Status)\n254\t\t}\n255\t}\n256\t\n257\t// TestCheckIssues_MissingRepoFullName 验证：缺少 repo_full_name 返回 400。\n258\tfunc TestCheckIssues_MissingRepoFullName(t *testing.T) {\n259\t\tenv := setupTest(t)\n260\t\n261\t\tresp := env.post(t, \"/api/issue/check\",\n262\t\t\t`{\"issue_numbers\":[1]}`)\n263\t\n264\t\tvar errResp struct {\n265\t\t\tCode    string `json:\"error\"`\n266\t\t\tMessage string `json:\"message\"`\n267\t\t}\n268\t\treadJSON(t, resp, &errResp)\n269\t\n270\t\tif resp.StatusCode != http.StatusBadRequest {\n271\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n272\t\t}\n273\t\tif errResp.Code != \"invalid_request\" {\n274\t\t\tt.Errorf(\"expected error=invalid_request, got %s\", errResp.Code)\n275\t\t}\n276\t}\n277\t\n278\t// TestCheckIssues_MissingIssueNumbers 验证：缺少 issue_numbers 返回 400。\n279\tfunc TestCheckIssues_MissingIssueNumbers(t *testing.T) {\n280\t\tenv := setupTest(t)\n281\t\n282\t\tresp := env.post(t, \"/api/issue/check\",\n283\t\t\t`{\"repo_full_name\":\"test/repo\"}`)\n284\t\n285\t\tvar errResp struct {\n286\t\t\tCode    string `json:\"error\"`\n287\t\t\tMessage string `json:\"message\"`\n288\t\t}\n289\t\treadJSON(t, resp, &errResp)\n290\t\n291\t\tif resp.StatusCode != http.StatusBadRequest {\n292\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n293\t\t}\n294\t\tif errResp.Code != \"invalid_request\" {\n295\t\t\tt.Errorf(\"expected error=invalid_request, got %s\", errResp.Code)\n296\t\t}\n297\t}\n298\t\n299\t// TestCheckIssues_InvalidJSON 验证：非法 JSON 请求体返回 400。\n300\tfunc TestCheckIssues_InvalidJSON(t *testing.T) {\n301\t\tenv := setupTest(t)\n302\t\n303\t\tresp := env.post(t, \"/api/issue/check\", `not json`)\n304\t\n305\t\tvar errResp struct {\n306\t\t\tCode    string `json:\"error\"`\n307\t\t\tMessage string `json:\"message\"`\n308\t\t}\n309\t\treadJSON(t, resp, &errResp)\n310\t\n311\t\tif resp.StatusCode != http.StatusBadRequest {\n312\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n313\t\t}\n314\t\tif errResp.Code != \"invalid_request\" {\n315\t\t\tt.Errorf(\"expected error=invalid_request, got %s\", errResp.Code)\n316\t\t}\n317\t}\n318\t\n319\t// TestCheckIssues_MethodNotAllowed 验证：GET 请求访问 check 接口返回 405。\n320\tfunc TestCheckIssues_MethodNotAllowed(t *testing.T) {\n321\t\tenv := setupTest(t)\n322\t\n323\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/check\")\n324\t\tif err != nil {\n325\t\t\tt.Fatal(err)\n326\t\t}\n327\t\n328\t\tvar errResp struct {\n329\t\t\tCode    string `json:\"error\"`\n330\t\t\tMessage string `json:\"message\"`\n331\t\t}\n332\t\treadJSON(t, resp, &errResp)\n333\t\n334\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n335\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n336\t\t}\n337\t\tif errResp.Code != \"method_not_allowed\" {\n338\t\t\tt.Errorf(\"expected error=method_not_allowed, got %s\", errResp.Code)\n339\t\t}\n340\t}\n341\t\n342\t// TestCheckIssues_IdempotentOnRepeatedCalls 验证：重复调用 check 接口是幂等的。\n343\tfunc TestCheckIssues_IdempotentOnRepeatedCalls(t *testing.T) {\n344\t\tenv := setupTest(t)\n345\t\n346\t\t// 第一次调用创建 idle 记录\n347\t\tenv.post(t, \"/api/issue/check\",\n348\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2]}`)\n349\t\n350\t\t// 第二次调用应返回相同的 idle 记录\n351\t\tresp := env.post(t, \"/api/issue/check\",\n352\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2]}`)\n353\t\n354\t\tvar result struct {\n355\t\t\tIssues []struct {\n356\t\t\t\tNumber int    `json:\"number\"`\n357\t\t\t\tStatus string `json:\"status\"`\n358\t\t\t} `json:\"issues\"`\n359\t\t}\n360\t\treadJSON(t, resp, &result)\n361\t\n362\t\tif resp.StatusCode != http.StatusOK {\n363\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n364\t\t}\n365\t\tif len(result.Issues) != 2 {\n366\t\t\tt.Fatalf(\"expected 2 issues, got %d\", len(result.Issues))\n367\t\t}\n368\t\tfor _, issue := range result.Issues {\n369\t\t\tif issue.Status != \"idle\" {\n370\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", issue.Number, issue.Status)\n371\t\t\t}\n372\t\t}\n373\t}\n374\t\n375\t// --- Release Issue tests ---\n376\t// POST /api/issue/release — 单个 issue 释放\n377\t// 验收标准：\n378\t//   - 领取者可释放自己的 issue\n379\t//   - 非领取者无法释放（返回 not_owner）\n380\t//   - merged/rejected 终态不被释放\n381\t//   - 参数缺失时返回错误\n382\t\n383\t// TestReleaseIssue 验证单个 issue 释放接口。\n384\tfunc TestReleaseIssue(t *testing.T) {\n385\t\tt.Run(\"owner_can_release\", func(t *testing.T) {\n386\t\t\t// 验收：领取者可释放自己的 issue\n387\t\t\t// 预置 #10 为 claimed（sess_abc 领取），用 sess_abc 调 release → success=true\n388\t\t\t// 释放后再 check 验证 #10 回到 idle、session_id=null\n389\t\t\tenv := setupTest(t)\n390\t\t\tdb := env.store.DB()\n391\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n392\t\n393\t\t\tresp := env.post(t, \"/api/issue/release\",\n394\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n395\t\n396\t\t\tvar result struct {\n397\t\t\t\tSuccess  bool  `json:\"success\"`\n398\t\t\t\tReleased *bool `json:\"released\"`\n399\t\t\t\tError    string `json:\"error\"`\n400\t\t\t}\n401\t\t\treadJSON(t, resp, &result)\n402\t\n403\t\t\tif resp.StatusCode != http.StatusOK {\n404\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n405\t\t\t}\n406\t\t\tif !result.Success {\n407\t\t\t\tt.Fatalf(\"expected success=true, got false (error: %s)\", result.Error)\n408\t\t\t}\n409\t\t\tif result.Released == nil || !*result.Released {\n410\t\t\t\tt.Fatal(\"expected released=true\")\n411\t\t\t}\n412\t\n413\t\t\t// 验证 issue 状态已回到 idle\n414\t\t\tcheckResp := env.post(t, \"/api/issue/check\",\n415\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[10]}`)\n416\t\t\tvar check struct {\n417\t\t\t\tIssues []struct {\n418\t\t\t\t\tStatus    string  `json:\"status\"`\n419\t\t\t\t\tSessionID *string `json:\"session_id\"`\n420\t\t\t\t} `json:\"issues\"`\n421\t\t\t}\n422\t\t\treadJSON(t, checkResp, &check)\n423\t\t\tif len(check.Issues) != 1 {\n424\t\t\t\tt.Fatalf(\"expected 1 issue, got %d\", len(check.Issues))\n425\t\t\t}\n426\t\t\tif check.Issues[0].Status != \"idle\" {\n427\t\t\t\tt.Errorf(\"expected idle after release, got %s\", check.Issues[0].Status)\n428\t\t\t}\n429\t\t\tif check.Issues[0].SessionID != nil {\n430\t\t\t\tt.Error(\"session_id should be null after release\")\n431\t\t\t}\n432\t\t})\n433\t\n434\t\tt.Run(\"non_owner_cannot_release\", func(t *testing.T) {\n435\t\t\t// 验收：非领取者无法释放（返回 not_owner）\n436\t\t\t// 预置 #10 为 claimed（sess_abc 领取），用 sess_other 调 release → success=false, error=not_owner\n437\t\t\tenv := setupTest(t)\n438\t\t\tdb := env.store.DB()\n439\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n440\t\n441\t\t\tresp := env.post(t, \"/api/issue/release\",\n442\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\"}`)\n443\t\n444\t\t\tvar result struct {\n445\t\t\t\tSuccess bool   `json:\"success\"`\n446\t\t\t\tError   string `json:\"error\"`\n447\t\t\t}\n448\t\t\treadJSON(t, resp, &result)\n449\t\n450\t\t\tif resp.StatusCode != http.StatusOK {\n451\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n452\t\t\t}\n453\t\t\tif result.Success {\n454\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n455\t\t\t}\n456\t\t\tif result.Error != \"not_owner\" {\n457\t\t\t\tt.Fatalf(\"expected error=not_owner, got %s\", result.Error)\n458\t\t\t}\n459\t\t})\n460\t\n461\t\tt.Run(\"terminal_merged_not_released\", func(t *testing.T) {\n462\t\t\t// 验收：merged 状态的 issue 不被释放\n463\t\t\t// 预置 #10 为 merged（sess_abc 领取），用 sess_abc 调 release → success=false\n464\t\t\t// 即使是领取者本人，终态也不可释放\n465\t\t\tenv := setupTest(t)\n466\t\t\tdb := env.store.DB()\n467\t\t\tseedIssue(db, \"test/repo\", 10, \"merged\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n468\t\n469\t\t\tresp := env.post(t, \"/api/issue/release\",\n470\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n471\t\n472\t\t\tvar result struct {\n473\t\t\t\tSuccess bool `json:\"success\"`\n474\t\t\t}\n475\t\t\treadJSON(t, resp, &result)\n476\t\n477\t\t\tif result.Success {\n478\t\t\t\tt.Fatal(\"merged issue should not be released\")\n479\t\t\t}\n480\t\t})\n481\t\n482\t\tt.Run(\"terminal_rejected_not_released\", func(t *testing.T) {\n483\t\t\t// 验收：rejected 状态的 issue 不被释放\n484\t\t\t// 预置 #10 为 rejected（sess_abc 领取），用 sess_abc 调 release → success=false\n485\t\t\tenv := setupTest(t)\n486\t\t\tdb := env.store.DB()\n487\t\t\tseedIssue(db, \"test/repo\", 10, \"rejected\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n488\t\n489\t\t\tresp := env.post(t, \"/api/issue/release\",\n490\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n491\t\n492\t\t\tvar result struct {\n493\t\t\t\tSuccess bool `json:\"success\"`\n494\t\t\t}\n495\t\t\treadJSON(t, resp, &result)\n496\t\n497\t\t\tif result.Success {\n498\t\t\t\tt.Fatal(\"rejected issue should not be released\")\n499\t\t\t}\n500\t\t})\n501\t\n502\t\tt.Run(\"non_terminal_statuses_releasable\", func(t *testing.T) {\n503\t\t\t// 补充：非终态（claimed/fixing/ready-for-pr/pr-created/testing/reviewing）都可释放\n504\t\t\t// 预置 #10 为 fixing（sess_abc），释放后验证回到 idle\n505\t\t\tenv := setupTest(t)\n506\t\t\tdb := env.store.DB()\n507\t\t\tseedIssue(db, \"test/repo\", 10, \"fixing\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n508\t\n509\t\t\tresp := env.post(t, \"/api/issue/release\",\n510\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n511\t\n512\t\t\tvar result struct {\n513\t\t\t\tSuccess  bool  `json:\"success\"`\n514\t\t\t\tReleased *bool `json:\"released\"`\n515\t\t\t}\n516\t\t\treadJSON(t, resp, &result)\n517\t\n518\t\t\tif !result.Success {\n519\t\t\t\tt.Fatal(\"fixing status should be releasable by owner\")\n520\t\t\t}\n521\t\t\tif result.Released == nil || !*result.Released {\n522\t\t\t\tt.Fatal(\"expected released=true\")\n523\t\t\t}\n524\t\t})\n525\t\n526\t\tt.Run(\"nonexistent_issue_returns_not_owner\", func(t *testing.T) {\n527\t\t\t// 补充：issue 不存在时返回 success=false（无记录可释放）\n528\t\t\tenv := setupTest(t)\n529\t\n530\t\t\tresp := env.post(t, \"/api/issue/release\",\n531\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":999,\"session_id\":\"sess_abc\"}`)\n532\t\n533\t\t\tvar result struct {\n534\t\t\t\tSuccess bool `json:\"success\"`\n535\t\t\t}\n536\t\t\treadJSON(t, resp, &result)\n537\t\n538\t\t\tif result.Success {\n539\t\t\t\tt.Fatal(\"nonexistent issue should not be released\")\n540\t\t\t}\n541\t\t})\n542\t\n543\t\tt.Run(\"missing_params_returns_400\", func(t *testing.T) {\n544\t\t\t// 验收：参数缺失时返回错误响应\n545\t\t\t// 缺少 session_id → 400\n546\t\t\tenv := setupTest(t)\n547\t\n548\t\t\tresp := env.post(t, \"/api/issue/release\",\n549\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10}`)\n550\t\n551\t\t\tif resp.StatusCode != http.StatusBadRequest {\n552\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n553\t\t\t}\n554\t\t})\n555\t}\n556\t\n557\t// --- Release Session tests ---\n558\t// POST /api/issue/release-session — 按 session 批量释放\n559\t// 验收标准：\n560\t//   - 释放该 session 所有未终态的 issue\n561\t//   - 已合并/打回的 issue 不受影响\n562\t//   - 无领取记录的 session 返回空列表\n563\t\n564\t// TestReleaseSession 验证按 session 批量释放接口。\n565\tfunc TestReleaseSession(t *testing.T) {\n566\t\tt.Run(\"releases_all_non_terminal\", func(t *testing.T) {\n567\t\t\t// 验收：释放该 session 所有未终态的 issue\n568\t\t\t// 验收：已合并/打回的 issue 不受影响\n569\t\t\t// 预置 sess_abc 领取 3 个 issue：\n570\t\t\t//   #10 claimed（非终态，应释放）\n571\t\t\t//   #11 fixing（非终态，应释放）\n572\t\t\t//   #12 merged（终态，不应释放）\n573\t\t\t// 调 release-session → released=[10,11], count=2\n574\t\t\t// 再 check 验证 #10/#11 回到 idle，#12 仍为 merged\n575\t\t\tenv := setupTest(t)\n576\t\t\tdb := env.store.DB()\n577\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n578\t\t\tseedIssue(db, \"test/repo\", 11, \"fixing\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n579\t\t\tseedIssue(db, \"test/repo\", 12, \"merged\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n580\t\n581\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n582\t\t\t\t`{\"session_id\":\"sess_abc\"}`)\n583\t\n584\t\t\tvar result struct {\n585\t\t\t\tReleased []int `json:\"released\"`\n586\t\t\t\tCount    int   `json:\"count\"`\n587\t\t\t}\n588\t\t\treadJSON(t, resp, &result)\n589\t\n590\t\t\tif resp.StatusCode != http.StatusOK {\n591\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n592\t\t\t}\n593\t\t\tif result.Count != 2 {\n594\t\t\t\tt.Fatalf(\"expected 2 released, got %d\", result.Count)\n595\t\t\t}\n596\t\n597\t\t\treleasedSet := map[int]bool{}\n598\t\t\tfor _, n := range result.Released {\n599\t\t\t\treleasedSet[n] = true\n600\t\t\t}\n601\t\t\tif !releasedSet[10] || !releasedSet[11] {\n602\t\t\t\tt.Fatalf(\"expected issues 10 and 11 in released, got %v\", result.Released)\n603\t\t\t}\n604\t\n605\t\t\t// 验证 #12（merged）不受影响\n606\t\t\tcheckResp := env.post(t, \"/api/issue/check\",\n607\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[10,11,12]}`)\n608\t\t\tvar check struct {\n609\t\t\t\tIssues []struct {\n610\t\t\t\t\tNumber int    `json:\"number\"`\n611\t\t\t\t\tStatus string `json:\"status\"`\n612\t\t\t\t} `json:\"issues\"`\n613\t\t\t}\n614\t\t\treadJSON(t, checkResp, &check)\n615\t\n616\t\t\tbyNum := map[int]string{}\n617\t\t\tfor _, iss := range check.Issues {\n618\t\t\t\tbyNum[iss.Number] = iss.Status\n619\t\t\t}\n620\t\t\tif byNum[10] != \"idle\" || byNum[11] != \"idle\" {\n621\t\t\t\tt.Fatalf(\"expected 10,11 idle after release, got %v\", byNum)\n622\t\t\t}\n623\t\t\tif byNum[12] != \"merged\" {\n624\t\t\t\tt.Fatalf(\"expected 12 still merged, got %s\", byNum[12])\n625\t\t\t}\n626\t\t})\n627\t\n628\t\tt.Run(\"rejected_not_released\", func(t *testing.T) {\n629\t\t\t// 验收：已打回的 issue 不受影响\n630\t\t\t// 预置 sess_abc 领取 #10（rejected），调 release-session → count=0\n631\t\t\tenv := setupTest(t)\n632\t\t\tdb := env.store.DB()\n633\t\t\tseedIssue(db, \"test/repo\", 10, \"rejected\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n634\t\n635\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n636\t\t\t\t`{\"session_id\":\"sess_abc\"}`)\n637\t\n638\t\t\tvar result struct {\n639\t\t\t\tCount int `json:\"count\"`\n640\t\t\t}\n641\t\t\treadJSON(t, resp, &result)\n642\t\n643\t\t\tif result.Count != 0 {\n644\t\t\t\tt.Fatalf(\"rejected should not be released, got count=%d\", result.Count)\n645\t\t\t}\n646\t\t})\n647\t\n648\t\tt.Run(\"no_claims_returns_empty\", func(t *testing.T) {\n649\t\t\t// 验收：无领取记录的 session 返回空列表\n650\t\t\t// 无任何预置数据，调 release-session → released=[], count=0\n651\t\t\tenv := setupTest(t)\n652\t\n653\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n654\t\t\t\t`{\"session_id\":\"sess_none\"}`)\n655\t\n656\t\t\tvar result struct {\n657\t\t\t\tReleased []int `json:\"released\"`\n658\t\t\t\tCount    int   `json:\"count\"`\n659\t\t\t}\n660\t\t\treadJSON(t, resp, &result)\n661\t\n662\t\t\tif resp.StatusCode != http.StatusOK {\n663\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n664\t\t\t}\n665\t\t\tif result.Count != 0 {\n666\t\t\t\tt.Errorf(\"expected 0 released, got %d\", result.Count)\n667\t\t\t}\n668\t\t\tif len(result.Released) != 0 {\n669\t\t\t\tt.Errorf(\"expected empty released array, got %v\", result.Released)\n670\t\t\t}\n671\t\t})\n672\t\n673\t\tt.Run(\"only_releases_own_session\", func(t *testing.T) {\n674\t\t\t// 补充：只释放目标 session 的 issue，不影响其他 session\n675\t\t\t// 预置 #10（sess_abc claimed）和 #11（sess_other claimed）\n676\t\t\t// 调 release-session(sess_abc) → 只释放 #10，#11 不受影响\n677\t\t\tenv := setupTest(t)\n678\t\t\tdb := env.store.DB()\n679\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n680\t\t\tseedIssue(db, \"test/repo\", 11, \"claimed\", \"sess_other\", \"2026-05-26T10:00:00Z\")\n681\t\n682\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n683\t\t\t\t`{\"session_id\":\"sess_abc\"}`)\n684\t\n685\t\t\tvar result struct {\n686\t\t\t\tReleased []int `json:\"released\"`\n687\t\t\t\tCount    int   `json:\"count\"`\n688\t\t\t}\n689\t\t\treadJSON(t, resp, &result)\n690\t\n691\t\t\tif result.Count != 1 {\n692\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n693\t\t\t}\n694\t\t\tif len(result.Released) != 1 || result.Released[0] != 10 {\n695\t\t\t\tt.Fatalf(\"expected [10], got %v\", result.Released)\n696\t\t\t}\n697\t\n698\t\t\t// 验证 #11 仍为 claimed（sess_other 的）\n699\t\t\tcheckResp := env.post(t, \"/api/issue/check\",\n700\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[11]}`)\n701\t\t\tvar check struct {\n702\t\t\t\tIssues []struct {\n703\t\t\t\t\tStatus    string  `json:\"status\"`\n704\t\t\t\t\tSessionID *string `json:\"session_id\"`\n705\t\t\t\t} `json:\"issues\"`\n706\t\t\t}\n707\t\t\treadJSON(t, checkResp, &check)\n708\t\t\tif len(check.Issues) != 1 {\n709\t\t\t\tt.Fatalf(\"expected 1 issue, got %d\", len(check.Issues))\n710\t\t\t}\n711\t\t\tif check.Issues[0].Status != \"claimed\" {\n712\t\t\t\tt.Errorf(\"expected #11 still claimed, got %s\", check.Issues[0].Status)\n713\t\t\t}\n714\t\t\tif check.Issues[0].SessionID == nil || *check.Issues[0].SessionID != \"sess_other\" {\n715\t\t\t\tt.Error(\"expected #11 still owned by sess_other\")\n716\t\t\t}\n717\t\t})\n718\t\n719\t\tt.Run(\"missing_session_id_returns_400\", func(t *testing.T) {\n720\t\t\t// 验收：参数缺失时返回错误响应\n721\t\t\t// 缺少 session_id → 400\n722\t\t\tenv := setupTest(t)\n723\t\n724\t\t\tresp := env.post(t, \"/api/issue/release-session\", `{}`)\n725\t\n726\t\t\tif resp.StatusCode != http.StatusBadRequest {\n727\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n728\t\t\t}\n729\t\t})\n730\t}\n731\t\n732\t// --- D2: Issue Status Update tests ---\n733\t// POST /api/issue/status — 更新 issue 状态（D2-D6 使用）\n734\t// 验收标准：\n735\t//   - 领取者可将 issue 状态从 claimed 更新为 fixing\n736\t//   - 非 owner session 无法更新状态\n737\t//   - 不存在的 issue 返回 not_found\n738\t//   - 参数缺失时返回 400\n739\t//   - 同一状态幂等更新返回成功\n740\t//   - 完整流程：claim → fixing 验证状态正确流转\n741\t\n742\t// TestUpdateStatus 验证 Issue 状态更新接口。\n743\tfunc TestUpdateStatus(t *testing.T) {\n744\t\tt.Run(\"owner_can_update_to_fixing\", func(t *testing.T) {\n745\t\t\tenv := setupTest(t)\n746\t\t\tdb := env.store.DB()\n747\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n748\t\n749\t\t\tresp := env.post(t, \"/api/issue/status\",\n750\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n751\t\n752\t\t\tvar result struct {\n753\t\t\t\tSuccess        bool   `json:\"success\"`\n754\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n755\t\t\t\tNewStatus      string `json:\"new_status\"`\n756\t\t\t\tError          string `json:\"error\"`\n757\t\t\t}\n758\t\t\treadJSON(t, resp, &result)\n759\t\n760\t\t\tif resp.StatusCode != http.StatusOK {\n761\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n762\t\t\t}\n763\t\t\tif !result.Success {\n764\t\t\t\tt.Fatalf(\"expected success=true, got false (error: %s)\", result.Error)\n765\t\t\t}\n766\t\t\tif result.PreviousStatus != \"claimed\" {\n767\t\t\t\tt.Errorf(\"expected previous_status=claimed, got %s\", result.PreviousStatus)\n768\t\t\t}\n769\t\t\tif result.NewStatus != \"fixing\" {\n770\t\t\t\tt.Errorf(\"expected new_status=fixing, got %s\", result.NewStatus)\n771\t\t\t}\n772\t\n773\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n774\t\t\tif statuses[10] != \"fixing\" {\n775\t\t\t\tt.Errorf(\"expected fixing after update, got %s\", statuses[10])\n776\t\t\t}\n777\t\t})\n778\t\n779\t\tt.Run(\"non_owner_cannot_update\", func(t *testing.T) {\n780\t\t\tenv := setupTest(t)\n781\t\t\tdb := env.store.DB()\n782\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n783\t\n784\t\t\tresp := env.post(t, \"/api/issue/status\",\n785\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"fixing\"}`)\n786\t\n787\t\t\tvar result struct {\n788\t\t\t\tSuccess        bool   `json:\"success\"`\n789\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n790\t\t\t\tError          string `json:\"error\"`\n791\t\t\t}\n792\t\t\treadJSON(t, resp, &result)\n793\t\n794\t\t\tif result.Success {\n795\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n796\t\t\t}\n797\t\t\tif result.Error != \"not_owner\" {\n798\t\t\t\tt.Errorf(\"expected error=not_owner, got %s\", result.Error)\n799\t\t\t}\n800\t\n801\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n802\t\t\tif statuses[10] != \"claimed\" {\n803\t\t\t\tt.Errorf(\"expected status unchanged (claimed), got %s\", statuses[10])\n804\t\t\t}\n805\t\t})\n806\t\n807\t\tt.Run(\"nonexistent_issue_returns_not_found\", func(t *testing.T) {\n808\t\t\tenv := setupTest(t)\n809\t\n810\t\t\tresp := env.post(t, \"/api/issue/status\",\n811\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":999,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n812\t\n813\t\t\tvar result struct {\n814\t\t\t\tSuccess bool   `json:\"success\"`\n815\t\t\t\tError   string `json:\"error\"`\n816\t\t\t}\n817\t\t\treadJSON(t, resp, &result)\n818\t\n819\t\t\tif result.Success {\n820\t\t\t\tt.Fatal(\"expected success=false for nonexistent issue\")\n821\t\t\t}\n822\t\t\tif result.Error != \"not_found\" {\n823\t\t\t\tt.Errorf(\"expected error=not_found, got %s\", result.Error)\n824\t\t\t}\n825\t\t})\n826\t\n827\t\tt.Run(\"missing_params_returns_400\", func(t *testing.T) {\n828\t\t\tenv := setupTest(t)\n829\t\n830\t\t\tresp := env.post(t, \"/api/issue/status\",\n831\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n832\t\t\tif resp.StatusCode != http.StatusBadRequest {\n833\t\t\t\tt.Fatalf(\"expected 400 missing status, got %d\", resp.StatusCode)\n834\t\t\t}\n835\t\n836\t\t\tresp = env.post(t, \"/api/issue/status\",\n837\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"status\":\"fixing\"}`)\n838\t\t\tif resp.StatusCode != http.StatusBadRequest {\n839\t\t\t\tt.Fatalf(\"expected 400 missing session_id, got %d\", resp.StatusCode)\n840\t\t\t}\n841\t\n842\t\t\tresp = env.post(t, \"/api/issue/status\",\n843\t\t\t\t`{\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n844\t\t\tif resp.StatusCode != http.StatusBadRequest {\n845\t\t\t\tt.Fatalf(\"expected 400 missing repo, got %d\", resp.StatusCode)\n846\t\t\t}\n847\t\t})\n848\t\n849\t\tt.Run(\"idempotent_same_status\", func(t *testing.T) {\n850\t\t\tenv := setupTest(t)\n851\t\t\tdb := env.store.DB()\n852\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n853\t\n854\t\t\tresp := env.post(t, \"/api/issue/status\",\n855\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n856\t\t\tvar r1 struct{ Success bool `json:\"success\"` }\n857\t\t\treadJSON(t, resp, &r1)\n858\t\t\tif !r1.Success {\n859\t\t\t\tt.Fatal(\"first update should succeed\")\n860\t\t\t}\n861\t\n862\t\t\tresp = env.post(t, \"/api/issue/status\",\n863\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n864\t\t\tvar r2 struct {\n865\t\t\t\tSuccess   bool   `json:\"success\"`\n866\t\t\t\tNewStatus string `json:\"new_status\"`\n867\t\t\t}\n868\t\t\treadJSON(t, resp, &r2)\n869\t\t\tif !r2.Success {\n870\t\t\t\tt.Fatal(\"idempotent update should succeed\")\n871\t\t\t}\n872\t\t\tif r2.NewStatus != \"fixing\" {\n873\t\t\t\tt.Errorf(\"expected new_status=fixing, got %s\", r2.NewStatus)\n874\t\t\t}\n875\t\t})\n876\t\n877\t\tt.Run(\"full_claim_to_fix_flow\", func(t *testing.T) {\n878\t\t\tenv := setupTest(t)\n879\t\n880\t\t\t// 1. check 创建 idle\n881\t\t\tenv.post(t, \"/api/issue/check\",\n882\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[20]}`)\n883\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{20})\n884\t\t\tif s[20] != \"idle\" {\n885\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[20])\n886\t\t\t}\n887\t\n888\t\t\t// 2. claim\n889\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 20, \"sess_fix\")\n890\t\t\tif code != http.StatusOK || !ok {\n891\t\t\t\tt.Fatalf(\"step 2: claim failed\")\n892\t\t\t}\n893\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{20})\n894\t\t\tif s[20] != \"claimed\" {\n895\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", s[20])\n896\t\t\t}\n897\t\n898\t\t\t// 3. 标记 fixing\n899\t\t\tresp := env.post(t, \"/api/issue/status\",\n900\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":20,\"session_id\":\"sess_fix\",\"status\":\"fixing\"}`)\n901\t\t\tvar r struct {\n902\t\t\t\tSuccess        bool   `json:\"success\"`\n903\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n904\t\t\t\tNewStatus      string `json:\"new_status\"`\n905\t\t\t}\n906\t\t\treadJSON(t, resp, &r)\n907\t\t\tif !r.Success {\n908\t\t\t\tt.Fatal(\"step 3: update to fixing failed\")\n909\t\t\t}\n910\t\t\tif r.PreviousStatus != \"claimed\" {\n911\t\t\t\tt.Errorf(\"step 3: expected previous=claimed, got %s\", r.PreviousStatus)\n912\t\t\t}\n913\t\n914\t\t\t// 4. 验证最终状态\n915\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{20})\n916\t\t\tif s[20] != \"fixing\" {\n917\t\t\t\tt.Fatalf(\"step 4: expected fixing, got %s\", s[20])\n918\t\t\t}\n919\t\t})\n920\t\n921\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n922\t\t\tenv := setupTest(t)\n923\t\n924\t\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/status\")\n925\t\t\tif err != nil {\n926\t\t\t\tt.Fatal(err)\n927\t\t\t}\n928\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n929\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n930\t\t\t}\n931\t\t})\n932\t}\n933\t\n934\t// claimIssue 调用 claim API 并返回 (statusCode, success, claimed_by)。\n935\tfunc claimIssue(t *testing.T, env *testEnv, repo string, number int, sessionID string) (int, bool, string) {\n936\t\tt.Helper()\n937\t\n938\t\tbody := fmt.Sprintf(\n939\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n940\t\t\trepo, number, sessionID)\n941\t\tresp := env.post(t, \"/api/issue/claim\", body)\n942\t\n943\t\tvar result struct {\n944\t\t\tSuccess   bool    `json:\"success\"`\n945\t\t\tError     string  `json:\"error\"`\n946\t\t\tClaimedBy *string `json:\"claimed_by\"`\n947\t\t\tStatus    string  `json:\"status\"`\n948\t\t}\n949\t\treadJSON(t, resp, &result)\n950\t\n951\t\tclaimedBy := \"\"\n952\t\tif result.ClaimedBy != nil {\n953\t\t\tclaimedBy = *result.ClaimedBy\n954\t\t}\n955\t\treturn resp.StatusCode, result.Success, claimedBy\n956\t}\n957\t\n958\t// checkStatuses 调用 check API 返回 issue_number → status 的映射。\n959\tfunc checkStatuses(t *testing.T, env *testEnv, repo string, numbers []int) map[int]string {\n960\t\tt.Helper()\n961\t\n962\t\tnums := make([]string, len(numbers))\n963\t\tfor i, n := range numbers {\n964\t\t\tnums[i] = fmt.Sprintf(\"%d\", n)\n965\t\t}\n966\t\n967\t\tbody := `{\"repo_full_name\":\"` + repo + `\",\"issue_numbers\":[` + strings.Join(nums, \",\") + `]}`\n968\t\tresp := env.post(t, \"/api/issue/check\", body)\n969\t\n970\t\tvar result struct {\n971\t\t\tIssues []struct {\n972\t\t\t\tNumber int    `json:\"number\"`\n973\t\t\t\tStatus string `json:\"status\"`\n974\t\t\t} `json:\"issues\"`\n975\t\t}\n976\t\treadJSON(t, resp, &result)\n977\t\n978\t\tm := map[int]string{}\n979\t\tfor _, iss := range result.Issues {\n980\t\t\tm[iss.Number] = iss.Status\n981\t\t}\n982\t\treturn m\n983\t}\n984\t\n985\t// --- D3: Issue Status Update → ready-for-pr tests ---\n986\t// 验收标准：\n987\t//   - fixing → ready-for-pr 状态更新成功\n988\t//   - 非 owner 无法更新\n989\t//   - 完整流程：claimed → fixing → ready-for-pr\n990\t\n991\t// TestUpdateStatus_ReadyForPR 验证 fixing → ready-for-pr 状态流转。\n992\tfunc TestUpdateStatus_ReadyForPR(t *testing.T) {\n993\t\tt.Run(\"fixing_to_ready_for_pr\", func(t *testing.T) {\n994\t\t\t// D3 验收：fixing 状态可更新为 ready-for-pr\n995\t\t\tenv := setupTest(t)\n996\t\t\tdb := env.store.DB()\n997\t\t\tseedIssue(db, \"test/repo\", 10, \"fixing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n998\t\n999\t\t\tresp := env.post(t, \"/api/issue/status\",\n1000\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"ready-for-pr\"}`)\n1001\t\n1002\t\t\tvar result struct {\n1003\t\t\t\tSuccess        bool   `json:\"success\"`\n1004\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1005\t\t\t\tNewStatus      string `json:\"new_status\"`\n1006\t\t\t}\n1007\t\t\treadJSON(t, resp, &result)\n1008\t\n1009\t\t\tif resp.StatusCode != http.StatusOK {\n1010\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n1011\t\t\t}\n1012\t\t\tif !result.Success {\n1013\t\t\t\tt.Fatal(\"expected success=true\")\n1014\t\t\t}\n1015\t\t\tif result.PreviousStatus != \"fixing\" {\n1016\t\t\t\tt.Errorf(\"expected previous=fixing, got %s\", result.PreviousStatus)\n1017\t\t\t}\n1018\t\t\tif result.NewStatus != \"ready-for-pr\" {\n1019\t\t\t\tt.Errorf(\"expected new=ready-for-pr, got %s\", result.NewStatus)\n1020\t\t\t}\n1021\t\n1022\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n1023\t\t\tif statuses[10] != \"ready-for-pr\" {\n1024\t\t\t\tt.Errorf(\"expected ready-for-pr, got %s\", statuses[10])\n1025\t\t\t}\n1026\t\t})\n1027\t\n1028\t\tt.Run(\"non_owner_cannot_mark_ready\", func(t *testing.T) {\n1029\t\t\tenv := setupTest(t)\n1030\t\t\tdb := env.store.DB()\n1031\t\t\tseedIssue(db, \"test/repo\", 10, \"fixing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1032\t\n1033\t\t\tresp := env.post(t, \"/api/issue/status\",\n1034\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"ready-for-pr\"}`)\n1035\t\n1036\t\t\tvar result struct {\n1037\t\t\t\tSuccess bool   `json:\"success\"`\n1038\t\t\t\tError   string `json:\"error\"`\n1039\t\t\t}\n1040\t\t\treadJSON(t, resp, &result)\n1041\t\n1042\t\t\tif result.Success {\n1043\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1044\t\t\t}\n1045\t\t\tif result.Error != \"not_owner\" {\n1046\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1047\t\t\t}\n1048\t\t})\n1049\t\n1050\t\tt.Run(\"full_claim_fix_done_flow\", func(t *testing.T) {\n1051\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr\n1052\t\t\tenv := setupTest(t)\n1053\t\n1054\t\t\t// 1. idle\n1055\t\t\tenv.post(t, \"/api/issue/check\",\n1056\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[30]}`)\n1057\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{30})\n1058\t\t\tif s[30] != \"idle\" {\n1059\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[30])\n1060\t\t\t}\n1061\t\n1062\t\t\t// 2. claim\n1063\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 30, \"sess_done\")\n1064\t\t\tif code != http.StatusOK || !ok {\n1065\t\t\t\tt.Fatalf(\"step 2: claim failed\")\n1066\t\t\t}\n1067\t\n1068\t\t\t// 3. fixing\n1069\t\t\tenv.post(t, \"/api/issue/status\",\n1070\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":30,\"session_id\":\"sess_done\",\"status\":\"fixing\"}`)\n1071\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{30})\n1072\t\t\tif s[30] != \"fixing\" {\n1073\t\t\t\tt.Fatalf(\"step 3: expected fixing, got %s\", s[30])\n1074\t\t\t}\n1075\t\n1076\t\t\t// 4. ready-for-pr\n1077\t\t\tresp := env.post(t, \"/api/issue/status\",\n1078\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":30,\"session_id\":\"sess_done\",\"status\":\"ready-for-pr\"}`)\n1079\t\t\tvar result struct {\n1080\t\t\t\tSuccess        bool   `json:\"success\"`\n1081\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1082\t\t\t\tNewStatus      string `json:\"new_status\"`\n1083\t\t\t}\n1084\t\t\treadJSON(t, resp, &result)\n1085\t\t\tif !result.Success {\n1086\t\t\t\tt.Fatal(\"step 4: ready-for-pr update failed\")\n1087\t\t\t}\n1088\t\t\tif result.PreviousStatus != \"fixing\" {\n1089\t\t\t\tt.Errorf(\"step 4: expected previous=fixing, got %s\", result.PreviousStatus)\n1090\t\t\t}\n1091\t\n1092\t\t\t// 5. 验证最终状态\n1093\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{30})\n1094\t\t\tif s[30] != \"ready-for-pr\" {\n1095\t\t\t\tt.Fatalf(\"step 5: expected ready-for-pr, got %s\", s[30])\n1096\t\t\t}\n1097\t\t})\n1098\t}\n1099\t\n1100\t// --- D4: Issue Status Update → pr-created tests ---\n1101\t// 验收标准：\n1102\t//   - ready-for-pr → pr-created 状态更新成功\n1103\t//   - 非 owner 无法更新\n1104\t//   - 完整流程：claimed → fixing → ready-for-pr → pr-created\n1105\t\n1106\t// TestUpdateStatus_PRCreated 验证 ready-for-pr → pr-created 状态流转。\n1107\tfunc TestUpdateStatus_PRCreated(t *testing.T) {\n1108\t\tt.Run(\"ready_for_pr_to_pr_created\", func(t *testing.T) {\n1109\t\t\t// D4 验收：ready-for-pr 状态可更新为 pr-created\n1110\t\t\tenv := setupTest(t)\n1111\t\t\tdb := env.store.DB()\n1112\t\t\tseedIssue(db, \"test/repo\", 10, \"ready-for-pr\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1113\t\n1114\t\t\tresp := env.post(t, \"/api/issue/status\",\n1115\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"pr-created\"}`)\n1116\t\n1117\t\t\tvar result struct {\n1118\t\t\t\tSuccess        bool   `json:\"success\"`\n1119\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1120\t\t\t\tNewStatus      string `json:\"new_status\"`\n1121\t\t\t}\n1122\t\t\treadJSON(t, resp, &result)\n1123\t\n1124\t\t\tif resp.StatusCode != http.StatusOK {\n1125\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n1126\t\t\t}\n1127\t\t\tif !result.Success {\n1128\t\t\t\tt.Fatal(\"expected success=true\")\n1129\t\t\t}\n1130\t\t\tif result.PreviousStatus != \"ready-for-pr\" {\n1131\t\t\t\tt.Errorf(\"expected previous=ready-for-pr, got %s\", result.PreviousStatus)\n1132\t\t\t}\n1133\t\t\tif result.NewStatus != \"pr-created\" {\n1134\t\t\t\tt.Errorf(\"expected new=pr-created, got %s\", result.NewStatus)\n1135\t\t\t}\n1136\t\n1137\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n1138\t\t\tif statuses[10] != \"pr-created\" {\n1139\t\t\t\tt.Errorf(\"expected pr-created, got %s\", statuses[10])\n1140\t\t\t}\n1141\t\t})\n1142\t\n1143\t\tt.Run(\"non_owner_cannot_create_pr_status\", func(t *testing.T) {\n1144\t\t\tenv := setupTest(t)\n1145\t\t\tdb := env.store.DB()\n1146\t\t\tseedIssue(db, \"test/repo\", 10, \"ready-for-pr\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1147\t\n1148\t\t\tresp := env.post(t, \"/api/issue/status\",\n1149\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"pr-created\"}`)\n1150\t\n1151\t\t\tvar result struct {\n1152\t\t\t\tSuccess bool   `json:\"success\"`\n1153\t\t\t\tError   string `json:\"error\"`\n1154\t\t\t}\n1155\t\t\treadJSON(t, resp, &result)\n1156\t\n1157\t\t\tif result.Success {\n1158\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1159\t\t\t}\n1160\t\t\tif result.Error != \"not_owner\" {\n1161\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1162\t\t\t}\n1163\t\t})\n1164\t\n1165\t\tt.Run(\"full_claim_fix_done_pr_flow\", func(t *testing.T) {\n1166\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr → pr-created\n1167\t\t\tenv := setupTest(t)\n1168\t\n1169\t\t\t// 1. idle\n1170\t\t\tenv.post(t, \"/api/issue/check\",\n1171\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[40]}`)\n1172\t\n1173\t\t\t// 2. claim\n1174\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 40, \"sess_pr\")\n1175\t\t\tif code != http.StatusOK || !ok {\n1176\t\t\t\tt.Fatalf(\"step 2: claim failed\")\n1177\t\t\t}\n1178\t\n1179\t\t\t// 3. fixing\n1180\t\t\tenv.post(t, \"/api/issue/status\",\n1181\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":40,\"session_id\":\"sess_pr\",\"status\":\"fixing\"}`)\n1182\t\n1183\t\t\t// 4. ready-for-pr\n1184\t\t\tenv.post(t, \"/api/issue/status\",\n1185\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":40,\"session_id\":\"sess_pr\",\"status\":\"ready-for-pr\"}`)\n1186\t\n1187\t\t\t// 5. pr-created\n1188\t\t\tresp := env.post(t, \"/api/issue/status\",\n1189\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":40,\"session_id\":\"sess_pr\",\"status\":\"pr-created\"}`)\n1190\t\t\tvar result struct {\n1191\t\t\t\tSuccess        bool   `json:\"success\"`\n1192\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1193\t\t\t\tNewStatus      string `json:\"new_status\"`\n1194\t\t\t}\n1195\t\t\treadJSON(t, resp, &result)\n1196\t\t\tif !result.Success {\n1197\t\t\t\tt.Fatal(\"step 5: pr-created update failed\")\n1198\t\t\t}\n1199\t\t\tif result.PreviousStatus != \"ready-for-pr\" {\n1200\t\t\t\tt.Errorf(\"step 5: expected previous=ready-for-pr, got %s\", result.PreviousStatus)\n1201\t\t\t}\n1202\t\n1203\t\t\t// 6. 验证最终状态\n1204\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{40})\n1205\t\t\tif s[40] != \"pr-created\" {\n1206\t\t\t\tt.Fatalf(\"step 6: expected pr-created, got %s\", s[40])\n1207\t\t\t}\n1208\t\t})\n1209\t}\n1210\t\n1211\t// --- D5: Issue Status Update → testing tests ---\n1212\t// 验收标准：\n1213\t//   - pr-created → testing 状态更新成功\n1214\t//   - 非 owner 无法更新\n1215\t//   - 完整流程：claimed → fixing → ready-for-pr → pr-created → testing\n1216\t\n1217\t// TestUpdateStatus_Testing 验证 pr-created → testing 状态流转。\n1218\tfunc TestUpdateStatus_Testing(t *testing.T) {\n1219\t\tt.Run(\"pr_created_to_testing\", func(t *testing.T) {\n1220\t\t\tenv := setupTest(t)\n1221\t\t\tdb := env.store.DB()\n1222\t\t\tseedIssue(db, \"test/repo\", 10, \"pr-created\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1223\t\n1224\t\t\tresp := env.post(t, \"/api/issue/status\",\n1225\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"testing\"}`)\n1226\t\n1227\t\t\tvar result struct {\n1228\t\t\t\tSuccess        bool   `json:\"success\"`\n1229\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1230\t\t\t\tNewStatus      string `json:\"new_status\"`\n1231\t\t\t}\n1232\t\t\treadJSON(t, resp, &result)\n1233\t\n1234\t\t\tif resp.StatusCode != http.StatusOK {\n1235\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n1236\t\t\t}\n1237\t\t\tif !result.Success {\n1238\t\t\t\tt.Fatal(\"expected success=true\")\n1239\t\t\t}\n1240\t\t\tif result.PreviousStatus != \"pr-created\" {\n1241\t\t\t\tt.Errorf(\"expected previous=pr-created, got %s\", result.PreviousStatus)\n1242\t\t\t}\n1243\t\t\tif result.NewStatus != \"testing\" {\n1244\t\t\t\tt.Errorf(\"expected new=testing, got %s\", result.NewStatus)\n1245\t\t\t}\n1246\t\n1247\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n1248\t\t\tif statuses[10] != \"testing\" {\n1249\t\t\t\tt.Errorf(\"expected testing, got %s\", statuses[10])\n1250\t\t\t}\n1251\t\t})\n1252\t\n1253\t\tt.Run(\"non_owner_cannot_mark_testing\", func(t *testing.T) {\n1254\t\t\tenv := setupTest(t)\n1255\t\t\tdb := env.store.DB()\n1256\t\t\tseedIssue(db, \"test/repo\", 10, \"pr-created\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1257\t\n1258\t\t\tresp := env.post(t, \"/api/issue/status\",\n1259\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"testing\"}`)\n1260\t\n1261\t\t\tvar result struct {\n1262\t\t\t\tSuccess bool   `json:\"success\"`\n1263\t\t\t\tError   string `json:\"error\"`\n1264\t\t\t}\n1265\t\t\treadJSON(t, resp, &result)\n1266\t\n1267\t\t\tif result.Success {\n1268\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1269\t\t\t}\n1270\t\t\tif result.Error != \"not_owner\" {\n1271\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1272\t\t\t}\n1273\t\t})\n1274\t\n1275\t\tt.Run(\"full_flow_to_testing\", func(t *testing.T) {\n1276\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr → pr-created → testing\n1277\t\t\tenv := setupTest(t)\n1278\t\n1279\t\t\tenv.post(t, \"/api/issue/check\",\n1280\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[50]}`)\n1281\t\n1282\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 50, \"sess_test\")\n1283\t\t\tif code != http.StatusOK || !ok {\n1284\t\t\t\tt.Fatalf(\"claim failed\")\n1285\t\t\t}\n1286\t\n1287\t\t\tenv.post(t, \"/api/issue/status\",\n1288\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"fixing\"}`)\n1289\t\t\tenv.post(t, \"/api/issue/status\",\n1290\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"ready-for-pr\"}`)\n1291\t\t\tenv.post(t, \"/api/issue/status\",\n1292\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"pr-created\"}`)\n1293\t\n1294\t\t\tresp := env.post(t, \"/api/issue/status\",\n1295\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"testing\"}`)\n1296\t\t\tvar result struct {\n1297\t\t\t\tSuccess        bool   `json:\"success\"`\n1298\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1299\t\t\t\tNewStatus      string `json:\"new_status\"`\n1300\t\t\t}\n1301\t\t\treadJSON(t, resp, &result)\n1302\t\t\tif !result.Success {\n1303\t\t\t\tt.Fatal(\"testing update failed\")\n1304\t\t\t}\n1305\t\t\tif result.PreviousStatus != \"pr-created\" {\n1306\t\t\t\tt.Errorf(\"expected previous=pr-created, got %s\", result.PreviousStatus)\n1307\t\t\t}\n1308\t\n1309\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{50})\n1310\t\t\tif s[50] != \"testing\" {\n1311\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[50])\n1312\t\t\t}\n1313\t\t})\n1314\t}\n1315\t\n1316\t// --- D6: Issue Status Update → reviewing/merged/rejected tests ---\n1317\t// 验收标准：\n1318\t//   - testing → reviewing 状态更新成功\n1319\t//   - reviewing → merged 终态更新成功\n1320\t//   - reviewing → rejected 状态更新成功\n1321\t//   - merged 不被 session end 释放\n1322\t//   - rejected 不被 session end 释放\n1323\t//   - 完整流程：idle → ... → testing → reviewing → merged/rejected\n1324\t\n1325\t// TestUpdateStatus_Review 验证 testing → reviewing → merged/rejected 状态流转。\n1326\tfunc TestUpdateStatus_Review(t *testing.T) {\n1327\t\tt.Run(\"testing_to_reviewing\", func(t *testing.T) {\n1328\t\t\tenv := setupTest(t)\n1329\t\t\tdb := env.store.DB()\n1330\t\t\tseedIssue(db, \"test/repo\", 10, \"testing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1331\t\n1332\t\t\tresp := env.post(t, \"/api/issue/status\",\n1333\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"reviewing\"}`)\n1334\t\n1335\t\t\tvar result struct {\n1336\t\t\t\tSuccess        bool   `json:\"success\"`\n1337\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1338\t\t\t\tNewStatus      string `json:\"new_status\"`\n1339\t\t\t}\n1340\t\t\treadJSON(t, resp, &result)\n1341\t\n1342\t\t\tif !result.Success {\n1343\t\t\t\tt.Fatalf(\"expected success=true, got error: %s\", result.NewStatus)\n1344\t\t\t}\n1345\t\t\tif result.PreviousStatus != \"testing\" {\n1346\t\t\t\tt.Errorf(\"expected previous=testing, got %s\", result.PreviousStatus)\n1347\t\t\t}\n1348\t\t\tif result.NewStatus != \"reviewing\" {\n1349\t\t\t\tt.Errorf(\"expected new=reviewing, got %s\", result.NewStatus)\n1350\t\t\t}\n1351\t\t})\n1352\t\n1353\t\tt.Run(\"reviewing_to_merged\", func(t *testing.T) {\n1354\t\t\tenv := setupTest(t)\n1355\t\t\tdb := env.store.DB()\n1356\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1357\t\n1358\t\t\tresp := env.post(t, \"/api/issue/status\",\n1359\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"merged\"}`)\n1360\t\n1361\t\t\tvar result struct {\n1362\t\t\t\tSuccess        bool   `json:\"success\"`\n1363\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1364\t\t\t\tNewStatus      string `json:\"new_status\"`\n1365\t\t\t}\n1366\t\t\treadJSON(t, resp, &result)\n1367\t\n1368\t\t\tif !result.Success {\n1369\t\t\t\tt.Fatal(\"expected success=true\")\n1370\t\t\t}\n1371\t\t\tif result.PreviousStatus != \"reviewing\" {\n1372\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1373\t\t\t}\n1374\t\t\tif result.NewStatus != \"merged\" {\n1375\t\t\t\tt.Errorf(\"expected new=merged, got %s\", result.NewStatus)\n1376\t\t\t}\n1377\t\t})\n1378\t\n1379\t\tt.Run(\"reviewing_to_rejected\", func(t *testing.T) {\n1380\t\t\tenv := setupTest(t)\n1381\t\t\tdb := env.store.DB()\n1382\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1383\t\n1384\t\t\tresp := env.post(t, \"/api/issue/status\",\n1385\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"rejected\"}`)\n1386\t\n1387\t\t\tvar result struct {\n1388\t\t\t\tSuccess        bool   `json:\"success\"`\n1389\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1390\t\t\t\tNewStatus      string `json:\"new_status\"`\n1391\t\t\t}\n1392\t\t\treadJSON(t, resp, &result)\n1393\t\n1394\t\t\tif !result.Success {\n1395\t\t\t\tt.Fatal(\"expected success=true\")\n1396\t\t\t}\n1397\t\t\tif result.PreviousStatus != \"reviewing\" {\n1398\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1399\t\t\t}\n1400\t\t\tif result.NewStatus != \"rejected\" {\n1401\t\t\t\tt.Errorf(\"expected new=rejected, got %s\", result.NewStatus)\n1402\t\t\t}\n1403\t\t})\n1404\t\n1405\t\tt.Run(\"non_owner_cannot_review\", func(t *testing.T) {\n1406\t\t\tenv := setupTest(t)\n1407\t\t\tdb := env.store.DB()\n1408\t\t\tseedIssue(db, \"test/repo\", 10, \"testing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1409\t\n1410\t\t\tresp := env.post(t, \"/api/issue/status\",\n1411\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"reviewing\"}`)\n1412\t\n1413\t\t\tvar result struct {\n1414\t\t\t\tSuccess bool   `json:\"success\"`\n1415\t\t\t\tError   string `json:\"error\"`\n1416\t\t\t}\n1417\t\t\treadJSON(t, resp, &result)\n1418\t\n1419\t\t\tif result.Success {\n1420\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1421\t\t\t}\n1422\t\t\tif result.Error != \"not_owner\" {\n1423\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1424\t\t\t}\n1425\t\t})\n1426\t\n1427\t\tt.Run(\"full_merge_flow\", func(t *testing.T) {\n1428\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr → pr-created → testing → reviewing → merged\n1429\t\t\tenv := setupTest(t)\n1430\t\n1431\t\t\tenv.post(t, \"/api/issue/check\",\n1432\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[60]}`)\n1433\t\n1434\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 60, \"sess_merge\")\n1435\t\t\tif code != http.StatusOK || !ok {\n1436\t\t\t\tt.Fatalf(\"claim failed\")\n1437\t\t\t}\n1438\t\n1439\t\t\tfor _, status := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n1440\t\t\t\tresp := env.post(t, \"/api/issue/status\",\n1441\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"test/repo\",\"issue_number\":60,\"session_id\":\"sess_merge\",\"status\":\"%s\"}`, status))\n1442\t\t\t\tvar r struct{ Success bool `json:\"success\"` }\n1443\t\t\t\treadJSON(t, resp, &r)\n1444\t\t\t\tif !r.Success {\n1445\t\t\t\t\tt.Fatalf(\"update to %s failed\", status)\n1446\t\t\t\t}\n1447\t\t\t}\n1448\t\n1449\t\t\t// merged\n1450\t\t\tresp := env.post(t, \"/api/issue/status\",\n1451\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":60,\"session_id\":\"sess_merge\",\"status\":\"merged\"}`)\n1452\t\t\tvar result struct {\n1453\t\t\t\tSuccess        bool   `json:\"success\"`\n1454\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1455\t\t\t\tNewStatus      string `json:\"new_status\"`\n1456\t\t\t}\n1457\t\t\treadJSON(t, resp, &result)\n1458\t\t\tif !result.Success {\n1459\t\t\t\tt.Fatal(\"merged update failed\")\n1460\t\t\t}\n1461\t\t\tif result.PreviousStatus != \"reviewing\" {\n1462\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1463\t\t\t}\n1464\t\n1465\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{60})\n1466\t\t\tif s[60] != \"merged\" {\n1467\t\t\t\tt.Fatalf(\"expected merged, got %s\", s[60])\n1468\t\t\t}\n1469\t\t})\n1470\t\n1471\t\tt.Run(\"full_reject_flow\", func(t *testing.T) {\n1472\t\t\t// 端到端：idle → ... → testing → reviewing → rejected\n1473\t\t\tenv := setupTest(t)\n1474\t\n1475\t\t\tenv.post(t, \"/api/issue/check\",\n1476\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[70]}`)\n1477\t\n1478\t\t\tclaimIssue(t, env, \"test/repo\", 70, \"sess_reject\")\n1479\t\t\tfor _, status := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n1480\t\t\t\tenv.post(t, \"/api/issue/status\",\n1481\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"test/repo\",\"issue_number\":70,\"session_id\":\"sess_reject\",\"status\":\"%s\"}`, status))\n1482\t\t\t}\n1483\t\n1484\t\t\tresp := env.post(t, \"/api/issue/status\",\n1485\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":70,\"session_id\":\"sess_reject\",\"status\":\"rejected\"}`)\n1486\t\t\tvar result struct {\n1487\t\t\t\tSuccess        bool   `json:\"success\"`\n1488\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1489\t\t\t\tNewStatus      string `json:\"new_status\"`\n1490\t\t\t}\n1491\t\t\treadJSON(t, resp, &result)\n1492\t\t\tif !result.Success {\n1493\t\t\t\tt.Fatal(\"rejected update failed\")\n1494\t\t\t}\n1495\t\t\tif result.PreviousStatus != \"reviewing\" {\n1496\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1497\t\t\t}\n1498\t\n1499\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{70})\n1500\t\t\tif s[70] != \"rejected\" {\n1501\t\t\t\tt.Fatalf(\"expected rejected, got %s\", s[70])\n1502\t\t\t}\n1503\t\t})\n1504\t}\n1505\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\tests\\integration\\backend_skill_flow_test.go"},"tool_use_id":"call_d9c37e19834c4aa7aafcb5a5","tool_response":"1\t// Package integration_test 包含后端技能流程的集成测试。\n2\t// 模拟各个技能（issue-claim、issue-fix、issue-done、issue-pr、issue-test、issue-review）调用后端的完整流程。\n3\tpackage integration_test\n4\t\n5\timport (\n6\t\t\"database/sql\"\n7\t\t\"encoding/json\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"net/http\"\n11\t\t\"net/http/httptest\"\n12\t\t\"os\"\n13\t\t\"strings\"\n14\t\t\"testing\"\n15\t\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n19\t)\n20\t\n21\t// --- helpers ---\n22\t\n23\t// env 是集成测试环境，包含测试服务器和 SQLite 存储。\n24\ttype env struct {\n25\t\tsrv   *httptest.Server\n26\t\tstore *store.SQLiteStore\n27\t}\n28\t\n29\t// setup 创建集成测试环境，自动清理临时数据库。\n30\tfunc setup(t *testing.T) *env {\n31\t\tt.Helper()\n32\t\n33\t\tf, err := os.CreateTemp(\"\", \"test-sessionend-*.db\")\n34\t\tif err != nil {\n35\t\t\tt.Fatal(err)\n36\t\t}\n37\t\tdbPath := f.Name()\n38\t\tf.Close()\n39\t\n40\t\ts, err := store.NewSQLiteStore(dbPath)\n41\t\tif err != nil {\n42\t\t\tos.Remove(dbPath)\n43\t\t\tt.Fatal(err)\n44\t\t}\n45\t\tt.Cleanup(func() {\n46\t\t\ts.Close()\n47\t\t\tos.Remove(dbPath)\n48\t\t})\n49\t\n50\t\tissueSvc := service.NewIssueService(s.Issues())\n51\t\trouter := api.NewRouter(api.Handlers{\n52\t\t\tIssue: api.NewIssueHandler(issueSvc),\n53\t\t})\n54\t\n55\t\tsrv := httptest.NewServer(router)\n56\t\tt.Cleanup(srv.Close)\n57\t\n58\t\treturn &env{srv: srv, store: s}\n59\t}\n60\t\n61\t// post 发送 POST 请求到集成测试环境。\n62\tfunc (e *env) post(t *testing.T, path, body string) *http.Response {\n63\t\tt.Helper()\n64\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n65\t\tif err != nil {\n66\t\t\tt.Fatal(err)\n67\t\t}\n68\t\treturn resp\n69\t}\n70\t\n71\t// readJSON 读取 HTTP 响应并解析为 JSON。\n72\tfunc readJSON(t *testing.T, resp *http.Response, v any) {\n73\t\tt.Helper()\n74\t\tdefer resp.Body.Close()\n75\t\tb, err := io.ReadAll(resp.Body)\n76\t\tif err != nil {\n77\t\t\tt.Fatal(err)\n78\t\t}\n79\t\tif err := json.Unmarshal(b, v); err != nil {\n80\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n81\t\t}\n82\t}\n83\t\n84\t// seedIssue 在数据库中预置一条 issue 记录。\n85\tfunc seedIssue(db *sql.DB, repo string, number int, status, sessionID, claimedAt string) {\n86\t\tdb.Exec(\n87\t\t\t`INSERT INTO issue_claims (repo_full_name, issue_number, status, session_id, claimed_at, updated_at)\n88\t\t\t VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)`,\n89\t\t\trepo, number, status,\n90\t\t\tnilIfEmpty(sessionID), nilIfEmpty(claimedAt),\n91\t\t)\n92\t}\n93\t\n94\t// claimIssue 调用 claim API 并返回 (statusCode, success, claimed_by)。\n95\tfunc claimIssue(t *testing.T, e *env, repo string, number int, sessionID string) (int, bool, string) {\n96\t\tt.Helper()\n97\t\n98\t\tbody := fmt.Sprintf(\n99\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n100\t\t\trepo, number, sessionID)\n101\t\tresp := e.post(t, \"/api/issue/claim\", body)\n102\t\n103\t\tvar result struct {\n104\t\t\tSuccess   bool    `json:\"success\"`\n105\t\t\tError     string  `json:\"error\"`\n106\t\t\tClaimedBy *string `json:\"claimed_by\"`\n107\t\t\tStatus    string  `json:\"status\"`\n108\t\t}\n109\t\treadJSON(t, resp, &result)\n110\t\n111\t\tclaimedBy := \"\"\n112\t\tif result.ClaimedBy != nil {\n113\t\t\tclaimedBy = *result.ClaimedBy\n114\t\t}\n115\t\treturn resp.StatusCode, result.Success, claimedBy\n116\t}\n117\t\n118\t// nilIfEmpty 将空字符串转为 nil，用于数据库插入。\n119\tfunc nilIfEmpty(s string) any {\n120\t\tif s == \"\" {\n121\t\t\treturn nil\n122\t\t}\n123\t\treturn s\n124\t}\n125\t\n126\t// checkStatuses 调用 check API 并返回 issue_number → status 的映射。\n127\tfunc checkStatuses(t *testing.T, e *env, repo string, numbers []int) map[int]string {\n128\t\tt.Helper()\n129\t\n130\t\tnums := make([]string, len(numbers))\n131\t\tfor i, n := range numbers {\n132\t\t\tnums[i] = fmt.Sprintf(\"%d\", n)\n133\t\t}\n134\t\n135\t\tbody := `{\"repo_full_name\":\"` + repo + `\",\"issue_numbers\":[` + strings.Join(nums, \",\") + `]}`\n136\t\tresp := e.post(t, \"/api/issue/check\", body)\n137\t\n138\t\tvar result struct {\n139\t\t\tIssues []struct {\n140\t\t\t\tNumber int    `json:\"number\"`\n141\t\t\t\tStatus string `json:\"status\"`\n142\t\t\t} `json:\"issues\"`\n143\t\t}\n144\t\treadJSON(t, resp, &result)\n145\t\n146\t\tm := map[int]string{}\n147\t\tfor _, iss := range result.Issues {\n148\t\t\tm[iss.Number] = iss.Status\n149\t\t}\n150\t\treturn m\n151\t}\n152\t\n153\t// --- B6-3 SessionEnd Hook 集成测试 ---\n154\t// 模拟 SessionEnd hook 调用 release-session API 的完整流程\n155\t// 验收标准：\n156\t//   - session 正常结束时，领取的 issue 被自动释放\n157\t//   - 已合并/打回的 issue 不被释放\n158\t//   - 无领取记录的 session 不报错\n159\t\n160\t// TestSessionEndHook 验证 SessionEnd hook 调用 release-session 的完整流程。\n161\tfunc TestSessionEndHook(t *testing.T) {\n162\t\tt.Run(\"session_end_releases_claimed_issues\", func(t *testing.T) {\n163\t\t\t// 验收：session 正常结束时，领取的 issue 被自动释放\n164\t\t\t// 模拟场景：sess_test 领取了 #10(claimed) 和 #11(fixing)\n165\t\t\t// SessionEnd hook 调用 release-session → #10/#11 回到 idle\n166\t\t\te := setup(t)\n167\t\t\tdb := e.store.DB()\n168\t\n169\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n170\t\t\tseedIssue(db, \"test/repo\", 11, \"fixing\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n171\t\n172\t\t\t// 模拟 hook 调用 release-session\n173\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n174\t\t\t\t`{\"session_id\":\"sess_test\"}`)\n175\t\n176\t\t\tvar result struct {\n177\t\t\t\tReleased []int `json:\"released\"`\n178\t\t\t\tCount    int   `json:\"count\"`\n179\t\t\t}\n180\t\t\treadJSON(t, resp, &result)\n181\t\n182\t\t\tif result.Count != 2 {\n183\t\t\t\tt.Fatalf(\"expected 2 released, got %d\", result.Count)\n184\t\t\t}\n185\t\n186\t\t\t// 验证两个 issue 都回到了 idle\n187\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10, 11})\n188\t\t\tif statuses[10] != \"idle\" {\n189\t\t\t\tt.Errorf(\"expected #10 idle, got %s\", statuses[10])\n190\t\t\t}\n191\t\t\tif statuses[11] != \"idle\" {\n192\t\t\t\tt.Errorf(\"expected #11 idle, got %s\", statuses[11])\n193\t\t\t}\n194\t\t})\n195\t\n196\t\tt.Run(\"merged_and_rejected_not_released\", func(t *testing.T) {\n197\t\t\t// 验收：已合并/打回的 issue 不被释放\n198\t\t\t// 模拟场景：sess_test 有 #10(claimed) #11(merged) #12(rejected)\n199\t\t\t// SessionEnd → 只有 #10 被释放，#11/#12 不变\n200\t\t\te := setup(t)\n201\t\t\tdb := e.store.DB()\n202\t\n203\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n204\t\t\tseedIssue(db, \"test/repo\", 11, \"merged\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n205\t\t\tseedIssue(db, \"test/repo\", 12, \"rejected\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n206\t\n207\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n208\t\t\t\t`{\"session_id\":\"sess_test\"}`)\n209\t\n210\t\t\tvar result struct {\n211\t\t\t\tReleased []int `json:\"released\"`\n212\t\t\t\tCount    int   `json:\"count\"`\n213\t\t\t}\n214\t\t\treadJSON(t, resp, &result)\n215\t\n216\t\t\tif result.Count != 1 {\n217\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n218\t\t\t}\n219\t\t\tif len(result.Released) != 1 || result.Released[0] != 10 {\n220\t\t\t\tt.Fatalf(\"expected [10], got %v\", result.Released)\n221\t\t\t}\n222\t\n223\t\t\t// 验证终态不变\n224\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10, 11, 12})\n225\t\t\tif statuses[10] != \"idle\" {\n226\t\t\t\tt.Errorf(\"expected #10 idle after release, got %s\", statuses[10])\n227\t\t\t}\n228\t\t\tif statuses[11] != \"merged\" {\n229\t\t\t\tt.Errorf(\"expected #11 still merged, got %s\", statuses[11])\n230\t\t\t}\n231\t\t\tif statuses[12] != \"rejected\" {\n232\t\t\t\tt.Errorf(\"expected #12 still rejected, got %s\", statuses[12])\n233\t\t\t}\n234\t\t})\n235\t\n236\t\tt.Run(\"no_claims_returns_empty_no_error\", func(t *testing.T) {\n237\t\t\t// 验收：无领取记录的 session 不报错\n238\t\t\t// 模拟场景：sess_empty 没有领取任何 issue\n239\t\t\t// SessionEnd → released=[], count=0，无报错\n240\t\t\te := setup(t)\n241\t\n242\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n243\t\t\t\t`{\"session_id\":\"sess_empty\"}`)\n244\t\n245\t\t\tvar result struct {\n246\t\t\t\tReleased []int `json:\"released\"`\n247\t\t\t\tCount    int   `json:\"count\"`\n248\t\t\t}\n249\t\t\treadJSON(t, resp, &result)\n250\t\n251\t\t\tif resp.StatusCode != http.StatusOK {\n252\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n253\t\t\t}\n254\t\t\tif result.Count != 0 {\n255\t\t\t\tt.Errorf(\"expected 0, got %d\", result.Count)\n256\t\t\t}\n257\t\t\tif len(result.Released) != 0 {\n258\t\t\t\tt.Errorf(\"expected empty, got %v\", result.Released)\n259\t\t\t}\n260\t\t})\n261\t\n262\t\tt.Run(\"only_releases_target_session\", func(t *testing.T) {\n263\t\t\t// 补充：只释放目标 session 的 issue，其他 session 的 issue 不受影响\n264\t\t\t// 模拟场景：sess_a 领取 #10, sess_b 领取 #11, #12(merged)属于 sess_a\n265\t\t\t// SessionEnd(sess_a) → 释放 #10，#11(属于sess_b)和 #12(merged)不变\n266\t\t\te := setup(t)\n267\t\t\tdb := e.store.DB()\n268\t\n269\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n270\t\t\tseedIssue(db, \"test/repo\", 11, \"claimed\", \"sess_b\", \"2026-05-26T10:00:00Z\")\n271\t\t\tseedIssue(db, \"test/repo\", 12, \"merged\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n272\t\n273\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n274\t\t\t\t`{\"session_id\":\"sess_a\"}`)\n275\t\n276\t\t\tvar result struct {\n277\t\t\t\tReleased []int `json:\"released\"`\n278\t\t\t\tCount    int   `json:\"count\"`\n279\t\t\t}\n280\t\t\treadJSON(t, resp, &result)\n281\t\n282\t\t\tif result.Count != 1 {\n283\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n284\t\t\t}\n285\t\t\tif len(result.Released) != 1 || result.Released[0] != 10 {\n286\t\t\t\tt.Fatalf(\"expected [10], got %v\", result.Released)\n287\t\t\t}\n288\t\n289\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10, 11, 12})\n290\t\t\tif statuses[10] != \"idle\" {\n291\t\t\t\tt.Errorf(\"expected #10 idle, got %s\", statuses[10])\n292\t\t\t}\n293\t\t\tif statuses[11] != \"claimed\" {\n294\t\t\t\tt.Errorf(\"expected #11 still claimed (sess_b), got %s\", statuses[11])\n295\t\t\t}\n296\t\t\tif statuses[12] != \"merged\" {\n297\t\t\t\tt.Errorf(\"expected #12 still merged, got %s\", statuses[12])\n298\t\t\t}\n299\t\t})\n300\t\n301\t\tt.Run(\"full_flow_claim_then_session_end\", func(t *testing.T) {\n302\t\t\t// 端到端流程：先 check（自动创建 idle）→ 模拟 claim → SessionEnd 释放\n303\t\t\t// 模拟完整生命周期：idle → claimed → SessionEnd → idle\n304\t\t\te := setup(t)\n305\t\n306\t\t\t// 1. check 创建 idle 记录\n307\t\t\te.post(t, \"/api/issue/check\",\n308\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[20]}`)\n309\t\n310\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{20})\n311\t\t\tif statuses[20] != \"idle\" {\n312\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", statuses[20])\n313\t\t\t}\n314\t\n315\t\t\t// 2. 模拟 claim（直接 SQL，claim API 后续实现）\n316\t\t\te.store.DB().Exec(\n317\t\t\t\t`UPDATE issue_claims SET status='claimed', session_id='sess_e2e', claimed_at=CURRENT_TIMESTAMP\n318\t\t\t\t WHERE repo_full_name='test/repo' AND issue_number=20`)\n319\t\n320\t\t\tstatuses = checkStatuses(t, e, \"test/repo\", []int{20})\n321\t\t\tif statuses[20] != \"claimed\" {\n322\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", statuses[20])\n323\t\t\t}\n324\t\n325\t\t\t// 3. SessionEnd 触发释放\n326\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n327\t\t\t\t`{\"session_id\":\"sess_e2e\"}`)\n328\t\n329\t\t\tvar result struct {\n330\t\t\t\tCount int `json:\"count\"`\n331\t\t\t}\n332\t\t\treadJSON(t, resp, &result)\n333\t\t\tif result.Count != 1 {\n334\t\t\t\tt.Fatalf(\"step 3: expected 1 released, got %d\", result.Count)\n335\t\t\t}\n336\t\n337\t\t\t// 4. 验证回到 idle\n338\t\t\tstatuses = checkStatuses(t, e, \"test/repo\", []int{20})\n339\t\t\tif statuses[20] != \"idle\" {\n340\t\t\t\tt.Fatalf(\"step 4: expected idle after release, got %s\", statuses[20])\n341\t\t\t}\n342\t\t})\n343\t}\n344\t\n345\t// --- B3: Claim API 集成测试 ---\n346\t// 验收标准：\n347\t//   - 空闲 issue 可被成功领取\n348\t//   - 已被其他 session 领取的 issue 返回 already_claimed\n349\t//   - 同一 session 重复领取同一 issue 返回成功（幂等）\n350\t//   - 已合并/打回的 issue 不可领取\n351\t//   - 首次出现的 issue 自动创建记录后领取\n352\t//   - 并发领取时只有一个成功（原子性）\n353\t\n354\t// TestClaimAPI 验证 Issue 领取 API。\n355\tfunc TestClaimAPI(t *testing.T) {\n356\t\tt.Run(\"claim_idle_issue_success\", func(t *testing.T) {\n357\t\t\t// 验收：空闲 issue 可被成功领取\n358\t\t\te := setup(t)\n359\t\t\tdb := e.store.DB()\n360\t\n361\t\t\tseedIssue(db, \"test/repo\", 10, \"idle\", \"\", \"\")\n362\t\n363\t\t\tcode, success, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_a\")\n364\t\t\tif code != http.StatusOK {\n365\t\t\t\tt.Fatalf(\"expected 200, got %d\", code)\n366\t\t\t}\n367\t\t\tif !success {\n368\t\t\t\tt.Fatal(\"expected success=true\")\n369\t\t\t}\n370\t\n371\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10})\n372\t\t\tif statuses[10] != \"claimed\" {\n373\t\t\t\tt.Errorf(\"expected claimed, got %s\", statuses[10])\n374\t\t\t}\n375\t\t})\n376\t\n377\t\tt.Run(\"claim_already_claimed_by_other\", func(t *testing.T) {\n378\t\t\t// 验收：已被其他 session 领取的 issue 返回 already_claimed\n379\t\t\te := setup(t)\n380\t\t\tdb := e.store.DB()\n381\t\n382\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n383\t\n384\t\t\tcode, success, claimedBy := claimIssue(t, e, \"test/repo\", 10, \"sess_b\")\n385\t\t\tif code != http.StatusConflict {\n386\t\t\t\tt.Fatalf(\"expected 409, got %d\", code)\n387\t\t\t}\n388\t\t\tif success {\n389\t\t\t\tt.Fatal(\"expected success=false\")\n390\t\t\t}\n391\t\t\tif claimedBy != \"sess_a\" {\n392\t\t\t\tt.Errorf(\"expected claimed_by=sess_a, got %s\", claimedBy)\n393\t\t\t}\n394\t\t})\n395\t\n396\t\tt.Run(\"claim_idempotent_same_session\", func(t *testing.T) {\n397\t\t\t// 验收：同一 session 重复领取同一 issue 返回成功（幂等）\n398\t\t\te := setup(t)\n399\t\t\tdb := e.store.DB()\n400\t\n401\t\t\tseedIssue(db, \"test/repo\", 10, \"idle\", \"\", \"\")\n402\t\n403\t\t\tcode1, ok1, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_a\")\n404\t\t\tif code1 != http.StatusOK || !ok1 {\n405\t\t\t\tt.Fatalf(\"first claim should succeed: code=%d ok=%v\", code1, ok1)\n406\t\t\t}\n407\t\n408\t\t\tcode2, ok2, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_a\")\n409\t\t\tif code2 != http.StatusOK || !ok2 {\n410\t\t\t\tt.Fatalf(\"idempotent claim should succeed: code=%d ok=%v\", code2, ok2)\n411\t\t\t}\n412\t\t})\n413\t\n414\t\tt.Run(\"claim_merged_rejected_blocked\", func(t *testing.T) {\n415\t\t\t// 验收：已合并/打回的 issue 不可领取\n416\t\t\te := setup(t)\n417\t\t\tdb := e.store.DB()\n418\t\n419\t\t\tseedIssue(db, \"test/repo\", 10, \"merged\", \"sess_old\", \"2026-05-26T10:00:00Z\")\n420\t\t\tseedIssue(db, \"test/repo\", 11, \"rejected\", \"sess_old\", \"2026-05-26T10:00:00Z\")\n421\t\n422\t\t\tcode10, ok10, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_new\")\n423\t\t\tif code10 != http.StatusConflict || ok10 {\n424\t\t\t\tt.Errorf(\"merged issue should not be claimable: code=%d ok=%v\", code10, ok10)\n425\t\t\t}\n426\t\n427\t\t\tcode11, ok11, _ := claimIssue(t, e, \"test/repo\", 11, \"sess_new\")\n428\t\t\tif code11 != http.StatusConflict || ok11 {\n429\t\t\t\tt.Errorf(\"rejected issue should not be claimable: code=%d ok=%v\", code11, ok11)\n430\t\t\t}\n431\t\t})\n432\t\n433\t\tt.Run(\"claim_new_issue_auto_create\", func(t *testing.T) {\n434\t\t\t// 验收：首次出现的 issue 自动创建记录后领取\n435\t\t\te := setup(t)\n436\t\n437\t\t\tcode, success, _ := claimIssue(t, e, \"test/repo\", 99, \"sess_new\")\n438\t\t\tif code != http.StatusOK || !success {\n439\t\t\t\tt.Fatalf(\"first-time claim should succeed: code=%d ok=%v\", code, success)\n440\t\t\t}\n441\t\n442\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{99})\n443\t\t\tif statuses[99] != \"claimed\" {\n444\t\t\t\tt.Errorf(\"expected claimed, got %s\", statuses[99])\n445\t\t\t}\n446\t\t})\n447\t\n448\t\tt.Run(\"claim_missing_params_returns_error\", func(t *testing.T) {\n449\t\t\t// 补充：缺少必填参数时返回 400\n450\t\t\te := setup(t)\n451\t\n452\t\t\tresp := e.post(t, \"/api/issue/claim\", `{\"repo_full_name\":\"test/repo\",\"issue_number\":10}`)\n453\t\t\tif resp.StatusCode != http.StatusBadRequest {\n454\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n455\t\t\t}\n456\t\t})\n457\t\n458\t\tt.Run(\"claim_after_release_succeeds\", func(t *testing.T) {\n459\t\t\t// 补充：issue 被释放后可被重新领取\n460\t\t\te := setup(t)\n461\t\t\tdb := e.store.DB()\n462\t\n463\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n464\t\n465\t\t\t// 释放\n466\t\t\te.post(t, \"/api/issue/release\",\n467\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_a\"}`)\n468\t\n469\t\t\t// 新 session 领取\n470\t\t\tcode, success, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_b\")\n471\t\t\tif code != http.StatusOK || !success {\n472\t\t\t\tt.Fatalf(\"claim after release should succeed: code=%d ok=%v\", code, success)\n473\t\t\t}\n474\t\t})\n475\t}\n476\t\n477\t// --- D2: 001-5-issue-fix 技能集成测试 ---\n478\t// 模拟 001-5-issue-fix 技能调用后端的完整流程\n479\t// 验收标准：\n480\t//   - claim 后调 status API 可将状态更新为 fixing\n481\t//   - 非 owner session 无法标记 fixing\n482\t//   - 后端不可用时 skill 脚本静默降级（此处验证 API 层行为）\n483\t//   - fixing 状态的 issue 可被 session end 正常释放\n484\t//   - 完整技能流程：claim → fixing → session end 释放\n485\t\n486\t// TestIssueFixFlow 验证 issue-fix 技能的完整流程。\n487\tfunc TestIssueFixFlow(t *testing.T) {\n488\t\tt.Run(\"claim_then_fixing\", func(t *testing.T) {\n489\t\t\t// D2 核心验收：claim → fixing 状态流转\n490\t\t\t// 模拟 /001-4-issue-claim 后，/001-5-issue-fix 标记 fixing\n491\t\t\te := setup(t)\n492\t\n493\t\t\t// 1. check 创建 idle\n494\t\t\te.post(t, \"/api/issue/check\",\n495\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[10]}`)\n496\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n497\t\t\tif s[10] != \"idle\" {\n498\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[10])\n499\t\t\t}\n500\t\n501\t\t\t// 2. claim（模拟 001-4-issue-claim）\n502\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 10, \"sess_fix_001\")\n503\t\t\tif code != http.StatusOK || !ok {\n504\t\t\t\tt.Fatalf(\"step 2: claim failed: code=%d ok=%v\", code, ok)\n505\t\t\t}\n506\t\n507\t\t\t// 3. 标记 fixing（模拟 001-5-issue-fix 调用 update_issue_status）\n508\t\t\tresp := e.post(t, \"/api/issue/status\",\n509\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":10,\"session_id\":\"sess_fix_001\",\"status\":\"fixing\"}`)\n510\t\t\tvar result struct {\n511\t\t\t\tSuccess        bool   `json:\"success\"`\n512\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n513\t\t\t\tNewStatus      string `json:\"new_status\"`\n514\t\t\t}\n515\t\t\treadJSON(t, resp, &result)\n516\t\t\tif !result.Success {\n517\t\t\t\tt.Fatalf(\"step 3: fixing update failed\")\n518\t\t\t}\n519\t\t\tif result.PreviousStatus != \"claimed\" {\n520\t\t\t\tt.Errorf(\"step 3: expected previous=claimed, got %s\", result.PreviousStatus)\n521\t\t\t}\n522\t\t\tif result.NewStatus != \"fixing\" {\n523\t\t\t\tt.Errorf(\"step 3: expected new=fixing, got %s\", result.NewStatus)\n524\t\t\t}\n525\t\n526\t\t\t// 4. check 确认状态为 fixing\n527\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n528\t\t\tif s[10] != \"fixing\" {\n529\t\t\t\tt.Fatalf(\"step 4: expected fixing, got %s\", s[10])\n530\t\t\t}\n531\t\t})\n532\t\n533\t\tt.Run(\"non_owner_cannot_fix\", func(t *testing.T) {\n534\t\t\t// 验收：非领取者无法标记 fixing\n535\t\t\te := setup(t)\n536\t\t\tdb := e.store.DB()\n537\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"claimed\", \"sess_owner\", \"2026-05-27T10:00:00Z\")\n538\t\n539\t\t\tresp := e.post(t, \"/api/issue/status\",\n540\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"fixing\"}`)\n541\t\n542\t\t\tvar result struct {\n543\t\t\t\tSuccess bool   `json:\"success\"`\n544\t\t\t\tError   string `json:\"error\"`\n545\t\t\t}\n546\t\t\treadJSON(t, resp, &result)\n547\t\t\tif result.Success {\n548\t\t\t\tt.Fatal(\"non-owner should not be able to update status\")\n549\t\t\t}\n550\t\t\tif result.Error != \"not_owner\" {\n551\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n552\t\t\t}\n553\t\t})\n554\t\n555\t\tt.Run(\"fixing_released_on_session_end\", func(t *testing.T) {\n556\t\t\t// 验收：fixing 状态的 issue 在 session 结束时被释放回到 idle\n557\t\t\t// 模拟：claim → fixing → session end → idle\n558\t\t\te := setup(t)\n559\t\t\tdb := e.store.DB()\n560\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"claimed\", \"sess_fix_end\", \"2026-05-27T10:00:00Z\")\n561\t\n562\t\t\t// 标记 fixing\n563\t\t\te.post(t, \"/api/issue/status\",\n564\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":10,\"session_id\":\"sess_fix_end\",\"status\":\"fixing\"}`)\n565\t\n566\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n567\t\t\tif s[10] != \"fixing\" {\n568\t\t\t\tt.Fatalf(\"expected fixing before session end, got %s\", s[10])\n569\t\t\t}\n570\t\n571\t\t\t// session end 释放\n572\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n573\t\t\t\t`{\"session_id\":\"sess_fix_end\"}`)\n574\t\t\tvar rel struct {\n575\t\t\t\tCount int `json:\"count\"`\n576\t\t\t}\n577\t\t\treadJSON(t, resp, &rel)\n578\t\t\tif rel.Count != 1 {\n579\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n580\t\t\t}\n581\t\n582\t\t\t// 验证回到 idle\n583\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n584\t\t\tif s[10] != \"idle\" {\n585\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n586\t\t\t}\n587\t\t})\n588\t\n589\t\tt.Run(\"full_lifecycle_claim_fix_release\", func(t *testing.T) {\n590\t\t\t// 完整生命周期：idle → claimed → fixing → session end → idle → re-claim\n591\t\t\te := setup(t)\n592\t\n593\t\t\t// 1. idle\n594\t\t\te.post(t, \"/api/issue/check\",\n595\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[15]}`)\n596\t\n597\t\t\t// 2. claim\n598\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 15, \"sess_lifecycle\")\n599\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n600\t\t\tif s[15] != \"claimed\" {\n601\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", s[15])\n602\t\t\t}\n603\t\n604\t\t\t// 3. fixing\n605\t\t\te.post(t, \"/api/issue/status\",\n606\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":15,\"session_id\":\"sess_lifecycle\",\"status\":\"fixing\"}`)\n607\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n608\t\t\tif s[15] != \"fixing\" {\n609\t\t\t\tt.Fatalf(\"step 3: expected fixing, got %s\", s[15])\n610\t\t\t}\n611\t\n612\t\t\t// 4. session end 释放\n613\t\t\te.post(t, \"/api/issue/release-session\",\n614\t\t\t\t`{\"session_id\":\"sess_lifecycle\"}`)\n615\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n616\t\t\tif s[15] != \"idle\" {\n617\t\t\t\tt.Fatalf(\"step 4: expected idle, got %s\", s[15])\n618\t\t\t}\n619\t\n620\t\t\t// 5. 重新被另一个 session 领取\n621\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 15, \"sess_new\")\n622\t\t\tif code != http.StatusOK || !ok {\n623\t\t\t\tt.Fatalf(\"step 5: re-claim failed: code=%d ok=%v\", code, ok)\n624\t\t\t}\n625\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n626\t\t\tif s[15] != \"claimed\" {\n627\t\t\t\tt.Fatalf(\"step 5: expected claimed, got %s\", s[15])\n628\t\t\t}\n629\t\t})\n630\t\n631\t\tt.Run(\"fixing_merged_not_released_on_session_end\", func(t *testing.T) {\n632\t\t\t// 补充：如果 fixing 的 issue 在期间被外部标记为 merged，\n633\t\t\t// session end 不应释放它（虽然正常流程不会出现这种场景，但验证边界条件）\n634\t\t\te := setup(t)\n635\t\t\tdb := e.store.DB()\n636\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_merged\", \"2026-05-27T10:00:00Z\")\n637\t\n638\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n639\t\t\t\t`{\"session_id\":\"sess_merged\"}`)\n640\t\t\tvar rel struct {\n641\t\t\t\tCount int `json:\"count\"`\n642\t\t\t}\n643\t\t\treadJSON(t, resp, &rel)\n644\t\t\tif rel.Count != 0 {\n645\t\t\t\tt.Fatalf(\"merged should not be released, got count=%d\", rel.Count)\n646\t\t\t}\n647\t\n648\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n649\t\t\tif s[10] != \"merged\" {\n650\t\t\t\tt.Errorf(\"expected merged unchanged, got %s\", s[10])\n651\t\t\t}\n652\t\t})\n653\t}\n654\t\n655\t// --- D3: 001-6-issue-done 技能集成测试 ---\n656\t// 验收标准：\n657\t//   - fixing → ready-for-pr 状态更新\n658\t//   - ready-for-pr 状态在 session end 时被释放\n659\t//   - 完整技能流程：claim → fixing → ready-for-pr → session end\n660\t\n661\t// TestIssueDoneFlow 验证 issue-done 技能的完整流程。\n662\tfunc TestIssueDoneFlow(t *testing.T) {\n663\t\tt.Run(\"fixing_to_ready_for_pr\", func(t *testing.T) {\n664\t\t\te := setup(t)\n665\t\n666\t\t\t// claim → fixing → ready-for-pr\n667\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 20, \"sess_done_001\")\n668\t\t\te.post(t, \"/api/issue/status\",\n669\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":20,\"session_id\":\"sess_done_001\",\"status\":\"fixing\"}`)\n670\t\n671\t\t\tresp := e.post(t, \"/api/issue/status\",\n672\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":20,\"session_id\":\"sess_done_001\",\"status\":\"ready-for-pr\"}`)\n673\t\t\tvar result struct {\n674\t\t\t\tSuccess        bool   `json:\"success\"`\n675\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n676\t\t\t\tNewStatus      string `json:\"new_status\"`\n677\t\t\t}\n678\t\t\treadJSON(t, resp, &result)\n679\t\t\tif !result.Success {\n680\t\t\t\tt.Fatal(\"ready-for-pr update failed\")\n681\t\t\t}\n682\t\t\tif result.PreviousStatus != \"fixing\" {\n683\t\t\t\tt.Errorf(\"expected previous=fixing, got %s\", result.PreviousStatus)\n684\t\t\t}\n685\t\n686\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{20})\n687\t\t\tif s[20] != \"ready-for-pr\" {\n688\t\t\t\tt.Fatalf(\"expected ready-for-pr, got %s\", s[20])\n689\t\t\t}\n690\t\t})\n691\t\n692\t\tt.Run(\"ready_for_pr_released_on_session_end\", func(t *testing.T) {\n693\t\t\te := setup(t)\n694\t\t\tdb := e.store.DB()\n695\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"ready-for-pr\", \"sess_done_end\", \"2026-05-27T10:00:00Z\")\n696\t\n697\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n698\t\t\t\t`{\"session_id\":\"sess_done_end\"}`)\n699\t\t\tvar rel struct{ Count int `json:\"count\"` }\n700\t\t\treadJSON(t, resp, &rel)\n701\t\t\tif rel.Count != 1 {\n702\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n703\t\t\t}\n704\t\n705\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n706\t\t\tif s[10] != \"idle\" {\n707\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n708\t\t\t}\n709\t\t})\n710\t\n711\t\tt.Run(\"full_lifecycle_claim_fix_done_release\", func(t *testing.T) {\n712\t\t\te := setup(t)\n713\t\n714\t\t\t// idle\n715\t\t\te.post(t, \"/api/issue/check\",\n716\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[25]}`)\n717\t\n718\t\t\t// claim\n719\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 25, \"sess_lc_done\")\n720\t\n721\t\t\t// fixing\n722\t\t\te.post(t, \"/api/issue/status\",\n723\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":25,\"session_id\":\"sess_lc_done\",\"status\":\"fixing\"}`)\n724\t\n725\t\t\t// ready-for-pr\n726\t\t\te.post(t, \"/api/issue/status\",\n727\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":25,\"session_id\":\"sess_lc_done\",\"status\":\"ready-for-pr\"}`)\n728\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{25})\n729\t\t\tif s[25] != \"ready-for-pr\" {\n730\t\t\t\tt.Fatalf(\"expected ready-for-pr, got %s\", s[25])\n731\t\t\t}\n732\t\n733\t\t\t// session end\n734\t\t\te.post(t, \"/api/issue/release-session\",\n735\t\t\t\t`{\"session_id\":\"sess_lc_done\"}`)\n736\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{25})\n737\t\t\tif s[25] != \"idle\" {\n738\t\t\t\tt.Fatalf(\"expected idle after session end, got %s\", s[25])\n739\t\t\t}\n740\t\n741\t\t\t// re-claim by another session\n742\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 25, \"sess_new\")\n743\t\t\tif code != http.StatusOK || !ok {\n744\t\t\t\tt.Fatalf(\"re-claim failed\")\n745\t\t\t}\n746\t\t})\n747\t}\n748\t\n749\t// --- D4: 001-7-issue-pr 技能集成测试 ---\n750\t// 验收标准：\n751\t//   - ready-for-pr → pr-created 状态更新\n752\t//   - pr-created 状态在 session end 时被释放\n753\t//   - 完整技能流程：claim → fixing → ready-for-pr → pr-created\n754\t\n755\t// TestIssuePRFlow 验证 issue-pr 技能的完整流程。\n756\tfunc TestIssuePRFlow(t *testing.T) {\n757\t\tt.Run(\"ready_for_pr_to_pr_created\", func(t *testing.T) {\n758\t\t\te := setup(t)\n759\t\n760\t\t\t// claim → fixing → ready-for-pr → pr-created\n761\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 30, \"sess_pr_001\")\n762\t\t\te.post(t, \"/api/issue/status\",\n763\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":30,\"session_id\":\"sess_pr_001\",\"status\":\"fixing\"}`)\n764\t\t\te.post(t, \"/api/issue/status\",\n765\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":30,\"session_id\":\"sess_pr_001\",\"status\":\"ready-for-pr\"}`)\n766\t\n767\t\t\tresp := e.post(t, \"/api/issue/status\",\n768\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":30,\"session_id\":\"sess_pr_001\",\"status\":\"pr-created\"}`)\n769\t\t\tvar result struct {\n770\t\t\t\tSuccess        bool   `json:\"success\"`\n771\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n772\t\t\t\tNewStatus      string `json:\"new_status\"`\n773\t\t\t}\n774\t\t\treadJSON(t, resp, &result)\n775\t\t\tif !result.Success {\n776\t\t\t\tt.Fatal(\"pr-created update failed\")\n777\t\t\t}\n778\t\t\tif result.PreviousStatus != \"ready-for-pr\" {\n779\t\t\t\tt.Errorf(\"expected previous=ready-for-pr, got %s\", result.PreviousStatus)\n780\t\t\t}\n781\t\n782\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{30})\n783\t\t\tif s[30] != \"pr-created\" {\n784\t\t\t\tt.Fatalf(\"expected pr-created, got %s\", s[30])\n785\t\t\t}\n786\t\t})\n787\t\n788\t\tt.Run(\"pr_created_released_on_session_end\", func(t *testing.T) {\n789\t\t\te := setup(t)\n790\t\t\tdb := e.store.DB()\n791\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"pr-created\", \"sess_pr_end\", \"2026-05-27T10:00:00Z\")\n792\t\n793\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n794\t\t\t\t`{\"session_id\":\"sess_pr_end\"}`)\n795\t\t\tvar rel struct{ Count int `json:\"count\"` }\n796\t\t\treadJSON(t, resp, &rel)\n797\t\t\tif rel.Count != 1 {\n798\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n799\t\t\t}\n800\t\n801\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n802\t\t\tif s[10] != \"idle\" {\n803\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n804\t\t\t}\n805\t\t})\n806\t\n807\t\tt.Run(\"full_lifecycle_to_pr_created\", func(t *testing.T) {\n808\t\t\te := setup(t)\n809\t\n810\t\t\t// idle\n811\t\t\te.post(t, \"/api/issue/check\",\n812\t\t\t\t`{\"repo_full_nam