[2026-06-13 19:31:28] [INFO] [PostToolBatch] Input: {"session_id":"d185f22a-32bc-44c4-8583-c3900cb0bc06","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\d185f22a-32bc-44c4-8583-c3900cb0bc06.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus","permission_mode":"default","effort":{"level":"medium"},"hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/cmd/claude-tap/main.go"},"tool_use_id":"call_22873be0cf3c41709f66a674","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"log\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"os/signal\"\n9\t\t\"strconv\"\n10\t\t\"strings\"\n11\t\t\"syscall\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/config\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/proxy\"\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/session\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n19\t)\n20\t\n21\t// main 是 claude-tap-plus 的入口函数，负责解析子命令并分发到对应处理函数。\n22\t//\n23\t// 支持的子命令：\n24\t//   session-push    收集本地 Claude 会话到存储\n25\t//   session-pull    从存储恢复会话到 ~/.claude/\n26\t//   session-status  显示会话存储状态\n27\t//   backend         启动后端服务器模式\n28\t//   deploy          将模板配置部署到目标项目\n29\t//   help            显示使用帮助\n30\t//\n31\t// 无子命令时默认进入代理模式（拦截 Claude Code API 流量）。\n32\tfunc main() {\n33\t\t// 设置日志格式：仅显示时间（含微秒）\n34\t\tlog.SetFlags(log.Ltime | log.Lmicroseconds)\n35\t\n36\t\t// 初始化文件日志器（使用默认 trace 目录）\n37\t\tlogDir := trace.DefaultTraceDir()\n38\t\tif err := logger.Init(logDir, false, logger.INFO); err != nil {\n39\t\t\tlog.Printf(\"warning: logger init failed: %v\", err)\n40\t\t}\n41\t\tdefer logger.Close()\n42\t\n43\t\t// 检测子命令，如果第一个参数是已知子命令则分发执行\n44\t\tif len(os.Args) > 1 {\n45\t\t\tswitch os.Args[1] {\n46\t\t\tcase \"session-push\":\n47\t\t\t\trunSessionPush(os.Args[2:])\n48\t\t\t\treturn\n49\t\t\tcase \"session-pull\":\n50\t\t\t\trunSessionPull(os.Args[2:])\n51\t\t\t\treturn\n52\t\t\tcase \"session-status\":\n53\t\t\t\trunSessionStatus(os.Args[2:])\n54\t\t\t\treturn\n55\t\t\tcase \"backend\":\n56\t\t\t\trunBackend(os.Args[2:])\n57\t\t\t\treturn\n58\t\t\tcase \"deploy\":\n59\t\t\t\trunDeploy(os.Args[2:])\n60\t\t\t\treturn\n61\t\t\tcase \"help\", \"--help\", \"-h\":\n62\t\t\t\tprintUsage()\n63\t\t\t\treturn\n64\t\t\t}\n65\t\t}\n66\t\n67\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n68\t\trunProxy(os.Args[1:])\n69\t}\n70\t\n71\t// printUsage 打印命令行使用帮助信息到标准输出。\n72\tfunc printUsage() {\n73\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n74\t\tfmt.Println()\n75\t\tfmt.Println(\"Usage:\")\n76\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n77\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n78\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n79\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n80\t\tfmt.Println()\n81\t\tfmt.Println(\"Proxy flags:\")\n82\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n83\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n84\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n85\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n86\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n87\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n88\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n89\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n90\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n91\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n92\t\tfmt.Println(\"  claude-tap-plus deploy --target PATH             Deploy .claude/ template to project\")\n93\t\tfmt.Println()\n94\t\tfmt.Println(\"Deploy flags:\")\n95\t\tfmt.Println(\"  --target PATH, -t      Target project root directory (required)\")\n96\t\tfmt.Println(\"  --dry-run              Preview changes without copying files\")\n97\t\tfmt.Println()\n98\t\tfmt.Println(\"Session-push flags:\")\n99\t\tfmt.Println(\"  --all                  Collect all projects\")\n100\t\tfmt.Println(\"  --force                Overwrite existing files\")\n101\t\tfmt.Println(\"  --dry-run              Preview only\")\n102\t\tfmt.Println(\"  --project NAME         Override project name\")\n103\t\tfmt.Println()\n104\t\tfmt.Println(\"Session-pull flags:\")\n105\t\tfmt.Println(\"  --all                  Restore all projects\")\n106\t\tfmt.Println(\"  --project NAME         Override project name\")\n107\t\tfmt.Println(\"  --dry-run              Preview only\")\n108\t\tfmt.Println()\n109\t\tfmt.Println(\"Session-status flags:\")\n110\t\tfmt.Println(\"  --verbose              Show file-level details\")\n111\t}\n112\t\n113\t// runProxy 是默认的代理模式主逻辑。\n114\t//\n115\t// 工作流程：\n116\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n117\t//  2. 自动探测上游 API 目标地址\n118\t//  3. 启动本地反向代理监听指定端口\n119\t//  4. 解析 Claude Code 可执行文件路径\n120\t//  5. 构建子进程环境变量（注入代理地址）\n121\t//  6. 启动 Claude Code 作为子进程\n122\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n123\t//  8. 子进程退出后打印 API 调用统计摘要\n124\tfunc runProxy(args []string) {\n125\t\t// 记录原始命令行参数，用于生成 resume 命令\n126\t\toriginalArgs := append([]string{}, args...)\n127\t\n128\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n129\t\tvar (\n130\t\t\ttapTarget    string // 上游 API 目标地址\n131\t\t\ttapPort      int    // 本地代理监听端口\n132\t\t\ttapOutputDir string // 追踪记录输出目录\n133\t\t\ttapVerbose   bool   // 是否启用详细日志\n134\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n135\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n136\t\t\ttapAPIKey    string // 直接传入 API Key\n137\t\t\ttapAuthToken string // 直接传入 OAuth Token\n138\t\t\ttapBaseURL   string // 直接传入上游地址\n139\t\t)\n140\t\n141\t\tvar claudeArgs []string\n142\t\tfor i := 0; i < len(args); i++ {\n143\t\t\targ := args[i]\n144\t\t\tswitch {\n145\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n146\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n147\t\t\t\ti++\n148\t\t\t\ttapTarget = args[i]\n149\t\t\t// 解析 --tap-target=URL 形式\n150\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n151\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n152\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n153\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n154\t\t\t\ti++\n155\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n156\t\t\t// 解析 --tap-port=PORT 形式\n157\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n158\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n159\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n160\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n161\t\t\t\ti++\n162\t\t\t\ttapOutputDir = args[i]\n163\t\t\t// 解析 --tap-output-dir=DIR 形式\n164\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n165\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n166\t\t\t// 启用详细日志\n167\t\t\tcase arg == \"--tap-verbose\":\n168\t\t\t\ttapVerbose = true\n169\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n170\t\t\tcase arg == \"--tap-console\":\n171\t\t\t\ttapConsole = true\n172\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n173\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n174\t\t\t\ti++\n175\t\t\t\ttapProfile = args[i]\n176\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n177\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n178\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n179\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n180\t\t\t\ti++\n181\t\t\t\ttapAPIKey = args[i]\n182\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n183\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n184\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n185\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n186\t\t\t\ti++\n187\t\t\t\ttapAuthToken = args[i]\n188\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n189\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n190\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n191\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n192\t\t\t\ti++\n193\t\t\t\ttapBaseURL = args[i]\n194\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n195\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n196\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n197\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n198\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n199\t\t\t\ti = len(args) // 停止解析\n200\t\t\t// 未知的 --tap-* 标志，直接忽略\n201\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n202\t\t\t// 其他参数视为 Claude Code 的参数\n203\t\t\tdefault:\n204\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n205\t\t\t}\n206\t\t}\n207\t\n208\t\t// 如果未指定输出目录，使用默认追踪目录\n209\t\tif tapOutputDir == \"\" {\n210\t\t\ttapOutputDir = trace.DefaultTraceDir()\n211\t\t}\n212\t\n213\t\t// 校验：--tap-console 必须配合 --tap-verbose\n214\t\tif tapConsole && !tapVerbose {\n215\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n216\t\t\tos.Exit(1)\n217\t\t}\n218\t\n219\t\t// 根据详细程度重新初始化日志器\n220\t\tif tapVerbose {\n221\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n222\t\t} else {\n223\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n224\t\t}\n225\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n226\t\n227\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n228\t\tresolved, err := config.ResolveTargetConfig(\n229\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n230\t\t\ttapAPIKey,\n231\t\t\ttapAuthToken,\n232\t\t\ttapProfile,\n233\t\t\t&config.ClaudeClient,\n234\t\t)\n235\t\tif err != nil {\n236\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n237\t\t}\n238\t\ttarget := resolved.BaseURL\n239\t\tif tapVerbose {\n240\t\t\tlog.Printf(\"upstream target: %s\", target)\n241\t\t}\n242\t\n243\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n244\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n245\t\n246\t\t// 设置 model 改写（契约 2：resolved.Model 优先级链）\n247\t\trp.SetModel(resolved.Model)\n248\t\n249\t\t// 检测是否为 kimi 上游，启用 reasoning_content 缓存\n250\t\tif proxy.IsKimiURL(resolved.BaseURL) {\n251\t\t\trp.SetKimiMode(true)\n252\t\t}\n253\t\n254\t\t// 加载兜底配置（契约 4：优先 profiles.json → 再 Claude settings）\n255\t\tfallbackCfgs := loadFallbackConfigs(resolved.Model, tapProfile)\n256\t\tif len(fallbackCfgs) > 0 {\n257\t\t\trp.SetFallbackConfigs(fallbackCfgs)\n258\t\t}\n259\t\n260\t\tport := tapPort\n261\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n262\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n263\t\tif err != nil {\n264\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n265\t\t}\n266\t\t// 函数退出时停止代理\n267\t\tdefer rp.Stop()\n268\t\n269\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n270\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n271\t\n272\t\t// 自动检测并启动后端服务（如果未运行）\n273\t\tensureBackend()\n274\t\n275\t\t// 向后端注册本代理（hooks 通过环境变量直连 proxy，backend 用于 session/issue 管理）\n276\t\tregisterProxyWithBackend(proxyURL)\n277\t\t// 代理退出时注销\n278\t\tdefer unregisterProxyFromBackend()\n279\t\n280\t\t// 设置会话初始化回调：注册到 proxy.json\n281\t\trp.OnSessionInit = func(sessionID, projectSlug string) {\n282\t\t\tkey := ProxySessionKey(projectSlug, sessionID)\n283\t\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\n284\t\t\t\tlogger.Warn(\"main\", \"register proxy session failed: %v\", err)\n285\t\t\t}\n286\t\t}\n287\t\t// 代理退出时注销 proxy.json 中的会话\n288\t\tdefer func() {\n289\t\t\tif sid := rp.SessionID(); sid != \"\" {\n290\t\t\t\tslug := rp.ProjectSlug()\n291\t\t\t\tkey := ProxySessionKey(slug, sid)\n292\t\t\t\tif err := UnregisterProxySession(key); err != nil {\n293\t\t\t\t\tlogger.Warn(\"main\", \"unregister proxy session failed: %v\", err)\n294\t\t\t\t}\n295\t\t\t}\n296\t\t}()\n297\t\n298\t\t// 解析 Claude Code 可执行文件路径\n299\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n300\t\tif err != nil {\n301\t\t\tlog.Fatal(err)\n302\t\t}\n303\t\n304\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n305\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n306\t\n307\t\t// 注入代理 PID 和 URL 到子进程环境（hook 直接 curl proxy，无需 backend 中转）\n308\t\tchildEnv = append(childEnv, \"CLAUDE_TAP_PROXY_PID=\"+strconv.Itoa(os.Getpid()))\n309\t\tchildEnv = append(childEnv, \"CLAUDE_TAP_PROXY_URL=\"+proxyURL)\n310\t\n311\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n312\t\tif resolved.APIKey != \"\" {\n313\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n314\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n315\t\t} else if resolved.AuthToken != \"\" {\n316\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n317\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n318\t\t}\n319\t\n320\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n321\t\tfinalArgs := claudeArgs\n322\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n323\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n324\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n325\t\t}\n326\t\n327\t\t// 启动 Claude Code 作为子进程\n328\t\tcmd := exec.Command(claudePath, finalArgs...)\n329\t\tcmd.Env = childEnv\n330\t\tcmd.Stdin = os.Stdin\n331\t\tcmd.Stdout = os.Stdout\n332\t\tcmd.Stderr = os.Stderr\n333\t\n334\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n335\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n336\t\n337\t\tif err := cmd.Start(); err != nil {\n338\t\t\tlog.Fatalf(\"start claude: %v\", err)\n339\t\t}\n340\t\n341\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n342\t\tsigChan := make(chan os.Signal, 2)\n343\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n344\t\n345\t\tgo func() {\n346\t\t\tsigCount := 0\n347\t\t\tfor sig := range sigChan {\n348\t\t\t\tsigCount++\n349\t\t\t\tif sigCount == 1 {\n350\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n351\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n352\t\t\t\t\t_ = cmd.Process.Signal(sig)\n353\t\t\t\t} else {\n354\t\t\t\t\t// 再次收到信号：强制终止子进程\n355\t\t\t\t\t_ = cmd.Process.Kill()\n356\t\t\t\t}\n357\t\t\t}\n358\t\t}()\n359\t\n360\t\t// 等待子进程结束\n361\t\twaitErr := cmd.Wait()\n362\t\n363\t\t// 停止信号处理器，释放资源\n364\t\tsignal.Stop(sigChan)\n365\t\tclose(sigChan)\n366\t\n367\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n368\t\tsummary := rp.Summary()\n369\t\ttracePath := rp.TracePath()\n370\t\n371\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n372\t\tif waitErr != nil {\n373\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n374\t\t}\n375\t\tfmt.Printf(\"\\n\")\n376\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n377\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n378\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n379\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n380\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n381\t\tif tracePath != \"\" {\n382\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n383\t\t}\n384\t\tfmt.Printf(\"\\n\")\n385\t\n386\t\t// 生成 Resume 命令（仅在有 session_id 时）\n387\t\tsessionID := rp.SessionID()\n388\t\tif sessionID != \"\" {\n389\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n390\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n391\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n392\t\t}\n393\t}\n394\t\n395\t// loadFallbackConfigs 按优先级加载兜底配置列表。\n396\t//\n397\t// 优先级（从高到低）：\n398\t//  1. profiles.json 中与 targetModel 同 model 的其他 profile\n399\t//  2. profiles.json 中其他 model 的 profile\n400\t//  3. ~/.claude/settings.json 中的配置（原始 fallback 逻辑）\n401\tfunc loadFallbackConfigs(targetModel, excludeProfile string) []*proxy.FallbackConfig {\n402\t\t// Level 1 & 2: 优先从 profiles.json 查找\n403\t\tprofiles, err := config.ResolveFallbackProfiles(targetModel, excludeProfile)\n404\t\tif err == nil && len(profiles) > 0 {\n405\t\t\tvar result []*proxy.FallbackConfig\n406\t\t\tfor _, p := range profiles {\n407\t\t\t\tresult = append(result, &proxy.FallbackConfig{\n408\t\t\t\t\tBaseURL:   p.BaseURL,\n409\t\t\t\t\tModel:     p.Model,\n410\t\t\t\t\tAuthToken: p.AuthToken,\n411\t\t\t\t\tAPIKey:    p.APIKey,\n412\t\t\t\t})\n413\t\t\t}\n414\t\t\tlogger.Info(\"main\", \"fallback loaded from profiles.json: %d candidates\", len(result))\n415\t\t\treturn result\n416\t\t}\n417\t\n418\t\t// Level 3: 回退到原始逻辑（Claude settings）\n419\t\ts, err := config.ReadClaudeSettings()\n420\t\tif err != nil || s == nil {\n421\t\t\treturn nil\n422\t\t}\n423\t\n424\t\tbaseURL := s.Env.AnthropicBaseURL\n425\t\tif baseURL == \"\" {\n426\t\t\tbaseURL = config.ClaudeClient.DefaultTarget\n427\t\t}\n428\t\n429\t\tlogger.Info(\"main\", \"fallback loaded from Claude settings\")\n430\t\treturn []*proxy.FallbackConfig{{\n431\t\t\tBaseURL:   baseURL,\n432\t\t\tModel:     s.Model,\n433\t\t\tAuthToken: s.Env.AnthropicAuthToken,\n434\t\t\tAPIKey:    s.Env.AnthropicAPIKey,\n435\t\t}}\n436\t}\n437\t\n438\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n439\t//\n440\t// 支持的参数：\n441\t//   --all       收集所有项目的会话\n442\t//   --force     覆盖已存在的会话文件\n443\t//   --dry-run   仅预览，不实际执行\n444\t//   --project   指定项目名称，覆盖自动检测\n445\tfunc runSessionPush(args []string) {\n446\t\tvar opts session.PushOptions\n447\t\tfor i := 0; i < len(args); i++ {\n448\t\t\targ := args[i]\n449\t\t\tswitch {\n450\t\t\tcase arg == \"--all\":\n451\t\t\t\topts.All = true\n452\t\t\tcase arg == \"--force\":\n453\t\t\t\topts.Force = true\n454\t\t\tcase arg == \"--dry-run\":\n455\t\t\t\topts.DryRun = true\n456\t\t\tcase arg == \"--project\" && i+1 < len(args):\n457\t\t\t\ti++\n458\t\t\t\topts.Project = args[i]\n459\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n460\t\t\t\topts.Project = arg[len(\"--project=\"):]\n461\t\t\t}\n462\t\t}\n463\t\n464\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n465\t\tresults, err := session.SessionPush(opts)\n466\t\tif err != nil {\n467\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n468\t\t\tos.Exit(1)\n469\t\t}\n470\t\n471\t\t// 汇总各项目的收集结果\n472\t\tfmt.Println()\n473\t\ttotalNew, totalSkipped := 0, 0\n474\t\tfor _, r := range results {\n475\t\t\ttotalNew += r.SessionsNew\n476\t\t\ttotalSkipped += r.SessionsSkipped\n477\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n478\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n479\t\t\t}\n480\t\t}\n481\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n482\t}\n483\t\n484\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n485\t//\n486\t// 支持的参数：\n487\t//   --all       恢复所有项目的会话\n488\t//   --dry-run   仅预览，不实际执行\n489\t//   --project   指定项目名称，覆盖自动检测\n490\tfunc runSessionPull(args []string) {\n491\t\tvar opts session.PullOptions\n492\t\tfor i := 0; i < len(args); i++ {\n493\t\t\targ := args[i]\n494\t\t\tswitch {\n495\t\t\tcase arg == \"--all\":\n496\t\t\t\topts.All = true\n497\t\t\tcase arg == \"--dry-run\":\n498\t\t\t\topts.DryRun = true\n499\t\t\tcase arg == \"--project\" && i+1 < len(args):\n500\t\t\t\ti++\n501\t\t\t\topts.Project = args[i]\n502\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n503\t\t\t\topts.Project = arg[len(\"--project=\"):]\n504\t\t\t}\n505\t\t}\n506\t\n507\t\tfmt.Println(\"📤 Restoring sessions...\")\n508\t\tresults, err := session.SessionPull(opts)\n509\t\tif err != nil {\n510\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n511\t\t\tos.Exit(1)\n512\t\t}\n513\t\n514\t\t// 汇总各项目的恢复结果\n515\t\tfmt.Println()\n516\t\ttotalRestored, totalSkipped := 0, 0\n517\t\tfor _, r := range results {\n518\t\t\ttotalRestored += r.SessionsRestored\n519\t\t\ttotalSkipped += r.SessionsSkipped\n520\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n521\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n522\t\t\t}\n523\t\t}\n524\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n525\t}\n526\t\n527\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n528\t//\n529\t// 支持的参数：\n530\t//   --verbose   显示文件级别的详细信息\n531\tfunc runSessionStatus(args []string) {\n532\t\tvar opts session.StatusOptions\n533\t\tfor i := 0; i < len(args); i++ {\n534\t\t\targ := args[i]\n535\t\t\tswitch {\n536\t\t\tcase arg == \"--verbose\":\n537\t\t\t\topts.Verbose = true\n538\t\t\t}\n539\t\t}\n540\t\n541\t\tif err := session.SessionStatus(opts); err != nil {\n542\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n543\t\t\tos.Exit(1)\n544\t\t}\n545\t}\n546\t\n547\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n548\t// 如果参数中包含空格或制表符，则使用引号包裹。\n549\tfunc formatArgs(args []string) string {\n550\t\tresult := \"\"\n551\t\tfor _, a := range args {\n552\t\t\tif containsSpace(a) {\n553\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n554\t\t\t} else {\n555\t\t\t\tresult += \" \" + a\n556\t\t\t}\n557\t\t}\n558\t\treturn strings.TrimSpace(result)\n559\t}\n560\t\n561\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n562\tfunc containsSpace(s string) bool {\n563\t\tfor _, c := range s {\n564\t\t\tif c == ' ' || c == '\\t' {\n565\t\t\t\treturn true\n566\t\t\t}\n567\t\t}\n568\t\treturn false\n569\t}\n570\t\n571\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n572\tfunc firstNonEmpty(ss ...string) string {\n573\t\tfor _, s := range ss {\n574\t\t\tif s != \"\" {\n575\t\t\t\treturn s\n576\t\t\t}\n577\t\t}\n578\t\treturn \"\"\n579\t}\n580\t\n581\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n582\t//\n583\t// 逻辑：\n584\t//  1. 复制原始参数\n585\t//  2. 移除已有的 --resume <old-id>（如果存在）\n586\t//  3. 追加 --resume <new-session-id>\n587\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n588\t\tfiltered := make([]string, 0, len(originalArgs))\n589\t\tskip := false\n590\t\tfor i, arg := range originalArgs {\n591\t\t\tif skip {\n592\t\t\t\tskip = false\n593\t\t\t\tcontinue\n594\t\t\t}\n595\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n596\t\t\t\tskip = true // 跳过 --resume 及其值\n597\t\t\t\tcontinue\n598\t\t\t}\n599\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n600\t\t\t\tcontinue // 跳过 --resume=id 形式\n601\t\t\t}\n602\t\t\tfiltered = append(filtered, arg)\n603\t\t}\n604\t\tfiltered = append(filtered, \"--resume\", sessionID)\n605\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n606\t}\n607\t\n608\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n609\tfunc shortenPath(path string) string {\n610\t\thome, err := os.UserHomeDir()\n611\t\tif err != nil {\n612\t\t\treturn path\n613\t\t}\n614\t\tif strings.HasPrefix(path, home) {\n615\t\t\treturn \"~\" + path[len(home):]\n616\t\t}\n617\t\treturn path\n618\t}\n619\t\n620\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n621\tfunc removeEnvVar(env []string, name string) []string {\n622\t\tprefix := name + \"=\"\n623\t\tresult := make([]string, 0, len(env))\n624\t\tfor _, e := range env {\n625\t\t\tif !strings.HasPrefix(e, prefix) {\n626\t\t\t\tresult = append(result, e)\n627\t\t\t}\n628\t\t}\n629\t\treturn result\n630\t}\n631\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/server.go"},"tool_use_id":"call_7bdd887e21d64c5baf406b09","tool_response":"1\t// Package backend 是后端服务的主包，提供 HTTP API 服务器及其配置。\n2\tpackage backend\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"fmt\"\n7\t\t\"net/http\"\n8\t\t\"os\"\n9\t\t\"os/signal\"\n10\t\t\"syscall\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n17\t)\n18\t\n19\t// Server 是后端 HTTP 服务的主结构体，聚合配置和数据存储。\n20\ttype Server struct {\n21\t\tcfg   Config         // 服务配置\n22\t\tstore *store.SQLiteStore // SQLite 数据存储\n23\t}\n24\t\n25\t// NewServer 创建并初始化后端服务器。\n26\t// 根据配置打开 SQLite 数据库，失败时返回错误。\n27\tfunc NewServer(cfg Config) (*Server, error) {\n28\t\tlogger.Debug(\"backend\", \"creating server: host=%s port=%d db=%s\", cfg.Host, cfg.Port, cfg.DBPath)\n29\t\ts, err := store.NewSQLiteStore(cfg.DBPath)\n30\t\tif err != nil {\n31\t\t\treturn nil, fmt.Errorf(\"open database: %w\", err)\n32\t\t}\n33\t\treturn &Server{cfg: cfg, store: s}, nil\n34\t}\n35\t\n36\t// Start 启动 HTTP 服务器。\n37\t// 启动前会清理超时会话，然后注册路由并开始监听。支持优雅关闭（SIGINT/SIGTERM）。\n38\tfunc (s *Server) Start() error {\n39\t\t// 启动清理：将超时会话标记为已关闭\n40\t\tcleanupSvc := service.NewCleanupService(s.store.Sessions())\n41\t\tcleanupSvc.CleanupTimedOutSessions(context.Background())\n42\t\tlogger.Info(\"backend\", \"startup cleanup done\")\n43\t\n44\t\t// 初始化业务服务和处理器\n45\t\tissueSvc := service.NewIssueService(s.store.Issues())\n46\t\tsessionSvc := service.NewSessionService(s.store.Sessions())\n47\t\tmachineSvc := service.NewMachineService(s.store.Machines())\n48\t\tprojectSvc := service.NewProjectService(s.store.Projects())\n49\t\ttokenSvc := service.NewTokenService(s.store.Sessions())\n50\t\ttraceSvc := service.NewTraceService(s.store.Sessions())\n51\t\tlogSvc := service.NewLogService(s.cfg.LogDir)\n52\t\tconfigSvc := service.NewConfigService(s.store.Configs())\n53\t\tproxySvc := service.NewProxyService(s.store.Proxies())\n54\t\tstatusSvc := service.NewStatusService(\n55\t\t\ts.store.Sessions(), s.store.Proxies(),\n56\t\t\ts.store.Issues(), s.store.Machines(), s.store.Projects(),\n57\t\t\ttime.Now(),\n58\t\t)\n59\t\n60\t\trouter := api.NewRouter(api.Handlers{\n61\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n62\t\t\tSession: api.NewSessionHandler(sessionSvc, issueSvc, tokenSvc, traceSvc),\n63\t\t\tProxy:   api.NewProxyHandlerWithService(proxySvc),\n64\t\t\tMachine: api.NewMachineHandler(machineSvc),\n65\t\t\tProject: api.NewProjectHandler(projectSvc),\n66\t\t\tLog:     api.NewLogHandler(logSvc),\n67\t\t\tConfig:  api.NewConfigHandler(configSvc),\n68\t\t\tStatus:  api.NewStatusHandler(statusSvc),\n69\t\t})\n70\t\n71\t\t// 创建 HTTP 服务器\n72\t\tsrv := &http.Server{\n73\t\t\tAddr:    s.cfg.Addr(),\n74\t\t\tHandler: router,\n75\t\t}\n76\t\n77\t\t// 监听系统信号以实现优雅关闭\n78\t\tquit := make(chan os.Signal, 1)\n79\t\tsignal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)\n80\t\n81\t\t// 创建可取消的 context 用于停止 watchdog\n82\t\tctx, cancel := context.WithCancel(context.Background())\n83\t\tdefer cancel()\n84\t\n85\t\t// 启动空闲 watchdog：每 30s 检查 proxy.json，持续空闲 10 分钟则关闭\n86\t\twatchdog := service.NewIdleWatchdog(30*time.Second, 10*time.Minute, func() {\n87\t\t\tlogger.Info(\"backend\", \"watchdog triggered shutdown\")\n88\t\t\tsrv.Shutdown(context.Background())\n89\t\t\tcancel() // 停止 watchdog 自身\n90\t\t})\n91\t\tgo watchdog.Run(ctx)\n92\t\n93\t\tgo func() {\n94\t\t\t<-quit\n95\t\t\tlogger.Info(\"backend\", \"shutdown signal received\")\n96\t\t\tcancel() // 停止 watchdog\n97\t\t\tsrv.Shutdown(context.Background())\n98\t\t}()\n99\t\n100\t\tlogger.Info(\"backend\", \"backend listening on %s\", s.cfg.Addr())\n101\t\tif err := srv.ListenAndServe(); err != http.ErrServerClosed {\n102\t\t\treturn err\n103\t\t}\n104\t\treturn nil\n105\t}\n106\t\n107\t// Close 关闭后端服务器及其数据库连接。\n108\tfunc (s *Server) Close() error {\n109\t\terr := s.store.Close()\n110\t\tlogger.Info(\"backend\", \"backend server closed\")\n111\t\treturn err\n112\t}\n113\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/reverse.go"},"tool_use_id":"call_e7bd5f5957214f84929f2686","tool_response":"1\t// Package proxy 提供 HTTP 代理功能，包括请求转发、SSE 流式处理与 Trace 记录。\n2\tpackage proxy\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"compress/gzip\"\n7\t\t\"compress/zlib\"\n8\t\t\"encoding/json\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"net\"\n12\t\t\"net/http\"\n13\t\t\"strings\"\n14\t\t\"sync\"\n15\t\t\"sync/atomic\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n19\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n20\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n21\t)\n22\t\n23\tconst (\n24\t\tmaxUpstreamRetries = 5                    // 上游请求最大重试次数\n25\t\tretryInterval      = 30 * time.Second     // 重试间隔\n26\t\tproxyDialTimeout   = 10 * time.Second     // TCP 连接超时\n27\t\tproxyTLSHandshake  = 10 * time.Second     // TLS 握手超时\n28\t\tproxyResponseHdr   = 60 * time.Second     // 等待响应头超时\n29\t\tproxyIdleConn      = 90 * time.Second     // 空闲连接超时\n30\t)\n31\t\n32\t// ReverseProxy 拦截 HTTP 请求并转发到上游 API，同时记录请求/响应到 JSONL Trace，并处理 SSE 流式响应。\n33\ttype ReverseProxy struct {\n34\t\ttarget             string              // 上游 API 目标地址\n35\t\tbaseDir            string              // Trace 文件存放的基础目录\n36\t\twriter             *trace.TraceWriter  // 当前会话的 Trace 写入器（由 _internal/trace-init 创建）\n37\t\tclient             *http.Client        // 转发请求的 HTTP 客户端\n38\t\tturn               atomic.Int64        // 请求计数器，用于标记 Turn 编号\n39\t\tserver             *http.Server        // 本地代理 HTTP 服务器\n40\t\tstartOnce          sync.Once           // 确保 Start 只执行一次\n41\t\tsessionID          string              // 当前会话 ID（由 trace-init 设置）\n42\t\tprojectSlug        string              // 当前项目标识（由 trace-init 设置）\n43\t\tOnSessionInit      func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\n44\t\tmodel              string              // 强制替换的模型名（空=不改写）\n45\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n46\t\tfallbackConfigs    []*FallbackConfig   // 兜底配置列表（上游不可用时轮询）\n47\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfigs 的并发安全\n48\t\tactualAddr         string              // 实际监听地址（启动后设置）\n49\t\treasoningCache     *ReasoningCache     // reasoning_content 缓存（仅 kimi 模式）\n50\t\tkimiMode           bool                // 是否为 kimi 上游\n51\t\tfallbackIndex      int                 // fallback 轮询索引\n52\t\tretryInterval      time.Duration       // 重试间隔（默认 retryInterval，测试可覆盖）\n53\t}\n54\t\n55\t// FallbackConfig 存储上游不可用时的兜底配置。\n56\ttype FallbackConfig struct {\n57\t\tBaseURL   string // 兜底上游 API 地址\n58\t\tModel     string // 兜底模型名\n59\t\tAuthToken string // 兜底认证 Token\n60\t\tAPIKey    string // 兜底 API Key\n61\t}\n62\t\n63\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n64\t// traceDir 为 Trace 文件存放的基础目录。\n65\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n66\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n67\t\treturn &ReverseProxy{\n68\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n69\t\t\tbaseDir:           traceDir,\n70\t\t\tupstreamAvailable: true,\n71\t\t\tclient:            newProxyHTTPClient(),\n72\t\t}\n73\t}\n74\t\n75\t// newProxyHTTPClient 创建带 Transport 超时的 HTTP 客户端。\n76\t// 流式场景整体不设超时，但连接建立阶段有保护。\n77\tfunc newProxyHTTPClient() *http.Client {\n78\t\treturn &http.Client{\n79\t\t\tTimeout: 0, // 流式场景不设整体超时\n80\t\t\tTransport: &http.Transport{\n81\t\t\t\tDialContext: (&net.Dialer{\n82\t\t\t\t\tTimeout: proxyDialTimeout,\n83\t\t\t\t}).DialContext,\n84\t\t\t\tTLSHandshakeTimeout:   proxyTLSHandshake,\n85\t\t\t\tResponseHeaderTimeout: proxyResponseHdr,\n86\t\t\t\tIdleConnTimeout:       proxyIdleConn,\n87\t\t\t},\n88\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n89\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n90\t\t\t},\n91\t\t}\n92\t}\n93\t\n94\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n95\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n96\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n97\t\tmux := http.NewServeMux()\n98\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n99\t\tp.server = &http.Server{\n100\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n101\t\t\tHandler: mux,\n102\t\t}\n103\t\n104\t\tlistener, err := ioListener(p.server.Addr)\n105\t\tif err != nil {\n106\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n107\t\t}\n108\t\n109\t\t// 在后台 goroutine 中启动服务\n110\t\tgo func() {\n111\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n112\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n113\t\t\t}\n114\t\t}()\n115\t\n116\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n117\t\tp.actualAddr = fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n118\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n119\t\treturn actualPort, nil\n120\t}\n121\t\n122\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n123\tfunc (p *ReverseProxy) Stop() {\n124\t\tlogger.Info(\"proxy\", \"stopping\")\n125\t\tif p.writer != nil {\n126\t\t\tp.writer.Close()\n127\t\t}\n128\t\tif p.server != nil {\n129\t\t\t_ = p.server.Close()\n130\t\t}\n131\t}\n132\t\n133\t// URL 返回代理服务器的 HTTP 地址（如 http://127.0.0.1:8080）。\n134\tfunc (p *ReverseProxy) URL() string {\n135\t\treturn p.actualAddr\n136\t}\n137\t\n138\t// serveHTTP 是代理的核心 HTTP 处理函数。\n139\t// 处理流程：请求预处理 → 尝试主上游 → 失败则尝试 fallback 链 → 全部失败则友好错误。\n140\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n141\t\t// 处理内部端点（绕过路径白名单）\n142\t\tif strings.HasPrefix(r.URL.Path, \"/_internal/\") {\n143\t\t\tp.handleInternal(w, r)\n144\t\t\treturn\n145\t\t}\n146\t\n147\t\t// 拒绝未知路径\n148\t\tif !IsAllowedPath(r.URL.Path) {\n149\t\t\thttp.NotFound(w, r)\n150\t\t\treturn\n151\t\t}\n152\t\n153\t\t// 读取请求体\n154\t\tbodyBytes, err := io.ReadAll(r.Body)\n155\t\tif err != nil {\n156\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n157\t\t\treturn\n158\t\t}\n159\t\t_ = r.Body.Close()\n160\t\n161\t\t// 保存原始请求体（改写 model 前），用于 fallback 时重新改写\n162\t\toriginalBody := make([]byte, len(bodyBytes))\n163\t\tcopy(originalBody, bodyBytes)\n164\t\n165\t\t// 解析请求体为 JSON（用于后续提取 model、stream 等字段）\n166\t\tvar reqBody any\n167\t\tif len(bodyBytes) > 0 {\n168\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n169\t\t}\n170\t\n171\t\t// 请求体 model 改写（契约 3）\n172\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, p.model)\n173\t\n174\t\t// 重新解析改写后的请求体\n175\t\treqBody = nil\n176\t\tif len(bodyBytes) > 0 {\n177\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n178\t\t}\n179\t\n180\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n181\t\tbodyBytes = injectReasoningContentCached(bodyBytes, reqBody, p.reasoningCache, p.kimiMode)\n182\t\treqBody = nil\n183\t\tif len(bodyBytes) > 0 {\n184\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n185\t\t}\n186\t\n187\t\t// 生成请求 ID 与 Turn 编号\n188\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n189\t\tturn := int(p.turn.Add(1))\n190\t\tt0 := time.Now()\n191\t\n192\t\tlogger.Debug(\"proxy\", \"[Turn %d] request: %s %s (%d bytes)\", turn, r.Method, r.URL.Path, len(bodyBytes))\n193\t\n194\t\t// 读取当前状态快照\n195\t\tp.availableMu.Lock()\n196\t\tupstreamAvailable := p.upstreamAvailable\n197\t\tfbConfigs := make([]*FallbackConfig, len(p.fallbackConfigs))\n198\t\tcopy(fbConfigs, p.fallbackConfigs)\n199\t\tfbIdx := p.fallbackIndex\n200\t\tp.availableMu.Unlock()\n201\t\thasFallback := len(fbConfigs) > 0\n202\t\n203\t\t// ========== Phase 1: 尝试主上游 ==========\n204\t\tif upstreamAvailable {\n205\t\t\tupstreamURL := p.target + r.URL.Path\n206\t\t\tif r.URL.RawQuery != \"\" {\n207\t\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n208\t\t\t}\n209\t\n210\t\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n211\t\t\tif err != nil {\n212\t\t\t\tlogProxyError(w, turn, err, 0)\n213\t\t\t\treturn\n214\t\t\t}\n215\t\n216\t\t\t// 复制请求头，过滤逐跳头\n217\t\t\tfor k, vals := range r.Header {\n218\t\t\t\tlower := strings.ToLower(k)\n219\t\t\t\tif hopByHopHeaders[lower] {\n220\t\t\t\t\tcontinue\n221\t\t\t\t}\n222\t\t\t\tfor _, v := range vals {\n223\t\t\t\t\tupstreamReq.Header.Add(k, v)\n224\t\t\t\t}\n225\t\t\t}\n226\t\t\tupstreamReq.Header.Del(\"Host\")\n227\t\n228\t\t\tresp, err := p.doWithRetry(upstreamReq, turn, hasFallback)\n229\t\t\tif err != nil {\n230\t\t\t\t// 连接错误 → 标记不可用，进入 fallback 链\n231\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] primary connection error: %v\", turn, err)\n232\t\t\t\tp.markUnavailable()\n233\t\t\t\t// fall through to fallback chain\n234\t\t\t} else if !shouldFallback(resp.StatusCode) {\n235\t\t\t\t// 主上游成功（或非降级错误如 400），直接处理响应\n236\t\t\t\tdefer resp.Body.Close()\n237\t\t\t\tp.dispatchResponse(w, resp, reqID, turn, r, reqBody, t0)\n238\t\t\t\treturn\n239\t\t\t} else {\n240\t\t\t\t// 主上游返回需要降级的状态码 → 标记不可用，进入 fallback 链\n241\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] primary returned %d, triggering fallback\", turn, resp.StatusCode)\n242\t\t\t\tresp.Body.Close()\n243\t\t\t\tp.markUnavailable()\n244\t\t\t\t// fall through to fallback chain\n245\t\t\t}\n246\t\t}\n247\t\n248\t\t// ========== Phase 2: 尝试 Fallback 链 ==========\n249\t\tif hasFallback {\n250\t\t\tfor i := 0; i < len(fbConfigs); i++ {\n251\t\t\t\tidx := (fbIdx + i) % len(fbConfigs)\n252\t\t\t\tfb := fbConfigs[idx]\n253\t\n254\t\t\t\t// 从原始请求体重新改写 model\n255\t\t\t\tfbBody := make([]byte, len(originalBody))\n256\t\t\t\tcopy(fbBody, originalBody)\n257\t\t\t\tvar fbParsed any\n258\t\t\t\tif len(fbBody) > 0 {\n259\t\t\t\t\t_ = json.Unmarshal(fbBody, &fbParsed)\n260\t\t\t\t}\n261\t\t\t\tif fb.Model != \"\" {\n262\t\t\t\t\tfbBody = rewriteModel(fbBody, fbParsed, fb.Model)\n263\t\t\t\t\tfbParsed = nil\n264\t\t\t\t\tif len(fbBody) > 0 {\n265\t\t\t\t\t\t_ = json.Unmarshal(fbBody, &fbParsed)\n266\t\t\t\t\t}\n267\t\t\t\t}\n268\t\t\t\tfbBody = injectReasoningContentCached(fbBody, fbParsed, p.reasoningCache, IsKimiURL(fb.BaseURL))\n269\t\t\t\tfbParsed = nil\n270\t\t\t\tif len(fbBody) > 0 {\n271\t\t\t\t\t_ = json.Unmarshal(fbBody, &fbParsed)\n272\t\t\t\t}\n273\t\n274\t\t\t\t// 构建 fallback 请求\n275\t\t\t\tfbURL := fb.BaseURL + r.URL.Path\n276\t\t\t\tif r.URL.RawQuery != \"\" {\n277\t\t\t\t\tfbURL += \"?\" + r.URL.RawQuery\n278\t\t\t\t}\n279\t\n280\t\t\t\tfbReq, err := http.NewRequest(r.Method, fbURL, bytes.NewReader(fbBody))\n281\t\t\t\tif err != nil {\n282\t\t\t\t\tp.advanceFallback()\n283\t\t\t\t\tcontinue\n284\t\t\t\t}\n285\t\n286\t\t\t\tfor k, vals := range r.Header {\n287\t\t\t\t\tlower := strings.ToLower(k)\n288\t\t\t\t\tif hopByHopHeaders[lower] {\n289\t\t\t\t\t\tcontinue\n290\t\t\t\t\t}\n291\t\t\t\t\tfor _, v := range vals {\n292\t\t\t\t\t\tfbReq.Header.Add(k, v)\n293\t\t\t\t\t}\n294\t\t\t\t}\n295\t\t\t\tfbReq.Header.Del(\"Host\")\n296\t\n297\t\t\t\t// 替换认证头\n298\t\t\t\tif fb.APIKey != \"\" {\n299\t\t\t\t\tfbReq.Header.Set(\"x-api-key\", fb.APIKey)\n300\t\t\t\t}\n301\t\t\t\tif fb.AuthToken != \"\" {\n302\t\t\t\t\tfbReq.Header.Set(\"Authorization\", \"Bearer \"+fb.AuthToken)\n303\t\t\t\t}\n304\t\n305\t\t\t\t// 发送请求\n306\t\t\t\tfbResp, fbErr := p.client.Do(fbReq)\n307\t\t\t\tif fbErr != nil {\n308\t\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] fallback[%d] connection error: %v\", turn, idx, fbErr)\n309\t\t\t\t\tp.advanceFallback()\n310\t\t\t\t\tcontinue\n311\t\t\t\t}\n312\t\n313\t\t\t\tif shouldFallback(fbResp.StatusCode) {\n314\t\t\t\t\tfbResp.Body.Close()\n315\t\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] fallback[%d] returned %d, trying next\", turn, idx, fbResp.StatusCode)\n316\t\t\t\t\tp.advanceFallback()\n317\t\t\t\t\tcontinue\n318\t\t\t\t}\n319\t\n320\t\t\t\t// Fallback 成功！更新索引\n321\t\t\t\tp.availableMu.Lock()\n322\t\t\t\tp.fallbackIndex = idx\n323\t\t\t\tp.availableMu.Unlock()\n324\t\t\t\tlogger.Info(\"proxy\", \"[Turn %d] fallback[%d] succeeded (status %d)\", turn, idx, fbResp.StatusCode)\n325\t\n326\t\t\t\tdefer fbResp.Body.Close()\n327\t\t\t\tp.dispatchResponse(w, fbResp, reqID, turn, r, fbParsed, t0)\n328\t\t\t\treturn\n329\t\t\t}\n330\t\t}\n331\t\n332\t\t// ========== Phase 3: 所有目标失败 → 日志错误 ==========\n333\t\tlogProxyError(w, turn, fmt.Errorf(\"all targets failed\"), 0)\n334\t}\n335\t\n336\t// handleStreaming 处理 SSE 流式响应：\n337\t//   - 复制响应头并写入客户端\n338\t//   - 逐块读取上游响应体并实时转发给客户端\n339\t//   - 使用 SSE 重组器收集完整事件\n340\t//   - 将重组后的结果写入 Trace\n341\tfunc (p *ReverseProxy) handleStreaming(\n342\t\tw http.ResponseWriter,\n343\t\tupstreamResp *http.Response,\n344\t\treqID string, turn, durationMs int,\n345\t\tr *http.Request, reqBody any,\n346\t\tt0 time.Time, model string,\n347\t) {\n348\t\t// 复制响应头\n349\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n350\t\tfor k, vals := range respHeaders {\n351\t\t\tfor _, v := range vals {\n352\t\t\t\tw.Header().Add(k, v)\n353\t\t\t}\n354\t\t}\n355\t\tw.WriteHeader(upstreamResp.StatusCode)\n356\t\n357\t\tflusher, canFlush := w.(http.Flusher)\n358\t\treassembler := sse.NewSSEReassembler()\n359\t\n360\t\t// 逐块读取并转发流式数据\n361\t\tbuf := make([]byte, 32*1024)\n362\t\tfor {\n363\t\t\tn, err := upstreamResp.Body.Read(buf)\n364\t\t\tif n > 0 {\n365\t\t\t\t_, _ = w.Write(buf[:n])\n366\t\t\t\tif canFlush {\n367\t\t\t\t\tflusher.Flush()\n368\t\t\t\t}\n369\t\t\t\treassembler.FeedBytes(buf[:n])\n370\t\t\t}\n371\t\t\tif err != nil {\n372\t\t\t\tbreak\n373\t\t\t}\n374\t\t}\n375\t\n376\t\tdurationMs = int(time.Since(t0).Milliseconds())\n377\t\treconstructed := reassembler.Reconstruct()\n378\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n379\t\n380\t\t// kimi 模式下缓存 SSE 响应中的 reasoning_content\n381\t\tif p.kimiMode && reconstructed != nil {\n382\t\t\tp.cacheFromResponse(reconstructed)\n383\t\t}\n384\t\n385\t\t// 构建 Trace 记录\n386\t\trecord := buildRecord(\n387\t\t\treqID, turn, durationMs,\n388\t\t\tr.Method, r.URL.RequestURI(),\n389\t\t\tr.Header, reqBody,\n390\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n391\t\t\treconstructed,\n392\t\t\treassembler.Events,\n393\t\t\tp.target,\n394\t\t)\n395\t\n396\t\tif w := p.getWriter(); w != nil {\n397\t\t\tif err := w.Write(record); err != nil {\n398\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n399\t\t\t}\n400\t\t} else {\n401\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n402\t\t}\n403\t\n404\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n405\t}\n406\t\n407\t// handleNonStreaming 处理普通（非流式）响应：\n408\t//   - 读取完整响应体\n409\t//   - 按需解压（gzip / deflate）\n410\t//   - 解析 JSON 响应体\n411\t//   - 写入 Trace 并返回给客户端\n412\tfunc (p *ReverseProxy) handleNonStreaming(\n413\t\tw http.ResponseWriter,\n414\t\tupstreamResp *http.Response,\n415\t\treqID string, turn, durationMs int,\n416\t\tr *http.Request, reqBody any, model string,\n417\t) {\n418\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n419\t\tif err != nil {\n420\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n421\t\t\treturn\n422\t\t}\n423\t\n424\t\t// 按需解压响应体\n425\t\tdecodeBytes := respBytes\n426\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n427\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n428\t\t\tvar reader io.ReadCloser\n429\t\t\tif encoding == \"gzip\" {\n430\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n431\t\t\t} else {\n432\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n433\t\t\t}\n434\t\t\tif reader != nil {\n435\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n436\t\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n437\t\t\t\t\tdecodeBytes = decoded\n438\t\t\t\t}\n439\t\t\t\t_ = reader.Close()\n440\t\t\t}\n441\t\t}\n442\t\n443\t\t// 解析解压后的 JSON 响应体\n444\t\tvar respBody any\n445\t\tif len(decodeBytes) > 0 {\n446\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n447\t\t}\n448\t\n449\t\t// kimi 模式下缓存响应中的 reasoning_content\n450\t\tif p.kimiMode {\n451\t\t\tif respMap, ok := respBody.(map[string]any); ok {\n452\t\t\t\tp.cacheFromResponse(respMap)\n453\t\t\t}\n454\t\t}\n455\t\n456\t\t// 构建 Trace 记录\n457\t\trecord := buildRecord(\n458\t\t\treqID, turn, durationMs,\n459\t\t\tr.Method, r.URL.RequestURI(),\n460\t\t\tr.Header, reqBody,\n461\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n462\t\t\trespBody,\n463\t\t\tnil,\n464\t\t\tp.target,\n465\t\t)\n466\t\n467\t\tif w := p.getWriter(); w != nil {\n468\t\t\tif err := w.Write(record); err != nil {\n469\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n470\t\t\t}\n471\t\t} else {\n472\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n473\t\t}\n474\t\n475\t\t// 将响应返回给客户端\n476\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n477\t\tfor k, vals := range respHeaders {\n478\t\t\tfor _, v := range vals {\n479\t\t\t\tw.Header().Add(k, v)\n480\t\t\t}\n481\t\t}\n482\t\tw.WriteHeader(upstreamResp.StatusCode)\n483\t\t_, _ = w.Write(respBytes)\n484\t\n485\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n486\t}\n487\t\n488\t// buildRecord 构建一条 Trace 记录，包含请求/响应的完整信息。\n489\tfunc buildRecord(\n490\t\treqID string, turn, durationMs int,\n491\t\tmethod, path string,\n492\t\treqHeaders http.Header, reqBody any,\n493\t\tstatus int, respHeaders http.Header,\n494\t\trespBody any,\n495\t\tsseEvents []map[string]any,\n496\t\tupstreamBaseURL string,\n497\t) map[string]any {\n498\t\trecord := map[string]any{\n499\t\t\t\"timestamp\":   time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n500\t\t\t\"request_id\":  reqID,\n501\t\t\t\"session_id\":  extractSessionID(reqBody),\n502\t\t\t\"turn\":        turn,\n503\t\t\t\"duration_ms\": durationMs,\n504\t\t\t\"request\": map[string]any{\n505\t\t\t\t\"method\":  method,\n506\t\t\t\t\"path\":    path,\n507\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n508\t\t\t\t\"body\":    reqBody,\n509\t\t\t},\n510\t\t\t\"response\": map[string]any{\n511\t\t\t\t\"status\":  status,\n512\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n513\t\t\t\t\"body\":    respBody,\n514\t\t\t},\n515\t\t}\n516\t\tif len(sseEvents) > 0 {\n517\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n518\t\t}\n519\t\tif upstreamBaseURL != \"\" {\n520\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n521\t\t}\n522\t\treturn record\n523\t}\n524\t\n525\t// extractSessionID 从请求体的 metadata.user_id 字段中提取 session_id。\n526\t// Claude Code 发送的格式为：metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n527\tfunc extractSessionID(reqBody any) string {\n528\t\tbody, ok := reqBody.(map[string]any)\n529\t\tif !ok {\n530\t\t\treturn \"\"\n531\t\t}\n532\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n533\t\tif metadata == nil {\n534\t\t\treturn \"\"\n535\t\t}\n536\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n537\t\tif userIDRaw == \"\" {\n538\t\t\treturn \"\"\n539\t\t}\n540\t\tvar userData map[string]string\n541\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n542\t\t\treturn \"\"\n543\t\t}\n544\t\treturn userData[\"session_id\"]\n545\t}\n546\t\n547\t// handleInternal 分发内部代理端点请求。\n548\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n549\t\tswitch r.URL.Path {\n550\t\tcase \"/_internal/trace-init\":\n551\t\t\tp.handleTraceInit(w, r)\n552\t\tdefault:\n553\t\t\thttp.NotFound(w, r)\n554\t\t}\n555\t}\n556\t\n557\t// handleTraceInit 接收 SessionStart 钩子传来的会话信息，创建 Trace 写入器。\n558\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n559\t\tif r.Method != http.MethodPost {\n560\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n561\t\t\treturn\n562\t\t}\n563\t\n564\t\tvar req struct {\n565\t\t\tSessionID      string `json:\"session_id\"`\n566\t\t\tMachineID      string `json:\"machine_id\"`\n567\t\t\tProjectSlug    string `json:\"project_slug\"`\n568\t\t\tTranscriptPath string `json:\"transcript_path\"`\n569\t\t}\n570\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n571\t\t\tlogger.Warn(\"proxy\", \"trace-init: invalid JSON: %v\", err)\n572\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n573\t\t\treturn\n574\t\t}\n575\t\n576\t\tif req.SessionID == \"\" {\n577\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n578\t\t\treturn\n579\t\t}\n580\t\n581\t\t// 允许 session 重新绑定（/clear 后新 session 取代旧 session）\n582\t\tif p.sessionID != \"\" && p.sessionID != req.SessionID {\n583\t\t\tlogger.Debug(\"proxy\", \"trace-init: rebinding session %s -> %s\", p.sessionID, req.SessionID)\n584\t\t}\n585\t\n586\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n587\t\n588\t\t// 若请求中未提供，则通过 trace 包自动检测\n589\t\tmachineID := req.MachineID\n590\t\tif machineID == \"\" {\n591\t\t\tmachineID = trace.MachineID()\n592\t\t}\n593\t\n594\t\tprojectSlug := req.ProjectSlug\n595\t\tif projectSlug == \"\" {\n596\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n597\t\t\tif projectSlug == \"\" {\n598\t\t\t\tprojectSlug = trace.DetectProjectName()\n599\t\t\t}\n600\t\t}\n601\t\n602\t\t// 创建会话专属的 Trace 写入器\n603\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n604\t\twriter, err := trace.NewTraceWriter(tracePath)\n605\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n606\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n607\t\tif err != nil {\n608\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n609\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n610\t\t\treturn\n611\t\t}\n612\t\n613\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n614\t\t\tif p.writer != nil {\n615\t\t\t\tp.writer.Close()\n616\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n617\t\t\t}\n618\t\tp.writer = writer\n619\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n620\t\n621\t\t// 通知外部注册 proxy.json\n622\t\tif p.OnSessionInit != nil {\n623\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n624\t\t}\n625\t\n626\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n627\t\tjson.NewEncoder(w).Encode(map[string]string{\n628\t\t\t\"status\":     \"ok\",\n629\t\t\t\"trace_path\": tracePath,\n630\t\t})\n631\t}\n632\t\n633\t// getWriter 返回当前会话的 Trace 写入器。\n634\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n635\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n636\t\treturn p.writer\n637\t}\n638\t\n639\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n640\t// 若无有效写入器，返回零值统计。\n641\tfunc (p *ReverseProxy) Summary() map[string]any {\n642\t\tif w := p.getWriter(); w != nil {\n643\t\t\treturn w.Summary()\n644\t\t}\n645\t\treturn map[string]any{\n646\t\t\t\"api_calls\":           0,\n647\t\t\t\"input_tokens\":        int64(0),\n648\t\t\t\"output_tokens\":       int64(0),\n649\t\t\t\"cache_read_tokens\":   int64(0),\n650\t\t\t\"cache_create_tokens\": int64(0),\n651\t\t}\n652\t}\n653\t\n654\t// SessionID 返回当前会话的 session_id。\n655\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n656\tfunc (p *ReverseProxy) SessionID() string {\n657\t\tif p.sessionID != \"\" {\n658\t\t\treturn p.sessionID\n659\t\t}\n660\t\tif w := p.getWriter(); w != nil {\n661\t\t\treturn w.SessionID()\n662\t\t}\n663\t\treturn \"\"\n664\t}\n665\t\n666\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n667\tfunc (p *ReverseProxy) ProjectSlug() string {\n668\t\treturn p.projectSlug\n669\t}\n670\t\n671\t// TracePath 返回当前追踪文件的完整路径。\n672\tfunc (p *ReverseProxy) TracePath() string {\n673\t\tif w := p.getWriter(); w != nil {\n674\t\t\treturn w.Path()\n675\t\t}\n676\t\treturn \"\"\n677\t}\n678\t\n679\t// doWithRetry 向上游发送请求，连接错误或 5xx 时进行重试。\n680\t// 如果 hasFallback 为 true（有兜底配置），不重试直接返回错误，由调用方切换兜底。\n681\t// 如果 hasFallback 为 false（无兜底配置），重试 maxUpstreamRetries 次，间隔 retryInterval。\n682\tfunc (p *ReverseProxy) doWithRetry(req *http.Request, turn int, hasFallback bool) (*http.Response, error) {\n683\t\tvar lastErr error\n684\t\tvar savedBody []byte\n685\t\n686\t\tmaxRetries := maxUpstreamRetries\n687\t\tif hasFallback {\n688\t\t\tmaxRetries = 0 // 有兜底时不重试，让 serveHTTP 立即切换\n689\t\t}\n690\t\n691\t\tfor attempt := 0; attempt <= maxRetries; attempt++ {\n692\t\t\tif attempt > 0 {\n693\t\t\t\tinterval := p.retryInterval\n694\t\t\t\tif interval == 0 {\n695\t\t\t\t\tinterval = retryInterval\n696\t\t\t\t}\n697\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] retry %d/%d after %v\", turn, attempt, maxUpstreamRetries, interval)\n698\t\t\t\ttime.Sleep(interval)\n699\t\t\t}\n700\t\n701\t\t\t// 第一次读取时保存 body，后续复用\n702\t\t\tif savedBody == nil && req.Body != nil {\n703\t\t\t\tsavedBody, _ = io.ReadAll(req.Body)\n704\t\t\t\treq.Body.Close()\n705\t\t\t}\n706\t\n707\t\t\tretryReq, err := http.NewRequest(req.Method, req.URL.String(), bytes.NewReader(savedBody))\n708\t\t\tif err != nil {\n709\t\t\t\treturn nil, err\n710\t\t\t}\n711\t\t\tretryReq.Header = req.Header.Clone()\n712\t\n713\t\t\tresp, err := p.client.Do(retryReq)\n714\t\t\tif err != nil {\n715\t\t\t\tlastErr = err\n716\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] attempt %d failed: %v\", turn, attempt+1, err)\n717\t\t\t\tif attempt < maxRetries {\n718\t\t\t\t\tcontinue\n719\t\t\t\t}\n720\t\t\t\treturn nil, fmt.Errorf(\"all %d retries exhausted: %w\", maxRetries, lastErr)\n721\t\t\t}\n722\t\n723\t\t\t// 5xx 错误触发重试，4xx 不重试；最后一次直接返回（让 serveHTTP 透传）\n724\t\t\tif resp.StatusCode >= 500 {\n725\t\t\t\tlastErr = fmt.Errorf(\"upstream returned %d\", resp.StatusCode)\n726\t\t\t\tif attempt < maxRetries {\n727\t\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] attempt %d: status %d, will retry\", turn, attempt+1, resp.StatusCode)\n728\t\t\t\t\tresp.Body.Close()\n729\t\t\t\t\tcontinue\n730\t\t\t\t}\n731\t\t\t\t// 最后一次尝试，直接返回响应（serveHTTP 会标记不可用并透传）\n732\t\t\t\treturn resp, nil\n733\t\t\t}\n734\t\n735\t\t\treturn resp, nil\n736\t\t}\n737\t\n738\t\treturn nil, fmt.Errorf(\"all %d retries exhausted: %w\", maxRetries, lastErr)\n739\t}\n740\t\n741\t// shouldFallback reports whether the HTTP status code should trigger fallback to the next profile.\n742\t// 401 (认证失败)、403 (访问被拒)、429 (频率超限)、5xx (服务器错误) 均触发降级。\n743\tfunc shouldFallback(statusCode int) bool {\n744\t\treturn statusCode == http.StatusUnauthorized ||\n745\t\t\tstatusCode == http.StatusForbidden ||\n746\t\t\tstatusCode == http.StatusTooManyRequests ||\n747\t\t\tstatusCode >= http.StatusInternalServerError\n748\t}\n749\t\n750\t// logProxyError 将友好中文提示输出到日志，同时返回 Anthropic API 格式的 JSON 错误响应。\n751\t// 必须返回 JSON 而非纯文本，否则 Claude Code 解析会崩溃。\n752\tfunc logProxyError(w http.ResponseWriter, turn int, lastErr error, lastStatusCode int) {\n753\t\tmsg := \"上游服务暂时不可用，请稍后重试\"\n754\t\tswitch {\n755\t\tcase lastStatusCode == http.StatusForbidden:\n756\t\t\tmsg = \"API 访问被拒绝 (403)，可能是认证信息过期或无权限，已尝试所有可用配置\"\n757\t\tcase lastStatusCode == http.StatusUnauthorized:\n758\t\t\tmsg = \"API 认证失败 (401)，请检查 API Key 或 Token 配置，已尝试所有可用配置\"\n759\t\tcase lastStatusCode == http.StatusTooManyRequests:\n760\t\t\tmsg = \"API 请求频率超限 (429)，所有配置均已限流，请稍后重试\"\n761\t\tcase lastErr != nil:\n762\t\t\tmsg = \"上游连接失败: \" + lastErr.Error()\n763\t\t}\n764\t\n765\t\tlogger.Error(\"proxy\", \"[Turn %d] %s\", turn, msg)\n766\t\n767\t\tstatusCode := lastStatusCode\n768\t\tif statusCode == 0 {\n769\t\t\tstatusCode = http.StatusBadGateway\n770\t\t}\n771\t\n772\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n773\t\tw.WriteHeader(statusCode)\n774\t\tjson.NewEncoder(w).Encode(map[string]any{\n775\t\t\t\"type\": \"error\",\n776\t\t\t\"error\": map[string]any{\n777\t\t\t\t\"type\":    \"api_error\",\n778\t\t\t\t\"message\": msg,\n779\t\t\t},\n780\t\t})\n781\t}\n782\t\n783\t// dispatchResponse extracts model/stream info from reqBody and dispatches to the appropriate handler.\n784\tfunc (p *ReverseProxy) dispatchResponse(w http.ResponseWriter, resp *http.Response, reqID string, turn int, r *http.Request, reqBody any, t0 time.Time) {\n785\t\tdurationMs := int(time.Since(t0).Milliseconds())\n786\t\n787\t\tmodel := \"\"\n788\t\tisStreaming := false\n789\t\tif m, ok := reqBody.(map[string]any); ok {\n790\t\t\tif v, ok := m[\"model\"].(string); ok {\n791\t\t\t\tmodel = v\n792\t\t\t}\n793\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n794\t\t\t\tisStreaming = s\n795\t\t\t}\n796\t\t}\n797\t\n798\t\tif isStreaming {\n799\t\t\tp.handleStreaming(w, resp, reqID, turn, durationMs, r, reqBody, t0, model)\n800\t\t} else {\n801\t\t\tp.handleNonStreaming(w, resp, reqID, turn, durationMs, r, reqBody, model)\n802\t\t}\n803\t}\n804\t\n805\t// markUnavailable 标记上游不可用（契约 4）。\n806\t// 首次失败后置 upstreamAvailable = false，进程生命周期内不再恢复。\n807\tfunc (p *ReverseProxy) markUnavailable() {\n808\t\tp.availableMu.Lock()\n809\t\tdefer p.availableMu.Unlock()\n810\t\tif p.upstreamAvailable {\n811\t\t\tp.upstreamAvailable = false\n812\t\t\tlogger.Warn(\"proxy\", \"upstream marked unavailable, switching to fallback\")\n813\t\t}\n814\t}\n815\t\n816\t// SetModel 设置强制替换的模型名。\n817\tfunc (p *ReverseProxy) SetModel(model string) {\n818\t\tp.model = model\n819\t}\n820\t\n821\t// SetFallbackConfigs 设置兜底配置列表，支持多 profile 轮询。\n822\tfunc (p *ReverseProxy) SetFallbackConfigs(cfgs []*FallbackConfig) {\n823\t\tp.availableMu.Lock()\n824\t\tdefer p.availableMu.Unlock()\n825\t\tp.fallbackConfigs = cfgs\n826\t\tp.fallbackIndex = 0\n827\t}\n828\t\n829\t// currentFallbackConfig 返回当前轮询的 fallback 配置。\n830\tfunc (p *ReverseProxy) currentFallbackConfig() *FallbackConfig {\n831\t\tif len(p.fallbackConfigs) == 0 {\n832\t\t\treturn nil\n833\t\t}\n834\t\tidx := p.fallbackIndex % len(p.fallbackConfigs)\n835\t\treturn p.fallbackConfigs[idx]\n836\t}\n837\t\n838\t// advanceFallback 切换到下一个 fallback 配置（轮询）。\n839\tfunc (p *ReverseProxy) advanceFallback() {\n840\t\tp.availableMu.Lock()\n841\t\tdefer p.availableMu.Unlock()\n842\t\tp.fallbackIndex++\n843\t\tlogger.Info(\"proxy\", \"fallback advanced to index %d\", p.fallbackIndex)\n844\t}\n845\t\n846\t// SetKimiMode 启用或禁用 kimi 模式。\n847\t// 启用时会自动创建 reasoning_content 缓存。\n848\tfunc (p *ReverseProxy) SetKimiMode(kimi bool) {\n849\t\tp.kimiMode = kimi\n850\t\tif kimi && p.reasoningCache == nil {\n851\t\t\tp.reasoningCache = NewReasoningCache()\n852\t\t\tlogger.Info(\"proxy\", \"reasoning_content mode enabled (kimi/deepseek), caching active\")\n853\t\t}\n854\t}\n855\t\n856\t// reasoningPrefixes 定义需要 reasoning_content 注入的上游 URL 前缀（scheme + host）。\n857\tvar reasoningPrefixes = []string{\n858\t\t\"https://api.kimi.com\",\n859\t\t\"https://api.moonshot.cn\",\n860\t\t\"https://api.deepseek.com\",\n861\t}\n862\t\n863\t// IsKimiURL 判断 URL 是否为需要 reasoning_content 注入的上游（kimi/moonshot/deepseek）。\n864\t// 基于 URL 前缀匹配，避免子串误判。\n865\tfunc IsKimiURL(url string) bool {\n866\t\tlower := strings.ToLower(url)\n867\t\tfor _, prefix := range reasoningPrefixes {\n868\t\t\tif strings.HasPrefix(lower, prefix) {\n869\t\t\t\treturn true\n870\t\t\t}\n871\t\t}\n872\t\treturn false\n873\t}\n874\t\n875\t// cacheFromResponse 从 API 响应快照中提取 reasoning_content 并存入缓存。\n876\t//\n877\t// 同时处理两种响应格式：\n878\t//   - OpenAI Chat Completions: snap[\"choices\"][0][\"message\"] 包含 reasoning_content/content/tool_calls\n879\t//   - Anthropic: snap[\"content\"] 包含 thinking 块和 tool_use 块\n880\t//\n881\t// 仅在 kimi 模式下调用。\n882\tfunc (p *ReverseProxy) cacheFromResponse(snap map[string]any) {\n883\t\tif p.reasoningCache == nil || snap == nil {\n884\t\t\treturn\n885\t\t}\n886\t\n887\t\t// 提取 reasoning_content 和消息内容\n888\t\tvar reasoningContent string\n889\t\tvar msgContent string    // 文本内容（用于 full key）\n890\t\tvar toolCallsJSON string // tool_calls JSON（用于 tc key 和 full key）\n891\t\n892\t\t// 路径 1: OpenAI Chat Completions 格式\n893\t\tchoices, _ := snap[\"choices\"].([]any)\n894\t\tif len(choices) > 0 {\n895\t\t\tchoice, _ := choices[0].(map[string]any)\n896\t\t\tif choice != nil {\n897\t\t\t\tmsg, _ := choice[\"message\"].(map[string]any)\n898\t\t\t\tif msg != nil {\n899\t\t\t\t\treasoningContent, _ = msg[\"reasoning_content\"].(string)\n900\t\t\t\t\tmsgContent, _ = msg[\"content\"].(string)\n901\t\t\t\t\tif tc, ok := msg[\"tool_calls\"]; ok && tc != nil {\n902\t\t\t\t\t\tif tcBytes, err := json.Marshal(tc); err == nil {\n903\t\t\t\t\t\t\ttoolCallsJSON = string(tcBytes)\n904\t\t\t\t\t\t}\n905\t\t\t\t\t}\n906\t\t\t\t}\n907\t\t\t}\n908\t\t}\n909\t\n910\t\t// 路径 2: Anthropic 格式（从 content 数组中的 thinking 块提取）\n911\t\tif reasoningContent == \"\" {\n912\t\t\tcontentArr, _ := snap[\"content\"].([]any)\n913\t\t\tfor _, blockRaw := range contentArr {\n914\t\t\t\tblock, ok := blockRaw.(map[string]any)\n915\t\t\t\tif !ok {\n916\t\t\t\t\tcontinue\n917\t\t\t\t}\n918\t\t\t\tif blockType, _ := block[\"type\"].(string); blockType == \"thinking\" {\n919\t\t\t\t\tif thinking, ok := block[\"thinking\"].(string); ok && thinking != \"\" {\n920\t\t\t\t\t\treasoningContent = thinking\n921\t\t\t\t\t\tbreak\n922\t\t\t\t\t}\n923\t\t\t\t}\n924\t\t\t}\n925\t\t\t// 同时从 Anthropic 格式提取 tool_use 块用于 key 计算\n926\t\t\tif toolCallsJSON == \"\" {\n927\t\t\t\tvar toolUseBlocks []any\n928\t\t\t\tfor _, blockRaw := range contentArr {\n929\t\t\t\t\tblock, ok := blockRaw.(map[string]any)\n930\t\t\t\t\tif !ok {\n931\t\t\t\t\t\tcontinue\n932\t\t\t\t\t}\n933\t\t\t\t\tif blockType, _ := block[\"type\"].(string); blockType == \"tool_use\" {\n934\t\t\t\t\t\ttoolUseBlocks = append(toolUseBlocks, block)\n935\t\t\t\t\t}\n936\t\t\t\t}\n937\t\t\t\tif len(toolUseBlocks) > 0 {\n938\t\t\t\t\tif tcBytes, err := json.Marshal(toolUseBlocks); err == nil {\n939\t\t\t\t\t\ttoolCallsJSON = string(tcBytes)\n940\t\t\t\t\t}\n941\t\t\t\t}\n942\t\t\t}\n943\t\t}\n944\t\n945\t\tif reasoningContent == \"\" {\n946\t\t\treturn // 无 reasoning_content 可缓存\n947\t\t}\n948\t\n949\t\tfullKey := MakeFullKey(msgContent, toolCallsJSON)\n950\t\ttcKey := MakeToolcallKey(toolCallsJSON)\n951\t\tp.reasoningCache.Store(fullKey, tcKey, reasoningContent)\n952\t\n953\t\tf, t := p.reasoningCache.Len()\n954\t\tlogger.Debug(\"proxy\", \"cached reasoning_content: rc_len=%d full=%d tc=%d\", len(reasoningContent), f, t)\n955\t}\n956\t\n957\t// rewriteModel 改写请求体 JSON 中的 model 字段（契约 3）。\n958\t// 如果 model 为空、body 为空、body 非 JSON 或 body 为 JSON 非对象，原样返回。\n959\tfunc rewriteModel(body []byte, parsed any, model string) []byte {\n960\t\tif model == \"\" || len(body) == 0 {\n961\t\t\treturn body\n962\t\t}\n963\t\n964\t\tm, ok := parsed.(map[string]any)\n965\t\tif !ok {\n966\t\t\treturn body // 非 JSON 或非对象\n967\t\t}\n968\t\n969\t\tm[\"model\"] = model\n970\t\trewritten, err := json.Marshal(m)\n971\t\tif err != nil {\n972\t\t\treturn body // 改写失败，原样返回\n973\t\t}\n974\t\treturn rewritten\n975\t}\n976\t\n977\t// injectReasoningContentCached 为 assistant tool_call 消息注入 reasoning_content 补丁。\n978\t//\n979\t// Kimi 等兼容 Anthropic 的端点要求：assistant tool_call 消息必须携带顶层字段 reasoning_content，\n980\t// 以及 content 数组中的 thinking 块。Claude Code 发送 tool_call 消息时不包含这些字段，导致上游 400 错误：\n981\t//\n982\t//\t400 thinking is enabled but reasoning_content is missing in assistant tool call message at index N\n983\t//\n984\t// 行为随 isKimi 参数变化：\n985\t//   - isKimi=false: 不做任何修改，直接透传\n986\t//   - isKimi=true + cache!=nil: 使用缓存的三级查找回填真实 reasoning_content\n987\t//   - isKimi=true + cache==nil: 注入空字符串（兜底行为，空字符串无害但能防止报错）\n988\tfunc injectReasoningContentCached(body []byte, parsed any, cache *ReasoningCache, isKimi bool) []byte {\n989\t\tif !isKimi {\n990\t\t\treturn body // 非 kimi 上游不做任何注入\n991\t\t}\n992\t\n993\t\tif len(body) == 0 {\n994\t\t\treturn body\n995\t\t}\n996\t\n997\t\tm, ok := parsed.(map[string]any)\n998\t\tif !ok {\n999\t\t\treturn body // 非 JSON 或非对象\n1000\t\t}\n1001\t\n1002\t\t// 获取 messages 数组（无 messages 则无需处理）\n1003\t\tmessages, ok := m[\"messages\"].([]any)\n1004\t\tif !ok || len(messages) == 0 {\n1005\t\t\treturn body\n1006\t\t}\n1007\t\n1008\t\tmodified := false\n1009\t\tfor i, msgRaw := range messages {\n1010\t\t\tmsg, ok := msgRaw.(map[string]any)\n1011\t\t\tif !ok {\n1012\t\t\t\tcontinue\n1013\t\t\t}\n1014\t\n1015\t\t\t// 只处理 assistant 消息\n1016\t\t\trole, _ := msg[\"role\"].(string)\n1017\t\t\tif role != \"assistant\" {\n1018\t\t\t\tcontinue\n1019\t\t\t}\n1020\t\n1021\t\t\t// 检查 content 是否为数组\n1022\t\t\tcontent, ok := msg[\"content\"].([]any)\n1023\t\t\tif !ok || len(content) == 0 {\n1024\t\t\t\tcontinue\n1025\t\t\t}\n1026\t\n1027\t\t\t// 检查是否有 tool_use 块、thinking 块、reasoning_content 字段\n1028\t\t\thasToolUse := false\n1029\t\t\thasThinking := false\n1030\t\t\tfor _, blockRaw := range content {\n1031\t\t\t\tblock, ok := blockRaw.(map[string]any)\n1032\t\t\t\tif !ok {\n1033\t\t\t\t\tcontinue\n1034\t\t\t\t}\n1035\t\t\t\tblockType, _ := block[\"type\"].(string)\n1036\t\t\t\tif blockType == \"tool_use\" {\n1037\t\t\t\t\thasToolUse = true\n1038\t\t\t\t}\n1039\t\t\t\tif blockType == \"thinking\" {\n1040\t\t\t\t\thasThinking = true\n1041\t\t\t\t}\n1042\t\t\t}\n1043\t\n1044\t\t\t// 检查已有的 reasoning_content\n1045\t\t\texistingRC, hasReasoningContent := msg[\"reasoning_content\"].(string)\n1046\t\n1047\t\t\t// 只处理含 tool_use 的 assistant 消息\n1048\t\t\tif !hasToolUse {\n1049\t\t\t\tcontinue\n1050\t\t\t}\n1051\t\n1052\t\t\tneedPatch := false\n1053\t\n1054\t\t\t// 如果已有非空的 reasoning_content，用它刷新缓存\n1055\t\t\tif hasReasoningContent && existingRC != \"\" && cache != nil {\n1056\t\t\t\tfullKey := MakeFullKeyFromMsg(msg)\n1057\t\t\t\ttcKey := MakeToolcallKeyFromMsg(msg)\n1058\t\t\t\tcache.Store(fullKey, tcKey, existingRC)\n1059\t\t\t\t// 已有完整 reasoning_content，不需要补丁\n1060\t\t\t\t// 但仍需确保 thinking 块存在\n1061\t\t\t}\n1062\t\n1063\t\t\t// 补丁 1: content 数组缺少 thinking 块 → 在开头插入\n1064\t\t\tif !hasThinking {\n1065\t\t\t\tthinkingBlock := map[string]any{\n1066\t\t\t\t\t\"type\":     \"thinking\",\n1067\t\t\t\t\t\"thinking\": \"\",\n1068\t\t\t\t}\n1069\t\t\t\tnewContent := make([]any, 0, len(content)+1)\n1070\t\t\t\tnewContent = append(newContent, thinkingBlock)\n1071\t\t\t\tnewContent = append(newContent, content...)\n1072\t\t\t\tmsg[\"content\"] = newContent\n1073\t\t\t\tneedPatch = true\n1074\t\t\t}\n1075\t\n1076\t\t\t// 补丁 2: 消息缺少顶层 reasoning_content 字段 → 尝试从缓存回填\n1077\t\t\tif !hasReasoningContent {\n1078\t\t\t\trcValue := \"\" // 兜底空字符串\n1079\t\t\t\tif cache != nil {\n1080\t\t\t\t\tfullKey := MakeFullKeyFromMsg(msg)\n1081\t\t\t\t\ttcKey := MakeToolcallKeyFromMsg(msg)\n1082\t\t\t\t\tif cached, found := cache.Lookup(fullKey, tcKey, true); found {\n1083\t\t\t\t\t\trcValue = cached\n1084\t\t\t\t\t}\n1085\t\t\t\t}\n1086\t\t\t\tmsg[\"reasoning_content\"] = rcValue\n1087\t\t\t\tneedPatch = true\n1088\t\t\t}\n1089\t\n1090\t\t\tif needPatch {\n1091\t\t\t\tmessages[i] = msg\n1092\t\t\t\tmodified = true\n1093\t\t\t}\n1094\t\t}\n1095\t\n1096\t\tif !modified {\n1097\t\t\treturn body\n1098\t\t}\n1099\t\n1100\t\tm[\"messages\"] = messages\n1101\t\trewritten, err := json.Marshal(m)\n1102\t\tif err != nil {\n1103\t\t\treturn body\n1104\t\t}\n1105\t\treturn rewritten\n1106\t}\n1107\t"}]}
