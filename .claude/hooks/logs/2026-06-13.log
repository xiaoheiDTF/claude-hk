sponse":"1\t// Package service 提供后端业务逻辑层。\n2\tpackage service\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"time\"\n10\t\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n12\t)\n13\t\n14\t// proxySession 用于反序列化 proxy.json 中的会话条目。\n15\ttype proxySession struct {\n16\t\tStartedAt string `json:\"started_at\"`\n17\t}\n18\t\n19\t// IdleWatchdog 监控 proxy.json，当所有会话注销且持续空闲超过指定时间后，\n20\t// 调用 shutdown 回调触发后端优雅关闭。\n21\ttype IdleWatchdog struct {\n22\t\tinterval    time.Duration // 检查间隔\n23\t\tidleTimeout time.Duration // 空闲超时（超过此时间无会话则关闭）\n24\t\tshutdown    func()        // 触发服务器关闭的回调\n25\t}\n26\t\n27\t// NewIdleWatchdog 创建空闲监控器。\n28\t//   - interval: 检查间隔（建议 30s）\n29\t//   - idleTimeout: 空闲超时（建议 10min）\n30\t//   - shutdown: 触发关闭的回调函数\n31\tfunc NewIdleWatchdog(interval, idleTimeout time.Duration, shutdown func()) *IdleWatchdog {\n32\t\treturn &IdleWatchdog{\n33\t\t\tinterval:    interval,\n34\t\t\tidleTimeout: idleTimeout,\n35\t\t\tshutdown:    shutdown,\n36\t\t}\n37\t}\n38\t\n39\t// Run 启动监控循环，直到 context 被取消或触发关闭。\n40\tfunc (w *IdleWatchdog) Run(ctx context.Context) {\n41\t\tlogger.Info(\"watchdog\", \"started: interval=%v idle_timeout=%v\", w.interval, w.idleTimeout)\n42\t\n43\t\tidleStart := time.Time{} // 记录首次检测到空闲的时间\n44\t\n45\t\tticker := time.NewTicker(w.interval)\n46\t\tdefer ticker.Stop()\n47\t\n48\t\tfor {\n49\t\t\tselect {\n50\t\t\tcase <-ctx.Done():\n51\t\t\t\tlogger.Info(\"watchdog\", \"stopped\")\n52\t\t\t\treturn\n53\t\t\tcase <-ticker.C:\n54\t\t\t\tsessionCount := countProxySessions()\n55\t\t\t\tif sessionCount > 0 {\n56\t\t\t\t\t// 有活跃会话，重置空闲计时\n57\t\t\t\t\tif !idleStart.IsZero() {\n58\t\t\t\t\t\tlogger.Info(\"watchdog\", \"sessions active (%d), resetting idle timer\", sessionCount)\n59\t\t\t\t\t}\n60\t\t\t\t\tidleStart = time.Time{}\n61\t\t\t\t} else {\n62\t\t\t\t\t// 无活跃会话\n63\t\t\t\t\tif idleStart.IsZero() {\n64\t\t\t\t\t\t// 首次检测到空闲\n65\t\t\t\t\t\tidleStart = time.Now()\n66\t\t\t\t\t\tlogger.Info(\"watchdog\", \"no sessions, idle timer started\")\n67\t\t\t\t\t} else if time.Since(idleStart) >= w.idleTimeout {\n68\t\t\t\t\t\t// 空闲超时，触发关闭\n69\t\t\t\t\t\tlogger.Info(\"watchdog\", \"idle timeout (%v) reached, shutting down\", w.idleTimeout)\n70\t\t\t\t\t\tw.shutdown()\n71\t\t\t\t\t\treturn\n72\t\t\t\t\t} else {\n73\t\t\t\t\t\tlogger.Debug(\"watchdog\", \"idle for %v, shutdown in %v\",\n74\t\t\t\t\t\t\ttime.Since(idleStart).Round(time.Second),\n75\t\t\t\t\t\t\tw.idleTimeout-time.Since(idleStart))\n76\t\t\t\t\t}\n77\t\t\t\t}\n78\t\t\t}\n79\t\t}\n80\t}\n81\t\n82\t// proxyJSONPath 返回 proxy.json 的路径（~/.claude-tap-plus/proxy.json）。\n83\tfunc proxyJSONPath() string {\n84\t\thome, err := os.UserHomeDir()\n85\t\tif err != nil {\n86\t\t\treturn \".claude-tap-plus/proxy.json\"\n87\t\t}\n88\t\treturn filepath.Join(home, \".claude-tap-plus\", \"proxy.json\")\n89\t}\n90\t\n91\t// countProxySessions 读取 proxy.json 并返回活跃会话数量。\n92\tfunc countProxySessions() int {\n93\t\tdata, err := os.ReadFile(proxyJSONPath())\n94\t\tif err != nil {\n95\t\t\treturn 0 // 文件不存在或读不出 → 视为无会话\n96\t\t}\n97\t\tvar sessions map[string]proxySession\n98\t\tif json.Unmarshal(data, &sessions) != nil {\n99\t\t\treturn 0\n100\t\t}"}]}
