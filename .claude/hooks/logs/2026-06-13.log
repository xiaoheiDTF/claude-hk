[2026-06-13 18:19:15] [INFO] [PreToolUse] Input: {"session_id":"32d40bdf-3481-40af-a99d-16267c06647a","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\32d40bdf-3481-40af-a99d-16267c06647a.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"default","effort":{"level":"medium"},"hook_event_name":"PreToolUse","tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\issue_handler.go"},"tool_use_id":"call_195497ad41214a27a39ec20e"}
