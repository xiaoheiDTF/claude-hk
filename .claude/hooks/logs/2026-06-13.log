s 遍历 ~/.claude/projects/ 下的所有项目目录，逐个收集会话。\n44\tfunc pushAllProjects(baseDir string, opts PushOptions) ([]PushResult, error) {\n45\t\tprojectsDir := ClaudeProjectsDir()\n46\t\tlogger.Debug(\"session\", \"scanning projects dir: %s\", projectsDir)\n47\t\tentries, err := os.ReadDir(projectsDir)\n48\t\tif err != nil {\n49\t\t\treturn nil, fmt.Errorf(\"read projects dir: %w\", err)\n50\t\t}\n51\t\n52\t\tvar results []PushResult\n53\t\tfor _, entry := range entries {\n54\t\t\tif !entry.IsDir() {\n55\t\t\t\tcontinue\n56\t\t\t}\n57\t\t\tslug := entry.Name()\n58\t\t\tresult, err := collectProject(baseDir, slug, filepath.Join(projectsDir, slug), opts)\n59\t\t\tif err != nil {\n60\t\t\t\tfmt.Printf(\"  ⚠ %s: %v\\n\", slug, err)\n61\t\t\t\tcontinue\n62\t\t\t}\n63\t\t\tresults = append(results, result)\n64\t\t}\n65\t\treturn results, nil\n66\t}\n67\t\n68\t// pushSingleProject 仅收集当前工作目录对应项目的会话。\n69\t// 首先检测当前目录的 slug，然后收集该 slug 对应的 Claude 会话文件。\n70\tfunc pushSingleProject(baseDir string, opts PushOptions) ([]PushResult, error) {\n71\t\tslug, _ := DetectLocalSlug()\n72\t\tproject := opts.Project\n73\t\tif project == \"\" {\n74\t\t\tproject = trace.DetectProjectName()\n75\t\t}\n76\t\n77\t\tclaudeDir := filepath.Join(ClaudeProjectsDir(), slug)\n78\t\tlogger.Debug(\"session\", \"push: project=%s slug=%s claude_dir=%s\", project, slug, claudeDir)\n79\t\n80\t\tif _, err := os.Stat(claudeDir); os.IsNotExist(err) {\n81\t\t\treturn nil, fmt.Errorf(\"no Claude session directory found for slug %q\", slug)\n82\t\t}\n83\t\n84\t\tfmt.Printf(\"Project: %s | Slug: %s | Claude dir: %s\\n\", project, slug, claudeDir)\n85\t\n86\t\tresult, err := collectProject(baseDir, slug, claudeDir, opts)\n87\t\tif err != nil {\n88\t\t\treturn nil, err\n89\t\t}\n90\t\n91\t\treturn []PushResult{result}, nil\n92\t}\n93\t\n94\t// collectProject 收集指定 slug 项目的会话文件。\n95\t// 流程：加载已有元数据 -> 扫描 Claude 目录中的 .jsonl 会话文件 ->\n96\t// 解析文件元信息 -> 复制新文件或强制覆盖 -> 更新 meta.json。\n97\tfunc collectProject(baseDir, slug, claudeDir string, opts PushOptions) (PushResult, error) {\n98\t\tsessionDir := SessionDir(baseDir, slug)\n99\t\tlogger.Debug(\"session\", \"collect: slug=%s dir=%s\", slug, sessionDir)\n100\t\n101\t\t// 加载已存在的会话元数据。\n102\t\tmeta, err := LoadMeta(sessionDir)\n103\t\tif err != nil {\n104\t\t\treturn PushResult{}, err\n105\t\t}\n106\t\n107\t\t// 在 Claude 的项目目录中查找所有会话 JSONL 文件。\n108\t\tfiles, err := FindSessionJSONLFiles(claudeDir)\n109\t\tif err != nil {\n110\t\t\treturn PushResult{}, fmt.Errorf(\"scan sessions: %w\", err)\n111\t\t}\n112\t\n113\t\t// 构建已收集会话 ID 的集合，用于快速判断哪些会话已存在。\n114\t\texisting := make(map[string]bool)\n115\t\tfor _, s := range meta.Sessions {\n116\t\t\texisting[s.SessionID] = true\n117\t\t}\n118\t\n119\t\tproject := slugToProjectName(slug)\n120\t\n121\t\tvar result PushResult\n122\t\tresult.Project = project\n123\t\n124\t\tfor _, file := range files {\n125\t\t\tsessionID := strings.TrimSuffix(filepath.Base(file), \".jsonl\")\n126\t\t\tlogger.Debug(\"session\", \"session file: %s size=%d\", filepath.Base(file), fileStatSize(file))\n127\t\n128\t\t\t// 如果会话已存在且未强制覆盖，则跳过。\n129\t\t\tif existing[sessionID] && !opts.Force {\n130\t\t\t\tresult.SessionsSkipped++\n131\t\t\t\tif opts.DryRun {\n132\t\t\t\t\tfmt.Printf(\"  [skip] %s (already collected)\\n\", filepath.Base(file))\n133\t\t\t\t}\n134\t\t\t\tcontinue\n135\t\t\t}\n136\t\n137\t\t\t// 解析会话 JSONL 文件，提取元信息。\n138\t\t\tentry, err := ParseSessionJSONL(file, slug)\n139\t\t\tif err != nil {\n140\t\t\t\tfmt.Printf(\"  ⚠ parse %s: %v\\n\", filepath.Base(file), err)\n141\t\t\t\tcontinue\n142\t\t\t}\n143\t\n144\t\t\t// 仅预览模式：只输出信息，不执行实际复制。\n145\t\t\tif opts.DryRun {\n146\t\t\t\tfmt.Printf(\"  [would copy] %s (%d records, %s)\\n\",\n147\t\t\t\t\tentry.File, entry.RecordCount, formatSize(entry.FileSize))\n148\t\t\t\tresult.SessionsNew++\n149\t\t\t\tresult.BytesCopied += entry.FileSize\n150\t\t\t\tcontinue\n151\t\t\t}\n152\t\n153\t\t\t// 将会话文件复制到本地存储目录。\n154\t\t\tdst := filepath.Join(sessionDir, entry.File)\n155\t\t\tif err := copyFile(dst, file); err != nil {\n156\t\t\t\tfmt.Printf(\"  ⚠ copy %s: %v\\n\", entry.File, err)\n157\t\t\t\tcontinue\n158\t\t\t}\n159\t\t\tlogger.Info(\"session\", \"copied: %s (%d bytes)\", entry.File, entry.FileSize)\n160\t\n161\t\t\t// 更新或新增会话条目到元数据中。\n162\t\t\tif existing[sessionID] {\n163\t\t\t\tfor i, s := range meta.Sessions {\n164\t\t\t\t\tif s.SessionID == sessionID {\n165\t\t\t\t\t\tmeta.Sessions[i] = *entry\n166\t\t\t\t\t\tbreak\n167\t\t\t\t\t}\n168\t\t\t\t}\n169\t\t\t} else {\n170\t\t\t\tmeta.Sessions = append(meta.Sessions, *entry)\n171\t\t\t}\n172\t\n173\t\t\tresult.SessionsNew++\n174\t\t\tresult.BytesCopied += entry.FileSize\n175\t\t\tfmt.Printf(\"  ✓ %s (%d records, %s)\\n\", entry.File, entry.RecordCount, formatSize(entry.FileSize))\n176\t\n177\t\t\t// 如果存在 subagents 子目录，一并复制。\n178\t\t\tsubagentsDir := filepath.Join(claudeDir, sessionID, \"subagents\")\n179\t\t\tif info, err := os.Stat(subagentsDir); err == nil && info.IsDir() {\n180\t\t\t\tdstSubagents := filepath.Join(sessionDir, sessionID, \"subagents\")\n181\t\t\t\tif err := copyDir(dstSubagents, subagentsDir); err == nil {\n182\t\t\t\t\tfmt.Printf(\"    ✓ subagents/ copied\\n\")\n183\t\t\t\t}\n184\t\t\t}\n185\t\t}\n186\t\n187\t\t// 更新项目的元信息。\n188\t\tmeta.Project = project\n189\t\tmeta.LocalSlug = slug\n190\t\tmeta.GitRemote = gitRemoteURL()\n191\t\tif cwd, err := os.Getwd(); err == nil {\n192\t\t\tmeta.LocalCwd = cwd\n193\t\t}\n194\t\n195\t\t// 非预览模式下保存更新后的元数据。\n196\t\tif !opts.DryRun {\n197\t\t\tif err := SaveMeta(sessionDir, meta); err != nil {\n198\t\t\t\treturn result, fmt.Errorf(\"save meta.json: %w\", err)\n199\t\t\t}\n200\t\t\tlogger.Debug(\"session\", \"meta.json updated: %d sessions\", len(meta.Sessions))\n201\t\t}\n202\t\n203\t\treturn result, nil\n204\t}\n205\t\n206\t// fileStatSize 返回指定路径的文件大小，出错时返回 0。\n207\tfunc fileStatSize(path string) int64 {\n208\t\tif fi, err := os.Stat(path); err == nil {\n209\t\t\treturn fi.Size()\n210\t\t}\n211\t\treturn 0\n212\t}\n213\t\n214\t// slugToProjectName 尝试从 slug 中提取项目名称。\n215\t// 例如：\"D--development-code-claude-tap\" → \"claude-tap\"\n216\tfunc slugToProjectName(slug string) string {\n217\t\t// 尝试找到最后一段有意义的片段。\n218\t\t// 常见模式：\n219\t\t//   D--development-code-claude-tap → claude-tap\n220\t\t//   -home-user-projects-myapp → myapp\n221\t\tparts := strings.Split(slug, \"-\")\n222\t\tif len(parts) <= 1 {\n223\t\t\treturn slug\n224\t\t}\n225\t\t// 启发式规则：取最后 1-2 段作为项目名称。\n226\t\t// 跳过驱动器盘符或空的首段。\n227\t\tstart := 0\n228\t\tif parts[0] == \"\" {\n229\t\t\tstart = 1 // 以 \"-\" 开头（Unix 路径）\n230\t\t}\n231\t\tif len(parts)-start <= 2 {\n232\t\t\treturn strings.Join(parts[start:], \"-\")\n233\t\t}\n234\t\t// 取最后 2 段作为项目名称猜测。\n235\t\treturn strings.Join(parts[len(parts)-2:], \"-\")\n236\t}\n237\t\n238\t// gitRemoteURL 获取当前工作目录对应的 Git 远程 origin URL。\n239\tfunc gitRemoteURL() string {\n240\t\tcwd, _ := os.Getwd()\n241\t\tif cwd == \"\" {\n242\t\t\treturn \"\"\n243\t\t}\n244\t\tconfigPath := filepath.Join(cwd, \".git\", \"config\")\n245\t\tdata, err := os.ReadFile(configPath)\n246\t\tif err != nil {\n247\t\t\treturn \"\"\n248\t\t}\n249\t\tcontent := string(data)\n250\t\tlines := strings.Split(content, \"\\n\")\n251\t\tinOrigin := false\n252\t\tfor _, line := range lines {\n253\t\t\ttrimmed := strings.TrimSpace(line)\n254\t\t\tif trimmed == `[remote \"origin\"]` {\n255\t\t\t\tinOrigin = true\n256\t\t\t\tcontinue\n257\t\t\t}\n258\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"url = \") {\n259\t\t\t\treturn strings.TrimPrefix(trimmed, \"url = \")\n260\t\t\t}\n261\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"[\") {\n262\t\t\t\tbreak\n263\t\t\t}\n264\t\t}\n265\t\treturn \"\"\n266\t}\n267\t\n268\t// formatSize 将字节数格式化为人类可读的字符串（如 KB、MB）。\n269\tfunc formatSize(bytes int64) string {\n270\t\tconst (\n271\t\t\tKB = 1024\n272\t\t\tMB = 1024 * KB\n273\t\t)\n274\t\tswitch {\n275\t\tcase bytes >= MB:\n276\t\t\treturn fmt.Sprintf(\"%.1fMB\", float64(bytes)/float64(MB))\n277\t\tcase bytes >= KB:\n278\t\t\treturn fmt.Sprintf(\"%.1fKB\", float64(bytes)/float64(KB))\n279\t\tdefault:\n280\t\t\treturn fmt.Sprintf(\"%dB\", bytes)\n281\t\t}\n282\t}\n283\t\n284\t// copyDir 递归复制整个目录。\n285\tfunc copyDir(dst, src string) error {\n286\t\treturn filepath.Walk(src, func(path string, info os.FileInfo, err error) error {\n287\t\t\tif err != nil {\n288\t\t\t\treturn err\n289\t\t\t}\n290\t\t\trel, _ := filepath.Rel(src, path)\n291\t\t\tdstPath := filepath.Join(dst, rel)\n292\t\n293\t\t\tif info.IsDir() {\n294\t\t\t\treturn os.MkdirAll(dstPath, 0o755)\n295\t\t\t}\n296\t\t\treturn copyFile(dstPath, path)\n297\t\t})\n298\t}\n299\t"}]}
