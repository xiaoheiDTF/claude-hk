rvice\n3\t\n4\timport (\n5\t\t\"bufio\"\n6\t\t\"context\"\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"regexp\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n15\t)\n16\t\n17\t// LogEntry 表示解析后的日志条目。\n18\ttype LogEntry struct {\n19\t\tTimestamp string // 完整时间戳，如 \"2026-06-01 20:56:28.000\"\n20\t\tLevel     string // 日志级别：DEBUG/INFO/WARN/ERROR\n21\t\tSource    string // 来源模块\n22\t\tMessage   string // 日志内容\n23\t}\n24\t\n25\t// LogService 提供日志查询功能，读取 logger.go 生成的日志文件。\n26\ttype LogService struct {\n27\t\tlogDir string // 日志文件存放目录\n28\t}\n29\t\n30\t// NewLogService 创建日志查询服务实例。\n31\tfunc NewLogService(logDir string) *LogService {\n32\t\treturn &LogService{logDir: logDir}\n33\t}\n34\t\n35\t// QueryLogs 查询日志，支持按级别过滤、按日期选择、限制返回条数。\n36\tfunc (svc *LogService) QueryLogs(_ context.Context, level, date string, limit int) ([]LogEntry, error) {\n37\t\tlogger.Debug(\"svc.log\", \"QueryLogs: level=%s date=%s limit=%d\", level, date, limit)\n38\t\n39\t\tif limit <= 0 {\n40\t\t\tlimit = 100\n41\t\t}\n42\t\n43\t\t// 确定日志文件日期\n44\t\tlogDate := date\n45\t\tif logDate == \"\" {\n46\t\t\tlogDate = time.Now().Format(\"2006-01-02\")\n47\t\t}\n48\t\n49\t\tlogFile := filepath.Join(svc.logDir, logDate+\".log\")\n50\t\n51\t\t// 文件不存在则返回空数组\n52\t\tif _, err := os.Stat(logFile); os.IsNotExist(err) {\n53\t\t\treturn []LogEntry{}, nil\n54\t\t}\n55\t\n56\t\tentries, err := svc.parseLogFile(logFile, logDate, level, limit)\n57\t\tif err != nil {\n58\t\t\treturn nil, fmt.Errorf(\"parse log file: %w\", err)\n59\t\t}\n60\t\n61\t\treturn entries, nil\n62\t}\n63\t\n64\t// logPattern 匹配 logger.go 的日志行格式：\n65\t//\n66\t//\t15:04:05.000 [LEVEL] module: message\n67\t//\n68\t// 例如：20:56:28.000 [INFO ] backend.cmd: backend starting: host=127.0.0.1\n69\tvar logPattern = regexp.MustCompile(`^(\\d{2}:\\d{2}:\\d{2}\\.\\d{3}) \\[([^\\]]+)\\]\\s*(\\S+): (.*)$`)\n70\t\n71\t// parseLogFile 逐行解析日志文件，按级别过滤并限制条数。\n72\tfunc (svc *LogService) parseLogFile(path, logDate, levelFilter string, limit int) ([]LogEntry, error) {\n73\t\tfile, err := os.Open(path)\n74\t\tif err != nil {\n75\t\t\treturn nil, err\n76\t\t}\n77\t\tdefer file.Close()\n78\t\n79\t\tvar entries []LogEntry\n80\t\tscanner := bufio.NewScanner(file)\n81\t\n82\t\tfor scanner.Scan() && len(entries) < limit {\n83\t\t\tline := scanner.Text()\n84\t\t\tmatches := logPattern.FindStringSubmatch(line)\n85\t\t\tif len(matches) != 5 {\n86\t\t\t\tcontinue\n87\t\t\t}\n88\t\n89\t\t\tentry := LogEntry{\n90\t\t\t\tTimestamp: logDate + \" \" + matches[1], // 补全日期\n91\t\t\t\tLevel:     strings.TrimSpace(matches[2]),\n92\t\t\t\tSource:    matches[3],\n93\t\t\t\tMessage:   matches[4],\n94\t\t\t}\n95\t\n96\t\t\t// 级别过滤（大小写不敏感）\n97\t\t\tif levelFilter != \"\" && !strings.EqualFold(entry.Level, levelFilter) {\n98\t\t\t\tcontinue\n99\t\t\t}\n100\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/service/status_service.go","limit":100},"tool_use_id":"call_a9970c2858ff4ec2a1126050","tool_response":"1\t// Package service 提供后端业务逻辑层。\n2\tpackage service\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"fmt\"\n7\t\t\"time\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n11\t)\n12\t\n13\t// SystemStats 是系统统计信息。\n14\ttype SystemStats struct {\n15\t\tActiveSessions int64 // 活跃会话数\n16\t\tActiveProxies  int64 // 活跃代理数\n17\t\tPendingIssues  int64 // 待处理 Issue 数\n18\t\tTotalMachines  int64 // 机器总数\n19\t\tTotalProjects  int64 // 项目总数\n20\t}\n21\t\n22\t// SystemStatus 表示系统整体状态。\n23\ttype SystemStatus struct {\n24\t\tStatus        string       // 系统状态：healthy\n25\t\tVersion       string       // 版本号\n26\t\tUptimeSeconds int64        // 运行时间（秒）\n27\t\tStats         SystemStats  // 统计信息\n28\t\tTimestamp     time.Time    // 当前时间戳\n29\t}\n30\t\n31\t// StatusService 聚合各子系统的统计数据。\n32\ttype StatusService str