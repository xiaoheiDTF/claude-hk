为草稿\n74\t- 发布 issue → 读取草稿，用 `gh issue create` 发布，追加发布记录\n75\t- 查看 issue → `gh issue view <编号>`\n76\t- 列出 issue → `gh issue list`\n77\t\n78\t## gh 命令参考\n79\t\n80\t```bash\n81\t# 发布\n82\tgh issue create --title \"<标题>\" --body \"<正文>\" --label \"<标签>\"\n83\t\n84\t# 查看\n85\tgh issue list --state open\n86\tgh issue view <编号>\n87\t\n88\t# 关闭\n89\tgh issue close <编号>\n90\t```\n91\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\.claude\\skills\\003-issues\\scripts\\03UserPromptSubmit.sh"},"tool_use_id":"call_2d35808609d7483cbbff5c77","tool_response":"1\t#!/bin/bash\n2\t# issues on_load: skill 加载时注入动态上下文\n3\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n4\tSKILL_TAG=\"issues\"\n5\tsource \"$PROJECT_DIR/.claude/skills/log.sh\"\n6\t\n7\tTODAY=$(date +%Y-%m-%d)\n8\t\n9\tsource \"$PROJECT_DIR/.claude/scripts/ensure_dirs.sh\"\n10\tensure_skill_dirs \"issues\"\n11\t\n12\tskill_log \"INFO\" \"日期: $TODAY\"\n13\tskill_log \"INFO\" \"草稿目录: $PROJECT_DIR/doc/issues/drafts/\"\n14\tskill_log \"INFO\" \"模板目录: $PROJECT_DIR/doc/issues/templates/\"\n15\t\n16\tCONTEXT=\"[issues] 日期: $TODAY\\n草稿目录: $PROJECT_DIR/doc/issues/drafts/\\n模板目录: $PROJECT_DIR/doc/issues/templates/\\n操作: 新建草稿、从模板创建、发布到 GitHub (gh CLI)\"\n17\t\n18\techo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"UserPromptSubmit\\\",\\\"additionalContext\\\":\\\"$CONTEXT\\\"}}\"\n19\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\.claude\\skills\\003-issues\\scripts\\16Stop.sh"},"tool_use_id":"call_4acafd947a97480fa59745c0","tool_response":"1\t#!/bin/bash\n2\t# issues 16Stop: Claude 响应结束后按 session_id 清理 .active\n3\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n4\tSKILL_TAG=\"issues\"\n5\tsource \"$PROJECT_DIR/.claude/skills/log.sh\"\n6\tsource \"$PROJECT_DIR/.claude/skills/active.sh\"\n7\t\n8\t# $1 = session_id（从 16-stop/base.sh 传入）\n9\tSESSION_ID=\"$1\"\n10\t\n11\tskill_log \"INFO\" \"[stop] skill completed | session: $SESSION_ID\"\n12\t\n13\t# 按 session_id 精确删除 .active 条目\n14\tif [ -n \"$SESSION_ID\" ]; then\n15\t  active_remove \"$SESSION_ID\"\n16\t  skill_log \"INFO\" \"[stop] .active removed session: $SESSION_ID\"\n17\telse\n18\t  # 无 session_id 时按 skill 名清理（兜底）\n19\t  active_remove_by_skill \"$SKILL_TAG\"\n20\t  skill_log \"WARN\" \"[stop] no session_id, cleaned by skill name: $SKILL_TAG\"\n21\tfi\n22\tskill_log \"INFO\" \"[stop] skill lifecycle end\"\n23\t"}]}
