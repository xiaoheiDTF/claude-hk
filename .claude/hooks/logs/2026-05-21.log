son.dump(d, f, indent=2)\n\" 2>/dev/null\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 删除条目\nactive_remove() {\n  local sid=\"$1\"\n\n  lock_acquire \"$LOCK_FILE\" 10 || return 1\n  _ensure_active\n\n  if command -v jq &>/dev/null; then\n    jq --arg s \"$sid\" 'del(.[$s])' \"$ACTIVE_FILE\" > \"$ACTIVE_FILE.tmp\"\n    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      local nf=$(_to_native \"$ACTIVE_FILE\")\n      local tf=$(_to_native \"$ACTIVE_FILE.tmp\")\n      \"$py\" -c \"\nimport json\nwith open(r\\\"$nf\\\", \\\"r\\\", encoding=\\\"utf-8\\\") as f:\n    d = json.load(f)\nd.pop(\\\"$sid\\\", None)\nwith open(r\\\"$tf\\\", \\\"w\\\", encoding=\\\"utf-8\\\") as f:\n    json.dump(d, f, indent=2)\n\" 2>/dev/null\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 查询条目\nactive_get() {\n  local sid=\"$1\"\n  [ -f \"$ACTIVE_FILE\" ] || return\n\n  if command -v jq &>/dev/null; then\n    jq -r --arg s \"$sid\" '.[$s] // empty' \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      local nf=$(_to_native \"$ACTIVE_FILE\")\n      \"$py\" -c \"\nimport json\nwith open(r\\\"$nf\\\", \\\"r\\\", encoding=\\\"utf-8\\\") as f:\n    d = json.load(f)\nv = d.get(\\\"$sid\\\", \\\"\\\")\nif v:\n    print(v)\n\" 2>/dev/null\n    fi\n  fi\n}\n\n# 列出所有\nactive_list() {\n  _ensure_active\n  cat \"$ACTIVE_FILE\"\n}\n"},"tool_use_id":"call_6d721324f0be460e9b3d1695"}
