SON 读写\n# .claude/skills/.active 格式: {\"session_id\":\"skill-name\", ...}\n#\n# 用法:\n#   source \"$SKILLS_DIR/active.sh\"\n#   active_add \"session123\" \"004-git-push\"\n#   active_remove \"session123\"\n#   active_get \"session123\"  → 输出 skill 名或空\n#   active_list              → 输出完整 JSON\n\nPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\nSKILLS_DIR=\"$PROJECT_DIR/.claude/skills\"\nACTIVE_FILE=\"$SKILLS_DIR/.active\"\nLOCK_FILE=\"$SKILLS_DIR/.active.lock\"\n\nsource \"$SKILLS_DIR/lock.sh\"\n\n# 解析 Python 路径\n_resolve_py() {\n  source \"$PROJECT_DIR/.claude/hooks/platform.sh\"\n  if [ -n \"$PYTHON_CMD\" ]; then\n    echo \"$PYTHON_CMD\"\n    return\n  fi\n  echo \"\"\n}\n\n# 确保 .active 文件存在且为有效 JSON\n_ensure_active() {\n  if [ ! -f \"$ACTIVE_FILE\" ] || [ ! -s \"$ACTIVE_FILE\" ]; then\n    echo \"{}\" > \"$ACTIVE_FILE\"\n  fi\n}\n\n# 添加条目\nactive_add() {\n  local sid=\"$1\"\n  local skill_name=\"$2\"\n\n  lock_acquire \"$LOCK_FILE\" 10 || return 1\n  _ensure_active\n\n  if command -v jq &>/dev/null; then\n    jq --arg s \"$sid\" --arg n \"$skill_name\" '.[$s] = $n' \"$ACTIVE_FILE\" > \"$ACTIVE_FILE.tmp\"\n    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      \"$py\" << PYEOF\nimport json\nwith open(\"$ACTIVE_FILE\", \"r\", encoding=\"utf-8\") as f:\n    d = json.load(f)\nd[\"$sid\"] = \"$skill_name\"\nwith open(\"$ACTIVE_FILE.tmp\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(d, f, indent=2)\nPYEOF\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 删除条目\nactive_remove() {\n  local sid=\"$1\"\n\n  lock_acquire \"$LOCK_FILE\" 10 || return 1\n  _ensure_active\n\n  if command -v jq &>/dev/null; then\n    jq --arg s \"$sid\" 'del(.[$s])' \"$ACTIVE_FILE\" > \"$ACTIVE_FILE.tmp\"\n    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      \"$py\" << PYEOF\nimport json\nwith open(\"$ACTIVE_FILE\", \"r\", encoding=\"utf-8\") as f:\n    d = json.load(f)\nd.pop(\"$sid\", None)\nwith open(\"$ACTIVE_FILE.tmp\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(d, f, indent=2)\nPYEOF\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 查询条目\nactive_get() {\n  local sid=\"$1\"\n  [ -f \"$ACTIVE_FILE\" ] || return\n\n  if command -v jq &>/dev/null; then\n    jq -r --arg s \"$sid\" '.[$s] // empty' \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      \"$py\" << PYEOF\nimport json\nwith open(\"$ACTIVE_FILE\", \"r\", encoding=\"utf-8\") as f:\n    d = json.load(f)\nv = d.get(\"$sid\", \"\")\nif v:\n    print(v)\nPYEOF\n    fi\n  fi\n}\n\n# 列出所有\nactive_list() {\n  _ensure_active\n  cat \"$ACTIVE_FILE\"\n}\n","structuredPatch":[{"oldStart":16,"oldLines":6,"newStart":16,"newLines":17,"lines":[" "," source \"$SKILLS_DIR/lock.sh\""," ","+# 路径转换：Git Bash /d/... → Windows D:\\...（给 Python 用）","+_to_native_path() {","+  if command -v cygpath &>/dev/null; then","+    cygpath -w \"$1\"","+  else","+    echo \"$1\"","+  fi","+}","+","+ACTIVE_FILE_NATIVE=$(_to_native_path \"$ACTIVE_FILE\")","+"," # 解析 Python 路径"," _resolve_py() {","   source \"$PROJECT_DIR/.claude/hooks/platform.sh\""]}],"userModified":false,"replaceAll":false},"tool_use_id":"call_2c08546b5a0e48adbde07dbd","duration_ms":18}
