ode\\claude-hk\\.claude\\hooks\\03-user-prompt-submit\\skill-inject.sh"},"tool_use_id":"call_8ed08d4aff57481eba8f619c","tool_response":"1\t#!/bin/bash\n2\t# skill-inject: 从用户 prompt 提取 skill 名，匹配注册表后注入上下文\n3\t# 被 03-user-prompt-submit/base.sh 调用\n4\t# 参数: $1 = 用户 prompt, $2 = session_id（来自 hook 输入 JSON）\n5\t#\n6\t# 匹配规则:\n7\t#   - 首字符必须是 /\n8\t#   - skill 名到第一个空格结束\n9\t#   - /xxx 后面的内容作为参数传递\n10\t\n11\tPROMPT=\"$1\"\n12\tSESSION_ID=\"$2\"\n13\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n14\tSKILLS_DIR=\"$PROJECT_DIR/.claude/skills\"\n15\tREGISTRY=\"$SKILLS_DIR/registry.conf\"\n16\t\n17\t# 首字符不是 / → 不是 skill 调用\n18\t[[ \"$PROMPT\" != /* ]] && exit 0\n19\t\n20\t# 提取 skill 名：去掉开头的 /，取到第一个空格\n21\tPROMPT_TRIMMED=\"${PROMPT#/}\"\n22\tSKILL_NAME=\"${PROMPT_TRIMMED%% *}\"\n23\t\n24\t# 提取参数：skill 名之后的内容\n25\tSKILL_ARGS=\"\"\n26\tif [[ \"$PROMPT_TRIMMED\" == *\" \"* ]]; then\n27\t  SKILL_ARGS=\"${PROMPT_TRIMMED#* }\"\n28\tfi\n29\t\n30\t[ -z \"$SKILL_NAME\" ] && exit 0\n31\t\n32\t# 注册表匹配（纯 ASCII）\n33\tMATCH=$(awk -v name=\"$SKILL_NAME\" '$1 == name {print $1}' \"$REGISTRY\" 2>/dev/null)\n34\t[ -z \"$MATCH\" ] && exit 0\n35\t\n36\t# 查找并运行 03UserPromptSubmit.sh\n37\tON_LOAD=\"$SKILLS_DIR/$MATCH/scripts/03UserPromptSubmit.sh\"\n38\t[ ! -f \"$ON_LOAD\" ] && exit 0\n39\t\n40\t# 执行获取上下文\n41\tCONTEXT=$(bash \"$ON_LOAD\" 2>/dev/null)\n42\t[ -z \"$CONTEXT\" ] && exit 0\n43\t\n44\t# 写入 .active（使用真实 session_id）\n45\tsource \"$SKILLS_DIR/active.sh\"\n46\tactive_add \"$SESSION_ID\" \"$MATCH\" 2>/dev/null\n47\t\n48\t# 输出：第一行元数据，第二行起 CONTEXT\n49\techo \"$MATCH|$SKILL_ARGS\"\n50\techo \"$CONTEXT\"\n51\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\.claude\\hooks\\16-stop\\skill-register.sh"},"tool_use_id":"call_5f2fd46de6c44abba405eceb","tool_response":"1\t#!/bin/bash\n2\t# skill-register: 扫描 skills 目录，将新增的 skill 自动注册到 registry.conf\n3\t# 被 29-session-end/base.sh 调用\n4\t\n5\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n6\tSKILLS_DIR=\"$PROJECT_DIR/.claude/skills\"\n7\tREGISTRY=\"$SKILLS_DIR/registry.conf\"\n8\t\n9\t[ -d \"$SKILLS_DIR\" ] || exit 0\n10\t\n11\t# 确保 registry.conf 存在\n12\ttouch \"$REGISTRY\"\n13\t\n14\t# 扫描所有包含 SKILL.md 的目录\n15\tCHANGED=0\n16\tfor skill_dir in \"$SKILLS_DIR\"/*/; do\n17\t  [ -d \"$skill_dir\" ] || continue\n18\t  SKILL_NAME=$(basename \"$skill_dir\")\n19\t  [ -f \"$skill_dir/SKILL.md\" ] || continue\n20\t\n21\t  # 检查是否已在 registry 中\n22\t  if ! grep -qx \"$SKILL_NAME\" \"$REGISTRY\" 2>/dev/null; then\n23\t    echo \"$SKILL_NAME\" >> \"$REGISTRY\"\n24\t    CHANGED=1\n25\t  fi\n26\tdone\n27\t\n28\t# 输出变更信息供 base.sh 日志使用\n29\t[ \"$CHANGED\" -eq 1 ] && echo \"UPDATED\"\n30\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\.claude\\scripts\\ensure_python.sh"},"tool_use_id":"call_6b74839644184859914539fb","tool_response":"1\t#!/bin/bash\n2\t# Python 保障模块 — 确保 Python 环境可用\n3\t# 被 init.sh 和 01-session-start 调用\n4\t#\n5\t# 策略:\n6\t#   1. 项目嵌入版（最优先，不依赖系统）\n7\t#   2. 系统 Python（用户已安装）\n8\t#   3. 自动下载（兜底，多源 + 重试）\n9\t#\n10\t# 状态文件: .claude/.python-state（纯文本，无需 Python 解析）\n11\t#   status=not_tried|downloading|ready|failed|failed_permanent\n12\t#   path=...\n13\t#   attempts=N\n14\t#   last_attempt=YYYY-MM-DDTHH:MM:SS\n15\t#   version=...\n16\t\n17\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n18\tCLAUSE_DIR=\"$PROJECT_DIR/.claude\"\n19\tLOCAL_LANG_DIR=\"$CLAUSE_DIR/localLanguage\"\n20\tSTATE_FILE=\"$CLAUSE_DIR/.python-state\"\n21\tMAX_ATTEMPTS=5\n22\t\n23\t# ---- 平台检测 ----\n24\t_detect_os() {\n25\t  case \"$(uname -s)\" in\n26\t    Linux*)   echo \"linux\" ;;\n27\t    Darwin*)  echo \"macos\" ;;\n28\t    MINGW*|MSYS*|CYGWIN*) echo \"windows\" ;;\n29\t    *)        echo \"unknown\" ;;\n30\t  esac\n31\t}\n32\t\n33\t# ---- 状态文件操作（纯 bash） ----\n34\t_state_get() {\n35\t  local key=\"$1\"\n36\t  [ -f \"$STATE_FILE\" ] && grep \"^${key}=\" \"$STATE_FILE\" | tail -1 | cut -d'=' -f2-\n37\t}\n38\t\n39\t_state_set() {\n40\t  local key=\"$1\"\n41\t  local val=\"$2\"\n42\t  if [ -f \"$STATE_FILE\" ] && grep -q \"^${key}=\" \"$STATE_FILE\"; then\n43\t    local tmp=\"${STATE_FILE}.tmp\"\n44\t    grep -v \"^${key}=\" \"$STATE_FILE\" > \"$tmp\"\n45\t    echo \"${key}=${val}\" >> \"$tmp\"\n46\t    mv \"$tmp\" \"$STATE_FILE\"\n47\t  else\n48\t    echo \"${key}=${val}\" >> \"$STATE_FILE\"\n49\t  fi\n50\t}\n51\t\n52\t_state_init() {\n53\t  mkdir -p \"$(dirname \"$STATE_FILE\")\"\n54\t  [ -f \"$STATE_FILE\" ] || cat > \"$STATE_FILE\" << 'EOF'\n55\tstatus=not_tried\n56\tpath=\n57\tattempts=0\n58\tlast_attempt=\n59\tversion=\n60\tEOF\n61\t}\n62\t\n63\t# ---- Python 路径解析 ----\n64\t_resolve_embed() {\n65\t  local os=$(_detect_os)\n66\t  case \"$os\" in\n67\t    windows) echo \"$LOCAL_LANG_DIR/python/python.exe\" ;;\n68\t    linux)   echo \"$LOCAL_LANG_DIR/python/bin/python3\" ;;\n69\t    macos)   echo \"$LOCAL_LANG_DIR/python/bin/python3\" ;;\n70\t  esac\n71\t}\n72\t\n73\t_resolve_python() {\n74\t  # 1. 嵌入版\n75\t  local embed=$(_resolve_embed)\n76\t  if [ -x \"$embed\" ]; then\n77\t    echo \"$embed\"\n78\t    return\n79\t  fi\n80\t  # 2. 系统 Python\n81\t  for cmd in python3 python; do\n82\t    if command -v \"$cmd\" &>/dev/null && \"$cmd\" -c \"pass\" 2>/dev/null; then\n83\t      echo \"$cmd\"\n84\t      return\n85\t    fi\n86\t  done\n87\t  echo \"\"\n88\t}\n89\t\n90\t# ---- 下载源配置 ----\n91\t_get_download_urls() {\n92\t  local os=$(_detect_os)\n93\t  case \"$os\" in\n94\t    windows)\n95\t      # Python 嵌入版（多镜像源）\n96\t      echo \"https://www.python.org/ftp/python/3.13.9/python-3.13.9-embed-amd64.zip\"\n97\t      echo \"https://registry.npmmirror.com/-/binary/python/3.13.9/python-3.13.9-embed-amd64.zip\"\n98\t      ;;\n99\t    linux)\n100\t      # python-build-standalone (x86_64)\n101\t      local ver=\"20250417\"\n102\t      local tag=\"cpython-3.13.3+${ver}-x86_64-unknown-linux-gnu-install_only.tar.gz\"\n103\t      echo \"https://github.com/indygreg/python-build-standalone/releases/download/${ver}/${tag}\"\n104\t      ;;\n105\t    macos)\n106\t      # python-build-standalone (arm64 + x86_64)\n107\t      local ver=\"20250417\"\n108\t      local arch=$(uname -m)\n109\t      local platform=\"aarch64-apple-darwin\"\n110\t      [ \"$arch\" = \"x86_64\" ] && platform=\"x86_64-apple-darwin\"\n111\t      local tag=\"cpython-3.13.3+${ver}-${platform}-install_only.tar.gz\"\n112\t      echo \"https://github.com/indygreg/python-build-standalone/releases/download/${ver}/${tag}\"\n113\t      ;;\n114\t  esac\n115\t}\n116\t\n117\t# ---- 下载并安装 ----\n118\t_download_python() {\n119\t  local python_dir=\"$LOCAL_LANG_DIR/python\"\n120\t  mkdir -p \"$python_dir\"\n121\t\n122\t  _state_set status \"downloading\"\n123\t  _state_set last_attempt \"$(date +%Y-%m-%dT%H:%M:%S)\"\n124\t\n125\t  local os=$(_detect_os)\n126\t  local urls\n127\t  urls=$(_get_download_urls)\n128\t\n129\t  while IFS= read -r url; do\n130\t    [ -z \"$url\" ] && continue\n131\t    local filename=$(basename \"$url\")\n132\t    local tmpfile=\"$python_dir/$filename\"\n133\t\n134\t    echo \"[ensure_python] 尝试下载: $url\"\n135\t\n136\t    if curl -L --connect-timeout 15 --max-time 300 -o \"$tmpfile\" \"$url\" 2>/dev/null; then\n137\t      # 验证下载文件不为空\n138\t      if [ -s \"$tmpfile\" ]; then\n139\t        echo \"[ensure_python] 下载成功，开始安装...\"\n140\t\n141\t        case \"$os\" in\n142\t          windows)\n143\t            cd \"$python_dir\" && unzip -o \"$filename\" 2>/dev/null && rm -f \"$filename\"\n144\t            # 修复 pip：移除 import 限制\n145\t            local pth_file=\"$python_dir/python313._pth\"\n146\t            [ -f \"$pth_file\" ] && echo \"import site\" >> \"$pth_file\"\n147\t            ;;\n148\t          linux|macos)\n149\t            cd \"$python_dir\" && tar xzf \"$filename\" --strip-components=1 2>/dev/null && rm -f \"$filename\"\n150\t            ;;\n151\t        esac\n152\t\n153\t        # 验证安装结果\n154\t        local embed=$(_resolve_embed)\n155\t        if [ -x \"$embed\" ]; then\n156\t          local ver=$(\"$embed\" --version 2>&1 | head -1)\n157\t          _state_set status \"ready\"\n158\t          _state_set path \"$embed\"\n159\t          _state_set version \"$ver\"\n160\t          echo \"[ensure_python] 安装成功: $embed ($ver)\"\n161\t          return 0\n162\t        else\n163\t          echo \"[ensure_python] 安装后验证失败\"\n164\t          rm -f \"$tmpfile\"\n165\t        fi\n166\t      else\n167\t        echo \"[ensure_python] 下载文件为空\"\n168\t        rm -f \"$tmpfile\"\n169\t      fi\n170\t    else\n171\t      echo \"[ensure_python] 下载失败: $url\"\n172\t      rm -f \"$tmpfile\"\n173\t    fi\n174\t  done <<< \"$urls\"\n175\t\n176\t  return 1\n177\t}\n178\t\n179\t# ---- 主入口 ----\n180\tensure_python() {\n181\t  _state_init\n182\t\n183\t  # 先尝试解析\n184\t  local found=$(_resolve_python)\n185\t  if [ -n \"$found\" ]; then\n186\t    # 更新状态（可能之前是系统 Python，不是嵌入版）\n187\t    [ \"$(_state_get status)\" != \"ready\" ] && {\n188\t      _state_set status \"ready\"\n189\t      _state_set path \"$found\"\n190\t      local ver=$(\"$found\" --version 2>&1 | head -1)\n191\t      _state_set version \"$ver\"\n192\t    }\n193\t    echo \"$found\"\n194\t    return 0\n195\t  fi\n196\t\n197\t  # 未找到 → 检查是否应该重试\n198\t  local status=$(_state_get status)\n199\t  local attempts=$(_state_get attempts)\n200\t  attempts=${attempts:-0}\n201\t\n202\t  case \"$status\" in\n203\t    ready)\n204\t      # 状态说是 ready 但实际找不到 → 重置\n205\t      _state_set status \"not_tried\"\n206\t      _state_set attempts \"0\"\n207\t      ;;\n208\t    failed_permanent)\n209\t      echo \"[ensure_python] 已达最大重试次数，请手动安装 Python\"\n210\t      echo \"\"\n211\t      return 1\n212\t      ;;\n213\t    downloading)\n214\t      # 可能上次中断了 → 允许重试\n215\t      ;;\n216\t  esac\n217\t\n218\t  # 超过最大次数\n219\t  if [ \"$attempts\" -ge \"$MAX_ATTEMPTS\" ]; then\n220\t    _state_set status \"failed_permanent\"\n221\t    echo \"[ensure_python] 已尝试 $attempts 次，停止重试\"\n222\t    echo \"[ensure_python] 请手动安装 Python 并重启 Claude Code\"\n223\t    echo \"\"\n224\t    return 1\n225\t  fi\n226\t\n227\t  # 尝试下载\n228\t  _state_set attempts \"$((attempts + 1))\"\n229\t  echo \"[ensure_python] Python 未找到，尝试自动下载 (第 $((attempts + 1))/$MAX_ATTEMPTS 次)...\"\n230\t\n231\t  if _download_python; then\n232\t    _resolve_python\n233\t    return 0\n234\t  else\n235\t    _state_set status \"failed\"\n236\t    echo \"[ensure_python] 本次下载失败，下次会话将重试\"\n237\t    echo \"\"\n238\t    return 1\n239\t  fi\n240\t}\n241\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\.claude\\scripts\\ensure_dirs.sh"},"tool_use_id":"call_2a56b950e7ae43f78e63061f","tool_response":"1\t#!/bin/bash\n2\t# 读取 dirs.conf，确保所有配置目录存在\n3\t# 用法: source 此文件后调用 ensure_all_dirs 或 ensure_skill_dirs <skill名>\n4\t\n5\tCLAUSE_DIR=\"$CLAUDE_PROJECT_DIR/.claude\"\n6\tDIRS_CONF=\"$CLAUSE_DIR/dirs.conf\"\n7\t\n8\t# 读取配置并创建所有缺失目录\n9\tensure_all_dirs() {\n10\t  local log_file=\"${1:-/dev/null}\"\n11\t  local created=0\n12\t  local skipped=0\n13\t\n14\t  while IFS= read -r line; do\n15\t    # 跳过空行和注释\n16\t    [[ -z \"$line\" || \"$line\" =~ ^[[:space:]]*# ]] && continue\n17\t    # 取第一列（路径）\n18\t    local dir=$(echo \"$line\" | awk '{print $1}')\n19\t    [ -z \"$dir\" ] && continue\n20\t\n21\t    local full_path=\"$CLAUDE_PROJECT_DIR/$dir\"\n22\t    if [ -d \"$full_path\" ]; then\n23\t      skipped=$((skipped + 1))\n24\t    else\n25\t      mkdir -p \"$full_path\" 2>>\"$log_file\"\n26\t      created=$((created + 1))\n27\t      [ -n \"$log_file\" ] && [ \"$log_file\" != \"/dev/null\" ] && \\\n28\t        echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [DIRS] 创建: $dir\" >> \"$log_file\"\n29\t    fi\n30\t  done < \"$DIRS_CONF\"\n31\t\n32\t  echo \"{\\\"total\\\":$(wc -l < \"$DIRS_CONF\"),\\\"created\\\":$created,\\\"skipped\\\":$skipped}\"\n33\t}\n34\t\n35\t# 检查单个 skill 相关目录是否存在\n36\tensure_skill_dirs() {\n37\t  local skill_keyword=\"$1\"\n38\t  while IFS= read -r line; do\n39\t    [[ -z \"$line\" || \"$line\" =~ ^[[:space:]]*# ]] && continue\n40\t    local dir=$(echo \"$line\" | awk '{print $1}')\n41\t    [[ \"$dir\" == *\"$skill_keyword\"* ]] || continue\n42\t    mkdir -p \"$CLAUDE_PROJECT_DIR/$dir\"\n43\t  done < \"$DIRS_CONF\"\n44\t}\n45\t\n46\t# 报告目录状态（不创建，仅检查）\n47\tcheck_dirs() {\n48\t  local missing=0\n49\t  while IFS= read -r line; do\n50\t    [[ -z \"$line\" || \"$line\" =~ ^[[:space:]]*# ]] && continue\n51\t    local dir=$(echo \"$line\" | awk '{print $1}')\n52\t    [ -z \"$dir\" ] && continue\n53\t    if [ ! -d \"$CLAUDE_PROJECT_DIR/$dir\" ]; then\n54\t      echo \"MISSING: $dir\"\n55\t      missing=$((missing + 1))\n56\t    fi\n57\t  done < \"$DIRS_CONF\"\n58\t  [ \"$missing\" -eq 0 ] && echo \"ALL OK\"\n59\t  return $missing\n60\t}\n61\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\.claude\\hooks\\platform.sh"},"tool_use_id":"call_fbb3442ca5a84cf5950714d6","tool_response":"1\t#!/bin/bash\n2\t# 平台检测与 Python 路径解析\n3\t\n4\tdetect_os() {\n5\t  case \"$(uname -s)\" in\n6\t    Linux*)   echo \"linux\" ;;\n7\t    Darwin*)  echo \"macos\" ;;\n8\t    MINGW*|MSYS*|CYGWIN*) echo \"windows\" ;;\n9\t    *)        echo \"unknown\" ;;\n10\t  esac\n11\t}\n12\t\n13\tOS_TYPE=$(detect_os)\n14\t\n15\tresolve_python() {\n16\t  local embed\n17\t  case \"$OS_TYPE\" in\n18\t    windows) embed=\"$CLAUDE_PROJECT_DIR/.claude/localLanguage/python/python.exe\" ;;\n19\t    *)       embed=\"$CLAUDE_PROJECT_DIR/.claude/localLanguage/python/bin/python3\" ;;\n20\t  esac\n21\t  if [ -x \"$embed\" ]; then echo \"$embed\"; return; fi\n22\t  for cmd in python3 python; do\n23\t    if command -v \"$cmd\" &>/dev/null && \"$cmd\" -c \"pass\" 2>/dev/null; then\n24\t      echo \"$cmd\"; return\n25\t    fi\n26\t  done\n27\t  echo \"\"\n28\t}\n29\t\n30\tPYTHON_CMD=$(resolve_python)\n31\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\.claude\\hooks\\json_get.py"},"tool_use_id":"call_b0374ed8dcc8445892a4c2ba","tool_response":"1\t\"\"\"JSON field extractor for hook scripts.\n2\t\n3\tUsage: printf '<json>' | python json_get.py <key>\n4\t  e.g.: printf '<json>' | python json_get.py .hook_event_name\n5\t        printf '<json>' | python json_get.py .tool_name\n6\t\"\"\"\n7\timport sys\n8\timport json\n9\t\n10\tdata = json.load(sys.stdin)\n11\tkeys = sys.argv[1].lstrip(\".\").split(\".\")\n12\tv = data\n13\tfor k in keys:\n14\t    if isinstance(v, dict) and k in v:\n15\t        v = v[k]\n16\t    else:\n17\t        v = \"\"\n18\t        break\n19\tprint(v if not isinstance(v, (list, dict)) else json.dumps(v, ensure_ascii=False))\n20\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\.claude\\init.sh"},"tool_use_id":"call_ee281e040fa04fabb4553ceb","tool_response":"1\t#!/bin/bash\n2\t# 统一初始化脚本 - 管理项目首次运行的所有配置\n3\t\n4\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n5\tCLAUSE_DIR=\"$PROJECT_DIR/.claude\"\n6\tLOG_DIR=\"$CLAUSE_DIR/hooks/logs\"\n7\tmkdir -p \"$LOG_DIR\"\n8\tLOG_FILE=\"$LOG_DIR/$(date +%Y-%m-%d).log\"\n9\tINIT_MARKER=\"$CLAUSE_DIR/.initialized\"\n10\t\n11\tinit_log() { echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [INIT] $*\" >> \"$LOG_FILE\"; }\n12\t\n13\t# 已初始化 → 跳过\n14\t[ -f \"$INIT_MARKER\" ] && exit 0\n15\t\n16\tinit_log \"首次运行，开始初始化...\"\n17\t\n18\t# ---- 1. 从配置文件创建项目目录 ----\n19\tsource \"$CLAUSE_DIR/scripts/ensure_dirs.sh\"\n20\tdir_result=$(ensure_all_dirs \"$LOG_FILE\")\n21\t# otherDoc 额外创建今日子目录\n22\tmkdir -p \"$PROJECT_DIR/doc/otherDoc/$(date +%Y-%m-%d)\"\n23\tinit_log \"目录初始化完成: $dir_result\"\n24\t\n25\t# ---- 2. 平台检测 ----\n26\tsource \"$CLAUSE_DIR/hooks/platform.sh\"\n27\t\n28\t# ---- 3. 配置 Python 环境（使用 ensure_python 模块） ----\n29\tsource \"$CLAUSE_DIR/scripts/ensure_python.sh\"\n30\tPYTHON_CMD=$(ensure_python)\n31\tif [ -n \"$PYTHON_CMD\" ]; then\n32\t  init_log \"Python 已就绪: $PYTHON_CMD\"\n33\telse\n34\t  init_log \"WARN\" \"Python 安装未成功，将在下次会话重试\"\n35\tfi\n36\t\n37\t# ---- 4. 配置 UTF-8 编码（跨平台） ----\n38\tsetup_utf8() {\n39\t  local bashrc=\"$HOME/.bashrc\"\n40\t  local marker=\"# >>> claude-hk-utf8 >>>\"\n41\t  local ender=\"# <<< claude-hk-utf8 <<<\"\n42\t  local block=\"\"\n43\t\n44\t  case \"$OS_TYPE\" in\n45\t    windows)\n46\t      block=\"${marker}\n47\texport LANG=zh_CN.UTF-8\n48\texport LC_ALL=zh_CN.UTF-8\n49\tchcp.com 65001 > /dev/null 2>&1\n50\t${ender}\"\n51\t      ;;\n52\t    linux)\n53\t      block=\"${marker}\n54\texport LANG=en_US.UTF-8\n55\texport LC_ALL=en_US.UTF-8\n56\t${ender}\"\n57\t      ;;\n58\t    macos)\n59\t      block=\"${marker}\n60\texport LANG=en_US.UTF-8\n61\texport LC_ALL=en_US.UTF-8\n62\t${ender}\"\n63\t      ;;\n64\t  esac\n65\t\n66\t  # 检查是否已有配置：标记块 或 关键内容\n67\t  if [ -f \"$bashrc\" ]; then\n68\t    if grep -q \"$marker\" \"$bashrc\" 2>/dev/null; then\n69\t      init_log \"UTF-8 标记块已存在，跳过\"\n70\t      return 0\n71\t    fi\n72\t    if grep -q \"chcp.com 65001\\|LANG=.*UTF-8\" \"$bashrc\" 2>/dev/null; then\n73\t      init_log \"UTF-8 配置已存在（无标记），补充写入标记块\"\n74\t      # 不重复写，只补标记方便下次判断\n75\t      sed -i \"1i $marker\" \"$bashrc\"\n76\t      echo \"$ender\" >> \"$bashrc\"\n77\t      return 0\n78\t    fi\n79\t  fi\n80\t\n81\t  echo \"\" >> \"$bashrc\"\n82\t  echo \"$block\" >> \"$bashrc\"\n83\t  init_log \"UTF-8 编码配置已写入 $bashrc (OS=$OS_TYPE)\"\n84\t\n85\t  if [ \"$OS_TYPE\" = \"windows\" ]; then\n86\t    setx LANG \"zh_CN.UTF-8\" >> \"$LOG_FILE\" 2>&1\n87\t    setx LC_ALL \"zh_CN.UTF-8\" >> \"$LOG_FILE\" 2>&1\n88\t    init_log \"Windows 系统环境变量 LANG/LC_ALL 已设置\"\n89\t  fi\n90\t}\n91\t\n92\tsetup_utf8\n93\t\n94\t# ---- 5. 写入标记文件 ----\n95\techo \"{\\\"os\\\":\\\"$OS_TYPE\\\",\\\"python\\\":\\\"$PYTHON_CMD\\\",\\\"utf8\\\":\\\"true\\\",\\\"initialized_at\\\":\\\"$(date +%Y-%m-%dT%H:%M:%S)\\\"}\" > \"$INIT_MARKER\"\n96\tinit_log \"初始化完成\"\n97\t\n98\texit 0\n99\t"}]}
