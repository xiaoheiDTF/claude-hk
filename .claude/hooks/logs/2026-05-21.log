 open('$ACTIVE_FILE.tmp', 'w'), indent=2)\n49\t\" 2>/dev/null\n50\t  fi\n51\t\n52\t  [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n53\t  lock_release\n54\t}\n55\t\n56\t# 删除条目\n57\tactive_remove() {\n58\t  local sid=\"$1\"\n59\t\n60\t  lock_acquire \"$LOCK_FILE\" 10 || return 1\n61\t  _ensure_active\n62\t\n63\t  if command -v jq &>/dev/null; then\n64\t    jq --arg s \"$sid\" 'del(.[$s])' \"$ACTIVE_FILE\" > \"$ACTIVE_FILE.tmp\"\n65\t    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n66\t  else\n67\t    local py=\"$PYTHON_CMD\"\n68\t    [ -z \"$py\" ] && py=\"python3\"\n69\t    \"$py\" -c \"\n70\timport json\n71\td = json.load(open('$ACTIVE_FILE'))\n72\td.pop('$sid', None)\n73\tjson.dump(d, open('$ACTIVE_FILE.tmp', 'w'), indent=2)\n74\t\" 2>/dev/null\n75\t    [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n76\t  fi\n77\t\n78\t  lock_release\n79\t}\n80\t\n81\t# 查询条目\n82\tactive_get() {\n83\t  local sid=\"$1\"\n84\t  [ -f \"$ACTIVE_FILE\" ] || return\n85\t\n86\t  if command -v jq &>/dev/null; then\n87\t    jq -r --arg s \"$sid\" '.[$s] // empty' \"$ACTIVE_FILE\"\n88\t  else\n89\t    local py=\"$PYTHON_CMD\"\n90\t    [ -z \"$py\" ] && py=\"python3\"\n91\t    \"$py\" -c \"\n92\timport json\n93\td = json.load(open('$ACTIVE_FILE'))\n94\tprint(d.get('$sid', ''))\n95\t\" 2>/dev/null\n96\t  fi\n97\t}\n98\t\n99\t# 列出所有\n100\tactive_list() {\n101\t  _ensure_active\n102\t  cat \"$ACTIVE_FILE\"\n103\t}\n104\t"}]}
