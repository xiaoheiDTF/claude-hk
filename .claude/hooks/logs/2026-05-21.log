& echo \"$line\" | cut -d'|' -f2","+}"," ","-  if command -v jq &>/dev/null; then","-    jq -r --arg s \"$sid\" '.[$s] // empty' \"$ACTIVE_FILE\"","-  else","-    local py=$(_resolve_py)","-    if [ -n \"$py\" ]; then","-      local nf=$(_to_native \"$ACTIVE_FILE\")","-      \"$py\" -c \"","-import json","-with open(r\\\"$nf\\\", \\\"r\\\", encoding=\\\"utf-8\\\") as f:","-    d = json.load(f)","-v = d.get(\\\"$sid\\\", \\\"\\\")","-if v:","-    print(v)","-\" 2>/dev/null","-    fi","-  fi","+# 按 skill 名删除所有匹配条目","+active_remove_by_skill() {","+  local skill_name=\"$1\"","+","+  lock_acquire \"$LOCK_FILE\" 10 || return 1","+  _ensure_active","+","+  local tmp=\"${ACTIVE_FILE}.tmp\"","+  grep -v \"|${skill_name}$\" \"$ACTIVE_FILE\" > \"$tmp\" 2>/dev/null || true","+  mv \"$tmp\" \"$ACTIVE_FILE\"","+","+  lock_release"," }"," ","-# 列出所有","+# 列出所有 skill 名（去重）","+active_skills() {","+  [ -f \"$ACTIVE_FILE\" ] || return","+  cut -d'|' -f2 \"$ACTIVE_FILE\" | sort -u","+}","+","+# 列出全部"," active_list() {","   _ensure_active","   cat \"$ACTIVE_FILE\""]}],"originalFile":"#!/bin/bash\n# .active 管理模块 — 带锁的 JSON 读写\n# .claude/skills/.active 格式: {\"session_id\":\"skill-name\", ...}\n\nPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\nSKILLS_DIR=\"$PROJECT_DIR/.claude/skills\"\nACTIVE_FILE=\"$SKILLS_DIR/.active\"\nLOCK_FILE=\"$SKILLS_DIR/.active.lock\"\n\nsource \"$SKILLS_DIR/lock.sh\"\n\n# 路径转换：Git Bash /d/... → Windows D:\\...（给嵌入版 Python 用）\n_to_native() {\n  if command -v cygpath &>/dev/null; then\n    cygpath -w \"$1\"\n  else\n    echo \"$1\"\n  fi\n}\n\n# 解析 Python 路径\n_resolve_py() {\n  source \"$PROJECT_DIR/.claude/hooks/platform.sh\"\n  [ -n \"$PYTHON_CMD\" ] && echo \"$PYTHON_CMD\" && return\n  echo \"\"\n}\n\n# 确保 .active 存在\n_ensure_active() {\n  if [ ! -f \"$ACTIVE_FILE\" ] || [ ! -s \"$ACTIVE_FILE\" ]; then\n    echo \"{}\" > \"$ACTIVE_FILE\"\n  fi\n}\n\n# 添加条目\nactive_add() {\n  local sid=\"$1\"\n  local skill_name=\"$2\"\n\n  lock_acquire \"$LOCK_FILE\" 10 || return 1\n  _ensure_active\n\n  if command -v jq &>/dev/null; then\n    jq --arg s \"$sid\" --arg n \"$skill_name\" '.[$s] = $n' \"$ACTIVE_FILE\" > \"$ACTIVE_FILE.tmp\"\n    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      local nf=$(_to_native \"$ACTIVE_FILE\")\n      local tf=$(_to_native \"$ACTIVE_FILE.tmp\")\n      \"$py\" -c \"\nimport json\nwith open(r\\\"$nf\\\", \\\"r\\\", encoding=\\\"utf-8\\\") as f:\n    d = json.load(f)\nd[\\\"$sid\\\"] = \\\"$skill_name\\\"\nwith open(r\\\"$tf\\\", \\\"w\\\", encoding=\\\"utf-8\\\") as f:\n    json.dump(d, f, indent=2)\n\" 2>/dev/null\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 删除条目\nactive_remove() {\n  local sid=\"$1\"\n\n  lock_acquire \"$LOCK_FILE\" 10 || return 1\n  _ensure_active\n\n  if command -v jq &>/dev/null; then\n    jq --arg s \"$sid\" 'del(.[$s])' \"$ACTIVE_FILE\" > \"$ACTIVE_FILE.tmp\"\n    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      local nf=$(_to_native \"$ACTIVE_FILE\")\n      local tf=$(_to_native \"$ACTIVE_FILE.tmp\")\n      \"$py\" -c \"\nimport json\nwith open(r\\\"$nf\\\", \\\"r\\\", encoding=\\\"utf-8\\\") as f:\n    d = json.load(f)\nd.pop(\\\"$sid\\\", None)\nwith open(r\\\"$tf\\\", \\\"w\\\", encoding=\\\"utf-8\\\") as f:\n    json.dump(d, f, indent=2)\n\" 2>/dev/null\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 查询条目\nactive_get() {\n  local sid=\"$1\"\n  [ -f \"$ACTIVE_FILE\" ] || return\n\n  if command -v jq &>/dev/null; then\n    jq -r --arg s \"$sid\" '.[$s] // empty' \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      local nf=$(_to_native \"$ACTIVE_FILE\")\n      \"$py\" -c \"\nimport json\nwith open(r\\\"$nf\\\", \\\"r\\\", encoding=\\\"utf-8\\\") as f:\n    d = json.load(f)\nv = d.get(\\\"$sid\\\", \\\"\\\")\nif v:\n    print(v)\n\" 2>/dev/null\n    fi\n  fi\n}\n\n# 列出所有\nactive_list() {\n  _ensure_active\n  cat \"$ACTIVE_FILE\"\n}\n","userModified":false},"tool_use_id":"call_61eb0cbd36764bf4848363c3","duration_ms":12}
