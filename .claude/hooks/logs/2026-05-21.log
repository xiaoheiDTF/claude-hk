urn 1\n53\t  _ensure_active\n54\t\n55\t  if command -v jq &>/dev/null; then\n56\t    jq --arg s \"$sid\" --arg n \"$skill_name\" '.[$s] = $n' \"$ACTIVE_FILE_NATIVE\" > \"$ACTIVE_FILE.tmp\"\n57\t    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE_NATIVE\"\n58\t  else\n59\t    local py=$(_resolve_py)\n60\t    if [ -n \"$py\" ]; then\n61\t      \"$py\" << PYEOF\n62\timport json\n63\twith open(\"$ACTIVE_FILE_NATIVE\", \"r\", encoding=\"utf-8\") as f:\n64\t    d = json.load(f)\n65\td[\"$sid\"] = \"$skill_name\"\n66\twith open(\"$ACTIVE_FILE.tmp\", \"w\", encoding=\"utf-8\") as f:\n67\t    json.dump(d, f, indent=2)\n68\tPYEOF\n69\t      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE_NATIVE\"\n70\t    fi\n71\t  fi\n72\t\n73\t  lock_release\n74\t}\n75\t\n76\t# 删除条目\n77\tactive_remove() {\n78\t  local sid=\"$1\"\n79\t\n80\t  lock_acquire \"$LOCK_FILE\" 10 || return 1\n81\t  _ensure_active\n82\t\n83\t  if command -v jq &>/dev/null; then\n84\t    jq --arg s \"$sid\" 'del(.[$s])' \"$ACTIVE_FILE_NATIVE\" > \"$ACTIVE_FILE.tmp\"\n85\t    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE_NATIVE\"\n86\t  else\n87\t    local py=$(_resolve_py)\n88\t    if [ -n \"$py\" ]; then\n89\t      \"$py\" << PYEOF\n90\timport json\n91\twith open(\"$ACTIVE_FILE_NATIVE\", \"r\", encoding=\"utf-8\") as f:\n92\t    d = json.load(f)\n93\td.pop(\"$sid\", None)\n94\twith open(\"$ACTIVE_FILE.tmp\", \"w\", encoding=\"utf-8\") as f:\n95\t    json.dump(d, f, indent=2)\n96\tPYEOF\n97\t      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE_NATIVE\"\n98\t    fi\n99\t  fi\n100\t\n101\t  lock_release\n102\t}\n103\t\n104\t# 查询条目\n105\tactive_get() {\n106\t  local sid=\"$1\"\n107\t  [ -f \"$ACTIVE_FILE_NATIVE\" ] || return\n108\t\n109\t  if command -v jq &>/dev/null; then\n110\t    jq -r --arg s \"$sid\" '.[$s] // empty' \"$ACTIVE_FILE_NATIVE\"\n111\t  else\n112\t    local py=$(_resolve_py)\n113\t    if [ -n \"$py\" ]; then\n114\t      \"$py\" << PYEOF\n115\timport json\n116\twith open(\"$