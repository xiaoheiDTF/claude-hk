TIVE_FILE.tmp\"\n    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE_NATIVE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      \"$py\" << PYEOF\nimport json\nwith open(\"$ACTIVE_FILE_NATIVE\", \"r\", encoding=\"utf-8\") as f:\n    d = json.load(f)\nd[\"$sid\"] = \"$skill_name\"\nwith open(\"$ACTIVE_FILE.tmp\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(d, f, indent=2)\nPYEOF\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE_NATIVE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 删除条目\nactive_remove() {\n  local sid=\"$1\"\n\n  lock_acquire \"$LOCK_FILE\" 10 || return 1\n  _ensure_active\n\n  if command -v jq &>/dev/null; then\n    jq --arg s \"$sid\" 'del(.[$s])' \"$ACTIVE_FILE_NATIVE\" > \"$ACTIVE_FILE.tmp\"\n    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE_NATIVE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      \"$py\" << PYEOF\nimport json\nwith open(\"$ACTIVE_FILE_NATIVE\", \"r\", encoding=\"utf-8\") as f:\n    d = json.load(f)\nd.pop(\"$sid\", None)\nwith open(\"$ACTIVE_FILE.tmp\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(d, f, indent=2)\nPYEOF\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE_NATIVE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 查询条目\nactive_get() {\n  local sid=\"$1\"\n  [ -f \"$ACTIVE_FILE_NATIVE\" ] || return\n\n  if command -v jq &>/dev/null; then\n    jq -r --arg s \"$sid\" '.[$s] // empty' \"$ACTIVE_FILE_NATIVE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      \"$py\" << PYEOF\nimport json\nwith open(\"$ACTIVE_FILE_NATIVE\", \"r\", encoding=\"utf-8\") as f:\n    d = json.load(f)\nv = d.get(\"$sid\", \"\")\nif v:\n    print(v)\nPYEOF\n    fi\n  fi\n}\n\n# 列出所有\nactive_list() {\n  _ensure_active\n  cat \"$ACTIVE_FILE_NATIVE\"\n}\n","numLines":131,"startLine":1,"totalLines":131}},"tool_use_id":"call_eb7936a26cfc49928a7ab03b","duration_ms":6}
