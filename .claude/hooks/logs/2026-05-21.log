skill_name\"\nwith open(\"$ACTIVE_FILE.tmp\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(d, f, indent=2)\nPYEOF\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 删除条目\nactive_remove() {\n  local sid=\"$1\"\n\n  lock_acquire \"$LOCK_FILE\" 10 || return 1\n  _ensure_active\n\n  if command -v jq &>/dev/null; then\n    jq --arg s \"$sid\" 'del(.[$s])' \"$ACTIVE_FILE\" > \"$ACTIVE_FILE.tmp\"\n    mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      \"$py\" << PYEOF\nimport json\nwith open(\"$ACTIVE_FILE\", \"r\", encoding=\"utf-8\") as f:\n    d = json.load(f)\nd.pop(\"$sid\", None)\nwith open(\"$ACTIVE_FILE.tmp\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(d, f, indent=2)\nPYEOF\n      [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"\n    fi\n  fi\n\n  lock_release\n}\n\n# 查询条目\nactive_get() {\n  local sid=\"$1\"\n  [ -f \"$ACTIVE_FILE\" ] || return\n\n  if command -v jq &>/dev/null; then\n    jq -r --arg s \"$sid\" '.[$s] // empty' \"$ACTIVE_FILE\"\n  else\n    local py=$(_resolve_py)\n    if [ -n \"$py\" ]; then\n      \"$py\" << PYEOF\nimport json\nwith open(\"$ACTIVE_FILE\", \"r\", encoding=\"utf-8\") as f:\n    d = json.load(f)\nv = d.get(\"$sid\", \"\")\nif v:\n    print(v)\nPYEOF\n    fi\n  fi\n}\n\n# 列出所有\nactive_list() {\n  _ensure_active\n  cat \"$ACTIVE_FILE\"\n}\n"},"tool_use_id":"call_864ba0fb66934c76a431edaa","tool_response":"The file D:\\development\\code\\claude-hk\\.claude\\skills\\active.sh has been updated successfully. (file state is current in your context — no need to Read it back)"}]}
