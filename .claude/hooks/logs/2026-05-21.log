 \"$CONTEXT\" ] && exit 0\n\n# 生成 session_id（PID + 时间戳）\nSESSION_ID=\"sess_$$_$(date +%s)\"\n\n# 写入 .active\nsource \"$SKILLS_DIR/active.sh\"\nactive_add \"$SESSION_ID\" \"$MATCH\" 2>/dev/null\n\n# 输出：直接传递 CONTEXT（已是完整 hook JSON），附加元数据\necho \"$SESSION_ID|$MATCH|$SKILL_ARGS\"\necho \"$CONTEXT\"\n","userModified":false},"tool_use_id":"call_242a689f4dd3400eacdfc3dd","duration_ms":29}
