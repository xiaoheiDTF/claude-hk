ls/.active\"' >> \"$file\"\n  echo 'if [ -f \"$ACTIVE_FILE\" ]; then' >> \"$file\"\n  echo '  LOCK_FILE=\"$PROJECT_DIR/.claude/skills/.active.lock\"' >> \"$file\"\n  echo '  source \"$PROJECT_DIR/.claude/skills/lock.sh\"' >> \"$file\"\n  echo '  lock_acquire \"$LOCK_FILE\" 10 2>/dev/null' >> \"$file\"\n  echo '  # 查找并删除值为当前 skill 名的条目' >> \"$file\"\n  echo '  if command -v jq &>/dev/null; then' >> \"$file\"\n  echo \"    jq 'to_entries | map(select(.value != \\\"$tag\\\")) | from_entries' \\\"\\$ACTIVE_FILE\\\" > \\\"\\$ACTIVE_FILE.tmp\\\" 2>/dev/null\" >> \"$file\"\n  echo '    [ -f \"$ACTIVE_FILE.tmp\" ] && mv \"$ACTIVE_FILE.tmp\" \"$ACTIVE_FILE\"' >> \"$file\"\n  echo '  else' >> \"$file\"\n  echo '    PY=\"$PYTHON_CMD\"' >> \"$file\"\n  echo '    [ -z \"$PY\" ] && PY=\"python3\"' >> \"$file\"\n  echo \"    \\\"\\$PY\\\" -c \\\"import json; d=json.load(open('\\$ACTIVE_FILE')); d={k:v for k,v in d.items() if v!='$tag'}; json.dump(d,open('\\$ACTIVE_FILE','w'),indent=2)\\\" 2>/dev/null\" >> \"$file\"\n  echo '  fi' >> \"$file\"\n  echo '  lock_release' >> \"$file\"\n  echo '  skill_log \"INFO\" \"[stop] .active cleaned for $SKILL_TAG\"' >> \"$file\"\n  echo 'fi' >> \"$file\"\n  echo \"\" >> \"$file\"\n  echo 'skill_log \"INFO\" \"[stop] skill lifecycle end\"' >> \"$file\"\n\n  echo \"wrote: $file\"\ndone","description":"Write all 16Stop.sh with .active cleanup"},"tool_use_id":"call_399ac1be87fc4d5cbe0fd0b0"}
