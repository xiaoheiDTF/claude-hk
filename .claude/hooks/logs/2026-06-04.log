t\t// sessions 表：记录每次 Claude Code 会话的元数据\n37\t\t\t`CREATE TABLE IF NOT EXISTS sessions (\n38\t\t\t\tid               INTEGER PRIMARY KEY AUTOINCREMENT,\n39\t\t\t\tsession_id       TEXT NOT NULL UNIQUE,\n40\t\t\t\tmachine_id       TEXT NOT NULL,\n41\t\t\t\tos               TEXT NOT NULL,\n42\t\t\t\tproject_slug     TEXT NOT NULL,\n43\t\t\t\tproject_cwd      TEXT NOT NULL,\n44\t\t\t\ttranscript_path  TEXT NOT NULL,\n45\t\t\t\tlocal_trace_path TEXT,\n46\t\t\t\tmodel            TEXT,\n47\t\t\t\tsource           TEXT,\n48\t\t\t\tstatus           TEXT NOT NULL DEFAULT 'active',\n49\t\t\t\tregistered_at    DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n50\t\t\t\tclosed_at        DATETIME,\n51\t\t\t\tclose_reason     TEXT\n52\t\t\t)`,\n53\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_machine ON sessions(machine_id)`,\n54\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_project ON sessions(project_slug)`,\n55\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_status ON sessions(status)`,\n56\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_registered ON sessions(registered_at)`,\n57\t\n58\t\t\t// issue_claims 表：存储 Issue 领取关系和状态流转\n59\t\t\t`CREATE TABLE IF NOT EXISTS issue_claims (\n60\t\t\t\tid              INTEGER PRIMARY KEY AUTOINCREMENT,\n61\t\t\t\trepo_full_name  TEXT NOT NULL,\n62\t\t\t\tissue_number    INTEGER NOT NULL,\n63\t\t\t\tissue_title     TEXT,\n64\t\t\t\tstatus          TEXT NOT NULL DEFAULT 'idle',\n65\t\t\t\tsession_id      TEXT,\n66\t\t\t\tclaimed_at      DATETIME,\n67\t\t\t\tupdated_at      DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n68\t\t\t\tUNIQUE(repo_full_name, issue_number)\n69\t\t\t)`,\n70\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_repo ON issue_claims(repo_full_name)`,\n71\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_session ON issue_claims(session_id)`,\n72\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_status ON issue_claims(status)`,\n73\t\n74\t\t\t// config 表：存储系统运行时配置\n75\t\t\t`CREATE TABLE IF NOT EXISTS config (\n76\t\t\t\tkey        TEXT PRIMARY KEY,\n77\t\t\t\tvalue      TEXT NOT NULL,\n78\t\t\t\tupdated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP\n79\t\t\t)`,\n80\t\n81\t\t\t// proxies 表：记录已注册的代理信息\n82\t\t\t`CREATE TABLE IF NOT EXISTS proxies (\n83\t\t\t\tproxy_id      TEXT PRIMARY KEY,\n84\t\t\t\tproject_slug  TEXT NOT NULL,\n85\t\t\t\tstatus        TEXT NOT NULL DEFAULT 'active',\n86\t\t\t\tregistered_at DATETIME NOT NULL,\n87\t\t\t\tlast_ping_at  DATETIME\n88\t\t\t)`,\n89\t\t\t`CREATE INDEX IF NOT EXISTS idx_proxies_status ON proxies(status)`,\n90\t\t\t`CREATE INDEX IF NOT EXISTS idx_proxies_project ON proxies(project_slug)`,\n91\t\t}\n92\t\n93\t\tlogger.Debug(\"store\", \"running %d migration statements\", len(stmts))\n94\t\tfor _, stmt := range stmts {\n95\t\t\tif _, err := db.Exec(stmt); err != nil {\n96\t\t\t\tlogger.Error(\"store\", \"migration failed: %s: %v\", stmt[:60], err)\n97\t\t\t\treturn err\n98\t\t\t}\n99\t\t\tlogger.Debug(\"store\", \"migration OK: %.60s\", stmt)\n100\t\t}\n101\t\treturn nil\n102\t}\n103\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\router.go"},"tool_use_id":"call_3e334e260a8942909b7831d9","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"net/http\"\n6\t\t\"strings\"\n7\t\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n9\t)\n10\t\n11\t// Handlers 聚合所有 HTTP 处理器的结构体。\n12\ttype Handlers struct {\n13\t\tIssue   *IssueHandler   // Issue 相关接口处理器\n14\t\tSession *SessionHandler // Session 相关接口处理器\n15\t\tProxy   *ProxyHandler   // 代理注册和 trace-init 转发处理器\n16\t\tMachine *MachineHandler // Machine 相关接口处理器\n17\t\tProject *ProjectHandler // Project 相关接口处理器\n18\t\tLog     *LogHandler     // Log 相关接口处理器\n19\t\tConfig  *ConfigHandler  // Config 相关接口处理器\n20\t\tStatus  *StatusHandler  // 系统状态处理器\n21\t}\n22\t\n23\t// NewRouter 创建并返回 HTTP 路由器，注册所有 API 端点。\n24\tfunc NewRouter(h Handlers) http.Handler {\n25\t\tmux := http.NewServeMux()\n26\t\t// 健康检查端点\n27\t\tmux.HandleFunc(\"/health\", Health)\n28\t\n29\t\t// Issue 相关路由。\n30\t\tmux.HandleFunc(\"/api/issue/check\", h.Issue.CheckIssues)         // 检查 Issue 状态\n31\t\tmux.HandleFunc(\"/api/issue/claim\", h.Issue.ClaimIssue)          // 领取 Issue\n32\t\tmux.HandleFunc(\"/api/issue/release\", h.Issue.ReleaseIssue)      // 释放 Issue\n33\t\tmux.HandleFunc(\"/api/issue/release-session\", h.Issue.ReleaseSession) // 释放会话下所有 Issue\n34\t\tmux.HandleFunc(\"/api/issue/status\", h.Issue.UpdateStatus)       // 更新 Issue 状态\n35\t\tmux.HandleFunc(\"/api/issues\", h.Issue.ListIssues)               // 列出所有 Issue\n36\t\n37\t\t// Session 相关路由。\n38\t\tmux.HandleFunc(\"/api/session/register\", h.Session.Register) // 注册会话\n39\t\tmux.HandleFunc(\"/api/session/close\", h.Session.Close)       // 关闭会话\n40\t\tmux.HandleFunc(\"/api/sessions\", h.Session.List)             // 获取会话列表\n41\t\tmux.HandleFunc(\"/api/session/\", func(w http.ResponseWriter, r *http.Request) {\n42\t\t\tpath := r.URL.Path\n43\t\t\tswitch {\n44\t\t\tcase strings.HasSuffix(path, \"/issues\"):\n45\t\t\t\th.Session.GetIssues(w, r)\n46\t\t\tcase strings.HasSuffix(path, \"/tokens\"):\n47\t\t\t\th.Session.GetTokens(w, r)\n48\t\t\tcase strings.HasSuffix(path, \"/traces\"):\n49\t\t\t\th.Session.GetTraces(w, r)\n50\t\t\tdefault:\n51\t\t\t\th.Session.Get(w, r)\n52\t\t\t}\n53\t\t})\n54\t\n55\t\t// Proxy 相关路由（代理注册 + trace-init 转发 + 代理列表）。\n56\t\tif h.Proxy != nil {\n57\t\t\tmux.HandleFunc(\"/api/proxy/register\", h.Proxy.Register)     // 代理注册\n58\t\t\tmux.HandleFunc(\"/api/proxy/unregister\", h.Proxy.Unregister) // 代理注销\n59\t\t\tmux.HandleFunc(\"/api/proxy/trace-init\", h.Proxy.TraceInit)  // 转发 trace-init\n60\t\t\tmux.HandleFunc(\"/api/proxies\", h.Proxy.List)                // 代理列表\n61\t\t}\n62\t\n63\t\t// Machine 相关路由。\n64\t\tif h.Machine != nil {\n65\t\t\tmux.HandleFunc(\"/api/machines\", h.Machine.List) // 列出所有机器\n66\t\t}\n67\t\n68\t\t// Project 相关路由。\n69\t\tif h.Project != nil {\n70\t\t\tmux.HandleFunc(\"/api/projects\", h.Project.List) // 列出所有项目\n71\t\t}\n72\t\n73\t\t// Log 相关路由。\n74\t\tif h.Log != nil {\n75\t\t\tmux.HandleFunc(\"/api/logs\", h.Log.Query) // 查询日志\n76\t\t}\n77\t\n78\t\t// Config 相关路由（GET + PUT 分发）。\n79\t\tif h.Config != nil {\n80\t\t\tmux.HandleFunc(\"/api/config\", h.Config.ServeHTTP) // 获取/更新配置\n81\t\t}\n82\t\n83\t\t// Status 相关路由。\n84\t\tif h.Status != nil {\n85\t\t\tmux.HandleFunc(\"/api/status\", h.Status.Get) // 系统状态\n86\t\t}\n87\t\n88\t\tlogger.Debug(\"api\", \"routes registered: %d endpoints\", 15)\n89\t\treturn mux\n90\t}\n91\t"},{"tool_name":"Glob","tool_input":{"pattern":"claude_tap_plus/internal/backend/domain/*.go"},"tool_use_id":"call_133051e779bf4d2b9c94b088","tool_response":"claude_tap_plus\\internal\\backend\\domain\\issue.go\nclaude_tap_plus\\internal\\backend\\domain\\machine.go\nclaude_tap_plus\\internal\\backend\\domain\\project.go\nclaude_tap_plus\\internal\\backend\\domain\\session.go\nclaude_tap_plus\\internal\\backend\\domain\\token.go"}]}
