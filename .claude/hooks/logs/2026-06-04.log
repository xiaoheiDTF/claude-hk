eStore store.MachineStore,\n137\t\tprojectStore store.ProjectStore,\n138\t) *StatusService {\n139\t\treturn &StatusService{\n140\t\t\tsessionStore: sessionStore,\n141\t\t\tproxyStore:   proxyStore,\n142\t\t\tissueStore:   issueStore,\n143\t\t\tmachineStore: machineStore,\n144\t\t\tprojectStore: projectStore,\n145\t\t}\n146\t}\n147\t\n148\t// SystemStatus 表示系统整体状态。\n149\ttype SystemStatus struct {\n150\t\tStatus        string\n151\t\tVersion       string\n152\t\tUptimeSeconds int64\n153\t\tStats         SystemStats\n154\t\tTimestamp     time.Time\n155\t}\n156\t\n157\tfunc (svc *StatusService) Get(ctx context.Context) (*SystemStatus, error) {\n158\t\tlogger.Debug(\"svc.status\", \"Get\")\n159\t\n160\t\t// 获取活跃会话数\n161\t\tactiveSessions, err := svc.countActiveSessions(ctx)\n162\t\tif err != nil {\n163\t\t\treturn nil, fmt.Errorf(\"count active sessions: %w\", err)\n164\t\t}\n165\t\n166\t\t// 获取活跃代理数\n167\t\tactiveProxies, err := svc.countActiveProxies(ctx)\n168\t\tif err != nil {\n169\t\t\treturn nil, fmt.Errorf(\"count active proxies: %w\", err)\n170\t\t}\n171\t\n172\t\t// 获取待处理 Issue 数\n173\t\tpendingIssues, err := svc.countPendingIssues(ctx)\n174\t\tif err != nil {\n175\t\t\treturn nil, fmt.Errorf(\"count pending issues: %w\", err)\n176\t\t}\n177\t\n178\t\t// 获取机器总数\n179\t\ttotalMachines, err := svc.countMachines(ctx)\n180\t\tif err != nil {\n181\t\t\treturn nil, fmt.Errorf(\"count machines: %w\", err)\n182\t\t}\n183\t\n184\t\t// 获取项目总数\n185\t\ttotalProjects, err := svc.countProjects(ctx)\n186\t\tif err != nil {\n187\t\t\treturn nil, fmt.Errorf(\"count projects: %w\", err)\n188\t\t}\n189\t\n190\t\t// 计算运行时间\n191\t\tuptime := time.Since(serverStartTime).Seconds()\n192\t\n193\t\treturn &SystemStatus{\n194\t\t\tStatus:        \"healthy\",\n195\t\t\tVersion:       \"1.0.0\",\n196\t\t\tUptimeSeconds: int64(uptime),\n197\t\t\tStats: SystemStats{\n198\t\t\t\tActiveSessions: activeSessions,\n199\t\t\t\tActiveProxies:  activeProxies,\n200\t\t\t\tPendingIssues:  pendingIssues,\n201\t\t\t\tTotalMachines:  totalMachines,\n202\t\t\t\tTotalProjects:  totalProjects,\n203\t\t\t},\n204\t\t\tTimestamp: time.Now().UTC(),\n205\t\t}, nil\n206\t}\n207\t\n208\tfunc (svc *StatusService) countActiveSessions(ctx context.Context) (int64, error) {\n209\t\tsessions, err := svc.sessionStore.ListSessions(ctx, store.SessionFilter{Status: strPtr(\"active\")})\n210\t\tif err != nil {\n211\t\t\treturn 0, err\n212\t\t}\n213\t\treturn int64(len(sessions)), nil\n214\t}\n215\t\n216\tfunc (svc *StatusService) countActiveProxies(ctx context.Context) (int64, error) {\n217\t\tproxies, err := svc.proxyStore.ListProxies(ctx, store.ProxyFilter{Status: strPtr(\"active\")})\n218\t\tif err != nil {\n219\t\t\treturn 0, err\n220\t\t}\n221\t\treturn int64(len(proxies)), nil\n222\t}\n223\t\n224\tfunc (svc *StatusService) countPendingIssues(ctx context.Context) (int64, error) {\n225\t\t// 待处理 = idle 状态的 issue\n226\t\tissues, err := svc.issueStore.ListIssues(ctx, store.IssueFilter{Status: strPtr(\"idle\")})\n227\t\tif err != nil {\n228\t\t\treturn 0, err\n229\t\t}\n230\t\treturn int64(len(issues)), nil\n231\t}\n232\t\n233\tfunc (svc *StatusService) countMachines(ctx context.Context) (int64, error) {\n234\t\tmachines, err := svc.machineStore.ListMachines(ctx, store.MachineFilter{})\n235\t\tif err != nil {\n236\t\t\treturn 0, err\n237\t\t}\n238\t\treturn int64(len(machines)), nil\n239\t}\n240\t\n241\tfunc (svc *StatusService) countProjects(ctx context.Context) (int64, error) {\n242\t\tprojects, err := svc.projectStore.ListProjects(ctx, store.ProjectFilter{})\n243\t\tif err != nil {\n244\t\t\treturn 0, err\n245\t\t}\n246\t\treturn int64(len(projects)), nil\n247\t}\n248\t\n249\tfunc strPtr(s string) *string {\n250\t\treturn &s\n251\t}\n252\t```\n253\t\n254\t### Step 3: 实现 Handler 层\n255\t\n256\t```go\n257\t// internal/backend/api/status_handler.go\n258\t\n259\tpackage api\n260\t\n261\timport (\n262\t\t\"net/http\"\n263\t\t\"time\"\n264\t\n265\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n266\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n267\t)\n268\t\n269\ttype StatusHandler struct {\n270\t\tsvc *service.StatusService\n271\t}\n272\t\n273\tfunc NewStatusHandler(svc *service.StatusService) *StatusHandler {\n274\t\treturn &StatusHandler{svc: svc}\n275\t}\n276\t\n277\tfunc (h *StatusHandler) Get(w http.ResponseWriter, r *http.Request) {\n278\t\tif r.Method != http.MethodGet {\n279\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n280\t\t\treturn\n281\t\t}\n282\t\n283\t\tlogger.Debug(\"api.status\", \"GET /api/status\")\n284\t\n285\t\tstatus, err := h.svc.Get(r.Context())\n286\t\tif err != nil {\n287\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get status\")\n288\t\t\treturn\n289\t\t}\n290\t\n291\t\twriteJSON(w, http.StatusOK, StatusResponse{\n292\t\t\tStatus:        status.Status,\n293\t\t\tVersion:       status.Version,\n294\t\t\tUptimeSeconds: status.UptimeSeconds,\n295\t\t\tStats: SystemStats{\n296\t\t\t\tActiveSessions: status.Stats.ActiveSessions,\n297\t\t\t\tActiveProxies:  status.Stats.ActiveProxies,\n298\t\t\t\tPendingIssues:  status.Stats.PendingIssues,\n299\t\t\t\tTotalMachines:  status.Stats.TotalMachines,\n300\t\t\t\tTotalProjects:  status.Stats.TotalProjects,\n301\t\t\t},\n302\t\t\tTimestamp: status.Timestamp,\n303\t\t})\n304\t}\n305\t```\n306\t\n307\t### Step 4: 注册路由\n308\t\n309\t```go\n310\t// internal/backend/api/router.go\n311\t\n312\ttype Handlers struct {\n313\t\tIssue   *IssueHandler\n314\t\tSession *SessionHandler\n315\t\tProxy   *ProxyHandler\n316\t\tMachine *MachineHandler\n317\t\tProject *ProjectHandler\n318\t\tLog     *LogHandler\n319\t\tConfig  *ConfigHandler\n320\t\tStatus  *StatusHandler // 新增\n321\t}\n322\t\n323\tfunc NewRouter(h Handlers) http.Handler {\n324\t\tmux := http.NewServeMux()\n325\t\t// ... 已有路由\n326\t\tmux.HandleFunc(\"/api/status\", h.Status.Get) // 新增\n327\t\treturn mux\n328\t}\n329\t```\n330\t\n331\t---\n332\t\n333\t## 四、Todo List\n334\t\n335\t- [ ] Step 1: 定义 StatusResponse 和 SystemStats 类型\n336\t- [ ] Step 2: 实现 StatusService（含各统计计数）\n337\t- [ ] Step 3: 实现 StatusHandler\n338\t- [ ] Step 4: 在 router.go 中注册 /api/status 路由\n339\t- [ ] Step 5: 确保各 Store 接口有 List 方法\n340\t- [ ] Step 6: 编写单元测试 status_api_test.go\n341\t- [ ] Step 7: 运行 BDD 测试验证\n342\t- [ ] Step 8: 更新 API 文档\n343\t\n344\t---\n345\t\n346\t*文档结束*\n347\t"}]}
