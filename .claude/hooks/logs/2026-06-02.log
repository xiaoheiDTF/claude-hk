[2026-06-02 23:59:04] [INFO] [PostToolBatch] Input: {"session_id":"1b51e036-fd80-4ff2-ab54-87dea13ff9e7","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\1b51e036-fd80-4ff2-ab54-87dea13ff9e7.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"auto","effort":{"level":"medium"},"hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\status_handler.go"},"tool_use_id":"call_7ead5265c59d46fb93b87867","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"net/http\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n9\t)\n10\t\n11\t// StatusHandler 处理系统状态查询。\n12\ttype StatusHandler struct {\n13\t\tsvc *service.StatusService\n14\t}\n15\t\n16\t// NewStatusHandler 创建 StatusHandler 实例。\n17\tfunc NewStatusHandler(svc *service.StatusService) *StatusHandler {\n18\t\treturn &StatusHandler{svc: svc}\n19\t}\n20\t\n21\t// Get 处理获取系统状态的请求。\n22\t// GET /api/status\n23\tfunc (h *StatusHandler) Get(w http.ResponseWriter, r *http.Request) {\n24\t\tif r.Method != http.MethodGet {\n25\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n26\t\t\treturn\n27\t\t}\n28\t\n29\t\tlogger.Debug(\"api.status\", \"GET /api/status\")\n30\t\n31\t\tstatus, err := h.svc.Get(r.Context())\n32\t\tif err != nil {\n33\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get status\")\n34\t\t\treturn\n35\t\t}\n36\t\n37\t\twriteJSON(w, http.StatusOK, StatusResponse{\n38\t\t\tStatus:        status.Status,\n39\t\t\tVersion:       status.Version,\n40\t\t\tUptimeSeconds: status.UptimeSeconds,\n41\t\t\tStats: SystemStats{\n42\t\t\t\tActiveSessions: status.Stats.ActiveSessions,\n43\t\t\t\tActiveProxies:  status.Stats.ActiveProxies,\n44\t\t\t\tPendingIssues:  status.Stats.PendingIssues,\n45\t\t\t\tTotalMachines:  status.Stats.TotalMachines,\n46\t\t\t\tTotalProjects:  status.Stats.TotalProjects,\n47\t\t\t},\n48\t\t\tTimestamp: status.Timestamp,\n49\t\t})\n50\t}\n51\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\proxy_handler.go"},"tool_use_id":"call_2ede99cdbd96484fa8962e10","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"encoding/json\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"net/http\"\n10\t\t\"sync\"\n11\t\n12\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n15\t)\n16\t\n17\t// ProxyHandler 处理代理注册、trace-init 转发和代理列表查询。\n18\ttype ProxyHandler struct {\n19\t\tmu      sync.RWMutex\n20\t\tproxies map[string]string     // pid -> proxy_url，注册的代理列表（内存）\n21\t\tsvc     *service.ProxyService // 代理列表服务（数据库）\n22\t}\n23\t\n24\t// NewProxyHandler 创建代理处理器（无数据库依赖，仅内存功能）。\n25\tfunc NewProxyHandler() *ProxyHandler {\n26\t\treturn &ProxyHandler{\n27\t\t\tproxies: make(map[string]string),\n28\t\t}\n29\t}\n30\t\n31\t// NewProxyHandlerWithService 创建带数据库服务的代理处理器。\n32\tfunc NewProxyHandlerWithService(svc *service.ProxyService) *ProxyHandler {\n33\t\treturn &ProxyHandler{\n34\t\t\tproxies: make(map[string]string),\n35\t\t\tsvc:     svc,\n36\t\t}\n37\t}\n38\t\n39\t// Register 处理代理注册请求。\n40\t// POST /api/proxy/register\n41\t// Body: {\"pid\": \"28364\", \"proxy_url\": \"http://127.0.0.1:64902\"}\n42\tfunc (h *ProxyHandler) Register(w http.ResponseWriter, r *http.Request) {\n43\t\tif r.Method != http.MethodPost {\n44\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n45\t\t\treturn\n46\t\t}\n47\t\n48\t\tvar req struct {\n49\t\t\tPID      string `json:\"pid\"`\n50\t\t\tProxyURL string `json:\"proxy_url\"`\n51\t\t}\n52\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n53\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n54\t\t\treturn\n55\t\t}\n56\t\n57\t\tif req.PID == \"\" || req.ProxyURL == \"\" {\n58\t\t\thttp.Error(w, \"pid and proxy_url required\", http.StatusBadRequest)\n59\t\t\treturn\n60\t\t}\n61\t\n62\t\th.mu.Lock()\n63\t\th.proxies[req.PID] = req.ProxyURL\n64\t\th.mu.Unlock()\n65\t\n66\t\tlogger.Info(\"api.proxy\", \"registered: pid=%s url=%s\", req.PID, req.ProxyURL)\n67\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n68\t}\n69\t\n70\t// Unregister 处理代理注销请求。\n71\t// POST /api/proxy/unregister\n72\t// Body: {\"pid\": \"28364\"}\n73\tfunc (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request) {\n74\t\tif r.Method != http.MethodPost {\n75\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n76\t\t\treturn\n77\t\t}\n78\t\n79\t\tvar req struct {\n80\t\t\tPID string `json:\"pid\"`\n81\t\t}\n82\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n83\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n84\t\t\treturn\n85\t\t}\n86\t\n87\t\th.mu.Lock()\n88\t\tdelete(h.proxies, req.PID)\n89\t\th.mu.Unlock()\n90\t\n91\t\tlogger.Info(\"api.proxy\", \"unregistered: pid=%s\", req.PID)\n92\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n93\t}\n94\t\n95\t// TraceInit 转发 trace-init 请求到所有注册的代理。\n96\t// POST /api/proxy/trace-init\n97\t// 将请求体原样转发给每个代理的 /_internal/trace-init，返回第一个成功的响应。\n98\tfunc (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request) {\n99\t\tif r.Method != http.MethodPost {\n100\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n101\t\t\treturn\n102\t\t}\n103\t\n104\t\t// 读取请求体\n105\t\tbody, err := io.ReadAll(r.Body)\n106\t\tif err != nil {\n107\t\t\thttp.Error(w, \"read body failed\", http.StatusBadRequest)\n108\t\t\treturn\n109\t\t}\n110\t\n111\t\t// 获取所有注册的代理\n112\t\th.mu.RLock()\n113\t\turls := make([]string, 0, len(h.proxies))\n114\t\tfor _, url := range h.proxies {\n115\t\t\turls = append(urls, url)\n116\t\t}\n117\t\th.mu.RUnlock()\n118\t\n119\t\tif len(urls) == 0 {\n120\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: no proxies registered\")\n121\t\t\thttp.Error(w, \"no proxies registered\", http.StatusServiceUnavailable)\n122\t\t\treturn\n123\t\t}\n124\t\n125\t\t// 转发到每个代理，返回第一个成功的响应\n126\t\tfor _, proxyURL := range urls {\n127\t\t\tresp, err := relayTraceInit(proxyURL, body)\n128\t\t\tif err != nil {\n129\t\t\t\tlogger.Debug(\"api.proxy\", \"trace-init relay to %s failed: %v\", proxyURL, err)\n130\t\t\t\tcontinue\n131\t\t\t}\n132\t\t\twriteJSON(w, http.StatusOK, resp)\n133\t\t\treturn\n134\t\t}\n135\t\n136\t\tlogger.Warn(\"api.proxy\", \"trace-init: all proxies failed\")\n137\t\thttp.Error(w, \"all proxies unreachable\", http.StatusBadGateway)\n138\t}\n139\t\n140\t// List 处理获取代理列表的请求。\n141\t// GET /api/proxies\n142\t// 查询参数：status（可选）、project（可选）\n143\tfunc (h *ProxyHandler) List(w http.ResponseWriter, r *http.Request) {\n144\t\tif r.Method != http.MethodGet {\n145\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n146\t\t\treturn\n147\t\t}\n148\t\n149\t\tvar filter store.ProxyFilter\n150\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\n151\t\t\tfilter.Status = &v\n152\t\t}\n153\t\tif v := r.URL.Query().Get(\"project\"); v != \"\" {\n154\t\t\tfilter.Project = &v\n155\t\t}\n156\t\n157\t\tlogger.Debug(\"api.proxy\", \"GET /api/proxies status=%v project=%v\", filter.Status, filter.Project)\n158\t\n159\t\tproxies, err := h.svc.List(r.Context(), filter)\n160\t\tif err != nil {\n161\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list proxies\")\n162\t\t\treturn\n163\t\t}\n164\t\n165\t\t// 确保返回空数组而非 null\n166\t\tif proxies == nil {\n167\t\t\tproxies = []store.Proxy{}\n168\t\t}\n169\t\n170\t\titems := make([]ProxyItem, len(proxies))\n171\t\tfor i, p := range proxies {\n172\t\t\titems[i] = ProxyItem{\n173\t\t\t\tProxyID:      p.ProxyID,\n174\t\t\t\tProjectSlug:  p.ProjectSlug,\n175\t\t\t\tStatus:       p.Status,\n176\t\t\t\tRegisteredAt: p.RegisteredAt,\n177\t\t\t\tLastPingAt:   p.LastPingAt,\n178\t\t\t}\n179\t\t}\n180\t\n181\t\twriteJSON(w, http.StatusOK, ProxiesResponse{\n182\t\t\tProxies: items,\n183\t\t\tTotal:   len(items),\n184\t\t})\n185\t}\n186\t\n187\t// relayTraceInit 将 trace-init 请求转发到指定代理。\n188\tfunc relayTraceInit(proxyURL string, body []byte) (map[string]any, error) {\n189\t\tclient := &http.Client{}\n190\t\treq, err := http.NewRequest(\"POST\", proxyURL+\"/_internal/trace-init\", bytes.NewReader(body))\n191\t\tif err != nil {\n192\t\t\treturn nil, err\n193\t\t}\n194\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n195\t\n196\t\tresp, err := client.Do(req)\n197\t\tif err != nil {\n198\t\t\treturn nil, err\n199\t\t}\n200\t\tdefer resp.Body.Close()\n201\t\n202\t\tif resp.StatusCode != http.StatusOK {\n203\t\t\trespBody, _ := io.ReadAll(resp.Body)\n204\t\t\treturn nil, fmt.Errorf(\"proxy returned %d: %s\", resp.StatusCode, string(respBody))\n205\t\t}\n206\t\n207\t\tvar result map[string]any\n208\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n209\t\t\treturn nil, fmt.Errorf(\"decode proxy response: %w\", err)\n210\t\t}\n211\t\treturn result, nil\n212\t}\n213\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\response.go"},"tool_use_id":"call_00cee250bfec4bfa843ed771","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"encoding/json\"\n6\t\t\"net/http\"\n7\t\t\"time\"\n8\t)\n9\t\n10\t// --- Issue response types ---\n11\t\n12\t// CheckIssuesResponse 是检查 Issue 状态的响应体。\n13\ttype CheckIssuesResponse struct {\n14\t\tIssues []IssueStatusItem `json:\"issues\"` // Issue 状态列表\n15\t}\n16\t\n17\t// IssueStatusItem 表示单个 Issue 的状态信息。\n18\ttype IssueStatusItem struct {\n19\t\tNumber    int     `json:\"number\"`     // Issue 编号\n20\t\tStatus    string  `json:\"status\"`     // 当前状态\n21\t\tSessionID *string `json:\"session_id\"` // 领取该 Issue 的会话 ID（空闲时为 null）\n22\t\tClaimedAt *string `json:\"claimed_at\"` // 领取时间（空闲时为 null）\n23\t}\n24\t\n25\t// ReleaseIssueResponse 是释放 Issue 的响应体。\n26\ttype ReleaseIssueResponse struct {\n27\t\tSuccess  bool   `json:\"success\"`           // 是否成功\n28\t\tReleased *bool  `json:\"released,omitempty\"` // 是否已释放\n29\t\tError    string `json:\"error,omitempty\"`    // 错误信息（如果有）\n30\t}\n31\t\n32\t// ClaimIssueResponse 是领取 Issue 的响应体。\n33\ttype ClaimIssueResponse struct {\n34\t\tSuccess   bool    `json:\"success\"`             // 是否成功\n35\t\tStatus    string  `json:\"status,omitempty\"`    // 领取后的状态\n36\t\tClaimedAt *string `json:\"claimed_at,omitempty\"` // 领取时间\n37\t\tError     string  `json:\"error,omitempty\"`      // 错误信息\n38\t\tClaimedBy *string `json:\"claimed_by,omitempty\"` // 已被谁领取\n39\t\tMessage   string  `json:\"message,omitempty\"`    // 提示信息\n40\t}\n41\t\n42\t// ReleaseSessionResponse 是释放会话下所有 Issue 的响应体。\n43\ttype ReleaseSessionResponse struct {\n44\t\tReleased []int `json:\"released\"` // 被释放的 Issue 编号列表\n45\t\tCount    int   `json:\"count\"`    // 释放数量\n46\t}\n47\t\n48\t// UpdateStatusResponse 是更新 Issue 状态的响应体。\n49\ttype UpdateStatusResponse struct {\n50\t\tSuccess        bool   `json:\"success\"`                  // 是否成功\n51\t\tPreviousStatus string `json:\"previous_status,omitempty\"` // 更新前的状态\n52\t\tNewStatus      string `json:\"new_status,omitempty\"`      // 更新后的状态\n53\t\tError          string `json:\"error,omitempty\"`           // 错误信息\n54\t}\n55\t\n56\t// IssuesListResponse 是 Issue 列表的响应体。\n57\ttype IssuesListResponse struct {\n58\t\tIssues     []IssueListItem `json:\"issues\"`      // Issue 列表\n59\t\tTotal      int             `json:\"total\"`       // 总数量\n60\t\tPage       int             `json:\"page\"`        // 当前页码\n61\t\tPageSize   int             `json:\"page_size\"`   // 每页大小\n62\t\tTotalPages int             `json:\"total_pages\"` // 总页数\n63\t}\n64\t\n65\t// IssueListItem 是 Issue 列表中的单个条目。\n66\ttype IssueListItem struct {\n67\t\tID           int64      `json:\"id\"`\n68\t\tRepoFullName string     `json:\"repo_full_name\"`\n69\t\tIssueNumber  int        `json:\"issue_number\"`\n70\t\tIssueTitle   *string    `json:\"issue_title\"`\n71\t\tStatus       string     `json:\"status\"`\n72\t\tSessionID    *string    `json:\"session_id\"`\n73\t\tClaimedAt    *time.Time `json:\"claimed_at\"`\n74\t\tUpdatedAt    time.Time  `json:\"updated_at\"`\n75\t}\n76\t\n77\t// --- Session response types ---\n78\t\n79\t// SessionListResponse 是会话列表的响应体。\n80\ttype SessionListResponse struct {\n81\t\tSessions []SessionListItem `json:\"sessions\"` // 会话列表\n82\t}\n83\t\n84\t// SessionIssuesResponse 是会话关联 Issue 的响应体。\n85\ttype SessionIssuesResponse struct {\n86\t\tIssues []IssueListItem `json:\"issues\"` // 会话关联的 Issue 列表\n87\t}\n88\t\n89\t// SessionTokensResponse 是会话 Token 统计的响应体。\n90\ttype SessionTokensResponse struct {\n91\t\tSessionID    string `json:\"session_id\"`\n92\t\tAPICalls     int    `json:\"api_calls\"`\n93\t\tInputTokens  int    `json:\"input_tokens\"`\n94\t\tOutputTokens int    `json:\"output_tokens\"`\n95\t\tCacheRead    int    `json:\"cache_read\"`\n96\t\tCacheCreate  int    `json:\"cache_create\"`\n97\t\tTotalTokens  int    `json:\"total_tokens\"`\n98\t}\n99\t\n100\t// SessionTracesResponse 是会话 Trace 文件列表的响应体。\n101\ttype SessionTracesResponse struct {\n102\t\tSessionID string      `json:\"session_id\"`\n103\t\tTraces    []TraceItem `json:\"traces\"`\n104\t}\n105\t\n106\t// TraceItem 是单个 Trace 文件的信息。\n107\ttype TraceItem struct {\n108\t\tPath      string `json:\"path\"`\n109\t\tSizeBytes int64  `json:\"size_bytes\"`\n110\t\tLineCount int    `json:\"line_count\"`\n111\t\tDate      string `json:\"date\"`\n112\t\tFilename  string `json:\"filename\"`\n113\t}\n114\t\n115\t// SessionListItem 是会话列表中的单个条目。\n116\ttype SessionListItem struct {\n117\t\tSessionID    string     `json:\"session_id\"`    // 会话 ID\n118\t\tMachineID    string     `json:\"machine_id\"`    // 机器 ID\n119\t\tProjectSlug  string     `json:\"project_slug\"`  // 项目标识\n120\t\tStatus       string     `json:\"status\"`        // 会话状态\n121\t\tRegisteredAt time.Time  `json:\"registered_at\"` // 注册时间\n122\t\tClosedAt     *time.Time `json:\"closed_at,omitempty\"` // 关闭时间（未关闭时为 null）\n123\t}\n124\t\n125\t// SessionDetail 是会话详情的响应体。\n126\ttype SessionDetail struct {\n127\t\tSessionID      string     `json:\"session_id\"`      // 会话 ID\n128\t\tMachineID      string     `json:\"machine_id\"`      // 机器 ID\n129\t\tOS             string     `json:\"os\"`              // 操作系统\n130\t\tProjectSlug    string     `json:\"project_slug\"`    // 项目标识\n131\t\tProjectCwd     string     `json:\"project_cwd\"`     // 项目工作目录\n132\t\tTranscriptPath string     `json:\"transcript_path\"` // 对话记录路径\n133\t\tLocalTracePath string     `json:\"local_trace_path\"` // 本地跟踪路径\n134\t\tModel          string     `json:\"model\"`           // 使用的模型\n135\t\tSource         string     `json:\"source\"`          // 来源\n136\t\tStatus         string     `json:\"status\"`          // 状态\n137\t\tRegisteredAt   time.Time  `json:\"registered_at\"`   // 注册时间\n138\t\tClosedAt       *time.Time `json:\"closed_at,omitempty\"` // 关闭时间\n139\t\tCloseReason    string     `json:\"close_reason,omitempty\"` // 关闭原因\n140\t}\n141\t\n142\t// --- Machine response types ---\n143\t\n144\t// MachinesListResponse 是机器列表的响应体。\n145\ttype MachinesListResponse struct {\n146\t\tMachines []MachineListItem `json:\"machines\"` // 机器列表\n147\t}\n148\t\n149\t// MachineListItem 是机器列表中的单个条目。\n150\ttype MachineListItem struct {\n151\t\tID          int64      `json:\"id\"`\n152\t\tMachineID   string     `json:\"machine_id\"`\n153\t\tOS          string     `json:\"os\"`\n154\t\tHostname    string     `json:\"hostname\"`\n155\t\tUsername    string     `json:\"username\"`\n156\t\tFirstSeenAt time.Time  `json:\"first_seen_at\"`\n157\t\tLastSeenAt  *time.Time `json:\"last_seen_at\"`\n158\t}\n159\t\n160\t// --- Project response types ---\n161\t\n162\t// ProjectsListResponse 是项目列表的响应体。\n163\ttype ProjectsListResponse struct {\n164\t\tProjects []ProjectListItem `json:\"projects\"` // 项目列表\n165\t}\n166\t\n167\t// ProjectListItem 是项目列表中的单个条目。\n168\ttype ProjectListItem struct {\n169\t\tID          int64     `json:\"id\"`\n170\t\tProjectSlug string    `json:\"project_slug\"`\n171\t\tProjectCwd  string    `json:\"project_cwd\"`\n172\t\tFirstSeenAt time.Time `json:\"first_seen_at\"`\n173\t\tLastSeenAt  time.Time `json:\"last_seen_at\"`\n174\t}\n175\t\n176\t// --- Config response types ---\n177\t\n178\t// ConfigResponse 是配置查询/更新的响应体。\n179\ttype ConfigResponse struct {\n180\t\tConfig map[string]interface{} `json:\"config\"` // 配置项键值对\n181\t}\n182\t\n183\t// --- Log response types ---\n184\t\n185\t// LogsResponse 是日志查询的响应体。\n186\ttype LogsResponse struct {\n187\t\tLogs []LogItem `json:\"logs\"` // 日志条目列表\n188\t}\n189\t\n190\t// LogItem 是单条日志记录。\n191\ttype LogItem struct {\n192\t\tTimestamp string `json:\"timestamp\"` // 时间戳，如 \"2026-06-01 20:56:28.000\"\n193\t\tLevel     string `json:\"level\"`     // 日志级别：DEBUG/INFO/WARN/ERROR\n194\t\tSource    string `json:\"source\"`    // 来源模块\n195\t\tMessage   string `json:\"message\"`   // 日志内容\n196\t}\n197\t\n198\t// --- Proxy response types ---\n199\t\n200\t// ProxiesResponse 是代理列表的响应体。\n201\ttype ProxiesResponse struct {\n202\t\tProxies []ProxyItem `json:\"proxies\"` // 代理列表\n203\t\tTotal   int         `json:\"total\"`   // 总数量\n204\t}\n205\t\n206\t// ProxyItem 是代理列表中的单个条目。\n207\ttype ProxyItem struct {\n208\t\tProxyID      string     `json:\"proxy_id\"`                // 代理唯一 ID\n209\t\tProjectSlug  string     `json:\"project_slug\"`            // 项目标识\n210\t\tStatus       string     `json:\"status\"`                  // 状态：active/offline\n211\t\tRegisteredAt time.Time  `json:\"registered_at\"`           // 注册时间\n212\t\tLastPingAt   *time.Time `json:\"last_ping_at,omitempty\"`  // 最后心跳时间\n213\t}\n214\t\n215\t// --- Status response types ---\n216\t\n217\t// StatusResponse 是系统状态的响应体。\n218\ttype StatusResponse struct {\n219\t\tStatus        string     `json:\"status\"`         // 系统状态：healthy\n220\t\tVersion       string     `json:\"version\"`        // 版本号\n221\t\tUptimeSeconds int64      `json:\"uptime_seconds\"` // 运行时间（秒）\n222\t\tStats         SystemStats `json:\"stats\"`          // 统计信息\n223\t\tTimestamp     time.Time  `json:\"timestamp\"`      // 时间戳\n224\t}\n225\t\n226\t// SystemStats 是系统统计信息的响应结构。\n227\ttype SystemStats struct {\n228\t\tActiveSessions int64 `json:\"active_sessions\"` // 活跃会话数\n229\t\tActiveProxies  int64 `json:\"active_proxies\"`  // 活跃代理数\n230\t\tPendingIssues  int64 `json:\"pending_issues\"`  // 待处理 Issue 数\n231\t\tTotalMachines  int64 `json:\"total_machines\"`  // 机器总数\n232\t\tTotalProjects  int64 `json:\"total_projects\"`  // 项目总数\n233\t}\n234\t\n235\t// --- Shared helpers ---\n236\t\n237\t// APIError 是统一的 API 错误结构体。\n238\ttype APIError struct {\n239\t\tCode    string `json:\"error\"`   // 错误码\n240\t\tMessage string `json:\"message\"` // 错误描述\n241\t}\n242\t\n243\t// writeJSON 向响应中写入 JSON 数据，设置 Content-Type 为 application/json。\n244\tfunc writeJSON(w http.ResponseWriter, status int, v any) {\n245\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n246\t\tw.WriteHeader(status)\n247\t\tjson.NewEncoder(w).Encode(v)\n248\t}\n249\t\n250\t// writeError 向响应中写入统一的 API 错误信息。\n251\tfunc writeError(w http.ResponseWriter, status int, code, message string) {\n252\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n253\t\tw.WriteHeader(status)\n254\t\tjson.NewEncoder(w).Encode(APIError{Code: code, Message: message})\n255\t}\n256\t"}]}
