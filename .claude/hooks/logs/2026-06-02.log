\t  export LC_ALL=\"${LC_ALL:-en_US.UTF-8}\"\n28\t\n29\t  if [ \"$os_type\" = \"windows\" ]; then\n30\t    chcp.com 65001 > /dev/null 2>&1\n31\t    log \"INFO\" \"Windows code page set to 65001\"\n32\t  fi\n33\t\n34\t  log \"INFO\" \"UTF-8 ensured (OS=$os_type, LANG=$LANG)\"\n35\t}\n36\t\n37\t# 2. Python 可用性（巡检 + 自动修复）\n38\tensure_python_check() {\n39\t  source \"$CLAUDE_PROJECT_DIR/.claude/scripts/ensure_python.sh\"\n40\t  local result\n41\t  result=$(ensure_python)\n42\t  if [ -n \"$result\" ]; then\n43\t    log \"INFO\" \"Python 已就绪: $result\"\n44\t  else\n45\t    log \"WARN\" \"Python 不可用，部分功能受限\"\n46\t  fi\n47\t}\n48\t\n49\t# 3. 目录完整性\n50\tensure_dirs() {\n51\t  source \"$CLAUDE_PROJECT_DIR/.claude/scripts/ensure_dirs.sh\"\n52\t  local missing\n53\t  missing=$(check_dirs 2>&1)\n54\t  if [ \"$missing\" = \"ALL OK\" ]; then\n55\t    log \"INFO\" \"目录检查通过\"\n56\t  else\n57\t    log \"WARN\" \"目录缺失，重新创建: $missing\"\n58\t    ensure_all_dirs \"$LOG_FILE\" > /dev/null\n59\t  fi\n60\t}\n61\t\n62\tensure_utf8\n63\tensure_python_check\n64\tensure_dirs\n65\t\n66\t# 4. Skill 级巡检\n67\tensure_skill_checks() {\n68\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n69\t  [ -d \"$skills_dir\" ] || return\n70\t  for check_script in \"$skills_dir\"/*/scripts/init_check.sh; do\n71\t    [ -f \"$check_script\" ] || continue\n72\t    local skill_name\n73\t    skill_name=$(basename \"$(dirname \"$(dirname \"$check_script\")\")\")\n74\t    if bash \"$check_script\" >> \"$LOG_FILE\" 2>&1; then\n75\t      log \"INFO\" \"Skill check OK: $skill_name\"\n76\t    else\n77\t      log \"WARN\" \"Skill check failed: $skill_name (non-blocking)\"\n78\t    fi\n79\t  done\n80\t}\n81\t\n82\tensure_skill_checks\n83\t\n84\t# 5. 初始化代理 trace 路径（通过后端 8080 转发到代理）\n85\tinit_trace_path() {\n86\t  if ! _backend_available; then\n87\t    log \"DEBUG\" \"Trace init skipped (backend/proxy unreachable)\"\n88\t    return 0\n89\t  fi\n90\t\n91\t  local sid\n92\t  sid=$(json_get '.session_id')\n93\t  [ -z \"$sid\" ] && return 0\n94\t\n95\t  local machine_id\n96\t  machine_id=\"$(whoami 2>/dev/null || echo unknown)@$(hostname 2>/dev/null || echo unknown)\"\n97\t\n98\t  local transcript_path\n99\t  transcript_path=$(json_get '.transcript_path')\n100\t\n101\t  local project_slug\n102\t  project_slug=$(echo \"$transcript_path\" | sed -n 's/.*[\\.]claude[\\\\/]\\{1\\}projects[\\\\/]\\{1\\}\\([^\\\\/]*\\).*/\\1/p')\n103\t  [ -z \"$project_slug\" ] && project_slug=$(basename \"$(json_get '.cwd')\" 2>/dev/null)\n104\t\n105\t  # Windows 路径反斜杠转义：\\ → \\\\（否则 Go JSON 解析器拒绝非法转义序列如 \\U）\n106\t  local safe_transcript_path=\"${transcript_path//\\\\/\\\\\\\\}\"\n107\t\n108\t  # 通过后端转发 trace-init 到代理\n109\t  local result\n110\t  result=$(_call_backend \"/api/proxy/trace-init\" \"{\n111\t    \\\"session_id\\\":\\\"$sid\\\",\n112\t    \\\"machine_id\\\":\\\"$machine_id\\\",\n113\t    \\\"project_slug\\\":\\\"$project_slug\\\",\n114\t    \\\"transcript_path\\\":\\\"$safe_transcript_path\\\"\n115\t  }\")\n116\t\n117\t  if [ -n \"$result\" ]; then\n118\t    log \"INFO\" \"Trace initialized: $(echo \"$result\" | jq -r '.trace_path // \"unknown\"' 2>/dev/null)\"\n119\t  else\n120\t    log \"DEBUG\" \"Trace init failed (backend call returned empty)\"\n121\t  fi\n122\t}\n123\t\n124\tinit_trace_path\n125\t\n126\t# 6. 注册会话到后端（SR-2）\n127\tregister_session() {\n128\t  if ! _backend_available; then\n129\t    log \"DEBUG\" \"Backend unreachable, skipping session registration\"\n130\t    return 0\n131\t  fi\n132\t\n133\t  local session_id transcript_path cwd model source_type os_type machine_id project_slug\n134\t\n135\t  session_id=$(json_get '.session_id')\n136\t  [ -z \"$session_id\" ] && return 0\n137\t\n138\t  transcript_path=$(json_get '.transcript_path')\n139\t  cwd=$(json_get '.cwd')\n140\t  model=$(json_get '.model')\n141\t  source_type=$(json_get '.source')\n142\t\n143\t  machine_id=\"$(whoami 2>/dev/null || echo unknown)@$(hostname 2>/dev/null || echo unknown)\"\n144\t\n145\t  case \"$(uname -s)\" in\n146\t    Linux*)   os_type=\"linux\" ;;\n147\t    Darwin*)  os_type=\"macos\" ;;\n148\t    MINGW*|MSYS*|CYGWIN*) os_type=\"windows\" ;;\n149\t    *)        os_type=\"unknown\" ;;\n150\t  esac\n151\t\n152\t  project_slug=$(echo \"$transcript_path\" | sed -n 's/.*[\\.]claude[\\\\/]\\{1\\}projects[\\\\/]\\{1\\}\\([^\\\\/]*\\).*/\\1/p')\n153\t  [ -z \"$project_slug\" ] && project_slug=$(basename \"$cwd\" 2>/dev/null)\n154\t\n155\t  # Windows 路径反斜杠转义\n156\t  local safe_cwd=\"${cwd//\\\\/\\\\\\\\}\"\n157\t  local safe_transcript_path=\"${transcript_path//\\\\/\\\\\\\\}\"\n158\t\n159\t  _call_backend \"/api/session/register\" \"{\n160\t    \\\"session_id\\\":\\\"$session_id\\\",\n161\t    \\\"machine_id\\\":\\\"$machine_id\\\",\n162\t    \\\"os\\\":\\\"$os_type\\\",\n163\t    \\\"project_slug\\\":\\\"$project_slug\\\",\n164\t    \\\"project_cwd\\\":\\\"$safe_cwd\\\",\n165\t    \\\"transcript_path\\\":\\\"$safe_transcript_path\\\",\n166\t    \\\"model\\\":\\\"$model\\\",\n167\t    \\\"source\\\":\\\"$source_type\\\"\n168\t  }\" > /dev/null 2>&1\n169\t\n170\t  log \"INFO\" \"Session registered to backend: $session_id\"\n171\t}\n172\t\n173\tregister_session\n174\t\n175\thook_output 0 '{}'\n176\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\base.sh"},"tool_use_id":"call_7ca16e6c1bf8484f87f03e94","tool_response":"1\t#!/bin/bash\n2\t# Hooks Base Script\n3\t# 1. 平台感知 (platform.sh)\n4\t# 2. 从 stdin 读取 JSON\n5\t# 3. 解析字段\n6\t# 4. 按日期写入日志，带 [EventName] 前缀\n7\t# 5. 输出结果 JSON\n8\t\n9\tHOOKS_DIR=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"\n10\tLOG_DIR=\"$HOOKS_DIR/logs\"\n11\tmkdir -p \"$LOG_DIR\"\n12\t\n13\tsource \"$HOOKS_DIR/platform.sh\"\n14\t\n15\tHOOK_INPUT=$(cat)\n16\tLOG_FILE=\"$LOG_DIR/$(date +%Y-%m-%d).log\"\n17\t\n18\t_log_raw() {\n19\t  echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [$1] $2\" >> \"$LOG_FILE\"\n20\t}\n21\t\n22\tjson_get() {\n23\t  local key=\"$1\"\n24\t  if [ -z \"$HOOK_INPUT\" ]; then echo \"\"; return; fi\n25\t  if command -v jq &>/dev/null; then\n26\t    printf '%s' \"$HOOK_INPUT\" | jq -r \"$key\" 2>/dev/null\n27\t    return\n28\t  fi\n29\t  if [ -n \"$PYTHON_CMD\" ]; then\n30\t    printf '%s' \"$HOOK_INPUT\" | \"$PYTHON_CMD\" \"$HOOKS_DIR/json_get.py\" \"$key\" 2>>\"$LOG_FILE\"\n31\t    return\n32\t  fi\n33\t  # 纯 sed fallback：提取 .key 或 .\"key\" 格式的顶层字段\n34\t  local bare_key=\"${key#.}\"\n35\t  printf '%s' \"$HOOK_INPUT\" | sed -n \"s/.*\\\"${bare_key}\\\"[[:space:]]*:[[:space:]]*\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" | head -1\n36\t}\n37\t\n38\tHOOK_EVENT=$(json_get '.hook_event_name')\n39\t[ -z \"$HOOK_EVENT\" ] && HOOK_EVENT=\"UNKNOWN\"\n40\t\n41\tlog() {\n42\t  echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [$1] [$HOOK_EVENT] $2\" >> \"$LOG_FILE\"\n43\t}\n44\t\n45\tlog \"DEBUG\" \"os=$OS_TYPE python=$PYTHON_CMD\"\n46\tlog \"INFO\" \"Input: $HOOK_INPUT\"\n47\t\n48\thook_output() {\n49\t  local exit_code=\"${1:-0}\"\n50\t  local json=\"${2:-{}}\"\n51\t  log \"INFO\" \"Output (exit=$exit_code): $json\"\n52\t  echo \"$json\"\n53\t  exit \"$exit_code\"\n54\t}\n55\t\n56\t# Skill 感知分发：根据 .active 中的 session_id 匹配活跃 skill，\n57\t# 调用对应 skill 目录下的生命周期脚本。\n58\t# 用法: dispatch_to_skill \"05\" [额外参数...]\n59\t# 返回: 0=成功或无活跃 skill，非 0=skill 脚本执行失败\n60\t# stdout: skill 脚本的输出（如有）\n61\tdispatch_to_skill() {\n62\t  local event_num=\"$1\"\n63\t  shift\n64\t\n65\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n66\t  local active_file=\"$skills_dir/.active\"\n67\t\n68\t  # 无 .active 或为空 → 跳过\n69\t  [ -s \"$active_file\" ] || return 0\n70\t\n71\t  # 获取当前 session_id\n72\t  local sid\n73\t  sid=$(json_get '.session_id')\n74\t  [ -z \"$sid\" ] && return 0\n75\t\n76\t  # 查找当前 session 激活的 skill\n77\t  source \"$skills_dir/active.sh\"\n78\t  local skill_name\n79\t  skill_name=$(active_get \"$sid\")\n80\t  [ -z \"$skill_name\" ] && return 0\n81\t\n82\t  # 按事件编号映射脚本名\n83\t  local script_name\n84\t  case \"$event_num\" in\n85\t    02) script_name=\"02Setup\" ;;\n86\t    04) script_name=\"04UserPromptExpansion\" ;;\n87\t    05) script_name=\"05PreToolUse\" ;;\n88\t    06) script_name=\"06PermissionRequest\" ;;\n89\t    07) script_name=\"07PermissionDenied\" ;;\n90\t    08) script_name=\"08PostToolUse\" ;;\n91\t    09) script_name=\"09PostToolUseFailure\" ;;\n92\t    10) script_name=\"10PostToolBatch\" ;;\n93\t    11) script_name=\"11Notification\" ;;\n94\t    12) script_name=\"12SubagentStart\" ;;\n95\t    13) script_name=\"13SubagentStop\" ;;\n96\t    14) script_name=\"14TaskCreated\" ;;\n97\t    15) script_name=\"15TaskCompleted\" ;;\n98\t    17) script_name=\"17StopFailure\" ;;\n99\t    18) script_name=\"18TeammateIdle\" ;;\n100\t    19) script_name=\"19InstructionsLoaded\" ;;\n101\t    20) script_name=\"20ConfigChange\" ;;\n102\t    21) script_name=\"21CwdChanged\" ;;\n103\t    22) script_name=\"22FileChanged\" ;;\n104\t    23) script_name=\"23WorktreeCreate\" ;;\n105\t    24) script_name=\"24WorktreeRemove\" ;;\n106\t    25) script_name=\"25PreCompact\" ;;\n107\t    26) script_name=\"26PostCompact\" ;;\n108\t    27) script_name=\"27Elicitation\" ;;\n109\t    28) script_name=\"28ElicitationResult\" ;;\n110\t    29) script_name=\"29SessionEnd\" ;;\n111\t    *) return 0 ;;\n112\t  esac\n113\t\n114\t  local script_path=\"$skills_dir/$skill_name/scripts/$script_name.sh\"\n115\t  [ -f \"$script_path\" ] || return 0\n116\t\n117\t  log \"INFO\" \"Dispatching to skill=$skill_name script=$script_name.sh\"\n118\t  bash \"$script_path\" \"$@\" 2>>\"$LOG_FILE\"\n119\t}\n120\t"}]}
