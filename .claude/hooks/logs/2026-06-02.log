n88\t\t\tsrv.Shutdown(context.Background())\n89\t\t\tcancel() // 停止 watchdog 自身\n90\t\t})\n91\t\tgo watchdog.Run(ctx)\n92\t\n93\t\tgo func() {\n94\t\t\t<-quit\n95\t\t\tlogger.Info(\"backend\", \"shutdown signal received\")\n96\t\t\tcancel() // 停止 watchdog\n97\t\t\tsrv.Shutdown(context.Background())\n98\t\t}()\n99\t\n100\t\tlogger.Info(\"backend\", \"backend listening on %s\", s.cfg.Addr())\n101\t\tif err := srv.ListenAndServe(); err != http.ErrServerClosed {\n102\t\t\treturn err\n103\t\t}\n104\t\treturn nil\n105\t}\n106\t\n107\t// Close 关闭后端服务器及其数据库连接。\n108\tfunc (s *Server) Close() error {\n109\t\terr := s.store.Close()\n110\t\tlogger.Info(\"backend\", \"backend server closed\")\n111\t\treturn err\n112\t}\n113\t"}]}
