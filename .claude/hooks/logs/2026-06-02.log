CRIPT_PATH\"\nskill_log \"INFO\" \"执行完成: $SCRIPT_PATH (退出码: $?)\"\n","numLines":48,"startLine":1,"totalLines":48}},"tool_use_id":"call_b13888a1575f4624951733ff","duration_ms":1}
