t\tt.Helper()\n109\t\tdefer resp.Body.Close()\n110\t\tb, err := io.ReadAll(resp.Body)\n111\t\tif err != nil {\n112\t\t\tt.Fatal(err)\n113\t\t}\n114\t\tvar result proxyListResponse\n115\t\tif err := json.Unmarshal(b, &result); err != nil {\n116\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n117\t\t}\n118\t\treturn result\n119\t}\n120\t\n121\t// seedProxyData 在数据库中预置 BDD Background 中的 3 条代理数据。\n122\t//   proxy-1 | project-a | active  | 2026-06-01T10:00:00Z\n123\t//   proxy-2 | project-b | active  | 2026-06-01T11:00:00Z\n124\t//   proxy-3 | project-a | offline | 2026-06-01T09:00:00Z\n125\tfunc seedProxyData(t *testing.T, env *proxyTestEnv) {\n126\t\tt.Helper()\n127\t\tdb := env.store.DB()\n128\t\tinserts := []struct {\n129\t\t\tid, project, status, registeredAt string\n130\t\t}{\n131\t\t\t{\"proxy-1\", \"project-a\", \"active\", \"2026-06-01 10:00:00\"},\n132\t\t\t{\"proxy-2\", \"project-b\", \"active\", \"2026-06-01 11:00:00\"},\n133\t\t\t{\"proxy-3\", \"project-a\", \"offline\", \"2026-06-01 09:00:00\"},\n134\t\t}\n135\t\tfor _, ins := range inserts {\n136\t\t\t_, err := db.Exec(\n137\t\t\t\t`INSERT INTO proxies (proxy_id, project_slug, status, registered_at) VALUES (?, ?, ?, ?)`,\n138\t\t\t\tins.id, ins.project, ins.status, ins.registeredAt)\n139\t\t\tif err != nil {\n140\t\t\t\tt.Fatalf(\"seed proxy %s: %v\", ins.id, err)\n141\t\t\t}\n142\t\t}\n143\t}\n144\t\n145\t// --- BDD Scenario tests ---\n146\t\n147\t// TestListProxies_GetAll 验证：获取所有代理列表。\n148\t// BDD: @positive Scenario: 获取所有代理列表\n149\tfunc TestListProxies_GetAll(t *testing.T) {\n150\t\tenv := setupProxyTest(t)\n151\t\tseedProxyData(t, env)\n152\t\n153\t\tresp := env.get(t, \"/api/proxies\")\n154\t\tresult := readProxyListResponse(t, resp)\n155\t\n156\t\tif resp.StatusCode != http.StatusOK {\n157\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n158\t\t}\n159\t\tif result.Total != 3 {\n160\t\t\tt.Fatalf(\"expected total=3, got %d\", result.Total)\n161\t\t}\n162\t\tif len(result.Proxies) != 3 {\n163\t\t\tt.Fatalf(\"expected 3 proxies, got %d\", len(result.Proxies))\n164\t\t}\n165\t\n166\t\t// 验证每个代理包含必要字段\n167\t\tfor _, p := range result.Proxies {\n168\t\t\tif p.ProxyID == \"\" {\n169\t\t\t\tt.Error(\"expected non-empty proxy_id\")\n170\t\t\t}\n171\t\t\tif p.ProjectSlug == \"\" {\n172\t\t\t\tt.Error(\"expected non-empty project_slug\")\n173\t\t\t}\n174\t\t\tif p.Status == \"\" {\n175\t\t\t\tt.Error(\"expected non-empty status\")\n176\t\t\t}\n177\t\t\tif p.RegisteredAt == \"\" {\n178\t\t\t\tt.Error(\"expected non-empty registered_at\")\n179\t\t\t}\n180\t\t}\n181\t}\n182\t\n183\t// TestListProxies_FilterByStatus 验证：按状态过滤代理。\n184\t// BDD: @positive Scenario: 按状态过滤代理\n185\tfunc TestListProxies_FilterByStatus(t *testing.T) {\n186\t\tenv := setupProxyTest(t)\n187\t\tseedProxyData(t, env)\n188\t\n189\t\tresp := env.get(t, \"/api/proxies?status=active\")\n190\t\tresult := readProxyListResponse(t, resp)\n191\t\n192\t\tif resp.StatusCode != http.StatusOK {\n193\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n194\t\t}\n195\t\tif len(result.Proxies) != 2 {\n196\t\t\tt.Fatalf(\"expected 2 proxies, got %d\", len(result.Proxies))\n197\t\t}\n198\t\tfor _, p := range result.Proxies {\n199\t\t\tif p.Status != \"active\" {\n200\t\t\t\tt.Errorf(\"expected status=active, got %s\", p.Status)\n201\t\t\t}\n202\t\t}\n203\t}\n204\t\n205\t// TestListProxies_FilterByProject 验证：按项目过滤代理。\n206\t// BDD: @positive Scenario: 按项目过滤代理\n207\tfunc TestListProxies_FilterByProject(t *testing.T) {\n208\t\tenv := setupProxyTest(t)\n209\t\tseedProxyData(t, env)\n210\t\n211\t\tresp := env.get(t, \"/api/proxies?project=project-a\")\n212\t\tresult := readProxyListResponse(t, resp)\n213\t\n214\t\tif resp.StatusCode != http.StatusOK {\n215\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n216\t\t}\n217\t\tif len(result.Proxies) != 2 {\n218\t\t\tt.Fatalf(\"expected 2 proxies, got %d\", len(result.Proxies))\n219\t\t}\n220\t\tfor _, p := range result.Proxies {\n221\t\t\tif p.ProjectSlug != \"project-a\" {\n222\t\t\t\tt.Errorf(\"expected project_slug=project-a, got %s\", p.ProjectSlug)\n223\t\t\t}\n224\t\t}\n225\t}\n226\t\n227\t// TestListProxies_CombinedFilter 验证：组合过滤代理。\n228\t// BDD: @positive Scenario: 组合过滤代理\n229\tfunc TestListProxies_CombinedFilter(t *testing.T) {\n230\t\tenv := setupProxyTest(t)\n231\t\tseedProxyData(t, env)\n232\t\n233\t\tresp := env.get(t, \"/api/proxies?status=active&project=project-a\")\n234\t\tresult := readProxyListResponse(t, resp)\n235\t\n236\t\tif resp.StatusCode != http.StatusOK {\n237\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n238\t\t}\n239\t\tif len(result.Proxies) != 1 {\n240\t\t\tt.Fatalf(\"expected 1 proxy, got %d\", len(result.Proxies))\n241\t\t}\n242\t\tif result.Proxies[0].ProxyID != \"proxy-1\" {\n243\t\t\tt.Errorf(\"expected proxy_id=proxy-1, got %s\", result.Proxies[0].ProxyID)\n244\t\t}\n245\t}\n246\t\n247\t// TestListProxies_EmptyResult 验证：无代理时返回空列表。\n248\t// BDD: @positive Scenario: 无代理时返回空列表\n249\tfunc TestListProxies_EmptyResult(t *testing.T) {\n250\t\tenv := setupProxyTest(t)\n251\t\n252\t\tresp := env.get(t, \"/api/proxies\")\n253\t\tresult := readProxyListResponse(t, resp)\n254\t\n255\t\tif resp.StatusCode != http.StatusOK {\n256\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n257\t\t}\n258\t\tif result.Total != 0 {\n259\t\t\tt.Fatalf(\"expected total=0, got %d\", result.Total)\n260\t\t}\n261\t\tif len(result.Proxies) != 0 {\n262\t\t\tt.Fatalf(\"expected empty proxies array, got %d items\", len(result.Proxies))\n263\t\t}\n264\t}\n265\t\n266\t// TestListProxies_MethodNotAllowed 验证：使用非 GET 方法请求返回 405。\n267\t// BDD: @negative Scenario: 使用非 GET 方法请求\n268\tfunc TestListProxies_MethodNotAllowed(t *testing.T) {\n269\t\tenv := setupProxyTest(t)\n270\t\n271\t\tresp := env.post(t, \"/api/proxies\", \"\")\n272\t\tdefer resp.Body.Close()\n273\t\n274\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n275\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n276\t\t}\n277\t\n278\t\tvar errResp struct {\n279\t\t\tCode    string `json:\"error\"`\n280\t\t\tMessage string `json:\"message\"`\n281\t\t}\n282\t\treadJSON(t, resp, &errResp)\n283\t\tif errResp.Code != \"method_not_allowed\" {\n284\t\t\tt.Errorf(\"expected error=method_not_allowed, got %s\", errResp.Code)\n285\t\t}\n286\t}\n287\t"}]}
