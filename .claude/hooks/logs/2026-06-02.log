 *httptest.Server\n43\t\tstore     *store.SQLiteStore\n44\t\tstartTime time.Time\n45\t}\n46\t\n47\t// setupStatusTest 创建状态测试环境，包含 Status handler。\n48\tfunc setupStatusTest(t *testing.T) *statusTestEnv {\n49\t\tt.Helper()\n50\t\n51\t\tf, err := os.CreateTemp(\"\", \"test-status-*.db\")\n52\t\tif err != nil {\n53\t\t\tt.Fatal(err)\n54\t\t}\n55\t\tdbPath := f.Name()\n56\t\tf.Close()\n57\t\n58\t\ts, err := store.NewSQLiteStore(dbPath)\n59\t\tif err != nil {\n60\t\t\tos.Remove(dbPath)\n61\t\t\tt.Fatal(err)\n62\t\t}\n63\t\n64\t\tt.Cleanup(func() {\n65\t\t\ts.Close()\n66\t\t\tos.Remove(dbPath)\n67\t\t})\n68\t\n69\t\tstartTime := time.Now().Add(-3600 * time.Second) // 模拟已运行 3600 秒\n70\t\n71\t\tissueSvc := service.NewIssueService(s.Issues())\n72\t\tsessionSvc := service.NewSessionService(s.Sessions())\n73\t\tmachineSvc := service.NewMachineService(s.Machines())\n74\t\tprojectSvc := service.NewProjectService(s.Projects())\n75\t\tproxySvc := service.NewProxyService(s.Proxies())\n76\t\tstatusSvc := service.NewStatusService(\n77\t\t\ts.Sessions(), s.Proxies(),\n78\t\t\ts.Issues(), s.Machines(), s.Projects(),\n79\t\t\tstartTime,\n80\t\t)\n81\t\n82\t\trouter := api.NewRouter(api.Handlers{\n83\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n84\t\t\tSession: api.NewSessionHandler(sessionSvc, issueSvc, service.NewTokenService(s.Sessions()), service.NewTraceService(s.Sessions())),\n85\t\t\tMachine: api.NewMachineHandler(machineSvc),\n86\t\t\tProject: api.NewProjectHandler(projectSvc),\n87\t\t\tProxy:   api.NewProxyHandlerWithService(proxySvc),\n88\t\t\tStatus:  api.NewStatusHandler(statusSvc),\n89\t\t})\n90\t\n91\t\tsrv := httptest.NewServer(router)\n92\t\tt.Cleanup(srv.Close)\n93\t\n94\t\treturn &statusTestEnv{srv: srv, store: s, startTime: startTime}\n95\t}\n96\t\n97\tfunc (e *statusTestEnv) get(t *testing.T, path string) *http.Response {\n98\t\tt.Helper()\n99\t\tresp, err := http.Get(e.srv.URL + path)\n100\t\tif err != nil {\n101\t\t\tt.Fatal(err)\n102\t\t}\n103\t\treturn resp\n104\t}\n105\t\n106\tfunc (e *statusTestEnv) post(t *testing.T, path, body string) *http.Response {\n107\t\tt.Helper()\n108\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n109\t\tif err != nil {\n110\t\t\tt.Fatal(err)\n111\t\t}\n112\t\treturn resp\n113\t}\n114\t\n115\t// readStatusResponse 读取并解析状态响应。\n116\tfunc readStatusResponse(t *testing.T, resp *http.Response) statusResponse {\n117\t\tt.Helper()\n118\t\tdefer resp.Body.Close()\n119\t\tb, err := io.ReadAll(resp.Body)\n120\t\tif err != nil {\n121\t\t\tt.Fatal(err)\n122\t\t}\n123\t\tvar result statusResponse\n124\t\tif err := json.Unmarshal(b, &result); err != nil {\n125\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n126\t\t}\n127\t\treturn result\n128\t}\n129\t\n130\t// seedStatusData 通过各 API 预置 BDD Background 中的数据：\n131\t//   3 活跃会话、2 活跃代理、5 待处理 Issue、4 机器、2 项目\n132\tfunc seedStatusData(t *testing.T, env *statusTestEnv) {\n133\t\tt.Helper()\n134\t\tdb := env.store.DB()\n135\t\tnow := time.Now().Format(\"2006-01-02 15:04:05\")\n136\t\n137\t\t// 插入 4 台机器\n138\t\tfor _, m := range []struct {\n139\t\t\tmid, os, host, user string\n140\t\t}{\n141\t\t\t{\"user@host-1\", \"linux\", \"host-1\", \"user\"},\n142\t\t\t{\"dev@host-2\", \"windows\", \"host-2\", \"dev\"},\n143\t\t\t{\"admin@host-3\", \"macos\", \"host-3\", \"admin\"},\n144\t\t\t{\"extra@host-4\", \"linux\", \"host-4\", \"extra\"},\n145\t\t} {\n146\t\t\t_, err := db.Exec(\n147\t\t\t\t`INSERT OR IGNORE INTO machines (machine_id, os, hostname, username, first_seen_at) VALUES (?, ?, ?, ?, ?)`,\n148\t\t\t\tm.mid, m.os, m.host, m.user, now)\n149\t\t\tif err != nil {\n150\t\t\t\tt.Fatalf(\"seed machine %s: %v\", m.mid, err)\n151\t\t\t}\n152\t\t}\n153\t\n154\t\t// 插入 2 个项目\n155\t\tfor _, p := range []struct {\n156\t\t\tslug, cwd string\n157\t\t}{\n158\t\t\t{\"proj-a\", \"/tmp/proj-a\"},\n159\t\t\t{\"proj-b\", \"/tmp/proj-b\"},\n160\t\t} {\n161\t\t\t_, err := db.Exec(\n162\t\t\t\t`INSERT OR IGNORE INTO projects (project_slug, project_cwd, first_seen_at, last_seen_at) VALUES (?, ?, ?, ?)`,\n163\t\t\t\tp.slug, p.cwd, now, now)\n164\t\t\tif err != nil {\n165\t\t\t\tt.Fatalf(\"seed project %s: %v\", p.slug, err)\n166\t\t\t}\n167\t\t}\n168\t\n169\t\t// 插入 3 个活跃会话\n170\t\tfor i, s := range []struct {\n171\t\t\tsid, mid, os, proj string\n172\t\t}{\n173\t\t\t{\"sess-s1\", \"user@host-1\", \"linux\", \"proj-a\"},\n174\t\t\t{\"sess-s2\", \"dev@host-2\", \"windows\", \"proj-a\"},\n175\t\t\t{\"sess-s3\", \"admin@host-3\", \"macos\", \"proj-b\"},\n176\t\t} {\n177\t\t\t_, err := db.Exec(\n178\t\t\t\t`INSERT OR IGNORE INTO sessions (session_id, machine_id, os, project_slug, project_cwd, transcript_path, status, registered_at)\n179\t\t\t\t VALUES (?, ?, ?, ?, '/tmp', '/tmp/t.jsonl', 'active', ?)`,\n180\t\t\t\ts.sid, s.mid, s.os, s.proj, now)\n181\t\t\tif err != nil {\n182\t\t\t\tt.Fatalf(\"seed session %d: %v\", i, err)\n183\t\t\t}\n184\t\t}\n185\t\n186\t\t// 插入 2 个活跃代理\n187\t\tfor _, p := range []struct {\n188\t\t\tid, proj, status string\n189\t\t}{\n190\t\t\t{\"proxy-1\", \"proj-a\", \"active\"},\n191\t\t\t{\"proxy-2\", \"proj-b\", \"active\"},\n192\t\t} {\n193\t\t\t_, err := db.Exec(\n194\t\t\t\t`INSERT INTO proxies (proxy_id, project_slug, status, registered_at) VALUES (?, ?, ?, ?)`,\n195\t\t\t\tp.id, p.proj, p.status, time.Now().Format(\"2006-01-02 15:04:05\"))\n196\t\t\tif err != nil {\n197\t\t\t\tt.Fatalf(\"seed proxy %s: %v\", p.id, err)\n198\t\t\t}\n199\t\t}\n200\t\n201\t\t// 插入 5 个待处理 Issue (status=idle)\n202\t\tfor i := 1; i <= 5; i++ {\n203\t\t\t_, err := db.Exec(\n204\t\t\t\t`INSERT INTO issue_claims (repo_full_name, issue_number, status, updated_at) VALUES (?, ?, 'idle', CURRENT_TIMESTAMP)`,\n205\t\t\t\tfmt.Sprintf(\"org/repo-%d\", (i-1)/3+1), i)\n206\t\t\tif err != nil {\n207\t\t\t\tt.Fatalf(\"seed issue %d: %v\", i, err)\n208\t\t\t}\n209\t\t}\n210\t}\n211\t\n212\t// --- BDD Scenario tests ---\n213\t\n214\t// TestGetStatus_WithData 验证：获取系统状态（含统计数据）。\n215\t// BDD: @positive Scenario: 获取系统状态\n216\tfunc TestGetStatus_WithData(t *testing.T) {\n217\t\tenv := setupStatusTest(t)\n218\t\tseedStatusData(t, env)\n219\t\n220\t\tresp := env.get(t, \"/api/status\")\n221\t\tresult := readStatusResponse(t, resp)\n222\t\n223\t\tif resp.StatusCode != http.StatusOK {\n224\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n225\t\t}\n226\t\tif result.Status != \"healthy\" {\n227\t\t\tt.Errorf(\"expected status=healthy, got %s\", result.Status)\n228\t\t}\n229\t\tif result.Version == \"\" {\n230\t\t\tt.Error(\"expected non-empty version\")\n231\t\t}\n232\t\tif result.UptimeSeconds < 3590 { // 接近 3600 秒\n233\t\t\tt.Errorf(\"expected uptime_seconds ~3600, got %d\", result.UptimeSeconds)\n234\t\t}\n235\t\tif result.Timestamp == \"\" {\n236\t\t\tt.Error(\"expected non-empty timestamp\")\n237\t\t}\n238\t\n239\t\t// 验证统计数据\n240\t\tif result.Stats.ActiveSessions != 3 {\n241\t\t\tt.Errorf(\"expected active_sessions=3, got %d\", result.Stats.ActiveSessions)\n242\t\t}\n243\t\tif result.Stats.ActiveProxies != 2 {\n244\t\t\tt.Errorf(\"expected active_proxies=2, got %d\", result.Stats.ActiveProxies)\n245\t\t}\n246\t\tif result.Stats.PendingIssues != 5 {\n247\t\t\tt.Errorf(\"expected pending_issues=5, got %d\", result.Stats.PendingIssues)\n248\t\t}\n249\t\tif result.Stats.TotalMachines != 4 {\n250\t\t\tt.Errorf(\"expected total_machines=4, got %d\", result.Stats.TotalMachines)\n251\t\t}\n252\t\tif result.Stats.TotalProjects != 2 {\n253\t\t\tt.Errorf(\"expected total_projects=2, got %d\", result.Stats.TotalProjects)\n254\t\t}\n255\t}\n256\t\n257\t// TestGetStatus_NoActiveSessions 验证：无活跃会话时状态正常。\n258\t// BDD: @positive Scenario: 系统无活跃会话时状态正常\n259\tfunc TestGetStatus_NoActiveSessions(t *testing.T) {\n260\t\tenv := setupStatusTest(t)\n261\t\t// 不插入任何数据\n262\t\n263\t\tresp := env.get(t, \"/api/status\")\n264\t\tresult := readStatusResponse(t, resp)\n265\t\n266\t\tif resp.StatusCode != http.StatusOK {\n267\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n268\t\t}\n269\t\tif result.Status != \"healthy\" {\n270\t\t\tt.Errorf(\"expected status=healthy, got %s\", result.Status)\n271\t\t}\n272\t\tif result.Stats.ActiveSessions != 0 {\n273\t\t\tt.Errorf(\"expected active_sessions=0, got %d\", result.Stats.ActiveSessions)\n274\t\t}\n275\t\tif result.Stats.ActiveProxies != 0 {\n276\t\t\tt.Errorf(\"expected active_proxies=0, got %d\", result.Stats.ActiveProxies)\n277\t\t}\n278\t\tif result.Stats.PendingIssues != 0 {\n279\t\t\tt.Errorf(\"expected pending_issues=0, got %d\", result.Stats.PendingIssues)\n280\t\t}\n281\t\tif result.Stats.TotalMachines != 0 {\n282\t\t\tt.Errorf(\"expected total_machines=0, got %d\", result.Stats.TotalMachines)\n283\t\t}\n284\t\tif result.Stats.TotalProjects != 0 {\n285\t\t\tt.Errorf(\"expected total_projects=0, got %d\", result.Stats.TotalProjects)\n286\t\t}\n287\t}\n288\t\n289\t// TestGetStatus_MethodNotAllowed 验证：使用非 GET 方法请求返回 405。\n290\t// BDD: @negative Scenario: 使用非 GET 方法请求\n291\tfunc TestGetStatus_MethodNotAllowed(t *testing.T) {\n292\t\tenv := setupStatusTest(t)\n293\t\n294\t\tresp := env.post(t, \"/api/status\", \"\")\n295\t\tdefer resp.Body.Close()\n296\t\n297\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n298\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n299\t\t}\n300\t\n301\t\tvar errResp struct {\n302\t\t\tCode    string `json:\"error\"`\n303\t\t\tMessage string `json:\"message\"`\n304\t\t}\n305\t\treadJSON(t, resp, &errResp)\n306\t\tif errResp.Code != \"method_not_allowed\" {\n307\t\t\tt.Errorf(\"expected error=method_not_allowed, got %s\", errResp.Code)\n308\t\t}\n309\t}\n310\t"}]}
