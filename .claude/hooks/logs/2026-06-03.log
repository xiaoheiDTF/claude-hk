      │ 机器        │ 注册时间        │ │"]},{"oldStart":374,"oldLines":8,"newStart":388,"newLines":6,"lines":[" │      │  ┌────────────────────────────────────────────────────────────────┐ │"," │      │  │  ⚠️  无法展示的数据（需要后端扩展 API）                          │ │"," │      │  │  ────────────────────────────────────────────────────────────  │ │","-│      │  │  • 代理注册列表（无 GET /api/proxies）                           │ │","-│      │  │  • Issue 统计（无 GET /api/issues/stats）                        │ │"," │      │  │  • 系统日志（无 GET /api/logs）                                  │ │"," │      │  │  • 配置信息（无 GET /api/config）                                │ │"," │      │  └────────────────────────────────────────────────────────────────┘ │"]}],"userModified":false,"replaceAll":false},"tool_use_id":"call_958a6d80b87d465dac4672c4","duration_ms":6}
