[2026-06-03 21:37:18] [INFO] [PreToolUse] Input: {"session_id":"66b46c66-8db9-4176-86bd-12395acb3f94","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\66b46c66-8db9-4176-86bd-12395acb3f94.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"default","agent_id":"a54054afd34ce9d0c","agent_type":"Explore","hook_event_name":"PreToolUse","tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\issue_store.go"},"tool_use_id":"call_705b1c98ba3d4fa686c08cee"}
