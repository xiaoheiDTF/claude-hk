ethod != http.MethodGet {\n259\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n260\t\t\treturn\n261\t\t}\n262\t\n263\t\t// 解析查询参数\n264\t\tvar filter store.IssueFilter\n265\t\tif v := r.URL.Query().Get(\"repo\"); v != \"\" {\n266\t\t\tfilter.RepoFullName = &v\n267\t\t}\n268\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\n269\t\t\tfilter.Status = &v\n270\t\t}\n271\t\tif v := r.URL.Query().Get(\"session_id\"); v != \"\" {\n272\t\t\tfilter.SessionID = &v\n273\t\t}\n274\t\tif v := r.URL.Query().Get(\"page\"); v != \"\" {\n275\t\t\tif n, err := strconv.Atoi(v); err == nil && n > 0 {\n276\t\t\t\tfilter.Page = n\n277\t\t\t}\n278\t\t}\n279\t\tif v := r.URL.Query().Get(\"page_size\"); v != \"\" {\n280\t\t\tif n, err := strconv.Atoi(v); err == nil && n > 0 {\n281\t\t\t\tfilter.PageSize = n\n282\t\t\t}\n283\t\t}\n284\t\n285\t\tlogger.Debug(\"api.issue\", \"GET /api/issues filter=%+v\", filter)\n286\t\n287\t\titems, total, err := h.svc.List(r.Context(), filter)\n288\t\tif err != nil {\n289\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list issues\")\n290\t\t\treturn\n291\t\t}\n292\t\n293\t\t// 确保返回空数组而非 null\n294\t\tif items == nil {\n295\t\t\titems = []store.IssueListItem{}\n296\t\t}\n297\t\n298\t\t// 分页参数\n299\t\tpage := filter.Page\n300\t\tif page < 1 {\n301\t\t\tpage = 1\n302\t\t}\n303\t\tpageSize := filter.PageSize\n304\t\tif pageSize < 1 {\n305\t\t\tpageSize = 20\n306\t\t}\n307\t\ttotalPages := int(math.Ceil(float64(total) / float64(pageSize)))\n308\t\n309\t\t// 转换为响应格式\n310\t\trespItems := make([]IssueListItem, len(items))\n311\t\tfor i, item := range items {\n312\t\t\trespItems[i] = IssueListItem{\n313\t\t\t\tID:           item.ID,\n314\t\t\t\tRepoFullName: item.RepoFullName,\n315\t\t\t\tIssueNumber:  item.IssueNumber,\n316\t\t\t\tIssueTitle:   item.IssueTitle,\n317\t\t\t\tStatus:       item.Status,\n318\t\t\t\tSessionID:    item.SessionID,\n319\t\t\t\tClaimedAt:    item.ClaimedAt,\n320\t\t\t\tUpdatedAt:    item.UpdatedAt,\n321\t\t\t}\n322\t\t}\n323\t\n324\t\twriteJSON(w, http.StatusOK, IssuesListResponse{\n325\t\t\tIssues:     respItems,\n326\t\t\tTotal:      total,\n327\t\t\tPage:       page,\n328\t\t\tPageSize:   pageSize,\n329\t\t\tTotalPages: totalPages,\n330\t\t})\n331\t}\n332\t"}]}
