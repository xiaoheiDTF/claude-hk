le   *string    // Issue 标题（可为 NULL）\n49\t\tStatus       string     // 当前状态\n50\t\tSessionID    *string    // 领取者的 session ID\n51\t\tClaimedAt    *time.Time // 领取时间\n52\t\tUpdatedAt    time.Time  // 更新时间\n53\t}\n54\t\n55\t// IssueStore 定义 Issue 数据存储的接口。\n56\ttype IssueStore interface {\n57\t\tCheckIssues(ctx context.Context, repo string, numbers []int) ([]IssueCheckResult, error)\n58\t\tClaimIssue(ctx context.Context, repo string, number int, sessionID string, issueTitle string) (*ClaimResult, error)\n59\t\tUpdateIssueStatus(ctx context.Context, repo string, number int, sessionID string, newStatus string) (*UpdateStatusResult, error)\n60\t\tReleaseIssue(ctx context.Context, repo string, number int, sessionID string) (bool, error)\n61\t\tReleaseSessionIssues(ctx context.Context, sessionID string) ([]int, error)\n62\t\tListIssues(ctx context.Context, filter IssueFilter) ([]IssueListItem, int, error)\n63\t\tListIssuesBySession(ctx context.Context, sessionID string) ([]IssueListItem, error)\n64\t}\n65\t\n66\t// IssueCheckResult 表示单个 Issue 的状态查询结果。\n67\ttype IssueCheckResult struct {\n68\t\tNumber    int     // Issue 编号\n69\t\tStatus    string  // 当前状态\n70\t\tSessionID *string // 领取者 session ID\n71\t\tClaimedAt *string // 领取时间\n72\t}\n73\t\n74\t// --- Session types ---\n75\t\n76\t// Session 表示会话实体（对应数据库 sessions 表）。\n77\ttype Session struct {\n78\t\tSessionID      string     // 会话唯一 ID\n79\t\tMachineID      string     // 机器标识\n80\t\tOS             string     // 操作系统\n81\t\tProjectSlug    string     // 项目标识\n82\t\tProjectCwd     string     // 项目工作目录\n83\t\tTranscriptPath string     // 对话记录路径\n84\t\tLocalTracePath string     // 本地跟踪路径\n85\t\tModel          string     // 使用的模型\n86\t\tSource         string     // 来源\n87\t\tStatus         string     // 状态\n88\t\tRegisteredAt   time.Time  // 注册时间\n89\t\tClosedAt       *time.Time // 关闭时间\n90\t\tCloseReason    string     // 关闭原因\n91\t}\n92\t\n93\t// SessionFilter 是会话列表的过滤条件（指针类型支持省略条件）。\n94\ttype SessionFilter struct {\n95\t\tMachineID   *string // 按机器 ID 过滤\n96\t\tProjectSlug *string // 按项目标识过滤\n97\t\tStatus      *string // 按状态过滤\n98\t}\n99\t\n100\t// SessionStore 定义 Session 数据存储的接口。\n101\ttype SessionStore interface {\n102\t\tRegisterSession(ctx context.Context, s Session) error\n103\t\tCloseSession(ctx context.Context, sessionID string, reason string) error\n104\t\tListSessions(ctx context.Context, filter SessionFilter) ([]Session, error)\n105\t\tGetSession(ctx context.Context, sessionID string) (*Session, error)\n106\t\tCleanupTimedOut(ctx context.Context) (int, error)\n107\t}\n108\t\n109\t// --- Machine types ---\n110\t\n111\t// Machine 表示机器实体（对应数据库 machines 表）。\n112\ttype Machine struct {\n113\t\tID          int64      // 记录 ID\n114\t\tMachineID   string     // 机器标识，格式 username@hostname\n115\t\tOS          string     // 操作系统\n116\t\tHostname    string     // 主机名\n117\t\tUsername    string     // 用户名\n118\t\tFirstSeenAt time.Time  // 首次发现时间\n119\t\tLastSeenAt  *time.Time // 最后发现时间\n120\t}\n121\t\n122\t// MachineFilter 是机器列表的过滤条件。\n123\ttype MachineFilter struct {\n124\t\tOS       *string // 按操作系统过滤\n125\t\tHostname *string // 按主机名过滤\n126\t}\n127\t\n128\t// MachineStore 定义 Machine 数据存储的接口。\n129\ttype MachineStore interface {\n130\t\tListMachines(ctx context.Context, filter MachineFilter) ([]Machine, error)\n131\t\tGetMachine(ctx context.Context, machineID string) (*Machine, error)\n132\t}\n133\t\n134\t// --- Project types ---\n135\t\n136\t// Project 表示项目实体（对应数据库 projects 表）。\n137\ttype Project struct {\n138\t\tID          int64     // 记录 ID\n139\t\tProjectSlug string    // 项目标识\n140\t\tProjectCwd  string    // 项目工作目录\n141\t\tFirstSeenAt time.Time // 首次发现时间\n142\t\tLastSeenAt  time.Time // 最后发现时间\n143\t}\n144\t\n145\t// ProjectStore 定义 Project 数据存储的接口。\n146\ttype ProjectStore interface {\n147\t\tListProjects(ctx context.Context) ([]Project, error)\n148\t\tGetProject(ctx context.Context, projectSlug string) (*Project, error)\n149\t}\n150\t\n151\t// --- Config types ---\n152\t\n153\t// ConfigStore 定义系统配置存储的接口。\n154\ttype ConfigStore interface {\n155\t\tGetConfig(ctx context.Context) (map[string]interface{}, error)\n156\t\tUpdateConfig(ctx context.Context, updates map[string]interface{}) error\n157\t}\n158\t\n159\t// --- Proxy types ---\n160\t\n161\t// Proxy 表示代理实体（对应数据库 proxies 表）。\n162\ttype Proxy struct {\n163\t\tProxyID      string     // 代理唯一 ID\n164\t\tProjectSlug  string     // 项目标识\n165\t\tStatus       string     // 状态：active/offline\n166\t\tRegisteredAt time.Time  // 注册时间\n167\t\tLastPingAt   *time.Time // 最后心跳时间（可为 NULL）\n168\t}\n169\t\n170\t// ProxyFilter 是代理列表的过滤条件。\n171\ttype ProxyFilter struct {\n172\t\tStatus  *string // 按状态过滤\n173\t\tProject *string // 按 project_slug 过滤\n174\t}\n175\t\n176\t// ProxyStore 定义代理数据存储的接口。\n177\ttype ProxyStore interface {\n178\t\tListProxies(ctx context.Context, filter ProxyFilter) ([]Proxy, error)\n179\t}\n180\t\n181\t// --- Store aggregate ---\n182\t\n183\t// Store 是统一的数据存储聚合接口。\n184\ttype Store interface {\n185\t\tIssues() IssueStore     // 返回 Issue 存储\n186\t\tSessions() SessionStore // 返回 Session 存储\n187\t\tMachines() MachineStore // 返回 Machine 存储\n188\t\tProjects() ProjectStore // 返回 Project 存储\n189\t\tConfigs() ConfigStore   // 返回 Config 存储\n190\t\tProxies() ProxyStore    // 返回 Proxy 存储\n191\t\tClose() error           // 关闭存储连接\n192\t}\n193\t"}]}
