tmachineStore store.MachineStore,\n47\t\tprojectStore store.ProjectStore,\n48\t\tstartTime time.Time,\n49\t) *StatusService {\n50\t\treturn &StatusService{\n51\t\t\tsessionStore: sessionStore,\n52\t\t\tproxyStore:   proxyStore,\n53\t\t\tissueStore:   issueStore,\n54\t\t\tmachineStore: machineStore,\n55\t\t\tprojectStore: projectStore,\n56\t\t\tstartTime:    startTime,\n57\t\t}\n58\t}\n59\t\n60\t// Get 获取系统整体状态。\n61\tfunc (svc *StatusService) Get(ctx context.Context) (*SystemStatus, error) {\n62\t\tlogger.Debug(\"svc.status\", \"Get\")\n63\t\n64\t\tactiveSessions, err := svc.countActiveSessions(ctx)\n65\t\tif err != nil {\n66\t\t\treturn nil, fmt.Errorf(\"count active sessions: %w\", err)\n67\t\t}\n68\t\n69\t\tactiveProxies, err := svc.countActiveProxies(ctx)\n70\t\tif err != nil {\n71\t\t\treturn nil, fmt.Errorf(\"count active proxies: %w\", err)\n72\t\t}\n73\t\n74\t\tpendingIssues, err := svc.countPendingIssues(ctx)\n75\t\tif err != nil {\n76\t\t\treturn nil, fmt.Errorf(\"count pending issues: %w\", err)\n77\t\t}\n78\t\n79\t\ttotalMachines, err := svc.countMachines(ctx)\n80\t\tif err != nil {\n81\t\t\treturn nil, fmt.Errorf(\"count machines: %w\", err)\n82\t\t}\n83\t\n84\t\ttotalProjects, err := svc.countProjects(ctx)\n85\t\tif err != nil {\n86\t\t\treturn nil, fmt.Errorf(\"count projects: %w\", err)\n87\t\t}\n88\t\n89\t\tuptime := int64(time.Since(svc.startTime).Seconds())\n90\t\n91\t\treturn &SystemStatus{\n92\t\t\tStatus:        \"healthy\",\n93\t\t\tVersion:       \"1.0.0\",\n94\t\t\tUptimeSeconds: uptime,\n95\t\t\tStats: SystemStats{\n96\t\t\t\tActiveSessions: activeSessions,\n97\t\t\t\tActiveProxies:  activeProxies,\n98\t\t\t\tPendingIssues:  pendingIssues,\n99\t\t\t\tTotalMachines:  totalMachines,\n100\t\t\t\tTotalProjects:  totalProjects,\n101\t\t\t},\n102\t\t\tTimestamp: time.Now().UTC(),\n103\t\t}, nil\n104\t}\n105\t\n106\tfunc (svc *StatusService) countActiveSessions(ctx context.Context) (int64, error) {\n107\t\tactive := \"active\"\n108\t\tsessions, err := svc.sessionStore.ListSessions(ctx, store.SessionFilter{Status: &active})\n109\t\tif err != nil {\n110\t\t\treturn 0, err\n111\t\t}\n112\t\treturn int64(len(sessions)), nil\n113\t}\n114\t\n115\tfunc (svc *StatusService) countActiveProxies(ctx context.Context) (int64, error) {\n116\t\tactive := \"active\"\n117\t\tproxies, err := svc.proxyStore.ListProxies(ctx, store.ProxyFilter{Status: &active})\n118\t\tif err != nil {\n119\t\t\treturn 0, err\n120\t\t}\n121\t\treturn int64(len(proxies)), nil\n122\t}\n123\t\n124\tfunc (svc *StatusService) countPendingIssues(ctx context.Context) (int64, error) {\n125\t\tidle := \"idle\"\n126\t\t_, total, err := svc.issueStore.ListIssues(ctx, store.IssueFilter{Status: &idle})\n127\t\tif err != nil {\n128\t\t\treturn 0, err\n129\t\t}\n130\t\treturn int64(total), nil\n131\t}\n132\t\n133\tfunc (svc *StatusService) countMachines(ctx context.Context) (int64, error) {\n134\t\tmachines, err := svc.machineStore.ListMachines(ctx, store.MachineFilter{})\n135\t\tif err != nil {\n136\t\t\treturn 0, err\n137\t\t}\n138\t\treturn int64(len(machines)), nil\n139\t}\n140\t\n141\tfunc (svc *StatusService) countProjects(ctx context.Context) (int64, error) {\n142\t\tprojects, err := svc.projectStore.ListProjects(ctx)\n143\t\tif err != nil {\n144\t\t\treturn 0, err\n145\t\t}\n146\t\treturn int64(len(projects)), nil\n147\t}\n148\t"}]}
