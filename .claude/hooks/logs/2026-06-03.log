  │  │  ────────────────────────────────────────────────────────────  │ │\n│      │  │  🟢 运行中  │  版本: v1.0.0  │  运行时间: 2h 35m               │ │\n│      │  │  最后检查: 2026-06-01 14:35:22                                 │ │\n│      │  │  ────────────────────────────────────────────────────────────  │ │\n│      │  │  活跃会话: 3  │  活跃代理: 2  │  待处理 Issue: 5               │ │\n│      │  │  机器总数: 4  │  项目总数: 6                                    │ │\n│      │  └────────────────────────────────────────────────────────────────┘ │\n│      │                                                                      │\n│      │  ┌────────────────────────────────────────────────────────────────┐ │\n│      │  │  代理注册列表（来自 GET /api/proxies）                           │ │\n│      │  │  ────────────────────────────────────────────────────────────  │ │\n│      │  │  代理 ID       │ 项目        │ 状态    │ 注册时间  │ 最后心跳   │ │\n│      │  │────────────────┼─────────────┼─────────┼──────────┼───────────│ │\n│      │  │ 28364          │ project-x   │ 🟢 活跃 │ 14:30    │ 14:35     │ │\n│      │  │ 15287          │ project-y   │ 🟢 活跃 │ 14:20    │ 14:34     │ │\n│      │  └────────────────────────────────────────────────────────────────┘ │\n│      │                                                                      │\n│      │  ┌────────────────────────────────────────────────────────────────┐ │\n│      │  │  活跃会话（来自 GET /api/sessions?status=active）               │ │\n│      │  │  ────────────────────────────────────────────────────────────  │ │\n│      │  │  Session ID        │ 项目      │ 机器        │ 注册时间        │ │\n│      │  │────────────────────┼───────────┼─────────────┼────────────────│ │\n│      │  │ abc123-def4...     │ project-x │ user@host-1 │ 14:32:15       │ │\n│      │  │ def456-ghi7...     │ project-y │ user@host-2 │ 14:28:40       │ │\n│      │  │ ghi012-mno3...     │ project-z │ user@host-3 │ 14:10:22       │ │\n│      │  └────────────────────────────────────────────────────────────────┘ │\n│   