, req.RepoFullName, req.IssueNumber)\n99\t\n100\t\t// 调用服务层领取 Issue\n101\t\tresult, err := h.svc.Claim(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID, req.IssueTitle)\n102\t\tif err != nil {\n103\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to claim issue\")\n104\t\t\treturn\n105\t\t}\n106\t\n107\t\t// 领取成功\n108\t\tif result.Success {\n109\t\t\twriteJSON(w, http.StatusOK, ClaimIssueResponse{\n110\t\t\t\tSuccess:   true,\n111\t\t\t\tStatus:    result.Status,\n112\t\t\t\tClaimedAt: result.ClaimedAt,\n113\t\t\t})\n114\t\t\treturn\n115\t\t}\n116\t\n117\t\t// 已被其他会话领取，返回冲突信息\n118\t\twriteJSON(w, http.StatusConflict, ClaimIssueResponse{\n119\t\t\tSuccess:   false,\n120\t\t\tError:     \"already_claimed\",\n121\t\t\tClaimedBy: result.ClaimedBy,\n122\t\t\tClaimedAt: result.ClaimedAt,\n123\t\t})\n124\t}\n125\t\n126\t// ReleaseIssue 处理释放单个 Issue 的请求。\n127\t// 接收 POST 请求，将指定 Issue 恢复为空闲状态（仅限当前持有者）。\n128\tfunc (h *IssueHandler) ReleaseIssue(w http.ResponseWriter, r *http.Request) {\n129\t\tif r.Method != http.MethodPost {\n130\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n131\t\t\treturn\n132\t\t}\n133\t\n134\t\tvar req ReleaseIssueRequest\n135\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n136\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n137\t\t\treturn\n138\t\t}\n139\t\n140\t\tif req.RepoFullName == \"\" || req.IssueNumber == 0 || req.SessionID == \"\" {\n141\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name, issue_number and session_id are required\")\n142\t\t\treturn\n143\t\t}\n144\t\n145\t\tlogger.Debug(\"api.issue\", \"POST /api/issue/release repo=%s #%d\", req.RepoFullName, req.IssueNumber)\n146\t\n147\t\t// 调用服务层释放 Issue\n148\t\treleased, err := h.svc.Release(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID)\n149\t\tif err != nil {\n150\t\t\twriteError(w, http.StatusInternalServe