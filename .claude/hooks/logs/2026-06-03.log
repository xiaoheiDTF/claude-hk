[]ProjectListItem, len(projects))\n44\t\tfor i, p := range projects {\n45\t\t\titems[i] = ProjectListItem{\n46\t\t\t\tID:          p.ID,\n47\t\t\t\tProjectSlug: p.ProjectSlug,\n48\t\t\t\tProjectCwd:  p.ProjectCwd,\n49\t\t\t\tFirstSeenAt: p.FirstSeenAt,\n50\t\t\t\tLastSeenAt:  p.LastSeenAt,\n51\t\t\t}\n52\t\t}\n53\t\n54\t\twriteJSON(w, http.StatusOK, ProjectsListResponse{Projects: items})\n55\t}\n56\t"}]}
