json:\"claimed_by,omitempty\"` // 已被谁领取\n39\t\tMessage   string  `json:\"message,omitempty\"`    // 提示信息\n40\t}\n41\t\n42\t// ReleaseSessionResponse 是释放会话下所有 Issue 的响应体。\n43\ttype ReleaseSessionResponse struct {\n44\t\tReleased []int `json:\"released\"` // 被释放的 Issue 编号列表\n45\t\tCount    int   `json:\"count\"`    // 释放数量\n46\t}\n47\t\n48\t// UpdateStatusResponse 是更新 Issue 状态的响应体。\n49\ttype UpdateStatusResponse struct {\n50\t\tSuccess        bool   `json:\"success\"`                  // 是否成功\n51\t\tPreviousStatus string `json:\"previous_status,omitempty\"` // 更新前的状态\n52\t\tNewStatus      string `json:\"new_status,omitempty\"`      // 更新后的状态\n53\t\tError          string `json:\"error,omitempty\"`           // 错误信息\n54\t}\n55\t\n56\t// IssuesListResponse 是 Issue 列表的响应体。\n57\ttype IssuesListResponse struct {\n58\t\tIssues     []IssueListItem `json:\"issues\"`      // Issue 列表\n59\t\tTotal      int             `json:\"total\"`       // 总数量\n60\t\tPage       int             `json:\"page\"`        // 当前页码\n61\t\tPageSize   int             `json:\"page_size\"`   // 每页大小\n62\t\tTotalPages int             `json:\"total_pages\"` // 总页数\n63\t}\n64\t\n65\t// IssueListItem 是 Issue 列表中的单个条目。\n66\ttype IssueListItem struct {\n67\t\tID           int64      `json:\"id\"`\n68\t\tRepoFullName string     `json:\"repo_full_name\"`\n69\t\tIssueNumber  int        `json:\"issue_number\"`\n70\t\tIssueTitle   *string    `json:\"issue_title\"`\n71\t\tStatus       string     `json:\"status\"`\n72\t\tSessionID    *string    `json:\"session_id\"`\n73\t\tClaimedAt    *time.Time `json:\"claimed_at\"`\n74\t\tUpdatedAt    time.Time  `json:\"updated_at\"`\n75\t}\n76\t\n77\t// --- Session response types ---\n78\t\n79\t// SessionListResponse 是会话列表的响应体。\n80\ttype SessionListResponse struct {\n81\t\tSessions []SessionListItem `json:\"sessions\"` // 会话列表\n82\t}\n83\t\n84\t// SessionIssuesResponse 是会话关联 Issue 的响应体。\n85\ttype SessionIssuesResponse struct {\n86\t\tIssues []IssueListItem `json:\"issues\"` // 会