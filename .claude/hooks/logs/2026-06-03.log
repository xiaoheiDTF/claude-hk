r == sql.ErrNoRows {\n46\t\t\t\tv, _ := json.Marshal(value)\n47\t\t\t\t_, err := s.db.ExecContext(ctx,\n48\t\t\t\t\t`INSERT INTO config(key, value, updated_at) VALUES (?, ?, ?)`,\n49\t\t\t\t\tkey, string(v), time.Now())\n50\t\t\t\tif err != nil {\n51\t\t\t\t\treturn fmt.Errorf(\"insert default config %s: %w\", key, err)\n52\t\t\t\t}\n53\t\t\t} else if err != nil {\n54\t\t\t\treturn err\n55\t\t\t}\n56\t\t}\n57\t\treturn nil\n58\t}\n59\t\n60\t// GetConfig 返回所有配置项。\n61\tfunc (s *sqliteConfigStore) GetConfig(ctx context.Context) (map[string]interface{}, error) {\n62\t\tlogger.Debug(\"store.config\", \"GetConfig\")\n63\t\n64\t\trows, err := s.db.QueryContext(ctx, `SELECT key, value FROM config`)\n65\t\tif err != nil {\n66\t\t\treturn nil, err\n67\t\t}\n68\t\tdefer rows.Close()\n69\t\n70\t\tconfig := make(map[string]interface{})\n71\t\tfor rows.Next() {\n72\t\t\tvar key, valueStr string\n73\t\t\tif err := rows.Scan(&key, &valueStr); err != nil {\n74\t\t\t\treturn nil, err\n75\t\t\t}\n76\t\t\tvar value interface{}\n77\t\t\tif err := json.Unmarshal([]byte(valueStr), &value); err != nil {\n78\t\t\t\tvalue = valueStr\n79\t\t\t}\n80\t\t\tconfig[key] = value\n81\t\t}\n82\t\treturn config, rows.Err()\n83\t}\n84\t\n85\t// UpdateConfig 更新指定的配置项。\n86\tfunc (s *sqliteConfigStore) UpdateConfig(ctx context.Context, updates map[string]interface{}) error {\n87\t\tlogger.Debug(\"store.config\", \"UpdateConfig: %v\", updates)\n88\t\n89\t\ttx, err := s.db.BeginTx(ctx, nil)\n90\t\tif err != nil {\n91\t\t\treturn err\n92\t\t}\n93\t\tdefer tx.Rollback()\n94\t\n95\t\tfor key, value := range updates {\n96\t\t\tif !isValidConfigKey(key) {\n97\t\t\t\treturn fmt.Errorf(\"unknown config key: %s\", key)\n98\t\t\t}\n99\t\t\tif err := validateConfigValue(key, value); err != nil {\n100\t\t\t\treturn err\n101\t\t\t}\n102\t\n103\t\t\tv, _ := json.Marshal(value)\n104\t\t\t_, err := tx.ExecContext(ctx,\n105\t\t\t\t`INSERT INTO config(key, value, updated_at) VALUES (?, ?, ?)\n106\t\t\t\t ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at`,\n107\t\t\t\tkey, string(v), time.Now())\n108\t\t\tif err != nil {\n109\t\t\t\treturn fmt.Errorf(\"update config %s: %w\", key, err)\n110\t\t\t}\n111\t\t}\n112\t\n113\t\treturn tx.Commit()\n114\t}\n115\t\n116\t// isValidConfigKey 检查配置键是否合法。\n117\tfunc isValidConfigKey(key string) bool {\n118\t\tswitch configKey(key) {\n119\t\tcase KeyLogLevel, KeySessionTimeout, KeyMaxConcurrent, KeyAutoClaim, KeyDefaultModel:\n120\t\t\treturn true\n121\t\t}\n122\t\treturn false\n123\t}\n124\t\n125\t// validateConfigValue 校验配置值的合法性。\n126\tfunc validateConfigValue(key string, value interface{}) error {\n127\t\tswitch configKey(key) {\n128\t\tcase KeyLogLevel:\n129\t\t\tv, ok := value.(string)\n130\t\t\tif !ok {\n131\t\t\t\treturn fmt.Errorf(\"invalid log_level: must be string\")\n132\t\t\t}\n133\t\t\tswitch v {\n134\t\t\tcase \"debug\", \"info\", \"warn\", \"error\":\n135\t\t\t\t// ok\n136\t\t\tdefault:\n137\t\t\t\treturn fmt.Errorf(\"invalid log_level: %s\", v)\n138\t\t\t}\n139\t\tcase KeySessionTimeout:\n140\t\t\tv, ok := toFloat64(value)\n141\t\t\tif !ok || v <= 0 {\n142\t\t\t\treturn fmt.Errorf(\"invalid session_timeout: %v\", value)\n143\t\t\t}\n144\t\tcase KeyMaxConcurrent:\n145\t\t\tv, ok := toFloat64(value)\n146\t\t\tif !ok || v <= 0 {\n147\t\t\t\treturn fmt.Errorf(\"invalid max_concurrent: %v\", value)\n148\t\t\t}\n149\t\tcase KeyAutoClaim:\n150\t\t\t_, ok := value.(bool)\n151\t\t\tif !ok {\n152\t\t\t\treturn fmt.Errorf(\"invalid auto_claim: must be bool\")\n153\t\t\t}\n154\t\tcase KeyDefaultModel:\n155\t\t\tv, ok := value.(string)\n156\t\t\tif !ok || v == \"\" {\n157\t\t\t\treturn fmt.Errorf(\"invalid default_model: %v\", value)\n158\t\t\t}\n159\t\t}\n160\t\treturn nil\n161\t}\n162\t\n163\t// toFloat64 将 JSON 数值转换为 float64（兼容 int/float64）。\n164\tfunc toFloat64(v interface{}) (float64, bool) {\n165\t\tswitch n := v.(type) {\n166\t\tcase float64:\n167\t\t\treturn n, true\n168\t\tcase int:\n169\t\t\treturn float64(n), true\n170\t\tcase int64:\n171\t\t\treturn float64(n), true\n172\t\tdefault:\n173\t\t\treturn 0, false\n174\t\t}\n175\t}\n176\t"}]}
