(w, http.StatusInternalServerError, \"internal_error\", \"failed to list machines\")\n43\t\t\treturn\n44\t\t}\n45\t\n46\t\t// 确保返回空数组而非 null\n47\t\tif machines == nil {\n48\t\t\tmachines = []store.Machine{}\n49\t\t}\n50\t\n51\t\titems := make([]MachineListItem, len(machines))\n52\t\tfor i, m := range machines {\n53\t\t\titems[i] = MachineListItem{\n54\t\t\t\tID:          m.ID,\n55\t\t\t\tMachineID:   m.MachineID,\n56\t\t\t\tOS:          m.OS,\n57\t\t\t\tHostname:    m.Hostname,\n58\t\t\t\tUsername:    m.Username,\n59\t\t\t\tFirstSeenAt: m.FirstSeenAt,\n60\t\t\t\tLastSeenAt:  m.LastSeenAt,\n61\t\t\t}\n62\t\t}\n63\t\n64\t\twriteJSON(w, http.StatusOK, MachinesListResponse{Machines: items})\n65\t}\n66\t"}]}
