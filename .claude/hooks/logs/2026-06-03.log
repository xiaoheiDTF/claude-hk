ngIssues:  status.Stats.PendingIssues,\n\t\t\tTotalMachines:  status.Stats.TotalMachines,\n\t\t\tTotalProjects:  status.Stats.TotalProjects,\n\t\t},\n\t\tTimestamp: status.Timestamp,\n\t})\n}\n","numLines":51,"startLine":1,"totalLines":51}},"tool_use_id":"call_3d1deb6f0be74c5e8307bdd6","duration_ms":1}
