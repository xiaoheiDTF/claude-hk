string     `json:\"local_trace_path\"` // 本地跟踪路径\n134\t\tModel          string     `json:\"model\"`           // 使用的模型\n135\t\tSource         string     `json:\"source\"`          // 来源\n136\t\tStatus         string     `json:\"status\"`          // 状态\n137\t\tRegisteredAt   time.Time  `json:\"registered_at\"`   // 注册时间\n138\t\tClosedAt       *time.Time `json:\"closed_at,omitempty\"` // 关闭时间\n139\t\tCloseReason    string     `json:\"close_reason,omitempty\"` // 关闭原因\n140\t}\n141\t\n142\t// --- Machine response types ---\n143\t\n144\t// MachinesListResponse 是机器列表的响应体。\n145\ttype MachinesListResponse struct {\n146\t\tMachines []MachineListItem `json:\"machines\"` // 机器列表\n147\t}\n148\t\n149\t// MachineListItem 是机器列表中的单个条目。\n150\ttype MachineListItem struct {\n151\t\tID          int64      `json:\"id\"`\n152\t\tMachineID   string     `json:\"machine_id\"`\n153\t\tOS          string     `json:\"os\"`\n154\t\tHostname    string     `json:\"hostname\"`\n155\t\tUsername    string     `json:\"username\"`\n156\t\tFirstSeenAt time.Time  `json:\"first_seen_at\"`\n157\t\tLastSeenAt  *time.Time `json:\"last_seen_at\"`\n158\t}\n159\t\n160\t// --- Project response types ---\n161\t\n162\t// ProjectsListResponse 是项目列表的响应体。\n163\ttype ProjectsListResponse struct {\n164\t\tProjects []ProjectListItem `json:\"projects\"` // 项目列表\n165\t}\n166\t\n167\t// ProjectListItem 是项目列表中的单个条目。\n168\ttype ProjectListItem struct {\n169\t\tID          int64     `json:\"id\"`\n170\t\tProjectSlug string    `json:\"project_slug\"`\n171\t\tProjectCwd  string    `json:\"project_cwd\"`\n172\t\tFirstSeenAt time.Time `json:\"first_seen_at\"`\n173\t\tLastSeenAt  time.Time `json:\"last_seen_at\"`\n174\t}\n175\t\n176\t// --- Config response types ---\n177\t\n178\t// ConfigResponse 是配置查询/更新的响应体。\n179\ttype ConfigResponse struct {\n180\t\tConfig map[string]interface{} `json:\"config\"` // 配置项键值对\n181\t}\n182\t\n183\t// --- Log response types ---\n184\t\n185\t// LogsResponse 是日志查询的响应体。\n186\ttype LogsResponse struct {\n187\t\tLogs []LogItem `json:\"logs\"` // 日志条目列表\n188\t}\n189\t\n190\t// LogItem 是单条日志记录。\n191\ttype LogItem struct {\n192\t\tTimestamp string `json:\"timestamp\"` // 时间戳，如 \"2026-06-01 20:56:28.000\"\n193\t\tLevel     string `json:\"level\"`     // 日志级别：DEBUG/INFO/WARN/ERROR\n194\t\tSource    string `json:\"source\"`    // 来源模块\n195\t\tMessage   string `json:\"message\"`   // 日志内容\n196\t}\n197\t\n198\t// --- Proxy response types ---\n199\t\n200\t// ProxiesResponse 是代理列表的响应体。\n201\ttype ProxiesResponse struct {\n202\t\tProxies []ProxyItem `json:\"proxies\"` // 代理列表\n203\t\tTotal   int         `json:\"total\"`   // 总数量\n204\t}\n205\t\n206\t// ProxyItem 是代理列表中的单个条目。\n207\ttype ProxyItem struct {\n208\t\tProxyID      string     `json:\"proxy_id\"`                // 代理唯一 ID\n209\t\tProjectSlug  string     `json:\"project_slug\"`            // 项目标识\n210\t\tStatus       string     `json:\"status\"`                  // 状态：active/offline\n211\t\tRegisteredAt time.Time  `json:\"registered_at\"`           // 注册时间\n212\t\tLastPingAt   *time.Time `json:\"last_ping_at,omitempty\"`  // 最后心跳时间\n213\t}\n214\t\n215\t// --- Status response types ---\n216\t\n217\t// StatusResponse 是系统状态的响应体。\n218\ttype StatusResponse struct {\n219\t\tStatus        string     `json:\"status\"`         // 系统状态：healthy\n220\t\tVersion       string     `json:\"version\"`        // 版本号\n221\t\tUptimeSeconds int64      `json:\"uptime_seconds\"` // 运行时间（秒）\n222\t\tStats         SystemStats `json:\"stats\"`          // 统计信息\n223\t\tTimestamp     time.Time  `json:\"timestamp\"`      // 时间戳\n224\t}\n225\t\n226\t// SystemStats 是系统统计信息的响应结构。\n227\ttype SystemStats struct {\n228\t\tActiveSessions int64 `json:\"active_sessions\"` // 活跃会话数\n229\t\tActiveProxies  int64 `json:\"active_proxies\"`  // 活跃代理数\n230\t\tPendingIssues  int64 `json:\"pending_issues\"`  // 待处理 Issue 数\n231\t\tTotalMachines  int64 `json:\"total_machines\"`  // 机器总数\n232\t\tTotalProjects  int64 `json:\"total_projects\"`  // 项目总数\n233\t}\n234\t\n235\t// --- Shared helpers ---\n236\t\n237\t// APIError 是统一的 API 错误结构体。\n238\ttype APIError struct {\n239\t\tCode    string `json:\"error\"`   // 错误码\n240\t\tMessage string `json:\"message\"` // 错误描述\n241\t}\n242\t\n243\t// writeJSON 向响应中写入 JSON 数据，设置 Content-Type 为 application/json。\n244\tfunc writeJSON(w http.ResponseWriter, status int, v any) {\n245\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n246\t\tw.WriteHeader(status)\n247\t\tjson.NewEncoder(w).Encode(v)\n248\t}\n249\t\n250\t// writeError 向响应中写入统一的 API 错误信息。\n251\tfunc writeError(w http.ResponseWriter, status int, code, message string) {\n252\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n253\t\tw.WriteHeader(status)\n254\t\tjson.NewEncoder(w).Encode(APIError{Code: code, Message: message})\n255\t}\n256\t"}]}
