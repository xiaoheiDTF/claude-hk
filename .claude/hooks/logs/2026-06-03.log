()\n38\t\t\treturn nil, fmt.Errorf(\"set WAL mode: %w\", err)\n39\t\t}\n40\t\tlogger.Debug(\"store\", \"WAL mode set\")\n41\t\n42\t\t// 执行数据库迁移\n43\t\tif err := runMigrations(db); err != nil {\n44\t\t\tdb.Close()\n45\t\t\treturn nil, fmt.Errorf(\"run migrations: %w\", err)\n46\t\t}\n47\t\tlogger.Debug(\"store\", \"migrations complete\")\n48\t\n49\t\tlogger.Info(\"store\", \"sqlite store ready: %s\", dbPath)\n50\t\n51\t\tcs := &sqliteConfigStore{db: db}\n52\t\tif err := cs.InitDefaults(context.Background()); err != nil {\n53\t\t\tdb.Close()\n54\t\t\treturn nil, fmt.Errorf(\"init config defaults: %w\", err)\n55\t\t}\n56\t\n57\t\treturn &SQLiteStore{\n58\t\t\tdb:           db,\n59\t\t\tissueStore:   &sqliteIssueStore{db: db},\n60\t\t\tsessionStore: &sqliteSessionStore{db: db},\n61\t\t\tmachineStore: &sqliteMachineStore{db: db},\n62\t\t\tprojectStore: &sqliteProjectStore{db: db},\n63\t\t\tconfigStore:  cs,\n64\t\t\tproxyStore:   &sqliteProxyStore{db: db},\n65\t\t}, nil\n66\t}\n67\t\n68\t// Issues 返回 Issue 存储接口。\n69\tfunc (s *SQLiteStore) Issues() IssueStore { return s.issueStore }\n70\t\n71\t// Sessions 返回 Session 存储接口。\n72\tfunc (s *SQLiteStore) Sessions() SessionStore { return s.sessionStore }\n73\t\n74\t// Machines 返回 Machine 存储接口。\n75\tfunc (s *SQLiteStore) Machines() MachineStore { return s.machineStore }\n76\t\n77\t// Projects 返回 Project 存储接口。\n78\tfunc (s *SQLiteStore) Projects() ProjectStore { return s.projectStore }\n79\t\n80\t// Configs 返回 Config 存储接口。\n81\tfunc (s *SQLiteStore) Configs() ConfigStore { return s.configStore }\n82\t\n83\t// Proxies 返回 Proxy 存储接口。\n84\tfunc (s *SQLiteStore) Proxies() ProxyStore { return s.proxyStore }\n85\t\n86\t// DB 返回底层的 *sql.DB 连接（主要用于测试）。\n87\tfunc (s *SQLiteStore) DB() *sql.DB { return s.db }\n88\t\n89\t// Close 关闭数据库连接。\n90\tfunc (s *SQLiteStore) Close() error {\n91\t\terr := s.db.Close()\n92\t\tlogger.Info(\"store\", \"sqlite store closed\")\n93\t\treturn err\n94\t}\n95\t"}]}
