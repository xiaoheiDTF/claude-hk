"\" {\n46\t\t\treturn []TraceFileInfo{}, nil\n47\t\t}\n48\t\n49\t\t// 获取 trace 文件信息\n50\t\tinfo, err := getTraceFileInfo(sess.LocalTracePath)\n51\t\tif err != nil {\n52\t\t\tlogger.Warn(\"svc.trace\", \"get trace info failed: %v\", err)\n53\t\t\treturn []TraceFileInfo{}, nil\n54\t\t}\n55\t\n56\t\treturn []TraceFileInfo{*info}, nil\n57\t}\n58\t\n59\t// getTraceFileInfo 获取单个 trace 文件的元数据。\n60\tfunc getTraceFileInfo(path string) (*TraceFileInfo, error) {\n61\t\tstat, err := os.Stat(path)\n62\t\tif err != nil {\n63\t\t\treturn nil, err\n64\t\t}\n65\t\n66\t\t// 计算行数\n67\t\tlineCount, err := countLines(path)\n68\t\tif err != nil {\n69\t\t\tlineCount = 0\n70\t\t}\n71\t\n72\t\tdir := filepath.Dir(path)\n73\t\tdate := filepath.Base(dir)\n74\t\tfilename := filepath.Base(path)\n75\t\n76\t\treturn &TraceFileInfo{\n77\t\t\tPath:      path,\n78\t\t\tSizeBytes: stat.Size(),\n79\t\t\tLineCount: lineCount,\n80\t\t\tDate:      date,\n81\t\t\tFilename:  filename,\n82\t\t}, nil\n83\t}\n84\t\n85\t// countLines 计算文件行数。\n86\tfunc countLines(path string) (int, error) {\n87\t\tfile, err := os.Open(path)\n88\t\tif err != nil {\n89\t\t\treturn 0, err\n90\t\t}\n91\t\tdefer file.Close()\n92\t\n93\t\tcount := 0\n94\t\tscanner := bufio.NewScanner(file)\n95\t\tfor scanner.Scan() {\n96\t\t\tcount++\n97\t\t}\n98\t\treturn count, scanner.Err()\n99\t}\n100\t"}]}
