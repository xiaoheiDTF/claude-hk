\t\tswitch {\n91\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n92\t\t\t\ti++\n93\t\t\t\ttapTarget = args[i]\n94\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n95\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n96\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n97\t\t\t\ti++\n98\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n99\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n100\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n101\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n102\t\t\t\ti++\n103\t\t\t\ttapOutputDir = args[i]\n104\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n105\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n106\t\t\tcase arg == \"--tap-verbose\":\n107\t\t\t\ttapVerbose = true\n108\t\t\tcase arg == \"--\", arg == \"--claude\":\n109\t\t\t\t// Everything after -- (or --claude) goes to claude.\n110\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n111\t\t\t\ti = len(args) // stop parsing\n112\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n113\t\t\t\t// Unknown tap flag, skip.\n114\t\t\tdefault:\n115\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n116\t\t\t}\n117\t\t}\n118\t\n119\t\tif tapOutputDir == \"\" {\n120\t\t\ttapOutputDir = trace.DefaultTraceDir()\n121\t\t}\n122\t\n123\t\t// Detect upstream target.\n124\t\ttarget := tapTarget\n125\t\tif target == \"\" {\n126\t\t\ttarget = config.DetectTarget(&config.ClaudeClient)\n127\t\t}\n128\t\tif tapVerbose {\n129\t\t\tlog.Printf(\"upstream target: %s\", target)\n130\t\t}\n131\t\n132\t\t// Setup trace writer (proxy creates trace file on trace-init or first request).\n133\t\t// Start reverse proxy.\n134\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n135\t\tport := tapPort\n136\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n137\t\tif err != nil {\n138\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n139\t\t}\n140\t\tdefer rp.Stop()\n141\t\n142\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n143\t\tlog.Printf(\"