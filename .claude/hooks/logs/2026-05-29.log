tionTest(t)\n162\t\n163\t\tclaimViaAPI(t, env.srv.URL, \"test/repo\", 20, \"sess_a\")\n164\t\n165\t\tenv.srv.Close()\n166\t\tenv.store.Close()\n167\t\n168\t\tenv2 := setupDegradationTestWithDB(t, dbPath)\n169\t\tt.Cleanup(func() { os.Remove(dbPath) })\n170\t\n171\t\tresp := claimViaAPI(t, env2.srv.URL, \"test/repo\", 20, \"sess_b\")\n172\t\tdefer resp.Body.Close()\n173\t\n174\t\tif resp.StatusCode != http.StatusConflict {\n175\t\t\tt.Fatalf(\"expected 409 Conflict, got %d\", resp.StatusCode)\n176\t\t}\n177\t\n178\t\tvar result map[string]interface{}\n179\t\treadDegJSON(t, resp, &result)\n180\t\tif result[\"success\"] == true {\n181\t\t\tt.Error(\"expected success=false for already claimed issue\")\n182\t\t}\n183\t}\n184\t\n185\tfunc TestRecovery_ReleaseSessionAfterRestart(t *testing.T) {\n186\t\tenv, dbPath := setupDegradationTest(t)\n187\t\n188\t\tclaimViaAPI(t, env.srv.URL, \"test/repo\", 30, \"sess_a\")\n189\t\tstatusViaAPI(t, env.srv.URL, \"test/repo\", 30, \"sess_a\", \"fixing\")\n190\t\n191\t\tenv.srv.Close()\n192\t\tenv.store.Close()\n193\t\n194\t\tenv2 := setupDegradationTestWithDB(t, dbPath)\n195\t\tt.Cleanup(func() { os.Remove(dbPath) })\n196\t\n197\t\tresp := releaseSessionViaAPI(t, env2.srv.URL, \"sess_a\")\n198\t\tdefer resp.Body.Close()\n199\t\n200\t\tvar result struct {\n201\t\t\tReleased []int `json:\"released\"`\n202\t\t\tCount    int   `json:\"count\"`\n203\t\t}\n204\t\treadDegJSON(t, resp, &result)\n205\t\n206\t\tif result.Count != 1 {\n207\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n208\t\t}\n209\t\tif len(result.Released) != 1 || result.Released[0] != 30 {\n210\t\t\tt.Errorf(\"expected released=[30], got %v\", result.Released)\n211\t\t}\n212\t}\n213\t\n214\t// --- T14: Malformed request tests ---\n215\t\n216\tfunc TestMalformedRequest_InvalidJSON(t *testing.T) {\n217\t\tenv, _ := setupDegradationTest(t)\n218\t\tt.Cleanup(env.store.Close)\n219\t\n220\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/claim\", \"application/json\", strings.NewReader(\"not json\"))\n221\t\tif err != nil {\n222\t\t\tt.Fatal(err)\n223\t\t}\n224\t\tdefer resp.Body.Close()\n225\t\n226\t\tif resp.StatusCode != http.StatusBadRequest {\n227\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n228\t\t}\n229\t}\n230\t\n231\tfunc TestMalformedRequest_EmptyRequiredFields(t *testing.T) {\n232\t\tenv, _ := setupDegradationTest(t)\n233\t\tt.Cleanup(env.store.Close)\n234\t\n235\t\ttests := []struct {\n236\t\t\tname string\n237\t\t\tbody string\n238\t\t}{\n239\t\t\t{\"empty repo\", `{\"repo_full_name\":\"\",\"issue_number\":1,\"session_id\":\"s1\"}`},\n240\t\t\t{\"zero issue_number\", `{\"repo_full_name\":\"r\",\"issue_number\":0,\"session_id\":\"s1\"}`},\n241\t\t\t{\"empty session_id\", `{\"repo_full_name\":\"r\",\"issue_number\":1,\"session_id\":\"\"}`},\n242\t\t}\n243\t\n244\t\tfor _, tt := range tests {\n245\t\t\tt.Run(tt.name, func(t *testing.T) {\n246\t\t\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/claim\", \"application/json\", strings.NewReader(tt.body))\n247\t\t\t\tif err != nil {\n248\t\t\t\t\tt.Fatal(err)\n249\t\t\t\t}\n250\t\t\t\tdefer resp.Body.Close()\n251\t\n252\t\t\t\tif resp.StatusCode != http.StatusBadRequest {\n253\t\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n254\t\t\t\t}\n255\t\t\t})\n256\t\t}\n257\t}\n258\t\n259\tfunc TestMalformedRequest_NegativeIssueNumber(t *testing.T) {\n260\t\tenv, _ := setupDegradationTest(t)\n261\t\tt.Cleanup(env.store.Close)\n262\t\n263\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/check\", \"application/json\",\n264\t\t\tstrings.NewReader(`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[-1,-2]}`))\n265\t\tif err != nil {\n266\t\t\tt.Fatal(err)\n267\t\t}\n268\t\tdefer resp.Body.Close()\n269\t\n270\t\t// Backend should handle negative numbers gracefully (creates idle records)\n271\t\tif resp.StatusCode != http.StatusOK {\n272\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n273\t\t}\n274\t}\n275\t\n276\tfunc TestMalformedRequest_StatusEmptyFields(t *testing.T) {\n277\t\tenv, _ := setupDegradationTest(t)\n278\t\tt.Cleanup(env.store.Close)\n279\t\n280\t\ttests := []struct {\n281\t\t\tname string\n282\t\t\tbody string\n283\t\t}{\n284\t\t\t{\"empty status\", `{\"repo_full_name\":\"r\",\"issue_number\":1,\"session_id\":\"s1\",\"status\":\"\"}`},\n285\t\t\t{\"empty repo\", `{\"repo_full_name\":\"\",\"issue_number\":1,\"session_id\":\"s1\",\"status\":\"fixing\"}`},\n286\t\t\t{\"empty session\", `{\"repo_full_name\":\"r\",\"issue_number\":1,\"session_id\":\"\",\"status\":\"fixing\"}`},\n287\t\t}\n288\t\n289\t\tfor _, tt := range tests {\n290\t\t\tt.Run(tt.name, func(t *testing.T) {\n291\t\t\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/status\", \"application/json\", strings.NewReader(tt.body))\n292\t\t\t\tif err != nil {\n293\t\t\t\t\tt.Fatal(err)\n294\t\t\t\t}\n295\t\t\t\tdefer resp.Body.Close()\n296\t\n297\t\t\t\tif resp.StatusCode != http.StatusBadRequest {\n298\t\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n299\t\t\t\t}\n300\t\t\t})\n301\t\t}\n302\t}\n303\t\n304\tfunc TestMalformedRequest_ExtraFieldsIgnored(t *testing.T) {\n305\t\tenv, _ := setupDegradationTest(t)\n306\t\tt.Cleanup(env.store.Close)\n307\t\n308\t\t// Extra fields should be silently ignored\n309\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/check\", \"application/json\",\n310\t\t\tstrings.NewReader(`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1],\"extra\":\"ignored\"}`))\n311\t\tif err != nil {\n312\t\t\tt.Fatal(err)\n313\t\t}\n314\t\tdefer resp.Body.Close()\n315\t\n316\t\tif resp.StatusCode != http.StatusOK {\n317\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n318\t\t}\n319\t}\n320\t\n321\tfunc TestMalformedRequest_InvalidMethod(t *testing.T) {\n322\t\tenv, _ := setupDegradationTest(t)\n323\t\tt.Cleanup(env.store.Close)\n324\t\n325\t\t// GET instead of POST\n326\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/claim\")\n327\t\tif err != nil {\n328\t\t\tt.Fatal(err)\n329\t\t}\n330\t\tdefer resp.Body.Close()\n331\t\n332\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n333\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n334\t\t}\n335\t}\n336\t\n337\tfunc TestMalformedRequest_ReleaseSessionEmptySessionID(t *testing.T) {\n338\t\tenv, _ := setupDegradationTest(t)\n339\t\tt.Cleanup(env.store.Close)\n340\t\n341\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/release-session\", \"application/json\",\n342\t\t\tstrings.NewReader(`{\"session_id\":\"\"}`))\n343\t\tif err != nil {\n344\t\t\tt.Fatal(err)\n345\t\t}\n346\t\tdefer resp.Body.Close()\n347\t\n348\t\tif resp.StatusCode != http.StatusBadRequest {\n349\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n350\t\t}\n351\t}\n352\t\n353\tfunc TestMalformedRequest_UnicodeInFields(t *testing.T) {\n354\t\tenv, _ := setupDegradationTest(t)\n355\t\tt.Cleanup(env.store.Close)\n356\t\n357\t\tbody := `{\"repo_full_name\":\"测试/仓库\",\"issue_numbers\":[1]}`\n358\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/check\", \"application/json\", strings.NewReader(body))\n359\t\tif err != nil {\n360\t\t\tt.Fatal(err)\n361\t\t}\n362\t\tdefer resp.Body.Close()\n363\t\n364\t\tif resp.StatusCode != http.StatusOK {\n365\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n366\t\t}\n367\t}\n368\t"}]}
