on_id\":\"sess_merge\",\"status\":\"%s\"}`, s))\n944\t\t\t}\n945\t\n946\t\t\tresp := e.post(t, \"/api/issue/status\",\n947\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":50,\"session_id\":\"sess_merge\",\"status\":\"merged\"}`)\n948\t\t\tvar result struct {\n949\t\t\t\tSuccess        bool   `json:\"success\"`\n950\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n951\t\t\t\tNewStatus      string `json:\"new_status\"`\n952\t\t\t}\n953\t\t\treadJSON(t, resp, &result)\n954\t\t\tif !result.Success {\n955\t\t\t\tt.Fatal(\"merged update failed\")\n956\t\t\t}\n957\t\t\tif result.PreviousStatus != \"reviewing\" {\n958\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n959\t\t\t}\n960\t\n961\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{50})\n962\t\t\tif s[50] != \"merged\" {\n963\t\t\t\tt.Fatalf(\"expected merged, got %s\", s[50])\n964\t\t\t}\n965\t\t})\n966\t\n967\t\tt.Run(\"merged_not_released_on_session_end\", func(t *testing.T) {\n968\t\t\t// 验收：merged 终态不被 session end 释放\n969\t\t\te := setup(t)\n970\t\t\tdb := e.store.DB()\n971\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_merged\", \"2026-05-27T10:00:00Z\")\n972\t\n973\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n974\t\t\t\t`{\"session_id\":\"sess_merged\"}`)\n975\t\t\tvar rel struct{ Count int `json:\"count\"` }\n976\t\t\treadJSON(t, resp, &rel)\n977\t\t\tif rel.Count != 0 {\n978\t\t\t\tt.Fatalf(\"merged should not be released, got count=%d\", rel.Count)\n979\t\t\t}\n980\t\n981\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n982\t\t\tif s[10] != \"merged\" {\n983\t\t\t\tt.Errorf(\"expected merged unchanged, got %s\", s[10])\n984\t\t\t}\n985\t\t})\n986\t\n987\t\tt.Run(\"reject_full_flow\", func(t *testing.T) {\n988\t\t\te := setup(t)\n989\t\n990\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 55, \"sess_reject\")\n991\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n992\t\t\t\te.post(t, \"/api/issue/status\",\n993\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":55,\"session_id\":\"sess_reject\",\"status\":\"%s\"}`, s))\n994\t\t\t}\n995\t\n996\t\t\tresp := e.post(t, \"/api/issue/status\",\n997\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":55,\"session_id\":\"sess_reject\",\"status\":\"rejected\"}`)\n998\t\t\tvar result struct {\n999\t\t\t\tSuccess        bool   `json:\"success\"`\n1000\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1001\t\t\t}\n1002\t\t\treadJSON(t, resp, &result)\n1003\t\t\tif !result.Success {\n1004\t\t\t\tt.Fatal(\"rejected update failed\")\n1005\t\t\t}\n1006\t\t\tif result.PreviousStatus != \"reviewing\" {\n1007\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1008\t\t\t}\n1009\t\n1010\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{55})\n1011\t\t\tif s[55] != \"rejected\" {\n1012\t\t\t\tt.Fatalf(\"expected rejected, got %s\", s[55])\n1013\t\t\t}\n1014\t\t})\n1015\t\n1016\t\tt.Run(\"rejected_not_released_on_session_end\", func(t *testing.T) {\n1017\t\t\t// 验收：rejected 终态不被 session end 释放\n1018\t\t\te := setup(t)\n1019\t\t\tdb := e.store.DB()\n1020\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"rejected\", \"sess_rejected\", \"2026-05-27T10:00:00Z\")\n1021\t\n1022\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1023\t\t\t\t`{\"session_id\":\"sess_rejected\"}`)\n1024\t\t\tvar rel struct{ Count int `json:\"count\"` }\n1025\t\t\treadJSON(t, resp, &rel)\n1026\t\t\tif rel.Count != 0 {\n1027\t\t\t\tt.Fatalf(\"rejected should not be released, got count=%d\", rel.Count)\n1028\t\t\t}\n1029\t\n1030\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{11})\n1031\t\t\tif s[11] != \"rejected\" {\n1032\t\t\t\tt.Errorf(\"expected rejected unchanged, got %s\", s[11])\n1033\t\t\t}\n1034\t\t})\n1035\t\n1036\t\tt.Run(\"non_terminal_reviewing_released_on_sessi