\n56\t}\n57\t\n58\tfunc (e *testEnv) post(t *testing.T, path, body string) *http.Response {\n59\t\tt.Helper()\n60\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n61\t\tif err != nil {\n62\t\t\tt.Fatal(err)\n63\t\t}\n64\t\treturn resp\n65\t}\n66\t\n67\tfunc readJSON(t *testing.T, resp *http.Response, v any) {\n68\t\tt.Helper()\n69\t\tdefer resp.Body.Close()\n70\t\tb, err := io.ReadAll(resp.Body)\n71\t\tif err != nil {\n72\t\t\tt.Fatal(err)\n73\t\t}\n74\t\tif err := json.Unmarshal(b, v); err != nil {\n75\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n76\t\t}\n77\t}\n78\t\n79\tfunc seedIssue(db *sql.DB, repo string, number int, status, sessionID, claimedAt string) {\n80\t\tdb.Exec(\n81\t\t\t`INSERT INTO issue_claims (repo_full_name, issue_number, status, session_id, claimed_at, updated_at)\n82\t\t\t VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)`,\n83\t\t\trepo, number, status,\n84\t\t\tnilIfEmpty(sessionID), nilIfEmpty(claimedAt),\n85\t\t)\n86\t}\n87\t\n88\tfunc nilIfEmpty(s string) any {\n89\t\tif s == \"\" {\n90\t\t\treturn nil\n91\t\t}\n92\t\treturn s\n93\t}\n94\t\n95\t// --- tests ---\n96\t\n97\tfunc TestHealth(t *testing.T) {\n98\t\tenv := setupTest(t)\n99\t\n100\t\tresp, err := http.Get(env.srv.URL + \"/health\")\n101\t\tif err != nil {\n102\t\t\tt.Fatal(err)\n103\t\t}\n104\t\tdefer resp.Body.Close()\n105\t\n106\t\tif resp.StatusCode != http.StatusOK {\n107\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n108\t\t}\n109\t\n110\t\tvar result map[string]string\n111\t\treadJSON(t, resp, &result)\n112\t\tif result[\"status\"] != \"ok\" {\n113\t\t\tt.Errorf(\"expected status=ok, got %s\", result[\"status\"])\n114\t\t}\n115\t}\n116\t\n117\tfunc TestCheckIssues_EmptyArray(t *testing.T) {\n118\t\tenv := setupTest(t)\n119\t\n120\t\tresp := env.post(t, \"/api/issue/check\",\n121\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[]}`)\n122\t\n123\t\tvar result struct {\n124\t\t\tIssues []any `json:\"issues\"`\n125\t\t}\n126\t\treadJSON(t, resp, &result)\n127\t\n128\t\tif resp.StatusCode != http.StatusOK {\n129\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n130\t\t}\n131\t\tif len(result.Issues) != 0 {\n132\t\t\tt.Fatalf(\"expected empty issues, got %d\", len(result.Issues))\n133\t\t}\n134\t}\n135\t\n136\tfunc TestCheckIssues_NewIssuesAutoCreatedAsIdle(t *testing.T) {\n137\t\tenv := setupTest(t)\n138\t\n139\t\tresp := env.post(t, \"/api/issue/check\",\n140\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2,3]}`)\n141\t\n142\t\tvar result struct {\n143\t\t\tIssues []struct {\n144\t\t\t\tNumber    int     `json:\"number\"`\n145\t\t\t\tStatus    string  `json:\"status\"`\n146\t\t\t\tSessionID *string `json:\"session_id\"`\n147\t\t\t\tClaimedAt *string `json:\"claimed_at\"`\n148\t\t\t} `json:\"issues\"`\n149\t\t}\n150\t\treadJSON(t, resp, &result)\n151\t\n152\t\tif resp.StatusCode != http.StatusOK {\n153\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n154\t\t}\n155\t\tif len(result.Issues) != 3 {\n156\t\t\tt.Fatalf(\"expected 3 issues, got %d\", len(result.Issues))\n157\t\t}\n158\t\n159\t\tfor _, issue := range result.Issues {\n160\t\t\tif issue.Status != \"idle\" {\n161\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", issue.Number, issue.Status)\n162\t\t\t}\n163\t\t\tif issue.SessionID != nil {\n164\t\t\t\tt.Errorf(\"issue %d: expected null session_id, got %v\", issue.Number, *issue.SessionID)\n165\t\t\t}\n166\t\t\tif issue.ClaimedAt != nil {\n167\t\t\t\tt.Errorf(\"issue %d: expected null claimed_at, got %v\", issue.Number, *issue.ClaimedAt)\n168\t\t\t}\n169\t\t}\n170\t}\n171\t\n172\tfunc TestCheckIssues_ClaimedAndMerged(t *testing.T) {\n173\t\tenv := setupTest(t)\n174\t\tdb := env.store.DB()\n175\t\n176\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n177\t\tseedIssue(db, \"test/repo\", 11, \"merged\", \"\", \"\")\n178\t\n179\t\tresp := env.post(t, \"/api/issue/check\",\n180\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[9,10,11,12]}`)\n181\t\n182\t\tvar result struct {\n183\t\t\tIssues []struct {\n184\t\t\t\tNumber    int     `json:\"number\"`\n185\t\t\t\tStatus    string  `json:\"status\"`\n186\t\t\t\tSessionID *string `json:\"session_id\"`\n187\t\t\t\tClaimedAt *string `json:\"claimed_at\"`\n188\t\t\t} `json:\"issues\"`\n189\t\t}\n190\t\treadJSON(t, resp, &result)\n191\t\n192\t\tif resp.StatusCode != http.StatusOK {\n193\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n194\t\t}\n195\t\tif len(result.Issues) != 4 {\n196\t\t\tt.Fatalf(\"expected 4 issues, got %d\", len(result.Issues))\n197\t\t}\n198\t\n199\t\tbyNumber := map[int]*struct {\n200\t\t\tNumber    int     `json:\"number\"`\n201\t\t\tStatus    string  `json:\"status\"`\n202\t\t\tSessionID *string `json:\"session_id\"`\n203\t\t\tClaimedAt *string `json:\"claimed_at\"`\n204\t\t}{}\n205\t\tfor i := range result.Issues {\n206\t\t\tbyNumber[result.Issues[i].Number] = &result.Issues[i]\n207\t\t}\n208\t\n209\t\t// #9: new → idle\n210\t\tif byNumber[9].Status != \"idle\" {\n211\t\t\tt.Errorf(\"issue 9: expected idle, got %s\", byNumber[9].Status)\n212\t\t}\n213\t\n214\t\t// #10: claimed\n215\t\tif byNumber[10].Status != \"claimed\" {\n216\t\t\tt.Errorf(\"issue 10: expected claimed, got %s\", byNumber[10].Status)\n217\t\t}\n218\t\tif byNumber[10].SessionID == nil || *byNumber[10].SessionID != \"sess_abc\" {\n219\t\t\tt.Errorf(\"issue 10: expected session_id=sess_abc, got %v\", byNumber[10].SessionID)\n220\t\t}\n221\t\tif byNumber[10].ClaimedAt == nil {\n222\t\t\tt.Error(\"issue 10: expected non-nil claimed_at\")\n223\t\t}\n224\t\n225\t\t// #11: merged\n226\t\tif byNumber[11].Status != \"merged\" {\n227\t\t\tt.Errorf(\"issue 11: expected merged, got %s\", byNumber[11].Status)\n228\t\t}\n229\t\tif byNumber[11].SessionID != nil {\n230\t\t\tt.Errorf(\"issue 11: expected null session_id, got %v\", byNumber[11].SessionID)\n231\t\t}\n232\t\n233\t\t// #12: new → idle\n234\t\tif byNumber[12].Status != \"idle\" {\n235\t\t\tt.Errorf(\"issue 12: expected idle, got %s\", byNumber[12].Status)\n236\t\t}\n237\t}\n238\t\n239\tfunc TestCheckIssues_MissingRepoFullName(t *testing.T) {\n240\t\tenv := setupTest(t)\n241\t\n242\t\tresp := env.post(t, \"/api/issue/check\",\n243\t\t\t`{\"issue_numbers\":[1]}`)\n244\t\n245\t\tvar errResp struct {\n246\t\t\tCode    string `json:\"error\"`\n247\t\t\tMessage string `json:\"message\"`\n248\t\t}\n249\t\treadJSON(t, resp, &errResp)\n250\t\n251\t\tif resp.StatusCode != http.StatusBadRequest {\n252\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n253\t\t}\n254\t\tif errResp.Code != \"invalid_request\" {\n255\t\t\tt.Errorf(\"expected error=invalid_request, got %s\", errResp.Code)\n256\t\t}\n257\t}\n258\t\n259\tfunc TestCheckIssues_MissingIssueNumbers(t *testing.T) {\n260\t\tenv := setupTest(t)\n261\t\n262\t\tresp := env.post(t, \"/api/issue/check\",\n263\t\t\t`{\"repo_full_name\":\"test/repo\"}`)\n264\t\n265\t\tvar errResp struct {\n266\t\t\tCode    string `json:\"error\"`\n267\t\t\tMessage string `json:\"message\"`\n268\t\t}\n269\t\treadJSON(t, resp, &errResp)\n270\t\n271\t\tif resp.StatusCode != http.StatusBadRequest {\n272\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n273\t\t}\n274\t\tif errResp.Code != \"invalid_request\" {\n275\t\t\tt.Errorf(\"expected error=invalid_request, got %s\", errResp.Code)\n276\t\t}\n277\t}\n278\t\n279\tfunc TestCheckIssues_InvalidJSON(t *testing.T) {\n280\t\tenv := setupTest(t)\n281\t\n282\t\tresp := env.post(t, \"/api/issue/check\", `not json`)\n283\t\n284\t\tvar errResp struct {\n285\t\t\tCode    string `json:\"error\"`\n286\t\t\tMessage string `json:\"message\"`\n287\t\t}\n288\t\treadJSON(t, resp, &errResp)\n289\t\n290\t\tif resp.StatusCode != http.StatusBadRequest {\n291\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n292\t\t}\n293\t\tif errResp.Code != \"invalid_request\" {\n294\t\t\tt.Errorf(\"expected error=invalid_request, got %s\", errResp.Code)\n295\t\t}\n296\t}\n297\t\n298\tfunc TestCheckIssues_MethodNotAllowed(t *testing.T) {\n299\t\tenv := setupTest(t)\n300\t\n301\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/check\")\n302\t\tif err != nil {\n303\t\t\tt.Fatal(err)\n304\t\t}\n305\t\n306\t\tvar errResp struct {\n307\t\t\tCode    string `json:\"error\"`\n308\t\t\tMessage string `json:\"message\"`\n309\t\t}\n310\t\treadJSON(t, resp, &errResp)\n311\t\n312\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n313\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n314\t\t}\n315\t\tif errResp.Code != \"method_not_allowed\" {\n316\t\t\tt.Errorf(\"expected error=method_not_allowed, got %s\", errResp.Code)\n317\t\t}\n318\t}\n319\t\n320\tfunc TestCheckIssues_IdempotentOnRepeatedCalls(t *testing.T) {\n321\t\tenv := setupTest(t)\n322\t\n323\t\t// First call creates idle records\n324\t\tenv.post(t, \"/api/issue/check\",\n325\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2]}`)\n326\t\n327\t\t// Second call should return the same idle records\n328\t\tresp := env.post(t, \"/api/issue/check\",\n329\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2]}`)\n330\t\n331\t\tvar result struct {\n332\t\t\tIssues []struct {\n333\t\t\t\tNumber int    `json:\"number\"`\n334\t\t\t\tStatus string `json:\"status\"`\n335\t\t\t} `json:\"issues\"`\n336\t\t}\n337\t\treadJSON(t, resp, &result)\n338\t\n339\t\tif resp.StatusCode != http.StatusOK {\n340\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n341\t\t}\n342\t\tif len(result.Issues) != 2 {\n343\t\t\tt.Fatalf(\"expected 2 issues, got %d\", len(result.Issues))\n344\t\t}\n345\t\tfor _, issue := range result.Issues {\n346\t\t\tif issue.Status != \"idle\" {\n347\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", issue.Number, issue.Status)\n348\t\t\t}\n349\t\t}\n350\t}\n351\t\n352\t// --- Release Issue tests ---\n353\t// POST /api/issue/release — 单个 issue 释放\n354\t// 验收标准：\n355\t//   - 领取者可释放自己的 issue\n356\t//   - 非领取者无法释放（返回 not_owner）\n357\t//   - merged/rejected 终态不被释放\n358\t//   - 参数缺失时返回错误\n359\t\n360\tfunc TestReleaseIssue(t *testing.T) {\n361\t\tt.Run(\"owner_can_release\", func(t *testing.T) {\n362\t\t\t// 验收：领取者可释放自己的 issue\n363\t\t\t// 预置 #10 为 claimed（sess_abc 领取），用 sess_abc 调 release → success=true\n364\t\t\t// 释放后再 check 验证 #10 回到 idle、session_id=null\n365\t\t\tenv := setupTest(t)\n366\t\t\tdb := env.store.DB()\n367\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n368\t\n369\t\t\tresp := env.post(t, \"/api/issue/release\",\n370\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n371\t\n372\t\t\tvar result struct {\n373\t\t\t\tSuccess  bool  `json:\"success\"`\n374\t\t\t\tReleased *bool `json:\"released\"`\n375\t\t\t\tError    string `json:\"error\"`\n376\t\t\t}\n377\t\t\treadJSON(t, resp, &result)\n378\t\n379\t\t\tif resp.StatusCode != http.StatusOK {\n380\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n381\t\t\t}\n382\t\t\tif !result.Success {\n383\t\t\t\tt.Fatalf(\"expected success=true, got false (error: %s)\", result.Error)\n384\t\t\t}\n385\t\t\tif result.Released == nil || !*result.Released {\n386\t\t\t\tt.Fatal(\"expected released=true\")\n387\t\t\t}\n388\t\n389\t\t\t// 验证 issue 状态已回到 idle\n390\t\t\tcheckResp := env.post(t, \"/api/issue/check\",\n391\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[10]}`)\n392\t\t\tvar check struct {\n393\t\t\t\tIssues []struct {\n394\t\t\t\t\tStatus    string  `json:\"status\"`\n395\t\t\t\t\tSessionID *string `json:\"session_id\"`\n396\t\t\t\t} `json:\"issues\"`\n397\t\t\t}\n398\t\t\treadJSON(t, checkResp, &check)\n399\t\t\tif len(check.Issues) != 1 {\n400\t\t\t\tt.Fatalf(\"expected 1 issue, got %d\", len(check.Issues))\n401\t\t\t}\n402\t\t\tif check.Issues[0].Status != \"idle\" {\n403\t\t\t\tt.Errorf(\"expected idle after release, got %s\", check.Issues[0].Status)\n404\t\t\t}\n405\t\t\tif check.Issues[0].SessionID != nil {\n406\t\t\t\tt.Error(\"session_id should be null after release\")\n407\t\t\t}\n408\t\t})\n409\t\n410\t\tt.Run(\"non_owner_cannot_release\", func(t *testing.T) {\n411\t\t\t// 验收：非领取者无法释放（返回 not_owner）\n412\t\t\t// 预置 #10 为 claimed（sess_abc 领取），用 sess_other 调 release → success=false, error=not_owner\n413\t\t\tenv := setupTest(t)\n414\t\t\tdb := env.store.DB()\n415\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n416\t\n417\t\t\tresp := env.post(t, \"/api/issue/release\",\n418\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\"}`)\n419\t\n420\t\t\tvar result struct {\n421\t\t\t\tSuccess bool   `json:\"success\"`\n422\t\t\t\tError   string `json:\"error\"`\n423\t\t\t}\n424\t\t\treadJSON(t, resp, &result)\n425\t\n426\t\t\tif resp.StatusCode != http.StatusOK {\n427\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n428\t\t\t}\n429\t\t\tif result.Success {\n430\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n431\t\t\t}\n432\t\t\tif result.Error != \"not_owner\" {\n433\t\t\t\tt.Fatalf(\"expected error=not_owner, got %s\", result.Error)\n434\t\t\t}\n435\t\t})\n436\t\n437\t\tt.Run(\"terminal_merged_not_released\", func(t *testing.T) {\n438\t\t\t// 验收：merged 状态的 issue 不被释放\n439\t\t\t// 预置 #10 为 merged（sess_abc 领取），用 sess_abc 调 release → success=false\n440\t\t\t// 即使是领取者本人，终态也不可释放\n441\t\t\tenv := setupTest(t)\n442\t\t\tdb := env.store.DB()\n443\t\t\tseedIssue(db, \"test/repo\", 10, \"merged\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n444\t\n445\t\t\tresp := env.post(t, \"/api/issue/release\",\n446\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n447\t\n448\t\t\tvar result struct {\n449\t\t\t\tSuccess bool `json:\"success\"`\n450\t\t\t}\n451\t\t\treadJSON(t, resp, &result)\n452\t\n453\t\t\tif result.Success {\n454\t\t\t\tt.Fatal(\"merged issue should not be released\")\n455\t\t\t}\n456\t\t})\n457\t\n458\t\tt.Run(\"terminal_rejected_not_released\", func(t *testing.T) {\n459\t\t\t// 验收：rejected 状态的 issue 不被释放\n460\t\t\t// 预置 #10 为 rejected（sess_abc 领取），用 sess_abc 调 release → success=false\n461\t\t\tenv := setupTest(t)\n462\t\t\tdb := env.store.DB()\n463\t\t\tseedIssue(db, \"test/repo\", 10, \"rejected\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n464\t\n465\t\t\tresp := env.post(t, \"/api/issue/release\",\n466\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n467\t\n468\t\t\tvar result struct {\n469\t\t\t\tSuccess bool `json:\"success\"`\n470\t\t\t}\n471\t\t\treadJSON(t, resp, &result)\n472\t\n473\t\t\tif result.Success {\n474\t\t\t\tt.Fatal(\"rejected issue should not be released\")\n475\t\t\t}\n476\t\t})\n477\t\n478\t\tt.Run(\"non_terminal_statuses_releasable\", func(t *testing.T) {\n479\t\t\t// 补充：非终态（claimed/fixing/ready-for-pr/pr-created/testing/reviewing）都可释放\n480\t\t\t// 预置 #10 为 fixing（sess_abc），释放后验证回到 idle\n481\t\t\tenv := setupTest(t)\n482\t\t\tdb := env.store.DB()\n483\t\t\tseedIssue(db, \"test/repo\", 10, \"fixing\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n484\t\n485\t\t\tresp := env.post(t, \"/api/issue/release\",\n486\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n487\t\n488\t\t\tvar result struct {\n489\t\t\t\tSuccess  bool  `json:\"success\"`\n490\t\t\t\tReleased *bool `json:\"released\"`\n491\t\t\t}\n492\t\t\treadJSON(t, resp, &result)\n493\t\n494\t\t\tif !result.Success {\n495\t\t\t\tt.Fatal(\"fixing status should be releasable by owner\")\n496\t\t\t}\n497\t\t\tif result.Released == nil || !*result.Released {\n498\t\t\t\tt.Fatal(\"expected released=true\")\n499\t\t\t}\n500\t\t})\n501\t\n502\t\tt.Run(\"nonexistent_issue_returns_not_owner\", func(t *testing.T) {\n503\t\t\t// 补充：issue 不存在时返回 success=false（无记录可释放）\n504\t\t\tenv := setupTest(t)\n505\t\n506\t\t\tresp := env.post(t, \"/api/issue/release\",\n507\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":999,\"session_id\":\"sess_abc\"}`)\n508\t\n509\t\t\tvar result struct {\n510\t\t\t\tSuccess bool `json:\"success\"`\n511\t\t\t}\n512\t\t\treadJSON(t, resp, &result)\n513\t\n514\t\t\tif result.Success {\n515\t\t\t\tt.Fatal(\"nonexistent issue should not be released\")\n516\t\t\t}\n517\t\t})\n518\t\n519\t\tt.Run(\"missing_params_returns_400\", func(t *testing.T) {\n520\t\t\t// 验收：参数缺失时返回错误响应\n521\t\t\t// 缺少 session_id → 400\n522\t\t\tenv := setupTest(t)\n523\t\n524\t\t\tresp := env.post(t, \"/api/issue/release\",\n525\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10}`)\n526\t\n527\t\t\tif resp.StatusCode != http.StatusBadRequest {\n528\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n529\t\t\t}\n530\t\t})\n531\t}\n532\t\n533\t// --- Release Session tests ---\n534\t// POST /api/issue/release-session — 按 session 批量释放\n535\t// 验收标准：\n536\t//   - 释放该 session 所有未终态的 issue\n537\t//   - 已合并/打回的 issue 不受影响\n538\t//   - 无领取记录的 session 返回空列表\n539\t\n540\tfunc TestReleaseSession(t *testing.T) {\n541\t\tt.Run(\"releases_all_non_terminal\", func(t *testing.T) {\n542\t\t\t// 验收：释放该 session 所有未终态的 issue\n543\t\t\t// 验收：已合并/打回的 issue 不受影响\n544\t\t\t// 预置 sess_abc 领取 3 个 issue：\n545\t\t\t//   #10 claimed（非终态，应释放）\n546\t\t\t//   #11 fixing（非终态，应释放）\n547\t\t\t//   #12 merged（终态，不应释放）\n548\t\t\t// 调 release-session → released=[10,11], count=2\n549\t\t\t// 再 check 验证 #10/#11 回到 idle，#12 仍为 merged\n550\t\t\tenv := setupTest(t)\n551\t\t\tdb := env.store.DB()\n552\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n553\t\t\tseedIssue(db, \"test/repo\", 11, \"fixing\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n554\t\t\tseedIssue(db, \"test/repo\", 12, \"merged\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n555\t\n556\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n557\t\t\t\t`{\"session_id\":\"sess_abc\"}`)\n558\t\n559\t\t\tvar result struct {\n560\t\t\t\tReleased []int `json:\"released\"`\n561\t\t\t\tCount    int   `json:\"count\"`\n562\t\t\t}\n563\t\t\treadJSON(t, resp, &result)\n564\t\n565\t\t\tif resp.StatusCode != http.StatusOK {\n566\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n567\t\t\t}\n568\t\t\tif result.Count != 2 {\n569\t\t\t\tt.Fatalf(\"expected 2 released, got %d\", result.Count)\n570\t\t\t}\n571\t\n572\t\t\treleasedSet := map[int]bool{}\n573\t\t\tfor _, n := range result.Released {\n574\t\t\t\treleasedSet[n] = true\n575\t\t\t}\n576\t\t\tif !releasedSet[10] || !releasedSet[11] {\n577\t\t\t\tt.Fatalf(\"expected issues 10 and 11 in released, got %v\", result.Released)\n578\t\t\t}\n579\t\n580\t\t\t// 验证 #12（merged）不受影响\n581\t\t\tcheckResp := env.post(t, \"/api/issue/check\",\n582\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[10,11,12]}`)\n583\t\t\tvar check struct {\n584\t\t\t\tIssues []struct {\n585\t\t\t\t\tNumber int    `json:\"number\"`\n586\t\t\t\t\tStatus string `json:\"status\"`\n587\t\t\t\t} `json:\"issues\"`\n588\t\t\t}\n589\t\t\treadJSON(t, checkResp, &check)\n590\t\n591\t\t\tbyNum := map[int]string{}\n592\t\t\tfor _, iss := range check.Issues {\n593\t\t\t\tbyNum[iss.Number] = iss.Status\n594\t\t\t}\n595\t\t\tif byNum[10] != \"idle\" || byNum[11] != \"idle\" {\n596\t\t\t\tt.Fatalf(\"expected 10,11 idle after release, got %v\", byNum)\n597\t\t\t}\n598\t\t\tif byNum[12] != \"merged\" {\n599\t\t\t\tt.Fatalf(\"expected 12 still merged, got %s\", byNum[12])\n600\t\t\t}\n601\t\t})\n602\t\n603\t\tt.Run(\"rejected_not_released\", func(t *testing.T) {\n604\t\t\t// 验收：已打回的 issue 不受影响\n605\t\t\t// 预置 sess_abc 领取 #10（rejected），调 release-session → count=0\n606\t\t\tenv := setupTest(t)\n607\t\t\tdb := env.store.DB()\n608\t\t\tseedIssue(db, \"test/repo\", 10, \"rejected\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n609\t\n610\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n611\t\t\t\t`{\"session_id\":\"sess_abc\"}`)\n612\t\n613\t\t\tvar result struct {\n614\t\t\t\tCount int `json:\"count\"`\n615\t\t\t}\n616\t\t\treadJSON(t, resp, &result)\n617\t\n618\t\t\tif result.Count != 0 {\n619\t\t\t\tt.Fatalf(\"rejected should not be released, got count=%d\", result.Count)\n620\t\t\t}\n621\t\t})\n622\t\n623\t\tt.Run(\"no_claims_returns_empty\", func(t *testing.T) {\n624\t\t\t// 验收：无领取记录的 session 返回空列表\n625\t\t\t// 无任何预置数据，调 release-session → released=[], count=0\n626\t\t\tenv := setupTest(t)\n627\t\n628\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n629\t\t\t\t`{\"session_id\":\"sess_none\"}`)\n630\t\n631\t\t\tvar result struct {\n632\t\t\t\tReleased []int `json:\"released\"`\n633\t\t\t\tCount    int   `json:\"count\"`\n634\t\t\t}\n635\t\t\treadJSON(t, resp, &result)\n636\t\n637\t\t\tif resp.StatusCode != http.StatusOK {\n638\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n639\t\t\t}\n640\t\t\tif result.Count != 0 {\n641\t\t\t\tt.Errorf(\"expected 0 released, got %d\", result.Count)\n642\t\t\t}\n643\t\t\tif len(result.Released) != 0 {\n644\t\t\t\tt.Errorf(\"expected empty released array, got %v\", result.Released)\n645\t\t\t}\n646\t\t})\n647\t\n648\t\tt.Run(\"only_releases_own_session\", func(t *testing.T) {\n649\t\t\t// 补充：只释放目标 session 的 issue，不影响其他 session\n650\t\t\t// 预置 #10（sess_abc claimed）和 #11（sess_other claimed）\n651\t\t\t// 调 release-session(sess_abc) → 只释放 #10，#11 不受影响\n652\t\t\tenv := setupTest(t)\n653\t\t\tdb := env.store.DB()\n654\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n655\t\t\tseedIssue(db, \"test/repo\", 11, \"claimed\", \"sess_other\", \"2026-05-26T10:00:00Z\")\n656\t\n657\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n658\t\t\t\t`{\"session_id\":\"sess_abc\"}`)\n659\t\n660\t\t\tvar result struct {\n661\t\t\t\tReleased []int `json:\"released\"`\n662\t\t\t\tCount    int   `json:\"count\"`\n663\t\t\t}\n664\t\t\treadJSON(t, resp, &result)\n665\t\n666\t\t\tif result.Count != 1 {\n667\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n668\t\t\t}\n669\t\t\tif len(result.Released) != 1 || result.Released[0] != 10 {\n670\t\t\t\tt.Fatalf(\"expected [10], got %v\", result.Released)\n671\t\t\t}\n672\t\n673\t\t\t// 验证 #11 仍为 claimed（sess_other 的）\n674\t\t\tcheckResp := env.post(t, \"/api/issue/check\",\n675\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[11]}`)\n676\t\t\tvar check struct {\n677\t\t\t\tIssues []struct {\n678\t\t\t\t\tStatus    string  `json:\"status\"`\n679\t\t\t\t\tSessionID *string `json:\"session_id\"`\n680\t\t\t\t} `json:\"issues\"`\n681\t\t\t}\n682\t\t\treadJSON(t, checkResp, &check)\n683\t\t\tif len(check.Issues) != 1 {\n684\t\t\t\tt.Fatalf(\"expected 1 issue, got %d\", len(check.Issues))\n685\t\t\t}\n686\t\t\tif check.Issues[0].Status != \"claimed\" {\n687\t\t\t\tt.Errorf(\"expected #11 still claimed, got %s\", check.Issues[0].Status)\n688\t\t\t}\n689\t\t\tif check.Issues[0].SessionID == nil || *check.Issues[0].SessionID != \"sess_other\" {\n690\t\t\t\tt.Error(\"expected #11 still owned by sess_other\")\n691\t\t\t}\n692\t\t})\n693\t\n694\t\tt.Run(\"missing_session_id_returns_400\", func(t *testing.T) {\n695\t\t\t// 验收：参数缺失时返回错误响应\n696\t\t\t// 缺少 session_id → 400\n697\t\t\tenv := setupTest(t)\n698\t\n699\t\t\tresp := env.post(t, \"/api/issue/release-session\", `{}`)\n700\t\n701\t\t\tif resp.StatusCode != http.StatusBadRequest {\n702\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n703\t\t\t}\n704\t\t})\n705\t}\n706\t\n707\t// --- D2: Issue Status Update tests ---\n708\t// POST /api/issue/status — 更新 issue 状态（D2-D6 使用）\n709\t// 验收标准：\n710\t//   - 领取者可将 issue 状态从 claimed 更新为 fixing\n711\t//   - 非 owner session 无法更新状态\n712\t//   - 不存在的 issue 返回 not_found\n713\t//   - 参数缺失时返回 400\n714\t//   - 同一状态幂等更新返回成功\n715\t//   - 完整流程：claim → fixing 验证状态正确流转\n716\t\n717\tfunc TestUpdateStatus(t *testing.T) {\n718\t\tt.Run(\"owner_can_update_to_fixing\", func(t *testing.T) {\n719\t\t\tenv := setupTest(t)\n720\t\t\tdb := env.store.DB()\n721\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n722\t\n723\t\t\tresp := env.post(t, \"/api/issue/status\",\n724\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n725\t\n726\t\t\tvar result struct {\n727\t\t\t\tSuccess        bool   `json:\"success\"`\n728\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n729\t\t\t\tNewStatus      string `json:\"new_status\"`\n730\t\t\t\tError          string `json:\"error\"`\n731\t\t\t}\n732\t\t\treadJSON(t, resp, &result)\n733\t\n734\t\t\tif resp.StatusCode != http.StatusOK {\n735\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n736\t\t\t}\n737\t\t\tif !result.Success {\n738\t\t\t\tt.Fatalf(\"expected success=true, got false (error: %s)\", result.Error)\n739\t\t\t}\n740\t\t\tif result.PreviousStatus != \"claimed\" {\n741\t\t\t\tt.Errorf(\"expected previous_status=claimed, got %s\", result.PreviousStatus)\n742\t\t\t}\n743\t\t\tif result.NewStatus != \"fixing\" {\n744\t\t\t\tt.Errorf(\"expected new_status=fixing, got %s\", result.NewStatus)\n745\t\t\t}\n746\t\n747\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n748\t\t\tif statuses[10] != \"fixing\" {\n749\t\t\t\tt.Errorf(\"expected fixing after update, got %s\", statuses[10])\n750\t\t\t}\n751\t\t})\n752\t\n753\t\tt.Run(\"non_owner_cannot_update\", func(t *testing.T) {\n754\t\t\tenv := setupTest(t)\n755\t\t\tdb := env.store.DB()\n756\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n757\t\n758\t\t\tresp := env.post(t, \"/api/issue/status\",\n759\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"fixing\"}`)\n760\t\n761\t\t\tvar result struct {\n762\t\t\t\tSuccess        bool   `json:\"success\"`\n763\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n764\t\t\t\tError          string `json:\"error\"`\n765\t\t\t}\n766\t\t\treadJSON(t, resp, &result)\n767\t\n768\t\t\tif result.Success {\n769\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n770\t\t\t}\n771\t\t\tif result.Error != \"not_owner\" {\n772\t\t\t\tt.Errorf(\"expected error=not_owner, got %s\", result.Error)\n773\t\t\t}\n774\t\n775\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n776\t\t\tif statuses[10] != \"claimed\" {\n777\t\t\t\tt.Errorf(\"expected status unchanged (claimed), got %s\", statuses[10])\n778\t\t\t}\n779\t\t})\n780\t\n781\t\tt.Run(\"nonexistent_issue_returns_not_found\", func(t *testing.T) {\n782\t\t\tenv := setupTest(t)\n783\t\n784\t\t\tresp := env.post(t, \"/api/issue/status\",\n785\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":999,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n786\t\n787\t\t\tvar result struct {\n788\t\t\t\tSuccess bool   `json:\"success\"`\n789\t\t\t\tError   string `json:\"error\"`\n790\t\t\t}\n791\t\t\treadJSON(t, resp, &result)\n792\t\n793\t\t\tif result.Success {\n794\t\t\t\tt.Fatal(\"expected success=false for nonexistent issue\")\n795\t\t\t}\n796\t\t\tif result.Error != \"not_found\" {\n797\t\t\t\tt.Errorf(\"expected error=not_found, got %s\", result.Error)\n798\t\t\t}\n799\t\t})\n800\t\n801\t\tt.Run(\"missing_params_returns_400\", func(t *testing.T) {\n802\t\t\tenv := setupTest(t)\n803\t\n804\t\t\tresp := env.post(t, \"/api/issue/status\",\n805\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n806\t\t\tif resp.StatusCode != http.StatusBadRequest {\n807\t\t\t\tt.Fatalf(\"expected 400 missing status, got %d\", resp.StatusCode)\n808\t\t\t}\n809\t\n810\t\t\tresp = env.post(t, \"/api/issue/status\",\n811\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"status\":\"fixing\"}`)\n812\t\t\tif resp.StatusCode != http.StatusBadRequest {\n813\t\t\t\tt.Fatalf(\"expected 400 missing session_id, got %d\", resp.StatusCode)\n814\t\t\t}\n815\t\n816\t\t\tresp = env.post(t, \"/api/issue/status\",\n817\t\t\t\t`{\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n818\t\t\tif resp.StatusCode != http.StatusBadRequest {\n819\t\t\t\tt.Fatalf(\"expected 400 missing repo, got %d\", resp.StatusCode)\n820\t\t\t}\n821\t\t})\n822\t\n823\t\tt.Run(\"idempotent_same_status\", func(t *testing.T) {\n824\t\t\tenv := setupTest(t)\n825\t\t\tdb := env.store.DB()\n826\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n827\t\n828\t\t\tresp := env.post(t, \"/api/issue/status\",\n829\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n830\t\t\tvar r1 struct{ Success bool `json:\"success\"` }\n831\t\t\treadJSON(t, resp, &r1)\n832\t\t\tif !r1.Success {\n833\t\t\t\tt.Fatal(\"first update should succeed\")\n834\t\t\t}\n835\t\n836\t\t\tresp = env.post(t, \"/api/issue/status\",\n837\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n838\t\t\tvar r2 struct {\n839\t\t\t\tSuccess   bool   `json:\"success\"`\n840\t\t\t\tNewStatus string `json:\"new_status\"`\n841\t\t\t}\n842\t\t\treadJSON(t, resp, &r2)\n843\t\t\tif !r2.Success {\n844\t\t\t\tt.Fatal(\"idempotent update should succeed\")\n845\t\t\t}\n846\t\t\tif r2.NewStatus != \"fixing\" {\n847\t\t\t\tt.Errorf(\"expected new_status=fixing, got %s\", r2.NewStatus)\n848\t\t\t}\n849\t\t})\n850\t\n851\t\tt.Run(\"full_claim_to_fix_flow\", func(t *testing.T) {\n852\t\t\tenv := setupTest(t)\n853\t\n854\t\t\t// 1. check 创建 idle\n855\t\t\tenv.post(t, \"/api/issue/check\",\n856\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[20]}`)\n857\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{20})\n858\t\t\tif s[20] != \"idle\" {\n859\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[20])\n860\t\t\t}\n861\t\n862\t\t\t// 2. claim\n863\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 20, \"sess_fix\")\n864\t\t\tif code != http.StatusOK || !ok {\n865\t\t\t\tt.Fatalf(\"step 2: claim failed\")\n866\t\t\t}\n867\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{20})\n868\t\t\tif s[20] != \"claimed\" {\n869\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", s[20])\n870\t\t\t}\n871\t\n872\t\t\t// 3. 标记 fixing\n873\t\t\tresp := env.post(t, \"/api/issue/status\",\n874\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":20,\"session_id\":\"sess_fix\",\"status\":\"fixing\"}`)\n875\t\t\tvar r struct {\n876\t\t\t\tSuccess        bool   `json:\"success\"`\n877\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n878\t\t\t\tNewStatus      string `json:\"new_status\"`\n879\t\t\t}\n880\t\t\treadJSON(t, resp, &r)\n881\t\t\tif !r.Success {\n882\t\t\t\tt.Fatal(\"step 3: update to fixing failed\")\n883\t\t\t}\n884\t\t\tif r.PreviousStatus != \"claimed\" {\n885\t\t\t\tt.Errorf(\"step 3: expected previous=claimed, got %s\", r.PreviousStatus)\n886\t\t\t}\n887\t\n888\t\t\t// 4. 验证最终状态\n889\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{20})\n890\t\t\tif s[20] != \"fixing\" {\n891\t\t\t\tt.Fatalf(\"step 4: expected fixing, got %s\", s[20])\n892\t\t\t}\n893\t\t})\n894\t\n895\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n896\t\t\tenv := setupTest(t)\n897\t\n898\t\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/status\")\n899\t\t\tif err != nil {\n900\t\t\t\tt.Fatal(err)\n901\t\t\t}\n902\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n903\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n904\t\t\t}\n905\t\t})\n906\t}\n907\t\n908\t// claimIssue calls the claim API and returns (statusCode, success, claimed_by).\n909\tfunc claimIssue(t *testing.T, env *testEnv, repo string, number int, sessionID string) (int, bool, string) {\n910\t\tt.Helper()\n911\t\n912\t\tbody := fmt.Sprintf(\n913\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n914\t\t\trepo, number, sessionID)\n915\t\tresp := env.post(t, \"/api/issue/claim\", body)\n916\t\n917\t\tvar result struct {\n918\t\t\tSuccess   bool    `json:\"success\"`\n919\t\t\tError     string  `json:\"error\"`\n920\t\t\tClaimedBy *string `json:\"claimed_by\"`\n921\t\t\tStatus    string  `json:\"status\"`\n922\t\t}\n923\t\treadJSON(t, resp, &result)\n924\t\n925\t\tclaimedBy := \"\"\n926\t\tif result.ClaimedBy != nil {\n927\t\t\tclaimedBy = *result.ClaimedBy\n928\t\t}\n929\t\treturn resp.StatusCode, result.Success, claimedBy\n930\t}\n931\t\n932\t// checkStatuses queries the check API and returns a map of issue_number → status.\n933\tfunc checkStatuses(t *testing.T, env *testEnv, repo string, numbers []int) map[int]string {\n934\t\tt.Helper()\n935\t\n936\t\tnums := make([]string, len(numbers))\n937\t\tfor i, n := range numbers {\n938\t\t\tnums[i] = fmt.Sprintf(\"%d\", n)\n939\t\t}\n940\t\n941\t\tbody := `{\"repo_full_name\":\"` + repo + `\",\"issue_numbers\":[` + strings.Join(nums, \",\") + `]}`\n942\t\tresp := env.post(t, \"/api/issue/check\", body)\n943\t\n944\t\tvar result struct {\n945\t\t\tIssues []struct {\n946\t\t\t\tNumber int    `json:\"number\"`\n947\t\t\t\tStatus string `json:\"status\"`\n948\t\t\t} `json:\"issues\"`\n949\t\t}\n950\t\treadJSON(t, resp, &result)\n951\t\n952\t\tm := map[int]string{}\n953\t\tfor _, iss := range result.Issues {\n954\t\t\tm[iss.Number] = iss.Status\n955\t\t}\n956\t\treturn m\n957\t}\n958\t\n959\t// --- D3: Issue Status Update → ready-for-pr tests ---\n960\t// 验收标准：\n961\t//   - fixing → ready-for-pr 状态更新成功\n962\t//   - 非 owner 无法更新\n963\t//   - 完整流程：claimed → fixing → ready-for-pr\n964\t\n965\tfunc TestUpdateStatus_ReadyForPR(t *testing.T) {\n966\t\tt.Run(\"fixing_to_ready_for_pr\", func(t *testing.T) {\n967\t\t\t// D3 验收：fixing 状态可更新为 ready-for-pr\n968\t\t\tenv := setupTest(t)\n969\t\t\tdb := env.store.DB()\n970\t\t\tseedIssue(db, \"test/repo\", 10, \"fixing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n971\t\n972\t\t\tresp := env.post(t, \"/api/issue/status\",\n973\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"ready-for-pr\"}`)\n974\t\n975\t\t\tvar result struct {\n976\t\t\t\tSuccess        bool   `json:\"success\"`\n977\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n978\t\t\t\tNewStatus      string `json:\"new_status\"`\n979\t\t\t}\n980\t\t\treadJSON(t, resp, &result)\n981\t\n982\t\t\tif resp.StatusCode != http.StatusOK {\n983\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n984\t\t\t}\n985\t\t\tif !result.Success {\n986\t\t\t\tt.Fatal(\"expected success=true\")\n987\t\t\t}\n988\t\t\tif result.PreviousStatus != \"fixing\" {\n989\t\t\t\tt.Errorf(\"expected previous=fixing, got %s\", result.PreviousStatus)\n990\t\t\t}\n991\t\t\tif result.NewStatus != \"ready-for-pr\" {\n992\t\t\t\tt.Errorf(\"expected new=ready-for-pr, got %s\", result.NewStatus)\n993\t\t\t}\n994\t\n995\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n996\t\t\tif statuses[10] != \"ready-for-pr\" {\n997\t\t\t\tt.Errorf(\"expected ready-for-pr, got %s\", statuses[10])\n998\t\t\t}\n999\t\t})\n1000\t\n1001\t\tt.Run(\"non_owner_cannot_mark_ready\", func(t *testing.T) {\n1002\t\t\tenv := setupTest(t)\n1003\t\t\tdb := env.store.DB()\n1004\t\t\tseedIssue(db, \"test/repo\", 10, \"fixing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1005\t\n1006\t\t\tresp := env.post(t, \"/api/issue/status\",\n1007\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"ready-for-pr\"}`)\n1008\t\n1009\t\t\tvar result struct {\n1010\t\t\t\tSuccess bool   `json:\"success\"`\n1011\t\t\t\tError   string `json:\"error\"`\n1012\t\t\t}\n1013\t\t\treadJSON(t, resp, &result)\n1014\t\n1015\t\t\tif result.Success {\n1016\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1017\t\t\t}\n1018\t\t\tif result.Error != \"not_owner\" {\n1019\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1020\t\t\t}\n1021\t\t})\n1022\t\n1023\t\tt.Run(\"full_claim_fix_done_flow\", func(t *testing.T) {\n1024\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr\n1025\t\t\tenv := setupTest(t)\n1026\t\n1027\t\t\t// 1. idle\n1028\t\t\tenv.post(t, \"/api/issue/check\",\n1029\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[30]}`)\n1030\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{30})\n1031\t\t\tif s[30] != \"idle\" {\n1032\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[30])\n1033\t\t\t}\n1034\t\n1035\t\t\t// 2. claim\n1036\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 30, \"sess_done\")\n1037\t\t\tif code != http.StatusOK || !ok {\n1038\t\t\t\tt.Fatalf(\"step 2: claim failed\")\n1039\t\t\t}\n1040\t\n1041\t\t\t// 3. fixing\n1042\t\t\tenv.post(t, \"/api/issue/status\",\n1043\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":30,\"session_id\":\"sess_done\",\"status\":\"fixing\"}`)\n1044\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{30})\n1045\t\t\tif s[30] != \"fixing\" {\n1046\t\t\t\tt.Fatalf(\"step 3: expected fixing, got %s\", s[30])\n1047\t\t\t}\n1048\t\n1049\t\t\t// 4. ready-for-pr\n1050\t\t\tresp := env.post(t, \"/api/issue/status\",\n1051\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":30,\"session_id\":\"sess_done\",\"status\":\"ready-for-pr\"}`)\n1052\t\t\tvar result struct {\n1053\t\t\t\tSuccess        bool   `json:\"success\"`\n1054\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1055\t\t\t\tNewStatus      string `json:\"new_status\"`\n1056\t\t\t}\n1057\t\t\treadJSON(t, resp, &result)\n1058\t\t\tif !result.Success {\n1059\t\t\t\tt.Fatal(\"step 4: ready-for-pr update failed\")\n1060\t\t\t}\n1061\t\t\tif result.PreviousStatus != \"fixing\" {\n1062\t\t\t\tt.Errorf(\"step 4: expected previous=fixing, got %s\", result.PreviousStatus)\n1063\t\t\t}\n1064\t\n1065\t\t\t// 5. 验证最终状态\n1066\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{30})\n1067\t\t\tif s[30] != \"ready-for-pr\" {\n1068\t\t\t\tt.Fatalf(\"step 5: expected ready-for-pr, got %s\", s[30])\n1069\t\t\t}\n1070\t\t})\n1071\t}\n1072\t\n1073\t// --- D4: Issue Status Update → pr-created tests ---\n1074\t// 验收标准：\n1075\t//   - ready-for-pr → pr-created 状态更新成功\n1076\t//   - 非 owner 无法更新\n1077\t//   - 完整流程：claimed → fixing → ready-for-pr → pr-created\n1078\t\n1079\tfunc TestUpdateStatus_PRCreated(t *testing.T) {\n1080\t\tt.Run(\"ready_for_pr_to_pr_created\", func(t *testing.T) {\n1081\t\t\t// D4 验收：ready-for-pr 状态可更新为 pr-created\n1082\t\t\tenv := setupTest(t)\n1083\t\t\tdb := env.store.DB()\n1084\t\t\tseedIssue(db, \"test/repo\", 10, \"ready-for-pr\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1085\t\n1086\t\t\tresp := env.post(t, \"/api/issue/status\",\n1087\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"pr-created\"}`)\n1088\t\n1089\t\t\tvar result struct {\n1090\t\t\t\tSuccess        bool   `json:\"success\"`\n1091\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1092\t\t\t\tNewStatus      string `json:\"new_status\"`\n1093\t\t\t}\n1094\t\t\treadJSON(t, resp, &result)\n1095\t\n1096\t\t\tif resp.StatusCode != http.StatusOK {\n1097\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n1098\t\t\t}\n1099\t\t\tif !result.Success {\n1100\t\t\t\tt.Fatal(\"expected success=true\")\n1101\t\t\t}\n1102\t\t\tif result.PreviousStatus != \"ready-for-pr\" {\n1103\t\t\t\tt.Errorf(\"expected previous=ready-for-pr, got %s\", result.PreviousStatus)\n1104\t\t\t}\n1105\t\t\tif result.NewStatus != \"pr-created\" {\n1106\t\t\t\tt.Errorf(\"expected new=pr-created, got %s\", result.NewStatus)\n1107\t\t\t}\n1108\t\n1109\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n1110\t\t\tif statuses[10] != \"pr-created\" {\n1111\t\t\t\tt.Errorf(\"expected pr-created, got %s\", statuses[10])\n1112\t\t\t}\n1113\t\t})\n1114\t\n1115\t\tt.Run(\"non_owner_cannot_create_pr_status\", func(t *testing.T) {\n1116\t\t\tenv := setupTest(t)\n1117\t\t\tdb := env.store.DB()\n1118\t\t\tseedIssue(db, \"test/repo\", 10, \"ready-for-pr\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1119\t\n1120\t\t\tresp := env.post(t, \"/api/issue/status\",\n1121\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"pr-created\"}`)\n1122\t\n1123\t\t\tvar result struct {\n1124\t\t\t\tSuccess bool   `json:\"success\"`\n1125\t\t\t\tError   string `json:\"error\"`\n1126\t\t\t}\n1127\t\t\treadJSON(t, resp, &result)\n1128\t\n1129\t\t\tif result.Success {\n1130\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1131\t\t\t}\n1132\t\t\tif result.Error != \"not_owner\" {\n1133\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1134\t\t\t}\n1135\t\t})\n1136\t\n1137\t\tt.Run(\"full_claim_fix_done_pr_flow\", func(t *testing.T) {\n1138\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr → pr-created\n1139\t\t\tenv := setupTest(t)\n1140\t\n1141\t\t\t// 1. idle\n1142\t\t\tenv.post(t, \"/api/issue/check\",\n1143\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[40]}`)\n1144\t\n1145\t\t\t// 2. claim\n1146\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 40, \"sess_pr\")\n1147\t\t\tif code != http.StatusOK || !ok {\n1148\t\t\t\tt.Fatalf(\"step 2: claim failed\")\n1149\t\t\t}\n1150\t\n1151\t\t\t// 3. fixing\n1152\t\t\tenv.post(t, \"/api/issue/status\",\n1153\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":40,\"session_id\":\"sess_pr\",\"status\":\"fixing\"}`)\n1154\t\n1155\t\t\t// 4. ready-for-pr\n1156\t\t\tenv.post(t, \"/api/issue/status\",\n1157\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":40,\"session_id\":\"sess_pr\",\"status\":\"ready-for-pr\"}`)\n1158\t\n1159\t\t\t// 5. pr-created\n1160\t\t\tresp := env.post(t, \"/api/issue/status\",\n1161\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":40,\"session_id\":\"sess_pr\",\"status\":\"pr-created\"}`)\n1162\t\t\tvar result struct {\n1163\t\t\t\tSuccess        bool   `json:\"success\"`\n1164\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1165\t\t\t\tNewStatus      string `json:\"new_status\"`\n1166\t\t\t}\n1167\t\t\treadJSON(t, resp, &result)\n1168\t\t\tif !result.Success {\n1169\t\t\t\tt.Fatal(\"step 5: pr-created update failed\")\n1170\t\t\t}\n1171\t\t\tif result.PreviousStatus != \"ready-for-pr\" {\n1172\t\t\t\tt.Errorf(\"step 5: expected previous=ready-for-pr, got %s\", result.PreviousStatus)\n1173\t\t\t}\n1174\t\n1175\t\t\t// 6. 验证最终状态\n1176\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{40})\n1177\t\t\tif s[40] != \"pr-created\" {\n1178\t\t\t\tt.Fatalf(\"step 6: expected pr-created, got %s\", s[40])\n1179\t\t\t}\n1180\t\t})\n1181\t}\n1182\t\n1183\t// --- D5: Issue Status Update → testing tests ---\n1184\t// 验收标准：\n1185\t//   - pr-created → testing 状态更新成功\n1186\t//   - 非 owner 无法更新\n1187\t//   - 完整流程：claimed → fixing → ready-for-pr → pr-created → testing\n1188\t\n1189\tfunc TestUpdateStatus_Testing(t *testing.T) {\n1190\t\tt.Run(\"pr_created_to_testing\", func(t *testing.T) {\n1191\t\t\tenv := setupTest(t)\n1192\t\t\tdb := env.store.DB()\n1193\t\t\tseedIssue(db, \"test/repo\", 10, \"pr-created\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1194\t\n1195\t\t\tresp := env.post(t, \"/api/issue/status\",\n1196\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"testing\"}`)\n1197\t\n1198\t\t\tvar result struct {\n1199\t\t\t\tSuccess        bool   `json:\"success\"`\n1200\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1201\t\t\t\tNewStatus      string `json:\"new_status\"`\n1202\t\t\t}\n1203\t\t\treadJSON(t, resp, &result)\n1204\t\n1205\t\t\tif resp.StatusCode != http.StatusOK {\n1206\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n1207\t\t\t}\n1208\t\t\tif !result.Success {\n1209\t\t\t\tt.Fatal(\"expected success=true\")\n1210\t\t\t}\n1211\t\t\tif result.PreviousStatus != \"pr-created\" {\n1212\t\t\t\tt.Errorf(\"expected previous=pr-created, got %s\", result.PreviousStatus)\n1213\t\t\t}\n1214\t\t\tif result.NewStatus != \"testing\" {\n1215\t\t\t\tt.Errorf(\"expected new=testing, got %s\", result.NewStatus)\n1216\t\t\t}\n1217\t\n1218\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n1219\t\t\tif statuses[10] != \"testing\" {\n1220\t\t\t\tt.Errorf(\"expected testing, got %s\", statuses[10])\n1221\t\t\t}\n1222\t\t})\n1223\t\n1224\t\tt.Run(\"non_owner_cannot_mark_testing\", func(t *testing.T) {\n1225\t\t\tenv := setupTest(t)\n1226\t\t\tdb := env.store.DB()\n1227\t\t\tseedIssue(db, \"test/repo\", 10, \"pr-created\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1228\t\n1229\t\t\tresp := env.post(t, \"/api/issue/status\",\n1230\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"testing\"}`)\n1231\t\n1232\t\t\tvar result struct {\n1233\t\t\t\tSuccess bool   `json:\"success\"`\n1234\t\t\t\tError   string `json:\"error\"`\n1235\t\t\t}\n1236\t\t\treadJSON(t, resp, &result)\n1237\t\n1238\t\t\tif result.Success {\n1239\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1240\t\t\t}\n1241\t\t\tif result.Error != \"not_owner\" {\n1242\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1243\t\t\t}\n1244\t\t})\n1245\t\n1246\t\tt.Run(\"full_flow_to_testing\", func(t *testing.T) {\n1247\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr → pr-created → testing\n1248\t\t\tenv := setupTest(t)\n1249\t\n1250\t\t\tenv.post(t, \"/api/issue/check\",\n1251\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[50]}`)\n1252\t\n1253\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 50, \"sess_test\")\n1254\t\t\tif code != http.StatusOK || !ok {\n1255\t\t\t\tt.Fatalf(\"claim failed\")\n1256\t\t\t}\n1257\t\n1258\t\t\tenv.post(t, \"/api/issue/status\",\n1259\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"fixing\"}`)\n1260\t\t\tenv.post(t, \"/api/issue/status\",\n1261\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"ready-for-pr\"}`)\n1262\t\t\tenv.post(t, \"/api/issue/status\",\n1263\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"pr-created\"}`)\n1264\t\n1265\t\t\tresp := env.post(t, \"/api/issue/status\",\n1266\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"testing\"}`)\n1267\t\t\tvar result struct {\n1268\t\t\t\tSuccess        bool   `json:\"success\"`\n1269\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1270\t\t\t\tNewStatus      string `json:\"new_status\"`\n1271\t\t\t}\n1272\t\t\treadJSON(t, resp, &result)\n1273\t\t\tif !result.Success {\n1274\t\t\t\tt.Fatal(\"testing update failed\")\n1275\t\t\t}\n1276\t\t\tif result.PreviousStatus != \"pr-created\" {\n1277\t\t\t\tt.Errorf(\"expected previous=pr-created, got %s\", result.PreviousStatus)\n1278\t\t\t}\n1279\t\n1280\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{50})\n1281\t\t\tif s[50] != \"testing\" {\n1282\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[50])\n1283\t\t\t}\n1284\t\t})\n1285\t}\n1286\t\n1287\t// --- D6: Issue Status Update → reviewing/merged/rejected tests ---\n1288\t// 验收标准：\n1289\t//   - testing → reviewing 状态更新成功\n1290\t//   - reviewing → merged 终态更新成功\n1291\t//   - reviewing → rejected 状态更新成功\n1292\t//   - merged 不被 session end 释放\n1293\t//   - rejected 不被 session end 释放\n1294\t//   - 完整流程：idle → ... → testing → reviewing → merged/rejected\n1295\t\n1296\tfunc TestUpdateStatus_Review(t *testing.T) {\n1297\t\tt.Run(\"testing_to_reviewing\", func(t *testing.T) {\n1298\t\t\tenv := setupTest(t)\n1299\t\t\tdb := env.store.DB()\n1300\t\t\tseedIssue(db, \"test/repo\", 10, \"testing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1301\t\n1302\t\t\tresp := env.post(t, \"/api/issue/status\",\n1303\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"reviewing\"}`)\n1304\t\n1305\t\t\tvar result struct {\n1306\t\t\t\tSuccess        bool   `json:\"success\"`\n1307\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1308\t\t\t\tNewStatus      string `json:\"new_status\"`\n1309\t\t\t}\n1310\t\t\treadJSON(t, resp, &result)\n1311\t\n1312\t\t\tif !result.Success {\n1313\t\t\t\tt.Fatalf(\"expected success=true, got error: %s\", result.NewStatus)\n1314\t\t\t}\n1315\t\t\tif result.PreviousStatus != \"testing\" {\n1316\t\t\t\tt.Errorf(\"expected previous=testing, got %s\", result.PreviousStatus)\n1317\t\t\t}\n1318\t\t\tif result.NewStatus != \"reviewing\" {\n1319\t\t\t\tt.Errorf(\"expected new=reviewing, got %s\", result.NewStatus)\n1320\t\t\t}\n1321\t\t})\n1322\t\n1323\t\tt.Run(\"reviewing_to_merged\", func(t *testing.T) {\n1324\t\t\tenv := setupTest(t)\n1325\t\t\tdb := env.store.DB()\n1326\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1327\t\n1328\t\t\tresp := env.post(t, \"/api/issue/status\",\n1329\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"merged\"}`)\n1330\t\n1331\t\t\tvar result struct {\n1332\t\t\t\tSuccess        bool   `json:\"success\"`\n1333\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1334\t\t\t\tNewStatus      string `json:\"new_status\"`\n1335\t\t\t}\n1336\t\t\treadJSON(t, resp, &result)\n1337\t\n1338\t\t\tif !result.Success {\n1339\t\t\t\tt.Fatal(\"expected success=true\")\n1340\t\t\t}\n1341\t\t\tif result.PreviousStatus != \"reviewing\" {\n1342\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1343\t\t\t}\n1344\t\t\tif result.NewStatus != \"merged\" {\n1345\t\t\t\tt.Errorf(\"expected new=merged, got %s\", result.NewStatus)\n1346\t\t\t}\n1347\t\t})\n1348\t\n1349\t\tt.Run(\"reviewing_to_rejected\", func(t *testing.T) {\n1350\t\t\tenv := setupTest(t)\n1351\t\t\tdb := env.store.DB()\n1352\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1353\t\n1354\t\t\tresp := env.post(t, \"/api/issue/status\",\n1355\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"rejected\"}`)\n1356\t\n1357\t\t\tvar result struct {\n1358\t\t\t\tSuccess        bool   `json:\"success\"`\n1359\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1360\t\t\t\tNewStatus      s