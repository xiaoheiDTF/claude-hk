\n48\t  fi\n49\t  if curl -s --max-time 2 \"$BACKEND_URL/health\" > /dev/null 2>&1; then\n50\t    return 0\n51\t  fi\n52\t  [ -n \"${SKILL_TAG:-}\" ] && skill_log \"ERROR\" \"Backend configured but unreachable at $BACKEND_URL\"\n53\t  return 1\n54\t}\n55\t\n56\t# 调用后端 API，失败时静默返回空\n57\t_call_backend() {\n58\t  local endpoint=\"$1\"\n59\t  local data=\"$2\"\n60\t  _load_backend_url\n61\t  [ -z \"$BACKEND_URL\" ] && return 1\n62\t\n63\t  local resp\n64\t  resp=$(curl -s --max-time 5 -X POST \"$BACKEND_URL$endpoint\" \\\n65\t    -H \"Content-Type: application/json\" \\\n66\t    -d \"$data\" 2>/dev/null)\n67\t  local rc=$?\n68\t  if [ $rc -ne 0 ] || [ -z \"$resp\" ]; then\n69\t    [ -n \"${SKILL_TAG:-}\" ] && skill_log \"DEBUG\" \"Backend call failed: $endpoint (curl rc=$rc)\"\n70\t    return 1\n71\t  fi\n72\t  echo \"$resp\"\n73\t}\n74\t\n75\t# 获取当前 session_id\n76\t_get_session_id() {\n77\t  if [ -n \"${CLAUDE_SESSION_ID:-}\" ]; then\n78\t    echo \"$CLAUDE_SESSION_ID\"\n79\t    return\n80\t  fi\n81\t  if command -v json_get >/dev/null 2>&1; then\n82\t    json_get '.session_id' 2>/dev/null\n83\t  fi\n84\t}\n85\t\n86\t# 通用状态更新函数（D2-D6 使用）— 静默降级\n87\tupdate_issue_status() {\n88\t  local issue_num=\"$1\"\n89\t  local new_status=\"$2\"\n90\t\n91\t  _load_backend_url\n92\t  [ -z \"$BACKEND_URL\" ] && return 0\n93\t\n94\t  local session_id\n95\t  session_id=$(_get_session_id)\n96\t  [ -z \"$session_id\" ] && return 0\n97\t\n98\t  local repo\n99\t  repo=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null)\n100\t  [ -z \"$repo\" ] && return 0\n101\t\n102\t  _call_backend \"/api/issue/status\" \"{\n103\t    \\\"repo_full_name\\\":\\\"$repo\\\",\n104\t    \\\"issue_number\\\":$issue_num,\n105\t    \\\"session_id\\\":\\\"$session_id\\\",\n106\t    \\\"status\\\":\\\"$new_status\\\"\n107\t  }\" > /dev/null 2>&1\n108\t}\n109\t"}]}
