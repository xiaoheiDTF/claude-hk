atusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n21\t\t\treturn\n22\t\t}\n23\t\n24\t\tvar req CheckIssuesRequest\n25\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n26\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n27\t\t\treturn\n28\t\t}\n29\t\n30\t\tif req.RepoFullName == \"\" {\n31\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name is required\")\n32\t\t\treturn\n33\t\t}\n34\t\tif req.IssueNumbers == nil {\n35\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"issue_numbers is required\")\n36\t\t\treturn\n37\t\t}\n38\t\n39\t\tresults, err := h.svc.Check(r.Context(), req.RepoFullName, req.IssueNumbers)\n40\t\tif err != nil {\n41\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to check issues\")\n42\t\t\treturn\n43\t\t}\n44\t\n45\t\titems := make([]IssueStatusItem, len(results))\n46\t\tfor i, r := range results {\n47\t\t\titems[i] = IssueStatusItem{\n48\t\t\t\tNumber:    r.Number,\n49\t\t\t\tStatus:    r.Status,\n50\t\t\t\tSessionID: r.SessionID,\n51\t\t\t\tClaimedAt: r.ClaimedAt,\n52\t\t\t}\n53\t\t}\n54\t\n55\t\tif items == nil {\n56\t\t\titems = []IssueStatusItem{}\n57\t\t}\n58\t\n59\t\twriteJSON(w, http.StatusOK, CheckIssuesResponse{Issues: items})\n60\t}\n61\t\n62\tfunc (h *IssueHandler) ClaimIssue(w http.ResponseWriter, r *http.Request) {\n63\t\tif r.Method != http.MethodPost {\n64\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n65\t\t\treturn\n66\t\t}\n67\t\n68\t\tvar req ClaimIssueRequest\n69\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n70\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n71\t\t\treturn\n72\t\t}\n73\t\n74\t\tif req.RepoFullName == \"\" || req.IssueNumber == 0 || req.SessionID == \"\" {\n75\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name, issue_number and session_id are required\")\n76\t\t\treturn\n77\t\t}\n78\t\n79\t\tresult, err := h.svc.Claim(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID, req.IssueTitle)\n80\t\tif err != nil {\n81\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to claim issue\")\n82\t\t\treturn\n83\t\t}\n84\t\n85\t\tif result.Success {\n86\t\t\twriteJSON(w, http.StatusOK, ClaimIssueResponse{\n87\t\t\t\tSuccess:   true,\n88\t\t\t\tStatus:    result.Status,\n89\t\t\t\tClaimedAt: result.ClaimedAt,\n90\t\t\t})\n91\t\t\treturn\n92\t\t}\n93\t\n94\t\twriteJSON(w, http.StatusConflict, ClaimIssueResponse{\n95\t\t\tSuccess:   false,\n96\t\t\tError:     \"already_claimed\",\n97\t\t\tClaimedBy: result.ClaimedBy,\n98\t\t\tClaimedAt: result.ClaimedAt,\n99\t\t})\n100\t}\n101\t\n102\tfunc (h *IssueHandler) ReleaseIssue(w http.ResponseWriter, r *http.Request) {\n103\t\tif r.Method != http.MethodPost {\n104\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n105\t\t\treturn\n106\t\t}\n107\t\n108\t\tvar req ReleaseIssueRequest\n109\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n110\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n111\t\t\treturn\n112\t\t}\n113\t\n114\t\tif req.RepoFullName == \"\" || req.IssueNumber == 0 || req.SessionID == \"\" {\n115\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name, issue_number and session_id are required\")\n116\t\t\treturn\n117\t\t}\n118\t\n119\t\treleased, err := h.svc.Release(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID)\n120\t\tif err != nil {\n121\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to release issue\")\n122\t\t\treturn\n123\t\t}\n124\t\n125\t\tif !released {\n126\t\t\twriteJSON(w, http.StatusOK, ReleaseIssueResponse{Success: false, Error: \"not_owner\"})\n127\t\t\treturn\n128\t\t}\n129\t\n130\t\twriteJSON(w, http.StatusOK, ReleaseIssueResponse{Success: true, Released: boolPtr(true)})\n131\t}\n132\t\n133\tfunc (h *IssueHandler) ReleaseSession(w http.ResponseWriter, r *http.Request) {\n134\t\tif r.Method != http.MethodPost {\n135\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n136\t\t\treturn\n137\t\t}\n138\t\n139\t\tvar req ReleaseSessionRequest\n140\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n141\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n142\t\t\treturn\n143\t\t}\n144\t\n145\t\tif req.SessionID == \"\" {\n146\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"session_id is required\")\n147\t\t\treturn\n148\t\t}\n149\t\n150\t\tnumbers, err := h.svc.ReleaseSession(r.Context(), req.SessionID)\n151\t\tif err != nil {\n152\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to release session issues\")\n153\t\t\treturn\n154\t\t}\n155\t\n156\t\tif numbers == nil {\n157\t\t\tnumbers = []int{}\n158\t\t}\n159\t\n160\t\twriteJSON(w, http.StatusOK, ReleaseSessionResponse{Released: numbers, Count: len(numbers)})\n161\t}\n162\t\n163\tfunc (h *IssueHandler) UpdateStatus(w http.ResponseWriter, r *http.Request) {\n164\t\tif r.Method != http.MethodPost {\n165\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n166\t\t\treturn\n167\t\t}\n168\t\n169\t\tvar req UpdateStatusRequest\n170\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n171\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n172\t\t\treturn\n173\t\t}\n174\t\n175\t\tif req.RepoFullName == \"\" || req.IssueNumber == 0 || req.SessionID == \"\" || req.Status == \"\" {\n176\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name, issue_number, session_id and status are required\")\n177\t\t\treturn\n178\t\t}\n179\t\n180\t\tresult, err := h.svc.UpdateStatus(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID, req.Status)\n181\t\tif err != nil {\n182\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to update status\")\n183\t\t\treturn\n184\t\t}\n185\t\n186\t\tif !result.Updated {\n187\t\t\tstatus := http.StatusOK\n188\t\t\terrMsg := \"\"\n189\t\t\tif result.PreviousStatus == \"\" {\n190\t\t\t\terrMsg = \"not_found\"\n191\t\t\t} else {\n192\t\t\t\terrMsg = \"not_owner\"\n193\t\t\t}\n194\t\t\twriteJSON(w, status, UpdateStatusResponse{\n195\t\t\t\tSuccess:        false,\n196\t\t\t\tPreviousStatus: result.PreviousStatus,\n197\t\t\t\tError:          errMsg,\n198\t\t\t})\n199\t\t\treturn\n200\t\t}\n201\t\n202\t\twriteJSON(w, http.StatusOK, UpdateStatusResponse{\n203\t\t\tSuccess:        true,\n204\t\t\tPreviousStatus: result.PreviousStatus,\n205\t\t\tNewStatus:      result.NewStatus,\n206\t\t})\n207\t}\n208\t\n209\tfunc boolPtr(b bool) *bool { return &b }\n210\t"}]}
