ing\"}`)\n1267\t\t\tvar result struct {\n1268\t\t\t\tSuccess        bool   `json:\"success\"`\n1269\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1270\t\t\t\tNewStatus      string `json:\"new_status\"`\n1271\t\t\t}\n1272\t\t\treadJSON(t, resp, &result)\n1273\t\t\tif !result.Success {\n1274\t\t\t\tt.Fatal(\"testing update failed\")\n1275\t\t\t}\n1276\t\t\tif result.PreviousStatus != \"pr-created\" {\n1277\t\t\t\tt.Errorf(\"expected previous=pr-created, got %s\", result.PreviousStatus)\n1278\t\t\t}\n1279\t\n1280\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{50})\n1281\t\t\tif s[50] != \"testing\" {\n1282\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[50])\n1283\t\t\t}\n1284\t\t})\n1285\t}\n1286\t\n1287\t// --- D6: Issue Status Update → reviewing/merged/rejected tests ---\n1288\t// 验收标准：\n1289\t//   - testing → reviewing 状态更新成功\n1290\t//   - reviewing → merged 终态更新成功\n1291\t//   - reviewing → rejected 状态更新成功\n1292\t//   - merged 不被 session end 释放\n1293\t//   - rejected 不被 session end 释放\n1294\t//   - 完整流程：idle → ... → testing → reviewing → merged/rejected\n1295\t\n1296\tfunc TestUpdateStatus_Review(t *testing.T) {\n1297\t\tt.Run(\"testing_to_reviewing\", func(t *testing.T) {\n1298\t\t\tenv := setupTest(t)\n1299\t\t\tdb := env.store.DB()\n1300\t\t\tseedIssue(db, \"test/repo\", 10, \"testing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1301\t\n1302\t\t\tresp := env.post(t, \"/api/issue/status\",\n1303\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"reviewing\"}`)\n1304\t\n1305\t\t\tvar result struct {\n1306\t\t\t\tSuccess        bool   `json:\"success\"`\n1307\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1308\t\t\t\tNewStatus      string `json:\"new_status\"`\n1309\t\t\t}\n1310\t\t\treadJSON(t, resp, &result)\n1311\t\n1312\t\t\tif !result.Success {\n1313\t\t\t\tt.Fatalf(\"expected success=true, got error: %s\", result.NewStatus)\n1314\t\t\t}\n1315\t\t\tif result.PreviousStatus != \"testing\" {\n1316\t\t\t\tt.Errorf(\"expected previous=testing, got %s\", result.PreviousStatus)\n1317\t\t\t}\n1318\t\t\tif result.NewStatus != \"reviewing\" {\n1319\t\t\t\tt.Errorf(\"expected new=reviewing, got %s\", result.NewStatus)\n1320\t\t\t}\n1321\t\t})\n1322\t\n1323\t\tt.Run(\"reviewing_to_merged\", func(t *testing.T) {\n1324\t\t\tenv := setupTest(t)\n1325\t\t\tdb := env.store.DB()\n1326\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1327\t\n1328\t\t\tresp := env.post(t, \"/api/issue/status\",\n1329\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"merged\"}`)\n1330\t\n1331\t\t\tvar result struct {\n1332\t\t\t\tSuccess        bool   `json:\"success\"`\n1333\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1334\t\t\t\tNewStatus      string `json:\"new_status\"`\n1335\t\t\t}\n1336\t\t\treadJSON(t, resp, &result)\n1337\t\n1338\t\t\tif !result.Success {\n1339\t\t\t\tt.Fatal(\"expected success=true\")\n1340\t\t\t}\n1341\t\t\tif result.PreviousStatus != \"reviewing\" {\n1342\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1343\t\t\t}\n1344\t\t\tif result.NewStatus != \"merged\" {\n1345\t\t\t\tt.Errorf(\"expected new=merged, got %s\", result.NewStatus)\n1346\t\t\t}\n1347\t\t})\n1348\t\n1349\t\tt.Run(\"reviewing_to_rejected\", func(t *testing.T) {\n1350\t\t\tenv := setupTest(t)\n1351\t\t\tdb := env.store.DB()\n1352\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1353\t\n1354\t\t\tresp := env.post(t, \"/api/issue/status\",\n1355\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"rejected\"}`)\n1356\t\n1357\t\t\tvar result struct {\n1358\t\t\t\tSuccess        bool   `json:\"success\"`\n1359\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1360\t\t\t\tNewStatus      string `json:\"new_status\"`\n1361\t\t\t}\n1362\t\t\treadJSON(t, resp, &result)\n1363\t\n1364\t\t\tif !result.Success {\n1365\t\t\t\tt.Fatal(\"expected success=true\")\n1366\t\t\t}\n1367\t\t\tif result.PreviousStatus != \"reviewing\" {\n1368\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1369\t\t\t}\n1370\t\t\tif result.NewStatus != \"rejected\" {\n1371\t\t\t\tt.Errorf(\"expected new=rejected, got %s\", result.NewStatus)\n1372\t\t\t}\n1373\t\t})\n1374\t\n1375\t\tt.Run(\"non_owner_cannot_review\", func(t *testing.T) {\n1376\t\t\tenv := setupTest(t)\n1377\t\t\tdb := env.store.DB()\n1378\t\t\tseedIssue(db, \"test/repo\", 10, \"testing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1379\t\n1380\t\t\tresp := env.post(t, \"/api/issue/status\",\n1381\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"reviewing\"}`)\n1382\t\n1383\t\t\tvar result struct {\n1384\t\t\t\tSuccess bool   `json:\"success\"`\n1385\t\t\t\tError   string `json:\"error\"`\n1386\t\t\t}\n1387\t\t\treadJSON(t, resp, &result)\n1388\t\n1389\t\t\tif result.Success {\n1390\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1391\t\t\t}\n1392\t\t\tif result.Error != \"not_owner\" {\n1393\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1394\t\t\t}\n1395\t\t})\n1396\t\n1397\t\tt.Run(\"full_merge_flow\", func(t *testing.T) {\n1398\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr → pr-created → testing → reviewing → merged\n1399\t\t\tenv := setupTest(t)\n1400\t\n1401\t\t\tenv.post(t, \"/api/issue/check\",\n1402\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[60]}`)\n1403\t\n1404\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 60, \"sess_merge\")\n1405\t\t\tif code != http.StatusOK || !ok {\n1406\t\t\t\tt.Fatalf(\"claim failed\")\n1407\t\t\t}\n1408\t\n1409\t\t\tfor _, status := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n1410\t\t\t\tresp := env.post(t, \"/api/issue/status\",\n1411\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"test/repo\",\"issue_number\":60,\"session_id\":\"sess_merge\",\"status\":\"%s\"}`, status))\n1412\t\t\t\tvar r struct{ Success bool `json:\"success\"` }\n1413\t\t\t\treadJSON(t, resp, &r)\n1414\t\t\t\tif !r.Success {\n1415\t\t\t\t\tt.Fatalf(\"update to %s failed\", status)\n1416\t\t\t\t}\n1417\t\t\t}\n1418\t\n1419\t\t\t// merged\n1420\t\t\tresp := env.post(t, \"/api/issue/status\",\n1421\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":60,\"session_id\":\"sess_merge\",\"status\":\"merged\"}`)\n1422\t\t\tvar result struct {\n1423\t\t\t\tSuccess        bool   `json:\"success\"`\n1424\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1425\t\t\t\tNewStatus      string `json:\"new_status\"`\n1426\t\t\t}\n1427\t\t\treadJSON(t, resp, &result)\n1428\t\t\tif !result.Success {\n1429\t\t\t\tt.Fatal(\"merged update failed\")\n1430\t\t\t}\n1431\t\t\tif result.PreviousStatus != \"reviewing\" {\n1432\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1433\t\t\t}\n1434\t\n1435\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{60})\n1436\t\t\tif s[60] != \"merged\" {\n1437\t\t\t\tt.Fatalf(\"expected merged, got %s\", s[60])\n1438\t\t\t}\n1439\t\t})\n1440\t\n1441\t\tt.Run(\"full_reject_flow\", func(t *testing.T) {\n1442\t\t\t// 端到端：idle → ... → testing → reviewing → rejected\n1443\t\t\tenv := setupTest(t)\n1444\t\n1445\t\t\tenv.post(t, \"/api/issue/check\",\n1446\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[70]}`)\n1447\t\n1448\t\t\tclaimIssue(t, env, \"test/repo\", 70, \"sess_reject\")\n1449\t\t\tfor _, status := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n1450\t\t\t\tenv.post(t, \"/api/issue/status\",\n1451\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"test/repo\",\"issue_number\":70,\"session_id\":\"sess_reject\",\"status\":\"%s\"}`, status))\n1452\t\t\t}\n1453\t\n1454\t\t\tresp := env.post(t, \"/api/issue/status\",\n1455\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":70,\"session_id\":\"sess_reject\",\"status\":\"rejected\"}`)\n1456\t\t\tvar result struct {\n1457\t\t\t\tSuccess        bool   `json:\"success\"`\n1458\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1459\t\t\t\tNewStatus      string `json:\"new_status\"`\n1460\t\t\t}\n1461\t\t\treadJSON(t, resp, &result)\n1462\t\t\tif !result.Success {\n1463\t\t\t\tt.Fatal(\"rejected update failed\")\n1464\t\t\t}\n1465\t\t\tif result.PreviousStatus != \"reviewing\" {\n1466\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1467\t\t\t}\n1468\t\n1469\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{70})\n1470\t\t\tif s[70] != \"rejected\" {\n1471\t\t\t\tt.Fatalf(\"expected rejected, got %s\", s[70])\n1472\t\t\t}\n1473\t\t})\n1474\t}\n1475\t"},{"tool_name":"Read","tool_input":{"file_path":"claude_tap_plus/tests/integration/backend_skill_flow_test.go"},"tool_use_id":"call_98a9d815fb3744c4a7a2c02a","tool_response":"1\tpackage integration_test\n2\t\n3\timport (\n4\t\t\"database/sql\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"net/http\"\n9\t\t\"net/http/httptest\"\n10\t\t\"os\"\n11\t\t\"strings\"\n12\t\t\"testing\"\n13\t\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n17\t)\n18\t\n19\t// --- helpers ---\n20\t\n21\ttype env struct {\n22\t\tsrv   *httptest.Server\n23\t\tstore *store.SQLiteStore\n24\t}\n25\t\n26\tfunc setup(t *testing.T) *env {\n27\t\tt.Helper()\n28\t\n29\t\tf, err := os.CreateTemp(\"\", \"test-sessionend-*.db\")\n30\t\tif err != nil {\n31\t\t\tt.Fatal(err)\n32\t\t}\n33\t\tdbPath := f.Name()\n34\t\tf.Close()\n35\t\n36\t\ts, err := store.NewSQLiteStore(dbPath)\n37\t\tif err != nil {\n38\t\t\tos.Remove(dbPath)\n39\t\t\tt.Fatal(err)\n40\t\t}\n41\t\tt.Cleanup(func() {\n42\t\t\ts.Close()\n43\t\t\tos.Remove(dbPath)\n44\t\t})\n45\t\n46\t\tissueSvc := service.NewIssueService(s.Issues())\n47\t\trouter := api.NewRouter(api.Handlers{\n48\t\t\tIssue: api.NewIssueHandler(issueSvc),\n49\t\t})\n50\t\n51\t\tsrv := httptest.NewServer(router)\n52\t\tt.Cleanup(srv.Close)\n53\t\n54\t\treturn &env{srv: srv, store: s}\n55\t}\n56\t\n57\tfunc (e *env) post(t *testing.T, path, body string) *http.Response {\n58\t\tt.Helper()\n59\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n60\t\tif err != nil {\n61\t\t\tt.Fatal(err)\n62\t\t}\n63\t\treturn resp\n64\t}\n65\t\n66\tfunc readJSON(t *testing.T, resp *http.Response, v any) {\n67\t\tt.Helper()\n68\t\tdefer resp.Body.Close()\n69\t\tb, err := io.ReadAll(resp.Body)\n70\t\tif err != nil {\n71\t\t\tt.Fatal(err)\n72\t\t}\n73\t\tif err := json.Unmarshal(b, v); err != nil {\n74\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n75\t\t}\n76\t}\n77\t\n78\tfunc seedIssue(db *sql.DB, repo string, number int, status, sessionID, claimedAt string) {\n79\t\tdb.Exec(\n80\t\t\t`INSERT INTO issue_claims (repo_full_name, issue_number, status, session_id, claimed_at, updated_at)\n81\t\t\t VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)`,\n82\t\t\trepo, number, status,\n83\t\t\tnilIfEmpty(sessionID), nilIfEmpty(claimedAt),\n84\t\t)\n85\t}\n86\t\n87\t// claimIssue calls the claim API and returns (statusCode, success, claimed_by).\n88\tfunc claimIssue(t *testing.T, e *env, repo string, number int, sessionID string) (int, bool, string) {\n89\t\tt.Helper()\n90\t\n91\t\tbody := fmt.Sprintf(\n92\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n93\t\t\trepo, number, sessionID)\n94\t\tresp := e.post(t, \"/api/issue/claim\", body)\n95\t\n96\t\tvar result struct {\n97\t\t\tSuccess   bool    `json:\"success\"`\n98\t\t\tError     string  `json:\"error\"`\n99\t\t\tClaimedBy *string `json:\"claimed_by\"`\n100\t\t\tStatus    string  `json:\"status\"`\n101\t\t}\n102\t\treadJSON(t, resp, &result)\n103\t\n104\t\tclaimedBy := \"\"\n105\t\tif result.ClaimedBy != nil {\n106\t\t\tclaimedBy = *result.ClaimedBy\n107\t\t}\n108\t\treturn resp.StatusCode, result.Success, claimedBy\n109\t}\n110\t\n111\tfunc nilIfEmpty(s string) any {\n112\t\tif s == \"\" {\n113\t\t\treturn nil\n114\t\t}\n115\t\treturn s\n116\t}\n117\t\n118\t// checkStatuses queries the check API and returns a map of issue_number → status.\n119\tfunc checkStatuses(t *testing.T, e *env, repo string, numbers []int) map[int]string {\n120\t\tt.Helper()\n121\t\n122\t\tnums := make([]string, len(numbers))\n123\t\tfor i, n := range numbers {\n124\t\t\tnums[i] = fmt.Sprintf(\"%d\", n)\n125\t\t}\n126\t\n127\t\tbody := `{\"repo_full_name\":\"` + repo + `\",\"issue_numbers\":[` + strings.Join(nums, \",\") + `]}`\n128\t\tresp := e.post(t, \"/api/issue/check\", body)\n129\t\n130\t\tvar result struct {\n131\t\t\tIssues []struct {\n132\t\t\t\tNumber int    `json:\"number\"`\n133\t\t\t\tStatus string `json:\"status\"`\n134\t\t\t} `json:\"issues\"`\n135\t\t}\n136\t\treadJSON(t, resp, &result)\n137\t\n138\t\tm := map[int]string{}\n139\t\tfor _, iss := range result.Issues {\n140\t\t\tm[iss.Number] = iss.Status\n141\t\t}\n142\t\treturn m\n143\t}\n144\t\n145\t// --- B6-3 SessionEnd Hook 集成测试 ---\n146\t// 模拟 SessionEnd hook 调用 release-session API 的完整流程\n147\t// 验收标准：\n148\t//   - session 正常结束时，领取的 issue 被自动释放\n149\t//   - 已合并/打回的 issue 不被释放\n150\t//   - 无领取记录的 session 不报错\n151\t\n152\tfunc TestSessionEndHook(t *testing.T) {\n153\t\tt.Run(\"session_end_releases_claimed_issues\", func(t *testing.T) {\n154\t\t\t// 验收：session 正常结束时，领取的 issue 被自动释放\n155\t\t\t// 模拟场景：sess_test 领取了 #10(claimed) 和 #11(fixing)\n156\t\t\t// SessionEnd hook 调用 release-session → #10/#11 回到 idle\n157\t\t\te := setup(t)\n158\t\t\tdb := e.store.DB()\n159\t\n160\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n161\t\t\tseedIssue(db, \"test/repo\", 11, \"fixing\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n162\t\n163\t\t\t// 模拟 hook 调用 release-session\n164\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n165\t\t\t\t`{\"session_id\":\"sess_test\"}`)\n166\t\n167\t\t\tvar result struct {\n168\t\t\t\tReleased []int `json:\"released\"`\n169\t\t\t\tCount    int   `json:\"count\"`\n170\t\t\t}\n171\t\t\treadJSON(t, resp, &result)\n172\t\n173\t\t\tif result.Count != 2 {\n174\t\t\t\tt.Fatalf(\"expected 2 released, got %d\", result.Count)\n175\t\t\t}\n176\t\n177\t\t\t// 验证两个 issue 都回到了 idle\n178\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10, 11})\n179\t\t\tif statuses[10] != \"idle\" {\n180\t\t\t\tt.Errorf(\"expected #10 idle, got %s\", statuses[10])\n181\t\t\t}\n182\t\t\tif statuses[11] != \"idle\" {\n183\t\t\t\tt.Errorf(\"expected #11 idle, got %s\", statuses[11])\n184\t\t\t}\n185\t\t})\n186\t\n187\t\tt.Run(\"merged_and_rejected_not_released\", func(t *testing.T) {\n188\t\t\t// 验收：已合并/打回的 issue 不被释放\n189\t\t\t// 模拟场景：sess_test 有 #10(claimed) #11(merged) #12(rejected)\n190\t\t\t// SessionEnd → 只有 #10 被释放，#11/#12 不变\n191\t\t\te := setup(t)\n192\t\t\tdb := e.store.DB()\n193\t\n194\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n195\t\t\tseedIssue(db, \"test/repo\", 11, \"merged\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n196\t\t\tseedIssue(db, \"test/repo\", 12, \"rejected\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n197\t\n198\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n199\t\t\t\t`{\"session_id\":\"sess_test\"}`)\n200\t\n201\t\t\tvar result struct {\n202\t\t\t\tReleased []int `json:\"released\"`\n203\t\t\t\tCount    int   `json:\"count\"`\n204\t\t\t}\n205\t\t\treadJSON(t, resp, &result)\n206\t\n207\t\t\tif result.Count != 1 {\n208\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n209\t\t\t}\n210\t\t\tif len(result.Released) != 1 || result.Released[0] != 10 {\n211\t\t\t\tt.Fatalf(\"expected [10], got %v\", result.Released)\n212\t\t\t}\n213\t\n214\t\t\t// 验证终态不变\n215\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10, 11, 12})\n216\t\t\tif statuses[10] != \"idle\" {\n217\t\t\t\tt.Errorf(\"expected #10 idle after release, got %s\", statuses[10])\n218\t\t\t}\n219\t\t\tif statuses[11] != \"merged\" {\n220\t\t\t\tt.Errorf(\"expected #11 still merged, got %s\", statuses[11])\n221\t\t\t}\n222\t\t\tif statuses[12] != \"rejected\" {\n223\t\t\t\tt.Errorf(\"expected #12 still rejected, got %s\", statuses[12])\n224\t\t\t}\n225\t\t})\n226\t\n227\t\tt.Run(\"no_claims_returns_empty_no_error\", func(t *testing.T) {\n228\t\t\t// 验收：无领取记录的 session 不报错\n229\t\t\t// 模拟场景：sess_empty 没有领取任何 issue\n230\t\t\t// SessionEnd → released=[], count=0，无报错\n231\t\t\te := setup(t)\n232\t\n233\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n234\t\t\t\t`{\"session_id\":\"sess_empty\"}`)\n235\t\n236\t\t\tvar result struct {\n237\t\t\t\tReleased []int `json:\"released\"`\n238\t\t\t\tCount    int   `json:\"count\"`\n239\t\t\t}\n240\t\t\treadJSON(t, resp, &result)\n241\t\n242\t\t\tif resp.StatusCode != http.StatusOK {\n243\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n244\t\t\t}\n245\t\t\tif result.Count != 0 {\n246\t\t\t\tt.Errorf(\"expected 0, got %d\", result.Count)\n247\t\t\t}\n248\t\t\tif len(result.Released) != 0 {\n249\t\t\t\tt.Errorf(\"expected empty, got %v\", result.Released)\n250\t\t\t}\n251\t\t})\n252\t\n253\t\tt.Run(\"only_releases_target_session\", func(t *testing.T) {\n254\t\t\t// 补充：只释放目标 session 的 issue，其他 session 的 issue 不受影响\n255\t\t\t// 模拟场景：sess_a 领取 #10, sess_b 领取 #11, #12(merged)属于 sess_a\n256\t\t\t// SessionEnd(sess_a) → 释放 #10，#11(属于sess_b)和 #12(merged)不变\n257\t\t\te := setup(t)\n258\t\t\tdb := e.store.DB()\n259\t\n260\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n261\t\t\tseedIssue(db, \"test/repo\", 11, \"claimed\", \"sess_b\", \"2026-05-26T10:00:00Z\")\n262\t\t\tseedIssue(db, \"test/repo\", 12, \"merged\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n263\t\n264\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n265\t\t\t\t`{\"session_id\":\"sess_a\"}`)\n266\t\n267\t\t\tvar result struct {\n268\t\t\t\tReleased []int `json:\"released\"`\n269\t\t\t\tCount    int   `json:\"count\"`\n270\t\t\t}\n271\t\t\treadJSON(t, resp, &result)\n272\t\n273\t\t\tif result.Count != 1 {\n274\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n275\t\t\t}\n276\t\t\tif len(result.Released) != 1 || result.Released[0] != 10 {\n277\t\t\t\tt.Fatalf(\"expected [10], got %v\", result.Released)\n278\t\t\t}\n279\t\n280\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10, 11, 12})\n281\t\t\tif statuses[10] != \"idle\" {\n282\t\t\t\tt.Errorf(\"expected #10 idle, got %s\", statuses[10])\n283\t\t\t}\n284\t\t\tif statuses[11] != \"claimed\" {\n285\t\t\t\tt.Errorf(\"expected #11 still claimed (sess_b), got %s\", statuses[11])\n286\t\t\t}\n287\t\t\tif statuses[12] != \"merged\" {\n288\t\t\t\tt.Errorf(\"expected #12 still merged, got %s\", statuses[12])\n289\t\t\t}\n290\t\t})\n291\t\n292\t\tt.Run(\"full_flow_claim_then_session_end\", func(t *testing.T) {\n293\t\t\t// 端到端流程：先 check（自动创建 idle）→ 模拟 claim → SessionEnd 释放\n294\t\t\t// 模拟完整生命周期：idle → claimed → SessionEnd → idle\n295\t\t\te := setup(t)\n296\t\n297\t\t\t// 1. check 创建 idle 记录\n298\t\t\te.post(t, \"/api/issue/check\",\n299\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[20]}`)\n300\t\n301\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{20})\n302\t\t\tif statuses[20] != \"idle\" {\n303\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", statuses[20])\n304\t\t\t}\n305\t\n306\t\t\t// 2. 模拟 claim（直接 SQL，claim API 后续实现）\n307\t\t\te.store.DB().Exec(\n308\t\t\t\t`UPDATE issue_claims SET status='claimed', session_id='sess_e2e', claimed_at=CURRENT_TIMESTAMP\n309\t\t\t\t WHERE repo_full_name='test/repo' AND issue_number=20`)\n310\t\n311\t\t\tstatuses = checkStatuses(t, e, \"test/repo\", []int{20})\n312\t\t\tif statuses[20] != \"claimed\" {\n313\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", statuses[20])\n314\t\t\t}\n315\t\n316\t\t\t// 3. SessionEnd 触发释放\n317\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n318\t\t\t\t`{\"session_id\":\"sess_e2e\"}`)\n319\t\n320\t\t\tvar result struct {\n321\t\t\t\tCount int `json:\"count\"`\n322\t\t\t}\n323\t\t\treadJSON(t, resp, &result)\n324\t\t\tif result.Count != 1 {\n325\t\t\t\tt.Fatalf(\"step 3: expected 1 released, got %d\", result.Count)\n326\t\t\t}\n327\t\n328\t\t\t// 4. 验证回到 idle\n329\t\t\tstatuses = checkStatuses(t, e, \"test/repo\", []int{20})\n330\t\t\tif statuses[20] != \"idle\" {\n331\t\t\t\tt.Fatalf(\"step 4: expected idle after release, got %s\", statuses[20])\n332\t\t\t}\n333\t\t})\n334\t}\n335\t\n336\t// --- B3: Claim API 集成测试 ---\n337\t// 验收标准：\n338\t//   - 空闲 issue 可被成功领取\n339\t//   - 已被其他 session 领取的 issue 返回 already_claimed\n340\t//   - 同一 session 重复领取同一 issue 返回成功（幂等）\n341\t//   - 已合并/打回的 issue 不可领取\n342\t//   - 首次出现的 issue 自动创建记录后领取\n343\t//   - 并发领取时只有一个成功（原子性）\n344\t\n345\tfunc TestClaimAPI(t *testing.T) {\n346\t\tt.Run(\"claim_idle_issue_success\", func(t *testing.T) {\n347\t\t\t// 验收：空闲 issue 可被成功领取\n348\t\t\te := setup(t)\n349\t\t\tdb := e.store.DB()\n350\t\n351\t\t\tseedIssue(db, \"test/repo\", 10, \"idle\", \"\", \"\")\n352\t\n353\t\t\tcode, success, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_a\")\n354\t\t\tif code != http.StatusOK {\n355\t\t\t\tt.Fatalf(\"expected 200, got %d\", code)\n356\t\t\t}\n357\t\t\tif !success {\n358\t\t\t\tt.Fatal(\"expected success=true\")\n359\t\t\t}\n360\t\n361\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10})\n362\t\t\tif statuses[10] != \"claimed\" {\n363\t\t\t\tt.Errorf(\"expected claimed, got %s\", statuses[10])\n364\t\t\t}\n365\t\t})\n366\t\n367\t\tt.Run(\"claim_already_claimed_by_other\", func(t *testing.T) {\n368\t\t\t// 验收：已被其他 session 领取的 issue 返回 already_claimed\n369\t\t\te := setup(t)\n370\t\t\tdb := e.store.DB()\n371\t\n372\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n373\t\n374\t\t\tcode, success, claimedBy := claimIssue(t, e, \"test/repo\", 10, \"sess_b\")\n375\t\t\tif code != http.StatusConflict {\n376\t\t\t\tt.Fatalf(\"expected 409, got %d\", code)\n377\t\t\t}\n378\t\t\tif success {\n379\t\t\t\tt.Fatal(\"expected success=false\")\n380\t\t\t}\n381\t\t\tif claimedBy != \"sess_a\" {\n382\t\t\t\tt.Errorf(\"expected claimed_by=sess_a, got %s\", claimedBy)\n383\t\t\t}\n384\t\t})\n385\t\n386\t\tt.Run(\"claim_idempotent_same_session\", func(t *testing.T) {\n387\t\t\t// 验收：同一 session 重复领取同一 issue 返回成功（幂等）\n388\t\t\te := setup(t)\n389\t\t\tdb := e.store.DB()\n390\t\n391\t\t\tseedIssue(db, \"test/repo\", 10, \"idle\", \"\", \"\")\n392\t\n393\t\t\tcode1, ok1, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_a\")\n394\t\t\tif code1 != http.StatusOK || !ok1 {\n395\t\t\t\tt.Fatalf(\"first claim should succeed: code=%d ok=%v\", code1, ok1)\n396\t\t\t}\n397\t\n398\t\t\tcode2, ok2, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_a\")\n399\t\t\tif code2 != http.StatusOK || !ok2 {\n400\t\t\t\tt.Fatalf(\"idempotent claim should succeed: code=%d ok=%v\", code2, ok2)\n401\t\t\t}\n402\t\t})\n403\t\n404\t\tt.Run(\"claim_merged_rejected_blocked\", func(t *testing.T) {\n405\t\t\t// 验收：已合并/打回的 issue 不可领取\n406\t\t\te := setup(t)\n407\t\t\tdb := e.store.DB()\n408\t\n409\t\t\tseedIssue(db, \"test/repo\", 10, \"merged\", \"sess_old\", \"2026-05-26T10:00:00Z\")\n410\t\t\tseedIssue(db, \"test/repo\", 11, \"rejected\", \"sess_old\", \"2026-05-26T10:00:00Z\")\n411\t\n412\t\t\tcode10, ok10, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_new\")\n413\t\t\tif code10 != http.StatusConflict || ok10 {\n414\t\t\t\tt.Errorf(\"merged issue should not be claimable: code=%d ok=%v\", code10, ok10)\n415\t\t\t}\n416\t\n417\t\t\tcode11, ok11, _ := claimIssue(t, e, \"test/repo\", 11, \"sess_new\")\n418\t\t\tif code11 != http.StatusConflict || ok11 {\n419\t\t\t\tt.Errorf(\"rejected issue should not be claimable: code=%d ok=%v\", code11, ok11)\n420\t\t\t}\n421\t\t})\n422\t\n423\t\tt.Run(\"claim_new_issue_auto_create\", func(t *testing.T) {\n424\t\t\t// 验收：首次出现的 issue 自动创建记录后领取\n425\t\t\te := setup(t)\n426\t\n427\t\t\tcode, success, _ := claimIssue(t, e, \"test/repo\", 99, \"sess_new\")\n428\t\t\tif code != http.StatusOK || !success {\n429\t\t\t\tt.Fatalf(\"first-time claim should succeed: code=%d ok=%v\", code, success)\n430\t\t\t}\n431\t\n432\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{99})\n433\t\t\tif statuses[99] != \"claimed\" {\n434\t\t\t\tt.Errorf(\"expected claimed, got %s\", statuses[99])\n435\t\t\t}\n436\t\t})\n437\t\n438\t\tt.Run(\"claim_missing_params_returns_error\", func(t *testing.T) {\n439\t\t\t// 补充：缺少必填参数时返回 400\n440\t\t\te := setup(t)\n441\t\n442\t\t\tresp := e.post(t, \"/api/issue/claim\", `{\"repo_full_name\":\"test/repo\",\"issue_number\":10}`)\n443\t\t\tif resp.StatusCode != http.StatusBadRequest {\n444\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n445\t\t\t}\n446\t\t})\n447\t\n448\t\tt.Run(\"claim_after_release_succeeds\", func(t *testing.T) {\n449\t\t\t// 补充：issue 被释放后可被重新领取\n450\t\t\te := setup(t)\n451\t\t\tdb := e.store.DB()\n452\t\n453\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n454\t\n455\t\t\t// 释放\n456\t\t\te.post(t, \"/api/issue/release\",\n457\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_a\"}`)\n458\t\n459\t\t\t// 新 session 领取\n460\t\t\tcode, success, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_b\")\n461\t\t\tif code != http.StatusOK || !success {\n462\t\t\t\tt.Fatalf(\"claim after release should succeed: code=%d ok=%v\", code, success)\n463\t\t\t}\n464\t\t})\n465\t}\n466\t\n467\t// --- D2: 003-5-issue-fix 技能集成测试 ---\n468\t// 模拟 003-5-issue-fix 技能调用后端的完整流程\n469\t// 验收标准：\n470\t//   - claim 后调 status API 可将状态更新为 fixing\n471\t//   - 非 owner session 无法标记 fixing\n472\t//   - 后端不可用时 skill 脚本静默降级（此处验证 API 层行为）\n473\t//   - fixing 状态的 issue 可被 session end 正常释放\n474\t//   - 完整技能流程：claim → fixing → session end 释放\n475\t\n476\tfunc TestIssueFixFlow(t *testing.T) {\n477\t\tt.Run(\"claim_then_fixing\", func(t *testing.T) {\n478\t\t\t// D2 核心验收：claim → fixing 状态流转\n479\t\t\t// 模拟 /003-4-issue-claim 后，/003-5-issue-fix 标记 fixing\n480\t\t\te := setup(t)\n481\t\n482\t\t\t// 1. check 创建 idle\n483\t\t\te.post(t, \"/api/issue/check\",\n484\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[10]}`)\n485\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n486\t\t\tif s[10] != \"idle\" {\n487\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[10])\n488\t\t\t}\n489\t\n490\t\t\t// 2. claim（模拟 003-4-issue-claim）\n491\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 10, \"sess_fix_001\")\n492\t\t\tif code != http.StatusOK || !ok {\n493\t\t\t\tt.Fatalf(\"step 2: claim failed: code=%d ok=%v\", code, ok)\n494\t\t\t}\n495\t\n496\t\t\t// 3. 标记 fixing（模拟 003-5-issue-fix 调用 update_issue_status）\n497\t\t\tresp := e.post(t, \"/api/issue/status\",\n498\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":10,\"session_id\":\"sess_fix_001\",\"status\":\"fixing\"}`)\n499\t\t\tvar result struct {\n500\t\t\t\tSuccess        bool   `json:\"success\"`\n501\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n502\t\t\t\tNewStatus      string `json:\"new_status\"`\n503\t\t\t}\n504\t\t\treadJSON(t, resp, &result)\n505\t\t\tif !result.Success {\n506\t\t\t\tt.Fatalf(\"step 3: fixing update failed\")\n507\t\t\t}\n508\t\t\tif result.PreviousStatus != \"claimed\" {\n509\t\t\t\tt.Errorf(\"step 3: expected previous=claimed, got %s\", result.PreviousStatus)\n510\t\t\t}\n511\t\t\tif result.NewStatus != \"fixing\" {\n512\t\t\t\tt.Errorf(\"step 3: expected new=fixing, got %s\", result.NewStatus)\n513\t\t\t}\n514\t\n515\t\t\t// 4. check 确认状态为 fixing\n516\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n517\t\t\tif s[10] != \"fixing\" {\n518\t\t\t\tt.Fatalf(\"step 4: expected fixing, got %s\", s[10])\n519\t\t\t}\n520\t\t})\n521\t\n522\t\tt.Run(\"non_owner_cannot_fix\", func(t *testing.T) {\n523\t\t\t// 验收：非领取者无法标记 fixing\n524\t\t\te := setup(t)\n525\t\t\tdb := e.store.DB()\n526\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"claimed\", \"sess_owner\", \"2026-05-27T10:00:00Z\")\n527\t\n528\t\t\tresp := e.post(t, \"/api/issue/status\",\n529\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"fixing\"}`)\n530\t\n531\t\t\tvar result struct {\n532\t\t\t\tSuccess bool   `json:\"success\"`\n533\t\t\t\tError   string `json:\"error\"`\n534\t\t\t}\n535\t\t\treadJSON(t, resp, &result)\n536\t\t\tif result.Success {\n537\t\t\t\tt.Fatal(\"non-owner should not be able to update status\")\n538\t\t\t}\n539\t\t\tif result.Error != \"not_owner\" {\n540\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n541\t\t\t}\n542\t\t})\n543\t\n544\t\tt.Run(\"fixing_released_on_session_end\", func(t *testing.T) {\n545\t\t\t// 验收：fixing 状态的 issue 在 session 结束时被释放回到 idle\n546\t\t\t// 模拟：claim → fixing → session end → idle\n547\t\t\te := setup(t)\n548\t\t\tdb := e.store.DB()\n549\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"claimed\", \"sess_fix_end\", \"2026-05-27T10:00:00Z\")\n550\t\n551\t\t\t// 标记 fixing\n552\t\t\te.post(t, \"/api/issue/status\",\n553\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":10,\"session_id\":\"sess_fix_end\",\"status\":\"fixing\"}`)\n554\t\n555\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n556\t\t\tif s[10] != \"fixing\" {\n557\t\t\t\tt.Fatalf(\"expected fixing before session end, got %s\", s[10])\n558\t\t\t}\n559\t\n560\t\t\t// session end 释放\n561\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n562\t\t\t\t`{\"session_id\":\"sess_fix_end\"}`)\n563\t\t\tvar rel struct {\n564\t\t\t\tCount int `json:\"count\"`\n565\t\t\t}\n566\t\t\treadJSON(t, resp, &rel)\n567\t\t\tif rel.Count != 1 {\n568\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n569\t\t\t}\n570\t\n571\t\t\t// 验证回到 idle\n572\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n573\t\t\tif s[10] != \"idle\" {\n574\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n575\t\t\t}\n576\t\t})\n577\t\n578\t\tt.Run(\"full_lifecycle_claim_fix_release\", func(t *testing.T) {\n579\t\t\t// 完整生命周期：idle → claimed → fixing → session end → idle → re-claim\n580\t\t\te := setup(t)\n581\t\n582\t\t\t// 1. idle\n583\t\t\te.post(t, \"/api/issue/check\",\n584\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[15]}`)\n585\t\n586\t\t\t// 2. claim\n587\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 15, \"sess_lifecycle\")\n588\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n589\t\t\tif s[15] != \"claimed\" {\n590\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", s[15])\n591\t\t\t}\n592\t\n593\t\t\t// 3. fixing\n594\t\t\te.post(t, \"/api/issue/status\",\n595\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":15,\"session_id\":\"sess_lifecycle\",\"status\":\"fixing\"}`)\n596\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n597\t\t\tif s[15] != \"fixing\" {\n598\t\t\t\tt.Fatalf(\"step 3: expected fixing, got %s\", s[15])\n599\t\t\t}\n600\t\n601\t\t\t// 4. session end 释放\n602\t\t\te.post(t, \"/api/issue/release-session\",\n603\t\t\t\t`{\"session_id\":\"sess_lifecycle\"}`)\n604\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n605\t\t\tif s[15] != \"idle\" {\n606\t\t\t\tt.Fatalf(\"step 4: expected idle, got %s\", s[15])\n607\t\t\t}\n608\t\n609\t\t\t// 5. 重新被另一个 session 领取\n610\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 15, \"sess_new\")\n611\t\t\tif code != http.StatusOK || !ok {\n612\t\t\t\tt.Fatalf(\"step 5: re-claim failed: code=%d ok=%v\", code, ok)\n613\t\t\t}\n614\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n615\t\t\tif s[15] != \"claimed\" {\n616\t\t\t\tt.Fatalf(\"step 5: expected claimed, got %s\", s[15])\n617\t\t\t}\n618\t\t})\n619\t\n620\t\tt.Run(\"fixing_merged_not_released_on_session_end\", func(t *testing.T) {\n621\t\t\t// 补充：如果 fixing 的 issue 在期间被外部标记为 merged，\n622\t\t\t// session end 不应释放它（虽然正常流程不会出现这种场景，但验证边界条件）\n623\t\t\te := setup(t)\n624\t\t\tdb := e.store.DB()\n625\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_merged\", \"2026-05-27T10:00:00Z\")\n626\t\n627\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n628\t\t\t\t`{\"session_id\":\"sess_merged\"}`)\n629\t\t\tvar rel struct {\n630\t\t\t\tCount int `json:\"count\"`\n631\t\t\t}\n632\t\t\treadJSON(t, resp, &rel)\n633\t\t\tif rel.Count != 0 {\n634\t\t\t\tt.Fatalf(\"merged should not be released, got count=%d\", rel.Count)\n635\t\t\t}\n636\t\n637\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n638\t\t\tif s[10] != \"merged\" {\n639\t\t\t\tt.Errorf(\"expected merged unchanged, got %s\", s[10])\n640\t\t\t}\n641\t\t})\n642\t}\n643\t\n644\t// --- D3: 003-6-issue-done 技能集成测试 ---\n645\t// 验收标准：\n646\t//   - fixing → ready-for-pr 状态更新\n647\t//   - ready-for-pr 状态在 session end 时被释放\n648\t//   - 完整技能流程：claim → fixing → ready-for-pr → session end\n649\t\n650\tfunc TestIssueDoneFlow(t *testing.T) {\n651\t\tt.Run(\"fixing_to_ready_for_pr\", func(t *testing.T) {\n652\t\t\te := setup(t)\n653\t\n654\t\t\t// claim → fixing → ready-for-pr\n655\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 20, \"sess_done_001\")\n656\t\t\te.post(t, \"/api/issue/status\",\n657\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":20,\"session_id\":\"sess_done_001\",\"status\":\"fixing\"}`)\n658\t\n659\t\t\tresp := e.post(t, \"/api/issue/status\",\n660\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":20,\"session_id\":\"sess_done_001\",\"status\":\"ready-for-pr\"}`)\n661\t\t\tvar result struct {\n662\t\t\t\tSuccess        bool   `json:\"success\"`\n663\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n664\t\t\t\tNewStatus      string `json:\"new_status\"`\n665\t\t\t}\n666\t\t\treadJSON(t, resp, &result)\n667\t\t\tif !result.Success {\n668\t\t\t\tt.Fatal(\"ready-for-pr update failed\")\n669\t\t\t}\n670\t\t\tif result.PreviousStatus != \"fixing\" {\n671\t\t\t\tt.Errorf(\"expected previous=fixing, got %s\", result.PreviousStatus)\n672\t\t\t}\n673\t\n674\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{20})\n675\t\t\tif s[20] != \"ready-for-pr\" {\n676\t\t\t\tt.Fatalf(\"expected ready-for-pr, got %s\", s[20])\n677\t\t\t}\n678\t\t})\n679\t\n680\t\tt.Run(\"ready_for_pr_released_on_session_end\", func(t *testing.T) {\n681\t\t\te := setup(t)\n682\t\t\tdb := e.store.DB()\n683\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"ready-for-pr\", \"sess_done_end\", \"2026-05-27T10:00:00Z\")\n684\t\n685\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n686\t\t\t\t`{\"session_id\":\"sess_done_end\"}`)\n687\t\t\tvar rel struct{ Count int `json:\"count\"` }\n688\t\t\treadJSON(t, resp, &rel)\n689\t\t\tif rel.Count != 1 {\n690\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n691\t\t\t}\n692\t\n693\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n694\t\t\tif s[10] != \"idle\" {\n695\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n696\t\t\t}\n697\t\t})\n698\t\n699\t\tt.Run(\"full_lifecycle_claim_fix_done_release\", func(t *testing.T) {\n700\t\t\te := setup(t)\n701\t\n702\t\t\t// idle\n703\t\t\te.post(t, \"/api/issue/check\",\n704\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[25]}`)\n705\t\n706\t\t\t// claim\n707\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 25, \"sess_lc_done\")\n708\t\n709\t\t\t// fixing\n710\t\t\te.post(t, \"/api/issue/status\",\n711\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":25,\"session_id\":\"sess_lc_done\",\"status\":\"fixing\"}`)\n712\t\n713\t\t\t// ready-for-pr\n714\t\t\te.post(t, \"/api/issue/status\",\n715\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":25,\"session_id\":\"sess_lc_done\",\"status\":\"ready-for-pr\"}`)\n716\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{25})\n717\t\t\tif s[25] != \"ready-for-pr\" {\n718\t\t\t\tt.Fatalf(\"expected ready-for-pr, got %s\", s[25])\n719\t\t\t}\n720\t\n721\t\t\t// session end\n722\t\t\te.post(t, \"/api/issue/release-session\",\n723\t\t\t\t`{\"session_id\":\"sess_lc_done\"}`)\n724\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{25})\n725\t\t\tif s[25] != \"idle\" {\n726\t\t\t\tt.Fatalf(\"expected idle after session end, got %s\", s[25])\n727\t\t\t}\n728\t\n729\t\t\t// re-claim by another session\n730\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 25, \"sess_new\")\n731\t\t\tif code != http.StatusOK || !ok {\n732\t\t\t\tt.Fatalf(\"re-claim failed\")\n733\t\t\t}\n734\t\t})\n735\t}\n736\t\n737\t// --- D4: 003-7-issue-pr 技能集成测试 ---\n738\t// 验收标准：\n739\t//   - ready-for-pr → pr-created 状态更新\n740\t//   - pr-created 状态在 session end 时被释放\n741\t//   - 完整技能流程：claim → fixing → ready-for-pr → pr-created\n742\t\n743\tfunc TestIssuePRFlow(t *testing.T) {\n744\t\tt.Run(\"ready_for_pr_to_pr_created\", func(t *testing.T) {\n745\t\t\te := setup(t)\n746\t\n747\t\t\t// claim → fixing → ready-for-pr → pr-created\n748\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 30, \"sess_pr_001\")\n749\t\t\te.post(t, \"/api/issue/status\",\n750\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":30,\"session_id\":\"sess_pr_001\",\"status\":\"fixing\"}`)\n751\t\t\te.post(t, \"/api/issue/status\",\n752\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":30,\"session_id\":\"sess_pr_001\",\"status\":\"ready-for-pr\"}`)\n753\t\n754\t\t\tresp := e.post(t, \"/api/issue/status\",\n755\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":30,\"session_id\":\"sess_pr_001\",\"status\":\"pr-created\"}`)\n756\t\t\tvar result struct {\n757\t\t\t\tSuccess        bool   `json:\"success\"`\n758\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n759\t\t\t\tNewStatus      string `json:\"new_status\"`\n760\t\t\t}\n761\t\t\treadJSON(t, resp, &result)\n762\t\t\tif !result.Success {\n763\t\t\t\tt.Fatal(\"pr-created update failed\")\n764\t\t\t}\n765\t\t\tif result.PreviousStatus != \"ready-for-pr\" {\n766\t\t\t\tt.Errorf(\"expected previous=ready-for-pr, got %s\", result.PreviousStatus)\n767\t\t\t}\n768\t\n769\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{30})\n770\t\t\tif s[30] != \"pr-created\" {\n771\t\t\t\tt.Fatalf(\"expected pr-created, got %s\", s[30])\n772\t\t\t}\n773\t\t})\n774\t\n775\t\tt.Run(\"pr_created_released_on_session_end\", func(t *testing.T) {\n776\t\t\te := setup(t)\n777\t\t\tdb := e.store.DB()\n778\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"pr-created\", \"sess_pr_end\", \"2026-05-27T10:00:00Z\")\n779\t\n780\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n781\t\t\t\t`{\"session_id\":\"sess_pr_end\"}`)\n782\t\t\tvar rel struct{ Count int `json:\"count\"` }\n783\t\t\treadJSON(t, resp, &rel)\n784\t\t\tif rel.Count != 1 {\n785\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n786\t\t\t}\n787\t\n788\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n789\t\t\tif s[10] != \"idle\" {\n790\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n791\t\t\t}\n792\t\t})\n793\t\n794\t\tt.Run(\"full_lifecycle_to_pr_created\", func(t *testing.T) {\n795\t\t\te := setup(t)\n796\t\n797\t\t\t// idle\n798\t\t\te.post(t, \"/api/issue/check\",\n799\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[35]}`)\n800\t\n801\t\t\t// claim → fixing → ready-for-pr → pr-created\n802\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 35, \"sess_pr_lc\")\n803\t\t\te.post(t, \"/api/issue/status\",\n804\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":35,\"session_id\":\"sess_pr_lc\",\"status\":\"fixing\"}`)\n805\t\t\te.post(t, \"/api/issue/status\",\n806\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":35,\"session_id\":\"sess_pr_lc\",\"status\":\"ready-for-pr\"}`)\n807\t\t\te.post(t, \"/api/issue/status\",\n808\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":35,\"session_id\":\"sess_pr_lc\",\"status\":\"pr-created\"}`)\n809\t\n810\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{35})\n811\t\t\tif s[35] != \"pr-created\" {\n812\t\t\t\tt.Fatalf(\"expected pr-created, got %s\", s[35])\n813\t\t\t}\n814\t\n815\t\t\t// session end 释放 pr-created\n816\t\t\te.post(t, \"/api/issue/release-session\",\n817\t\t\t\t`{\"session_id\":\"sess_pr_lc\"}`)\n818\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{35})\n819\t\t\tif s[35] != \"idle\" {\n820\t\t\t\tt.Fatalf(\"expected idle after session end, got %s\", s[35])\n821\t\t\t}\n822\t\n823\t\t\t// re-claim\n824\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 35, \"sess_new\")\n825\t\t\tif code != http.StatusOK || !ok {\n826\t\t\t\tt.Fatalf(\"re-claim failed\")\n827\t\t\t}\n828\t\t})\n829\t}\n830\t\n831\t// --- D5: 003-8-issue-test 技能集成测试 ---\n832\t// 验收标准：\n833\t//   - pr-created → testing 状态更新\n834\t//   - testing 状态在 session end 时被释放\n835\t//   - 完整技能流程：claim → fixing → ready-for-pr → pr-created → testing\n836\t\n837\tfunc TestIssueTestFlow(t *testing.T) {\n838\t\tt.Run(\"pr_created_to_testing\", func(t *testing.T) {\n839\t\t\te := setup(t)\n840\t\n841\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 40, \"sess_test_001\")\n842\t\t\te.post(t, \"/api/issue/status\",\n843\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":40,\"session_id\":\"sess_test_001\",\"status\":\"fixing\"}`)\n844\t\t\te.post(t, \"/api/issue/status\",\n845\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":40,\"session_id\":\"sess_test_001\",\"status\":\"ready-for-pr\"}`)\n846\t\t\te.post(t, \"/api/issue/status\",\n847\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":40,\"session_id\":\"sess_test_001\",\"status\":\"pr-created\"}`)\n848\t\n849\t\t\tresp := e.post(t, \"/api/issue/status\",\n850\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":40,\"session_id\":\"sess_test_001\",\"status\":\"testing\"}`)\n851\t\t\tvar result struct {\n852\t\t\t\tSuccess        bool   `json:\"success\"`\n853\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n854\t\t\t\tNewStatus      string `json:\"new_status\"`\n855\t\t\t}\n856\t\t\treadJSON(t, resp, &result)\n857\t\t\tif !result.Success {\n858\t\t\t\tt.Fatal(\"testing update failed\")\n859\t\t\t}\n860\t\t\tif result.PreviousStatus != \"pr-created\" {\n861\t\t\t\tt.Errorf(\"expected previous=pr-created, got %s\", result.PreviousStatus)\n862\t\t\t}\n863\t\n864\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{40})\n865\t\t\tif s[40] != \"testing\" {\n866\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[40])\n867\t\t\t}\n868\t\t})\n869\t\n870\t\tt.Run(\"testing_released_on_session_end\", func(t *testing.T) {\n871\t\t\te := setup(t)\n872\t\t\tdb := e.store.DB()\n873\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"testing\", \"sess_test_end\", \"2026-05-27T10:00:00Z\")\n874\t\n875\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n876\t\t\t\t`{\"session_id\":\"sess_test_end\"}`)\n877\t\t\tvar rel struct{ Count int `json:\"count\"` }\n878\t\t\treadJSON(t, resp, &rel)\n879\t\t\tif rel.Count != 1 {\n880\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n881\t\t\t}\n882\t\n883\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n884\t\t\tif s[10] != \"idle\" {\n885\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n886\t\t\t}\n887\t\t})\n888\t\n889\t\tt.Run(\"full_lifecycle_to_testing\", func(t *testing.T) {\n890\t\t\te := setup(t)\n891\t\n892\t\t\t// idle\n893\t\t\te.post(t, \"/api/issue/check\",\n894\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[45]}`)\n895\t\n896\t\t\t// claim → fixing → ready-for-pr → pr-created → testing\n897\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 45, \"sess_test_lc\")\n898\t\t\te.post(t, \"/api/issue/status\",\n899\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"fixing\"}`)\n900\t\t\te.post(t, \"/api/issue/status\",\n901\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"ready-for-pr\"}`)\n902\t\t\te.post(t, \"/api/issue/status\",\n903\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"pr-created\"}`)\n904\t\t\te.post(t, \"/api/issue/status\",\n905\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"testing\"}`)\n906\t\n907\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{45})\n908\t\t\tif s[45] != \"testing\" {\n909\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[45])\n910\t\t\t}\n911\t\n912\t\t\t// session end 释放 testing\n913\t\t\te.post(t, \"/api/issue/release-session\",\n914\t\t\t\t`{\"session_id\":\"sess_test_lc\"}`)\n915\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{45})\n916\t\t\tif s[45] != \"idle\" {\n917\t\t\t\tt.Fatalf(\"expected idle after session end, got %s\", s[45])\n918\t\t\t}\n919\t\n920\t\t\t// re-claim\n921\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 45, \"sess_new\")\n922\t\t\tif code != http.StatusOK || !ok {\n923\t\t\t\tt.Fatalf(\"re-claim failed\")\n924\t\t\t}\n925\t\t})\n926\t}\n927\t\n928\t// --- D6: 003-9-issue-review 技能集成测试 ---\n929\t// 验收标准：\n930\t//   - testing → reviewing → merged 完整流程\n931\t//   - merged 终态不被 session end 释放\n932\t//   - rejected 终态不被 session end 释放\n933\t//   - rejected issue 释放后可被重新 claim\n934\t\n935\tfunc TestIssueReviewFlow(t *testing.T) {\n936\t\tt.Run(\"merge_full_flow\", func(t *testing.T) {\n937\t\t\te := setup(t)\n938\t\n939\t\t\t// claim → fixing → ready-for-pr → pr-created → testing → reviewing → merged\n940\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 50, \"sess_merge\")\n941\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n942\t\t\t\te.post(t, \"/api/issue/status\",\n943\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":50,\"session_id\":\"sess_merge\",\"status\":\"%s\"}`, s))\n944\t\t\t}\n945\t\n946\t\t\tresp := e.post(t, \"/api/issue/status\",\n947\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":50,\"session_id\":\"sess_merge\",\"status\":\"merged\"}`)\n948\t\t\tvar result struct {\n949\t\t\t\tSuccess        bool   `json:\"success\"`\n950\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n951\t\t\t\tNewStatus      string `json:\"new_status\"`\n952\t\t\t}\n953\t\t\treadJSON(t, resp, &result)\n954\t\t\tif !result.Success {\n955\t\t\t\tt.Fatal(\"merged update failed\")\n956\t\t\t}\n957\t\t\tif result.PreviousStatus != \"reviewing\" {\n958\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n959\t\t\t}\n960\t\n961\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{50})\n962\t\t\tif s[50] != \"merged\" {\n963\t\t\t\tt.Fatalf(\"expected merged, got %s\", s[50])\n964\t\t\t}\n965\t\t})\n966\t\n967\t\tt.Run(\"merged_not_released_on_session_end\", func(t *testing.T) {\n968\t\t\t// 验收：merged 终态不被 session end 释放\n969\t\t\te := setup(t)\n970\t\t\tdb := e.store.DB()\n971\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_merged\", \"2026-05-27T10:00:00Z\")\n972\t\n973\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n974\t\t\t\t`{\"session_id\":\"sess_merged\"}`)\n975\t\t\tvar rel struct{ Count int `json:\"count\"` }\n976\t\t\treadJSON(t, resp, &rel)\n977\t\t\tif rel.Count != 0 {\n978\t\t\t\tt.Fatalf(\"merged should not be released, got count=%d\", rel.Count)\n979\t\t\t}\n980\t\n981\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n982\t\t\tif s[10] != \"merged\" {\n983\t\t\t\tt.Errorf(\"expected merged unchanged, got %s\", s[10])\n984\t\t\t}\n985\t\t})\n986\t\n987\t\tt.Run(\"reject_full_flow\", func(t *testing.T) {\n988\t\t\te := setup(t)\n989\t\n990\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 55, \"sess_reject\")\n991\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n992\t\t\t\te.post(t, \"/api/issue/status\",\n993\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":55,\"session_id\":\"sess_reject\",\"status\":\"%s\"}`, s))\n994\t\t\t}\n995\t\n996\t\t\tresp := e.post(t, \"/api/issue/status\",\n997\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":55,\"session_id\":\"sess_reject\",\"status\":\"rejected\"}`)\n998\t\t\tvar result struct {\n999\t\t\t\tSuccess        bool   `json:\"success\"`\n1000\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1001\t\t\t}\n1002\t\t\treadJSON(t, resp, &result)\n1003\t\t\tif !result.Success {\n1004\t\t\t\tt.Fatal(\"rejected update failed\")\n1005\t\t\t}\n1006\t\t\tif result.PreviousStatus != \"reviewing\" {\n1007\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1008\t\t\t}\n1009\t\n1010\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{55})\n1011\t\t\tif s[55] != \"rejected\" {\n1012\t\t\t\tt.Fatalf(\"expected rejected, got %s\", s[55])\n1013\t\t\t}\n1014\t\t})\n1015\t\n1016\t\tt.Run(\"rejected_not_released_on_session_end\", func(t *testing.T) {\n1017\t\t\t// 验收：rejected 终态不被 session end 释放\n1018\t\t\te := setup(t)\n1019\t\t\tdb := e.store.DB()\n1020\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"rejected\", \"sess_rejected\", \"2026-05-27T10:00:00Z\")\n1021\t\n1022\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1023\t\t\t\t`{\"session_id\":\"sess_rejected\"}`)\n1024\t\t\tvar rel struct{ Count int `json:\"count\"` }\n1025\t\t\treadJSON(t, resp, &rel)\n1026\t\t\tif rel.Count != 0 {\n1027\t\t\t\tt.Fatalf(\"rejected should not be released, got count=%d\", rel.Count)\n1028\t\t\t}\n1029\t\n1030\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{11})\n1031\t\t\tif s[11] != \"rejected\" {\n1032\t\t\t\tt.Errorf(\"expected rejected unchanged, got %s\", s[11])\n1033\t\t\t}\n1034\t\t})\n1035\t\n1036\t\tt.Run(\"non_terminal_reviewing_released_on_session_end\", func(t *testing.T) {\n1037\t\t\t// reviewing（非终态）在 session end 时应被释放\n1038\t\t\te := setup(t)\n1039\t\t\tdb := e.store.DB()\n1040\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 12, \"reviewing\", \"sess_rev\", \"2026-05-27T10:00:00Z\")\n1041\t\n1042\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1043\t\t\t\t`{\"session_id\":\"sess_rev\"}`)\n1044\t\t\tvar rel struct{ Count int `json:\"count\"` }\n1045\t\t\treadJSON(t, resp, &rel)\n1046\t\t\tif rel.Count != 1 {\n1047\t\t\t\tt.Fatalf(\"reviewing should be released, got count=%d\", rel.Count)\n1048\t\t\t}\n1049\t\n1050\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{12})\n1051\t\t\tif s[12] != \"idle\" {\n1052\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[12])\n1053\t\t\t}\n1054\t\t})\n1055\t\n1056\t\tt.Run(\"complete_lifecycle_merge\", func(t *testing.T) {\n1057\t\t\t// 完整生命周期：idle → claimed → ... → merged，session end 不影响\n1058\t\t\te := setup(t)\n1059\t\n1060\t\t\te.post(t, \"/api/issue/check\",\n1061\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[60]}`)\n1062\t\n1063\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 60, \"sess_full_merge\")\n1064\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\", \"merged\"} {\n1065\t\t\t\te.post(t, \"/api/issue/status\",\n1066\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":60,\"session_id\":\"sess_full_merge\",\"status\":\"%s\"}`, s))\n1067\t\t\t}\n1068\t\n1069\t\t\t// session end 不释放 merged\n1070\t\t\te.post(t, \"/api/issue/release-session\",\n1071\t\t\t\t`{\"session_id\":\"sess_full_merge\"}`)\n1072\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{60})\n1073\t\t\tif s[60] != \"merged\" {\n1074\t\t\t\tt.Fatalf(\"expected merged preserved after session end, got %s\", s[60])\n1075\t\t\t}\n1076\t\t})\n1077\t\n1078\t\tt.Run(\"complete_lifecycle_reject_then_reclaim\", func(t *testing.T) {\n1079\t\t\t// 完整生命周期：... → rejected，手动 release 后可重新 claim\n1080\t\t\te := setup(t)\n1081\t\n1082\t\t\te.post(t, \"/api/issue/check\",\n1083\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[65]}`)\n1084\t\n1085\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 65, \"sess_rej\")\n1086\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\", \"rejected\"} {\n1087\t\t\t\te.post(t, \"/api/issue/status\",\n1088\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":65,\"session_id\":\"sess_rej\",\"status\":\"%s\"}`, s))\n1089\t\t\t}\n1090\t\n1091\t\t\t// rejected 是终态，session end 不释放\n1092\t\t\te.post(t, \"/api/issue/release-session\",\n1093\t\t\t\t`{\"session_id\":\"sess_rej\"}`)\n1094\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{65})\n1095\t\t\tif s[65] != \"rejected\" {\n1096\t\t\t\tt.Fatalf(\"expected rejected preserved, got %s\", s[65])\n1097\t\t\t}\n1098\t\n1099\t\t\t// 手动 release（由新的 fixing 周期触发）\n1100\t\t\te.post(t, \"/api/issue/release\",\n1101\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":65,\"session_id\":\"sess_rej\"}`)\n1102\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{65})\n1103\t\t\tif s[65] != \"rejected\" {\n1104\t\t\t\tt.Fatalf(\"rejected should not be releasable by owner either, got %s\", s[65])\n1105\t\t\t}\n1106\t\t})\n1107\t}\n1108\t\n1109\t// --- D7: SessionEnd Hook 自动释放集成测试 ---\n1110\t// 验收标准：\n1111\t//   - 会话结束时释放该 session 所有非终态 issue\n1112\t//   - merged 不被释放\n1113\t//   - rejected 不被释放\n1114\t//   - 无领取记录的 session 不报错\n1115\t//   - 释放后 issue 可被重新 claim\n1116\t\n1117\tfunc TestSessionEndRelease(t *testing.T) {\n1118\t\tt.Run(\"releases_fixing_ready_for_pr_pr_created_testing_reviewing\", func(t *testing.T) {\n1119\t\t\t// 验收：所有非终态（fixing/ready-for-pr/pr-created/testing/reviewing）都被释放\n1120\t\t\te := setup(t)\n1121\t\t\tdb := e.store.DB()\n1122\t\n1123\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"fixing\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1124\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"ready-for-pr\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1125\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 12, \"pr-created\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1126\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 13, \"testing\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1127\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 14, \"reviewing\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1128\t\n1129\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1130\t\t\t\t`{\"session_id\":\"sess_d7\"}`)\n1131\t\t\tvar result struct {\n1132\t\t\t\tReleased []int `json:\"released\"`\n1133\t\t\t\tCount    int   `json:\"count\"`\n1134\t\t\t}\n1135\t\t\treadJSON(t, resp, &result)\n1136\t\n1137\t\t\tif result.Count != 5 {\n1138\t\t\t\tt.Fatalf(\"expected 5 released, got %d\", result.Count)\n1139\t\t\t}\n1140\t\n1141\t\t\t// 验证所有 issue 都回到 idle\n1142\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11, 12, 13, 14})\n1143\t\t\tfor _, n := range []int{10, 11, 12, 13, 14} {\n1144\t\t\t\tif s[n] != \"idle\" {\n1145\t\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", n, s[n])\n1146\t\t\t\t}\n1147\t\t\t}\n1148\t\t})\n1149\t\n1150\t\tt.Run(\"merged_not_released\", func(t *testing.T) {\n1151\t\t\t// 验收：merged 终态不被释放\n1152\t\t\te := setup(t)\n1153\t\t\tdb := e.store.DB()\n1154\t\n1155\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_d7_m\", \"2026-05-27T10:00:00Z\")\n1156\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"fixing\", \"sess_d7_m\", \"2026-05-27T10:00:00Z\")\n1157\t\n1158\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1159\t\t\t\t`{\"session_id\":\"sess_d7_m\"}`)\n1160\t\t\tvar result struct {\n1161\t\t\t\tReleased []int `json:\"released\"`\n1162\t\t\t\tCount    int   `json:\"count\"`\n1163\t\t\t}\n1164\t\t\treadJSON(t, resp, &result)\n1165\t\n1166\t\t\tif result.Count != 1 {\n1167\t\t\t\tt.Fatalf(\"expected 1 released (fixing only), got %d\", result.Count)\n1168\t\t\t}\n1169\t\t\tif len(result.Released) != 1 || result.Released[0] != 11 {\n1170\t\t\t\tt.Fatalf(\"expected [11], got %v\", result.Released)\n1171\t\t\t}\n1172\t\n1173\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11})\n1174\t\t\tif s[10] != \"merged\" {\n1175\t\t\t\tt.Errorf(\"merged should stay, got %s\", s[10])\n1176\t\t\t}\n1177\t\t\tif s[11] != \"idle\" {\n1178\t\t\t\tt.Errorf(\"fixing should be idle, got %s\", s[11])\n1179\t\t\t}\n1180\t\t})\n1181\t\n1182\t\tt.Run(\"rejected_not_released\", func(t *testing.T) {\n1183\t\t\t// 验收：rejected 终态不被释放\n1184\t\t\te := setup(t)\n1185\t\t\tdb := e.store.DB()\n1186\t\n1187\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"rejected\", \"sess_d7_r\", \"2026-05-27T10:00:00Z\")\n1188\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"claimed\", \"sess_d7_r\", \"2026-05-27T10:00:00Z\")\n1189\t\n1190\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1191\t\t\t\t`{\"session_id\":\"sess_d7_r\"}`)\n1192\t\t\tvar result struct{ Count int `json:\"count\"` }\n1193\t\t\treadJSON(t, resp, &result)\n1194\t\n1195\t\t\tif result.Count != 1 {\n1196\t\t\t\tt.Fatalf(\"expected 1 released (claimed only), got %d\", result.Count)\n1197\t\t\t}\n1198\t\n1199\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11})\n1200\t\t\tif s[10] != \"rejected\" {\n1201\t\t\t\tt.Errorf(\"rejected should stay, got %s\", s[10])\n1202\t\t\t}\n1203\t\t\tif s[11] != \"idle\" {\n1204\t\t\t\tt.Errorf(\"claimed should be idle, got %s\", s[11])\n1205\t\t\t}\n1206\t\t})\n1207\t\n1208\t\tt.Run(\"released_issue_can_be_reclaimed\", func(t *testing.T) {\n1209\t\t\t// 验收：释放后 issue 可被重新 claim\n1210\t\t\te := setup(t)\n1211\t\t\tdb := e.store.DB()\n1212\t\n1213\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"fixing\", \"sess_old\", \"2026-05-27T10:00:00Z\")\n1214\t\n1215\t\t\t// 释放\n1216\t\t\te.post(t, \"/api/issue/release-session\",\n1217\t\t\t\t`{\"session_id\":\"sess_old\"}`)\n1218\t\n1219\t\t\t// 新 session claim\n1220\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 10, \"sess_new\")\n1221\t\t\tif code != http.StatusOK || !ok {\n1222\t\t\t\tt.Fatalf(\"re-claim should succeed: code=%d ok=%v\", code, ok)\n1223\t\t\t}\n1224\t\n1225\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n1226\t\t\tif s[10] != \"claimed\" {\n1227\t\t\t\tt.Fatalf(\"expected claimed after re-claim, got %s\", s[10])\n1228\t\t\t}\n1229\t\t})\n1230\t\n1231\t\tt.Run(\"no_backend_issues_returns_ok\", func(t *testing.T) {\n1232\t\t\t// 验收：无领取记录的 session 返回成功\n1233\t\t\te := setup(t)\n1234\t\n1235\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1236\t\t\t\t`{\"session_id\":\"sess_empty_d7\"}`)\n1237\t\n1238\t\t\tif resp.StatusCode != http.StatusOK {\n1239\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n1240\t\t\t}\n1241\t\t})\n1242\t}\n1243\t"}]}
