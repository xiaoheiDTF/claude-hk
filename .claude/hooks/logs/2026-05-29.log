go func(idx int) {\n\t\t\t\tdefer wg.Done()\n\t\t\t\tsessionID := fmt.Sprintf(\"sess_%d\", idx)\n\t\t\t\tbody := fmt.Sprintf(\n\t\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"%s\"}`,\n\t\t\t\t\tsessionID)\n\t\t\t\tresp := env.post(t, \"/api/issue/claim\", body)\n\t\t\t\tvar result struct {\n\t\t\t\t\tSuccess bool `json:\"success\"`\n\t\t\t\t}\n\t\t\t\treadJSON(t, resp, &result)\n\t\t\t\tif result.Success {\n\t\t\t\t\tatomic.AddInt32(&successCount, 1)\n\t\t\t\t}\n\t\t\t}(i)\n\t\t}\n\n\t\twg.Wait()\n\n\t\tif successCount != 1 {\n\t\t\tt.Fatalf(\"expected exactly 1 successful claim, got %d\", successCount)\n\t\t}\n\n\t\t// Verify final status is claimed (not idle, not multiple claims).\n\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n\t\tif statuses[10] != \"claimed\" {\n\t\t\tt.Errorf(\"expected claimed after concurrent claims, got %s\", statuses[10])\n\t\t}\n\t})\n\n\tt.Run(\"concurrent_claim_different_issues\", func(t *testing.T) {\n\t\t// Each session claims a different issue — all should succeed.\n\t\tenv := setupTest(t)\n\n\t\tvar wg sync.WaitGroup\n\t\tvar successCount int32\n\n\t\tconcurrency := 5\n\t\twg.Add(concurrency)\n\n\t\tfor i := 0; i < concurrency; i++ {\n\t\t\tgo func(idx int) {\n\t\t\t\tdefer wg.Done()\n\t\t\t\tissueNum := 100 + idx\n\t\t\t\tsessionID := fmt.Sprintf(\"sess_diff_%d\", idx)\n\n\t\t\t\t// Auto-create via check first.\n\t\t\t\tbody := fmt.Sprintf(\n\t\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[%d]}`,\n\t\t\t\t\tissueNum)\n\t\t\t\tenv.post(t, \"/api/issue/check\", body)\n\n\t\t\t\t// Claim.\n\t\t\t\tbody = fmt.Sprintf(\n\t\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n\t\t\t\t\tissueNum, sessionID)\n\t\t\t\tresp := env.post(t, \"/api/issue/claim\", body)\n\t\t\t\tvar result struct {\n\t\t\t\t\tSuccess bool `json:\"success\"`\n\t\t\t\t}\n\t\t\t\treadJSON(t, resp, &result)\n\t\t\t\tif result.Success {\n\t\t\t\t\tatomic.AddInt32(&successCount, 1)\n\t\t\t\t}\n\t\t\t}(i)\n\t\t}\n\n\t\twg.Wait()\n\n\t\tif successCount != int32(concurrency) {\n\t\t\tt.Fatalf(\"expected %d successful claims, got %d\", concurrency, successCount)\n\t\t}\n\t})\n}\n","userModified":false},"tool_use_id":"call_3b088b54ffac48fdacea071c","duration_ms":8}
