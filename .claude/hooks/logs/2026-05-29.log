cSSEEvent `json:\"sse_events,omitempty\"`\n34\t}\n35\t\n36\t// AnthropicSSEEvent represents a single Server-Sent Events frame.\n37\ttype AnthropicSSEEvent struct {\n38\t\tEvent string `json:\"event\"`\n39\t\tData  any    `json:\"data\"`\n40\t}\n41\t\n42\t// AnthropicTraceSummary holds aggregate statistics for a trace session.\n43\ttype AnthropicTraceSummary struct {\n44\t\tAPICalls          int            `json:\"api_calls\"`\n45\t\tInputTokens       int64          `json:\"input_tokens\"`\n46\t\tOutputTokens      int64          `json:\"output_tokens\"`\n47\t\tCacheReadTokens   int64          `json:\"cache_read_tokens\"`\n48\t\tCacheCreateTokens int64          `json:\"cache_create_tokens\"`\n49\t\tModelsUsed        map[string]int `json:\"models_used\"`\n50\t}\n51\t\n52\t// NewAnthropicTraceRecord creates a TraceRecord with auto-generated fields.\n53\tfunc NewAnthropicTraceRecord(turn, durationMs int, method, path string) *AnthropicTraceRecord {\n54\t\treturn &AnthropicTraceRecord{\n55\t\t\tTimestamp: time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n56\t\t\tRequestID: fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12),\n57\t\t\tTurn:       turn,\n58\t\t\tDurationMs: durationMs,\n59\t\t\tRequest: AnthropicRequest{\n60\t\t\t\tMethod:  method,\n61\t\t\t\tPath:    path,\n62\t\t\t\tHeaders: make(map[string]string),\n63\t\t\t},\n64\t\t\tResponse: AnthropicResponse{\n65\t\t\t\tHeaders: make(map[string]string),\n66\t\t\t},\n67\t\t}\n68\t}\n69\t"}]}
