n49\t\n50\t// Write serialises the record as a single JSON line, flushes, and updates statistics.\n51\tfunc (w *TraceWriter) Write(record map[string]any) error {\n52\t\tw.mu.Lock()\n53\t\tdefer w.mu.Unlock()\n54\t\n55\t\tdata, err := json.Marshal(record)\n56\t\tif err != nil {\n57\t\t\treturn fmt.Errorf(\"marshal trace record: %w\", err)\n58\t\t}\n59\t\n60\t\tif _, err := w.writer.Write(data); err != nil {\n61\t\t\treturn err\n62\t\t}\n63\t\tif _, err := w.writer.WriteString(\"\\n\"); err != nil {\n64\t\t\treturn err\n65\t\t}\n66\t\tif err := w.writer.Flush(); err != nil {\n67\t\t\treturn err\n68\t\t}\n69\t\n70\t\tw.count++\n71\t\tw.updateStats(record)\n72\t\treturn nil\n73\t}\n74\t\n75\t// Close flushes and closes the underlying file.\n76\tfunc (w *TraceWriter) Close() error {\n77\t\tw.mu.Lock()\n78\t\tdefer w.mu.Unlock()\n79\t\tif w.writer != nil {\n80\t\t\t_ = w.writer.Flush()\n81\t\t}\n82\t\tif w.file != nil {\n83\t\t\treturn w.file.Close()\n84\t\t}\n85\t\treturn nil\n86\t}\n87\t\n88\t// Summary returns aggregate statistics for the trace session.\n89\tfunc (w *TraceWriter) Summary() map[string]any {\n90\t\tw.mu.Lock()\n91\t\tdefer w.mu.Unlock()\n92\t\n93\t\treturn map[string]any{\n94\t\t\t\"api_calls\":             w.count,\n95\t\t\t\"input_tokens\":          w.inputTokens,\n96\t\t\t\"output_tokens\":         w.outputTokens,\n97\t\t\t\"cache_read_tokens\":     w.cacheRead,\n98\t\t\t\"cache_create_tokens\":   w.cacheCreate,\n99\t\t\t\"models_used\":           w.modelsUsed,\n100\t\t}\n101\t}\n102\t\n103\tfunc (w *TraceWriter) updateStats(record map[string]any) {\n104\t\t// Extract model from request body.\n105\t\treqBody, _ := record[\"request\"].(map[string]any)\n106\t\tif reqBody != nil {\n107\t\t\tif body, ok := reqBody[\"body\"].(map[string]any); ok {\n108\t\t\t\tmodel, _ := body[\"model\"].(string)\n109\t\t\t\tif model == \"\" {\n110\t\t\t\t\tmodel = \"unknown\"\n111\t\t\t\t}\n112\t\t\t\tw.modelsUsed[model]++\n113\t\t\t}\n114\t\t}\n115\t\n116\t\t// Extract token usage from response body.\n117\t\trespBody, _ := record[\"response\"].(map[string]any)\n118\t\tif respBody == nil {\n119\t\t\treturn\n120\t\t}\n121\t\tbody, _ := respBody[\"body\"].(map[string]any)\n122\t\tif body == nil {\n123\t\t\treturn\n124\t\t}\n125\t\n126\t\trawUsage, _ := body[\"usage\"].(map[string]any)\n127\t\tif rawUsage == nil {\n128\t\t\t// Sometimes the body itself is the usage object.\n129\t\t\trawUsage = body\n130\t\t}\n131\t\n132\t\tnorm := usage.NormalizeUsage(rawUsage)\n133\t\tw.inputTokens += norm[\"input_tokens\"]\n134\t\tw.outputTokens += norm[\"output_tokens\"]\n135\t\tw.cacheRead += norm[\"cache_read_input_tokens\"]\n136\t\tw.cacheCreate += norm[\"cache_creation_input_tokens\"]\n137\t}\n138\t\n139\t// DefaultTraceDir returns the trace storage directory next to the executable.\n140\t// e.g. executable at \"C:\\tools\\claude-tap-plus.exe\" → \"C:\\tools\\.traces\"\n141\tfunc DefaultTraceDir() string {\n142\t\texe, err := os.Executable()\n143\t\tif err != nil {\n144\t\t\treturn \".traces\"\n145\t\t}\n146\t\treturn filepath.Join(filepath.Dir(exe), \".traces\")\n147\t}\n148\t\n149\t// DetectProjectName returns the project name for the current working directory.\n150\t// Priority: git remote repo name → cwd basename.\n151\tfunc DetectProjectName() string {\n152\t\tcwd, _ := os.Getwd()\n153\t\t// Try git remote origin URL first.\n154\t\tif cwd != \"\" {\n155\t\t\trepo := gitRemoteRepoName(cwd)\n156\t\t\tif repo != \"\" {\n157\t\t\t\treturn repo\n158\t\t\t}\n159\t\t}\n160\t\t// Fallback to cwd basename.\n161\t\tproject := filepath.Base(cwd)\n162\t\tif project == \"\" || project == \".\" {\n163\t\t\tproject = \"default\"\n164\t\t}\n165\t\treturn project\n166\t}\n167\t\n168\t// NewTracePath returns a trace file path under baseDir/{project}/:\n169\t// baseDir/{project}/{date}_{time}_{shortID}.jsonl\n170\t// project is derived from git remote or cwd basename.\n171\t// shortID is 6 random hex chars for uniqueness (cloud-sync friendly).\n172\tfunc NewTracePath(baseDir string) string {\n173\t\tproject := DetectProjectName()\n174\t\n175\t\tnow := time.Now()\n176\t\tdateTime := now.Format(\"2006-01-02_150405\")\n177\t\tshortID := randomHex(3) // 3 bytes = 6 hex chars\n178\t\tfilename := fmt.Sprintf(\"%s_%s.jsonl\", dateTime, shortID)\n179\t\n180\t\treturn filepath.Join(baseDir, project, filename)\n181\t}\n182\t\n183\t// gitRemoteRepoName extracts the repo name from git remote origin URL.\n184\t// e.g. \"https://github.com/user/my-project.git\" → \"my-project\"\n185\tfunc gitRemoteRepoName(dir string) string {\n186\t\t// Try reading .git/config directly to avoid shell dependency.\n187\t\tconfigPath := filepath.Join(dir, \".git\", \"config\")\n188\t\tdata, err := os.ReadFile(configPath)\n189\t\tif err != nil {\n190\t\t\treturn \"\"\n191\t\t}\n192\t\tcontent := string(data)\n193\t\t// Find [remote \"origin\"] section and extract URL.\n194\t\tlines := strings.Split(content, \"\\n\")\n195\t\tinOrigin := false\n196\t\tfor _, line := range lines {\n197\t\t\ttrimmed := strings.TrimSpace(line)\n198\t\t\tif trimmed == `[remote \"origin\"]` {\n199\t\t\t\tinOrigin = true\n200\t\t\t\tcontinue\n201\t\t\t}\n202\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"url = \") {\n203\t\t\t\turl := strings.TrimPrefix(trimmed, \"url = \")\n204\t\t\t\t// Extract last segment, strip .git suffix.\n205\t\t\t\tbase := filepath.Base(url)\n206\t\t\t\tbase = strings.TrimSuffix(base, \".git\")\n207\t\t\t\treturn base\n208\t\t\t}\n209\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"[\") {\n210\t\t\t\tbreak // entered next section\n211\t\t\t}\n212\t\t}\n213\t\treturn \"\"\n214\t}\n215\t\n216\t// randomHex returns n random bytes as a hex string (2*n chars).\n217\tfunc randomHex(n int) string {\n218\t\tb := make([]byte, n)\n219\t\t_, _ = rand.Read(b)\n220\t\treturn hex.EncodeToString(b)\n221\t}\n222\t"}]}
