\t}\n40\t\n41\t\t// Look for slug ending with the project name.\n42\t\t// e.g. \"claude-tap\" matches \"D--development-code-claude-tap\"\n43\t\tsuffix := \"-\" + projectName\n44\t\tfor _, entry := range entries {\n45\t\t\tname := entry.Name()\n46\t\t\tif name == projectName || strings.HasSuffix(name, suffix) {\n47\t\t\t\treturn name, true\n48\t\t\t}\n49\t\t}\n50\t\treturn \"\", false\n51\t}\n52\t\n53\t// CwdToClaudeKey converts an absolute path to the key format used in .claude.json.\n54\t// Claude Code uses forward slashes: \"D:/development/code/claude-tap\"\n55\tfunc CwdToClaudeKey(absPath string) string {\n56\t\treturn strings.ReplaceAll(absPath, `\\`, \"/\")\n57\t}\n58\t"}]}
