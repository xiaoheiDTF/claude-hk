  [ -z \"$repo\" ] && return 0\n\n  _call_backend \"/api/issue/status\" \"{\n    \\\"repo_full_name\\\":\\\"$repo\\\",\n    \\\"issue_number\\\":$issue_num,\n    \\\"session_id\\\":\\\"$session_id\\\",\n    \\\"status\\\":\\\"$new_status\\\"\n  }\" > /dev/null 2>&1\n}\n","numLines":66,"startLine":1,"totalLines":66}},"tool_use_id":"call_810d9dfb7d8b4fde87acc7a2","duration_ms":3}
