issue close \"$issue_num\" 2>/dev/null\n117\t}\n118\t\n119\t# 更新后端状态 + 同步 GitHub label（双写）\n120\tupdate_issue_status() {\n121\t  local issue_number=\"$1\"\n122\t  local new_status=\"$2\"\n123\t  _load_backend_url\n124\t  [ -z \"$BACKEND_URL\" ] && return 0\n125\t\n126\t  local session_id\n127\t  session_id=$(_get_session_id)\n128\t  local repo\n129\t  repo=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null)\n130\t\n131\t  # 1. 调后端更新状态\n132\t  local result\n133\t  result=$(_call_backend \"/api/issue/status\" \"{\n134\t    \\\"repo_full_name\\\":\\\"$repo\\\",\n135\t    \\\"issue_number\\\":$issue_number,\n136\t    \\\"session_id\\\":\\\"$session_id\\\",\n137\t    \\\"status\\\":\\\"$new_status\\\"\n138\t  }\")\n139\t\n140\t  # 2. 从响应中获取 previous_status，同步 GitHub label\n141\t  local old_status\n142\t  old_status=$(echo \"$result\" | jq -r '.previous_status // empty' 2>/dev/null)\n143\t  [ -n \"$old_status\" ] && _sync_github_label \"$issue_number\" \"$old_status\" \"$new_status\"\n144\t}\n145\t```\n146\t\n147\t### 变量\n148\t\n149\t| 变量 | 类型 | 说明 |\n150\t|------|------|------|\n151\t| `BACKEND_URL` | 全局缓存 | 首次调用 `_load_backend_url` 后填充，后续复用 |\n152\t\n153\t### 依赖\n154\t\n155\t- `curl` 命令可用\n156\t- `json_get` 函数或 `jq` 可用（用于 `_get_session_id`）\n157\t- `.claude/backend.conf` 文件（可选，不存在时所有后端调用静默跳过）\n158\t\n159\t## 2. `/health` 健康检查端点\n160\t\n161\t**端点**: `GET /health`\n162\t\n163\t### 响应\n164\t\n165\t```json\n166\t{\"status\": \"ok\", \"uptime\": 3600}\n167\t```\n168\t\n169\t| 字段 | 类型 | 说明 |\n170\t|------|------|------|\n171\t| status | string | 固定 `\"ok\"` |\n172\t| uptime | int | 服务运行秒数（可选） |\n173\t\n174\t### 用途\n175\t\n176\t`_backend_available()` 调用此端点判断后端是否可用。2 秒内无响应视为不可用。\n177\t\n178\t### 验收标准\n179\t\n180\t- [ ] 后端运行时返回 `{\"status\": \"ok\"}`\n181\t- [ ] 后端未启动时 curl 超时（连接失败）\n182\t\n183\t## 3. 后端服务启动命令\n184\t\n185\t后端服务作为 `claude-tap-plus` 的子命令运行，与代理进程独立：\n186\t\n187\t```bash\n188\t# 启动后端（默认端口 8080）\n189\tclaude-tap-plus backend\n190\t\n191\t# 指定端口和数据库