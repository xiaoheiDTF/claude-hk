 0)\n147\t\tif err != nil {\n148\t\t\tt.Fatalf(\"start proxy: %v\", err)\n149\t\t}\n150\t\tdefer rp.Stop()\n151\t\n152\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n153\t\n154\t\t// Send 3 requests.\n155\t\tfor i := 0; i < 3; i++ {\n156\t\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n157\t\t\ttestutil.AssertResponseStatus(t, resp, 200)\n158\t\t\tio.ReadAll(resp.Body)\n159\t\t\tresp.Body.Close()\n160\t\t}\n161\t\n162\t\t// Verify trace has 3 records with incrementing turn numbers.\n163\t\twriter.Close()\n164\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n165\t\tif len(records) != 3 {\n166\t\t\tt.Fatalf(\"expected 3 trace records, got %d\", len(records))\n167\t\t}\n168\t\n169\t\tfor i, rec := range records {\n170\t\t\tturn, _ := rec[\"turn\"].(float64)\n171\t\t\tif int(turn) != i+1 {\n172\t\t\t\tt.Errorf(\"record %d: turn = %v, want %d\", i, turn, i+1)\n173\t\t\t}\n174\t\t\t// All should have same session_id.\n175\t\t\tsid, _ := rec[\"session_id\"].(string)\n176\t\t\tif sid != \"test-session-001\" {\n177\t\t\t\tt.Errorf(\"record %d: session_id = %q, want test-session-001\", i, sid)\n178\t\t\t}\n179\t\t}\n180\t}\n181\t\n182\t// TestSessionIDExtraction tests that session_id is correctly extracted from metadata.user_id.\n183\tfunc TestSessionIDExtraction(t *testing.T) {\n184\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n185\t\tmockServer := testutil.CreateMockServer(t, fx)\n186\t\tdefer mockServer.Close()\n187\t\n188\t\ttracePath := testutil.TempTraceFile(t)\n189\t\twriter, err := trace.NewTraceWriter(tracePath)\n190\t\tif err != nil {\n191\t\t\tt.Fatalf(\"create writer: %v\", err)\n192\t\t}\n193\t\tdefer writer.Close()\n194\t\n195\t\trp := proxy.NewReverseProxy(mockServer.URL, writer)\n196\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n197\t\tif err != nil {\n198\t\t\tt.Fatalf(\"start proxy: %v\", err)\n199\t\t}\n200\t\tdefer rp.Stop()\n201\t\n202\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n203\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n204\t\tio.ReadAll(resp.Body)\n205\t\tresp.Body.Close()\n206\t\n207\t\twriter.Close()\n208\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n209\t\tif len(records) == 0 {\n210\t\t\tt.Fatal(\"no trace records\")\n211\t\t}\n212\t\n213\t\tsid, _ := records[0][\"session_id\"].(string)\n214\t\tif sid != \"test-session-001\" {\n215\t\t\tt.Errorf(\"session_id: got %q, want %q\", sid, \"test-session-001\")\n216\t\t}\n217\t}\n218\t\n219\t// TestTokenStats verifies that TraceWriter.Summary() accumulates token counts correctly.\n220\tfunc TestTokenStats(t *testing.T) {\n221\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n222\t\tmockServer := testutil.CreateMockServer(t, fx)\n223\t\tdefer mockServer.Close()\n224\t\n225\t\ttracePath := testutil.TempTraceFile(t)\n226\t\twriter, err := trace.NewTraceWriter(tracePath)\n227\t\tif err != nil {\n228\t\t\tt.Fatalf(\"create writer: %v\", err)\n229\t\t}\n230\t\tdefer writer.Close()\n231\t\n232\t\trp := proxy.NewReverseProxy(mockServer.URL, writer)\n233\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n234\t\tif err != nil {\n235\t\t\tt.Fatalf(\"start proxy: %v\", err)\n236\t\t}\n237\t\tdefer rp.Stop()\n238\t\n239\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n240\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n241\t\tio.ReadAll(resp.Body)\n242\t\tresp.Body.Close()\n243\t\n244\t\tsummary := writer.Summary()\n245\t\n246\t\tapiCalls, _ := summary[\"api_calls\"].(int)\n247\t\tif apiCalls != 1 {\n248\t\t\tt.Errorf(\"api_calls: got %d, want 1\", apiCalls)\n249\t\t}\n250\t\n251\t\tinputTokens, _ := summary[\"input_tokens\"].(int64)\n252\t\tif inputTokens != 1234 {\n253\t\t\tt.Errorf(\"input_tokens: got %d, want 1234\", inputTokens)\n254\t\t}\n255\t\n256\t\toutputTokens, _ := summary[\"output_tokens\"].(int64)\n257\t\tif outputTokens != 56 {\n258\t\t\tt.Errorf(\"output_tokens: got %d, want 56\", outputTokens)\n259\t\t}\n260\t}\n261\t\n262\t// TestHeaderRedaction verifies that sensitive headers are redacted in trace output.\n263\tfunc TestHeaderRedaction(t *testing.T) {\n264\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n265\t\tmockServer := testutil.CreateMockServer(t, fx)\n266\t\tdefer mockServer.Close()\n267\t\n268\t\ttracePath := testutil.TempTraceFile(t)\n269\t\twriter, err := trace.NewTraceWriter(tracePath)\n270\t\tif err != nil {\n271\t\t\tt.Fatalf(\"create writer: %v\", err)\n272\t\t}\n273\t\tdefer writer.Close()\n274\t\n275\t\trp := proxy.NewReverseProxy(mockServer.URL, writer)\n276\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n277\t\tif err != nil {\n278\t\t\tt.Fatalf(\"start proxy: %v\", err)\n279\t\t}\n280\t\tdefer rp.Stop()\n281\t\n282\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n283\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n284\t\tio.ReadAll(resp.Body)\n285\t\tresp.Body.Close()\n286\t\n287\t\twriter.Close()\n288\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n289\t\tif len(records) == 0 {\n290\t\t\tt.Fatal(\"no trace records\")\n291\t\t}\n292\t\n293\t\treqMap, _ := records[0][\"request\"].(map[string]any)\n294\t\theaders, _ := reqMap[\"headers\"].(map[string]any)\n295\t\n296\t\t// X-Api-Key should be truncated.\n297\t\tif apiKey, ok := headers[\"X-Api-Key\"].(string); ok {\n298\t\t\tif apiKey == \"sk-ant-test-key-12345678\" {\n299\t\t\t\tt.Error(\"X-Api-Key not redacted in trace\")\n300\t\t\t}\n301\t\t}\n302\t\n303\t\t// Authorization should be masked.\n304\t\tif auth, ok := headers[\"Authorization\"].(string); ok {\n305\t\t\tif auth == \"Bearer sk-ant-test-key-12345678\" {\n306\t\t\t\tt.Error(\"Authorization not redacted in trace\")\n307\t\t\t}\n308\t\t}\n309\t}\n310\t\n311\t// TestBlockedPath verifies that non-whitelisted paths are rejected.\n312\tfunc TestBlockedPath(t *testing.T) {\n313\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n314\t\t\tw.WriteHeader(200)\n315\t\t\tw.Write([]byte(\"should not reach\"))\n316\t\t})\n317\t\tmockServer := httptest.NewServer(mockHandler)\n318\t\tdefer mockServer.Close()\n319\t\n320\t\ttracePath := testutil.TempTraceFile(t)\n321\t\twriter, err := trace.NewTraceWriter(tracePath)\n322\t\tif err != nil {\n323\t\t\tt.Fatalf(\"create writer: %v\", err)\n324\t\t}\n325\t\tdefer writer.Close()\n326\t\n327\t\trp := proxy.NewReverseProxy(mockServer.URL, writer)\n328\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n329\t\tif err != nil {\n330\t\t\tt.Fatalf(\"start proxy: %v\", err)\n331\t\t}\n332\t\tdefer rp.Stop()\n333\t\n334\t\t// Request to a blocked path.\n335\t\tresp, err := http.Get(\"http://127.0.0.1:\" + fmt.Sprint(port) + \"/admin/config\")\n336\t\tif err != nil {\n337\t\t\tt.Fatalf(\"send request: %v\", err)\n338\t\t}\n339\t\tdefer resp.Body.Close()\n340\t\n341\t\tif resp.StatusCode != 404 {\n342\t\t\tt.Errorf(\"blocked path status: got %d, want 404\", resp.StatusCode)\n343\t\t}\n344\t\n345\t\t// Trace should be empty (no record written for blocked path).\n346\t\twriter.Close()\n347\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n348\t\tif len(records) != 0 {\n349\t\t\tt.Errorf(\"expected 0 trace records for blocked path, got %d\", len(records))\n350\t\t}\n351\t}\n352\t\n353\t// TestGzipResponse verifies that gzip-compressed responses are correctly decompressed in trace.\n354\tfunc TestGzipResponse(t *testing.T) {\n355\t\tfx := testutil.LoadFixture(t, \"gzip_response.json\")\n356\t\tmockServer := testutil.CreateMockServer(t, fx)\n357\t\tdefer mockServer.Close()\n358\t\n359\t\ttracePath := testutil.TempTraceFile(t)\n360\t\twriter, err := trace.NewTraceWriter(tracePath)\n361\t\tif err != nil {\n362\t\t\tt.Fatalf(\"create writer: %v\", err)\n363\t\t}\n364\t\tdefer writer.Close()\n365\t\n366\t\trp := proxy.NewReverseProxy(mockServer.URL, writer)\n367\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n368\t\tif err != nil {\n369\t\t\tt.Fatalf(\"start proxy: %v\", err)\n370\t\t}\n371\t\tdefer rp.Stop()\n372\t\n373\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n374\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n375\t\ttestutil.AssertResponseStatus(t, resp, 200)\n376\t\n377\t\t// Client receives decompressed response.\n378\t\tbody := testutil.DrainAndClose(t, resp)\n379\t\tvar respBody map[string]any\n380\t\tif err := json.Unmarshal(body, &respBody); err != nil {\n381\t\t\tt.Fatalf(\"parse response (should be decompressed): %v\", err)\n382\t\t}\n383\t\tif respBody[\"type\"] != \"message\" {\n384\t\t\tt.Errorf(\"response type: got %v, want message\", respBody[\"type\"])\n385\t\t}\n386\t\n387\t\t// Trace should have decompressed body.\n388\t\twriter.Close()\n389\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n390\t\tif len(records) == 0 {\n391\t\t\tt.Fatal(\"no trace records\")\n392\t\t}\n393\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n394\t}\n395\t"}]}
