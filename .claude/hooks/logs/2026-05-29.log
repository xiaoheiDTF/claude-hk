pen --json number,title,headRefName 2>/dev/null)\n    if [ -n \"$prs\" ] && [ \"$prs\" != \"[]\" ]; then\n      echo \"$prs\" | jq -r '.[] | \"  PR #\\(.number): \\(.title) (分支: \\(.headRefName))\"'\n    else\n      echo \"(暂无 open PRs)\"\n    fi\n  fi\nfi\n\nskill_log \"INFO\" \"[inject] issue-test context injected for #$ISSUE_NUM\"\n","numLines":48,"startLine":1,"totalLines":48}},"tool_use_id":"call_889ab0b2433e405da3f0fcf5","duration_ms":1}
