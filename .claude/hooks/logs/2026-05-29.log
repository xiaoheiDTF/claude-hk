9\t\tif err != nil {\n110\t\t\treturn nil, fmt.Errorf(\"query state: %w\", err)\n111\t\t}\n112\t\n113\t\t// Idempotent: same session already claimed it.\n114\t\tif curSession.Valid && curSession.String == sessionID {\n115\t\t\tresult := &ClaimResult{Success: true, Status: curStatus}\n116\t\t\tif curClaimedAt.Valid {\n117\t\t\t\tresult.ClaimedAt = &curClaimedAt.String\n118\t\t\t}\n119\t\t\treturn result, nil\n120\t\t}\n121\t\n122\t\t// Already claimed by another session or in terminal state.\n123\t\tresult := &ClaimResult{Success: false, Status: curStatus}\n124\t\tif curSession.Valid {\n125\t\t\tresult.ClaimedBy = &curSession.String\n126\t\t}\n127\t\tif curClaimedAt.Valid {\n128\t\t\tresult.ClaimedAt = &curClaimedAt.String\n129\t\t}\n130\t\treturn result, nil\n131\t}\n132\t\n133\tfunc (s *sqliteIssueStore) UpdateIssueStatus(ctx context.Context, repo string, number int, sessionID string, newStatus string) (*UpdateStatusResult, error) {\n134\t\t// Check current state.\n135\t\tvar curStatus string\n136\t\tvar curOwner sql.NullString\n137\t\terr := s.db.QueryRowContext(ctx,\n138\t\t\t`SELECT status, session_id FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n139\t\t\trepo, number,\n140\t\t).Scan(&curStatus, &curOwner)\n141\t\tif err == sql.ErrNoRows {\n142\t\t\treturn &UpdateStatusResult{Updated: false}, nil\n143\t\t}\n144\t\tif err != nil {\n145\t\t\treturn nil, fmt.Errorf(\"query status: %w\", err)\n146\t\t}\n147\t\n148\t\t// Only the owning session can update status.\n149\t\tif !curOwner.Valid || curOwner.String != sessionID {\n150\t\t\treturn &UpdateStatusResult{PreviousStatus: curStatus, Updated: false}, nil\n151\t\t}\n152\t\n153\t\t// Update.\n154\t\tres, err := s.db.ExecContext(ctx,\n155\t\t\t`UPDATE issue_claims SET status = ?, updated_at = CURRENT_TIMESTAMP\n156\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND session_id = ?`,\n157\t\t\tnewStatus, repo, number, sessionID,\n158\t\t)\n159\t\tif err != nil {\n160\t\t\treturn nil, fmt.Errorf(\"update status: %w\", err)\n161\t\t}\n162\t\tn, _ := res.RowsAffected()\n163\t\treturn &UpdateStatusResult{PreviousStatus: curStatus, NewStatus: newStatus, Updated: n > 0}, nil\n164\t}\n165\t\n166\tfunc (s *sqliteIssueStore) ReleaseIssue(ctx context.Context, repo string, number int, sessionID string) (bool, error) {\n167\t\t// Check current owner.\n168\t\tvar owner sql.NullString\n169\t\terr := s.db.QueryRowContext(ctx,\n170\t\t\t`SELECT session_id FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n171\t\t\trepo, number,\n172\t\t).Scan(&owner)\n173\t\tif err == sql.ErrNoRows {\n174\t\t\treturn false, nil\n175\t\t}\n176\t\tif err != nil {\n177\t\t\treturn false, fmt.Errorf(\"query owner: %w\", err)\n178\t\t}\n179\t\tif !owner.Valid || owner.String != sessionID {\n180\t\t\treturn false, nil\n181\t\t}\n182\t\n183\t\t// Release: only non-terminal statuses.\n184\t\tres, err := s.db.ExecContext(ctx,\n185\t\t\t`UPDATE issue_claims\n186\t\t\t    SET status = 'idle', session_id = NULL, claimed_at = NULL, updated_at = CURRENT_TIMESTAMP\n187\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND session_id = ?\n188\t\t\t    AND status NOT IN ('merged', 'rejected')`,\n189\t\t\trepo, number, sessionID,\n190\t\t)\n191\t\tif err != nil {\n192\t\t\treturn false, fmt.Errorf(\"update: %w\", err)\n193\t\t}\n194\t\tn, _ := res.RowsAffected()\n195\t\treturn n > 0, nil\n196\t}\n197\t\n198\tfunc (s *sqliteIssueStore) ReleaseSessionIssues(ctx context.Context, sessionID string) ([]int, error) {\n199\t\t// Collect issue numbers that will be released.\n200\t\trows, err := s.db.QueryContext(ctx,\n201\t\t\t`SELECT issue_number FROM issue_claims\n202\t\t\t  WHERE session_id = ? AND status NOT IN ('merged', 'rejected')`,\n203\t\t\tsessionID,\n204\t\t)\n205\t\tif err != nil {\n206\t\t\treturn nil, fmt.Errorf(\"query session issues: %w\", err)\n207\t\t}\n208\t\n209\t\tvar numbers []int\n210\t\tfor rows.Next() {\n211\t\t\tvar n int\n212\t\t\tif err := rows.Scan(&n); err != nil {\n213\t\t\t\trows.Close()\n214\t\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n215\t\t\t}\n216\t\t\tnumbers = append(numbers, n)\n217\t\t}\n218\t\trows.Close()\n219\t\n220\t\tif len(numbers) == 0 {\n221\t\t\treturn nil, nil\n222\t\t}\n223\t\n224\t\t// Batch update.\n225\t\t_, err = s.db.ExecContext(ctx,\n226\t\t\t`UPDATE issue_claims\n227\t\t\t    SET status = 'idle', session_id = NULL, claimed_at = NULL, updated_at = CURRENT_TIMESTAMP\n228\t\t\t  WHERE session_id = ? AND status NOT IN ('merged', 'rejected')`,\n229\t\t\tsessionID,\n230\t\t)\n231\t\tif err != nil {\n232\t\t\treturn nil, fmt.Errorf(\"batch release: %w\", err)\n233\t\t}\n234\t\n235\t\treturn numbers, nil\n236\t}\n237\t"}]}
