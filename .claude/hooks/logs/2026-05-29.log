= httptest.NewServer(router)\n55\t\tt.Cleanup(srv.Close)\n56\t\n57\t\treturn &testEnv{srv: srv, store: s}\n58\t}\n59\t\n60\tfunc (e *testEnv) post(t *testing.T, path, body string) *http.Response {\n61\t\tt.Helper()\n62\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n63\t\tif err != nil {\n64\t\t\tt.Fatal(err)\n65\t\t}\n66\t\treturn resp\n67\t}\n68\t\n69\tfunc readJSON(t *testing.T, resp *http.Response, v any) {\n70\t\tt.Helper()\n71\t\tdefer resp.Body.Close()\n72\t\tb, err := io.ReadAll(resp.Body)\n73\t\tif err != nil {\n74\t\t\tt.Fatal(err)\n75\t\t}\n76\t\tif err := json.Unmarshal(b, v); err != nil {\n77\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n78\t\t}\n79\t}\n80\t\n81\tfunc seedIssue(db *sql.DB, repo string, number int, status, sessionID, claimedAt string) {\n82\t\tdb.Exec(\n83\t\t\t`INSERT INTO issue_claims (repo_full_name, issue_number, status, session_id, claimed_at, updated_at)\n84\t\t\t VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)`,\n85\t\t\trepo, number, status,\n86\t\t\tnilIfEmpty(sessionID), nilIfEmpty(claimedAt),\n87\t\t)\n88\t}\n89\t\n90\tfunc nilIfEmpty(s string) any {\n91\t\tif s == \"\" {\n92\t\t\treturn nil\n93\t\t}\n94\t\treturn s\n95\t}\n96\t\n97\t// --- tests ---\n98\t\n99\tfunc TestHealth(t *testing.T) {\n100\t\tenv := setupTest(t)\n101\t\n102\t\tresp, err := http.Get(env.srv.URL + \"/health\")\n103\t\tif err != nil {\n104\t\t\tt.Fatal(err)\n105\t\t}\n106\t\tdefer resp.Body.Close()\n107\t\n108\t\tif resp.StatusCode != http.StatusOK {\n109\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n110\t\t}\n111\t\n112\t\tvar result map[string]string\n113\t\treadJSON(t, resp, &result)\n114\t\tif result[\"status\"] != \"ok\" {\n115\t\t\tt.Errorf(\"expected status=ok, got %s\", result[\"status\"])\n116\t\t}\n117\t}\n118\t\n119\tfunc TestCheckIssues_EmptyArray(t *testing.T) {\n120\t\tenv := setupTest(t)\n121\t\n122\t\tresp := env.post(t, \"/api/issue/check\",\n123\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[]}`)\n124\t\n125\t\tvar result struct {\n126\t\t\tIssues []any `json:\"issues\"`\n127\t\t}\n128\t\treadJSON(t, resp, &result)\n129\t\n130\t\tif resp.StatusCode != http.StatusOK {\n131\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n132\t\t}\n133\t\tif len(result.Issues) != 0 {\n134\t\t\tt.Fatalf(\"expected empty issues, got %d\", len(result.Issues))\n135\t\t}\n136\t}\n137\t\n138\tfunc TestCheckIssues_NewIssuesAutoCreatedAsIdle(t *testing.T) {\n139\t\tenv := setupTest(t)\n140\t\n141\t\tresp := env.post(t, \"/api/issue/check\",\n142\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2,3]}`)\n143\t\n144\t\tvar result struct {\n145\t\t\tIssues []struct {\n146\t\t\t\tNumber    int     `json:\"number\"`\n147\t\t\t\tStatus    string  `json:\"status\"`\n148\t\t\t\tSessionID *string `json:\"session_id\"`\n149\t\t\t\tClaimedAt *string `json:\"claimed_at\"`\n150\t\t\t} `json:\"issues\"`\n151\t\t}\n152\t\treadJSON(t, resp, &result)\n153\t\n154\t\tif resp.StatusCode != http.StatusOK {\n155\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n156\t\t}\n157\t\tif len(result.Issues) != 3 {\n158\t\t\tt.Fatalf(\"expected 3 issues, got %d\", len(result.Issues))\n159\t\t}\n160\t\n161\t\tfor _, issue := range result.Issues {\n162\t\t\tif issue.Status != \"idle\" {\n163\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", issue.Number, issue.Status)\n164\t\t\t}\n165\t\t\tif issue.SessionID != nil {\n166\t\t\t\tt.Errorf(\"issue %d: expected null session_id, got %v\", issue.Number, *issue.SessionID)\n167\t\t\t}\n168\t\t\tif issue.ClaimedAt != nil {\n169\t\t\t\tt.Errorf(\"issue %d: expected null claimed_at, got %v\", issue.Number, *issue.ClaimedAt)\n170\t\t\t}\n171\t\t}\n172\t}\n173\t\n174\tfunc TestCheckIssues_ClaimedAndMerged(t *testing.T) {\n175\t\tenv := setupTest(t)\n176\t\tdb := env.store.DB()\n177\t\n178\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n179\t\tseedIssue(db, \"test/repo\", 11, \"merged\", \"\", \"\")\n180\t\n181\t\tresp := env.post(t, \"/api/issue/check\",\n182\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[9,10,11,12]}`)\n183\t\n184\t\tvar result struct {\n185\t\t\tIssues []struct {\n186\t\t\t\tNumber    int     `json:\"number\"`\n187\t\t\t\tStatus    string  `json:\"status\"`\n188\t\t\t\tSessionID *string `json:\"session_id\"`\n189\t\t\t\tClaimedAt *string `json:\"claimed_at\"`\n190\t\t\t} `json:\"issues\"`\n191\t\t}\n192\t\treadJSON(t, resp, &result)\n193\t\n194\t\tif resp.StatusCode != http.StatusOK {\n195\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n196\t\t}\n197\t\tif len(result.Issues) != 4 {\n198\t\t\tt.Fatalf(\"expected 4 issues, got %d\", len(result.Issues))\n199\t\t}\n200\t\n201\t\tbyNumber := map[int]*struct {\n202\t\t\tNumber    int     `json:\"number\"`\n203\t\t\tStatus    string  `json:\"status\"`\n204\t\t\tSessionID *string `json:\"session_id\"`\n205\t\t\tClaimedAt *string `json:\"claimed_at\"`\n206\t\t}{}\n207\t\tfor i := range result.Issues {\n208\t\t\tbyNumber[result.Issues[i].Number] = &result.Issues[i]\n209\t\t}\n210\t\n211\t\t// #9: new → idle\n212\t\tif byNumber[9].Status != \"idle\" {\n213\t\t\tt.Errorf(\"issue 9: expected idle, got %s\", byNumber[9].Status)\n214\t\t}\n215\t\n216\t\t// #10: claimed\n217\t\tif byNumber[10].Status != \"claimed\" {\n218\t\t\tt.Errorf(\"issue 10: expected claimed, got %s\", byNumber[10].Status)\n219\t\t}\n220\t\tif byNumber[10].SessionID == nil || *byNumber[10].SessionID != \"sess_abc\" {\n221\t\t\tt.Errorf(\"issue 10: expected session_id=sess_abc, got %v\", byNumber[10].SessionID)\n222\t\t}\n223\t\tif byNumber[10].ClaimedAt == nil {\n224\t\t\tt.Error(\"issue 10: expected non-nil claimed_at\")\n225\t\t}\n226\t\n227\t\t// #11: merged\n228\t\tif byNumber[11].Status != \"merged\" {\n229\t\t\tt.Errorf(\"issue 11: expected merged, got %s\", byNumber[11].Status)\n230\t\t}\n231\t\tif byNumber[11].SessionID != nil {\n232\t\t\tt.Errorf(\"issue 11: expected null session_id, got %v\", byNumber[11].SessionID)\n233\t\t}\n234\t\n235\t\t// #12: new → idle\n236\t\tif byNumber[12].Status != \"idle\" {\n237\t\t\tt.Errorf(\"issue 12: expected idle, got %s\", byNumber[12].Status)\n238\t\t}\n239\t}\n240\t\n241\tfunc TestCheckIssues_MissingRepoFullName(t *testing.T) {\n242\t\tenv := setupTest(t)\n243\t\n244\t\tresp := env.post(t, \"/api/issue/check\",\n245\t\t\t`{\"issue_numbers\":[1]}`)\n246\t\n247\t\tvar errResp struct {\n248\t\t\tCode    string `json:\"error\"`\n249\t\t\tMessage string `json:\"message\"`\n250\t\t}\n251\t\treadJSON(t, resp, &errResp)\n252\t\n253\t\tif resp.StatusCode != http.StatusBadRequest {\n254\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n255\t\t}\n256\t\tif errResp.Code != \"invalid_request\" {\n257\t\t\tt.Errorf(\"expected error=invalid_request, got %s\", errResp.Code)\n258\t\t}\n259\t}\n260\t\n261\tfunc TestCheckIssues_MissingIssueNumbers(t *testing.T) {\n262\t\tenv := setupTest(t)\n263\t\n264\t\tresp := env.post(t, \"/api/issue/check\",\n265\t\t\t`{\"repo_full_name\":\"test/repo\"}`)\n266\t\n267\t\tvar errResp struct {\n268\t\t\tCode    string `json:\"error\"`\n269\t\t\tMessage string `json:\"message\"`\n270\t\t}\n271\t\treadJSON(t, resp, &errResp)\n272\t\n273\t\tif resp.StatusCode != http.StatusBadRequest {\n274\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n275\t\t}\n276\t\tif errResp.Code != \"invalid_request\" {\n277\t\t\tt.Errorf(\"expected error=invalid_request, got %s\", errResp.Code)\n278\t\t}\n279\t}\n280\t\n281\tfunc TestCheckIssues_InvalidJSON(t *testing.T) {\n282\t\tenv := setupTest(t)\n283\t\n284\t\tresp := env.post(t, \"/api/issue/check\", `not json`)\n285\t\n286\t\tvar errResp struct {\n287\t\t\tCode    string `json:\"error\"`\n288\t\t\tMessage string `json:\"message\"`\n289\t\t}\n290\t\treadJSON(t, resp, &errResp)\n291\t\n292\t\tif resp.StatusCode != http.StatusBadRequest {\n293\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n294\t\t}\n295\t\tif errResp.Code != \"invalid_request\" {\n296\t\t\tt.Errorf(\"expected error=invalid_request, got %s\", errResp.Code)\n297\t\t}\n298\t}\n299\t\n300\tfunc TestCheckIssues_MethodNotAllowed(t *testing.T) {\n301\t\tenv := setupTest(t)\n302\t\n303\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/check\")\n304\t\tif err != nil {\n305\t\t\tt.Fatal(err)\n306\t\t}\n307\t\n308\t\tvar errResp struct {\n309\t\t\tCode    string `json:\"error\"`\n310\t\t\tMessage string `json:\"message\"`\n311\t\t}\n312\t\treadJSON(t, resp, &errResp)\n313\t\n314\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n315\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n316\t\t}\n317\t\tif errResp.Code != \"method_not_allowed\" {\n318\t\t\tt.Errorf(\"expected error=method_not_allowed, got %s\", errResp.Code)\n319\t\t}\n320\t}\n321\t\n322\tfunc TestCheckIssues_IdempotentOnRepeatedCalls(t *testing.T) {\n323\t\tenv := setupTest(t)\n324\t\n325\t\t// First call creates idle records\n326\t\tenv.post(t, \"/api/issue/check\",\n327\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2]}`)\n328\t\n329\t\t// Second call should return the same idle records\n330\t\tresp := env.post(t, \"/api/issue/check\",\n331\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2]}`)\n332\t\n333\t\tvar result struct {\n334\t\t\tIssues []struct {\n335\t\t\t\tNumber int    `json:\"number\"`\n336\t\t\t\tStatus string `json:\"status\"`\n337\t\t\t} `json:\"issues\"`\n338\t\t}\n339\t\treadJSON(t, resp, &result)\n340\t\n341\t\tif resp.StatusCode != http.StatusOK {\n342\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n343\t\t}\n344\t\tif len(result.Issues) != 2 {\n345\t\t\tt.Fatalf(\"expected 2 issues, got %d\", len(result.Issues))\n346\t\t}\n347\t\tfor _, issue := range result.Issues {\n348\t\t\tif issue.Status != \"idle\" {\n349\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", issue.Number, issue.Status)\n350\t\t\t}\n351\t\t}\n352\t}\n353\t\n354\t// --- Release Issue tests ---\n355\t// POST /api/issue/release — 单个 issue 释放\n356\t// 验收标准：\n357\t//   - 领取者可释放自己的 issue\n358\t//   - 非领取者无法释放（返回 not_owner）\n359\t//   - merged/rejected 终态不被释放\n360\t//   - 参数缺失时返回错误\n361\t\n362\tfunc TestReleaseIssue(t *testing.T) {\n363\t\tt.Run(\"owner_can_release\", func(t *testing.T) {\n364\t\t\t// 验收：领取者可释放自己的 issue\n365\t\t\t// 预置 #10 为 claimed（sess_abc 领取），用 sess_abc 调 release → success=true\n366\t\t\t// 释放后再 check 验证 #10 回到 idle、session_id=null\n367\t\t\tenv := setupTest(t)\n368\t\t\tdb := env.store.DB()\n369\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n370\t\n371\t\t\tresp := env.post(t, \"/api/issue/release\",\n372\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n373\t\n374\t\t\tvar result struct {\n375\t\t\t\tSuccess  bool  `json:\"success\"`\n376\t\t\t\tReleased *bool `json:\"released\"`\n377\t\t\t\tError    string `json:\"error\"`\n378\t\t\t}\n379\t\t\treadJSON(t, resp, &result)\n380\t\n381\t\t\tif resp.StatusCode != http.StatusOK {\n382\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n383\t\t\t}\n384\t\t\tif !result.Success {\n385\t\t\t\tt.Fatalf(\"expected success=true, got false (error: %s)\", result.Error)\n386\t\t\t}\n387\t\t\tif result.Released == nil || !*result.Released {\n388\t\t\t\tt.Fatal(\"expected released=true\")\n389\t\t\t}\n390\t\n391\t\t\t// 验证 issue 状态已回到 idle\n392\t\t\tcheckResp := env.post(t, \"/api/issue/check\",\n393\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[10]}`)\n394\t\t\tvar check struct {\n395\t\t\t\tIssues []struct {\n396\t\t\t\t\tStatus    string  `json:\"status\"`\n397\t\t\t\t\tSessionID *string `json:\"session_id\"`\n398\t\t\t\t} `json:\"issues\"`\n399\t\t\t}\n400\t\t\treadJSON(t, checkResp, &check)\n401\t\t\tif len(check.Issues) != 1 {\n402\t\t\t\tt.Fatalf(\"expected 1 issue, got %d\", len(check.Issues))\n403\t\t\t}\n404\t\t\tif check.Issues[0].Status != \"idle\" {\n405\t\t\t\tt.Errorf(\"expected idle after release, got %s\", check.Issues[0].Status)\n406\t\t\t}\n407\t\t\tif check.Issues[0].SessionID != nil {\n408\t\t\t\tt.Error(\"session_id should be null after release\")\n409\t\t\t}\n410\t\t})\n411\t\n412\t\tt.Run(\"non_owner_cannot_release\", func(t *testing.T) {\n413\t\t\t// 验收：非领取者无法释放（返回 not_owner）\n414\t\t\t// 预置 #10 为 claimed（sess_abc 领取），用 sess_other 调 release → success=false, error=not_owner\n415\t\t\tenv := setupTest(t)\n416\t\t\tdb := env.store.DB()\n417\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n418\t\n419\t\t\tresp := env.post(t, \"/api/issue/release\",\n420\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\"}`)\n421\t\n422\t\t\tvar result struct {\n423\t\t\t\tSuccess bool   `json:\"success\"`\n424\t\t\t\tError   string `json:\"error\"`\n425\t\t\t}\n426\t\t\treadJSON(t, resp, &result)\n427\t\n428\t\t\tif resp.StatusCode != http.StatusOK {\n429\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n430\t\t\t}\n431\t\t\tif result.Success {\n432\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n433\t\t\t}\n434\t\t\tif result.Error != \"not_owner\" {\n435\t\t\t\tt.Fatalf(\"expected error=not_owner, got %s\", result.Error)\n436\t\t\t}\n437\t\t})\n438\t\n439\t\tt.Run(\"terminal_merged_not_released\", func(t *testing.T) {\n440\t\t\t// 验收：merged 状态的 issue 不被释放\n441\t\t\t// 预置 #10 为 merged（sess_abc 领取），用 sess_abc 调 release → success=false\n442\t\t\t// 即使是领取者本人，终态也不可释放\n443\t\t\tenv := setupTest(t)\n444\t\t\tdb := env.store.DB()\n445\t\t\tseedIssue(db, \"test/repo\", 10, \"merged\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n446\t\n447\t\t\tresp := env.post(t, \"/api/issue/release\",\n448\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n449\t\n450\t\t\tvar result struct {\n451\t\t\t\tSuccess bool `json:\"success\"`\n452\t\t\t}\n453\t\t\treadJSON(t, resp, &result)\n454\t\n455\t\t\tif result.Success {\n456\t\t\t\tt.Fatal(\"merged issue should not be released\")\n457\t\t\t}\n458\t\t})\n459\t\n460\t\tt.Run(\"terminal_rejected_not_released\", func(t *testing.T) {\n461\t\t\t// 验收：rejected 状态的 issue 不被释放\n462\t\t\t// 预置 #10 为 rejected（sess_abc 领取），用 sess_abc 调 release → success=false\n463\t\t\tenv := setupTest(t)\n464\t\t\tdb := env.store.DB()\n465\t\t\tseedIssue(db, \"test/repo\", 10, \"rejected\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n466\t\n467\t\t\tresp := env.post(t, \"/api/issue/release\",\n468\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n469\t\n470\t\t\tvar result struct {\n471\t\t\t\tSuccess bool `json:\"success\"`\n472\t\t\t}\n473\t\t\treadJSON(t, resp, &result)\n474\t\n475\t\t\tif result.Success {\n476\t\t\t\tt.Fatal(\"rejected issue should not be released\")\n477\t\t\t}\n478\t\t})\n479\t\n480\t\tt.Run(\"non_terminal_statuses_releasable\", func(t *testing.T) {\n481\t\t\t// 补充：非终态（claimed/fixing/ready-for-pr/pr-created/testing/reviewing）都可释放\n482\t\t\t// 预置 #10 为 fixing（sess_abc），释放后验证回到 idle\n483\t\t\tenv := setupTest(t)\n484\t\t\tdb := env.store.DB()\n485\t\t\tseedIssue(db, \"test/repo\", 10, \"fixing\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n486\t\n487\t\t\tresp := env.post(t, \"/api/issue/release\",\n488\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n489\t\n490\t\t\tvar result struct {\n491\t\t\t\tSuccess  bool  `json:\"success\"`\n492\t\t\t\tReleased *bool `json:\"released\"`\n493\t\t\t}\n494\t\t\treadJSON(t, resp, &result)\n495\t\n496\t\t\tif !result.Success {\n497\t\t\t\tt.Fatal(\"fixing status should be releasable by owner\")\n498\t\t\t}\n499\t\t\tif result.Released == nil || !*result.Released {\n500\t\t\t\tt.Fatal(\"expected released=true\")\n501\t\t\t}\n502\t\t})\n503\t\n504\t\tt.Run(\"nonexistent_issue_returns_not_owner\", func(t *testing.T) {\n505\t\t\t// 补充：issue 不存在时返回 success=false（无记录可释放）\n506\t\t\tenv := setupTest(t)\n507\t\n508\t\t\tresp := env.post(t, \"/api/issue/release\",\n509\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":999,\"session_id\":\"sess_abc\"}`)\n510\t\n511\t\t\tvar result struct {\n512\t\t\t\tSuccess bool `json:\"success\"`\n513\t\t\t}\n514\t\t\treadJSON(t, resp, &result)\n515\t\n516\t\t\tif result.Success {\n517\t\t\t\tt.Fatal(\"nonexistent issue should not be released\")\n518\t\t\t}\n519\t\t})\n520\t\n521\t\tt.Run(\"missing_params_returns_400\", func(t *testing.T) {\n522\t\t\t// 验收：参数缺失时返回错误响应\n523\t\t\t// 缺少 session_id → 400\n524\t\t\tenv := setupTest(t)\n525\t\n526\t\t\tresp := env.post(t, \"/api/issue/release\",\n527\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10}`)\n528\t\n529\t\t\tif resp.StatusCode != http.StatusBadRequest {\n530\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n531\t\t\t}\n532\t\t})\n533\t}\n534\t\n535\t// --- Release Session tests ---\n536\t// POST /api/issue/release-session — 按 session 批量释放\n537\t// 验收标准：\n538\t//   - 释放该 session 所有未终态的 issue\n539\t//   - 已合并/打回的 issue 不受影响\n540\t//   - 无领取记录的 session 返回空列表\n541\t\n542\tfunc TestReleaseSession(t *testing.T) {\n543\t\tt.Run(\"releases_all_non_terminal\", func(t *testing.T) {\n544\t\t\t// 验收：释放该 session 所有未终态的 issue\n545\t\t\t// 验收：已合并/打回的 issue 不受影响\n546\t\t\t// 预置 sess_abc 领取 3 个 issue：\n547\t\t\t//   #10 claimed（非终态，应释放）\n548\t\t\t//   #11 fixing（非终态，应释放）\n549\t\t\t//   #12 merged（终态，不应释放）\n550\t\t\t// 调 release-session → released=[10,11], count=2\n551\t\t\t// 再 check 验证 #10/#11 回到 idle，#12 仍为 merged\n552\t\t\tenv := setupTest(t)\n553\t\t\tdb := env.store.DB()\n554\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n555\t\t\tseedIssue(db, \"test/repo\", 11, \"fixing\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n556\t\t\tseedIssue(db, \"test/repo\", 12, \"merged\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n557\t\n558\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n559\t\t\t\t`{\"session_id\":\"sess_abc\"}`)\n560\t\n561\t\t\tvar result struct {\n562\t\t\t\tReleased []int `json:\"released\"`\n563\t\t\t\tCount    int   `json:\"count\"`\n564\t\t\t}\n565\t\t\treadJSON(t, resp, &result)\n566\t\n567\t\t\tif resp.StatusCode != http.StatusOK {\n568\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n569\t\t\t}\n570\t\t\tif result.Count != 2 {\n571\t\t\t\tt.Fatalf(\"expected 2 released, got %d\", result.Count)\n572\t\t\t}\n573\t\n574\t\t\treleasedSet := map[int]bool{}\n575\t\t\tfor _, n := range result.Released {\n576\t\t\t\treleasedSet[n] = true\n577\t\t\t}\n578\t\t\tif !releasedSet[10] || !releasedSet[11] {\n579\t\t\t\tt.Fatalf(\"expected issues 10 and 11 in released, got %v\", result.Released)\n580\t\t\t}\n581\t\n582\t\t\t// 验证 #12（merged）不受影响\n583\t\t\tcheckResp := env.post(t, \"/api/issue/check\",\n584\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[10,11,12]}`)\n585\t\t\tvar check struct {\n586\t\t\t\tIssues []struct {\n587\t\t\t\t\tNumber int    `json:\"number\"`\n588\t\t\t\t\tStatus string `json:\"status\"`\n589\t\t\t\t} `json:\"issues\"`\n590\t\t\t}\n591\t\t\treadJSON(t, checkResp, &check)\n592\t\n593\t\t\tbyNum := map[int]string{}\n594\t\t\tfor _, iss := range check.Issues {\n595\t\t\t\tbyNum[iss.Number] = iss.Status\n596\t\t\t}\n597\t\t\tif byNum[10] != \"idle\" || byNum[11] != \"idle\" {\n598\t\t\t\tt.Fatalf(\"expected 10,11 idle after release, got %v\", byNum)\n599\t\t\t}\n600\t\t\tif byNum[12] != \"merged\" {\n601\t\t\t\tt.Fatalf(\"expected 12 still merged, got %s\", byNum[12])\n602\t\t\t}\n603\t\t})\n604\t\n605\t\tt.Run(\"rejected_not_released\", func(t *testing.T) {\n606\t\t\t// 验收：已打回的 issue 不受影响\n607\t\t\t// 预置 sess_abc 领取 #10（rejected），调 release-session → count=0\n608\t\t\tenv := setupTest(t)\n609\t\t\tdb := env.store.DB()\n610\t\t\tseedIssue(db, \"test/repo\", 10, \"rejected\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n611\t\n612\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n613\t\t\t\t`{\"session_id\":\"sess_abc\"}`)\n614\t\n615\t\t\tvar result struct {\n616\t\t\t\tCount int `json:\"count\"`\n617\t\t\t}\n618\t\t\treadJSON(t, resp, &result)\n619\t\n620\t\t\tif result.Count != 0 {\n621\t\t\t\tt.Fatalf(\"rejected should not be released, got count=%d\", result.Count)\n622\t\t\t}\n623\t\t})\n624\t\n625\t\tt.Run(\"no_claims_returns_empty\", func(t *testing.T) {\n626\t\t\t// 验收：无领取记录的 session 返回空列表\n627\t\t\t// 无任何预置数据，调 release-session → released=[], count=0\n628\t\t\tenv := setupTest(t)\n629\t\n630\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n631\t\t\t\t`{\"session_id\":\"sess_none\"}`)\n632\t\n633\t\t\tvar result struct {\n634\t\t\t\tReleased []int `json:\"released\"`\n635\t\t\t\tCount    int   `json:\"count\"`\n636\t\t\t}\n637\t\t\treadJSON(t, resp, &result)\n638\t\n639\t\t\tif resp.StatusCode != http.StatusOK {\n640\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n641\t\t\t}\n642\t\t\tif result.Count != 0 {\n643\t\t\t\tt.Errorf(\"expected 0 released, got %d\", result.Count)\n644\t\t\t}\n645\t\t\tif len(result.Released) != 0 {\n646\t\t\t\tt.Errorf(\"expected empty released array, got %v\", result.Released)\n647\t\t\t}\n648\t\t})\n649\t\n650\t\tt.Run(\"only_releases_own_session\", func(t *testing.T) {\n651\t\t\t// 补充：只释放目标 session 的 issue，不影响其他 session\n652\t\t\t// 预置 #10（sess_abc claimed）和 #11（sess_other claimed）\n653\t\t\t// 调 release-session(sess_abc) → 只释放 #10，#11 不受影响\n654\t\t\tenv := setupTest(t)\n655\t\t\tdb := env.store.DB()\n656\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n657\t\t\tseedIssue(db, \"test/repo\", 11, \"claimed\", \"sess_other\", \"2026-05-26T10:00:00Z\")\n658\t\n659\t\t\tresp := env.post(t, \"/api/issue/release-session\",\n660\t\t\t\t`{\"session_id\":\"sess_abc\"}`)\n661\t\n662\t\t\tvar result struct {\n663\t\t\t\tReleased []int `json:\"released\"`\n664\t\t\t\tCount    int   `json:\"count\"`\n665\t\t\t}\n666\t\t\treadJSON(t, resp, &result)\n667\t\n668\t\t\tif result.Count != 1 {\n669\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n670\t\t\t}\n671\t\t\tif len(result.Released) != 1 || result.Released[0] != 10 {\n672\t\t\t\tt.Fatalf(\"expected [10], got %v\", result.Released)\n673\t\t\t}\n674\t\n675\t\t\t// 验证 #11 仍为 claimed（sess_other 的）\n676\t\t\tcheckResp := env.post(t, \"/api/issue/check\",\n677\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[11]}`)\n678\t\t\tvar check struct {\n679\t\t\t\tIssues []struct {\n680\t\t\t\t\tStatus    string  `json:\"status\"`\n681\t\t\t\t\tSessionID *string `json:\"session_id\"`\n682\t\t\t\t} `json:\"issues\"`\n683\t\t\t}\n684\t\t\treadJSON(t, checkResp, &check)\n685\t\t\tif len(check.Issues) != 1 {\n686\t\t\t\tt.Fatalf(\"expected 1 issue, got %d\", len(check.Issues))\n687\t\t\t}\n688\t\t\tif check.Issues[0].Status != \"claimed\" {\n689\t\t\t\tt.Errorf(\"expected #11 still claimed, got %s\", check.Issues[0].Status)\n690\t\t\t}\n691\t\t\tif check.Issues[0].SessionID == nil || *check.Issues[0].SessionID != \"sess_other\" {\n692\t\t\t\tt.Error(\"expected #11 still owned by sess_other\")\n693\t\t\t}\n694\t\t})\n695\t\n696\t\tt.Run(\"missing_session_id_returns_400\", func(t *testing.T) {\n697\t\t\t// 验收：参数缺失时返回错误响应\n698\t\t\t// 缺少 session_id → 400\n699\t\t\tenv := setupTest(t)\n700\t\n701\t\t\tresp := env.post(t, \"/api/issue/release-session\", `{}`)\n702\t\n703\t\t\tif resp.StatusCode != http.StatusBadRequest {\n704\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n705\t\t\t}\n706\t\t})\n707\t}\n708\t\n709\t// --- D2: Issue Status Update tests ---\n710\t// POST /api/issue/status — 更新 issue 状态（D2-D6 使用）\n711\t// 验收标准：\n712\t//   - 领取者可将 issue 状态从 claimed 更新为 fixing\n713\t//   - 非 owner session 无法更新状态\n714\t//   - 不存在的 issue 返回 not_found\n715\t//   - 参数缺失时返回 400\n716\t//   - 同一状态幂等更新返回成功\n717\t//   - 完整流程：claim → fixing 验证状态正确流转\n718\t\n719\tfunc TestUpdateStatus(t *testing.T) {\n720\t\tt.Run(\"owner_can_update_to_fixing\", func(t *testing.T) {\n721\t\t\tenv := setupTest(t)\n722\t\t\tdb := env.store.DB()\n723\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n724\t\n725\t\t\tresp := env.post(t, \"/api/issue/status\",\n726\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n727\t\n728\t\t\tvar result struct {\n729\t\t\t\tSuccess        bool   `json:\"success\"`\n730\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n731\t\t\t\tNewStatus      string `json:\"new_status\"`\n732\t\t\t\tError          string `json:\"error\"`\n733\t\t\t}\n734\t\t\treadJSON(t, resp, &result)\n735\t\n736\t\t\tif resp.StatusCode != http.StatusOK {\n737\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n738\t\t\t}\n739\t\t\tif !result.Success {\n740\t\t\t\tt.Fatalf(\"expected success=true, got false (error: %s)\", result.Error)\n741\t\t\t}\n742\t\t\tif result.PreviousStatus != \"claimed\" {\n743\t\t\t\tt.Errorf(\"expected previous_status=claimed, got %s\", result.PreviousStatus)\n744\t\t\t}\n745\t\t\tif result.NewStatus != \"fixing\" {\n746\t\t\t\tt.Errorf(\"expected new_status=fixing, got %s\", result.NewStatus)\n747\t\t\t}\n748\t\n749\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n750\t\t\tif statuses[10] != \"fixing\" {\n751\t\t\t\tt.Errorf(\"expected fixing after update, got %s\", statuses[10])\n752\t\t\t}\n753\t\t})\n754\t\n755\t\tt.Run(\"non_owner_cannot_update\", func(t *testing.T) {\n756\t\t\tenv := setupTest(t)\n757\t\t\tdb := env.store.DB()\n758\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n759\t\n760\t\t\tresp := env.post(t, \"/api/issue/status\",\n761\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"fixing\"}`)\n762\t\n763\t\t\tvar result struct {\n764\t\t\t\tSuccess        bool   `json:\"success\"`\n765\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n766\t\t\t\tError          string `json:\"error\"`\n767\t\t\t}\n768\t\t\treadJSON(t, resp, &result)\n769\t\n770\t\t\tif result.Success {\n771\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n772\t\t\t}\n773\t\t\tif result.Error != \"not_owner\" {\n774\t\t\t\tt.Errorf(\"expected error=not_owner, got %s\", result.Error)\n775\t\t\t}\n776\t\n777\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n778\t\t\tif statuses[10] != \"claimed\" {\n779\t\t\t\tt.Errorf(\"expected status unchanged (claimed), got %s\", statuses[10])\n780\t\t\t}\n781\t\t})\n782\t\n783\t\tt.Run(\"nonexistent_issue_returns_not_found\", func(t *testing.T) {\n784\t\t\tenv := setupTest(t)\n785\t\n786\t\t\tresp := env.post(t, \"/api/issue/status\",\n787\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":999,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n788\t\n789\t\t\tvar result struct {\n790\t\t\t\tSuccess bool   `json:\"success\"`\n791\t\t\t\tError   string `json:\"error\"`\n792\t\t\t}\n793\t\t\treadJSON(t, resp, &result)\n794\t\n795\t\t\tif result.Success {\n796\t\t\t\tt.Fatal(\"expected success=false for nonexistent issue\")\n797\t\t\t}\n798\t\t\tif result.Error != \"not_found\" {\n799\t\t\t\tt.Errorf(\"expected error=not_found, got %s\", result.Error)\n800\t\t\t}\n801\t\t})\n802\t\n803\t\tt.Run(\"missing_params_returns_400\", func(t *testing.T) {\n804\t\t\tenv := setupTest(t)\n805\t\n806\t\t\tresp := env.post(t, \"/api/issue/status\",\n807\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n808\t\t\tif resp.StatusCode != http.StatusBadRequest {\n809\t\t\t\tt.Fatalf(\"expected 400 missing status, got %d\", resp.StatusCode)\n810\t\t\t}\n811\t\n812\t\t\tresp = env.post(t, \"/api/issue/status\",\n813\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"status\":\"fixing\"}`)\n814\t\t\tif resp.StatusCode != http.StatusBadRequest {\n815\t\t\t\tt.Fatalf(\"expected 400 missing session_id, got %d\", resp.StatusCode)\n816\t\t\t}\n817\t\n818\t\t\tresp = env.post(t, \"/api/issue/status\",\n819\t\t\t\t`{\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n820\t\t\tif resp.StatusCode != http.StatusBadRequest {\n821\t\t\t\tt.Fatalf(\"expected 400 missing repo, got %d\", resp.StatusCode)\n822\t\t\t}\n823\t\t})\n824\t\n825\t\tt.Run(\"idempotent_same_status\", func(t *testing.T) {\n826\t\t\tenv := setupTest(t)\n827\t\t\tdb := env.store.DB()\n828\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n829\t\n830\t\t\tresp := env.post(t, \"/api/issue/status\",\n831\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n832\t\t\tvar r1 struct{ Success bool `json:\"success\"` }\n833\t\t\treadJSON(t, resp, &r1)\n834\t\t\tif !r1.Success {\n835\t\t\t\tt.Fatal(\"first update should succeed\")\n836\t\t\t}\n837\t\n838\t\t\tresp = env.post(t, \"/api/issue/status\",\n839\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n840\t\t\tvar r2 struct {\n841\t\t\t\tSuccess   bool   `json:\"success\"`\n842\t\t\t\tNewStatus string `json:\"new_status\"`\n843\t\t\t}\n844\t\t\treadJSON(t, resp, &r2)\n845\t\t\tif !r2.Success {\n846\t\t\t\tt.Fatal(\"idempotent update should succeed\")\n847\t\t\t}\n848\t\t\tif r2.NewStatus != \"fixing\" {\n849\t\t\t\tt.Errorf(\"expected new_status=fixing, got %s\", r2.NewStatus)\n850\t\t\t}\n851\t\t})\n852\t\n853\t\tt.Run(\"full_claim_to_fix_flow\", func(t *testing.T) {\n854\t\t\tenv := setupTest(t)\n855\t\n856\t\t\t// 1. check 创建 idle\n857\t\t\tenv.post(t, \"/api/issue/check\",\n858\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[20]}`)\n859\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{20})\n860\t\t\tif s[20] != \"idle\" {\n861\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[20])\n862\t\t\t}\n863\t\n864\t\t\t// 2. claim\n865\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 20, \"sess_fix\")\n866\t\t\tif code != http.StatusOK || !ok {\n867\t\t\t\tt.Fatalf(\"step 2: claim failed\")\n868\t\t\t}\n869\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{20})\n870\t\t\tif s[20] != \"claimed\" {\n871\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", s[20])\n872\t\t\t}\n873\t\n874\t\t\t// 3. 标记 fixing\n875\t\t\tresp := env.post(t, \"/api/issue/status\",\n876\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":20,\"session_id\":\"sess_fix\",\"status\":\"fixing\"}`)\n877\t\t\tvar r struct {\n878\t\t\t\tSuccess        bool   `json:\"success\"`\n879\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n880\t\t\t\tNewStatus      string `json:\"new_status\"`\n881\t\t\t}\n882\t\t\treadJSON(t, resp, &r)\n883\t\t\tif !r.Success {\n884\t\t\t\tt.Fatal(\"step 3: update to fixing failed\")\n885\t\t\t}\n886\t\t\tif r.PreviousStatus != \"claimed\" {\n887\t\t\t\tt.Errorf(\"step 3: expected previous=claimed, got %s\", r.PreviousStatus)\n888\t\t\t}\n889\t\n890\t\t\t// 4. 验证最终状态\n891\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{20})\n892\t\t\tif s[20] != \"fixing\" {\n893\t\t\t\tt.Fatalf(\"step 4: expected fixing, got %s\", s[20])\n894\t\t\t}\n895\t\t})\n896\t\n897\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n898\t\t\tenv := setupTest(t)\n899\t\n900\t\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/status\")\n901\t\t\tif err != nil {\n902\t\t\t\tt.Fatal(err)\n903\t\t\t}\n904\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n905\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n906\t\t\t}\n907\t\t})\n908\t}\n909\t\n910\t// claimIssue calls the claim API and returns (statusCode, success, claimed_by).\n911\tfunc claimIssue(t *testing.T, env *testEnv, repo string, number int, sessionID string) (int, bool, string) {\n912\t\tt.Helper()\n913\t\n914\t\tbody := fmt.Sprintf(\n915\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n916\t\t\trepo, number, sessionID)\n917\t\tresp := env.post(t, \"/api/issue/claim\", body)\n918\t\n919\t\tvar result struct {\n920\t\t\tSuccess   bool    `json:\"success\"`\n921\t\t\tError     string  `json:\"error\"`\n922\t\t\tClaimedBy *string `json:\"claimed_by\"`\n923\t\t\tStatus    string  `json:\"status\"`\n924\t\t}\n925\t\treadJSON(t, resp, &result)\n926\t\n927\t\tclaimedBy := \"\"\n928\t\tif result.ClaimedBy != nil {\n929\t\t\tclaimedBy = *result.ClaimedBy\n930\t\t}\n931\t\treturn resp.StatusCode, result.Success, claimedBy\n932\t}\n933\t\n934\t// checkStatuses queries the check API and returns a map of issue_number → status.\n935\tfunc checkStatuses(t *testing.T, env *testEnv, repo string, numbers []int) map[int]string {\n936\t\tt.Helper()\n937\t\n938\t\tnums := make([]string, len(numbers))\n939\t\tfor i, n := range numbers {\n940\t\t\tnums[i] = fmt.Sprintf(\"%d\", n)\n941\t\t}\n942\t\n943\t\tbody := `{\"repo_full_name\":\"` + repo + `\",\"issue_numbers\":[` + strings.Join(nums, \",\") + `]}`\n944\t\tresp := env.post(t, \"/api/issue/check\", body)\n945\t\n946\t\tvar result struct {\n947\t\t\tIssues []struct {\n948\t\t\t\tNumber int    `json:\"number\"`\n949\t\t\t\tStatus string `json:\"status\"`\n950\t\t\t} `json:\"issues\"`\n951\t\t}\n952\t\treadJSON(t, resp, &result)\n953\t\n954\t\tm := map[int]string{}\n955\t\tfor _, iss := range result.Issues {\n956\t\t\tm[iss.Number] = iss.Status\n957\t\t}\n958\t\treturn m\n959\t}\n960\t\n961\t// --- D3: Issue Status Update → ready-for-pr tests ---\n962\t// 验收标准：\n963\t//   - fixing → ready-for-pr 状态更新成功\n964\t//   - 非 owner 无法更新\n965\t//   - 完整流程：claimed → fixing → ready-for-pr\n966\t\n967\tfunc TestUpdateStatus_ReadyForPR(t *testing.T) {\n968\t\tt.Run(\"fixing_to_ready_for_pr\", func(t *testing.T) {\n969\t\t\t// D3 验收：fixing 状态可更新为 ready-for-pr\n970\t\t\tenv := setupTest(t)\n971\t\t\tdb := env.store.DB()\n972\t\t\tseedIssue(db, \"test/repo\", 10, \"fixing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n973\t\n974\t\t\tresp := env.post(t, \"/api/issue/status\",\n975\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"ready-for-pr\"}`)\n976\t\n977\t\t\tvar result struct {\n978\t\t\t\tSuccess        bool   `json:\"success\"`\n979\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n980\t\t\t\tNewStatus      string `json:\"new_status\"`\n981\t\t\t}\n982\t\t\treadJSON(t, resp, &result)\n983\t\n984\t\t\tif resp.StatusCode != http.StatusOK {\n985\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n986\t\t\t}\n987\t\t\tif !result.Success {\n988\t\t\t\tt.Fatal(\"expected success=true\")\n989\t\t\t}\n990\t\t\tif result.PreviousStatus != \"fixing\" {\n991\t\t\t\tt.Errorf(\"expected previous=fixing, got %s\", result.PreviousStatus)\n992\t\t\t}\n993\t\t\tif result.NewStatus != \"ready-for-pr\" {\n994\t\t\t\tt.Errorf(\"expected new=ready-for-pr, got %s\", result.NewStatus)\n995\t\t\t}\n996\t\n997\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n998\t\t\tif statuses[10] != \"ready-for-pr\" {\n999\t\t\t\tt.Errorf(\"expected ready-for-pr, got %s\", statuses[10])\n1000\t\t\t}\n1001\t\t})\n1002\t\n1003\t\tt.Run(\"non_owner_cannot_mark_ready\", func(t *testing.T) {\n1004\t\t\tenv := setupTest(t)\n1005\t\t\tdb := env.store.DB()\n1006\t\t\tseedIssue(db, \"test/repo\", 10, \"fixing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1007\t\n1008\t\t\tresp := env.post(t, \"/api/issue/status\",\n1009\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"ready-for-pr\"}`)\n1010\t\n1011\t\t\tvar result struct {\n1012\t\t\t\tSuccess bool   `json:\"success\"`\n1013\t\t\t\tError   string `json:\"error\"`\n1014\t\t\t}\n1015\t\t\treadJSON(t, resp, &result)\n1016\t\n1017\t\t\tif result.Success {\n1018\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1019\t\t\t}\n1020\t\t\tif result.Error != \"not_owner\" {\n1021\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1022\t\t\t}\n1023\t\t})\n1024\t\n1025\t\tt.Run(\"full_claim_fix_done_flow\", func(t *testing.T) {\n1026\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr\n1027\t\t\tenv := setupTest(t)\n1028\t\n1029\t\t\t// 1. idle\n1030\t\t\tenv.post(t, \"/api/issue/check\",\n1031\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[30]}`)\n1032\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{30})\n1033\t\t\tif s[30] != \"idle\" {\n1034\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[30])\n1035\t\t\t}\n1036\t\n1037\t\t\t// 2. claim\n1038\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 30, \"sess_done\")\n1039\t\t\tif code != http.StatusOK || !ok {\n1040\t\t\t\tt.Fatalf(\"step 2: claim failed\")\n1041\t\t\t}\n1042\t\n1043\t\t\t// 3. fixing\n1044\t\t\tenv.post(t, \"/api/issue/status\",\n1045\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":30,\"session_id\":\"sess_done\",\"status\":\"fixing\"}`)\n1046\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{30})\n1047\t\t\tif s[30] != \"fixing\" {\n1048\t\t\t\tt.Fatalf(\"step 3: expected fixing, got %s\", s[30])\n1049\t\t\t}\n1050\t\n1051\t\t\t// 4. ready-for-pr\n1052\t\t\tresp := env.post(t, \"/api/issue/status\",\n1053\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":30,\"session_id\":\"sess_done\",\"status\":\"ready-for-pr\"}`)\n1054\t\t\tvar result struct {\n1055\t\t\t\tSuccess        bool   `json:\"success\"`\n1056\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1057\t\t\t\tNewStatus      string `json:\"new_status\"`\n1058\t\t\t}\n1059\t\t\treadJSON(t, resp, &result)\n1060\t\t\tif !result.Success {\n1061\t\t\t\tt.Fatal(\"step 4: ready-for-pr update failed\")\n1062\t\t\t}\n1063\t\t\tif result.PreviousStatus != \"fixing\" {\n1064\t\t\t\tt.Errorf(\"step 4: expected previous=fixing, got %s\", result.PreviousStatus)\n1065\t\t\t}\n1066\t\n1067\t\t\t// 5. 验证最终状态\n1068\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{30})\n1069\t\t\tif s[30] != \"ready-for-pr\" {\n1070\t\t\t\tt.Fatalf(\"step 5: expected ready-for-pr, got %s\", s[30])\n1071\t\t\t}\n1072\t\t})\n1073\t}\n1074\t\n1075\t// --- D4: Issue Status Update → pr-created tests ---\n1076\t// 验收标准：\n1077\t//   - ready-for-pr → pr-created 状态更新成功\n1078\t//   - 非 owner 无法更新\n1079\t//   - 完整流程：claimed → fixing → ready-for-pr → pr-created\n1080\t\n1081\tfunc TestUpdateStatus_PRCreated(t *testing.T) {\n1082\t\tt.Run(\"ready_for_pr_to_pr_created\", func(t *testing.T) {\n1083\t\t\t// D4 验收：ready-for-pr 状态可更新为 pr-created\n1084\t\t\tenv := setupTest(t)\n1085\t\t\tdb := env.store.DB()\n1086\t\t\tseedIssue(db, \"test/repo\", 10, \"ready-for-pr\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1087\t\n1088\t\t\tresp := env.post(t, \"/api/issue/status\",\n1089\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"pr-created\"}`)\n1090\t\n1091\t\t\tvar result struct {\n1092\t\t\t\tSuccess        bool   `json:\"success\"`\n1093\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1094\t\t\t\tNewStatus      string `json:\"new_status\"`\n1095\t\t\t}\n1096\t\t\treadJSON(t, resp, &result)\n1097\t\n1098\t\t\tif resp.StatusCode != http.StatusOK {\n1099\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n1100\t\t\t}\n1101\t\t\tif !result.Success {\n1102\t\t\t\tt.Fatal(\"expected success=true\")\n1103\t\t\t}\n1104\t\t\tif result.PreviousStatus != \"ready-for-pr\" {\n1105\t\t\t\tt.Errorf(\"expected previous=ready-for-pr, got %s\", result.PreviousStatus)\n1106\t\t\t}\n1107\t\t\tif result.NewStatus != \"pr-created\" {\n1108\t\t\t\tt.Errorf(\"expected new=pr-created, got %s\", result.NewStatus)\n1109\t\t\t}\n1110\t\n1111\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n1112\t\t\tif statuses[10] != \"pr-created\" {\n1113\t\t\t\tt.Errorf(\"expected pr-created, got %s\", statuses[10])\n1114\t\t\t}\n1115\t\t})\n1116\t\n1117\t\tt.Run(\"non_owner_cannot_create_pr_status\", func(t *testing.T) {\n1118\t\t\tenv := setupTest(t)\n1119\t\t\tdb := env.store.DB()\n1120\t\t\tseedIssue(db, \"test/repo\", 10, \"ready-for-pr\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1121\t\n1122\t\t\tresp := env.post(t, \"/api/issue/status\",\n1123\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":