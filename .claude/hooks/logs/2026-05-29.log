[2026-05-29 22:27:23] [INFO] [PostToolBatch] Input: {"session_id":"982b9502-87ae-44d6-bfc3-ef26db9a536e","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\982b9502-87ae-44d6-bfc3-ef26db9a536e.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus","permission_mode":"plan","agent_id":"a713e7f078f256d9d","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\reverse.go"},"tool_use_id":"call_d74181d0093246e58b8334ac","tool_response":"1\tpackage proxy\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"compress/gzip\"\n6\t\t\"compress/zlib\"\n7\t\t\"encoding/json\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"log\"\n11\t\t\"net/http\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\t\"sync/atomic\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n19\t)\n20\t\n21\t// ReverseProxy intercepts HTTP requests, forwards them to an upstream API,\n22\t// records the request/response to a JSONL trace, and handles SSE streaming.\n23\ttype ReverseProxy struct {\n24\t\ttarget    string\n25\t\twriter    *trace.TraceWriter\n26\t\tclient    *http.Client\n27\t\tturn      atomic.Int64\n28\t\tserver    *http.Server\n29\t\tstartOnce sync.Once\n30\t}\n31\t\n32\t// NewReverseProxy creates a proxy that forwards to the given target URL.\n33\tfunc NewReverseProxy(target string, writer *trace.TraceWriter) *ReverseProxy {\n34\t\treturn &ReverseProxy{\n35\t\t\ttarget: strings.TrimRight(target, \"/\"),\n36\t\t\twriter: writer,\n37\t\t\tclient: &http.Client{\n38\t\t\t\tTimeout: 0, // no timeout for streaming\n39\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n40\t\t\t\t\treturn http.ErrUseLastResponse\n41\t\t\t\t},\n42\t\t\t},\n43\t\t}\n44\t}\n45\t\n46\t// Start begins the proxy HTTP server on the given host:port.\n47\t// If port is 0, a random available port is chosen. Returns the actual port.\n48\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n49\t\tmux := http.NewServeMux()\n50\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n51\t\tp.server = &http.Server{\n52\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n53\t\t\tHandler: mux,\n54\t\t}\n55\t\n56\t\tlistener, err := ioListener(p.server.Addr)\n57\t\tif err != nil {\n58\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n59\t\t}\n60\t\n61\t\tgo func() {\n62\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n63\t\t\t\tlog.Printf(\"proxy server error: %v\", err)\n64\t\t\t}\n65\t\t}()\n66\t\n67\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n68\t\treturn actualPort, nil\n69\t}\n70\t\n71\t// Stop gracefully shuts down the proxy server.\n72\tfunc (p *ReverseProxy) Stop() {\n73\t\tif p.server != nil {\n74\t\t\t_ = p.server.Close()\n75\t\t}\n76\t}\n77\t\n78\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n79\t\t// Reject unknown paths.\n80\t\tif !IsAllowedPath(r.URL.Path) {\n81\t\t\thttp.NotFound(w, r)\n82\t\t\treturn\n83\t\t}\n84\t\n85\t\t// Read request body.\n86\t\tbodyBytes, err := io.ReadAll(r.Body)\n87\t\tif err != nil {\n88\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n89\t\t\treturn\n90\t\t}\n91\t\t_ = r.Body.Close()\n92\t\n93\t\t// Parse request body as JSON.\n94\t\tvar reqBody any\n95\t\tif len(bodyBytes) > 0 {\n96\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n97\t\t}\n98\t\n99\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n100\t\tturn := int(p.turn.Add(1))\n101\t\tt0 := time.Now()\n102\t\n103\t\t// Build upstream request URL.\n104\t\tupstreamURL := p.target + r.URL.Path\n105\t\tif r.URL.RawQuery != \"\" {\n106\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n107\t\t}\n108\t\n109\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n110\t\tif err != nil {\n111\t\t\thttp.Error(w, \"create upstream request: \"+err.Error(), http.StatusBadGateway)\n112\t\t\treturn\n113\t\t}\n114\t\n115\t\t// Copy headers, filter hop-by-hop.\n116\t\tfor k, vals := range r.Header {\n117\t\t\tlower := strings.ToLower(k)\n118\t\t\tif hopByHopHeaders[lower] {\n119\t\t\t\tcontinue\n120\t\t\t}\n121\t\t\tfor _, v := range vals {\n122\t\t\t\tupstreamReq.Header.Add(k, v)\n123\t\t\t}\n124\t\t}\n125\t\tupstreamReq.Header.Del(\"Host\")\n126\t\n127\t\tupstreamResp, err := p.client.Do(upstreamReq)\n128\t\tif err != nil {\n129\t\t\tlog.Printf(\"[Turn %d] upstream error: %v\", turn, err)\n130\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n131\t\t\treturn\n132\t\t}\n133\t\tdefer upstreamResp.Body.Close()\n134\t\n135\t\tduration := time.Since(t0).Milliseconds()\n136\t\tmodel := \"\"\n137\t\tif m, ok := reqBody.(map[string]any); ok {\n138\t\t\tif v, ok := m[\"model\"].(string); ok {\n139\t\t\t\tmodel = v\n140\t\t\t}\n141\t\t}\n142\t\n143\t\t// Detect streaming.\n144\t\tisStreaming := false\n145\t\tif m, ok := reqBody.(map[string]any); ok {\n146\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n147\t\t\t\tisStreaming = s\n148\t\t\t}\n149\t\t}\n150\t\n151\t\tif isStreaming {\n152\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n153\t\t} else {\n154\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n155\t\t}\n156\t}\n157\t\n158\tfunc (p *ReverseProxy) handleStreaming(\n159\t\tw http.ResponseWriter,\n160\t\tupstreamResp *http.Response,\n161\t\treqID string, turn, durationMs int,\n162\t\tr *http.Request, reqBody any,\n163\t\tt0 time.Time, model string,\n164\t) {\n165\t\t// Copy response headers.\n166\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n167\t\tfor k, vals := range respHeaders {\n168\t\t\tfor _, v := range vals {\n169\t\t\t\tw.Header().Add(k, v)\n170\t\t\t}\n171\t\t}\n172\t\tw.WriteHeader(upstreamResp.StatusCode)\n173\t\n174\t\tflusher, canFlush := w.(http.Flusher)\n175\t\treassembler := sse.NewSSEReassembler()\n176\t\n177\t\tbuf := make([]byte, 32*1024)\n178\t\tfor {\n179\t\t\tn, err := upstreamResp.Body.Read(buf)\n180\t\t\tif n > 0 {\n181\t\t\t\t_, _ = w.Write(buf[:n])\n182\t\t\t\tif canFlush {\n183\t\t\t\t\tflusher.Flush()\n184\t\t\t\t}\n185\t\t\t\treassembler.FeedBytes(buf[:n])\n186\t\t\t}\n187\t\t\tif err != nil {\n188\t\t\t\tbreak\n189\t\t\t}\n190\t\t}\n191\t\n192\t\tdurationMs = int(time.Since(t0).Milliseconds())\n193\t\treconstructed := reassembler.Reconstruct()\n194\t\n195\t\trecord := buildRecord(\n196\t\t\treqID, turn, durationMs,\n197\t\t\tr.Method, r.URL.RequestURI(),\n198\t\t\tr.Header, reqBody,\n199\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n200\t\t\treconstructed,\n201\t\t\treassembler.Events,\n202\t\t\tp.target,\n203\t\t)\n204\t\n205\t\tif err := p.writer.Write(record); err != nil {\n206\t\t\tlog.Printf(\"[Turn %d] trace write error: %v\", turn, err)\n207\t\t}\n208\t\n209\t\tlog.Printf(\"[Turn %d] ← %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n210\t}\n211\t\n212\tfunc (p *ReverseProxy) handleNonStreaming(\n213\t\tw http.ResponseWriter,\n214\t\tupstreamResp *http.Response,\n215\t\treqID string, turn, durationMs int,\n216\t\tr *http.Request, reqBody any, model string,\n217\t) {\n218\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n219\t\tif err != nil {\n220\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n221\t\t\treturn\n222\t\t}\n223\t\n224\t\t// Decompress if needed.\n225\t\tdecodeBytes := respBytes\n226\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n227\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n228\t\t\tvar reader io.ReadCloser\n229\t\t\tif encoding == \"gzip\" {\n230\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n231\t\t\t} else {\n232\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n233\t\t\t}\n234\t\t\tif reader != nil {\n235\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n236\t\t\t\t\tdecodeBytes = decoded\n237\t\t\t\t}\n238\t\t\t\t_ = reader.Close()\n239\t\t\t}\n240\t\t}\n241\t\n242\t\tvar respBody any\n243\t\tif len(decodeBytes) > 0 {\n244\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n245\t\t}\n246\t\n247\t\trecord := buildRecord(\n248\t\t\treqID, turn, durationMs,\n249\t\t\tr.Method, r.URL.RequestURI(),\n250\t\t\tr.Header, reqBody,\n251\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n252\t\t\trespBody,\n253\t\t\tnil,\n254\t\t\tp.target,\n255\t\t)\n256\t\n257\t\tif err := p.writer.Write(record); err != nil {\n258\t\t\tlog.Printf(\"[Turn %d] trace write error: %v\", turn, err)\n259\t\t}\n260\t\n261\t\t// Write response to client.\n262\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n263\t\tfor k, vals := range respHeaders {\n264\t\t\tfor _, v := range vals {\n265\t\t\t\tw.Header().Add(k, v)\n266\t\t\t}\n267\t\t}\n268\t\tw.WriteHeader(upstreamResp.StatusCode)\n269\t\t_, _ = w.Write(respBytes)\n270\t\n271\t\tlog.Printf(\"[Turn %d] ← %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n272\t}\n273\t\n274\tfunc buildRecord(\n275\t\treqID string, turn, durationMs int,\n276\t\tmethod, path string,\n277\t\treqHeaders http.Header, reqBody any,\n278\t\tstatus int, respHeaders http.Header,\n279\t\trespBody any,\n280\t\tsseEvents []map[string]any,\n281\t\tupstreamBaseURL string,\n282\t) map[string]any {\n283\t\trecord := map[string]any{\n284\t\t\t\"timestamp\":    time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n285\t\t\t\"request_id\":   reqID,\n286\t\t\t\"session_id\":   extractSessionID(reqBody),\n287\t\t\t\"turn\":         turn,\n288\t\t\t\"duration_ms\":  durationMs,\n289\t\t\t\"request\": map[string]any{\n290\t\t\t\t\"method\":  method,\n291\t\t\t\t\"path\":    path,\n292\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n293\t\t\t\t\"body\":    reqBody,\n294\t\t\t},\n295\t\t\t\"response\": map[string]any{\n296\t\t\t\t\"status\":  status,\n297\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n298\t\t\t\t\"body\":    respBody,\n299\t\t\t},\n300\t\t}\n301\t\tif len(sseEvents) > 0 {\n302\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n303\t\t}\n304\t\tif upstreamBaseURL != \"\" {\n305\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n306\t\t}\n307\t\treturn record\n308\t}\n309\t\n310\t// extractSessionID extracts session_id from request.body.metadata.user_id (JSON string).\n311\t// Claude Code sends: metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n312\tfunc extractSessionID(reqBody any) string {\n313\t\tbody, ok := reqBody.(map[string]any)\n314\t\tif !ok {\n315\t\t\treturn \"\"\n316\t\t}\n317\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n318\t\tif metadata == nil {\n319\t\t\treturn \"\"\n320\t\t}\n321\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n322\t\tif userIDRaw == \"\" {\n323\t\t\treturn \"\"\n324\t\t}\n325\t\tvar userData map[string]string\n326\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n327\t\t\treturn \"\"\n328\t\t}\n329\t\treturn userData[\"session_id\"]\n330\t}\n331\t"}]}
