ags] [-- claude-args...]      Run proxy mode (default)\")\n51\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n52\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n53\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n54\t\tfmt.Println()\n55\t\tfmt.Println(\"Proxy flags:\")\n56\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n57\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n58\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n59\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n60\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n61\t\tfmt.Println()\n62\t\tfmt.Println(\"Session-push flags:\")\n63\t\tfmt.Println(\"  --all                  Collect all projects\")\n64\t\tfmt.Println(\"  --force                Overwrite existing files\")\n65\t\tfmt.Println(\"  --dry-run              Preview only\")\n66\t\tfmt.Println(\"  --project NAME         Override project name\")\n67\t\tfmt.Println()\n68\t\tfmt.Println(\"Session-pull flags:\")\n69\t\tfmt.Println(\"  --all                  Restore all projects\")\n70\t\tfmt.Println(\"  --project NAME         Override project name\")\n71\t\tfmt.Println(\"  --dry-run              Preview only\")\n72\t\tfmt.Println()\n73\t\tfmt.Println(\"Session-status flags:\")\n74\t\tfmt.Println(\"  --verbose              Show file-level details\")\n75\t}\n76\t\n77\t// runProxy is the default proxy mode — intercepts Claude Code API traffic.\n78\tfunc runProxy(args []string) {\n79\t\t// Parse --tap-* flags, collect remaining args for claude.\n80\t\tvar (\n81\t\t\ttapTarget    string\n82\t\t\ttapPort      int\n83\t\t\ttapOutputDir string\n84\t\t\ttapVerbose   bool\n85\t\t)\n86\t\n87\t\tvar claudeArgs []string\n88\t\tfor i := 0; i < len(args); i++ {\n89\t\t\targ := args[i]\n90\t\t\tswitch {\n91\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n92\t\t\t\ti++\n93\t\t\t\ttapTarget = args[i]\n94\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n95\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n96\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n97\t\t\t\ti++\n98\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n99\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n100\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n101\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n102\t\t\t\ti++\n103\t\t\t\ttapOutputDir = args[i]\n104\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n105\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n106\t\t\tcase arg == \"--tap-verbose\":\n107\t\t\t\ttapVerbose = true\n108\t\t\tcase arg == \"--\", arg == \"--claude\":\n109\t\t\t\t// Everything after -- (or --claude) goes to claude.\n110\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n111\t\t\t\ti = len(args) // stop parsing\n112\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n113\t\t\t\t// Unknown tap flag, skip.\n114\t\t\tdefault:\n115\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n116\t\t\t}\n117\t\t}\n118\t\n119\t\tif tapOutputDir == \"\" {\n120\t\t\ttapOutputDir = trace.DefaultTraceDir()\n121\t\t}\n122\t\n123\t\t// Detect upstream target.\n124\t\ttarget := tapTarget\n125\t\tif target == \"\" {\n126\t\t\ttarget = config.DetectTarget(&config.ClaudeClient)\n127\t\t}\n128\t\tif tapVerbose {\n129\t\t\tlog.Printf(\"upstream target: %s\", target)\n130\t\t}\n131\t\n132\t\t// Setup trace writer.\n133\t\ttracePath := trace.NewTracePath(tapOutputDir)\n134\t\twriter, err := trace.NewTraceWriter(tracePath)\n135\t\tif err != nil {\n136\t\t\tlog.Fatalf(\"create trace writer: %v\", err)\n137\t\t}\n138\t\tdefer writer.Close()\n139\t\n140\t\tif tapVerbose {\n141\t\t\tlog.Printf(\"trace file: %s\", tracePath)\n142\t\t}\n143\t\n144\t\t// Start reverse proxy.\n145\t\trp := proxy.NewReverseProxy(target, writer)\n146\t\tport := tapPort\n147\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n148\t\tif err != nil {\n149\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n150\t\t}\n151\t\tdefer rp.Stop()\n152\t\n153\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n154\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n155\t\n156\t\t// Resolve claude binary.\n157\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n158\t\tif err != nil {\n159\t\t\tlog.Fatal(err)\n160\t\t}\n161\t\n162\t\t// Build child environment.\n163\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n164\t\n165\t\t// Inject --settings for clients that need it (e.g. Claude Code).\n166\t\tfinalArgs := claudeArgs\n167\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n168\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n169\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n170\t\t}\n171\t\n172\t\t// Launch claude as child process.\n173\t\tcmd := exec.Command(claudePath, finalArgs...)\n174\t\tcmd.Env = childEnv\n175\t\tcmd.Stdin = os.Stdin\n176\t\tcmd.Stdout = os.Stdout\n177\t\tcmd.Stderr = os.Stderr\n178\t\n179\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n180\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n181\t\n182\t\tif err := cmd.Start(); err != nil {\n183\t\t\tlog.Fatalf(\"start claude: %v\", err)\n184\t\t}\n185\t\n186\t\t// Handle signals: forward to child process.\n187\t\tsigChan := make(chan os.Signal, 2)\n188\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n189\t\n190\t\tgo func() {\n191\t\t\tsigCount := 0\n192\t\t\tfor sig := range sigChan {\n193\t\t\t\tsigCount++\n194\t\t\t\tif sigCount == 1 {\n195\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n196\t\t\t\t\t_ = cmd.Process.Signal(sig)\n197\t\t\t\t} else {\n198\t\t\t\t\t_ = cmd.Process.Kill()\n199\t\t\t\t}\n200\t\t\t}\n201\t\t}()\n202\t\n203\t\t// Wait for child to exit.\n204\t\twaitErr := cmd.Wait()\n205\t\n206\t\t// Stop signal handler.\n207\t\tsignal.Stop(sigChan)\n208\t\tclose(sigChan)\n209\t\n210\t\t// Print summary.\n211\t\tsummary := writer.Summary()\n212\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n213\t\tif waitErr != nil {\n214\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n215\t\t}\n216\t\tfmt.Printf(\"\\n\")\n217\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n218\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n219\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n220\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n221\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n222\t\tfmt.Printf(\"   Trace: %s\\n\", tracePath)\n223\t}\n224\t\n225\tfunc runSessionPush(args []string) {\n226\t\tvar opts session.PushOptions\n227\t\tfor i := 0; i < len(args); i++ {\n228\t\t\targ := args[i]\n229\t\t\tswitch {\n230\t\t\tcase arg == \"--all\":\n231\t\t\t\topts.All = true\n232\t\t\tcase arg == \"--force\":\n233\t\t\t\topts.Force = true\n234\t\t\tcase arg == \"--dry-run\":\n235\t\t\t\topts.DryRun = true\n236\t\t\tcase arg == \"--project\" && i+1 < len(args):\n237\t\t\t\ti++\n238\t\t\t\topts.Project = args[i]\n239\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n240\t\t\t\topts.Project = arg[len(\"--project=\"):]\n241\t\t\t}\n242\t\t}\n243\t\n244\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n245\t\tresults, err := session.SessionPush(opts)\n246\t\tif err != nil {\n247\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n248\t\t\tos.Exit(1)\n249\t\t}\n250\t\n251\t\tfmt.Println()\n252\t\ttotalNew, totalSkipped := 0, 0\n253\t\tfor _, r := range results {\n254\t\t\ttotalNew += r.SessionsNew\n255\t\t\ttotalSkipped += r.SessionsSkipped\n256\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n257\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n258\t\t\t}\n259\t\t}\n260\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n261\t}\n262\t\n263\tfunc runSessionPull(args []string) {\n264\t\tvar opts session.PullOptions\n265\t\tfor i := 0; i < len(args); i++ {\n266\t\t\targ := args[i]\n267\t\t\tswitch {\n268\t\t\tcase arg == \"--all\":\n269\t\t\t\topts.All = true\n270\t\t\tcase arg == \"--dry-run\":\n271\t\t\t\topts.DryRun = true\n272\t\t\tcase arg == \"--project\" && i+1 < len(args):\n273\t\t\t\ti++\n274\t\t\t\topts.Project = args[i]\n275\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n276\t\t\t\topts.Project = arg[len(\"--project=\"):]\n277\t\t\t}\n278\t\t}\n279\t\n280\t\tfmt.Println(\"📤 Restoring sessions...\")\n281\t\tresults, err := session.SessionPull(opts)\n282\t\tif err != nil {\n283\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n284\t\t\tos.Exit(1)\n285\t\t}\n286\t\n287\t\tfmt.Println()\n288\t\ttotalRestored, totalSkipped := 0, 0\n289\t\tfor _, r := range results {\n290\t\t\ttotalRestored += r.SessionsRestored\n291\t\t\ttotalSkipped += r.SessionsSkipped\n292\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n293\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n294\t\t\t}\n295\t\t}\n296\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n297\t}\n298\t\n299\tfunc runSessionStatus(args []string) {\n300\t\tvar opts session.StatusOptions\n301\t\tfor i := 0; i < len(args); i++ {\n302\t\t\targ := args[i]\n303\t\t\tswitch {\n304\t\t\tcase arg == \"--verbose\":\n305\t\t\t\topts.Verbose = true\n306\t\t\t}\n307\t\t}\n308\t\n309\t\tif err := session.SessionStatus(opts); err != nil {\n310\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n311\t\t\tos.Exit(1)\n312\t\t}\n313\t}\n314\t\n315\tfunc formatArgs(args []string) string {\n316\t\tresult := \"\"\n317\t\tfor _, a := range args {\n318\t\t\tif containsSpace(a) {\n319\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n320\t\t\t} else {\n321\t\t\