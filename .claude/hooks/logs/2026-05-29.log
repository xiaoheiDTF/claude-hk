t\t\t}\n234\t\t\tif reader != nil {\n235\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n236\t\t\t\t\tdecodeBytes = decoded\n237\t\t\t\t}\n238\t\t\t\t_ = reader.Close()\n239\t\t\t}\n240\t\t}\n241\t\n242\t\tvar respBody any\n243\t\tif len(decodeBytes) > 0 {\n244\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n245\t\t}\n246\t\n247\t\trecord := buildRecord(\n248\t\t\treqID, turn, durationMs,\n249\t\t\tr.Method, r.URL.RequestURI(),\n250\t\t\tr.Header, reqBody,\n251\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n252\t\t\trespBody,\n253\t\t\tnil,\n254\t\t\tp.target,\n255\t\t)\n256\t\n257\t\tif err := p.writer.Write(record); err != nil {\n258\t\t\tlog.Printf(\"[Turn %d] trace write error: %v\", turn, err)\n259\t\t}\n260\t\n261\t\t// Write response to client.\n262\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n263\t\tfor k, vals := range respHeaders {\n264\t\t\tfor _, v := range vals {\n265\t\t\t\tw.Header().Add(k, v)\n266\t\t\t}\n267\t\t}\n268\t\tw.WriteHeader(upstreamResp.StatusCode)\n269\t\t_, _ = w.Write(respBytes)\n270\t\n271\t\tlog.Printf(\"[Turn %d] ← %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n272\t}\n273\t\n274\tfunc buildRecord(\n275\t\treqID string, turn, durationMs int,\n276\t\tmethod, path string,\n277\t\treqHeaders http.Header, reqBody any,\n278\t\tstatus int, respHeaders http.Header,\n279\t\trespBody any,\n280\t\tsseEvents []map[string]any,\n281\t\tupstreamBaseURL string,\n282\t) map[string]any {\n283\t\trecord := map[string]any{\n284\t\t\t\"timestamp\":    time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n285\t\t\t\"request_id\":   reqID,\n286\t\t\t\"session_id\":   extractSessionID(reqBody),\n287\t\t\t\"turn\":         turn,\n288\t\t\t\"duration_ms\":  durationMs,\n289\t\t\t\"request\": map[string]any{\n290\t\t\t\t\"method\":  method,\n291\t\t\t\t\"path\":    path,\n292\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n293\t\t\t\t\"body\":    reqBody,\n294\t\t\t},\n295\t\t\t\"response\": map[string]any{\n296\t\t\t\t\"status\":  status,\n297\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n298\t\t\t\t\"body\":    respBody,\n299\t\t\t},\n300\t\t}\n301\t\tif len(sseEvents) > 0 {\n302\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n303\t\t}\n304\t\tif upstreamBaseURL != \"\" {\n305\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n306\t\t}\n307\t\treturn record\n308\t}\n309\t\n310\t// extractSessionID extracts session_id from request.body.metadata.user_id (JSON string).\n311\t// Claude Code sends: metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n312\tfunc extractSessionID(reqBody any) string {\n313\t\tbody, ok := reqBody.(map[string]any)\n314\t\tif !ok {\n315\t\t\treturn \"\"\n316\t\t}\n317\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n318\t\tif metadata == nil {\n319\t\t\treturn \"\"\n320\t\t}\n321\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n322\t\tif userIDRaw == \"\" {\n323\t\t\treturn \"\"\n324\t\t}\n325\t\tvar userData map[string]string\n326\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n327\t\t\treturn \"\"\n328\t\t}\n329\t\treturn userData[\"session_id\"]\n330\t}\n331\t"}]}
