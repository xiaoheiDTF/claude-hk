list --state open --json number,title,body --jq \".[] | select(.body | test(\\\"Closes #$ISSUE_NUM\\\")) | {number,title}\" 2>/dev/null)\n23\t    if [ -n \"$pr_info\" ]; then\n24\t      echo \"关联 PR:\"\n25\t      echo \"$pr_info\" | jq -r '\"  PR #\\(.number): \\(.title)\"'\n26\t    else\n27\t      echo \"未找到关联 issue #$ISSUE_NUM 的 PR\"\n28\t    fi\n29\t  fi\n30\t\n31\t  # 向后端标记 testing 状态（降级静默）\n32\t  update_issue_status \"$ISSUE_NUM\" \"testing\"\n33\telse\n34\t  # 无参数时列出有 PR 的 issues\n35\t  if _gh --version &>/dev/null; then\n36\t    echo \"\"\n37\t    echo \"=== 可测试的 PRs ===\"\n38\t    prs=$(_gh pr list --state open --json number,title,headRefName 2>/dev/null)\n39\t    if [ -n \"$prs\" ] && [ \"$prs\" != \"[]\" ]; then\n40\t      echo \"$prs\" | jq -r '.[] | \"  PR #\\(.number): \\(.title) (分支: \\(.headRefName))\"'\n41\t    else\n42\t      echo \"(暂无 open PRs)\"\n43\t    fi\n44\t  fi\n45\tfi\n46\t\n47\tskill_log \"INFO\" \"[inject] issue-test context injected for #$ISSUE_NUM\"\n48\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/.claude/skills/003-9-issue-review/scripts/03UserPromptSubmit.sh"},"tool_use_id":"call_9a00373f5af541c6be2baac9","tool_response":"1\t#!/bin/bash\n2\t# 003-9-issue-review 上下文注入\n3\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n4\tSKILL_TAG=\"003-9-issue-review\"\n5\tsource \"$PROJECT_DIR/.claude/skills/log.sh\"\n6\tsource \"$PROJECT_DIR/.claude/skills/backend.sh\"\n7\t\n8\t# gh 路径检测\n9\t_gh() { command -v gh &>/dev/null && gh \"$@\" || \"C:/Program Files/GitHub CLI/gh.exe\" \"$@\"; }\n10\t\n11\t# 从 prompt 提取 issue 编号和子命令\n12\tPROMPT=\"$1\"\n13\tISSUE_NUM=$(echo \"$PROMPT\" | grep -oE '#[0-9]+' | head -1 | tr -d '#')\n14\t\n15\t# 检测子命令：merge 或 reject\n16\tREVIEW_ACTION=\"\"\n17\tif echo \"$PROMPT\" | grep -qi \"merge\"; then\n18\t  REVIEW_ACTION=\"merge\"\n19\telif echo \"$PROMPT\" | grep -qi \"reject\"; then\n20\t  REVIEW_ACTION=\"reject\"\n21\tfi\n22\t\n23\techo \"=== Issue Review 上下文 ===\"\n24\techo \"日期: $(date +%Y-%m-%d)\"\n25\t\n26\tif [ -n \"$ISSUE_NUM\" ]; then\n27\t  if _gh --version &>/dev/null; then\n28\t    # 找关联 PR\n29\t    pr_info=$(_gh pr list --state open --json number,title,body --jq \".[] | select(.body | test(\\\"Closes #$ISSUE_NUM\\\")) | {number,title}\" 2>/dev/null)\n30\t    if [ -n \"$pr_info\" ]; then\n31\t      echo \"关联 PR:\"\n32\t      echo \"$pr_info\" | jq -r '\"  PR #\\(.number): \\(.title)\"'\n33\t    else\n34\t      echo \"未找到关联 issue #$ISSUE_NUM 的 PR\"\n35\t    fi\n36\t  fi\n37\t\n38\t  # 向后端标记状态（降级静默）\n39\t  if [ \"$REVIEW_ACTION\" = \"merge\" ]; then\n40\t    # merge 时先标记 reviewing，最终由 Claude 执行完 merge 后调 merged\n41\t    update_issue_status \"$ISSUE_NUM\" \"reviewing\"\n42\t    update_issue_status \"$ISSUE_NUM\" \"merged\"\n43\t  elif [ \"$REVIEW_ACTION\" = \"reject\" ]; then\n44\t    update_issue_status \"$ISSUE_NUM\" \"reviewing\"\n45\t    update_issue_status \"$ISSUE_NUM\" \"rejected\"\n46\t  else\n47\t    # 默认：仅标记 reviewing\n48\t    update_issue_status \"$ISSUE_NUM\" \"reviewing\"\n49\t  fi\n50\telse\n51\t  if _gh --version &>/dev/null; then\n52\t    echo \"\"\n53\t    echo \"=== 可审核的 PRs ===\"\n54\t    prs=$(_gh pr list --state open --json number,title,headRefName 2>/dev/null)\n55\t    if [ -n \"$prs\" ] && [ \"$prs\" != \"[]\" ]; then\n56\t      echo \"$prs\" | jq -r '.[] | \"  PR #\\(.number): \\(.title) (分支: \\(.headRefName))\"'\n57\t      echo \"\"\n58\t      echo \"用法:\"\n59\t      echo \"  /003-9-issue-review merge #<N>   合并 PR\"\n60\t      echo \"  /003-9-issue-review reject #<N>  打回 PR\"\n61\t    else\n62\t      echo \"(暂无 open PRs)\"\n63\t    fi\n64\t  fi\n65\tfi\n66\t\n67\tskill_log \"INFO\" \"[inject] issue-review context injected for #$ISSUE_NUM action=$REVIEW_ACTION\"\n68\t"}]}
