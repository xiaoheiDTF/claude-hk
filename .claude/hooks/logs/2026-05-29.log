eviewing）都被释放\n1120\t\t\te := setup(t)\n1121\t\t\tdb := e.store.DB()\n1122\t\n1123\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"fixing\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1124\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"ready-for-pr\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1125\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 12, \"pr-created\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1126\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 13, \"testing\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1127\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 14, \"reviewing\", \"sess_d7\", \"2026-05-27T10:00:00Z\")\n1128\t\n1129\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1130\t\t\t\t`{\"session_id\":\"sess_d7\"}`)\n1131\t\t\tvar result struct {\n1132\t\t\t\tReleased []int `json:\"released\"`\n1133\t\t\t\tCount    int   `json:\"count\"`\n1134\t\t\t}\n1135\t\t\treadJSON(t, resp, &result)\n1136\t\n1137\t\t\tif result.Count != 5 {\n1138\t\t\t\tt.Fatalf(\"expected 5 released, got %d\", result.Count)\n1139\t\t\t}\n1140\t\n1141\t\t\t// 验证所有 issue 都回到 idle\n1142\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11, 12, 13, 14})\n1143\t\t\tfor _, n := range []int{10, 11, 12, 13, 14} {\n1144\t\t\t\tif s[n] != \"idle\" {\n1145\t\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", n, s[n])\n1146\t\t\t\t}\n1147\t\t\t}\n1148\t\t})\n1149\t\n1150\t\tt.Run(\"merged_not_released\", func(t *testing.T) {\n1151\t\t\t// 验收：merged 终态不被释放\n1152\t\t\te := setup(t)\n1153\t\t\tdb := e.store.DB()\n1154\t\n1155\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_d7_m\", \"2026-05-27T10:00:00Z\")\n1156\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"fixing\", \"sess_d7_m\", \"2026-05-27T10:00:00Z\")\n1157\t\n1158\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1159\t\t\t\t`{\"session_id\":\"sess_d7_m\"}`)\n1160\t\t\tvar result struct {\n1161\t\t\t\tReleased []int `json:\"released\"`\n1162\t\t\t\tCount    int   `json:\"count\"`\n1163\t\t\t}\n1164\t\t\treadJSON(t, resp, &result)\n1165\t\n1166\t\t\tif result.Count != 1 {\n1167\t\t\t\tt.Fatalf(\"expected 1 released (fixing only), got %d\", result.Count)\n1168\t\t\t}\n1169\t\t\tif len(result.Released) != 1 || result.Released[0] != 11 {\n1170\t\t\t\tt.Fatalf(\"expected [11], got %v\", result.Released)\n1171\t\t\t}\n1172\t\n1173\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11})\n1174\t\t\tif s[10] != \"merged\" {\n1175\t\t\t\tt.Errorf(\"merged should stay, got %s\", s[10])\n1176\t\t\t}\n1177\t\t\tif s[11] != \"idle\" {\n1178\t\t\t\tt.Errorf(\"fixing should be idle, got %s\", s[11])\n1179\t\t\t}\n1180\t\t})\n1181\t\n1182\t\tt.Run(\"rejected_not_released\", func(t *testing.T) {\n1183\t\t\t// 验收：rejected 终态不被释放\n1184\t\t\te := setup(t)\n1185\t\t\tdb := e.store.DB()\n1186\t\n1187\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"rejected\", \"sess_d7_r\", \"2026-05-27T10:00:00Z\")\n1188\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"claimed\", \"sess_d7_r\", \"2026-05-27T10:00:00Z\")\n1189\t\n1190\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1191\t\t\t\t`{\"session_id\":\"sess_d7_r\"}`)\n1192\t\t\tvar result struct{ Count int `json:\"count\"` }\n1193\t\t\treadJSON(t, resp, &result)\n1194\t\n1195\t\t\tif result.Count != 1 {\n1196\t\t\t\tt.Fatalf(\"expected 1 released (claimed only), got %d\", result.Count)\n1197\t\t\t}\n1198\t\n1199\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11})\n1200\t\t\tif s[10] != \"rejected\" {\n1201\t\t\t\tt.Errorf(\"rejected should stay, got %s\", s[10])\n1202\t\t\t}\n1203\t\t\tif s[11] != \"idle\" {\n1204\t\t\t\tt.Errorf(\"claimed should be idle, got %s\", s[11])\n1205\t\t\t}\n1206\t\t})\n1207\t\n1208\t\tt.Run(\"released_issue_can_be_reclaimed\", func(t *testing.T) {\n1209\t\t\t// 验收：释放后 issue 可被重新 claim\n1210\t\t\te := setup(t)\n1211\t\t\tdb := e.store.DB()\n1212\t\n1213\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"fixing\", \"sess_old\", \"2026-05-27T10:00:00Z\")\n1214\t\n1215\t\t\t// 释放\n1216\t\t\te.post(t, \"/api/issue/release-session\",\n1217\t\t\t\t`{\"session_id\":\"sess_old\"}`)\n1218\t\n1219\t\t\t// 新 session claim\n1220\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 10, \"sess_new\")\n1221\t\t\tif code != http.StatusOK || !ok {\n1222\t\t\t\tt.Fatalf(\"re-claim should succeed: code=%d ok=%v\", code, ok)\n1223\t\t\t}\n1224\t\n1225\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n1226\t\t\tif s[10] != \"claimed\" {\n1227\t\t\t\tt.Fatalf(\"expected claimed after re-claim, got %s\", s[10])\n1228\t\t\t}\n1229\t\t})\n1230\t\n1231\t\tt.Run(\"no_backend_issues_returns_ok\", func(t *testing.T) {\n1232\t\t\t// 验收：无领取记录的 session 返回成功\n1233\t\t\te := setup(t)\n1234\t\n1235\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1236\t\t\t\t`{\"session_id\":\"sess_empty_d7\"}`)\n1237\t\n1238\t\t\tif resp.StatusCode != http.StatusOK {\n1239\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n1240\t\t\t}\n1241\t\t})\n1242\t}\n1243\t"}]}
