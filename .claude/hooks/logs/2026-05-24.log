ngs.\n100\tfunc HasSettingsArg(args []string) bool {\n101\t\tfor _, arg := range args {\n102\t\t\tif arg == \"--settings\" || strings.HasPrefix(arg, \"--settings=\") {\n103\t\t\t\treturn true\n104\t\t\t}\n105\t\t}\n106\t\treturn false\n107\t}\n108\t\n109\t// BuildSettingsArgs returns [\"--settings\", JSON] to inject the proxy URL via Claude's settings.\n110\tfunc BuildSettingsArgs(cfg *ClientConfig, proxyURL string) []string {\n111\t\tenvJSON := fmt.Sprintf(`{\"env\":{\"%s\":\"%s\"}}`, cfg.BaseURLEnv, proxyURL)\n112\t\treturn []string{\"--settings\", envJSON}\n113\t}\n114\t"}]}
