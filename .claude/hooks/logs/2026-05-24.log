n39\t    sys.stderr.reconfigure(encoding=\"utf-8\", errors=\"backslashreplace\")\n40\t\n41\tlog = logging.getLogger(\"claude-tap\")\n42\t\n43\ttry:\n44\t    from importlib.metadata import version as _pkg_version\n45\t\n46\t    __version__ = _pkg_version(\"claude-tap\")\n47\texcept Exception:\n48\t    __version__ = \"0.0.0\"\n49\t\n50\t\n51\tdef _open_browser(url: str) -> None:\n52\t    \"\"\"Open URL in browser without blocking. Silently ignores failures in headless environments.\"\"\"\n53\t    threading.Thread(target=lambda: webbrowser.open(url), daemon=True).start()\n54\t\n55\t\n56\t@dataclass(frozen=True)\n57\tclass ClientConfig:\n58\t    \"\"\"Per-client configuration for supported AI CLI tools.\"\"\"\n59\t\n60\t    cmd: str\n61\t    label: str\n62\t    install_url: str\n63\t    base_url_env: str\n64\t    base_url_suffix: str  # appended to http://127.0.0.1:{port}\n65\t    default_target: str\n66\t    extra_base_url_envs: tuple[str, ...] = ()\n67\t    nesting_env_keys: tuple[str, ...] = ()  # env vars to clear before launch\n68\t    # Some CLIs need process env duplicated into a CLI settings payload.\n69\t    inject_settings_env: bool = False\n70\t    # Some CLIs need a base URL in both env and a native config override.\n71\t    base_url_config_key: str | None = None\n72\t    # Reverse proxy URL normalization. Example: Codex OAuth receives /v1/* but\n73\t    # its upstream target already points at a /codex backend that expects /*.\n74\t    strip_path_prefix: str = \"\"\n75\t    strip_path_prefix_unless_target_contains: tuple[str, ...] = ()\n76\t    # Default proxy mode when --tap-proxy-mode is not explicitly set.\n77\t    # Multi-provider clients (e.g. hermes, opencode, pi) default to \"forward\" so that all\n78\t    # provider traffic is captured regardless of which env var the client honors.\n79\t    default_proxy_mode: str = \"reverse\"\n80\t\n81\t    @property\n82\t    def missing_help(self) -> str:\n83\t        return (\n84\t            f\"\\nError: '{self.cmd}' command not found in PATH.\\nPlease install {self.label} first: {self.install_url}\\n\"\n85\t        )\n86\t\n87\t    def reverse_base_url(self, port: int) -> str:\n88\t        return f\"http://127.0.0.1:{port}{self.base_url_suffix}\"\n89\t\n90\t    @property\n91\t    def reverse_base_url_envs(self) -> tuple[str, ...]:\n92\t        seen: set[str] = set()\n93\t        env_keys: list[str] = []\n94\t        for env_key in (self.base_url_env, *self.extra_base_url_envs):\n95\t            if env_key in seen:\n96\t                continue\n97\t            seen.add(env_key)\n98\t            env_keys.append(env_key)\n99\t        return tuple(env_keys)\n100\t\n101\t    def reverse_base_url_env_map(self, port: int) -> dict[str, str]:\n102\t        base_url = self.reverse_base_url(port)\n103\t        return {env_key: base_url for env_key in self.reverse_base_url_envs}\n104\t\n105\t    def reverse_strip_path_prefix(self, target: str) -> str:\n106\t        if not self.strip_path_prefix:\n107\t            return \"\"\n108\t        if any(marker in target for marker in self.strip_path_prefix_unless_target_contains):\n109\t            return \"\"\n110\t        return self.strip_path_prefix\n111\t\n112\t\n113\tCLIENT_CONFIGS: dict[str, ClientConfig] = {\n114\t    \"claude\": ClientConfig(\n115\t        cmd=\"claude\",\n116\t        label=\"Claude Code\",\n117\t        install_url=\"https://docs.anthropic.com/en/docs/claude-code\",\n118\t        base_url_env=\"ANTHROPIC_BASE_URL\",\n119\t        base_url_suffix=\"\",\n120\t        default_target=\"https://api.anthropic.com\",\n121\t        nesting_env_keys=(\"CLAUDECODE\", \"CLAUDE_CODE_SSE_PORT\"),\n122\t        inject_settings_env=True,\n123\t    ),\n124\t    \"codex\": ClientConfig(\n125\t        cmd=\"codex\",\n126\t        label=\"Codex CLI\",\n127\t        install_url=\"https://github.com/openai/codex\",\n128\t        base_url_env=\"OPENAI_BASE_URL\",\n129\t        base_url_suffix=\"/v1\",\n130\t        default_target=\"https://api.openai.com\",\n131\t        base_url_config_key=\"openai_base_url\",\n132\t        strip_path_prefix=\"/v1\",\n133\t        strip_path_prefix_unless_target_contains=(\"api.openai.com\",),\n134\t    ),\n135\t    \"kimi\": ClientConfig(\n136\t        cmd=\"kimi\",\n137\t        label=\"Kimi Code CLI\",\n138\t        install_url=\"https://github.com/MoonshotAI/kimi-cli\",\n139\t        base_url_env=\"KIMI_BASE_URL\",\n140\t        base_url_suffix=\"\",\n141\t        default_target=\"https://api.kimi.com/coding/v1\",\n142\t    ),\n143\t    \"gemini\": ClientConfig(\n144\t        cmd=\"gemini\",\n145\t        label=\"Gemini CLI\",\n146\t        install_url=\"https://github.com/google-gemini/gemini-cli\",\n147\t        base_url_env=\"GOOGLE_GEMINI_BASE_URL\",\n148\t        extra_base_url_envs=(\"GOOGLE_VERTEX_BASE_URL\",),\n149\t        base_url_suffix=\"\",\n150\t        default_target=\"https://generativelanguage.googleapis.com\",\n151\t        # Google OAuth / Code Assist traffic spans several Google endpoints.\n152\t        # Forward mode captures that flow without assuming a single base URL.\n153\t        default_proxy_mode=\"forward\",\n154\t    ),\n155\t    \"opencode\": ClientConfig(\n156\t        cmd=\"opencode\",\n157\t        label=\"OpenCode\",\n158\t        install_url=\"https://opencode.ai/docs/\",\n159\t        # opencode is multi-provider; ANTHROPIC_BASE_URL is what reverse mode\n160\t        # patches when the user explicitly opts out of forward mode. Forward\n161\t        # proxy is the default and captures every provider transparently.\n162\t        base_url_env=\"ANTHROPIC_BASE_URL\",\n163\t        base_url_suffix=\"\",\n164\t        default_target=\"https://api.anthropic.com\",\n165\t        default_proxy_mode=\"forward\",\n166\t    ),\n167\t    \"pi\": ClientConfig(\n168\t        cmd=\"pi\",\n169\t        label=\"Pi\",\n170\t        install_url=\"https://github.com/badlogic/pi-mono/tree/main/packages/coding-agent\",\n171\t        # Pi is multi-provider and stores provider base URLs in its model\n172\t        # registry/models.json rather than a single global env var. Reverse\n173\t        # mode remains structurally available for custom OpenAI-compatible\n174\t        # setups, but forward mode is the reliable default.\n175\t        base_url_env=\"OPENAI_BASE_URL\",\n176\t        base_url_suffix=\"/v1\",\n177\t        default_target=\"https://api.openai.com\",\n178\t        default_proxy_mode=\"forward\",\n179\t    ),\n180\t    \"hermes\": ClientConfig(\n181\t        cmd=\"hermes\",\n182\t        label=\"Hermes Agent\",\n183\t        install_url=\"https://github.com/NousResearch/hermes-agent\",\n184\t        base_url_env=\"OPENAI_BASE_URL\",\n185\t        base_url_suffix=\"/v1\",\n186\t        default_target=\"https://api.openai.com\",\n187\t        # hermes is a Python 3.11+ multi-provider agent; reverse mode requires\n188\t        # a user-configured OpenAI-compatible provider in ~/.hermes that honors\n189\t        # OPENAI_BASE_URL. Default to forward proxy capture.\n190\t        default_proxy_mode=\"forward\",\n191\t    ),\n192\t    \"cursor\": ClientConfig(\n193\t        cmd=\"cursor-agent\",\n194\t        label=\"Cursor CLI\",\n195\t        install_url=\"https://cursor.com/cli\",\n196\t        # Cursor CLI does not expose a provider base URL. Keep reverse-mode\n197\t        # fields structurally valid, but default to forward proxy mode.\n198\t        base_url_env=\"CURSOR_BASE_URL\",\n199\t        base_url_suffix=\"\",\n200\t        default_target=\"https://api2.cursor.sh\",\n201\t        default_proxy_mode=\"forward\",\n202\t    ),\n203\t    \"qoder\": ClientConfig(\n204\t        cmd=\"qodercli\",\n205\t        label=\"Qoder CLI\",\n206\t        install_url=\"https://qoder.com/cli\",\n207\t        # Qoder CLI talks to multiple Qoder endpoints and does not expose a\n208\t        # reliable single-provider base URL override. Keep reverse-mode fields\n209\t        # structurally valid, but default to forward proxy mode.\n210\t        base_url_env=\"QODER_BASE_URL\",\n211\t        base_url_suffix=\"\",\n212\t        default_target=\"https://api2.qoder.sh\",\n213\t        default_proxy_mode=\"forward\",\n214\t    ),\n215\t}\n216\t\n217\t\n218\tasync def run_client(\n219\t    port: int,\n220\t    extra_args: list[str],\n221\t    client: str = \"claude\",\n222\t    proxy_mode: str = \"reverse\",\n223\t    ca_cert_path: Path | None = None,\n224\t) -> int:\n225\t    cfg = CLIENT_CONFIGS[client]\n226\t\n227\t    # asyncio.create_subprocess_exec uses CreateProcess on Windows, which only\n228\t    # auto-appends `.exe`; resolve here so npm `.cmd`/`.bat` shims also work.\n229\t    resolved_cmd = shutil.which(cfg.cmd)\n230\t    if resolved_cmd is None:\n231\t        print(cfg.missing_help)\n232\t        return 1\n233\t\n234\t    env = os.environ.copy()\n235\t\n236\t    cmd_args = list(extra_args)\n237\t    cmd_args = _maybe_rewrite_hermes_gateway_start(client, cmd_args)\n238\t    has_base_url_config_override = bool(\n239\t        cfg.base_url_config_key and _has_config_override(cmd_args, cfg.base_url_config_key)\n240\t    )\n241\t\n242\t    if proxy_mode == \"forward\":\n243\t        proxy_url = f\"http://127.0.0.1:{port}\"\n244\t        # Set both upper/lower-case variants for tools that read one form only.\n245\t        env[\"HTTP_PROXY\"] = proxy_url\n246\t        env[\"HTTPS_PROXY\"] = proxy_url\n247\t        env[\"ALL_PROXY\"] = proxy_url\n248\t        env[\"http_proxy\"] = proxy_url\n249\t        env[\"https_proxy\"] = proxy_url\n250\t        env[\"all_proxy\"] = proxy_url\n251\t        _extend_no_proxy(env, (\"localhost\", \"127.0.0.1\", \"::1\"))\n252\t        if ca_cert_path:\n253\t            env[\"NODE_EXTRA_CA_CERTS\"] = str(ca_cert_path)\n254\t            # Codex is a Rust binary; NODE_EXTRA_CA_CERTS does not affect its TLS stack.\n255\t            env[\"SSL_CERT_FILE\"] = str(ca_cert_path)\n256\t            env[\"CODEX_CA_CERTIFICATE\"] = str(ca_cert_path)\n257\t            # hermes is Python (httpx + requests); SSL_CERT_FILE covers httpx,\n258\t            # REQUESTS_CA_BUNDLE covers the requests library.\n259\t            env[\"REQUESTS_CA_BUNDLE\"] = str(ca_cert_path)\n260\t\n261\t        if cfg.inject_settings_env:\n262\t            if not _has_settings_arg(cmd_args):\n263\t                settings_payload: dict[str, dict[str, str]] = {\n264\t                    \"env\": {\n265\t                        \"HTTP_PROXY\": proxy_url,\n266\t                        \"HTTPS_PROXY\": proxy_url,\n267\t                        \"ALL_PROXY\": proxy_url,\n268\t                        \"http_proxy\": proxy_url,\n269\t                        \"https_proxy\": proxy_url,\n270\t                        \"all_proxy\": proxy_url,\n271\t                    }\n272\t                }\n273\t                if ca_cert_path:\n274\t                    settings_payload[\"env\"][\"NODE_EXTRA_CA_CERTS\"] = str(ca_cert_path)\n275\t                cmd_args = _settings_arg(settings_payload[\"env\"]) + cmd_args\n276\t        # Don't set provider-specific base URL in forward mode\n277\t    else:\n278\t        reverse_env = cfg.reverse_base_url_env_map(port)\n279\t        env.update(reverse_env)\n280\t        env[\"NO_PROXY\"] = \"127.0.0.1\"\n281\t        if cfg.inject_settings_env and not _has_settings_arg(cmd_args):\n282\t            cmd_args = _settings_arg(reverse_env) + cmd_args\n283\t        if cfg.base_url_config_key and not has_base_url_config_override:\n284\t            # Some clients ignore their base URL env in selected auth/transport modes\n285\t            # unless the same value is also supplied as a config override.\n286\t            base_url = cfg.reverse_base_url(port)\n287\t            cmd_args = [\"-c\", f'{cfg.base_url_config_key}=\"{base_url}\"'] + cmd_args\n288\t\n289\t    for key in cfg.nesting_env_keys:\n290\t        env.pop(key, None)\n291\t\n292\t    cmd = [resolved_cmd] + cmd_args\n293\t    print(f\"\\n🚀 Starting {cfg.label}: {' '.join([cfg.cmd, *cmd_args])}\")\n294\t    if proxy_mode == \"forward\":\n295\t        print(f\"   HTTPS_PROXY=http://127.0.0.1:{port}\")\n296\t        if ca_cert_path:\n297\t            print(f\"   NODE_EXTRA_CA_CERTS={ca_cert_path}\")\n298\t    else:\n299\t        for env_key, base_url in cfg.reverse_base_url_env_map(port).items():\n300\t            print(f\"   {env_key}={base_url}\")\n301\t    print()\n302\t\n303\t    # Give child its own process group and make it the foreground group\n304\t    # so the TUI app has full terminal control (e.g. Cmd+Delete, Ctrl+U).\n305\t    use_fg = hasattr(os, \"tcsetpgrp\") and sys.stdin.isatty()\n306\t\n307\t    proc = await asyncio.create_subprocess_exec(\n308\t        *cmd,\n309\t        env=env,\n310\t        stdin=None,\n311\t        stdout=None,\n312\t        stderr=None,\n313\t        **({\"process_group\": 0} if use_fg else {}),\n314\t    )\n315\t\n316\t    if use_fg:\n317\t        try:\n318\t            os.tcsetpgrp(sys.stdin.fileno(), proc.pid)\n319\t        except OSError:\n320\t            pass\n321\t\n322\t    # --- Signal handling: graceful Ctrl+C / Ctrl+Z ---\n323\t    loop = asyncio.get_running_loop()\n324\t\n325\t    # SIGTSTP is Unix-only; on Windows the attribute is absent.\n326\t    sigtstp = getattr(signal, \"SIGTSTP\", None)\n327\t    old_sigtstp = signal.signal(sigtstp, signal.SIG_IGN) if sigtstp is not None else None\n328\t\n329\t    sigint_count = 0\n330\t\n331\t    def _handle_sigint():\n332\t        nonlocal sigint_count\n333\t        sigint_count += 1\n334\t        if sigint_count == 1:\n335\t            if proc.returncode is None:\n336\t                proc.terminate()\n337\t                print(f\"\\n⏳ Shutting down {cfg.label}... (Ctrl+C again to force)\")\n338\t        else:\n339\t            if proc.returncode is None:\n340\t                proc.kill()\n341\t\n342\t    def _handle_sigtstp():\n343\t        if proc.returncode is None:\n344\t            proc.terminate()\n345\t            print(f\"\\n⏳ Shutting down {cfg.label}...\")\n346\t\n347\t    try:\n348\t        loop.add_signal_handler(signal.SIGINT, _handle_sigint)\n349\t        if sigtstp is not None:\n350\t            loop.add_signal_handler(sigtstp, _handle_sigtstp)\n351\t    except (NotImplementedError, OSError):\n352\t        pass\n353\t\n354\t    code = await proc.wait()\n355\t\n356\t    # Restore parent as foreground process group.\n357\t    # Ignore SIGTTOU first — the parent is still in the background group\n358\t    # and any terminal write (including tcsetpgrp) would suspend it.\n359\t    if use_fg:\n360\t        old_sigttou = signal.signal(signal.SIGTTOU, signal.SIG_IGN)\n361\t        try:\n362\t            os.tcsetpgrp(sys.stdin.fileno(), os.getpgrp())\n363\t        except OSError:\n364\t            pass\n365\t        signal.signal(signal.SIGTTOU, old_sigttou)\n366\t\n367\t    # Restore original SIGTSTP handler and remove async signal handlers\n368\t    if sigtstp is not None and old_sigtstp is not None:\n369\t        signal.signal(sigtstp, old_sigtstp)\n370\t    try:\n371\t        loop.remove_signal_handler(signal.SIGINT)\n372\t    except (NotImplementedError, OSError):\n373\t        pass\n374\t    if sigtstp is not None:\n375\t        try:\n376\t            loop.remove_signal_handler(sigtstp)\n377\t        except (NotImplementedError, OSError):\n378\t            pass\n379\t\n380\t    print(f\"\\n📋 {cfg.label} exited with code {code}\")\n381\t    return code\n382\t\n383\t\n384\t_HERMES_GLOBAL_OPTS_WITH_VALUE = {\"--profile\", \"-p\"}\n385\t_HERMES_GLOBAL_BOOLEAN_OPTS = {\"--ignore-user-config\", \"--accept-hooks\"}\n386\t\n387\t\n388\tdef _maybe_rewrite_hermes_gateway_start(client: str, cmd_args: list[str]) -> list[str]:\n389\t    \"\"\"Rewrite ``hermes [global-opts] gateway start`` to ``... gateway run``.\n390\t\n391\t    Recent hermes versions delegate ``gateway start`` to systemd / launchd,\n392\t    which spawn the gateway in a fresh env that does NOT inherit the\n393\t    HTTPS_PROXY / CA env we inject — trace capture would silently fail.\n394\t    ``gateway run`` is the foreground equivalent (it's exactly what the\n395\t    systemd unit's ``ExecStart=`` invokes), so the spawned process is our\n396\t    child and inherits the injected env.\n397\t\n398\t    Hermes' CLI shape is ``hermes [global-options] <command> [...]``, so the\n399\t    rewrite skips any recognised leading global options before matching\n400\t    ``gateway start``.\n401\t    \"\"\"\n402\t    if client != \"hermes\":\n403\t        return cmd_args\n404\t    i = 0\n405\t    while i < len(cmd_args):\n406\t        arg = cmd_args[i]\n407\t        if arg in _HERMES_GLOBAL_OPTS_WITH_VALUE and i + 1 < len(cmd_args):\n408\t            i += 2\n409\t            continue\n410\t        if \"=\" in arg and arg.split(\"=\", 1)[0] in _HERMES_GLOBAL_OPTS_WITH_VALUE:\n411\t            i += 1\n412\t            continue\n413\t        if arg in _HERMES_GLOBAL_BOOLEAN_OPTS:\n414\t            i += 1\n415\t            continue\n416\t        break\n417\t    if i + 1 < len(cmd_args) and cmd_args[i] == \"gateway\" and cmd_args[i + 1] == \"start\":\n418\t        print(\n419\t            \"ℹ️  Rewriting `hermes gateway start` to `hermes gateway run` so the \"\n420\t            \"gateway runs in the foreground under claude-tap. Recent hermes \"\n421\t            \"versions delegate `gateway start` to systemd / launchd, which spawns \"\n422\t            \"the gateway in a fresh env that does NOT inherit the proxy / CA env \"\n423\t            \"we inject — trace capture would silently fail. Pass --tap-no-launch \"\n424\t            \"and start the gateway yourself if you want the daemonised behaviour.\"\n425\t        )\n426\t        return cmd_args[:i] + [\"gateway\", \"run\"] + cmd_args[i + 2 :]\n427\t    return cmd_args\n428\t\n429\t\n430\tdef _extend_no_proxy(env: dict[str, str], values: tuple[str, ...]) -> None:\n431\t    \"\"\"Append local proxy bypasses without discarding existing settings.\"\"\"\n432\t    existing: list[str] = []\n433\t    for key in (\"NO_PROXY\", \"no_proxy\"):\n434\t        raw = env.get(key, \"\")\n435\t        existing.extend(part.strip() for part in raw.split(\",\") if part.strip())\n436\t\n437\t    merged: list[str] = []\n438\t    seen: set[str] = set()\n439\t    for value in [*existing, *values]:\n440\t        lowered = value.lower()\n441\t        if lowered in seen:\n442\t            continue\n443\t        seen.add(lowered)\n444\t        merged.append(value)\n445\t\n446\t    no_proxy = \",\".join(merged)\n447\t    env[\"NO_PROXY\"] = no_proxy\n448\t    env[\"no_proxy\"] = no_proxy\n449\t\n450\t\n451\tdef _has_config_override(args: list[str], key: str) -> bool:\n452\t    \"\"\"Return True when argv already contains a matching -c/--config override.\"\"\"\n453\t    prefixes = (f\"{key}=\",)\n454\t    i = 0\n455\t    while i < len(args):\n456\t        arg = args[i]\n457\t        if arg in (\"-c\", \"--config\"):\n458\t            if i + 1 < len(args) and args[i + 1].startswith(prefixes):\n459\t                return True\n460\t            i += 2\n461\t            continue\n462\t        if arg.startswith(\"--config=\"):\n463\t            value = arg.split(\"=\", 1)[1]\n464\t            if value.startswith(prefixes):\n465\t                return True\n466\t        i += 1\n467\t    return False\n468\t\n469\t\n470\tdef _has_settings_arg(args: list[str]) -> bool:\n471\t    return any(arg == \"--settings\" or arg.startswith(\"--settings=\") for arg in args)\n472\t\n473\t\n474\tdef _settings_arg(env_values: dict[str, str]) -> list[str]:\n475\t    settings_payload = {\"env\": env_values}\n476\t    return [\"--settings\", json.dumps(settings_payload, separators=(\",\", \":\"))]\n477\t\n478\t\n479\tasync def async_main(args: argparse.Namespace):\n480\t    output_dir = Path(args.output_dir)\n481\t    output_dir.mkdir(parents=True, exist_ok=True)\n482\t\n483\t    now = datetime.now()\n484\t    date_str = now.strftime(\"%Y-%m-%d\")\n485\t    time_str = now.strftime(\"%H%M%S\")\n486\t    ts = now.strftime(\"%Y%m%d_%H%M%S\")  # kept for manifest compatibility\n487\t    date_dir = output_dir / date_str\n488\t    date_dir.mkdir(parents=True, exist_ok=True)\n489\t    trace_path = date_dir / f\"trace_{time_str}.jsonl\"\n490\t    log_path = date_dir / f\"trace_{time_str}.log\"\n491\t\n492\t    # Start live viewer server if requested\n493\t    live_server: LiveViewerServer | None = None\n494\t    if args.live_viewer:\n495\t        live_server = LiveViewerServer(trace_path, port=args.live_port, host=args.host, output_dir=output_dir)\n496\t        await live_server.start()\n497\t        print(f\"🌐 Live viewer: {live_server.url}\")\n498\t        _open_browser(live_server.url)\n499\t\n500\t    writer = TraceWriter(trace_path, live_server=live_server)\n501\t\n502\t    # Proxy logs go to file, not terminal (avoids polluting Claude TUI)\n503\t    file_handler = logging.FileHandler(log_path, encoding=\"utf-8\")\n504\t    file_handler.setFormatter(logging.Formatter(\"%(asctime)s %(message)s\", datefmt=\"%H:%M:%S\"))\n505\t    log.addHandler(file_handler)\n506\t    log.setLevel(logging.DEBUG)\n507\t    # Suppress aiohttp logs from polluting the terminal\n508\t    logging.getLogger(\"aiohttp.access\").setLevel(logging.WARNING)\n509\t    # Redirect aiohttp.server errors (e.g. broken connections) to log file only\n510\t    aiohttp_server_log = logging.getLogger(\"aiohttp.server\")\n511\t    aiohttp_server_log.addHandler(file_handler)\n512\t    aiohttp_server_log.propagate = False\n513\t    # uvloop emits TLS shutdown warnings through the asyncio logger.\n514\t    # Keep them in the trace log rather than printing them into the client TUI.\n515\t    asyncio_log = logging.getLogger(\"asyncio\")\n516\t    asyncio_log.addHandler(file_handler)\n517\t    asyncio_log.propagate = False\n518\t\n519\t    # Honor system proxy env (HTTP_PROXY/HTTPS_PROXY/ALL_PROXY/NO_PROXY) for\n520\t    # outbound upstream requests. This is important when users route traffic\n521\t    # through tools like Clash/VPN.\n522\t    session = aiohttp.ClientSession(auto_decompress=False, trust_env=True)\n523\t\n524\t    # Forward proxy mode: raw TCP server with CONNECT/TLS termination\n525\t    # Reverse proxy mode: aiohttp web app (current behavior)\n526\t    forward_server: ForwardProxyServer | None = None\n527\t    runner: web.AppRunner | None = None\n528\t    ca_cert_path: Path | None = None\n529\t\n530\t    if args.proxy_mode == \"forward\":\n531\t        ca_cert_path, ca_key_path = ensure_ca()\n532\t        ca = CertificateAuthority(ca_cert_path, ca_key_path)\n533\t        forward_server = ForwardProxyServer(\n534\t            host=args.host,\n535\t            port=args.port,\n536\t            ca=ca,\n537\t            writer=writer,\n538\t            session=session,\n539\t        )\n540\t        actual_port = await forward_server.start()\n541\t        print(f\"🔍 claude-tap v{__version__} forward proxy on http://{args.host}:{actual_port}\")\n542\t        print(f\"   CA cert: {ca_cert_path}\")\n543\t    else:\n544\t        app = web.Application(client_max_size=0)  # No body size limit (proxy must forward everything)\n545\t        app[\"trace_ctx\"] = {\n546\t            \"target_url\": args.target,\n547\t            \"writer\": writer,\n548\t            \"session\": session,\n549\t            \"turn_counter\": 0,\n550\t            \"extra_allowed_path_prefixes\": tuple(args.extra_allowed_paths),\n551\t            **_reverse_proxy_trace_options(args.client, args.target),\n552\t        }\n553\t        app.router.add_route(\"*\", \"/{path_info:.*}\", proxy_handler)\n554\t\n555\t        runner = web.AppRunner(app)\n556\t        await runner.setup()\n557\t        site = web.TCPSite(runner, args.host, args.port)\n558\t        await site.start()\n559\t\n560\t        # Resolve actual port (site._server is a private API; fall back to args.port)\n561\t        try:\n562\t            actual_port = site._server.sockets[0].getsockname()[1]\n563\t        except (AttributeError, IndexError, OSError):\n564\t            actual_port = args.port\n565\t        print(f\"🔍 claude-tap v{__version__} listening on http://{args.host}:{actual_port}\")\n566\t\n567\t    print(f\"📁 Trace file: {trace_path}\")\n568\t\n569\t    # Background update check\n570\t    if not args.no_update_check:\n571\t        try:\n572\t            latest = await _check_pypi_version()\n573\t            if latest and _version_tuple(latest) > _version_tuple(__version__):\n574\t                print(f\"⬆️  Update available: {__version__} → {latest}\")\n575\t                if not args.no_auto_update:\n576\t                    installer = _detect_installer()\n577\t                    _start_background_update(installer)\n578\t                    print(f\"   Downloading update in background ({installer})...\")\n579\t        except Exception:\n580\t            pass\n581\t\n582\t    exit_code = 0\n583\t    client_started_at = time.time()\n584\t    try:\n585\t        if not args.no_launch:\n586\t            client_started_at = time.time()\n587\t            try:\n588\t                exit_code = await run_client(\n589\t                    actual_port,\n590\t                    args.claude_args,\n591\t                    client=args.client,\n592\t                    proxy_mode=args.proxy_mode,\n593\t                    ca_cert_path=ca_cert_path,\n594\t                )\n595\t            except asyncio.CancelledError:\n596\t                pass\n597\t        else:\n598\t            print(\"\\n--no-launch mode: proxy running. Press Ctrl+C to stop.\")\n599\t            try:\n600\t                while True:\n601\t                    await asyncio.sleep(3600)\n602\t            except asyncio.CancelledError:\n603\t                pass\n604\t    finally:\n605\t        if forward_server:\n606\t            try:\n607\t                await asyncio.wait_for(forward_server.stop(), timeout=10)\n608\t            except asyncio.TimeoutError:\n609\t                log.warning(\"Timed out stopping forward proxy\")\n610\t            except Exception:\n611\t                pass\n612\t        if runner:\n613\t            try:\n614\t                await runner.cleanup()\n615\t            except Exception:\n616\t                pass\n617\t\n618\t        # Stop live viewer server if running\n619\t        if live_server:\n620\t            try:\n621\t                await live_server.stop()\n622\t            except Exception:\n623\t                pass\n624\t        try:\n625\t            await asyncio.wait_for(session.close(), timeout=5)\n626\t        except asyncio.TimeoutError:\n627\t            log.warning(\"Timed out closing upstream HTTP session\")\n628\t        except Exception:\n629\t            pass\n630\t\n631\t        if args.client == \"cursor\" and not args.no_launch:\n632\t            imported = await import_cursor_transcripts(writer, since=client_started_at)\n633\t            if imported:\n634\t                print(f\"   Cursor transcript turns: {imported}\")\n635\t\n636\t        # Close writer before generating HTML\n637\t        writer.close()\n638\t\n639\t        # Generate self-contained HTML viewer\n640\t        html_path = trace_path.with_suffix(\".html\")\n641\t        _generate_html_viewer(trace_path, html_path)\n642\t\n643\t        # Register trace and cleanup old ones\n644\t        trace_files = [_rel_posix(trace_path, output_dir), _rel_posix(log_path, output_dir)]\n645\t        if html_path.exists():\n646\t            trace_files.append(_rel_posix(html_path, output_dir))\n647\t        _register_trace(output_dir, ts, trace_files)\n648\t        if args.max_traces > 0:\n649\t            cleaned = _cleanup_traces(output_dir, args.max_traces)\n650\t            if cleaned:\n651\t                print(f\"\\n🧹 Cleaned up {cleaned} old trace(s)\")\n652\t\n653\t        # Print summary with cost estimation\n654\t        stats = writer.get_summary()\n655\t        print(\"\\n📊 Trace summary:\")\n656\t        print(f\"   API calls: {stats['api_calls']}\")\n657\t\n658\t        # Token breakdown\n659\t        total_tokens = stats[\"input_tokens\"] + stats[\"output_tokens\"]\n660\t        if total_tokens > 0:\n661\t            print(f\"   Tokens: {stats['input_tokens']:,} in / {stats['output_tokens']:,} out\", end=\"\")\n662\t            if stats[\"cache_read_tokens\"] > 0:\n663\t                print(f\" / {stats['cache_read_tokens']:,} cache_read\", end=\"\")\n664\t            if stats[\"cache_create_tokens\"] > 0:\n665\t                print(f\" / {stats['cache_create_tokens']:,} cache_write\", end=\"\")\n666\t            print()\n667\t\n668\t        # Output files\n669\t        print(f\"   Trace: {trace_path}\")\n670\t        print(f\"   Log:   {log_path}\")\n671\t        print(f\"   View:  {html_path}\")\n672\t\n673\t        # Open viewer in browser (default: auto-open unless --tap-no-open)\n674\t        if args.open_viewer and html_path.exists():\n675\t            print(\"\\n🌐 Opening viewer in browser...\")\n676\t            _open_browser(html_path.absolute().as_uri())\n677\t\n678\t    return exit_code\n679\t\n680\t\n681\t_CODEX_CHATGPT_TARGET = \"https://chatgpt.com/backend-api/codex\"\n682\t\n683\t\n684\tdef _read_settings_env_base_url(path: Path, env_key: str) -> str | None:\n685\t    \"\"\"Read a provider base URL from a Claude-style settings file.\"\"\"\n686\t    try:\n687\t        data = json.loads(path.read_text(encoding=\"utf-8\"))\n688\t    except (OSError, json.JSONDecodeError, ValueError):\n689\t        return None\n690\t    if not isinstance(data, dict):\n691\t        return None\n692\t    env = data.get(\"env\")\n693\t    if not isinstance(env, dict):\n694\t        return None\n695\t    value = env.get(env_key)\n696\t    if not isinstance(value, str):\n697\t        return None\n698\t    value = value.strip()\n699\t    return value or None\n700\t\n701\t\n702\tdef _detect_claude_target() -> str:\n703\t    \"\"\"Auto-detect the upstream target Claude Code would normally use.\n704\t\n705\t    Claude Code can source ``ANTHROPIC_BASE_URL`` from settings files rather\n706\t    than the process environment. Mirror that behavior so reverse proxy mode\n707\t    captures custom gateways without forcing users to repeat ``--tap-target``.\n708\t    \"\"\"\n709\t    env_target = os.environ.get(\"ANTHROPIC_BASE_URL\", \"\").strip()\n710\t    if env_target:\n711\t        return env_target\n712\t\n713\t    env_key = CLIENT_CONFIGS[\"claude\"].base_url_env\n714\t    candidate_paths = (\n715\t        Path.cwd() / \".claude\" / \"settings.local.json\",\n716\t        Path.cwd() / \".claude\" / \"settings.json\",\n717\t        Path.home() / \".claude\" / \"settings.json\",\n718\t    )\n719\t    for path in candidate_paths:\n720\t        target = _read_settings_env_base_url(path, env_key)\n721\t        if target:\n722\t            return target\n723\t    return CLIENT_CONFIGS[\"claude\"].default_target\n724\t\n725\t\n726\tdef _reverse_proxy_trace_options(client: str, target: str) -> dict[str, object]:\n727\t    cfg = CLIENT_CONFIGS[client]\n728\t    return {\n729\t        \"strip_path_prefix\": cfg.reverse_strip_path_prefix(target),\n730\t        \"force_http\": False,\n731\t    }\n732\t\n733\t\n734\tdef _detect_codex_target() -> str:\n735\t    \"\"\"Auto-detect the correct upstream target for Codex CLI.\n736\t\n737\t    Reads ``~/.codex/auth.json`` (or ``$CODEX_HOME/auth.json``) to determine\n738\t    the auth mode.  ChatGPT OAuth users (``codex login``) need the chatgpt.com\n739\t    backend; API-key users use api.openai.com.\n740\t    \"\"\"\n741\t    codex_home = Path(os.environ.get(\"CODEX_HOME\") or Path.home() / \".codex\")\n742\t    auth_file = codex_home / \"auth.json\"\n743\t    try:\n744\t        data = json.loads(auth_file.read_text(encoding=\"utf-8\"))\n745\t        if isinstance(data, dict) and data.get(\"auth_mode\") == \"chatgpt\":\n746\t            return _CODEX_CHATGPT_TARGET\n747\t    except (OSError, json.JSONDecodeError, ValueError):\n748\t        pass\n749\t    return CLIENT_CONFIGS[\"codex\"].default_target\n750\t\n751\t\n752\tTARGET_DETECTORS = {\n753\t    \"claude\": _detect_claude_target,\n754\t    \"codex\": _detect_codex_target,\n755\t}\n756\t\n757\t\n758\tdef parse_args(argv: list[str] | None = None) -> argparse.Namespace:\n759\t    \"\"\"Parse argv, extracting ``--tap-*`` flags for ourselves and forwarding\n760\t    everything else to the selected client.\n761\t    \"\"\"\n762\t    if argv is None:\n763\t        argv = sys.argv[1:]\n764\t\n765\t    tap_parser = argparse.ArgumentParser(\n766\t        prog=\"claude-tap\",\n767\t        description=(\n768\t            \"Trace Claude Code, Codex CLI, Gemini CLI, Kimi CLI, OpenCode, Pi, Hermes Agent, \"\n769\t            \"Cursor CLI, or Qoder CLI API requests via a local proxy. All flags not listed below are \"\n770\t            \"forwarded to the selected client.\"\n771\t        ),\n772\t        epilog=(\n773\t            \"claude code:\\n\"\n774\t            \"  claude-tap                            Basic tracing\\n\"\n775\t            \"  claude-tap --tap-live                 Real-time viewer in browser\\n\"\n776\t            \"  claude-tap -- --model claude-opus-4-6  Pass flags to Claude Code\\n\"\n777\t            \"  claude-tap -- -c                      Continue last conversation\\n\"\n778\t            \"  claude-tap -- --dangerously-skip-permissions  Auto-accept tool calls\\n\"\n779\t            \"  claude-tap --tap-live -- --dangerously-skip-permissions --model claude-sonnet-4-6\\n\"\n780\t            \"\\n\"\n781\t            \"codex cli:\\n\"\n782\t            \"  # Target is auto-detected from Codex auth state when possible\\n\"\n783\t            \"  claude-tap --tap-client codex\\n\"\n784\t            \"  # If auto-detection cannot read Codex auth, specify OAuth target explicitly\\n\"\n785\t            \"  claude-tap --tap-client codex --tap-target https://chatgpt.com/backend-api/codex\\n\"\n786\t            \"  # With model and full auto-approval\\n\"\n787\t            \"  claude-tap --tap-client codex -- --model codex-mini-latest --full-auto\\n\"\n788\t            \"\\n\"\n789\t            \"kimi cli:\\n\"\n790\t            \"  # Uses KIMI_BASE_URL and forwards to Kimi Code by default\\n\"\n791\t            \"  claude-tap --tap-client kimi\\n\"\n792\t            \"  claude-tap --tap-client kimi -- --thinking\\n\"\n793\t            \"  # Use Moonshot Open Platform instead of Kimi Code\\n\"\n794\t            \"  claude-tap --tap-client kimi --tap-target https://api.moonshot.ai/v1\\n\"\n795\t            \"\\n\"\n796\t            \"gemini cli (defaults to forward proxy mode):\\n\"\n797\t            '  claude-tap --tap-client gemini -- -p \"hello\"\\n'\n798\t            \"  # Reverse mode sets GOOGLE_GEMINI_BASE_URL and GOOGLE_VERTEX_BASE_URL\\n\"\n799\t            \"  claude-tap --tap-client gemini --tap-proxy-mode reverse\\n\"\n800\t            \"\\n\"\n801\t            \"opencode (multi-provider; defaults to forward proxy mode):\\n\"\n802\t            \"  # Forward proxy captures every provider opencode talks to\\n\"\n803\t            \"  claude-tap --tap-client opencode\\n\"\n804\t            \"  # Force reverse mode (single ANTHROPIC_BASE_URL provider only)\\n\"\n805\t            \"  claude-tap --tap-client opencode --tap-proxy-mode reverse\\n\"\n806\t            \"\\n\"\n807\t            \"pi (multi-provider; defaults to forward proxy mode):\\n\"\n808\t            \"  # Forward proxy captures OpenAI Codex OAuth and other providers\\n\"\n809\t            '  claude-tap --tap-client pi -- --model openai-codex/gpt-5.3-codex-spark -p \"hello\"\\n'\n810\t            \"  # Pi OAuth is configured with /login inside pi, or via PI_CODING_AGENT_DIR\\n\"\n811\t            \"\\n\"\n812\t            \"hermes agent (multi-provider Python agent — forward proxy default):\\n\"\n813\t            \"  # Interactive TUI — captures LLM calls directly\\n\"\n814\t            \"  claude-tap --tap-client hermes --tap-live\\n\"\n815\t            \"  # Gateway mode — captures LLM calls triggered by Slack/Telegram/etc. messages\\n\"\n816\t            \"  #   (requires messaging platform configured in ~/.hermes/.env)\\n\"\n817\t            \"  claude-tap --tap-client hermes -- gateway start\\n\"\n818\t            \"\\n\"\n819\t            \"cursor cli (defaults to forward proxy mode):\\n\"\n820\t            '  claude-tap --tap-client cursor -- -p --trust --model auto \"hello\"\\n'\n821\t            \"  # Cursor readable messages are imported from local transcripts after exit\\n\"\n822\t            \"\\n\"\n823\t            \"qoder cli (defaults to forward proxy mode):\\n\"\n824\t            '  claude-tap --tap-client qoder -- -p \"hello\" --permission-mode dont_ask\\n'\n825\t            \"  # Authenticate first with `qodercli login` or QODER_PERSONAL_ACCESS_TOKEN / QODER_JOB_TOKEN\\n\"\n826\t            \"\\n\"\n827\t            \"proxy-only mode (connect from another terminal):\\n\"\n828\t            \"  claude-tap --tap-no-launch --tap-port 8080\\n\"\n829\t            \"  # then: ANTHROPIC_BASE_URL=http://127.0.0.1:8080 claude\\n\"\n830\t            \"\\n\"\n831\t            \"export traces:\\n\"\n832\t            \"  claude-tap export trace.jsonl              Export to markdown\\n\"\n833\t            \"  claude-tap export trace.jsonl -o out.md    Export to file\\n\"\n834\t            \"  claude-tap export trace.jsonl --format json Export as JSON\\n\"\n835\t            \"  claude-tap export trace.jsonl -o out.html  Export as HTML viewer\\n\"\n836\t            \"\\n\"\n837\t            \"update:\\n\"\n838\t            \"  claude-tap update                          Upgrade claude-tap in place\\n\"\n839\t            \"  claude-tap update --installer pip          Force pip-based upgrade\\n\"\n840\t            \"\\n\"\n841\t            \"dashboard:\\n\"\n842\t            \"  claude-tap dashboard                       Browse trace history\\n\"\n843\t            \"  claude-tap dashboard --tap-live-port 3000  Use a fixed dashboard port\\n\"\n844\t            \"\\n\"\n845\t            \"homepage: https://github.com/liaohch3/claude-tap\"\n846\t        ),\n847\t        formatter_class=argparse.RawDescriptionHelpFormatter,\n848\t    )\n849\t    tap_parser.add_argument(\"-v\", \"--version\", action=\"version\", version=f\"%(prog)s {__version__}\")\n850\t\n851\t    # -- Proxy options --\n852\t    proxy_group = tap_parser.add_argument_group(\"proxy options\")\n853\t    proxy_group.add_argument(\"--tap-port\", type=int, default=0, dest=\"port\", help=\"Proxy port (default: auto)\")\n854\t    proxy_group.add_argument(\n855\t        \"--tap-host\",\n856\t        default=None,\n857\t        dest=\"host\",\n858\t        help=\"Bind address (default: 127.0.0.1, or 0.0.0.0 with --tap-no-launch)\",\n859\t    )\n860\t    proxy_group.add_argument(\n861\t        \"--tap-client\",\n862\t        choices=sorted(CLIENT_CONFIGS.keys()),\n863\t        default=\"claude\",\n864\t        dest=\"client\",\n865\t        help=\"Client to launch (default: claude)\",\n866\t    )\n867\t    proxy_group.add_argument(\n868\t        \"--tap-target\",\n869\t        default=None,\n870\t        dest=\"target\",\n871\t        help=\"Upstream API URL (default: auto-detected from auth state)\",\n872\t    )\n873\t    proxy_group.add_argument(\n874\t        \"--tap-proxy-mode\",\n875\t        choices=[\"reverse\", \"forward\"],\n876\t        default=None,\n877\t        dest=\"proxy_mode\",\n878\t        help=(\n879\t            \"'reverse' sets provider base URL, 'forward' sets HTTPS_PROXY with CONNECT/TLS termination. \"\n880\t            \"Default depends on the client: 'reverse' for claude/codex/kimi, \"\n881\t            \"'forward' for gemini/opencode/pi/hermes/cursor/qoder.\"\n882\t        ),\n883\t    )\n884\t    proxy_group.add_argument(\n885\t        \"--tap-no-launch\", action=\"store_true\", dest=\"no_launch\", help=\"Only start the proxy, don't launch client\"\n886\t    )\n887\t    proxy_group.add_argument(\n888\t        \"--tap-allow-path\",\n889\t        action=\"append\",\n890\t        default=[],\n891\t        dest=\"extra_allowed_paths\",\n892\t        metavar=\"PREFIX\",\n893\t        help=\"Extra path prefix to allow through the proxy (can be repeated, e.g. --tap-allow-path /custom/api)\",\n894\t    )\n895\t\n896\t    # -- Viewer options --\n897\t    viewer_group = tap_parser.add_argument_group(\"viewer options\")\n898\t    viewer_group.add_argument(\n899\t        \"--tap-no-open\",\n900\t        action=\"store_false\",\n901\t        dest=\"open_viewer\",\n902\t        default=True,\n903\t        help=\"Don't auto-open HTML viewer after exit\",\n904\t    )\n905\t    viewer_group.add_argument(\n906\t        \"--tap-live\",\n907\t        action=\"store_true\",\n908\t        dest=\"live_viewer\",\n909\t        help=\"Start real-time viewer server (auto-opens browser)\",\n910\t    )\n911\t    viewer_group.add_argument(\n912\t        \"--tap-live-port\",\n913\t        type=int,\n914\t        default=0,\n915\t        dest=\"live_port\",\n916\t        help=\"Port for live viewer server (default: auto)\",\n917\t    )\n918\t\n919\t    # -- Storage & update options --\n920\t    storage_group = tap_parser.add_argument_group(\"storage and update options\")\n921\t    storage_group.add_argument(\n922\t        \"--tap-output-dir\", default=\"./.traces\", dest=\"output_dir\", help=\"Trace output directory (default: ./.traces)\"\n923\t    )\n924\t    storage_group.add_argument(\n925\t        \"--tap-max-traces\",\n926\t        type=int,\n927\t        default=50,\n928\t        dest=\"max_traces\",\n929\t        help=\"Max trace sessions to keep (default: 50, 0 = unlimited)\",\n930\t    )\n931\t    storage_group.add_argument(\n932\t        \"--tap-no-update-check\",\n933\t        action=\"store_true\",\n934\t        dest=\"no_update_check\",\n935\t        help=\"Disable PyPI update check on startup\",\n936\t    )\n937\t    storage_group.add_argument(\n938\t        \"--tap-no-auto-update\",\n939\t        action=\"store_true\",\n940\t        dest=\"no_auto_update\",\n941\t        help=\"Check for updates but don't auto-download\",\n942\t    )\n943\t    args, claude_args = tap_parser.parse_known_args(argv)\n944\t    # Strip leading \"--\" separator if present (argparse leaves it in remainder)\n945\t    if claude_args and claude_args[0] == \"--\":\n946\t        claude_args = claude_args[1:]\n947\t    args.claude_args = claude_args\n948\t    # Default host: 0.0.0.0 in --tap-no-launch mode (proxy-only, typically remote),\n949\t    # 127.0.0.1 otherwise (launching the client locally).\n950\t    if args.host is None:\n951\t        args.host = \"0.0.0.0\" if args.no_launch else \"127.0.0.1\"\n952\t    if args.target is None:\n953\t        detector = TARGET_DETECTORS.get(args.client)\n954\t        args.target = detector() if detector else CLIENT_CONFIGS[args.client].default_target\n955\t    if args.proxy_mode is None:\n956\t        args.proxy_mode = CLIENT_CONFIGS[args.client].default_proxy_mode\n957\t\n958\t    # Validate --tap-allow-path prefixes\n959\t    for prefix in args.extra_allowed_paths:\n960\t        if not prefix:\n961\t            tap_parser.error(\"--tap-allow-path cannot be empty\")\n962\t        if not prefix.startswith(\"/\"):\n963\t            tap_parser.error(f\"--tap-allow-path '{prefix}' must start with '/'\")\n964\t        if prefix == \"/\":\n965\t            tap_parser.error(\"--tap-allow-path '/' is too broad and not allowed\")\n966\t        if prefix.endswith(\"/\"):\n967\t            tap_parser.error(f\"--tap-allow-path '{prefix}' must not end with '/' (specify exact prefix)\")\n968\t\n969\t    return args\n970\t\n971\t\n972\tdef parse_dashboard_args(argv: list[str] | None = None) -> argparse.Namespace:\n973\t    \"\"\"Parse arguments for the standalone dashboard command.\"\"\"\n974\t    parser = argparse.ArgumentParser(\n975\t        prog=\"claude-tap dashboard\",\n976\t        description=\"Open a local claude-tap dashboard for browsing trace history.\",\n977\t    )\n978\t    parser.add_argument(\n979\t        \"--tap-output-dir\",\n980\t        default=\"./.traces\",\n981\t        dest=\"output_dir\",\n982\t        help=\"Trace output directory to browse (default: ./.traces)\",\n983\t    )\n984\t    parser.add_argument(\n985\t        \"--tap-live-port\",\n986\t        type=int,\n987\t        default=0,\n988\t        dest=\"live_port\",\n989\t        help=\"Dashboard server port (default: auto)\",\n990\t    )\n991\t    parser.add_argument(\n992\t        \"--tap-host\",\n993\t        default=\"127.0.0.1\",\n994\t        dest=\"host\",\n995\t        help=\"Bind address (default: 127.0.0.1)\",\n996\t    )\n997\t    parser.add_argument(\n998\t        \"--tap-no-open\",\n999\t        action=\"store_false\",\n1000\t        dest=\"open_viewer\",\n1001\t        default=True,\n1002\t        help=\"Don't auto-open the dashboard in a browser\",\n1003\t    )\n1004\t    return parser.parse_args(argv)\n1005\t\n1006\t\n1007\tasync def dashboard_main(args: argparse.Namespace) -> int:\n1008\t    \"\"\"Run the standalone dashboard until interrupted.\"\"\"\n1009\t    output_dir = Path(args.output_dir)\n1010\t    output_dir.mkdir(parents=True, exist_ok=True)\n1011\t\n1012\t    now = datetime.now()\n1013\t    date_dir = output_dir / now.strftime(\"%Y-%m-%d\")\n1014\t    date_dir.mkdir(parents=True, exist_ok=True)\n1015\t    trace_path = date_dir / f\"dashboard_{now.strftime('%H%M%S')}.jsonl\"\n1016\t\n1017\t    server = LiveViewerServer(trace_path, port=args.live_port, host=args.host, output_dir=output_dir)\n1018\t    await server.start()\n1019\t    print(f\"🌐 claude-tap dashboard: {server.url}\")\n1020\t    print(f\"📁 Trace directory: {output_dir}\")\n1021\t    print(\"Press Ctrl+C to stop.\")\n1022\t    if args.open_viewer:\n1023\t        _open_browser(server.url)\n1024\t\n1025\t    try:\n1026\t        while True:\n1027\t            await asyncio.sleep(3600)\n1028\t    except asyncio.CancelledError:\n1029\t        pass\n1030\t    finally:\n1031\t        await server.stop()\n1032\t    return 0\n1033\t\n1034\t\n1035\t# ---------------------------------------------------------------------------\n1036\t# Smart update check\n1037\t# ---------------------------------------------------------------------------\n1038\t\n1039\t\n1040\tdef _version_tuple(v: str) -> tuple[int, ...]:\n1041\t    \"\"\"Parse '0.1.4' into (0, 1, 4) for comparison.\"\"\"\n1042\t    return tuple(int(x) for x in v.strip().split(\".\") if x.isdigit())\n1043\t\n1044\t\n1045\tasync def _check_pypi_version(timeout: float = 3.0) -> str | None:\n1046\t    \"\"\"Check PyPI for the latest version. Returns version string or None.\"\"\"\n1047\t    url = os.environ.get(\"CLAUDE_TAP_PYPI_URL\", \"https://pypi.org/pypi/claude-tap/json\")\n1048\t\n1049\t    def _fetch() -> str | None:\n1050\t        try:\n1051\t            req = urllib.request.Request(url, headers={\"Accept\": \"application/json\"})\n1052\t            with urllib.request.urlopen(req, timeout=timeout) as resp:\n1053\t                data = json.loads(resp.read())\n1054\t                return data.get(\"info\", {}).get(\"version\")\n1055\t        except Exception:\n1056\t            return None\n1057\t\n1058\t    loop = asyncio.get_running_loop()\n1059\t    return await loop.run_in_executor(None, _fetch)\n1060\t\n1061\t\n1062\tdef _detect_installer() -> str:\n1063\t    \"\"\"Detect whether claude-tap was installed via uv or pip.\"\"\"\n1064\t    exe = sys.executable or \"\"\n1065\t    if \"uv\" in exe.lower() or shutil.which(\"uv\"):\n1066\t        return \"uv\"\n1067\t    return \"pip\"\n1068\t\n1069\t\n1070\tdef _start_background_update(installer: str) -> subprocess.Popen | None:\n1071\t    \"\"\"Start a background process to upgrade claude-tap.\"\"\"\n1072\t    try:\n1073\t        cmd = _build_update_command(installer)\n1074\t        if cmd is None:\n1075\t            return None\n1076\t        return subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n1077\t    except Exception:\n1078\t        return None\n1079\t\n1080\t\n1081\tdef _build_update_command(installer: str) -> list[str] | None:\n1082\t    \"\"\"Build the foreground/background self-upgrade command.\"\"\"\n1083\t    if installer == \"uv\":\n1084\t        uv_path = shutil.which(\"uv\")\n1085\t        if uv_path is None:\n1086\t            return None\n1087\t        return [uv_path, \"tool\", \"upgrade\", \"claude-tap\"]\n1088\t    if installer == \"pip\":\n1089\t        return [sys.executable, \"-m\", \"pip\", \"install\", \"--upgrade\", \"claude-tap\"]\n1090\t    raise ValueError(f\"unsupported installer: {installer}\")\n1091\t\n1092\t\n1093\tdef parse_update_args(argv: list[str] | None = None) -> argparse.Namespace:\n1094\t    \"\"\"Parse arguments for the update subcommand.\"\"\"\n1095\t    parser = argparse.ArgumentParser(\n1096\t        prog=\"claude-tap update\",\n1097\t        description=\"Upgrade claude-tap using the detected installer.\",\n1098\t    )\n1099\t    parser.add_argument(\n1100\t        \"--installer\",\n1101\t        choices=[\"auto\", \"uv\", \"pip\"],\n1102\t        default=\"auto\",\n1103\t        help=\"Upgrade backend to use (default: auto-detect uv or pip)\",\n1104\t    )\n1105\t    parser.add_argument(\n1106\t        \"--dry-run\",\n1107\t        action=\"store_true\",\n1108\t        help=\"Print the upgrade command without running it\",\n1109\t    )\n1110\t    return parser.parse_args(argv)\n1111\t\n1112\t\n1113\tdef update_main(argv: list[str] | None = None) -> int:\n1114\t    \"\"\"Entry point for the update subcommand.\"\"\"\n1115\t    args = parse_update_args(argv)\n1116\t    installer = _detect_installer() if args.installer == \"auto\" else args.installer\n1117\t    cmd = _build_update_command(installer)\n1118\t    if cmd is None:\n1119\t        print(\"Error: 'uv' command not found. Re-run with --installer pip or install uv.\", file=sys.stderr)\n1120\t        return 1\n1121\t\n1122\t    printable_cmd = \" \".join(cmd)\n1123\t    print(f\"Upgrading claude-tap with {installer}: {printable_cmd}\")\n1124\t    if args.dry_run:\n1125\t        return 0\n1126\t\n1127\t    try:\n1128\t        result = subprocess.run(cmd, check=False)\n1129\t    except OSError as exc:\n1130\t        print(f\"Error: failed to run update command: {exc}\", file=sys.stderr)\n1131\t        return 1\n1132\t    return result.returncode\n1133\t\n1134\t\n1135\t# ---------------------------------------------------------------------------\n1136\t# Trace cleanup – manifest-based\n1137\t# ---------------------------------------------------------------------------\n1138\t\n1139\t_MANIFEST_FILE = \".cloudtap-manifest.json\"\n1140\t\n1141\t\n1142\tdef _rel_posix(path: Path, base: Path) -> str:\n1143\t    # Forward slashes so manifests stay portable when `.traces` is synced across OSes.\n1144\t    return path.relative_to(base).as_posix()\n1145\t\n1146\t\n1147\tdef _load_manifest(output_dir: Path) -> dict:\n1148\t    \"\"\"Load or create the manifest file.\"\"\"\n1149\t    manifest_path = output_dir / _MANIFEST_FILE\n1150\t    if manifest_path.exists():\n1151\t        try:\n1152\t            data = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n1153\t            if data.get(\"_cloudtap\"):\n1154\t                return data\n1155\t        except (json.JSONDecodeError, OSError):\n1156\t            pass\n1157\t    manifest = {\"_cloudtap\": True, \"version\": __version__, \"traces\": []}\n1158\t    _maybe_migrate_existing(output_dir, manifest)\n1159\t    _save_manifest(output_dir, manifest)\n1160\t    return manifest\n1161\t\n1162\t\n1163\tdef _save_manifest(output_dir: Path, manifest: dict) -> None:\n1164\t    \"\"\"Save manifest to disk.\"\"\"\n1165\t    manifest_path = output_dir / _MANIFEST_FILE\n1166\t    manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\n1167\t\n1168\t\n1169\tdef _register_trace(output_dir: Path, ts: str, trace_files: list[str]) -> dict:\n1170\t    \"\"\"Register a new trace session in the manifest.\"\"\"\n1171\t    manifest = _load_manifest(output_dir)\n1172\t    entry = {\n1173\t        \"timestamp\": ts,\n1174\t        \"files\": trace_files,\n1175\t        \"created_at\": datetime.now(timezone.utc).isoformat(),\n1176\t    }\n1177\t    manifest[\"traces\"].append(entry)\n1178\t    _save_manifest(output_dir, manifest)\n1179\t    return manifest\n1180\t\n1181\t\n1182\tdef _cleanup_traces(output_dir: Path, max_traces: int) -> int:\n1183\t    \"\"\"Remove oldest traces exceeding max_traces. Returns count of deleted sessions.\"\"\"\n1184\t    if max_traces <= 0:\n1185\t        return 0\n1186\t    manifest = _load_manifest(output_dir)\n1187\t    traces = manifest.get(\"traces\", [])\n1188\t    if len(traces) <= max_traces:\n1189\t        return 0\n1190\t    traces.sort(key=lambda t: t.get(\"timestamp\", \"\"))\n1191\t    to_remove = traces[: len(traces) - max_traces]\n1192\t    removed = 0\n1193\t    for entry in to_remove:\n1194\t        parents_to_check: set[Path] = set()\n1195\t        for fname in entry.get(\"files\", []):\n1196\t            fpath = output_dir / fname\n1197\t            if fpath.exists():\n1198\t                parents_to_check.add(fpath.parent)\n1199\t                try:\n1200\t                    fpath.unlink()\n1201\t                except OSError:\n1202\t                    pass\n1203\t        # Remove empty date subdirectories\n1204\t        for parent in parents_to_check:\n1205\t            if parent != output_dir and parent.is_dir() and not any(parent.iterdir()):\n1206\t                try:\n1207\t                    parent.rmdir()\n1208\t                except OSError:\n1209\t                    pass\n1210\t        traces.remove(entry)\n1211\t        removed += 1\n1212\t    manifest[\"traces\"] = traces\n1213\t    _save_manifest(output_dir, manifest)\n1214\t    return removed\n1215\t\n1216\t\n1217\tdef _maybe_migrate_existing(output_dir: Path, manifest: dict) -> None:\n1218\t    \"\"\"Auto-register existing trace_*.jsonl files that are not yet in the manifest.\"\"\"\n1219\t    # Normalize separators so manifests written by older Windows builds (with `\\`) still match.\n1220\t    known_files: set[str] = {\n1221\t        f.replace(\"\\\\\", \"/\") for entry in manifest.get(\"traces\", []) for f in entry.get(\"files\", [])\n1222\t    }\n1223\t\n1224\t    for jsonl in sorted(output_dir.glob(\"**/trace_*.jsonl\")):\n1225\t        rel = _rel_posix(jsonl, output_dir)\n1226\t        if rel in known_files or jsonl.name in known_files:\n1227\t            continue\n1228\t        stem = jsonl.stem\n1229\t        ts = stem.replace(\"trace_\", \"\", 1)\n1230\t        # Prefix with date dir if present\n1231\t        if jsonl.parent != output_dir:\n1232\t            ts = jsonl.parent.name.replace(\"-\", \"\") + \"_\" + ts\n1233\t        files = [rel]\n1234\t        for suffix in [\".log\", \".html\"]:\n1235\t            companion = jsonl.with_suffix(suffix)\n1236\t            if companion.exists():\n1237\t                files.append(_rel_posix(companion, output_dir))\n1238\t        manifest[\"traces\"].append(\n1239\t            {\n1240\t                \"timestamp\": ts,\n1241\t                \"files\": files,\n1242\t                \"created_at\": datetime.fromtimestamp(jsonl.stat().st_mtime, tz=timezone.utc).isoformat(),\n1243\t            }\n1244\t        )\n1245\t\n1246\t\n1247\tdef main_entry() -> None:\n1248\t    \"\"\"Entry point for the claude-tap CLI.\"\"\"\n1249\t    # Check if first argument is \"export\" subcommand\n1250\t    if len(sys.argv) > 1 and sys.argv[1] == \"export\":\n1251\t        from claude_tap.export import export_main\n1252\t\n1253\t        sys.exit(export_main(sys.argv[2:]))\n1254\t\n1255\t    if len(sys.argv) > 1 and sys.argv[1] == \"update\":\n1256\t        sys.exit(update_main(sys.argv[2:]))\n1257\t\n1258\t    if len(sys.argv) > 1 and sys.argv[1] == \"dashboard\":\n1259\t        args = parse_dashboard_args(sys.argv[2:])\n1260\t        try:\n1261\t            code = asyncio.run(dashboard_main(args))\n1262\t        except KeyboardInterrupt:\n1263\t            code = 0\n1264\t        sys.exit(code)\n1265\t\n1266\t    args = parse_args()\n1267\t    try:\n1268\t        code = asyncio.run(async_main(args))\n1269\t    except KeyboardInterrupt:\n1270\t        code = 0\n1271\t    sys.exit(code)\n1272\t"}]}
