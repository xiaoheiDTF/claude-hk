46\t}\n47\t\n48\t# 3. 目录完整性\n49\tensure_dirs() {\n50\t  source \"$CLAUDE_PROJECT_DIR/.claude/scripts/ensure_dirs.sh\"\n51\t  local missing\n52\t  missing=$(check_dirs 2>&1)\n53\t  if [ \"$missing\" = \"ALL OK\" ]; then\n54\t    log \"INFO\" \"目录检查通过\"\n55\t  else\n56\t    log \"WARN\" \"目录缺失，重新创建: $missing\"\n57\t    ensure_all_dirs \"$LOG_FILE\" > /dev/null\n58\t  fi\n59\t}\n60\t\n61\tensure_utf8\n62\tensure_python_check\n63\tensure_dirs\n64\t\n65\t# 4. Skill 级巡检\n66\tensure_skill_checks() {\n67\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n68\t  [ -d \"$skills_dir\" ] || return\n69\t  for check_script in \"$skills_dir\"/*/scripts/init_check.sh; do\n70\t    [ -f \"$check_script\" ] || continue\n71\t    local skill_name\n72\t    skill_name=$(basename \"$(dirname \"$(dirname \"$check_script\")\")\")\n73\t    if bash \"$check_script\" >> \"$LOG_FILE\" 2>&1; then\n74\t      log \"INFO\" \"Skill check OK: $skill_name\"\n75\t    else\n76\t      log \"WARN\" \"Skill check failed: $skill_name (non-blocking)\"\n77\t    fi\n78\t  done\n79\t}\n80\t\n81\tensure_skill_checks\n82\t\n83\t# 5. 初始化代理 trace 路径（通过后端 8080 转发到代理）\n84\tinit_trace_path() {\n85\t  local json_file=\"$HOME/.claude-tap-plus/backend.json\"\n86\t  [ -f \"$json_file\" ] || return 0\n87\t\n88\t  local host port\n89\t  host=$(grep -o '\"host\"[[:space:]]*:[[:space:]]*\"[^\"]*\"' \"$json_file\" 2>/dev/null | head -1 | sed 's/.*: *\"//;s/\"//')\n90\t  port=$(grep -o '\"port\"[[:space:]]*:[[:space:]]*[0-9]*' \"$json_file\" 2>/dev/null | head -1 | sed 's/.*: *//')\n91\t  [ -z \"$host\" ] || [ -z \"$port\" ] && return 0\n92\t\n93\t  local backend_url=\"http://$host:$port\"\n94\t\n95\t  local sid\n96\t  sid=$(json_get '.session_id')\n97\t  [ -z \"$sid\" ] && return 0\n98\t\n99\t  local machine_id\n100\t  machine_id=\"$(whoami 2>/dev/null || echo unknown)@$(hostname 2>/dev/null || echo unknown)\"\n101\t\n102\t  local transcript_path\n103\t  transcript_path=$(json_get '.transcript_path')\n104\t\n105\t  local project_slug\n106\t  project_slug=$(echo \"$transcript_path\" | sed -n 's/.*[\\.]claude[\\\\/]\\{1\\}projects[\\\\/]\\{1\\}\\([^\\\\/]*\\).*/\\1/p')\n107\t  [ -z \"$project_slug\" ] && project_slug=$(basename \"$(json_get '.cwd')\" 2>/dev/null)\n108\t\n109\t  # 通过后端转发 trace-init 到代理\n110\t  local result\n111\t  result=$(curl -s --max-time 3 -X POST \"$backend_url/api/proxy/trace-init\" \\\n112\t    -H \"Content-Type: application/json\" \\\n113\t    -d \"{\n114\t      \\\"session_id\\\":\\\"$sid\\\",\n115\t      \\\"machine_id\\\":\\\"$machine_id\\\",\n116\t      \\\"project_slug\\\":\\\"$project_slug\\\",\n117\t      \\\"transcript_path\\\":\\\"$transcript_path\\\"\n118\t    }\" 2>/dev/null)\n119\t\n120\t  if [ -n \"$result\" ]; then\n121\t    log \"INFO\" \"Trace initialized: $(echo \"$result\" | jq -r '.trace_path // \"unknown\"' 2>/dev/null)\"\n122\t  else\n123\t    log \"DEBUG\" \"Trace init skipped (backend/proxy unreachable)\"\n124\t  fi\n125\t}\n126\t\n127\tinit_trace_path\n128\t\n129\t# 6. 注册会话到后端（SR-2）\n130\tregister_session() {\n131\t  source \"$CLAUDE_PROJECT_DIR/.claude/skills/backend.sh\"\n132\t  _load_backend_url\n133\t  [ -z \"$BACKEND_URL\" ] && return 0\n134\t\n135\t  if ! _backend_available; then\n136\t    log \"DEBUG\" \"Backend unreachable, skipping session registration\"\n137\t    return 0\n138\t  fi\n139\t\n140\t  local session_id transcript_path cwd model source_type os_type machine_id project_slug\n141\t\n142\t  session_id=$(json_get '.session_id')\n143\t  [ -z \"$session_id\" ] && return 0\n144\t\n145\t  transcript_path=$(json_get '.transcript_path')\n146\t  cwd=$(json_get '.cwd')\n147\t  model=$(json_get '.model')\n148\t  source_type=$(json_get '.source')\n149\t\n150\t  machine_id=\"$(whoami 2>/dev/null || echo unknown)@$(hostname 2>/dev/null || echo unknown)\"\n151\t\n152\t  case \"$(uname -s)\" in\n153\t    Linux*)   os_type=\"linux\" ;;\n154\t    Darwin*)  os_type=\"macos\" ;;\n155\t    MINGW*|MSYS*|CYGWIN*) os_type=\"windows\" ;;\n156\t    *)        os_type=\"unknown\" ;;\n157\t  esac\n158\t\n159\t  project_slug=$(echo \"$transcript_path\" | sed -n 's/.*[\\.]claude[\\\\/]\\{1\\}projects[\\\\/]\\{1\\}\\([^\\\\/]*\\).*/\\1/p')\n160\t  [ -z \"$project_slug\" ] && project_slug=$(basename \"$cwd\" 2>/dev/null)\n161\t\n162\t  _call_backend \"/api/session/register\" \"{\n163\t    \\\"session_id\\\":\\\"$session_id\\\",\n164\t    \\\"machine_id\\\":\\\"$machine_id\\\",\n165\t    \\\"os\\\":\\\"$os_type\\\",\n166\t    \\\"project_slug\\\":\\\"$project_slug\\\",\n167\t    \\\"project_cwd\\\":\\\"$cwd\\\",\n168\t    \\\"transcript_path\\\":\\\"$transcript_path\\\",\n169\t    \\\"model\\\":\\\"$model\\\",\n170\t    \\\"source\\\":\\\"$source_type\\\"\n171\t  }\" > /dev/null 2>&1\n172\t\n173\t  log \"INFO\" \"Session registered to backend: $session_id\"\n174\t}\n175\t\n176\tregister_session\n177\t\n178\thook_output 0 '{}'\n179\t"}]}
