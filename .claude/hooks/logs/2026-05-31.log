nc(\"/api/session/\", h.Session.Get)              // 获取单个会话详情\n35\t\n36\t\t// Proxy 相关路由（代理注册 + trace-init 转发）。\n37\t\tif h.Proxy != nil {\n38\t\t\tmux.HandleFunc(\"/api/proxy/register\", h.Proxy.Register)     // 代理注册\n39\t\t\tmux.HandleFunc(\"/api/proxy/unregister\", h.Proxy.Unregister) // 代理注销\n40\t\t\tmux.HandleFunc(\"/api/proxy/trace-init\", h.Proxy.TraceInit)  // 转发 trace-init\n41\t\t}\n42\t\n43\t\tlogger.Debug(\"api\", \"routes registered: %d endpoints\", 9)\n44\t\treturn mux\n45\t}\n46\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\sqlite.go"},"tool_use_id":"call_e599b64571634463b7fc370b","tool_response":"1\t// Package store 提供数据持久化层，基于 SQLite 实现。\n2\tpackage store\n3\t\n4\timport (\n5\t\t\"database/sql\"\n6\t\t\"fmt\"\n7\t\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n9\t\n10\t\t_ \"modernc.org/sqlite\" // 注册 SQLite 驱动\n11\t)\n12\t\n13\t// SQLiteStore 是统一的 SQLite 存储入口，聚合了 Issue 和 Session 两个子存储。\n14\ttype SQLiteStore struct {\n15\t\tdb           *sql.DB          // SQLite 数据库连接\n16\t\tissueStore   *sqliteIssueStore // Issue 存储实现\n17\t\tsessionStore *sqliteSessionStore // Session 存储实现\n18\t}\n19\t\n20\t// NewSQLiteStore 创建并初始化 SQLite 存储。\n21\t// 打开数据库、设置 WAL 模式、执行迁移，然后初始化各子存储。\n22\tfunc NewSQLiteStore(dbPath string) (*SQLiteStore, error) {\n23\t\tlogger.Debug(\"store\", \"opening sqlite: %s\", dbPath)\n24\t\t// 打开数据库，设置 busy timeout 为 5 秒\n25\t\tdb, err := sql.Open(\"sqlite\", dbPath+\"?_pragma=busy_timeout(5000)\")\n26\t\tif err != nil {\n27\t\t\treturn nil, fmt.Errorf(\"open sqlite: %w\", err)\n28\t\t}\n29\t\n30\t\t// 启用 WAL 模式以提高并发性能\n31\t\tif _, err := db.Exec(\"PRAGMA journal_mode=WAL\"); err != nil {\n32\t\t\tdb.Close()\n33\t\t\treturn nil, fmt.Errorf(\"set WAL mode: %w\", err)\n34\t\t}\n35\t\tlogger.Debug(\"store\", \"WAL mode set\")\n36\t\n37\t\t// 执行数据库迁移\n38\t\tif err := runMigrations(db); err != nil {\n39\t\t\tdb.Close()\n40\t\t\treturn nil, fmt.Errorf(\"run migrations: %w\", err)\n41\t\t}\n42\t\tlogger.Debug(\"store\", \"migrations complete\")\n43\t\n44\t\tlogger.Info(\"store\", \"sqlite store ready: %s\", dbPath)\n45\t\treturn &SQLiteStore{\n46\t\t\tdb:           db,\n47\t\t\tissueStore:   &sqliteIssueStore{db: db},\n48\t\t\tsessionStore: &sqliteSessionStore{db: db},\n49\t\t}, nil\n50\t}\n51\t\n52\t// Issues 返回 Issue 存储接口。\n53\tfunc (s *SQLiteStore) Issues() IssueStore { return s.issueStore }\n54\t\n55\t// Sessions 返回 Session 存储接口。\n56\tfunc (s *SQLiteStore) Sessions() SessionStore { return s.sessionStore }\n57\t\n58\t// DB 返回底层的 *sql.DB 连接（主要用于测试）。\n59\tfunc (s *SQLiteStore) DB() *sql.DB { return s.db }\n60\t\n61\t// Close 关闭数据库连接。\n62\tfunc (s *SQLiteStore) Close() error {\n63\t\terr := s.db.Close()\n64\t\tlogger.Info(\"store\", \"sqlite store closed\")\n65\t\treturn err\n66\t}\n67\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\migrations.go"},"tool_use_id":"call_3cd8f21e8a7f4a64b5568f38","tool_response":"1\t// Package store 提供数据持久化层，基于 SQLite 实现。\n2\tpackage store\n3\t\n4\timport (\n5\t\t\"database/sql\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n8\t)\n9\t\n10\t// runMigrations 执行数据库迁移，创建必要的表和索引。\n11\t// 如果表或索引已存在则跳过（使用 IF NOT EXISTS）。\n12\tfunc runMigrations(db *sql.DB) error {\n13\t\tstmts := []string{\n14\t\t\t// machines 表：记录使用 claude-tap-plus 的机器信息\n15\t\t\t`CREATE TABLE IF NOT EXISTS machines (\n16\t\t\t\tid              INTEGER PRIMARY KEY AUTOINCREMENT,\n17\t\t\t\tmachine_id      TEXT NOT NULL UNIQUE,\n18\t\t\t\tos              TEXT NOT NULL,\n19\t\t\t\thostname        TEXT NOT NULL,\n20\t\t\t\tusername        TEXT NOT NULL,\n21\t\t\t\tfirst_seen_at   DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n22\t\t\t\tlast_seen_at    DATETIME\n23\t\t\t)`,\n24\t\t\t`CREATE INDEX IF NOT EXISTS idx_machines_hostname ON machines(hostname)`,\n25\t\n26\t\t\t// projects 表：记录 Claude Code 工作过的项目\n27\t\t\t`CREATE TABLE IF NOT EXISTS projects (\n28\t\t\t\tid              INTEGER PRIMARY KEY AUTOINCREMENT,\n29\t\t\t\tproject_slug    TEXT NOT NULL UNIQUE,\n30\t\t\t\tproject_cwd     TEXT NOT NULL,\n31\t\t\t\tfirst_seen_at   DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n32\t\t\t\tlast_seen_at    DATETIME\n33\t\t\t)`,\n34\t\t\t`CREATE INDEX IF NOT EXISTS idx_projects_slug ON projects(project_slug)`,\n35\t\n36\t\t\t// sessions 表：记录每次 Claude Code 会话的元数据\n37\t\t\t`CREATE TABLE IF NOT EXISTS sessions (\n38\t\t\t\tid               INTEGER PRIMARY KEY AUTOINCREMENT,\n39\t\t\t\tsession_id       TEXT NOT NULL UNIQUE,\n40\t\t\t\tmachine_id       TEXT NOT NULL,\n41\t\t\t\tos               TEXT NOT NULL,\n42\t\t\t\tproject_slug     TEXT NOT NULL,\n43\t\t\t\tproject_cwd      TEXT NOT NULL,\n44\t\t\t\ttranscript_path  TEXT NOT NULL,\n45\t\t\t\tlocal_trace_path TEXT,\n46\t\t\t\tmodel            TEXT,\n47\t\t\t\tsource           TEXT,\n48\t\t\t\tstatus           TEXT NOT NULL DEFAULT 'active',\n49\t\t\t\tregistered_at    DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n50\t\t\t\tclosed_at        DATETIME,\n51\t\t\t\tclose_reason     TEXT\n52\t\t\t)`,\n53\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_machine ON sessions(machine_id)`,\n54\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_project ON sessions(project_slug)`,\n55\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_status ON sessions(status)`,\n56\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_registered ON sessions(registered_at)`,\n57\t\n58\t\t\t// issue_claims 表：存储 Issue 领取关系和状态流转\n59\t\t\t`CREATE TABLE IF NOT EXISTS issue_claims (\n60\t\t\t\tid              INTEGER PRIMARY KEY AUTOINCREMENT,\n61\t\t\t\trepo_full_name  TEXT NOT NULL,\n62\t\t\t\tissue_number    INTEGER NOT NULL,\n63\t\t\t\tissue_title     TEXT,\n64\t\t\t\tstatus          TEXT NOT NULL DEFAULT 'idle',\n65\t\t\t\tsession_id      TEXT,\n66\t\t\t\tclaimed_at      DATETIME,\n67\t\t\t\tupdated_at      DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n68\t\t\t\tUNIQUE(repo_full_name, issue_number)\n69\t\t\t)`,\n70\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_repo ON issue_claims(repo_full_name)`,\n71\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_session ON issue_claims(session_id)`,\n72\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_status ON issue_claims(status)`,\n73\t\t}\n74\t\n75\t\tlogger.Debug(\"store\", \"running %d migration statements\", len(stmts))\n76\t\tfor _, stmt := range stmts {\n77\t\t\tif _, err := db.Exec(stmt); err != nil {\n78\t\t\t\tlogger.Error(\"store\", \"migration failed: %s: %v\", stmt[:60], err)\n79\t\t\t\treturn err\n80\t\t\t}\n81\t\t\tlogger.Debug(\"store\", \"migration OK: %.60s\", stmt)\n82\t\t}\n83\t\treturn nil\n84\t}\n85\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\config\\resolve.go"},"tool_use_id":"call_54192defbbde4a41b420abf8","tool_response":"1\tpackage config\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\n6\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n7\t)\n8\t\n9\t// ResolvedConfig 包含按优先级链解析后的最终配置。\n10\ttype ResolvedConfig struct {\n11\t\tBaseURL   string // 最终的上游 API 地址\n12\t\tAPIKey    string // 最终的 API Key（可能为空）\n13\t\tAuthToken string // 最终的 OAuth Token（可能为空）\n14\t}\n15\t\n16\t// ResolveTargetConfig 按优先级解析最终的上游 API 配置。\n17\t//\n18\t// 优先级（从高到低）：\n19\t//\n20\t//\t1. cliBaseURL / cliAPIKey / cliAuthToken（命令行直接指定）\n21\t//\t2. profileName（读取 profiles.json）\n22\t//\t3. 环境变量（ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL）\n23\t//\t4. ~/.claude.json（Claude Code 配置文件）\n24\t//\t5. 默认值\n25\tfunc ResolveTargetConfig(cliBaseURL, cliAPIKey, cliAuthToken, profileName string, cfg *ClientConfig) (*ResolvedConfig, error) {\n26\t\tresult := &ResolvedConfig{}\n27\t\n28\t\t// Level 2: 从 profiles.json 读取配置\n29\t\tif profileName != \"\" {\n30\t\t\tp, err := ResolveProfileConfig(profileName)\n31\t\t\tif err != nil {\n32\t\t\t\tlogger.Warn(\"config\", \"profile resolution failed: %v\", err)\n33\t\t\t} else {\n34\t\t\t\tresult.BaseURL = p.BaseURL\n35\t\t\t\tresult.APIKey = p.APIKey\n36\t\t\t\tresult.AuthToken = p.AuthToken\n37\t\t\t}\n38\t\t}\n39\t\n40\t\t// Level 1: 命令行直接指定，覆盖 profile 值\n41\t\tif cliBaseURL != \"\" {\n42\t\t\tresult.BaseURL = cliBaseURL\n43\t\t}\n44\t\tif cliAPIKey != \"\" {\n45\t\t\tresult.APIKey = cliAPIKey\n46\t\t}\n47\t\tif cliAuthToken != \"\" {\n48\t\t\tresult.AuthToken = cliAuthToken\n49\t\t}\n50\t\n51\t\t// Level 3: 环境变量（仅在仍为空时）\n52\t\tif result.BaseURL == \"\" {\n53\t\t\tif env := os.Getenv(cfg.BaseURLEnv); env != \"\" {\n54\t\t\t\tresult.BaseURL = env\n55\t\t\t\tlogger.Debug(\"config\", \"base_url from env %s\", cfg.BaseURLEnv)\n56\t\t\t}\n57\t\t}\n58\t\tif result.APIKey == \"\" && result.AuthToken == \"\" {\n59\t\t\tif env := os.Getenv(\"ANTHROPIC_API_KEY\"); env != \"\" {\n60\t\t\t\tresult.APIKey = env\n61\t\t\t\tlogger.Debug(\"config\", \"api_key from env ANTHROPIC_API_KEY\")\n62\t\t\t}\n63\t\t\tif env := os.Getenv(\"ANTHROPIC_AUTH_TOKEN\"); env != \"\" {\n64\t\t\t\tresult.AuthToken = env\n65\t\t\t\tlogger.Debug(\"config\", \"auth_token from env ANTHROPIC_AUTH_TOKEN\")\n66\t\t\t}\n67\t\t}\n68\t\n69\t\t// Level 4: ~/.claude.json（仅在 base_url 仍为空时）\n70\t\tif result.BaseURL == \"\" && cfg == &ClaudeClient {\n71\t\t\tcc, err := ReadClaudeConfig()\n72\t\t\tif err == nil && cc != nil {\n73\t\t\t\tif url := ClaudeBaseURLFromConfig(cc); url != \"\" {\n74\t\t\t\t\tresult.BaseURL = url\n75\t\t\t\t\tlogger.Debug(\"config\", \"base_url from ~/.claude.json\")\n76\t\t\t\t}\n77\t\t\t}\n78\t\t}\n79\t\n80\t\t// Level 5: 默认值\n81\t\tif result.BaseURL == \"\" {\n82\t\t\tresult.BaseURL = cfg.DefaultTarget\n83\t\t}\n84\t\n85\t\tauthType := \"none\"\n86\t\tif result.APIKey != \"\" {\n87\t\t\tauthType = \"api_key\"\n88\t\t} else if result.AuthToken != \"\" {\n89\t\t\tauthType = \"auth_token\"\n90\t\t}\n91\t\tlogger.Info(\"config\", \"resolved: base_url=%s auth=%s\", result.BaseURL, authType)\n92\t\treturn result, nil\n93\t}\n94\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\usage\\normalize.go"},"tool_use_id":"call_eb62a5f9f2c946bd8eca07ca","tool_response":"1\tpackage usage\n2\t\n3\timport (\n4\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n5\t)\n6\t\n7\t// NormalizeUsage 将不同 Provider 特定的 Token 字段名统一映射到 Anthropic 规范的标准名称。\n8\t//\n9\t// 支持的 Provider 及其字段映射关系：\n10\t//   - Anthropic: input_tokens / output_tokens / cache_read_input_tokens / cache_creation_input_tokens\n11\t//   - OpenAI:    prompt_tokens / completion_tokens / cached_tokens\n12\t//   - Google Gemini: promptTokenCount / candidatesTokenCount / cachedContentTokenCount\n13\t//\n14\t// 此外，该函数还会检查嵌套结构（如 input_tokens_details.cached_tokens、\n15\t// prompt_tokens_details.cached_tokens），将其累加到 cache_read_input_tokens 中。\n16\t//\n17\t// 参数 usage 是原始 API 响应中的 usage 对象（map[string]any）。\n18\t// 返回按 Anthropic 规范标准化后的 Token 统计 map。\n19\tfunc NormalizeUsage(usage map[string]any) map[string]int64 {\n20\t\tif usage == nil {\n21\t\t\treturn nil\n22\t\t}\n23\t\n24\t\tlogger.Debug(\"usage\", \"normalize usage: keys=%v\", mapKeys(usage))\n25\t\n26\t\tresult := make(map[string]int64)\n27\t\n28\t\t// 映射输入 Token 数量：优先查找 Anthropic 字段名，其次 OpenAI、Gemini\n29\t\tresult[\"input_tokens\"] = firstInt64(usage,\n30\t\t\t\"input_tokens\",\n31\t\t\t\"prompt_tokens\",\n32\t\t\t\"promptTokenCount\",\n33\t\t)\n34\t\n35\t\t// 映射输出 Token 数量：优先查找 Anthropic 字段名，其次 OpenAI、Gemini\n36\t\tresult[\"output_tokens\"] = firstInt64(usage,\n37\t\t\t\"output_tokens\",\n38\t\t\t\"completion_tokens\",\n39\t\t\t\"candidatesTokenCount\",\n40\t\t)\n41\t\n42\t\t// 映射缓存读取的输入 Token 数量\n43\t\tresult[\"cache_read_input_tokens\"] = firstInt64(usage,\n44\t\t\t\"cache_read_input_tokens\",\n45\t\t\t\"cached_tokens\",\n46\t\t\t\"cachedContentTokenCount\",\n47\t\t)\n48\t\n49\t\t// 映射缓存创建的输入 Token 数量（目前仅 Anthropic 使用）\n50\t\tresult[\"cache_creation_input_tokens\"] = firstInt64(usage,\n51\t\t\t\"cache_creation_input_tokens\",\n52\t\t)\n53\t\n54\t\t// 处理嵌套结构：OpenAI 风格的 usage.input_tokens_details.cached_tokens\n55\t\tif details, ok := usage[\"input_tokens_details\"].(map[string]any); ok {\n56\t\t\tif v := intFromMap(details, \"cached_tokens\"); v > 0 {\n57\t\t\t\tresult[\"cache_read_input_tokens\"] += v\n58\t\t\t}\n59\t\t}\n60\t\t// 处理嵌套结构：OpenAI 风格的 usage.prompt_tokens_details.cached_tokens\n61\t\tif details, ok := usage[\"prompt_tokens_details\"].(map[string]any); ok {\n62\t\t\tif v := intFromMap(details, \"cached_tokens\"); v > 0 {\n63\t\t\t\tresult[\"cache_read_input_tokens\"] += v\n64\t\t\t}\n65\t\t}\n66\t\n67\t\tlogger.Debug(\"usage\", \"normalized: in=%d out=%d cache_read=%d cache_create=%d\",\n68\t\t\tresult[\"input_tokens\"], result[\"output_tokens\"],\n69\t\t\tresult[\"cache_read_input_tokens\"], result[\"cache_creation_input_tokens\"])\n70\t\n71\t\treturn result\n72\t}\n73\t\n74\t// firstInt64 在 map 中按给定 keys 的优先顺序查找第一个非零的 int64 值。\n75\t// 如果所有 key 都不存在或值为零，则返回 0。\n76\tfunc firstInt64(m map[string]any, keys ...string) int64 {\n77\t\tfor _, k := range keys {\n78\t\t\tif v := intFromMap(m, k); v != 0 {\n79\t\t\t\treturn v\n80\t\t\t}\n81\t\t}\n82\t\treturn 0\n83\t}\n84\t\n85\t// intFromMap 从 map 中按 key 提取 int64 值，兼容多种数值类型。\n86\t//\n87\t// 支持的类型：\n88\t//   - float64（JSON 反序列化后的数字默认类型）\n89\t//   - int\n90\t//   - int64\n91\t//   - json.Number（encoding/json 的数字类型，通过接口匹配避免引入包依赖）\n92\tfunc intFromMap(m map[string]any, key string) int64 {\n93\t\tv, ok := m[key]\n94\t\tif !ok {\n95\t\t\treturn 0\n96\t\t}\n97\t\tswitch n := v.(type) {\n98\t\tcase float64:\n99\t\t\treturn int64(n)\n100\t\tcase int:\n101\t\t\treturn int64(n)\n102\t\tcase int64:\n103\t\t\treturn n\n104\t\tcase json_number:\n105\t\t\tif i, err := n.Int64(); err == nil {\n106\t\t\t\treturn i\n107\t\t\t}\n108\t\t}\n109\t\treturn 0\n110\t}\n111\t\n112\t// json_number 是一个本地接口，用于匹配 encoding/json.Number 类型，\n113\t// 从而在不直接导入 encoding/json 包的情况下，安全地处理 JSON 数字值。\n114\ttype json_number interface{ Int64() (int64, error) }\n115\t\n116\t// mapKeys 返回 map 的 key 列表，用于调试日志。\n117\tfunc mapKeys(m map[string]any) []string {\n118\t\tkeys := make([]string, 0, len(m))\n119\t\tfor k := range m {\n120\t\t\tkeys = append(keys, k)\n121\t\t}\n122\t\treturn keys\n123\t}\n124\t"}]}
