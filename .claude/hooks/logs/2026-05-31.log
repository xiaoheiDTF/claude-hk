CRIPT_PATH\"\nskill_log \"INFO\" \"执行完成: $SCRIPT_PATH (退出码: $?)\"\n","numLines":48,"startLine":1,"totalLines":48}},"tool_use_id":"call_5840b965812f4242b11af51a","duration_ms":4}
