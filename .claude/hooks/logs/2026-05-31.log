[2026-05-31 13:33:29] [INFO] [PreToolUse] Input: {"session_id":"7b2b89f2-ee5f-44be-9351-b88ec9fac19c","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\7b2b89f2-ee5f-44be-9351-b88ec9fac19c.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"head -2 /c/Users/Administrator/.claude-tap-plus/.traces/Administrator@DESKTOP-ELIN5K6/D--CodeDevelopment-CodeProject-claude-hk/5f5bbd34-69d9-498a-9d5f-0ed0927048c5.jsonl","description":"查看 trace JSONL 内容格式"},"tool_use_id":"call_6e74f4679d5d4e0f9ff4129b"}
