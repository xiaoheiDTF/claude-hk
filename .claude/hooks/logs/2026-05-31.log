    echo \"\"\n36\t    echo \"=== 可解决的 Issues ===\"\n37\t    issues=$(_gh issue list --state open --label \"in-progress\" --assignee @me --json number,title,labels 2>/dev/null)\n38\t    if [ -n \"$issues\" ] && [ \"$issues\" != \"[]\" ]; then\n39\t      count=$(echo \"$issues\" | jq 'length')\n40\t      echo \"当前已领取的 open issues（共 $count 个）:\"\n41\t      echo \"\"\n42\t      echo \"$issues\" | jq -r '.[] | \"#\\(.number) [\\([.labels[].name] | join(\",\"))] \\(.title)\\n  请回复 /003-5-issue-fix #\\(.number) 来开始解决\\n\"'\n43\t    else\n44\t      echo \"(暂无已领取的 issues，请先使用 /003-4-issue-claim 领取)\"\n45\t    fi\n46\t  else\n47\t    echo \"gh CLI 不可用，请先安装 GitHub CLI\"\n48\t    echo \"请指定 issue 编号，例如: /003-5-issue-fix #5\"\n49\t  fi\n50\tfi\n51\t\n52\tskill_log \"INFO\" \"[inject] issue-fix context injected for #$ISSUE_NUM\"\n53\t"}]}
