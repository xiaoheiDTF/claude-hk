; err != nil {\n204\t\t\tconfig = make(map[string]any)\n205\t\t}\n206\t\n207\t\t// Claude Code 使用正斜杠路径作为键。\n208\t\tprojectKey := CwdToClaudeKey(cwd)\n209\t\n210\t\t// 获取或创建项目条目。\n211\t\tprojectEntry, ok := config[projectKey].(map[string]any)\n212\t\tif !ok {\n213\t\t\tprojectEntry = make(map[string]any)\n214\t\t}\n215\t\n216\t\t// 更新会话相关字段。\n217\t\tprojectEntry[\"lastSessionId\"] = entry.SessionID\n218\t\tprojectEntry[\"lastSessionModified\"] = time.Now().UnixMilli()\n219\t\tprojectEntry[\"lastGracefulShutdown\"] = true\n220\t\n221\t\tif entry.FirstTimestamp != \"\" {\n222\t\t\tprojectEntry[\"lastSessionFirstPrompt\"] = \"\" // 元数据中不包含提示文本。\n223\t\t}\n224\t\n225\t\t// 如果已存在指向更新会话的 lastSessionId，则跳过（mostRecentSession 保证了这是最新的）。\n226\t\tif existingLastSession, ok := projectEntry[\"lastSessionId\"].(string); ok {\n227\t\t\tif existingLastSession == entry.SessionID {\n228\t\t\t\t// 已经指向该会话，无需更新。\n229\t\t\t}\n230\t\t\t// 如果不同，保留较新的那个 — mostRecentSession 已确保这一点。\n231\t\t}\n232\t\n233\t\tconfig[projectKey] = projectEntry\n234\t\n235\t\t// 写回配置文件。\n236\t\tout, err := json.MarshalIndent(config, \"\", \"  \")\n237\t\tif err != nil {\n238\t\t\treturn fmt.Errorf(\"marshal .claude.json: %w\", err)\n239\t\t}\n240\t\n241\t\treturn os.WriteFile(configPath, out, 0o644)\n242\t}\n243\t\n244\t// parseTimestamp 解析 ISO 时间戳字符串。\n245\t// 支持多种常见格式，解析失败返回零值时间。\n246\tfunc parseTimestamp(s string) time.Time {\n247\t\tfor _, format := range []string{\n248\t\t\t\"2006-01-02T15:04:05.000Z\",\n249\t\t\t\"2006-01-02T15:04:05Z\",\n250\t\t\ttime.RFC3339,\n251\t\t\ttime.RFC3339Nano,\n252\t\t} {\n253\t\t\tif t, err := time.Parse(format, s); err == nil {\n254\t\t\t\treturn t\n255\t\t\t}\n256\t\t}\n257\t\treturn time.Time{}\n258\t}\n259\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\session\\status.go"},"tool_use_id":"call_ba2c156e0a0641a89e7eae74","tool_response":"1\t// Package session 提供 Claude Code 会话的收集、恢复、状态查看等核心功能。\n2\tpack