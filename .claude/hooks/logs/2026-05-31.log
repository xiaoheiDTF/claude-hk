l.exe -NoProfile -ExecutionPolicy Bypass -File \"$FOREGROUND_WIN_PATH\" -Hint \"$PROJECT_HINT\" 2>>\"$LOG_FILE\"\n  log \"INFO\" \"[win32-fg] foreground script executed (hint=$PROJECT_HINT)\"\nelse\n  log \"WARNING\" \"[win32-fg] win32-foreground.ps1 not found at $FOREGROUND_PS1\"\nfi\n\nreturn 0 2>/dev/null || true\n","numLines":40,"startLine":1,"totalLines":40}},"tool_use_id":"call_954f4f9c2dfc46a9a7b0ef4f","duration_ms":4}
