SUE_NUM 讨论上下文 ===\"\n36\techo \"日期: $(date +%Y-%m-%d)\"\n37\techo \"\"\n38\t\n39\t# 拉取 issue 详情\n40\tif _gh --version &>/dev/null; then\n41\t  issue_json=$(_gh issue view \"$ISSUE_NUM\" --json title,body,labels,state,assignees,comments 2>/dev/null)\n42\t  if [ -n \"$issue_json\" ]; then\n43\t    echo \"Issue 详情:\"\n44\t    _gh issue view \"$ISSUE_NUM\" 2>/dev/null\n45\t    echo \"\"\n46\t    echo \"评论:\"\n47\t    _gh api \"repos/{owner}/{repo}/issues/$ISSUE_NUM/comments\" --jq '.[] | \"---\\n作者: \\(.user.login)\\n时间: \\(.created_at)\\n\\(.body)\\n\"' 2>/dev/null || echo \"(无评论)\"\n48\t  else\n49\t    echo \"无法获取 issue #$ISSUE_NUM，请确认编号是否正确\"\n50\t  fi\n51\telse\n52\t  echo \"gh CLI 不可用，无法拉取 issue\"\n53\tfi\n54\t\n55\tskill_log \"INFO\" \"[inject] issue-discuss context injected for #$ISSUE_NUM\"\n56\t"}]}
