n  BaseURL string   // 上游 API 地址\n  APIKey string    // API 密钥\n  AuthToken string // OAuth Token\n  Provider string  // 供应商标识\n  ```\n\n#### Proxy 包 (`internal/proxy/`)\n- **SSEReassembler** (`internal/sse/reassembler.go`)\n  ```go\n  Events []map[string]any // 解析出的所有 SSE 事件列表\n  buf []byte              // 未处理完的 SSE 字节缓冲区\n  curEv *string           // 当前正在解析的事件类型\n  curData []string        // 当前事件的 data 行累积\n  snap map[string]any     // 重建后的完整响应快照\n  fedOnce bool            // 是否已接收过首块数据\n  ```\n\n#### Trace 包 (`internal/trace/`)\n- **TraceWriter** (`writer.go`)\n  ```go\n  mu sync.Mutex\n  file *os.File\n  writer *bufio.Writer\n  count int            // 已写入记录数\n  inputTokens int64    // 累计输入 Token\n  outputTokens int64   // 累计输出 Token\n  cacheRead int64      // 累计缓存读取 Token\n  cacheCreate int64    // 累计缓存创建 Token\n  modelsUsed map[string]int\n  path string\n  sessionID string\n  ```\n\n#### Session 包 (`internal/session/`)\n- **SessionMeta** (`meta.go`)\n  ```go\n  Project string\n  GitRemote string\n  LocalSlug string\n  LocalCwd string\n  MachineID string\n  Sessions []SessionEntry\n  ```\n\n- **SessionEntry** (`meta.go`)\n  ```go\n  SessionID string\n  File string\n  FileSize int64\n  RecordCount int\n  FirstTimestamp string\n  LastTimestamp string\n  ModelsUsed []string\n  GitBranch string\n  SourceSlug string\n  CollectedAt string\n  ```\n\n#### Backend 层 (`internal/backend/`)\n- **Server** (`server.go`)\n  ```go\n  cfg Config\n  store *store.SQLiteStore\n  ```\n\n- **Config** (`config.go`)\n  ```go\n  Host string\n  Port int\n  DBPath string\n  ```\n\n- **IssueClaim** (`domain/issue.go`)\n  ```go\n  ID int64\n  RepoFullName string\n  IssueNumber int\n  IssueTitle string\n  Status IssueStatus\n  SessionID string\n  ClaimedAt *time.Time\n  UpdatedAt time.Time\n  ```\n\n- **Session** (`domain/session.go`)\n  ```go\n  ID int64\n  SessionID string\n  MachineID string\n  OS string\n  ProjectSlug string\n  ProjectCwd string\n  TranscriptPath string\n  LocalTracePath string\n  Model string\n  Source string\n  Status SessionStatus\n  RegisteredAt time.Time\n  ClosedAt *time.Time\n  CloseReason string\n  ```\n\n### API 相关结构\n\n#### API 请求/响应 (`internal/backend/api/`)\n- **CheckIssuesRequest**\n  ```go\n  RepoFullName string\n  IssueNumbers []int\n  ```\n\n- **IssueStatusItem**\n  ```go\n  Number int\n  Status string\n  SessionID *string\n  ClaimedAt *string\n  ```\n\n- **RegisterSessionRequest**\n  ```go\n  SessionID string\n  MachineID string\n  OS string\n  ProjectSlug string\n  ProjectCwd string\n  TranscriptPath string\n  LocalTracePath string\n  Model string\n  Source string\n  ```\n\n## 2. 所有公开函数签名\n\n### CMD 层\n```go\n// main.go\nfunc main()\nfunc printUsage()\nfunc runProxy(args []string)\nfunc runSessionPush(args []string)\nfunc runSessionPull(args []string)\nfunc runSessionStatus(args []string)\n\n// backend_cmd.go\nfunc runBackend(args []string)\n\n// backend_autostart.go\nfunc ensureBackend()\nfunc startBackendProcess() error\nfunc waitForBackend(timeout, interval time.Duration) bool\n\n// session_files.go\nfunc BaseDir() string\nfunc ReadBackendInfo() *BackendInfo\nfunc WriteBackendInfo(info BackendInfo) error\nfunc RegisterProxySession(key, startedAt string) error\nfunc UnregisterProxySession(key string) error\n```\n\n### Config 包\n```go\n// claudeconfig.go\nfunc ReadClaudeConfig() (*ClaudeConfig, error)\nfunc ClaudeBaseURLFromConfig(cfg *ClaudeConfig) string\nfunc HomeDir() string\n\n// client.go\nfunc DetectTarget(cfg *ClientConfig) string\nfunc ResolveCmd(cfg *ClientConfig) (string, error)\nfunc BuildChildEnv(cfg *ClientConfig, proxyURL string) []string\nfunc HasSettingsArg(args []string) bool\nfunc BuildSettingsArgs(cfg *ClientConfig, proxyURL string) []string\n\n// profiles.go\nfunc ReadProfiles() (*ProfilesFile, error)\nfunc ResolveProfileConfig(name string) (*ProfileConfig, error)\n\n// resolve.go\nfunc ResolveTargetConfig(cliBaseURL, cliAPIKey, cliAuthToken, profileName string, cfg *ClientConfig) (*ResolvedConfig, error)\n```\n\n### Proxy 包\n```go\n// reverse.go\nfunc NewReverseProxy(target, traceDir string) *ReverseProxy\nfunc (p *ReverseProxy) Start(host string, port int) (int, error)\nfunc (p *ReverseProxy) Stop()\nfunc (p *ReverseProxy) Summary() map[string]any\nfunc (p *ReverseProxy) SessionID() string\nfunc (p *ReverseProxy) ProjectSlug() string\nfunc (p *ReverseProxy) TracePath() string\n\n// headers.go\nfunc FilterHeaders(headers http.Header, redact bool) http.Header\nfunc HeadersToMap(h http.Header) map[string]string\n\n// paths.go\nfunc IsAllowedPath(path string) bool\n```\n\n### SSE 包\n```go\n// reassembler.go\nfunc NewSSEReassembler() *SSEReassembler\nfunc (r *SSEReassembler) FeedBytes(chunk []byte)\nfunc (r *SSEReassembler) Reconstruct() map[string]any\n```\n\n### Trace 包\n```go\n// writer.go\nfunc NewTraceWriter(path string) (*TraceWriter, error)\nfunc (w *TraceWriter) Write(record map[string]any) error\nfunc (w *TraceWriter) Close() error\nfunc (w *TraceWriter) Summary() map[string]any\nfunc (w *TraceWriter) SessionID() string\nfunc DefaultTraceDir() string\nfunc DetectProjectName() string\nfunc NewSessionTracePath(baseDir, machineID, projectSlug, sessionID string) string\n```\n\n### Session 包\n```go\n// collect.go\nfunc SessionPush(opts PushOptions) ([]PushResult, error)\n\n// restore.go\nfunc SessionPull(opts PullOptions) ([]PullResult, error)\n\n// status.go\nfunc SessionStatus(opts StatusOptions) error\n\n// meta.go\nfunc LoadMeta(dir string) (*SessionMeta, error)\nfunc SaveMeta(dir string, meta *SessionMeta) error\nfunc ParseSessionJSONL(path string, sourceSlug string) (*SessionEntry, error)\n\n// slug.go\nfunc GenerateSlug(absPath string) string\nfunc DetectLocalSlug() (string, string)\nfunc ClaudeProjectsDir() string\nfunc FindSlugForProject(projectName string) (string, bool)\n```\n\n### Backend 层\n```go\n// server.go\nfunc NewServer(cfg Config) (*Server, error)\nfunc (s *Server) Start() error\nfunc (s *Server) Close() error\n\n// api/router.go\nfunc NewRouter(h Handlers) http.Handler\n\n// api/issue_handler.go\nfunc NewIssueHandler(svc *service.IssueService) *IssueHandler\nfunc (h *IssueHandler) CheckIssues(w http.ResponseWriter, r *http.Request)\nfunc (h *IssueHandler) ClaimIssue(w http.ResponseWriter, r *http.Request)\nfunc (h *IssueHandler) ReleaseIssue(w http.ResponseWriter, r *http.Request)\nfunc (h *IssueHandler) ReleaseSession(w http.ResponseWriter, r *http.Request)\nfunc (h *IssueHandler) UpdateStatus(w http.ResponseWriter, r *http.Request)\n\n// api/session_handler.go\nfunc NewSessionHandler(svc *service.SessionService) *SessionHandler\nfunc (h *SessionHandler) Register(w http.ResponseWriter, r *http.Request)\nfunc (h *SessionHandler) Close(w http.ResponseWriter, r *http.Request)\nfunc (h *SessionHandler) List(w http.ResponseWriter, r *http.Request)\nfunc (h *SessionHandler) Get(w http.ResponseWriter, r *http.Request)\n\n// api/proxy_handler.go\nfunc NewProxyHandler() *ProxyHandler\nfunc (h *ProxyHandler) Register(w http.ResponseWriter, r *http.Request)\nfunc (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request)\nfunc (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request)\n\n// service/issue_service.go\nfunc NewIssueService(s store.IssueStore) *IssueService\nfunc (svc *IssueService) Check(ctx context.Context, repo string, numbers []int) ([]store.IssueCheckResult, error)\nfunc (svc *IssueService) Claim(ctx context.Context, repo string, number int, sessionID string, issueTitle string) (*store.ClaimResult, error)\nfunc (svc *IssueService) UpdateStatus(ctx context.Context, repo string, number int, sessionID string, newStatus string) (*store.UpdateStatusResult, error)\nfunc (svc *IssueService) Release(ctx context.Context, repo string, number int, sessionID string) (bool, error)\nfunc (svc *IssueService) ReleaseSession(ctx context.Context, sessionID string) ([]int, error)\n\n// service/session_service.go\nfunc NewSessionService(s store.SessionStore) *SessionService\nfunc (svc *SessionService) Register(ctx context.Context, sess store.Session) error\nfunc (svc *SessionService) Close(ctx context.Context, sessionID string, reason string) error\nfunc (svc *SessionService) List(ctx context.Context, filter store.SessionFilter) ([]store.Session, error)\nfunc (svc *SessionService) Get(ctx context.Context, sessionID string) (*store.Session, error)\n\n// store/sqlite.go\nfunc NewSQLiteStore(dbPath string) (*SQLiteStore, error)\nfunc (s *SQLiteStore) Close() error\n```\n\n## 3. 包间依赖图\n\n```\ncmd/claude-tap/\n├── main.go → config, logger, proxy, session, trace\n├── backend_cmd.go → backend, logger, trace\n├── backend_autostart.go → logger\n├── session_files.go → logger\n└── sysproc_*.go\n\ninternal/config/\n├── claudeconfig.go → logger\n├── client.go → logger\n├── profiles.go → logger\n└── resolve.go → logger\n\ninternal/proxy/\n├── reverse.go → logger, sse, trace\n├── headers.go\n├── netutil.go\n└── paths.go\n\ninternal/sse/\n├── reassembler.go → logger, usage\n└── types.go\n\ninternal/trace/\n├── writer.go → logger, usage\n└── anthropic.go\n\ninternal/usage/\n├── normalize.go → logger\n└── anthropropic.go\n\ninternal/logger/\n└── logger.go\n\ninternal/session/\n├── collect.go → logger, trace\n├── restore.go → logger\n├── status.go → logger\n├── meta.go → logger\n└── slug.go\n\ninternal/backend/\n├── server.go → api, service, store, logger\n├── config.go → logger\n├── errors.go\n├── api/\n│   ├── router.go\n│   ├── issue_handler.go → service, logger\n│   ├── session_handler.go → service, store, logger\n│   ├── health_handler.go → logger\n│   ├── proxy_handler.go → logger\n│   ├── request.go\n│   └── response.go\n├── domain/\n│   ├── issue.go\n│   ├── machine.go\n│   ├── project.go\n│   └── session.go\n├── service/\n│   ├── issue_service.go → store, logger\n│   ├── session_service.go → store, logger\n│   ├── cleanup_service.go → store, logger\n│   └── idle_watchdog.go → logger\n└── store/\n    ├── store.go\n    ├── sqlite.go → logger\n    ├── migrations.go → logger\n    ├── issue_store.go → logger\n    └── session_store.go → logger\n```\n\n## 4. 数据流（从 main 入口到最终存储的完整调用链）\n\n### 代理模式流程\n```\nmain()\n└── runProxy(args[])\n    ├── config.ResolveTargetConfig()\n    │   ├── profiles.json 读取\n    │   ├── 环境变量检查\n    │   ├── ~/.claude.json 读取\n    │   └── 默认值设置\n    │\n    ├── proxy.NewReverseProxy(target, traceDir)\n    │   ├── proxy.Start(\"127.0.0.1\", port)\n    │   │   └── 监听本地端口\n    │   │\n    │   ├── ensureBackend() → 启动后端服务\n    │   │\n    │   └── registerProxyWithBackend(proxyURL) → 向后端注册\n    │\n    ├── config.ResolveCmd() → 查找 claude 可执行文件\n    │\n    ├── config.BuildChildEnv() → 设置子进程环境变量\n    │\n    ├── exec.Command() → 启动 Claude Code 子进程\n    │\n    └── proxy.serveHTTP() → 处理 HTTP 请求\n        ├── handleInternal() → 处理 /_internal/trace-init\n        │   ├── trace.NewTraceWriter() → 创建追踪写入器\n        │   └── RegisterProxySession() → 更新 proxy.json\n        │\n        ├── handleStreaming() → 处理流式响应\n        │   ├── sse.NewSSEReassembler() → 创建 SSE 重组器\n        │   ├── reassembler.FeedBytes() → 处理 SSE 数据\n        │   ├── reassembler.Reconstruct() → 重构完整响应\n        │   └── trace.TraceWriter.Write() → 写入追踪记录\n        │\n        └── handleNonStreaming() → 处理非流式响应\n            └── trace.TraceWriter.Write() → 写入追踪记录\n```\n\n### Session 收集流程\n```\nmain()\n└── runSessionPush(args[])\n    └── session.SessionPush(opts)\n        ├── pushSingleProject() 或 pushAllProjects()\n        │   └── collectProject()\n        │       ├── LoadMeta() → 读取现有元数据\n        │       ├── FindSessionJSONLFiles() → 扫描会话文件\n        │       ├── ParseSessionJSONL() → 解析会话元信息\n        │       ├── copyFile() → 复制会话文件\n        │       └── SaveMeta() → 更新元数据\n```\n\n### 后端服务流程\n```\nmain()\n└── runBackend(args[])\n    ├── backend.NewServer(cfg)\n    │   ├── store.NewSQLiteStore(dbPath)\n    │   │   ├── runMigrations() → 执行数据库迁移\n    │   │   └── 创建 SQLiteStore 实例\n    │   │\n    │   └── 创建 Server 实例\n    │\n    ├── server.Start()\n    │   ├── cleanupSvc.CleanupTimedOutSessions() → 清理超时会话\n    │   ├── 初始化业务服务 (IssueService, SessionService)\n    │   ├── api.NewRouter() → 注册路由\n    │   ├── 启动 HTTP 服务器\n    │   └── 启动 idle watchdog\n    │\n    └── 处理 HTTP 请求\n        ├── /api/session/register → SessionHandler.Register()\n        │   └── sessionSvc.Register() → 写入数据库\n        │\n        ├── /api/proxy/register → ProxyHandler.Register()\n        │   └── 更新内存中的代理列表\n        │\n        └── /api/proxy/trace-init → ProxyHandler.TraceInit()\n            ├── 转发到所有注册的代理\n            └── relayTraceInit() → HTTP 转发\n```\n\n### 关键数据存储路径\n1. **追踪文件**: `~/.claude-tap-plus/.traces/{machineID}/{projectSlug}/{sessionID}.jsonl`\n2. **会话存储**: `{exe-dir}/sessions/{slug}/meta.json`\n3. **代理会话记录**: `~/.claude-tap-plus/proxy.json`\n4. **后端数据库**: `backend.db` (SQLite)\n5. **Claude Code 会话**: `~/.claude/projects/{slug}/{sessionID}.jsonl`\n\n这个项目实现了一个完整的 Claude Code 代理和会话管理系统，具有以下核心特性：\n- HTTP 代理拦截和记录 API 调用\n- SSE 流式响应的重组和解析\n- 会话的收集、恢复和状态管理\n- 分布式 Issue 管理（通过后端 API）\n- 自动化的后端服务管理\n- 多 Provider 的 Token 用量标准化"}],"totalDurationMs":202102,"totalTokens":146033,"totalToolUseCount":50,"usage":{"input_tokens":4278,"cache_creation_input_tokens":0,"cache_read_input_tokens":135410,"output_tokens":6345,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"toolStats":{"readCount":50,"searchCount":0,"bashCount":0,"editFileCount":0,"linesAdded":0,"linesRemoved":0,"otherToolCount":0}},"tool_use_id":"call_0d80df02f7844fb9aca9bf4d","duration_ms":202102}
