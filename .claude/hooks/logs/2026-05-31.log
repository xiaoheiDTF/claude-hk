l_backend() {\n43\t  local endpoint=\"$1\"\n44\t  local data=\"$2\"\n45\t  _load_backend_url\n46\t  [ -z \"$BACKEND_URL\" ] && return 1\n47\t\n48\t  local resp\n49\t  resp=$(curl -s --max-time 5 -X POST \"$BACKEND_URL$endpoint\" \\\n50\t    -H \"Content-Type: application/json\" \\\n51\t    -d \"$data\" 2>/dev/null)\n52\t  local rc=$?\n53\t  if [ $rc -ne 0 ] || [ -z \"$resp\" ]; then\n54\t    [ -n \"${SKILL_TAG:-}\" ] && skill_log \"DEBUG\" \"Backend call failed: $endpoint (curl rc=$rc)\"\n55\t    return 1\n56\t  fi\n57\t  echo \"$resp\"\n58\t}\n59\t\n60\t# 获取当前 session_id\n61\t_get_session_id() {\n62\t  if [ -n \"${CLAUDE_SESSION_ID:-}\" ]; then\n63\t    echo \"$CLAUDE_SESSION_ID\"\n64\t    return\n65\t  fi\n66\t  if command -v json_get >/dev/null 2>&1; then\n67\t    json_get '.session_id' 2>/dev/null\n68\t  fi\n69\t}\n70\t\n71\t# 通用状态更新函数（D2-D6 使用）— 静默降级\n72\tupdate_issue_status() {\n73\t  local issue_num=\"$1\"\n74\t  local new_status=\"$2\"\n75\t\n76\t  _load_backend_url\n77\t  [ -z \"$BACKEND_URL\" ] && return 0\n78\t\n79\t  local session_id\n80\t  session_id=$(_get_session_id)\n81\t  [ -z \"$session_id\" ] && return 0\n82\t\n83\t  local repo\n84\t  repo=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null)\n85\t  [ -z \"$repo\" ] && return 0\n86\t\n87\t  # 1. 调后端更新状态\n88\t  local result\n89\t  result=$(_call_backend \"/api/issue/status\" \"{\n90\t    \\\"repo_full_name\\\":\\\"$repo\\\",\n91\t    \\\"issue_number\\\":$issue_num,\n92\t    \\\"session_id\\\":\\\"$session_id\\\",\n93\t    \\\"status\\\":\\\"$new_status\\\"\n94\t  }\")\n95\t\n96\t  # 2. 从响应中获取 previous_status，同步 GitHub label\n97\t  local old_status\n98\t  old_status=$(echo \"$result\" | jq -r '.previous_status // empty' 2>/dev/null)\n99\t  [ -n \"$old_status\" ] && _sync_github_label \"$issue_num\" \"$old_status\" \"$new_status\"\n100\t}\n101\t\n102\t# 状态→GitHub Label 映射\n103\t_status_to_label() {\n104\t  case \"$1\" in\n105\t    claimed)       echo \"in-progress\" ;;\n106\t    fixing)        echo \"fixing\" ;;\n107\t    ready-for-pr)  echo \"ready-for-pr\" ;;\n108\t    pr-created)    echo \"pr-created\" ;;\n109\t    testing)       echo \"testing\" ;;\n110\t    reviewing)     echo \"reviewing\" ;;\n111\t    rejected)      echo \"rejected\" ;;\n112\t    merged|idle)   echo \"\" ;;\n113\t    *)             echo \"\" ;;\n114\t  esac\n115\t}\n116\t\n117\t# 同步 GitHub label（后端状态变更后调用）\n118\t_sync_github_label() {\n119\t  local issue_num=\"$1\"\n120\t  local old_status=\"$2\"\n121\t  local new_status=\"$3\"\n122\t\n123\t  local old_label\n124\t  old_label=$(_status_to_label \"$old_status\")\n125\t  local new_label\n126\t  new_label=$(_status_to_label \"$new_status\")\n127\t\n128\t  # 移除旧 label\n129\t  [ -n \"$old_label\" ] && [ \"$old_label\" != \"$new_label\" ] && \\\n130\t    gh issue edit \"$issue_num\" --remove-label \"$old_label\" 2>/dev/null\n131\t\n132\t  # 添加新 label\n133\t  [ -n \"$new_label\" ] && \\\n134\t    gh issue edit \"$issue_num\" --add-label \"$new_label\" 2>/dev/null\n135\t\n136\t  # merged 特殊处理：关闭 issue\n137\t  [ \"$new_status\" = \"merged\" ] && gh issue close \"$issue_num\" 2>/dev/null\n138\t}\n139\t"}]}
