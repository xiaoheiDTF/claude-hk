"$ISSUE_NUM\" --json title,state,assignees,labels --jq '{title,state,assignees:[.assignees[].login],labels:[.labels[].name]}' 2>/dev/null || echo \"无法获取 issue 信息\"\n99\t  fi\n100\telse\n101\t  # 无参数时列出未领取的 open issues\n102\t  if _gh --version &>/dev/null; then\n103\t    echo \"\"\n104\t    echo \"=== 可领取的 Issues ===\"\n105\t    issues=$(_gh issue list --state open --json number,title,labels,assignees 2>/dev/null)\n106\t    if [ -n \"$issues\" ] && [ \"$issues\" != \"[]\" ]; then\n107\t      # 过滤出无 assignee 的 issues\n108\t      unclaimed=$(echo \"$issues\" | jq -r '[.[] | select(.assignees | length == 0)]')\n109\t\n110\t      # [新增] 调后端过滤已被其他 Agent 领取的 issue\n111\t      filtered=$(filter_claimed_issues \"$unclaimed\")\n112\t\n113\t      count=$(echo \"$filtered\" | jq 'length')\n114\t      echo \"当前可领取的 open issues（共 $count 个）:\"\n115\t      echo \"\"\n116\t      echo \"$filtered\" | jq -r '.[] | \"#\\(.number) [\\([.labels[].name] | join(\",\"))] \\(.title)\\n  状态: 可领取\\n  请回复 /003-4-issue-claim #\\(.number) 来领取\\n\"'\n117\t    else\n118\t      echo \"(暂无 open issues)\"\n119\t    fi\n120\t  else\n121\t    echo \"gh CLI 不可用，请先安装 GitHub CLI\"\n122\t    echo \"请指定 issue 编号，例如: /003-4-issue-claim #5\"\n123\t  fi\n124\tfi\n125\t\n126\tskill_log \"INFO\" \"[inject] issue-claim context injected for #$ISSUE_NUM\"\n127\t"}]}
