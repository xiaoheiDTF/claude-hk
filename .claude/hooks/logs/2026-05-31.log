turn\n410\t\t}\n411\t\n412\t\tif req.SessionID == \"\" {\n413\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n414\t\t\treturn\n415\t\t}\n416\t\n417\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n418\t\n419\t\t// 若请求中未提供，则通过 trace 包自动检测"}]}
