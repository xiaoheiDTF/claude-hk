28-elicitation-result: 用户响应 MCP elicitation 后、响应发送回服务器之前触发\n3\t# 退出 2 可阻止响应 (操作变为 decline)\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\taction=$(json_get '.action')\n9\tcontent=$(json_get '.content')\n10\t\n11\tlog \"INFO\" \"action=$action\"\n12\t\n13\t# 示例: 阻止响应\n14\t# hook_output 2 '{\"hookSpecificOutput\":{\"hookEventName\":\"ElicitationResult\",\"action\":\"decline\"}}'\n15\t\n16\tdispatch_to_skill \"28\" || true\n17\thook_output 0 '{}'\n18\t"}]}
