unknown\" ;;\n157\t  esac\n158\t\n159\t  project_slug=$(echo \"$transcript_path\" | sed -n 's/.*[\\.]claude[\\\\/]\\{1\\}projects[\\\\/]\\{1\\}\\([^\\\\/]*\\).*/\\1/p')\n160\t  [ -z \"$project_slug\" ] && project_slug=$(basename \"$cwd\" 2>/dev/null)\n161\t\n162\t  _call_backend \"/api/session/register\" \"{\n163\t    \\\"session_id\\\":\\\"$session_id\\\",\n164\t    \\\"machine_id\\\":\\\"$machine_id\\\",\n165\t    \\\"os\\\":\\\"$os_type\\\",\n166\t    \\\"project_slug\\\":\\\"$project_slug\\\",\n167\t    \\\"project_cwd\\\":\\\"$cwd\\\",\n168\t    \\\"transcript_path\\\":\\\"$transcript_path\\\",\n169\t    \\\"model\\\":\\\"$model\\\",\n170\t    \\\"source\\\":\\\"$source_type\\\"\n171\t  }\" > /dev/null 2>&1\n172\t\n173\t  log \"INFO\" \"Session registered to backend: $session_id\"\n174\t}\n175\t\n176\tregister_session\n177\t\n178\thook_output 0 '{}'\n179\t"}]}
