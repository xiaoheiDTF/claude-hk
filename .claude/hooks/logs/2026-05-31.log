text.Context, repo string, number int, sessionID string, newStatus string) (*store.UpdateStatusResult, error) {\n36\t\tlogger.Debug(\"svc.issue\", \"UpdateStatus: repo=%s #%d session=%s -> %s\", repo, number, sessionID, newStatus)\n37\t\treturn svc.store.UpdateIssueStatus(ctx, repo, number, sessionID, newStatus)\n38\t}\n39\t\n40\t// Release 释放指定 session 持有的某个 Issue（仅限非终态）。\n41\t// 返回是否成功释放。\n42\tfunc (svc *IssueService) Release(ctx context.Context, repo string, number int, sessionID string) (bool, error) {\n43\t\tlogger.Debug(\"svc.issue\", \"Release: repo=%s #%d session=%s\", repo, number, sessionID)\n44\t\treturn svc.store.ReleaseIssue(ctx, repo, number, sessionID)\n45\t}\n46\t\n47\t// ReleaseSession 释放指定 session 持有的所有非终态 Issue。\n48\t// 返回被释放的 Issue 编号列表。\n49\tfunc (svc *IssueService) ReleaseSession(ctx context.Context, sessionID string) ([]int, error) {\n50\t\tlogger.Debug(\"svc.issue\", \"ReleaseSession: session=%s\", sessionID)\n51\t\treturn svc.store.ReleaseSessionIssues(ctx, sessionID)\n52\t}\n53\t"}]}
