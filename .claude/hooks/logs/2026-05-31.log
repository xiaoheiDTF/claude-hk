[2026-05-31 10:59:57] [INFO] [PostToolBatch] Input: {"session_id":"7b2b89f2-ee5f-44be-9351-b88ec9fac19c","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\7b2b89f2-ee5f-44be-9351-b88ec9fac19c.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"plan","agent_id":"a437da47e015ebb98","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\usage\\normalize.go"},"tool_use_id":"call_7a2729e1a84544fea6eb3865","tool_response":"1\tpackage usage\n2\t\n3\timport (\n4\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n5\t)\n6\t\n7\t// NormalizeUsage 将不同 Provider 特定的 Token 字段名统一映射到 Anthropic 规范的标准名称。\n8\t//\n9\t// 支持的 Provider 及其字段映射关系：\n10\t//   - Anthropic: input_tokens / output_tokens / cache_read_input_tokens / cache_creation_input_tokens\n11\t//   - OpenAI:    prompt_tokens / completion_tokens / cached_tokens\n12\t//   - Google Gemini: promptTokenCount / candidatesTokenCount / cachedContentTokenCount\n13\t//\n14\t// 此外，该函数还会检查嵌套结构（如 input_tokens_details.cached_tokens、\n15\t// prompt_tokens_details.cached_tokens），将其累加到 cache_read_input_tokens 中。\n16\t//\n17\t// 参数 usage 是原始 API 响应中的 usage 对象（map[string]any）。\n18\t// 返回按 Anthropic 规范标准化后的 Token 统计 map。\n19\tfunc NormalizeUsage(usage map[string]any) map[string]int64 {\n20\t\tif usage == nil {\n21\t\t\treturn nil\n22\t\t}\n23\t\n24\t\tlogger.Debug(\"usage\", \"normalize usage: keys=%v\", mapKeys(usage))\n25\t\n26\t\tresult := make(map[string]int64)\n27\t\n28\t\t// 映射输入 Token 数量：优先查找 Anthropic 字段名，其次 OpenAI、Gemini\n29\t\tresult[\"input_tokens\"] = firstInt64(usage,\n30\t\t\t\"input_tokens\",\n31\t\t\t\"prompt_tokens\",\n32\t\t\t\"promptTokenCount\",\n33\t\t)\n34\t\n35\t\t// 映射输出 Token 数量：优先查找 Anthropic 字段名，其次 OpenAI、Gemini\n36\t\tresult[\"output_tokens\"] = firstInt64(usage,\n37\t\t\t\"output_tokens\",\n38\t\t\t\"completion_tokens\",\n39\t\t\t\"candidatesTokenCount\",\n40\t\t)\n41\t\n42\t\t// 映射缓存读取的输入 Token 数量\n43\t\tresult[\"cache_read_input_tokens\"] = firstInt64(usage,\n44\t\t\t\"cache_read_input_tokens\",\n45\t\t\t\"cached_tokens\",\n46\t\t\t\"cachedContentTokenCount\",\n47\t\t)\n48\t\n49\t\t// 映射缓存创建的输入 Token 数量（目前仅 Anthropic 使用）\n50\t\tresult[\"cache_creation_input_tokens\"] = firstInt64(usage,\n51\t\t\t\"cache_creation_input_tokens\",\n52\t\t)\n53\t\n54\t\t// 处理嵌套结构：OpenAI 风格的 usage.input_tokens_details.cached_tokens\n55\t\tif details, ok := usage[\"input_tokens_details\"].(map[string]any); ok {\n56\t\t\tif v := intFromMap(details, \"cached_tokens\"); v > 0 {\n57\t\t\t\tresult[\"cache_read_input_tokens\"] += v\n58\t\t\t}\n59\t\t}\n60\t\t// 处理嵌套结构：OpenAI 风格的 usage.prompt_tokens_details.cached_tokens\n61\t\tif details, ok := usage[\"prompt_tokens_details\"].(map[string]any); ok {\n62\t\t\tif v := intFromMap(details, \"cached_tokens\"); v > 0 {\n63\t\t\t\tresult[\"cache_read_input_tokens\"] += v\n64\t\t\t}\n65\t\t}\n66\t\n67\t\tlogger.Debug(\"usage\", \"normalized: in=%d out=%d cache_read=%d cache_create=%d\",\n68\t\t\tresult[\"input_tokens\"], result[\"output_tokens\"],\n69\t\t\tresult[\"cache_read_input_tokens\"], result[\"cache_creation_input_tokens\"])\n70\t\n71\t\treturn result\n72\t}\n73\t\n74\t// firstInt64 在 map 中按给定 keys 的优先顺序查找第一个非零的 int64 值。\n75\t// 如果所有 key 都不存在或值为零，则返回 0。\n76\tfunc firstInt64(m map[string]any, keys ...string) int64 {\n77\t\tfor _, k := range keys {\n78\t\t\tif v := intFromMap(m, k); v != 0 {\n79\t\t\t\treturn v\n80\t\t\t}\n81\t\t}\n82\t\treturn 0\n83\t}\n84\t\n85\t// intFromMap 从 map 中按 key 提取 int64 值，兼容多种数值类型。\n86\t//\n87\t// 支持的类型：\n88\t//   - float64（JSON 反序列化后的数字默认类型）\n89\t//   - int\n90\t//   - int64\n91\t//   - json.Number（encoding/json 的数字类型，通过接口匹配避免引入包依赖）\n92\tfunc intFromMap(m map[string]any, key string) int64 {\n93\t\tv, ok := m[key]\n94\t\tif !ok {\n95\t\t\treturn 0\n96\t\t}\n97\t\tswitch n := v.(type) {\n98\t\tcase float64:\n99\t\t\treturn int64(n)\n100\t\tcase int:\n101\t\t\treturn int64(n)\n102\t\tcase int64:\n103\t\t\treturn n\n104\t\tcase json_number:\n105\t\t\tif i, err := n.Int64(); err == nil {\n106\t\t\t\treturn i\n107\t\t\t}\n108\t\t}\n109\t\treturn 0\n110\t}\n111\t\n112\t// json_number 是一个本地接口，用于匹配 encoding/json.Number 类型，\n113\t// 从而在不直接导入 encoding/json 包的情况下，安全地处理 JSON 数字值。\n114\ttype json_number interface{ Int64() (int64, error) }\n115\t\n116\t// mapKeys 返回 map 的 key 列表，用于调试日志。\n117\tfunc mapKeys(m map[string]any) []string {\n118\t\tkeys := make([]string, 0, len(m))\n119\t\tfor k := range m {\n120\t\t\tkeys = append(keys, k)\n121\t\t}\n122\t\treturn keys\n123\t}\n124\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\usage\\anthropic.go"},"tool_use_id":"call_affe979cf2cc444195093510","tool_response":"1\tpackage usage\n2\t\n3\t// AnthropicNormalizedUsage 定义了 Anthropic 风格的标准化 Token 用量结构体。\n4\t//\n5\t// 该结构体将不同 Provider（如 Anthropic、OpenAI、Google Gemini）各自的 Token 字段名\n6\t// 统一映射到 Anthropic 规范下的标准名称，便于后续统计和展示。\n7\ttype AnthropicNormalizedUsage struct {\n8\t\tInputTokens              int64 `json:\"input_tokens\"`                            // 输入 Token 数量（prompt tokens）\n9\t\tOutputTokens             int64 `json:\"output_tokens\"`                           // 输出 Token 数量（completion tokens）\n10\t\tCacheReadInputTokens     int64 `json:\"cache_read_input_tokens,omitempty\"`       // 缓存命中读取的输入 Token 数量（可选）\n11\t\tCacheCreationInputTokens int64 `json:\"cache_creation_input_tokens,omitempty\"`   // 缓存创建时写入的输入 Token 数量（可选）\n12\t}\n13\t"}]}
