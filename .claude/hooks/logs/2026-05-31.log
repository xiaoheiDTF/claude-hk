[2026-05-31 10:53:23] [INFO] [PostToolBatch] Input: {"session_id":"7b2b89f2-ee5f-44be-9351-b88ec9fac19c","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\7b2b89f2-ee5f-44be-9351-b88ec9fac19c.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"default","agent_id":"af8ac65681f50ae95","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\main.go"},"tool_use_id":"call_5d4c40f8ec0b48d2bb3824c6","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"log\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"os/signal\"\n9\t\t\"strings\"\n10\t\t\"syscall\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/config\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/proxy\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/session\"\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n18\t)\n19\t\n20\t// main 是 claude-tap-plus 的入口函数，负责解析子命令并分发到对应处理函数。\n21\t//\n22\t// 支持的子命令：\n23\t//   session-push    收集本地 Claude 会话到存储\n24\t//   session-pull    从存储恢复会话到 ~/.claude/\n25\t//   session-status  显示会话存储状态\n26\t//   backend         启动后端服务器模式\n27\t//   help            显示使用帮助\n28\t//\n29\t// 无子命令时默认进入代理模式（拦截 Claude Code API 流量）。\n30\tfunc main() {\n31\t\t// 设置日志格式：仅显示时间（含微秒）\n32\t\tlog.SetFlags(log.Ltime | log.Lmicroseconds)\n33\t\n34\t\t// 初始化文件日志器（使用默认 trace 目录）\n35\t\tlogDir := trace.DefaultTraceDir()\n36\t\tif err := logger.Init(logDir, false, logger.INFO); err != nil {\n37\t\t\tlog.Printf(\"warning: logger init failed: %v\", err)\n38\t\t}\n39\t\tdefer logger.Close()\n40\t\n41\t\t// 检测子命令，如果第一个参数是已知子命令则分发执行\n42\t\tif len(os.Args) > 1 {\n43\t\t\tswitch os.Args[1] {\n44\t\t\tcase \"session-push\":\n45\t\t\t\trunSessionPush(os.Args[2:])\n46\t\t\t\treturn\n47\t\t\tcase \"session-pull\":\n48\t\t\t\trunSessionPull(os.Args[2:])\n49\t\t\t\treturn\n50\t\t\tcase \"session-status\":\n51\t\t\t\trunSessionStatus(os.Args[2:])\n52\t\t\t\treturn\n53\t\t\tcase \"backend\":\n54\t\t\t\trunBackend(os.Args[2:])\n55\t\t\t\treturn\n56\t\t\tcase \"help\", \"--help\", \"-h\":\n57\t\t\t\tprintUsage()\n58\t\t\t\treturn\n59\t\t\t}\n60\t\t}\n61\t\n62\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n63\t\trunProxy(os.Args[1:])\n64\t}\n65\t\n66\t// printUsage 打印命令行使用帮助信息到标准输出。\n67\tfunc printUsage() {\n68\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n69\t\tfmt.Println()\n70\t\tfmt.Println(\"Usage:\")\n71\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n72\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n73\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n74\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n75\t\tfmt.Println()\n76\t\tfmt.Println(\"Proxy flags:\")\n77\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n78\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n79\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n80\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n81\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n82\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n83\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n84\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n85\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n86\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n87\t\tfmt.Println()\n88\t\tfmt.Println(\"Session-push flags:\")\n89\t\tfmt.Println(\"  --all                  Collect all projects\")\n90\t\tfmt.Println(\"  --force                Overwrite existing files\")\n91\t\tfmt.Println(\"  --dry-run              Preview only\")\n92\t\tfmt.Println(\"  --project NAME         Override project name\")\n93\t\tfmt.Println()\n94\t\tfmt.Println(\"Session-pull flags:\")\n95\t\tfmt.Println(\"  --all                  Restore all projects\")\n96\t\tfmt.Println(\"  --project NAME         Override project name\")\n97\t\tfmt.Println(\"  --dry-run              Preview only\")\n98\t\tfmt.Println()\n99\t\tfmt.Println(\"Session-status flags:\")\n100\t\tfmt.Println(\"  --verbose              Show file-level details\")\n101\t}\n102\t\n103\t// runProxy 是默认的代理模式主逻辑。\n104\t//\n105\t// 工作流程：\n106\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n107\t//  2. 自动探测上游 API 目标地址\n108\t//  3. 启动本地反向代理监听指定端口\n109\t//  4. 解析 Claude Code 可执行文件路径\n110\t//  5. 构建子进程环境变量（注入代理地址）\n111\t//  6. 启动 Claude Code 作为子进程\n112\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n113\t//  8. 子进程退出后打印 API 调用统计摘要\n114\tfunc runProxy(args []string) {\n115\t\t// 记录原始命令行参数，用于生成 resume 命令\n116\t\toriginalArgs := append([]string{}, args...)\n117\t\n118\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n119\t\tvar (\n120\t\t\ttapTarget    string // 上游 API 目标地址\n121\t\t\ttapPort      int    // 本地代理监听端口\n122\t\t\ttapOutputDir string // 追踪记录输出目录\n123\t\t\ttapVerbose   bool   // 是否启用详细日志\n124\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n125\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n126\t\t\ttapAPIKey    string // 直接传入 API Key\n127\t\t\ttapAuthToken string // 直接传入 OAuth Token\n128\t\t\ttapBaseURL   string // 直接传入上游地址\n129\t\t)\n130\t\n131\t\tvar claudeArgs []string\n132\t\tfor i := 0; i < len(args); i++ {\n133\t\t\targ := args[i]\n134\t\t\tswitch {\n135\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n136\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n137\t\t\t\ti++\n138\t\t\t\ttapTarget = args[i]\n139\t\t\t// 解析 --tap-target=URL 形式\n140\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n141\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n142\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n143\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n144\t\t\t\ti++\n145\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n146\t\t\t// 解析 --tap-port=PORT 形式\n147\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n148\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n149\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n150\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n151\t\t\t\ti++\n152\t\t\t\ttapOutputDir = args[i]\n153\t\t\t// 解析 --tap-output-dir=DIR 形式\n154\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n155\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n156\t\t\t// 启用详细日志\n157\t\t\tcase arg == \"--tap-verbose\":\n158\t\t\t\ttapVerbose = true\n159\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n160\t\t\tcase arg == \"--tap-console\":\n161\t\t\t\ttapConsole = true\n162\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n163\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n164\t\t\t\ti++\n165\t\t\t\ttapProfile = args[i]\n166\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n167\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n168\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n169\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n170\t\t\t\ti++\n171\t\t\t\ttapAPIKey = args[i]\n172\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n173\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n174\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n175\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n176\t\t\t\ti++\n177\t\t\t\ttapAuthToken = args[i]\n178\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n179\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n180\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n181\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n182\t\t\t\ti++\n183\t\t\t\ttapBaseURL = args[i]\n184\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n185\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n186\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n187\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n188\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n189\t\t\t\ti = len(args) // 停止解析\n190\t\t\t// 未知的 --tap-* 标志，直接忽略\n191\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n192\t\t\t// 其他参数视为 Claude Code 的参数\n193\t\t\tdefault:\n194\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n195\t\t\t}\n196\t\t}\n197\t\n198\t\t// 如果未指定输出目录，使用默认追踪目录\n199\t\tif tapOutputDir == \"\" {\n200\t\t\ttapOutputDir = trace.DefaultTraceDir()\n201\t\t}\n202\t\n203\t\t// 校验：--tap-console 必须配合 --tap-verbose\n204\t\tif tapConsole && !tapVerbose {\n205\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n206\t\t\tos.Exit(1)\n207\t\t}\n208\t\n209\t\t// 根据详细程度重新初始化日志器\n210\t\tif tapVerbose {\n211\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n212\t\t} else {\n213\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n214\t\t}\n215\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n216\t\n217\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n218\t\tresolved, err := config.ResolveTargetConfig(\n219\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n220\t\t\ttapAPIKey,\n221\t\t\ttapAuthToken,\n222\t\t\ttapProfile,\n223\t\t\t&config.ClaudeClient,\n224\t\t)\n225\t\tif err != nil {\n226\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n227\t\t}\n228\t\ttarget := resolved.BaseURL\n229\t\tif tapVerbose {\n230\t\t\tlog.Printf(\"upstream target: %s\", target)\n231\t\t}\n232\t\n233\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n234\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n235\t\tport := tapPort\n236\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n237\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n238\t\tif err != nil {\n239\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n240\t\t}\n241\t\t// 函数退出时停止代理\n242\t\tdefer rp.Stop()\n243\t\n244\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n245\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n246\t\n247\t\t// 自动检测并启动后端服务（如果未运行）\n248\t\tensureBackend()\n249\t\n250\t\t// 向后端注册本代理（hooks 通过后端转发 trace-init）\n251\t\tregisterProxyWithBackend(proxyURL)\n252\t\t// 代理退出时注销\n253\t\tdefer unregisterProxyFromBackend()\n254\t\n255\t\t// 设置会话初始化回调：注册到 proxy.json\n256\t\trp.OnSessionInit = func(sessionID, projectSlug string) {\n257\t\t\tkey := ProxySessionKey(projectSlug, sessionID)\n258\t\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\n259\t\t\t\tlogger.Warn(\"main\", \"register proxy session failed: %v\", err)\n260\t\t\t}\n261\t\t}\n262\t\t// 代理退出时注销 proxy.json 中的会话\n263\t\tdefer func() {\n264\t\t\tif sid := rp.SessionID(); sid != \"\" {\n265\t\t\t\tslug := rp.ProjectSlug()\n266\t\t\t\tkey := ProxySessionKey(slug, sid)\n267\t\t\t\tif err := UnregisterProxySession(key); err != nil {\n268\t\t\t\t\tlogger.Warn(\"main\", \"unregister proxy session failed: %v\", err)\n269\t\t\t\t}\n270\t\t\t}\n271\t\t}()\n272\t\n273\t\t// 解析 Claude Code 可执行文件路径\n274\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n275\t\tif err != nil {\n276\t\t\tlog.Fatal(err)\n277\t\t}\n278\t\n279\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n280\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n281\t\n282\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n283\t\tif resolved.APIKey != \"\" {\n284\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n285\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n286\t\t} else if resolved.AuthToken != \"\" {\n287\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n288\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n289\t\t}\n290\t\n291\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n292\t\tfinalArgs := claudeArgs\n293\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n294\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n295\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n296\t\t}\n297\t\n298\t\t// 启动 Claude Code 作为子进程\n299\t\tcmd := exec.Command(claudePath, finalArgs...)\n300\t\tcmd.Env = childEnv\n301\t\tcmd.Stdin = os.Stdin\n302\t\tcmd.Stdout = os.Stdout\n303\t\tcmd.Stderr = os.Stderr\n304\t\n305\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n306\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n307\t\n308\t\tif err := cmd.Start(); err != nil {\n309\t\t\tlog.Fatalf(\"start claude: %v\", err)\n310\t\t}\n311\t\n312\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n313\t\tsigChan := make(chan os.Signal, 2)\n314\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n315\t\n316\t\tgo func() {\n317\t\t\tsigCount := 0\n318\t\t\tfor sig := range sigChan {\n319\t\t\t\tsigCount++\n320\t\t\t\tif sigCount == 1 {\n321\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n322\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n323\t\t\t\t\t_ = cmd.Process.Signal(sig)\n324\t\t\t\t} else {\n325\t\t\t\t\t// 再次收到信号：强制终止子进程\n326\t\t\t\t\t_ = cmd.Process.Kill()\n327\t\t\t\t}\n328\t\t\t}\n329\t\t}()\n330\t\n331\t\t// 等待子进程结束\n332\t\twaitErr := cmd.Wait()\n333\t\n334\t\t// 停止信号处理器，释放资源\n335\t\tsignal.Stop(sigChan)\n336\t\tclose(sigChan)\n337\t\n338\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n339\t\tsummary := rp.Summary()\n340\t\ttracePath := rp.TracePath()\n341\t\n342\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n343\t\tif waitErr != nil {\n344\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n345\t\t}\n346\t\tfmt.Printf(\"\\n\")\n347\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n348\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n349\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n350\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n351\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n352\t\tif tracePath != \"\" {\n353\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n354\t\t}\n355\t\tfmt.Printf(\"\\n\")\n356\t\n357\t\t// 生成 Resume 命令（仅在有 session_id 时）\n358\t\tsessionID := rp.SessionID()\n359\t\tif sessionID != \"\" {\n360\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n361\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n362\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n363\t\t}\n364\t}\n365\t\n366\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n367\t//\n368\t// 支持的参数：\n369\t//   --all       收集所有项目的会话\n370\t//   --force     覆盖已存在的会话文件\n371\t//   --dry-run   仅预览，不实际执行\n372\t//   --project   指定项目名称，覆盖自动检测\n373\tfunc runSessionPush(args []string) {\n374\t\tvar opts session.PushOptions\n375\t\tfor i := 0; i < len(args); i++ {\n376\t\t\targ := args[i]\n377\t\t\tswitch {\n378\t\t\tcase arg == \"--all\":\n379\t\t\t\topts.All = true\n380\t\t\tcase arg == \"--force\":\n381\t\t\t\topts.Force = true\n382\t\t\tcase arg == \"--dry-run\":\n383\t\t\t\topts.DryRun = true\n384\t\t\tcase arg == \"--project\" && i+1 < len(args):\n385\t\t\t\ti++\n386\t\t\t\topts.Project = args[i]\n387\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n388\t\t\t\topts.Project = arg[len(\"--project=\"):]\n389\t\t\t}\n390\t\t}\n391\t\n392\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n393\t\tresults, err := session.SessionPush(opts)\n394\t\tif err != nil {\n395\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n396\t\t\tos.Exit(1)\n397\t\t}\n398\t\n399\t\t// 汇总各项目的收集结果\n400\t\tfmt.Println()\n401\t\ttotalNew, totalSkipped := 0, 0\n402\t\tfor _, r := range results {\n403\t\t\ttotalNew += r.SessionsNew\n404\t\t\ttotalSkipped += r.SessionsSkipped\n405\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n406\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n407\t\t\t}\n408\t\t}\n409\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n410\t}\n411\t\n412\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n413\t//\n414\t// 支持的参数：\n415\t//   --all       恢复所有项目的会话\n416\t//   --dry-run   仅预览，不实际执行\n417\t//   --project   指定项目名称，覆盖自动检测\n418\tfunc runSessionPull(args []string) {\n419\t\tvar opts session.PullOptions\n420\t\tfor i := 0; i < len(args); i++ {\n421\t\t\targ := args[i]\n422\t\t\tswitch {\n423\t\t\tcase arg == \"--all\":\n424\t\t\t\topts.All = true\n425\t\t\tcase arg == \"--dry-run\":\n426\t\t\t\topts.DryRun = true\n427\t\t\tcase arg == \"--project\" && i+1 < len(args):\n428\t\t\t\ti++\n429\t\t\t\topts.Project = args[i]\n430\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n431\t\t\t\topts.Project = arg[len(\"--project=\"):]\n432\t\t\t}\n433\t\t}\n434\t\n435\t\tfmt.Println(\"📤 Restoring sessions...\")\n436\t\tresults, err := session.SessionPull(opts)\n437\t\tif err != nil {\n438\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n439\t\t\tos.Exit(1)\n440\t\t}\n441\t\n442\t\t// 汇总各项目的恢复结果\n443\t\tfmt.Println()\n444\t\ttotalRestored, totalSkipped := 0, 0\n445\t\tfor _, r := range results {\n446\t\t\ttotalRestored += r.SessionsRestored\n447\t\t\ttotalSkipped += r.SessionsSkipped\n448\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n449\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n450\t\t\t}\n451\t\t}\n452\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n453\t}\n454\t\n455\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n456\t//\n457\t// 支持的参数：\n458\t//   --verbose   显示文件级别的详细信息\n459\tfunc runSessionStatus(args []string) {\n460\t\tvar opts session.StatusOptions\n461\t\tfor i := 0; i < len(args); i++ {\n462\t\t\targ := args[i]\n463\t\t\tswitch {\n464\t\t\tcase arg == \"--verbose\":\n465\t\t\t\topts.Verbose = true\n466\t\t\t}\n467\t\t}\n468\t\n469\t\tif err := session.SessionStatus(opts); err != nil {\n470\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n471\t\t\tos.Exit(1)\n472\t\t}\n473\t}\n474\t\n475\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n476\t// 如果参数中包含空格或制表符，则使用引号包裹。\n477\tfunc formatArgs(args []string) string {\n478\t\tresult := \"\"\n479\t\tfor _, a := range args {\n480\t\t\tif containsSpace(a) {\n481\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n482\t\t\t} else {\n483\t\t\t\tresult += \" \" + a\n484\t\t\t}\n485\t\t}\n486\t\treturn strings.TrimSpace(result)\n487\t}\n488\t\n489\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n490\tfunc containsSpace(s string) bool {\n491\t\tfor _, c := range s {\n492\t\t\tif c == ' ' || c == '\\t' {\n493\t\t\t\treturn true\n494\t\t\t}\n495\t\t}\n496\t\treturn false\n497\t}\n498\t\n499\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n500\tfunc firstNonEmpty(ss ...string) string {\n501\t\tfor _, s := range ss {\n502\t\t\tif s != \"\" {\n503\t\t\t\treturn s\n504\t\t\t}\n505\t\t}\n506\t\treturn \"\"\n507\t}\n508\t\n509\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n510\t//\n511\t// 逻辑：\n512\t//  1. 复制原始参数\n513\t//  2. 移除已有的 --resume <old-id>（如果存在）\n514\t//  3. 追加 --resume <new-session-id>\n515\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n516\t\tfiltered := make([]string, 0, len(originalArgs))\n517\t\tskip := false\n518\t\tfor i, arg := range originalArgs {\n519\t\t\tif skip {\n520\t\t\t\tskip = false\n521\t\t\t\tcontinue\n522\t\t\t}\n523\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n524\t\t\t\tskip = true // 跳过 --resume 及其值\n525\t\t\t\tcontinue\n526\t\t\t}\n527\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n528\t\t\t\tcontinue // 跳过 --resume=id 形式\n529\t\t\t}\n530\t\t\tfiltered = append(filtered, arg)\n531\t\t}\n532\t\tfiltered = append(filtered, \"--resume\", sessionID)\n533\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n534\t}\n535\t\n536\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n537\tfunc shortenPath(path string) string {\n538\t\thome, err := os.UserHomeDir()\n539\t\tif err != nil {\n540\t\t\treturn path\n541\t\t}\n542\t\tif strings.HasPrefix(path, home) {\n543\t\t\treturn \"~\" + path[len(home):]\n544\t\t}\n545\t\treturn path\n546\t}\n547\t\n548\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n549\tfunc removeEnvVar(env []string, name string) []string {\n550\t\tprefix := name + \"=\"\n551\t\tresult := make([]string, 0, len(env))\n552\t\tfor _, e := range env {\n553\t\t\tif !strings.HasPrefix(e, prefix) {\n554\t\t\t\tresult = append(result, e)\n555\t\t\t}\n556\t\t}\n557\t\treturn result\n558\t}\n559\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\reverse.go"},"tool_use_id":"call_a96aa518b2ed4a4d9aee2fef","tool_response":"1\t// Package proxy 提供 HTTP 代理功能，包括请求转发、SSE 流式处理与 Trace 记录。\n2\tpackage proxy\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"compress/gzip\"\n7\t\t\"compress/zlib\"\n8\t\t\"encoding/json\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"net/http\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\t\"sync/atomic\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n19\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n20\t)\n21\t\n22\t// ReverseProxy 拦截 HTTP 请求并转发到上游 API，同时记录请求/响应到 JSONL Trace，并处理 SSE 流式响应。\n23\ttype ReverseProxy struct {\n24\t\ttarget         string              // 上游 API 目标地址\n25\t\tbaseDir        string              // Trace 文件存放的基础目录\n26\t\twriter         *trace.TraceWriter  // 当前会话的 Trace 写入器（由 _internal/trace-init 创建）\n27\t\tclient         *http.Client        // 转发请求的 HTTP 客户端\n28\t\tturn           atomic.Int64        // 请求计数器，用于标记 Turn 编号\n29\t\tserver         *http.Server        // 本地代理 HTTP 服务器\n30\t\tstartOnce      sync.Once           // 确保 Start 只执行一次\n31\t\tsessionID      string              // 当前会话 ID（由 trace-init 设置）\n32\t\tprojectSlug    string              // 当前项目标识（由 trace-init 设置）\n33\t\tOnSessionInit  func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\n34\t}\n35\t\n36\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n37\t// traceDir 为 Trace 文件存放的基础目录。\n38\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n39\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n40\t\treturn &ReverseProxy{\n41\t\t\ttarget:  strings.TrimRight(target, \"/\"),\n42\t\t\tbaseDir: traceDir,\n43\t\t\tclient: &http.Client{\n44\t\t\t\tTimeout: 0, // 流式场景不设超时\n45\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n46\t\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n47\t\t\t\t},\n48\t\t\t},\n49\t\t}\n50\t}\n51\t\n52\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n53\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n54\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n55\t\tmux := http.NewServeMux()\n56\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n57\t\tp.server = &http.Server{\n58\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n59\t\t\tHandler: mux,\n60\t\t}\n61\t\n62\t\tlistener, err := ioListener(p.server.Addr)\n63\t\tif err != nil {\n64\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n65\t\t}\n66\t\n67\t\t// 在后台 goroutine 中启动服务\n68\t\tgo func() {\n69\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n70\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n71\t\t\t}\n72\t\t}()\n73\t\n74\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n75\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n76\t\treturn actualPort, nil\n77\t}\n78\t\n79\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n80\tfunc (p *ReverseProxy) Stop() {\n81\t\tlogger.Info(\"proxy\", \"stopping\")\n82\t\tif p.writer != nil {\n83\t\t\tp.writer.Close()\n84\t\t}\n85\t\tif p.server != nil {\n86\t\t\t_ = p.server.Close()\n87\t\t}\n88\t}\n89\t\n90\t// serveHTTP 是代理的核心 HTTP 处理函数。\n91\t// 处理流程：内部端点 → 路径白名单检查 → 读取请求体 → 构建上游请求 → 转发 → 流式/非流式处理。\n92\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n93\t\t// 处理内部端点（绕过路径白名单）\n94\t\tif strings.HasPrefix(r.URL.Path, \"/_internal/\") {\n95\t\t\tp.handleInternal(w, r)\n96\t\t\treturn\n97\t\t}\n98\t\n99\t\t// 拒绝未知路径\n100\t\tif !IsAllowedPath(r.URL.Path) {\n101\t\t\thttp.NotFound(w, r)\n102\t\t\treturn\n103\t\t}\n104\t\n105\t\t// 读取请求体\n106\t\tbodyBytes, err := io.ReadAll(r.Body)\n107\t\tif err != nil {\n108\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n109\t\t\treturn\n110\t\t}\n111\t\t_ = r.Body.Close()\n112\t\n113\t\t// 解析请求体为 JSON（用于后续提取 model、stream 等字段）\n114\t\tvar reqBody any\n115\t\tif len(bodyBytes) > 0 {\n116\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n117\t\t}\n118\t\n119\t\t// 生成请求 ID 与 Turn 编号\n120\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n121\t\tturn := int(p.turn.Add(1))\n122\t\tt0 := time.Now()\n123\t\n124\t\tlogger.Debug(\"proxy\", \"[Turn %d] request: %s %s (%d bytes)\", turn, r.Method, r.URL.Path, len(bodyBytes))\n125\t\n126\t\t// 构建上游请求 URL\n127\t\tupstreamURL := p.target + r.URL.Path\n128\t\tif r.URL.RawQuery != \"\" {\n129\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n130\t\t}\n131\t\n132\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n133\t\tif err != nil {\n134\t\t\thttp.Error(w, \"create upstream request: \"+err.Error(), http.StatusBadGateway)\n135\t\t\treturn\n136\t\t}\n137\t\n138\t\t// 复制请求头，过滤逐跳头\n139\t\tfor k, vals := range r.Header {\n140\t\t\tlower := strings.ToLower(k)\n141\t\t\tif hopByHopHeaders[lower] {\n142\t\t\t\tcontinue\n143\t\t\t}\n144\t\t\tfor _, v := range vals {\n145\t\t\t\tupstreamReq.Header.Add(k, v)\n146\t\t\t}\n147\t\t}\n148\t\tupstreamReq.Header.Del(\"Host\")\n149\t\n150\t\t// 向上游发送请求\n151\t\tupstreamResp, err := p.client.Do(upstreamReq)\n152\t\tif err != nil {\n153\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error: %v\", turn, err)\n154\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n155\t\t\treturn\n156\t\t}\n157\t\tdefer upstreamResp.Body.Close()\n158\t\n159\t\tduration := time.Since(t0).Milliseconds()\n160\t\n161\t\t// 从请求体中提取 model 字段\n162\t\tmodel := \"\"\n163\t\tif m, ok := reqBody.(map[string]any); ok {\n164\t\t\tif v, ok := m[\"model\"].(string); ok {\n165\t\t\t\tmodel = v\n166\t\t\t}\n167\t\t}\n168\t\n169\t\t// 检测是否为流式请求\n170\t\tisStreaming := false\n171\t\tif m, ok := reqBody.(map[string]any); ok {\n172\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n173\t\t\t\tisStreaming = s\n174\t\t\t}\n175\t\t}\n176\t\n177\t\t// 根据是否流式分发到对应处理器\n178\t\tif isStreaming {\n179\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n180\t\t} else {\n181\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n182\t\t}\n183\t}\n184\t\n185\t// handleStreaming 处理 SSE 流式响应：\n186\t//   - 复制响应头并写入客户端\n187\t//   - 逐块读取上游响应体并实时转发给客户端\n188\t//   - 使用 SSE 重组器收集完整事件\n189\t//   - 将重组后的结果写入 Trace\n190\tfunc (p *ReverseProxy) handleStreaming(\n191\t\tw http.ResponseWriter,\n192\t\tupstreamResp *http.Response,\n193\t\treqID string, turn, durationMs int,\n194\t\tr *http.Request, reqBody any,\n195\t\tt0 time.Time, model string,\n196\t) {\n197\t\t// 复制响应头\n198\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n199\t\tfor k, vals := range respHeaders {\n200\t\t\tfor _, v := range vals {\n201\t\t\t\tw.Header().Add(k, v)\n202\t\t\t}\n203\t\t}\n204\t\tw.WriteHeader(upstreamResp.StatusCode)\n205\t\n206\t\tflusher, canFlush := w.(http.Flusher)\n207\t\treassembler := sse.NewSSEReassembler()\n208\t\n209\t\t// 逐块读取并转发流式数据\n210\t\tbuf := make([]byte, 32*1024)\n211\t\tfor {\n212\t\t\tn, err := upstreamResp.Body.Read(buf)\n213\t\t\tif n > 0 {\n214\t\t\t\t_, _ = w.Write(buf[:n])\n215\t\t\t\tif canFlush {\n216\t\t\t\t\tflusher.Flush()\n217\t\t\t\t}\n218\t\t\t\treassembler.FeedBytes(buf[:n])\n219\t\t\t}\n220\t\t\tif err != nil {\n221\t\t\t\tbreak\n222\t\t\t}\n223\t\t}\n224\t\n225\t\tdurationMs = int(time.Since(t0).Milliseconds())\n226\t\treconstructed := reassembler.Reconstruct()\n227\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n228\t\n229\t\t// 构建 Trace 记录\n230\t\trecord := buildRecord(\n231\t\t\treqID, turn, durationMs,\n232\t\t\tr.Method, r.URL.RequestURI(),\n233\t\t\tr.Header, reqBody,\n234\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n235\t\t\treconstructed,\n236\t\t\treassembler.Events,\n237\t\t\tp.target,\n238\t\t)\n239\t\n240\t\tif w := p.getWriter(); w != nil {\n241\t\t\tif err := w.Write(record); err != nil {\n242\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n243\t\t\t}\n244\t\t} else {\n245\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n246\t\t}\n247\t\n248\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n249\t}\n250\t\n251\t// handleNonStreaming 处理普通（非流式）响应：\n252\t//   - 读取完整响应体\n253\t//   - 按需解压（gzip / deflate）\n254\t//   - 解析 JSON 响应体\n255\t//   - 写入 Trace 并返回给客户端\n256\tfunc (p *ReverseProxy) handleNonStreaming(\n257\t\tw http.ResponseWriter,\n258\t\tupstreamResp *http.Response,\n259\t\treqID string, turn, durationMs int,\n260\t\tr *http.Request, reqBody any, model string,\n261\t) {\n262\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n263\t\tif err != nil {\n264\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n265\t\t\treturn\n266\t\t}\n267\t\n268\t\t// 按需解压响应体\n269\t\tdecodeBytes := respBytes\n270\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n271\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n272\t\t\tvar reader io.ReadCloser\n273\t\t\tif encoding == \"gzip\" {\n274\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n275\t\t\t} else {\n276\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n277\t\t\t}\n278\t\t\tif reader != nil {\n279\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n280\t\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n281\t\t\t\t\tdecodeBytes = decoded\n282\t\t\t\t}\n283\t\t\t\t_ = reader.Close()\n284\t\t\t}\n285\t\t}\n286\t\n287\t\t// 解析解压后的 JSON 响应体\n288\t\tvar respBody any\n289\t\tif len(decodeBytes) > 0 {\n290\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n291\t\t}\n292\t\n293\t\t// 构建 Trace 记录\n294\t\trecord := buildRecord(\n295\t\t\treqID, turn, durationMs,\n296\t\t\tr.Method, r.URL.RequestURI(),\n297\t\t\tr.Header, reqBody,\n298\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n299\t\t\trespBody,\n300\t\t\tnil,\n301\t\t\tp.target,\n302\t\t)\n303\t\n304\t\tif w := p.getWriter(); w != nil {\n305\t\t\tif err := w.Write(record); err != nil {\n306\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n307\t\t\t}\n308\t\t} else {\n309\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n310\t\t}\n311\t\n312\t\t// 将响应返回给客户端\n313\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n314\t\tfor k, vals := range respHeaders {\n315\t\t\tfor _, v := range vals {\n316\t\t\t\tw.Header().Add(k, v)\n317\t\t\t}\n318\t\t}\n319\t\tw.WriteHeader(upstreamResp.StatusCode)\n320\t\t_, _ = w.Write(respBytes)\n321\t\n322\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n323\t}\n324\t\n325\t// buildRecord 构建一条 Trace 记录，包含请求/响应的完整信息。\n326\tfunc buildRecord(\n327\t\treqID string, turn, durationMs int,\n328\t\tmethod, path string,\n329\t\treqHeaders http.Header, reqBody any,\n330\t\tstatus int, respHeaders http.Header,\n331\t\trespBody any,\n332\t\tsseEvents []map[string]any,\n333\t\tupstreamBaseURL string,\n334\t) map[string]any {\n335\t\trecord := map[string]any{\n336\t\t\t\"timestamp\":   time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n337\t\t\t\"request_id\":  reqID,\n338\t\t\t\"session_id\":  extractSessionID(reqBody),\n339\t\t\t\"turn\":        turn,\n340\t\t\t\"duration_ms\": durationMs,\n341\t\t\t\"request\": map[string]any{\n342\t\t\t\t\"method\":  method,\n343\t\t\t\t\"path\":    path,\n344\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n345\t\t\t\t\"body\":    reqBody,\n346\t\t\t},\n347\t\t\t\"response\": map[string]any{\n348\t\t\t\t\"status\":  status,\n349\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n350\t\t\t\t\"body\":    respBody,\n351\t\t\t},\n352\t\t}\n353\t\tif len(sseEvents) > 0 {\n354\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n355\t\t}\n356\t\tif upstreamBaseURL != \"\" {\n357\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n358\t\t}\n359\t\treturn record\n360\t}\n361\t\n362\t// extractSessionID 从请求体的 metadata.user_id 字段中提取 session_id。\n363\t// Claude Code 发送的格式为：metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n364\tfunc extractSessionID(reqBody any) string {\n365\t\tbody, ok := reqBody.(map[string]any)\n366\t\tif !ok {\n367\t\t\treturn \"\"\n368\t\t}\n369\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n370\t\tif metadata == nil {\n371\t\t\treturn \"\"\n372\t\t}\n373\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n374\t\tif userIDRaw == \"\" {\n375\t\t\treturn \"\"\n376\t\t}\n377\t\tvar userData map[string]string\n378\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n379\t\t\treturn \"\"\n380\t\t}\n381\t\treturn userData[\"session_id\"]\n382\t}\n383\t\n384\t// handleInternal 分发内部代理端点请求。\n385\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n386\t\tswitch r.URL.Path {\n387\t\tcase \"/_internal/trace-init\":\n388\t\t\tp.handleTraceInit(w, r)\n389\t\tdefault:\n390\t\t\thttp.NotFound(w, r)\n391\t\t}\n392\t}\n393\t\n394\t// handleTraceInit 接收 SessionStart 钩子传来的会话信息，创建 Trace 写入器。\n395\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n396\t\tif r.Method != http.MethodPost {\n397\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n398\t\t\treturn\n399\t\t}\n400\t\n401\t\tvar req struct {\n402\t\t\tSessionID      string `json:\"session_id\"`\n403\t\t\tMachineID      string `json:\"machine_id\"`\n404\t\t\tProjectSlug    string `json:\"project_slug\"`\n405\t\t\tTranscriptPath string `json:\"transcript_path\"`\n406\t\t}\n407\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n408\t\t\tlogger.Warn(\"proxy\", \"trace-init: invalid JSON: %v\", err)\n409\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n410\t\t\treturn\n411\t\t}\n412\t\n413\t\tif req.SessionID == \"\" {\n414\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n415\t\t\treturn\n416\t\t}\n417\t\n418\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n419\t\n420\t\t// 若请求中未提供，则通过 trace 包自动检测\n421\t\tmachineID := req.MachineID\n422\t\tif machineID == \"\" {\n423\t\t\tmachineID = trace.MachineID()\n424\t\t}\n425\t\n426\t\tprojectSlug := req.ProjectSlug\n427\t\tif projectSlug == \"\" {\n428\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n429\t\t\tif projectSlug == \"\" {\n430\t\t\t\tprojectSlug = trace.DetectProjectName()\n431\t\t\t}\n432\t\t}\n433\t\n434\t\t// 创建会话专属的 Trace 写入器\n435\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n436\t\twriter, err := trace.NewTraceWriter(tracePath)\n437\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n438\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n439\t\tif err != nil {\n440\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n441\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n442\t\t\treturn\n443\t\t}\n444\t\n445\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n446\t\t\tif p.writer != nil {\n447\t\t\t\tp.writer.Close()\n448\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n449\t\t\t}\n450\t\tp.writer = writer\n451\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n452\t\n453\t\t// 通知外部注册 proxy.json\n454\t\tif p.OnSessionInit != nil {\n455\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n456\t\t}\n457\t\n458\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n459\t\tjson.NewEncoder(w).Encode(map[string]string{\n460\t\t\t\"status\":     \"ok\",\n461\t\t\t\"trace_path\": tracePath,\n462\t\t})\n463\t}\n464\t\n465\t// getWriter 返回当前会话的 Trace 写入器。\n466\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n467\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n468\t\treturn p.writer\n469\t}\n470\t\n471\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n472\t// 若无有效写入器，返回零值统计。\n473\tfunc (p *ReverseProxy) Summary() map[string]any {\n474\t\tif w := p.getWriter(); w != nil {\n475\t\t\treturn w.Summary()\n476\t\t}\n477\t\treturn map[string]any{\n478\t\t\t\"api_calls\":           0,\n479\t\t\t\"input_tokens\":        int64(0),\n480\t\t\t\"output_tokens\":       int64(0),\n481\t\t\t\"cache_read_tokens\":   int64(0),\n482\t\t\t\"cache_create_tokens\": int64(0),\n483\t\t}\n484\t}\n485\t\n486\t// SessionID 返回当前会话的 session_id。\n487\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n488\tfunc (p *ReverseProxy) SessionID() string {\n489\t\tif p.sessionID != \"\" {\n490\t\t\treturn p.sessionID\n491\t\t}\n492\t\tif w := p.getWriter(); w != nil {\n493\t\t\treturn w.SessionID()\n494\t\t}\n495\t\treturn \"\"\n496\t}\n497\t\n498\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n499\tfunc (p *ReverseProxy) ProjectSlug() string {\n500\t\treturn p.projectSlug\n501\t}\n502\t\n503\t// TracePath 返回当前追踪文件的完整路径。\n504\tfunc (p *ReverseProxy) TracePath() string {\n505\t\tif w := p.getWriter(); w != nil {\n506\t\t\treturn w.Path()\n507\t\t}\n508\t\treturn \"\"\n509\t}\n510\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\sse\\reassembler.go"},"tool_use_id":"call_c585f64b907d439cbcb2f03d","tool_response":"1\tpackage sse\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/usage\"\n11\t)\n12\t\n13\t// SSEReassembler 解析原始 SSE（Server-Sent Events）字节流，并将流式片段重组成完整的 API 响应。\n14\t//\n15\t// 支持的协议：\n16\t//   - Anthropic Messages API Streaming\n17\t//   - OpenAI Chat Completions Streaming\n18\t//   - OpenAI Responses API Streaming\n19\t//\n20\t// 使用方式：\n21\t//\n22\t//\tr := sse.NewSSEReassembler()\n23\t//\tr.FeedBytes(chunk)       // 多次调用，分块送入 SSE 数据\n24\t//\tsnapshot := r.Reconstruct() // 获取当前累积的完整响应快照\n25\t//\tevents := r.Events       // 获取所有解析出的原始事件列表\n26\ttype SSEReassembler struct {\n27\t\tEvents   []map[string]any // 解析出的所有原始 SSE 事件列表\n28\t\tbuf      []byte           // 未处理完的 SSE 字节缓冲区\n29\t\tcurEv    *string          // 当前正在解析的事件类型（event: xxx）\n30\t\tcurData  []string         // 当前事件的 data 行累积（支持多行 data）\n31\t\tsnap     map[string]any   // 重建后的完整响应快照\n32\t\tfedOnce  bool             // 是否已接收过首块数据（用于首次日志）\n33\t}\n34\t\n35\t// NewSSEReassembler 创建一个新的 SSE 重组器实例。\n36\tfunc NewSSEReassembler() *SSEReassembler {\n37\t\treturn &SSEReassembler{}\n38\t}\n39\t\n40\t// FeedBytes 追加原始 SSE 字节数据并处理已完整的行。\n41\t//\n42\t// 该方法按 \\n 分割输入数据，逐行解析 SSE 协议中的 event、data 字段，\n43\t// 遇到空行时触发事件生成并调用累积逻辑更新快照。\n44\t// 可以多次调用以处理分块传输的数据。\n45\tfunc (r *SSEReassembler) FeedBytes(chunk []byte) {\n46\t\tif !r.fedOnce {\n47\t\t\tlogger.Debug(\"sse\", \"FeedBytes: first chunk size=%d\", len(chunk))\n48\t\t\tr.fedOnce = true\n49\t\t}\n50\t\tr.buf = append(r.buf, chunk...)\n51\t\tfor {\n52\t\t\tidx := bytes.IndexByte(r.buf, '\\n')\n53\t\t\tif idx < 0 {\n54\t\t\t\tbreak\n55\t\t\t}\n56\t\t\tline := r.buf[:idx]\n57\t\t\tr.buf = r.buf[idx+1:]\n58\t\t\tr.feedLine(string(line))\n59\t\t}\n60\t}\n61\t\n62\t// Reconstruct 返回当前累积的消息快照。\n63\t//\n64\t// 如果尚未收到足够的事件来构建快照（如仅收到部分 SSE 帧），则返回 nil。\n65\tfunc (r *SSEReassembler) Reconstruct() map[string]any {\n66\t\treturn r.snap\n67\t}\n68\t\n69\t// feedLine 处理单条 SSE 文本行，解析 event、data 和空行分隔符。\n70\t//\n71\t// SSE 协议规则：\n72\t//   - 以 \"event:\" 开头的行设置当前事件类型\n73\t//   - 以 \"data:\" 开头的行追加到当前事件的数据 payload\n74\t//   - 空行表示当前事件结束，触发事件生成\n75\t//   - \"[DONE]\" 是 OpenAI 的流结束标记，直接忽略\n76\tfunc (r *SSEReassembler) feedLine(line string) {\n77\t\tline = strings.TrimRight(line, \"\\r\")\n78\t\n79\t\tif strings.HasPrefix(line, \"event:\") {\n80\t\t\tev := strings.TrimSpace(line[len(\"event:\"):])\n81\t\t\tr.curEv = &ev\n82\t\t\tr.curData = nil\n83\t\t} else if strings.HasPrefix(line, \"data:\") {\n84\t\t\tr.curData = append(r.curData, strings.TrimSpace(line[len(\"data:\"):]))\n85\t\t} else if line == \"\" {\n86\t\t\t// 空行触发事件：如果既没有 event 也没有 data 则跳过\n87\t\t\tif r.curEv == nil && len(r.curData) == 0 {\n88\t\t\t\treturn\n89\t\t\t}\n90\t\t\traw := strings.Join(r.curData, \"\\n\")\n91\t\n92\t\t\t// 跳过 OpenAI 的 [DONE] 哨兵标记\n93\t\t\tif raw == \"[DONE]\" && r.curEv == nil {\n94\t\t\t\tr.curEv = nil\n95\t\t\t\tr.curData = nil\n96\t\t\t\treturn\n97\t\t\t}\n98\t\n99\t\t\tvar data any\n100\t\t\tif err := json.Unmarshal([]byte(raw), &data); err != nil {\n101\t\t\t\tdata = raw\n102\t\t\t}\n103\t\n104\t\t\tevType := \"message\"\n105\t\t\tif r.curEv != nil {\n106\t\t\t\tevType = *r.curEv\n107\t\t\t}\n108\t\t\tr.addEvent(evType, data)\n109\t\t\tr.curEv = nil\n110\t\t\tr.curData = nil\n111\t\t}\n112\t}\n113\t\n114\t// addEvent 将解析出的单个 SSE 事件追加到事件列表，并触发累积更新。\n115\tfunc (r *SSEReassembler) addEvent(eventType string, data any) {\n116\t\tr.Events = append(r.Events, map[string]any{\"event\": eventType, \"data\": data})\n117\t\tr.accumulate(eventType, data)\n118\t}\n119\t\n120\t// accumulate 按事件类型将流式片段累积到响应快照中。\n121\t//\n122\t// 支持的事件类型及处理逻辑：\n123\t//   - message_start:      初始化快照为 message 对象\n124\t//   - response.created/completed/done: OpenAI Responses API，初始化或更新快照\n125\t//   - message:            OpenAI Chat Completions 流，调用 accumulateChatCompletionChunk\n126\t//   - content_block_start: 向快照 content 数组添加新的内容块\n127\t//   - content_block_delta: 更新指定索引的内容块（文本、推理、JSON 片段）\n128\t//   - content_block_stop:  将累积的 partial_json 解析为 input 字段\n129\t//   - message_delta:       更新 message 级别的 delta（如 stop_reason）和 usage\n130\tfunc (r *SSEReassembler) accumulate(eventType string, data any) {\n131\t\tm, ok := data.(map[string]any)\n132\t\tif !ok {\n133\t\t\treturn\n134\t\t}\n135\t\n136\t\tswitch eventType {\n137\t\tcase \"message_start\":\n138\t\t\tif msg, ok := m[\"message\"].(map[string]any); ok {\n139\t\t\t\tr.snap = deepCopy(msg)\n140\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_start, model=%v\", msg[\"model\"])\n141\t\t\t}\n142\t\n143\t\tcase \"response.created\", \"response.completed\", \"response.done\":\n144\t\t\tif resp, ok := m[\"response\"].(map[string]any); ok {\n145\t\t\t\tr.snap = deepCopy(resp)\n146\t\t\t} else if eventType == \"response.completed\" || eventType == \"response.done\" {\n147\t\t\t\tr.snap = deepCopy(m)\n148\t\t\t}\n149\t\n150\t\tcase \"message\":\n151\t\t\tif _, hasChoices := m[\"choices\"]; hasChoices {\n152\t\t\t\tr.accumulateChatCompletionChunk(m)\n153\t\t\t\treturn\n154\t\t\t}\n155\t\n156\t\tcase \"content_block_start\":\n157\t\t\tif r.snap == nil {\n158\t\t\t\treturn\n159\t\t\t}\n160\t\t\tblock := deepCopy(m[\"content_block\"].(map[string]any))\n161\t\t\tidx := int(float64Val(m[\"index\"]))\n162\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_start idx=%d type=%v\", idx, block[\"type\"])\n163\t\t\tif _, ok := r.snap[\"content\"]; !ok {\n164\t\t\t\tr.snap[\"content\"] = []any{}\n165\t\t\t}\n166\t\t\tcontent := r.snap[\"content\"].([]any)\n167\t\t\tfor len(content) <= idx {\n168\t\t\t\tcontent = append(content, map[string]any{})\n169\t\t\t}\n170\t\t\tcontent[idx] = block\n171\t\t\tr.snap[\"content\"] = content\n172\t\n173\t\tcase \"content_block_delta\":\n174\t\t\tif r.snap == nil {\n175\t\t\t\treturn\n176\t\t\t}\n177\t\t\tidx := int(float64Val(m[\"index\"]))\n178\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n179\t\t\tif delta == nil {\n180\t\t\t\treturn\n181\t\t\t}\n182\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n183\t\t\tif idx >= len(content) {\n184\t\t\t\treturn\n185\t\t\t}\n186\t\t\tblock, _ := content[idx].(map[string]any)\n187\t\t\tif block == nil {\n188\t\t\t\treturn\n189\t\t\t}\n190\t\t\tswitch delta[\"type\"] {\n191\t\t\tcase \"text_delta\":\n192\t\t\t\tblock[\"text\"] = strVal(block[\"text\"]) + strVal(delta[\"text\"])\n193\t\t\tcase \"thinking_delta\":\n194\t\t\t\tblock[\"thinking\"] = strVal(block[\"thinking\"]) + strVal(delta[\"thinking\"])\n195\t\t\tcase \"input_json_delta\":\n196\t\t\t\tblock[\"_partial_json\"] = strVal(block[\"_partial_json\"]) + strVal(delta[\"partial_json\"])\n197\t\t\t}\n198\t\n199\t\tcase \"content_block_stop\":\n200\t\t\tif r.snap == nil {\n201\t\t\t\treturn\n202\t\t\t}\n203\t\t\tidx := int(float64Val(m[\"index\"]))\n204\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n205\t\t\tif idx >= len(content) {\n206\t\t\t\treturn\n207\t\t\t}\n208\t\t\tblock, _ := content[idx].(map[string]any)\n209\t\t\tif block == nil {\n210\t\t\t\treturn\n211\t\t\t}\n212\t\t\t// 将累积的 JSON 字符串片段解析为结构化的 input 字段\n213\t\t\tif pj, ok := block[\"_partial_json\"]; ok {\n214\t\t\t\tvar parsed any\n215\t\t\t\tif json.Unmarshal([]byte(strVal(pj)), &parsed) == nil {\n216\t\t\t\t\tblock[\"input\"] = parsed\n217\t\t\t\t}\n218\t\t\t\tdelete(block, \"_partial_json\")\n219\t\t\t}\n220\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_stop idx=%d\", idx)\n221\t\n222\t\tcase \"message_delta\":\n223\t\t\tif r.snap == nil {\n224\t\t\t\treturn\n225\t\t\t}\n226\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n227\t\t\tif delta != nil {\n228\t\t\t\tfor k, v := range delta {\n229\t\t\t\t\tr.snap[k] = v\n230\t\t\t\t}\n231\t\t\t}\n232\t\t\tif u, ok := m[\"usage\"].(map[string]any); ok {\n233\t\t\t\tif _, exists := r.snap[\"usage\"]; !exists {\n234\t\t\t\t\tr.snap[\"usage\"] = map[string]any{}\n235\t\t\t\t}\n236\t\t\t\texisting := r.snap[\"usage\"].(map[string]any)\n237\t\t\t\tfor k, v := range u {\n238\t\t\t\t\texisting[k] = v\n239\t\t\t\t}\n240\t\t\t}\n241\t\t\tif delta != nil {\n242\t\t\t\tif sr, ok := delta[\"stop_reason\"]; ok && sr != nil {\n243\t\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_delta stop_reason=%v\", sr)\n244\t\t\t\t}\n245\t\t\t}\n246\t\t}\n247\t}\n248\t\n249\t// --- OpenAI Chat Completions 流式累积 ---\n250\t\n251\t// accumulateChatCompletionChunk 处理 OpenAI Chat Completions Streaming 的单个 chunk。\n252\t//\n253\t// 该函数将 choices[0].delta 中的内容逐块累积，同时处理：\n254\t//   - role、content、reasoning_content 的拼接\n255\t//   - tool_calls 的渐进式构建（id、name、arguments 分块到达）\n256\t//   - usage 信息的合并\n257\t//   - finish_reason 的更新\n258\t//\n259\t// 快照结构兼容 Anthropic 格式，content 数组中会同时维护文本块和工具调用块。\n260\tfunc (r *SSEReassembler) accumulateChatCompletionChunk(data map[string]any) {\n261\t\tchoices, _ := data[\"choices\"].([]any)\n262\t\trawUsage, _ := data[\"usage\"]\n263\t\n264\t\tif len(choices) == 0 {\n265\t\t\tif u, ok := rawUsage.(map[string]any); ok && r.snap != nil {\n266\t\t\t\tr.mergeChatUsage(u)\n267\t\t\t}\n268\t\t\treturn\n269\t\t}\n270\t\n271\t\tchoice, _ := choices[0].(map[string]any)\n272\t\tif choice == nil {\n273\t\t\treturn\n274\t\t}\n275\t\tdelta, _ := choice[\"delta\"].(map[string]any)\n276\t\tfinishReason := choice[\"finish_reason\"]\n277\t\tchoiceUsage, _ := choice[\"usage\"].(map[string]any)\n278\t\n279\t\t// 首个 chunk 时初始化快照\n280\t\tif r.snap == nil {\n281\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk init, model=%s\", strVal(data[\"model\"]))\n282\t\t\tr.snap = map[string]any{\n283\t\t\t\t\"id\":     strVal(data[\"id\"]),\n284\t\t\t\t\"object\": \"chat.completion\",\n285\t\t\t\t\"model\":  strVal(data[\"model\"]),\n286\t\t\t\t\"choices\": []any{\n287\t\t\t\t\tmap[string]any{\n288\t\t\t\t\t\t\"index\":         0,\n289\t\t\t\t\t\t\"message\":       map[string]any{\"role\": strVal(fieldStr(delta, \"role\")), \"content\": \"\"},\n290\t\t\t\t\t\t\"finish_reason\": nil,\n291\t\t\t\t\t},\n292\t\t\t\t},\n293\t\t\t\t\"content\": []any{map[string]any{\"type\": \"text\", \"text\": \"\"}},\n294\t\t\t}\n295\t\t\tif role := strVal(fieldStr(delta, \"role\")); role == \"\" {\n296\t\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)[\"role\"] = \"assistant\"\n297\t\t\t}\n298\t\t}\n299\t\n300\t\tmsg := r.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n301\t\ttextBlock := r.chatTextBlock()\n302\t\n303\t\tif role := strVal(fieldStr(delta, \"role\")); role != \"\" {\n304\t\t\tmsg[\"role\"] = role\n305\t\t}\n306\t\tif rc := strVal(fieldStr(delta, \"reasoning_content\")); rc != \"\" {\n307\t\t\tmsg[\"reasoning_content\"] = strVal(msg[\"reasoning_content\"]) + rc\n308\t\t\tr.mirrorReasoning(strVal(msg[\"reasoning_content\"]))\n309\t\t}\n310\t\tif c := strVal(fieldStr(delta, \"content\")); c != \"\" {\n311\t\t\tmsg[\"content\"] = strVal(msg[\"content\"]) + c\n312\t\t\ttextBlock[\"text\"] = strVal(textBlock[\"text\"]) + c\n313\t\t}\n314\t\n315\t\t// 工具调用增量处理\n316\t\tfor _, tcRaw := range sliceField(delta, \"tool_calls\") {\n317\t\t\ttcDelta, _ := tcRaw.(map[string]any)\n318\t\t\tif tcDelta == nil {\n319\t\t\t\tcontinue\n320\t\t\t}\n321\t\t\tidx := int(float64Val(tcDelta[\"index\"]))\n322\t\t\ttoolCalls, _ := msg[\"tool_calls\"].([]any)\n323\t\t\tif toolCalls == nil {\n324\t\t\t\ttoolCalls = []any{}\n325\t\t\t}\n326\t\t\tfor len(toolCalls) <= idx {\n327\t\t\t\ttoolCalls = append(toolCalls, map[string]any{\n328\t\t\t\t\t\"id\":   \"\",\n329\t\t\t\t\t\"type\": \"function\",\n330\t\t\t\t\t\"function\": map[string]any{\n331\t\t\t\t\t\t\"name\":      \"\",\n332\t\t\t\t\t\t\"arguments\": \"\",\n333\t\t\t\t\t},\n334\t\t\t\t})\n335\t\t\t}\n336\t\t\texisting := toolCalls[idx].(map[string]any)\n337\t\t\tif id := strVal(tcDelta[\"id\"]); id != \"\" {\n338\t\t\t\texisting[\"id\"] = id\n339\t\t\t}\n340\t\t\tif t := strVal(tcDelta[\"type\"]); t != \"\" {\n341\t\t\t\texisting[\"type\"] = t\n342\t\t\t}\n343\t\t\tif fnDelta, ok := tcDelta[\"function\"].(map[string]any); ok {\n344\t\t\t\tfn, _ := existing[\"function\"].(map[string]any)\n345\t\t\t\tif fn == nil {\n346\t\t\t\t\tfn = map[string]any{\"name\": \"\", \"arguments\": \"\"}\n347\t\t\t\t}\n348\t\t\t\tif n := strVal(fnDelta[\"name\"]); n != \"\" {\n349\t\t\t\t\tfn[\"name\"] = strVal(fn[\"name\"]) + n\n350\t\t\t\t}\n351\t\t\t\tif a := strVal(fnDelta[\"arguments\"]); a != \"\" {\n352\t\t\t\t\tfn[\"arguments\"] = strVal(fn[\"arguments\"]) + a\n353\t\t\t\t}\n354\t\t\t\texisting[\"function\"] = fn\n355\t\t\t}\n356\t\t\ttoolCalls[idx] = existing\n357\t\t\tmsg[\"tool_calls\"] = toolCalls\n358\t\t\tr.mirrorToolCall(idx, existing)\n359\t\t}\n360\t\n361\t\tif finishReason != nil && finishReason != \"\" {\n362\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"finish_reason\"] = finishReason\n363\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk finish_reason=%v\", finishReason)\n364\t\t}\n365\t\n366\t\tif u, ok := rawUsage.(map[string]any); ok {\n367\t\t\tr.mergeChatUsage(u)\n368\t\t}\n369\t\tif choiceUsage != nil {\n370\t\t\tr.mergeChatUsage(choiceUsage)\n371\t\t}\n372\t}\n373\t\n374\t// chatTextBlock 获取或创建快照中的文本内容块。\n375\t// 返回 content 数组中第一个 type=\"text\" 的块；如果不存在则新建一个。\n376\tfunc (r *SSEReassembler) chatTextBlock() map[string]any {\n377\t\tcontent := r.snap[\"content\"].([]any)\n378\t\tfor _, b := range content {\n379\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"text\" {\n380\t\t\t\treturn block\n381\t\t\t}\n382\t\t}\n383\t\tblock := map[string]any{\"type\": \"text\", \"text\": \"\"}\n384\t\tr.snap[\"content\"] = append(content, block)\n385\t\treturn block\n386\t}\n387\t\n388\t// mirrorReasoning 将 reasoning_content 同步到 content 数组中的 thinking 块。\n389\t// 如果 content 中不存在 thinking 块，则在开头插入一个。\n390\tfunc (r *SSEReassembler) mirrorReasoning(reasoning string) {\n391\t\tcontent := r.snap[\"content\"].([]any)\n392\t\tfor _, b := range content {\n393\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n394\t\t\t\tblock[\"thinking\"] = reasoning\n395\t\t\t\treturn\n396\t\t\t}\n397\t\t}\n398\t\tblock := map[string]any{\"type\": \"thinking\", \"thinking\": reasoning}\n399\t\tr.snap[\"content\"] = append([]any{block}, content...)\n400\t}\n401\t\n402\t// mirrorToolCall 将 Chat Completions 的 tool_call 同步到 Anthropic 格式的 content 数组中。\n403\t//\n404\t// 同步规则：\n405\t//   - 在 content 数组中查找或创建对应的 tool_use 块\n406\t//   - 将 function name 映射为 tool_use 的 name\n407\t//   - 将 arguments JSON 解析后映射为 tool_use 的 input\n408\t//   - thinking 块的存在会影响工具调用块在 content 中的索引偏移\n409\tfunc (r *SSEReassembler) mirrorToolCall(idx int, tc map[string]any) {\n410\t\tcontent := r.snap[\"content\"].([]any)\n411\t\t// 如果存在 thinking 块，工具调用的位置需要偏移 1\n412\t\toffset := 1\n413\t\tfor _, b := range content {\n414\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n415\t\t\t\toffset = 2\n416\t\t\t\tbreak\n417\t\t\t}\n418\t\t}\n419\t\ttarget := idx + offset\n420\t\tfor len(content) <= target {\n421\t\t\tcontent = append(content, map[string]any{\"type\": \"tool_use\", \"id\": \"\", \"name\": \"\", \"input\": map[string]any{}})\n422\t\t}\n423\t\tblock := content[target].(map[string]any)\n424\t\tif id := strVal(tc[\"id\"]); id != \"\" {\n425\t\t\tblock[\"id\"] = id\n426\t\t}\n427\t\tif fn, ok := tc[\"function\"].(map[string]any); ok {\n428\t\t\tif n := strVal(fn[\"name\"]); n != \"\" {\n429\t\t\t\tblock[\"name\"] = n\n430\t\t\t}\n431\t\t\tif args := strVal(fn[\"arguments\"]); args != \"\" {\n432\t\t\t\tvar parsed any\n433\t\t\t\tif json.Unmarshal([]byte(args), &parsed) == nil {\n434\t\t\t\t\tblock[\"input\"] = parsed\n435\t\t\t\t}\n436\t\t\t}\n437\t\t}\n438\t\tr.snap[\"content\"] = content\n439\t}\n440\t\n441\t// mergeChatUsage 将 OpenAI Chat Completions 的 usage 数据标准化后合并到快照。\n442\tfunc (r *SSEReassembler) mergeChatUsage(u map[string]any) {\n443\t\tr.snap[\"usage\"] = usage.NormalizeUsage(u)\n444\t}\n445\t\n446\t// --- 辅助函数 ---\n447\t\n448\t// deepCopy 通过 JSON 序列化/反序列化实现 map 的深拷贝。\n449\tfunc deepCopy(m map[string]any) map[string]any {\n450\t\tif m == nil {\n451\t\t\treturn nil\n452\t\t}\n453\t\tdata, _ := json.Marshal(m)\n454\t\tresult := make(map[string]any)\n455\t\t_ = json.Unmarshal(data, &result)\n456\t\treturn result\n457\t}\n458\t\n459\t// float64Val 将任意数值类型转换为 float64。\n460\t// 支持 float64、int、int64；不支持的类型返回 0。\n461\tfunc float64Val(v any) float64 {\n462\t\tswitch n := v.(type) {\n463\t\tcase float64:\n464\t\t\treturn n\n465\t\tcase int:\n466\t\t\treturn float64(n)\n467\t\tcase int64:\n468\t\t\treturn float64(n)\n469\t\t}\n470\t\treturn 0\n471\t}\n472\t\n473\t// strVal 将任意值转换为字符串。\n474\t// nil 返回空字符串，string 类型直接返回，其他类型使用 fmt.Sprintf 格式化。\n475\tfunc strVal(v any) string {\n476\t\tif v == nil {\n477\t\t\treturn \"\"\n478\t\t}\n479\t\tif s, ok := v.(string); ok {\n480\t\t\treturn s\n481\t\t}\n482\t\treturn fmt.Sprintf(\"%v\", v)\n483\t}\n484\t\n485\t// fieldStr 从 map 中安全获取字段值。\n486\tfunc fieldStr(m map[string]any, key string) any {\n487\t\tv, _ := m[key]\n488\t\treturn v\n489\t}\n490\t\n491\t// sliceField 从 map 中获取 []any 类型的字段，如果不存在或类型不匹配则返回 nil。\n492\tfunc sliceField(m map[string]any, key string) []any {\n493\t\tv, _ := m[key].([]any)\n494\t\tif v == nil {\n495\t\t\treturn nil\n496\t\t}\n497\t\treturn v\n498\t}\n499\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\trace\\writer.go"},"tool_use_id":"call_3e8d5981c0e948dfbc3e5536","tool_response":"1\tpackage trace\n2\t\n3\timport (\n4\t\t\"bufio\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"os\"\n8\t\t\"os/user\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\t\"sync\"\n12\t\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/usage\"\n15\t)\n16\t\n17\t// TraceWriter 负责将 API 调用记录以 JSONL 格式追加写入追踪文件，\n18\t// 并在写入过程中累计 Token 用量统计。\n19\t//\n20\t// 使用方式：\n21\t//\n22\t//\ttw, err := trace.NewTraceWriter(path)\n23\t//\ttw.Write(record)\n24\t//\tsummary := tw.Summary()\n25\t//\ttw.Close()\n26\ttype TraceWriter struct {\n27\t\tmu           sync.Mutex     // 保护并发写入和统计更新\n28\t\tfile         *os.File       // 底层追踪文件句柄\n29\t\twriter       *bufio.Writer  // 缓冲写入器，提升写入性能\n30\t\tcount        int            // 已写入记录数（API 调用次数）\n31\t\tinputTokens  int64          // 累计输入 Token\n32\t\toutputTokens int64          // 累计输出 Token\n33\t\tcacheRead    int64          // 累计缓存读取 Token\n34\t\tcacheCreate  int64          // 累计缓存创建 Token\n35\t\tmodelsUsed   map[string]int // 各模型使用次数统计\n36\t\tpath         string         // 追踪文件路径\n37\t\tsessionID    string         // 从首条记录提取的 session_id\n38\t}\n39\t\n40\t// NewTraceWriter 创建 TraceWriter 实例，按需创建输出目录并打开追踪文件。\n41\t//\n42\t// 参数 path 为追踪文件的完整路径。函数会自动创建路径中缺失的目录，\n43\t// 并以追加模式打开文件（如果不存在则创建）。\n44\tfunc NewTraceWriter(path string) (*TraceWriter, error) {\n45\t\tdir := filepath.Dir(path)\n46\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n47\t\t\treturn nil, fmt.Errorf(\"create trace dir: %w\", err)\n48\t\t}\n49\t\tlogger.Debug(\"trace\", \"ensured directory: %s\", dir)\n50\t\n51\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)\n52\t\tif err != nil {\n53\t\t\treturn nil, fmt.Errorf(\"open trace file: %w\", err)\n54\t\t}\n55\t\n56\t\tlogger.Info(\"trace\", \"trace writer opened: %s\", path)\n57\t\n58\t\treturn &TraceWriter{\n59\t\t\tfile:       f,\n60\t\t\twriter:     bufio.NewWriter(f),\n61\t\t\tmodelsUsed: make(map[string]int),\n62\t\t\tpath:       path,\n63\t\t}, nil\n64\t}\n65\t\n66\t// Write 将单条记录序列化为 JSON 行写入文件，并立即刷新缓冲区，\n67\t// 同时更新内部统计计数。\n68\t//\n69\t// 记录格式为 JSON Lines（每行一条独立 JSON，以换行符分隔），\n70\t// 便于后续按行读取和解析。\n71\tfunc (w *TraceWriter) Write(record map[string]any) error {\n72\t\tw.mu.Lock()\n73\t\tdefer w.mu.Unlock()\n74\t\n75\t\tdata, err := json.Marshal(record)\n76\t\tif err != nil {\n77\t\t\treturn fmt.Errorf(\"marshal trace record: %w\", err)\n78\t\t}\n79\t\n80\t\tif _, err := w.writer.Write(data); err != nil {\n81\t\t\treturn err\n82\t\t}\n83\t\tif _, err := w.writer.WriteString(\"\\n\"); err != nil {\n84\t\t\treturn err\n85\t\t}\n86\t\tif err := w.writer.Flush(); err != nil {\n87\t\t\treturn err\n88\t\t}\n89\t\n90\t\tlogger.Debug(\"trace\", \"record #%d written: %d bytes\", w.count+1, len(data))\n91\t\n92\t\tw.count++\n93\t\tw.updateStats(record)\n94\t\n95\t\t// 从首条记录提取 session_id\n96\t\tif w.count == 1 {\n97\t\t\tif sid, ok := record[\"session_id\"].(string); ok {\n98\t\t\t\tw.sessionID = sid\n99\t\t\t}\n100\t\t}\n101\t\treturn nil\n102\t}\n103\t\n104\t// Close 刷新缓冲区并关闭底层文件。\n105\t// 应在追踪会话结束时调用，以确保所有数据落盘。\n106\tfunc (w *TraceWriter) Close() error {\n107\t\tw.mu.Lock()\n108\t\tdefer w.mu.Unlock()\n109\t\tlogger.Info(\"trace\", \"trace writer closed: %d records written\", w.count)\n110\t\tif w.writer != nil {\n111\t\t\t_ = w.writer.Flush()\n112\t\t}\n113\t\tif w.file != nil {\n114\t\t\treturn w.file.Close()\n115\t\t}\n116\t\treturn nil\n117\t}\n118\t\n119\t// Path 返回追踪文件的完整路径。\n120\tfunc (w *TraceWriter) Path() string {\n121\t\treturn w.path\n122\t}\n123\t\n124\t// SessionID 返回从追踪记录中提取的 session_id。\n125\t// 如果尚无记录或首条记录不含 session_id，返回空字符串。\n126\tfunc (w *TraceWriter) SessionID() string {\n127\t\treturn w.sessionID\n128\t}\n129\t\n130\t// Summary 返回当前追踪会话的聚合统计信息。\n131\t//\n132\t// 返回的 map 包含以下字段：\n133\t//   - api_calls:            API 调用总次数\n134\t//   - input_tokens:         累计输入 Token\n135\t//   - output_tokens:        累计输出 Token\n136\t//   - cache_read_tokens:    累计缓存读取 Token\n137\t//   - cache_create_tokens:  累计缓存创建 Token\n138\t//   - models_used:          各模型调用次数 map[string]int\n139\tfunc (w *TraceWriter) Summary() map[string]any {\n140\t\tw.mu.Lock()\n141\t\tdefer w.mu.Unlock()\n142\t\n143\t\treturn map[string]any{\n144\t\t\t\"api_calls\":           w.count,\n145\t\t\t\"input_tokens\":        w.inputTokens,\n146\t\t\t\"output_tokens\":       w.outputTokens,\n147\t\t\t\"cache_read_tokens\":   w.cacheRead,\n148\t\t\t\"cache_create_tokens\": w.cacheCreate,\n149\t\t\t\"models_used\":         w.modelsUsed,\n150\t\t}\n151\t}\n152\t\n153\t// updateStats 从单条记录中提取模型信息和 Token 用量，更新累计统计。\n154\t//\n155\t// 提取逻辑：\n156\t//  1. 从 request.body.model 获取模型名称，归入 modelsUsed 计数\n157\t//  2. 从 response.body.usage 或 body 顶层提取 usage 数据\n158\t//  3. 使用 usage.NormalizeUsage 标准化后累加到各 Token 计数器\n159\tfunc (w *TraceWriter) updateStats(record map[string]any) {\n160\t\t// 从请求体中提取模型名称\n161\t\treqBody, _ := record[\"request\"].(map[string]any)\n162\t\tif reqBody != nil {\n163\t\t\tif body, ok := reqBody[\"body\"].(map[string]any); ok {\n164\t\t\t\tmodel, _ := body[\"model\"].(string)\n165\t\t\t\tif model == \"\" {\n166\t\t\t\t\tmodel = \"unknown\"\n167\t\t\t\t}\n168\t\t\t\tw.modelsUsed[model]++\n169\t\t\t}\n170\t\t}\n171\t\n172\t\t// 从响应体中提取 Token 用量\n173\t\trespBody, _ := record[\"response\"].(map[string]any)\n174\t\tif respBody == nil {\n175\t\t\treturn\n176\t\t}\n177\t\tbody, _ := respBody[\"body\"].(map[string]any)\n178\t\tif body == nil {\n179\t\t\treturn\n180\t\t}\n181\t\n182\t\trawUsage, _ := body[\"usage\"].(map[string]any)\n183\t\tif rawUsage == nil {\n184\t\t\t// 某些情况下 usage 直接位于 body 顶层\n185\t\t\trawUsage = body\n186\t\t}\n187\t\n188\t\tnorm := usage.NormalizeUsage(rawUsage)\n189\t\tw.inputTokens += norm[\"input_tokens\"]\n190\t\tw.outputTokens += norm[\"output_tokens\"]\n191\t\tw.cacheRead += norm[\"cache_read_input_tokens\"]\n192\t\tw.cacheCreate += norm[\"cache_creation_input_tokens\"]\n193\t}\n194\t\n195\t// DefaultTraceDir 返回默认的追踪文件存储目录，位于用户主目录下。\n196\t//\n197\t// 默认路径：$HOME/.claude-tap-plus/.traces\n198\t// 如果无法获取用户主目录，则返回相对路径 \".claude-tap-plus/.traces\"。\n199\tfunc DefaultTraceDir() string {\n200\t\thome, err := os.UserHomeDir()\n201\t\tif err != nil {\n202\t\t\treturn \".claude-tap-plus/.traces\"\n203\t\t}\n204\t\tdir := filepath.Join(home, \".claude-tap-plus\", \".traces\")\n205\t\tlogger.Debug(\"trace\", \"default trace dir: %s\", dir)\n206\t\treturn dir\n207\t}\n208\t\n209\t// DetectProjectName 返回当前工作目录对应的项目名称。\n210\t//\n211\t// 优先级：\n212\t//  1. 从 git remote origin URL 提取仓库名（如 my-project）\n213\t//  2. 当前工作目录的目录名作为兜底\n214\tfunc DetectProjectName() string {\n215\t\tcwd, _ := os.Getwd()\n216\t\t// 优先尝试从 git 远程地址获取仓库名\n217\t\tif cwd != \"\" {\n218\t\t\trepo := gitRemoteRepoName(cwd)\n219\t\t\tif repo != \"\" {\n220\t\t\t\tlogger.Debug(\"trace\", \"detected project name: %s (from git)\", repo)\n221\t\t\t\treturn repo\n222\t\t\t}\n223\t\t}\n224\t\t// 兜底：使用当前目录名\n225\t\tproject := filepath.Base(cwd)\n226\t\tif project == \"\" || project == \".\" {\n227\t\t\tproject = \"default\"\n228\t\t}\n229\t\tlogger.Debug(\"trace\", \"detected project name: %s (from cwd)\", project)\n230\t\treturn project\n231\t}\n232\t\n233\t// gitRemoteRepoName 从 .git/config 文件中提取 remote origin 对应的仓库名。\n234\t//\n235\t// 示例：\n236\t//\n237\t//\t\"https://github.com/user/my-project.git\" → \"my-project\"\n238\t//\n239\t// 直接读取配置文件以避免依赖 git 命令。\n240\tfunc gitRemoteRepoName(dir string) string {\n241\t\tconfigPath := filepath.Join(dir, \".git\", \"config\")\n242\t\tdata, err := os.ReadFile(configPath)\n243\t\tif err != nil {\n244\t\t\treturn \"\"\n245\t\t}\n246\t\tcontent := string(data)\n247\t\t// 定位 [remote \"origin\"] 区域并提取 URL\n248\t\tlines := strings.Split(content, \"\\n\")\n249\t\tinOrigin := false\n250\t\tfor _, line := range lines {\n251\t\t\ttrimmed := strings.TrimSpace(line)\n252\t\t\tif trimmed == `[remote \"origin\"]` {\n253\t\t\t\tinOrigin = true\n254\t\t\t\tcontinue\n255\t\t\t}\n256\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"url = \") {\n257\t\t\t\turl := strings.TrimPrefix(trimmed, \"url = \")\n258\t\t\t\t// 提取 URL 最后一段并去掉 .git 后缀\n259\t\t\t\tbase := filepath.Base(url)\n260\t\t\t\tbase = strings.TrimSuffix(base, \".git\")\n261\t\t\t\treturn base\n262\t\t\t}\n263\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"[\") {\n264\t\t\t\tbreak // 已进入下一个配置区域\n265\t\t\t}\n266\t\t}\n267\t\treturn \"\"\n268\t}\n269\t\n270\t// MachineID 返回 \"用户名@主机名\" 格式的机器标识符。\n271\t// 用于区分不同机器的追踪数据。\n272\tfunc MachineID() string {\n273\t\thostname, _ := os.Hostname()\n274\t\tif hostname == \"\" {\n275\t\t\thostname = \"unknown\"\n276\t\t}\n277\t\tusername := \"unknown\"\n278\t\tif u, err := user.Current(); err == nil && u.Username != \"\" {\n279\t\t\tusername = u.Username\n280\t\t}\n281\t\treturn username + \"@\" + hostname\n282\t}\n283\t\n284\t// ExtractProjectSlug 从 Claude Code 的会话转录文件路径中提取项目标识（slug）。\n285\t//\n286\t// 输入示例：\n287\t//\n288\t//\t\"C:\\Users\\Admin\\.claude\\projects\\D--xxx-yyy\\uuid.jsonl\"\n289\t//\n290\t// 输出：\n291\t//\n292\t//\t\"D--xxx-yyy\"\n293\t//\n294\t// 如果路径不符合预期的 .claude/projects/ 模式，则返回空字符串。\n295\tfunc ExtractProjectSlug(transcriptPath string) string {\n296\t\tif transcriptPath == \"\" {\n297\t\t\treturn \"\"\n298\t\t}\n299\t\t// 统一路径分隔符为 /\n300\t\tnormalized := filepath.ToSlash(transcriptPath)\n301\t\n302\t\t// 定位 \".claude/projects/\" 标记段\n303\t\tmarker := \".claude/projects/\"\n304\t\tidx := strings.Index(normalized, marker)\n305\t\tif idx < 0 {\n306\t\t\treturn \"\"\n307\t\t}\n308\t\n309\t\t// 提取标记后的第一段目录名\n310\t\trest := normalized[idx+len(marker):]\n311\t\tif slashIdx := strings.Index(rest, \"/\"); slashIdx >= 0 {\n312\t\t\trest = rest[:slashIdx]\n313\t\t}\n314\t\n315\t\tif rest == \"\" {\n316\t\t\treturn \"\"\n317\t\t}\n318\t\treturn rest\n319\t}\n320\t\n321\t// NewSessionTracePath 基于会话信息构建追踪文件路径。\n322\t//\n323\t// 路径格式：baseDir/{machineID}/{projectSlug}/{sessionID}.jsonl\n324\t//\n325\t// 同一 session_id 对应唯一路径，resume 时追加写入而非创建新文件。\n326\t//\n327\t// 参数说明：\n328\t//   - baseDir:     基础追踪目录\n329\t//   - machineID:   机器标识（如 username@hostname）\n330\t//   - projectSlug: 项目标识（如 D--xxx-yyy）\n331\t//   - sessionID:   会话唯一标识\n332\tfunc NewSessionTracePath(baseDir, machineID, projectSlug, sessionID string) string {\n333\t\tpath := filepath.Join(baseDir, machineID, projectSlug, sessionID+\".jsonl\")\n334\t\tlogger.Debug(\"trace\", \"session trace path: %s\", path)\n335\t\treturn path\n336\t}\n337\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\server.go"},"tool_use_id":"call_6e6037003d8149a6b15d8c61","tool_response":"1\t// Package backend 是后端服务的主包，提供 HTTP API 服务器及其配置。\n2\tpackage backend\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"fmt\"\n7\t\t\"net/http\"\n8\t\t\"os\"\n9\t\t\"os/signal\"\n10\t\t\"syscall\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n17\t)\n18\t\n19\t// Server 是后端 HTTP 服务的主结构体，聚合配置和数据存储。\n20\ttype Server struct {\n21\t\tcfg   Config         // 服务配置\n22\t\tstore *store.SQLiteStore // SQLite 数据存储\n23\t}\n24\t\n25\t// NewServer 创建并初始化后端服务器。\n26\t// 根据配置打开 SQLite 数据库，失败时返回错误。\n27\tfunc NewServer(cfg Config) (*Server, error) {\n28\t\tlogger.Debug(\"backend\", \"creating server: host=%s port=%d db=%s\", cfg.Host, cfg.Port, cfg.DBPath)\n29\t\ts, err := store.NewSQLiteStore(cfg.DBPath)\n30\t\tif err != nil {\n31\t\t\treturn nil, fmt.Errorf(\"open database: %w\", err)\n32\t\t}\n33\t\treturn &Server{cfg: cfg, store: s}, nil\n34\t}\n35\t\n36\t// Start 启动 HTTP 服务器。\n37\t// 启动前会清理超时会话，然后注册路由并开始监听。支持优雅关闭（SIGINT/SIGTERM）。\n38\tfunc (s *Server) Start() error {\n39\t\t// 启动清理：将超时会话标记为已关闭\n40\t\tcleanupSvc := service.NewCleanupService(s.store.Sessions())\n41\t\tcleanupSvc.CleanupTimedOutSessions(context.Background())\n42\t\tlogger.Info(\"backend\", \"startup cleanup done\")\n43\t\n44\t\t// 初始化业务服务和处理器\n45\t\tissueSvc := service.NewIssueService(s.store.Issues())\n46\t\tsessionSvc := service.NewSessionService(s.store.Sessions())\n47\t\n48\t\trouter := api.NewRouter(api.Handlers{\n49\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n50\t\t\tSession: api.NewSessionHandler(sessionSvc),\n51\t\t\tProxy:   api.NewProxyHandler(),\n52\t\t})\n53\t\n54\t\t// 创建 HTTP 服务器\n55\t\tsrv := &http.Server{\n56\t\t\tAddr:    s.cfg.Addr(),\n57\t\t\tHandler: router,\n58\t\t}\n59\t\n60\t\t// 监听系统信号以实现优雅关闭\n61\t\tquit := make(chan os.Signal, 1)\n62\t\tsignal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)\n63\t\n64\t\t// 创建可取消的 context 用于停止 watchdog\n65\t\tctx, cancel := context.WithCancel(context.Background())\n66\t\tdefer cancel()\n67\t\n68\t\t// 启动空闲 watchdog：每 30s 检查 proxy.json，持续空闲 10 分钟则关闭\n69\t\twatchdog := service.NewIdleWatchdog(30*time.Second, 10*time.Minute, func() {\n70\t\t\tlogger.Info(\"backend\", \"watchdog triggered shutdown\")\n71\t\t\tsrv.Shutdown(context.Background())\n72\t\t\tcancel() // 停止 watchdog 自身\n73\t\t})\n74\t\tgo watchdog.Run(ctx)\n75\t\n76\t\tgo func() {\n77\t\t\t<-quit\n78\t\t\tlogger.Info(\"backend\", \"shutdown signal received\")\n79\t\t\tcancel() // 停止 watchdog\n80\t\t\tsrv.Shutdown(context.Background())\n81\t\t}()\n82\t\n83\t\tlogger.Info(\"backend\", \"backend listening on %s\", s.cfg.Addr())\n84\t\tif err := srv.ListenAndServe(); err != http.ErrServerClosed {\n85\t\t\treturn err\n86\t\t}\n87\t\treturn nil\n88\t}\n89\t\n90\t// Close 关闭后端服务器及其数据库连接。\n91\tfunc (s *Server) Close() error {\n92\t\terr := s.store.Close()\n93\t\tlogger.Info(\"backend\", \"backend server closed\")\n94\t\treturn err\n95\t}\n96\t"}]}
