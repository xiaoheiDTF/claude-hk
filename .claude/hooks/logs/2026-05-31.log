CTION\" = \"merge\" ]; then\n40\t    # merge 时先标记 reviewing，最终由 Claude 执行完 merge 后调 merged\n41\t    update_issue_status \"$ISSUE_NUM\" \"reviewing\"\n42\t    update_issue_status \"$ISSUE_NUM\" \"merged\"\n43\t  elif [ \"$REVIEW_ACTION\" = \"reject\" ]; then\n44\t    update_issue_status \"$ISSUE_NUM\" \"reviewing\"\n45\t    update_issue_status \"$ISSUE_NUM\" \"rejected\"\n46\t  else\n47\t    # 默认：仅标记 reviewing\n48\t    update_issue_status \"$ISSUE_NUM\" \"reviewing\"\n49\t  fi\n50\telse\n51\t  if _gh --version &>/dev/null; then\n52\t    echo \"\"\n53\t    echo \"=== 可审核的 PRs ===\"\n54\t    prs=$(_gh pr list --state open --json number,title,headRefName 2>/dev/null)\n55\t    if [ -n \"$prs\" ] && [ \"$prs\" != \"[]\" ]; then\n56\t      echo \"$prs\" | jq -r '.[] | \"  PR #\\(.number): \\(.title) (分支: \\(.headRefName))\"'\n57\t      echo \"\"\n58\t      echo \"用法:\"\n59\t      echo \"  /003-9-issue-review merge #<N>   合并 PR\"\n60\t      echo \"  /003-9-issue-review reject #<N>  打回 PR\"\n61\t    else\n62\t      echo \"(暂无 open PRs)\"\n63\t    fi\n64\t  fi\n65\tfi\n66\t\n67\tskill_log \"INFO\" \"[inject] issue-review context injected for #$ISSUE_NUM action=$REVIEW_ACTION\"\n68\t"}]}
