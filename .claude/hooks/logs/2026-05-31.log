o BackendInfo) error {\n50\t\tdir := filepath.Dir(BackendJSONPath())\n51\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n52\t\t\treturn err\n53\t\t}\n54\t\tdata, err := json.MarshalIndent(info, \"\", \"  \")\n55\t\tif err != nil {\n56\t\t\treturn err\n57\t\t}\n58\t\treturn os.WriteFile(BackendJSONPath(), data, 0o644)\n59\t}\n60\t\n61\t// WriteProxyURL 将代理 URL 合并写入已有的 backend.json（保留后端的 host/port）。\n62\tfunc WriteProxyURL(proxyURL string) error {\n63\t\tinfo := ReadBackendInfo()\n64\t\tif info == nil {\n65\t\t\tinfo = &BackendInfo{}\n66\t\t}\n67\t\tinfo.ProxyURL = proxyURL\n68\t\treturn WriteBackendInfo(*info)\n69\t}\n70\t\n71\t// RemoveBackendInfo 删除 backend.json。\n72\tfunc RemoveBackendInfo() error {\n73\t\terr := os.Remove(BackendJSONPath())\n74\t\tif err != nil && !os.IsNotExist(err) {\n75\t\t\treturn err\n76\t\t}\n77\t\treturn nil\n78\t}\n79\t\n80\t// --- proxy.json ---\n81\t\n82\t// ProxySession 记录一个活跃的代理会话。\n83\ttype ProxySession struct {\n84\t\tStartedAt string `json:\"started_at\"` // 会话启动时间（ISO 8601）\n85\t}\n86\t\n87\t// ProxyJSONPath 返回 proxy.json 的完整路径。\n88\tfunc ProxyJSONPath() string {\n89\t\treturn filepath.Join(BaseDir(), \"proxy.json\")\n90\t}\n91\t\n92\tvar proxyMu sync.Mutex // 保护 proxy.json 并发读写\n93\t\n94\t// ProxySessionKey 生成 proxy.json 中的唯一键：{projectSlug}_{sessionID}。\n95\tfunc ProxySessionKey(projectSlug, sessionID string) string {\n96\t\treturn projectSlug + \"_\" + sessionID\n97\t}\n98\t\n99\t// RegisterProxySession 向 proxy.json 注册一个会话。\n100\t// key 格式为 {projectSlug}_{sessionID}，确保同一项目同一会话唯一。\n101\tfunc RegisterProxySession(key string, startedAt string) error {\n102\t\tproxyMu.Lock()\n103\t\tdefer proxyMu.Unlock()\n104\t\n105\t\tsessions := readProxySessions()\n106\t\tsessions[key] = ProxySession{StartedAt: startedAt}\n107\t\treturn writeProxySessions(sessions)\n108\t}\n109\t\n110\t// UnregisterProxySession 从 proxy.json 注销一个会话。\n111\tfunc UnregisterProxySession(key string) error {\n112\t\tproxyMu.Lock()\n113\t\tdefer proxyMu.Unlock()\n114\t\n115\t\tsessions := readProxySessions()\n116\t\tdelete(sessions, key)\n117\t\treturn writeProxySessions(sessions)\n118\t}\n119\t\n120\t// ReadProxySessions 读取 proxy.json 中的所有会话（不加锁，供 watchdog 使用）。\n121\tfunc ReadProxySessions() map[string]ProxySession {\n122\t\tproxyMu.Lock()\n123\t\tdefer proxyMu.Unlock()\n124\t\treturn readProxySessions()\n125\t}\n126\t\n127\t// readProxySessions 内部读取函数，不加锁。\n128\tfunc readProxySessions() map[string]ProxySession {\n129\t\tresult := make(map[string]ProxySession)\n130\t\tdata, err := os.ReadFile(ProxyJSONPath())\n131\t\tif err != nil {\n132\t\t\treturn result\n133\t\t}\n134\t\tjson.Unmarshal(data, &result)\n135\t\treturn result\n136\t}\n137\t\n138\t// writeProxySessions 内部写入函数，不加锁。\n139\tfunc writeProxySessions(sessions map[string]ProxySession) error {\n140\t\tdir := filepath.Dir(ProxyJSONPath())\n141\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n142\t\t\treturn err\n143\t\t}\n144\t\tdata, err := json.MarshalIndent(sessions, \"\", \"  \")\n145\t\tif err != nil {\n146\t\t\treturn err\n147\t\t}\n148\t\tlogger.Debug(\"session_files\", \"proxy.json updated: %d sessions\", len(sessions))\n149\t\treturn os.WriteFile(ProxyJSONPath(), data, 0o644)\n150\t}\n151\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\service\\idle_watchdog.go"},"tool_use_id":"call_cd622a6681c545ba87325a0e","tool_response":"1\t// Package service 提供后端业务逻辑层。\n2\tpackage service\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"time\"\n10\t\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n12\t)\n13\t\n14\t// proxySession 用于反序列化 proxy.json 中的会话条目。\n15\ttype proxySession struct {\n16\t\tStartedAt string `json:\"started_at\"`\n17\t}\n18\t\n19\t// IdleWatchdog 监控 proxy.json，当所有会话注销且持续空闲超过指定时间后，\n20\t// 调用 shutdown 回调触发后端优雅关闭。\n21\ttype IdleWatchdog struct {\n22\t\tinterval    time.Duration // 检查间隔\n23\t\tidleTimeout time.Duration // 空闲超时（超过此时间无会话则关闭）\n24\t\tshutdown    func()        // 触发服务器关闭的回调\n25\t}\n26\t\n27\t// NewIdleWatchdog 创建空闲监控器。\n28\t//   - interval: 检查间隔（建议 30s）\n29\t//   - idleTimeout: 空闲超时（建议 10min）\n30\t//   - shutdown: 触发关闭的回调函数\n31\tfunc NewIdleWatchdog(interval, idleTimeout time.Duration, shutdown func()) *IdleWatchdog {\n32\t\treturn &IdleWatchdog{\n33\t\t\tinterval:    interval,\n34\t\t\tidleTimeout: idleTimeout,\n35\t\t\tshutdown:    shutdown,\n36\t\t}\n37\t}\n38\t\n39\t// Run 启动监控循环，直到 context 被取消或触发关闭。\n40\tfunc (w *IdleWatchdog) Run(ctx context.Context) {\n41\t\tlogger.Info(\"watchdog\", \"started: interval=%v idle_timeout=%v\", w.interval, w.idleTimeout)\n42\t\n43\t\tidleStart := time.Time{} // 记录首次检测到空闲的时间\n44\t\n45\t\tticker := time.NewTicker(w.interval)\n46\t\tdefer ticker.Stop()\n47\t\n48\t\tfor {\n49\t\t\tselect {\n50\t\t\tcase <-ctx.Done():\n51\t\t\t\tlogger.Info(\"watchdog\", \"stopped\")\n52\t\t\t\treturn\n53\t\t\tcase <-ticker.C:\n54\t\t\t\tsessionCount := countProxySessions()\n55\t\t\t\tif sessionCount > 0 {\n56\t\t\t\t\t// 有活跃会话，重置空闲计时\n57\t\t\t\t\tif !idleStart.IsZero() {\n58\t\t\t\t\t\tlogger.Info(\"watchdog\", \"sessions active (%d), resetting idle timer\", sessionCount)\n59\t\t\t\t\t}\n60\t\t\t\t\tidleStart = time.Time{}\n61\t\t\t\t} else {\n62\t\t\t\t\t// 无活跃会话\n63\t\t\t\t\tif idleStart.IsZero() {\n64\t\t\t\t\t\t// 首次检测到空闲\n65\t\t\t\t\t\tidleStart = time.Now()\n66\t\t\t\t\t\tlogger.Info(\"watchdog\", \"no sessions, idle timer started\")\n67\t\t\t\t\t} else if time.Since(idleStart) >= w.idleTimeout {\n68\t\t\t\t\t\t// 空闲超时，触发关闭\n69\t\t\t\t\t\tlogger.Info(\"watchdog\", \"idle timeout (%v) reached, shutting down\", w.idleTimeout)\n70\t\t\t\t\t\tw.shutdown()\n71\t\t\t\t\t\treturn\n72\t\t\t\t\t} else {\n73\t\t\t\t\t\tlogger.Debug(\"watchdog\", \"idle for %v, shutdown in %v\",\n74\t\t\t\t\t\t\ttime.Since(idleStart).Round(time.Second),\n75\t\t\t\t\t\t\tw.idleTimeout-time.Since(idleStart))\n76\t\t\t\t\t}\n77\t\t\t\t}\n78\t\t\t}\n79\t\t}\n80\t}\n81\t\n82\t// proxyJSONPath 返回 proxy.json 的路径（~/.claude-tap-plus/proxy.json）。\n83\tfunc proxyJSONPath() string {\n84\t\thome, err := os.UserHomeDir()\n85\t\tif err != nil {\n86\t\t\treturn \".claude-tap-plus/proxy.json\"\n87\t\t}\n88\t\treturn filepath.Join(home, \".claude-tap-plus\", \"proxy.json\")\n89\t}\n90\t\n91\t// countProxySessions 读取 proxy.json 并返回活跃会话数量。\n92\tfunc countProxySessions() int {\n93\t\tdata, err := os.ReadFile(proxyJSONPath())\n94\t\tif err != nil {\n95\t\t\treturn 0 // 文件不存在或读不出 → 视为无会话\n96\t\t}\n97\t\tvar sessions map[string]proxySession\n98\t\tif json.Unmarshal(data, &sessions) != nil {\n99\t\t\treturn 0\n100\t\t}\n101\t\treturn len(sessions)\n102\t}\n103\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\server.go"},"tool_use_id":"call_e4e092fe9d6e4c72915dd370","tool_response":"1\t// Package backend 是后端服务的主包，提供 HTTP API 服务器及其配置。\n2\tpackage backend\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"fmt\"\n7\t\t\"net/http\"\n8\t\t\"os\"\n9\t\t\"os/signal\"\n10\t\t\"syscall\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n17\t)\n18\t\n19\t// Server 是后端 HTTP 服务的主结构体，聚合配置和数据存储。\n20\ttype Server struct {\n21\t\tcfg   Config         // 服务配置\n22\t\tstore *store.SQLiteStore // SQLite 数据存储\n23\t}\n24\t\n25\t// NewServer 创建并初始化后端服务器。\n26\t// 根据配置打开 SQLite 数据库，失败时返回错误。\n27\tfunc NewServer(cfg Config) (*Server, error) {\n28\t\tlogger.Debug(\"backend\", \"creating server: host=%s port=%d db=%s\", cfg.Host, cfg.Port, cfg.DBPath)\n29\t\ts, err := store.NewSQLiteStore(cfg.DBPath)\n30\t\tif err != nil {\n31\t\t\treturn nil, fmt.Errorf(\"open database: %w\", err)\n32\t\t}\n33\t\treturn &Server{cfg: cfg, store: s}, nil\n34\t}\n35\t\n36\t// Start 启动 HTTP 服务器。\n37\t// 启动前会清理超时会话，然后注册路由并开始监听。支持优雅关闭（SIGINT/SIGTERM）。\n38\tfunc (s *Server) Start() error {\n39\t\t// 启动清理：将超时会话标记为已关闭\n40\t\tcleanupSvc := service.NewCleanupService(s.store.Sessions())\n41\t\tcleanupSvc.CleanupTimedOutSessions(context.Background())\n42\t\tlogger.Info(\"backend\", \"startup cleanup done\")\n43\t\n44\t\t// 初始化业务服务和处理器\n45\t\tissueSvc := service.NewIssueService(s.store.Issues())\n46\t\tsessionSvc := service.NewSessionService(s.store.Sessions())\n47\t\n48\t\trouter := api.NewRouter(api.Handlers{\n49\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n50\t\t\tSession: api.NewSessionHandler(sessionSvc),\n51\t\t\tProxy:   api.NewProxyHandler(),\n52\t\t})\n53\t\n54\t\t// 创建 HTTP 服务器\n55\t\tsrv := &http.Server{\n56\t\t\tAddr:    s.cfg.Addr(),\n57\t\t\tHandler: router,\n58\t\t}\n59\t\n60\t\t// 监听系统信号以实现优雅关闭\n61\t\tquit := make(chan os.Signal, 1)\n62\t\tsignal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)\n63\t\n64\t\t// 创建可取消的 context 用于停止 watchdog\n65\t\tctx, cancel := context.WithCancel(context.Background())\n66\t\tdefer cancel()\n67\t\n68\t\t// 启动空闲 watchdog：每 30s 检查 proxy.json，持续空闲 10 分钟则关闭\n69\t\twatchdog := service.NewIdleWatchdog(30*time.Second, 10*time.Minute, func() {\n70\t\t\tlogger.Info(\"backend\", \"watchdog triggered shutdown\")\n71\t\t\tsrv.Shutdown(context.Background())\n72\t\t\tcancel() // 停止 watchdog 自身\n73\t\t})\n74\t\tgo watchdog.Run(ctx)\n75\t\n76\t\tgo func() {\n77\t\t\t<-quit\n78\t\t\tlogger.Info(\"backend\", \"shutdown signal received\")\n79\t\t\tcancel() // 停止 watchdog\n80\t\t\tsrv.Shutdown(context.Background())\n81\t\t}()\n82\t\n83\t\tlogger.Info(\"backend\", \"backend listening on %s\", s.cfg.Addr())\n84\t\tif err := srv.ListenAndServe(); err != http.ErrServerClosed {\n85\t\t\treturn err\n86\t\t}\n87\t\treturn nil\n88\t}\n89\t\n90\t// Close 关闭后端服务器及其数据库连接。\n91\tfunc (s *Server) Close() error {\n92\t\terr := s.store.Close()\n93\t\tlogger.Info(\"backend\", \"backend server closed\")\n94\t\treturn err\n95\t}\n96\t"}]}
