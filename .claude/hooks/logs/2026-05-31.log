 \"$ISSUE_NUM\" \"pr-created\"\n37\telse\n38\t  # 无参数时列出 open PRs 和 ready-for-pr 的 issues\n39\t  if _gh --version &>/dev/null; then\n40\t    echo \"\"\n41\t    echo \"=== PR 状态 ===\"\n42\t    # 列出当前分支关联的 PR\n43\t    branch=$(git -C \"$PROJECT_DIR\" branch --show-current 2>/dev/null)\n44\t    prs=$(_gh pr list --state open --json number,title,headRefName 2>/dev/null)\n45\t    if [ -n \"$prs\" ] && [ \"$prs\" != \"[]\" ]; then\n46\t      echo \"Open PRs:\"\n47\t      echo \"$prs\" | jq -r '.[] | \"  PR #\\(.number): \\(.title) (分支: \\(.headRefName))\"'\n48\t      echo \"\"\n49\t    fi\n50\t    # 列出 ready-for-pr 的 issues\n51\t    issues=$(_gh issue list --state open --label \"ready-for-pr\" --assignee @me --json number,title,labels 2>/dev/null)\n52\t    if [ -n \"$issues\" ] && [ \"$issues\" != \"[]\" ]; then\n53\t      count=$(echo \"$issues\" | jq 'length')\n54\t      echo \"待提 PR 的 issues（共 $count 个）:\"\n55\t      echo \"\"\n56\t      echo \"$issues\" | jq -r '.[] | \"#\\(.number) [\\([.labels[].name] | join(\",\"))] \\(.title)\\n  请回复 /003-7-issue-pr #\\(.number) 来提交 PR\\n\"'\n57\t    fi\n58\t  else\n59\t    echo \"gh CLI 不可用，请先安装 GitHub CLI\"\n60\t    echo \"请指定 issue 编号，例如: /003-7-issue-pr #5\"\n61\t  fi\n62\tfi\n63\t\n64\tskill_log \"INFO\" \"[inject] issue-pr context injected for #$ISSUE_NUM\"\n65\t"}]}
