e || strings.HasSuffix(name, suffix) {\n\t\t\treturn name, true\n\t\t}\n\t}\n\treturn \"\", false\n}\n\n// CwdToClaudeKey 将绝对路径转换为 .claude.json 中使用的键格式。\n// Claude Code 使用正斜杠格式：\"D:/development/code/claude-tap\"。\nfunc CwdToClaudeKey(absPath string) string {\n\treturn strings.ReplaceAll(absPath, `\\`, \"/\")\n}\n","numLines":58,"startLine":1,"totalLines":58}},"tool_use_id":"call_a386d2e9b0f244e18094a43b","duration_ms":3}
