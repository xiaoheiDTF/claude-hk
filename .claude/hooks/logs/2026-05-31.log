t\t// sessions 表：记录每次 Claude Code 会话的元数据\n37\t\t\t`CREATE TABLE IF NOT EXISTS sessions (\n38\t\t\t\tid               INTEGER PRIMARY KEY AUTOINCREMENT,\n39\t\t\t\tsession_id       TEXT NOT NULL UNIQUE,\n40\t\t\t\tmachine_id       TEXT NOT NULL,\n41\t\t\t\tos               TEXT NOT NULL,\n42\t\t\t\tproject_slug     TEXT NOT NULL,\n43\t\t\t\tproject_cwd      TEXT NOT NULL,\n44\t\t\t\ttranscript_path  TEXT NOT NULL,\n45\t\t\t\tlocal_trace_path TEXT,\n46\t\t\t\tmodel            TEXT,\n47\t\t\t\tsource           TEXT,\n48\t\t\t\tstatus           TEXT NOT NULL DEFAULT 'active',\n49\t\t\t\tregistered_at    DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n50\t\t\t\tclosed_at        DATETIME,\n51\t\t\t\tclose_reason     TEXT\n52\t\t\t)`,\n53\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_machine ON sessions(machine_id)`,\n54\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_project ON sessions(project_slug)`,\n55\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_status ON sessions(status)`,\n56\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_registered ON sessions(registered_at)`,\n57\t\n58\t\t\t// issue_claims 表：存储 Issue 领取关系和状态流转\n59\t\t\t`CREATE TABLE IF NOT EXISTS issue_claims (\n60\t\t\t\tid              INTEGER PRIMARY KEY AUTOINCREMENT,\n61\t\t\t\trepo_full_name  TEXT NOT NULL,\n62\t\t\t\tissue_number    INTEGER NOT NULL,\n63\t\t\t\tissue_title     TEXT,\n64\t\t\t\tstatus          TEXT NOT NULL DEFAULT 'idle',\n65\t\t\t\tsession_id      TEXT,\n66\t\t\t\tclaimed_at      DATETIME,\n67\t\t\t\tupdated_at      DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n68\t\t\t\tUNIQUE(repo_full_name, issue_number)\n69\t\t\t)`,\n70\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_repo ON issue_claims(repo_full_name)`,\n71\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_session ON issue_claims(session_id)`,\n72\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_status ON issue_claims(status)`,\n73\t\t}\n74\t\n75\t\tlogger.Debug(\"store\", \"running %d migration statements\", len(stmts))\n76\t\tfor _, stmt := range stmts {\n77\t\t\tif _, err := db.Exec(stmt); err != nil {\n78\t\t\t\tlogger.Error(\"store\", \"migration failed: %s: %v\", stmt[:60], err)\n79\t\t\t\treturn err\n80\t\t\t}\n81\t\t\tlogger.Debug(\"store\", \"migration OK: %.60s\", stmt)\n82\t\t}\n83\t\treturn nil\n84\t}\n85\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\store.go"},"tool_use_id":"call_ed8684d3ef334373b3e7ae0f","tool_response":"1\t// Package store 提供数据持久化层，基于 SQLite 实现。\n2\tpackage store\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"errors\"\n7\t\t\"time\"\n8\t)\n9\t\n10\tvar (\n11\t\t// ErrSessionExists 表示会话已存在（重复注册）。\n12\t\tErrSessionExists = errors.New(\"session already exists\")\n13\t\t// ErrSessionNotFound 表示会话不存在或已被关闭。\n14\t\tErrSessionNotFound = errors.New(\"session not found or already closed\")\n15\t)\n16\t\n17\t// --- Issue types ---\n18\t\n19\t// ClaimResult 表示 Issue 领取操作的结果。\n20\ttype ClaimResult struct {\n21\t\tSuccess   bool    // 是否成功领取\n22\t\tStatus    string  // 当前状态\n23\t\tClaimedBy *string // 被谁领取（冲突时）\n24\t\tClaimedAt *string // 领取时间\n25\t}\n26\t\n27\t// UpdateStatusResult 表示 Issue 状态更新操作的结果。\n28\ttype UpdateStatusResult struct {\n29\t\tPreviousStatus string // 更新前的状态\n30\t\tNewStatus      string // 更新后的状态\n31\t\tUpdated        bool   // 是否成功更新\n32\t}\n33\t\n34\t// IssueStore 定义 Issue 数据存储的接口。\n35\ttype IssueStore interface {\n36\t\tCheckIssues(ctx context.Context, repo string, numbers []int) ([]IssueCheckResult, error)\n37\t\tClaimIssue(ctx context.Context, repo string, number int, sessionID string, issueTitle string) (*ClaimResult, error)\n38\t\tUpdateIssueStatus(ctx context.Context, repo string, number int, sessionID string, newStatus string) (*UpdateStatusResult, error)\n39\t\tReleaseIssue(ctx context.Context, repo string, number int, sessionID string) (bool, error)\n40\t\tReleaseSessionIssues(ctx context.Context, sessionID string) ([]int, error)\n41\t}\n42\t\n43\t// IssueCheckResult 表示单个 Issue 的状态查询结果。\n44\ttype IssueCheckResult struct {\n45\t\tNumber    int     // Issue 编号\n46\t\tStatus    string  // 当前状态\n47\t\tSessionID *string // 领取者 session ID\n48\t\tClaimedAt *string // 领取时间\n49\t}\n50\t\n51\t// --- Session types ---\n52\t\n53\t// Session 表示会话实体（对应数据库 sessions 表）。\n54\ttype Session struct {\n55\t\tSessionID      string     // 会话唯一 ID\n56\t\tMachineID      string     // 机器标识\n57\t\tOS             string     // 操作系统\n58\t\tProjectSlug    string     // 项目标识\n59\t\tProjectCwd     string     // 项目工作目录\n60\t\tTranscriptPath string     // 对话记录路径\n61\t\tLocalTracePath string     // 本地跟踪路径\n62\t\tModel          string     // 使用的模型\n63\t\tSource         string     // 来源\n64\t\tStatus         string     // 状态\n65\t\tRegisteredAt   time.Time  // 注册时间\n66\t\tClosedAt       *time.Time // 关闭时间\n67\t\tCloseReason    string     // 关闭原因\n68\t}\n69\t\n70\t// SessionFilter 是会话列表的过滤条件（指针类型支持省略条件）。\n71\ttype SessionFilter struct {\n72\t\tMachineID   *string // 按机器 ID 过滤\n73\t\tProjectSlug *string // 按项目标识过滤\n74\t\tStatus      *string // 按状态过滤\n75\t}\n76\t\n77\t// SessionStore 定义 Session 数据存储的接口。\n78\ttype SessionStore interface {\n79\t\tRegisterSession(ctx context.Context, s Session) error\n80\t\tCloseSession(ctx context.Context, sessionID string, reason string) error\n81\t\tListSessions(ctx context.Context, filter SessionFilter) ([]Session, error)\n82\t\tGetSession(ctx context.Context, sessionID string) (*Session, error)\n83\t\tCleanupTimedOut(ctx context.Context) (int, error)\n84\t}\n85\t\n86\t// --- Store aggregate ---\n87\t\n88\t// Store 是统一的数据存储聚合接口。\n89\ttype Store interface {\n90\t\tIssues() IssueStore   // 返回 Issue 存储\n91\t\tSessions() SessionStore // 返回 Session 存储\n92\t\tClose() error         // 关闭存储连接\n93\t}\n94\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\domain\\issue.go"},"tool_use_id":"call_e58c1993a1aa45f8abb0c95e","tool_response":"1\t// Package domain 定义核心业务实体和枚举类型。\n2\tpackage domain\n3\t\n4\timport \"time\"\n5\t\n6\t// IssueStatus 表示 Issue 的流转状态。\n7\ttype IssueStatus string\n8\t\n9\tconst (\n10\t\tIssueIdle       IssueStatus = \"idle\"        // 空闲，无人领取\n11\t\tIssueClaimed    IssueStatus = \"claimed\"     // 已被某 session 领取\n12\t\tIssueFixing     IssueStatus = \"fixing\"      // 正在开发中\n13\t\tIssueReadyForPR IssueStatus = \"ready-for-pr\" // 开发完成，等待提 PR\n14\t\tIssuePRCreated  IssueStatus = \"pr-created\"  // PR 已创建\n15\t\tIssueTesting    IssueStatus = \"testing\"     // 测试中\n16\t\tIssueReviewing  IssueStatus = \"reviewing\"   // 审核中\n17\t\tIssueMerged     IssueStatus = \"merged\"      // 已合并（终态）\n18\t\tIssueRejected   IssueStatus = \"rejected\"    // 被打回\n19\t)\n20\t\n21\t// IssueClaim 对应 issue_claims 表，存储 Issue 领取关系和状态流转。\n22\t// 只存\"哪个 session 领取了哪个 issue\"及其状态，不存 issue 完整内容（内容在 GitHub 上）。\n23\t// UNIQUE(repo_full_name, issue_number)\n24\ttype IssueClaim struct {\n25\t\tID           int64       `json:\"id\"`\n26\t\tRepoFullName string      `json:\"repo_full_name\"` // 如 xiaoheiDTF/claude-hk，来自 gh repo view\n27\t\tIssueNumber  int         `json:\"issue_number\"`   // GitHub issue 编号\n28\t\tIssueTitle   string      `json:\"issue_title\"`    // issue 标题（缓存，方便展示）\n29\t\tStatus       IssueStatus `json:\"status\"`         // 见 IssueStatus 枚举，默认 idle\n30\t\tSessionID    string      `json:\"session_id\"`     // 领取者的 session_id，idle 时为空\n31\t\tClaimedAt    *time.Time  `json:\"claimed_at\"`     // 领取时间，idle 时为 null\n32\t\tUpdatedAt    time.Time   `json:\"updated_at\"`     // 最后更新时间\n33\t}\n34\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\domain\\session.go"},"tool_use_id":"call_6798483f61dc4fd89c87522b","tool_response":"1\t// Package domain 定义核心业务实体和枚举类型。\n2\tpackage domain\n3\t\n4\timport \"time\"\n5\t\n6\t// SessionStatus 表示会话的状态。\n7\ttype SessionStatus string\n8\t\n9\tconst (\n10\t\tSessionActive SessionStatus = \"active\" // 活跃会话\n11\t\tSessionClosed SessionStatus = \"closed\" // 已关闭\n12\t)\n13\t\n14\t// Session 对应 sessions 表，记录每次 Claude Code 会话的元数据。\n15\t// 后端只存元数据，消息内容存储在本地 JSONL 文件中。\n16\ttype Session struct {\n17\t\tID             int64         `json:\"id\"`\n18\t\tSessionID      string        `json:\"session_id\"`      // UUID，SessionStart hook 传入，UNIQUE\n19\t\tMachineID      string        `json:\"machine_id\"`       // whoami@hostname\n20\t\tOS             string        `json:\"os\"`               // windows/linux/macos\n21\t\tProjectSlug    string        `json:\"project_slug\"`     // 从 transcript_path 解析\n22\t\tProjectCwd     string        `json:\"project_cwd\"`      // SessionStart hook 的 cwd 字段\n23\t\tTranscriptPath string        `json:\"transcript_path\"`  // Claude Code hook 提供的 transcript_path，便于溯源\n24\t\tLocalTracePath string        `json:\"local_trace_path\"` // proxy 本地 trace 文件路径，由代理首次拦截该 session 的 API 调用时构造写入\n25\t\tModel          string        `json:\"model\"`            // SessionStart hook 的 model 字段\n26\t\tSource         string        `json:\"source\"`           // startup/resume\n27\t\tStatus         SessionStatus `json:\"status\"`           // active / closed，默认 active\n28\t\tRegisteredAt   time.Time     `json:\"registered_at\"`    // SessionStart 注册时间\n29\t\tClosedAt       *time.Time    `json:\"closed_at\"`        // SessionEnd 注销时间\n30\t\tCloseReason    string        `json:\"close_reason\"`     // SessionEnd 的 reason 字段（如 prompt_input_exit）\n31\t}\n32\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\router.go"},"tool_use_id":"call_95348aafbc094526b9351a4b","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"net/http\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n8\t)\n9\t\n10\t// Handlers 聚合所有 HTTP 处理器的结构体。\n11\ttype Handlers struct {\n12\t\tIssue   *IssueHandler   // Issue 相关接口处理器\n13\t\tSession *SessionHandler // Session 相关接口处理器\n14\t\tProxy   *ProxyHandler   // 代理注册和 trace-init 转发处理器\n15\t}\n16\t\n17\t// NewRouter 创建并返回 HTTP 路由器，注册所有 API 端点。\n18\tfunc NewRouter(h Handlers) http.Handler {\n19\t\tmux := http.NewServeMux()\n20\t\t// 健康检查端点\n21\t\tmux.HandleFunc(\"/health\", Health)\n22\t\n23\t\t// Issue 相关路由。\n24\t\tmux.HandleFunc(\"/api/issue/check\", h.Issue.CheckIssues)         // 检查 Issue 状态\n25\t\tmux.HandleFunc(\"/api/issue/claim\", h.Issue.ClaimIssue)          // 领取 Issue\n26\t\tmux.HandleFunc(\"/api/issue/release\", h.Issue.ReleaseIssue)      // 释放 Issue\n27\t\tmux.HandleFunc(\"/api/issue/release-session\", h.Issue.ReleaseSession) // 释放会话下所有 Issue\n28\t\tmux.HandleFunc(\"/api/issue/status\", h.Issue.UpdateStatus)       // 更新 Issue 状态\n29\t\n30\t\t// Session 相关路由。\n31\t\tmux.HandleFunc(\"/api/session/register\", h.Session.Register) // 注册会话\n32\t\tmux.HandleFunc(\"/api/session/close\", h.Session.Close)       // 关闭会话\n33\t\tmux.HandleFunc(\"/api/sessions\", h.Session.List)             // 获取会话列表\n34\t\tmux.HandleFunc(\"/api/session/\", h.Session.Get)              // 获取单个会话详情\n35\t\n36\t\t// Proxy 相关路由（代理注册 + trace-init 转发）。\n37\t\tif h.Proxy != nil {\n38\t\t\tmux.HandleFunc(\"/api/proxy/register\", h.Proxy.Register)     // 代理注册\n39\t\t\tmux.HandleFunc(\"/api/proxy/unregister\", h.Proxy.Unregister) // 代理注销\n40\t\t\tmux.HandleFunc(\"/api/proxy/trace-init\", h.Proxy.TraceInit)  // 转发 trace-init\n41\t\t}\n42\t\n43\t\tlogger.Debug(\"api\", \"routes registered: %d endpoints\", 9)\n44\t\treturn mux\n45\t}\n46\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\usage\\normalize.go"},"tool_use_id":"call_2505f33dda9e42d3976e3d80","tool_response":"1\tpackage usage\n2\t\n3\timport (\n4\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n5\t)\n6\t\n7\t// NormalizeUsage 将不同 Provider 特定的 Token 字段名统一映射到 Anthropic 规范的标准名称。\n8\t//\n9\t// 支持的 Provider 及其字段映射关系：\n10\t//   - Anthropic: input_tokens / output_tokens / cache_read_input_tokens / cache_creation_input_tokens\n11\t//   - OpenAI:    prompt_tokens / completion_tokens / cached_tokens\n12\t//   - Google Gemini: promptTokenCount / candidatesTokenCount / cachedContentTokenCount\n13\t//\n14\t// 此外，该函数还会检查嵌套结构（如 input_tokens_details.cached_tokens、\n15\t// prompt_tokens_details.cached_tokens），将其累加到 cache_read_input_tokens 中。\n16\t//\n17\t// 参数 usage 是原始 API 响应中的 usage 对象（map[string]any）。\n18\t// 返回按 Anthropic 规范标准化后的 Token 统计 map。\n19\tfunc NormalizeUsage(usage map[string]any) map[string]int64 {\n20\t\tif usage == nil {\n21\t\t\treturn nil\n22\t\t}\n23\t\n24\t\tlogger.Debug(\"usage\", \"normalize usage: keys=%v\", mapKeys(usage))\n25\t\n26\t\tresult := make(map[string]int64)\n27\t\n28\t\t// 映射输入 Token 数量：优先查找 Anthropic 字段名，其次 OpenAI、Gemini\n29\t\tresult[\"input_tokens\"] = firstInt64(usage,\n30\t\t\t\"input_tokens\",\n31\t\t\t\"prompt_tokens\",\n32\t\t\t\"promptTokenCount\",\n33\t\t)\n34\t\n35\t\t// 映射输出 Token 数量：优先查找 Anthropic 字段名，其次 OpenAI、Gemini\n36\t\tresult[\"output_tokens\"] = firstInt64(usage,\n37\t\t\t\"output_tokens\",\n38\t\t\t\"completion_tokens\",\n39\t\t\t\"candidatesTokenCount\",\n40\t\t)\n41\t\n42\t\t// 映射缓存读取的输入 Token 数量\n43\t\tresult[\"cache_read_input_tokens\"] = firstInt64(usage,\n44\t\t\t\"cache_read_input_tokens\",\n45\t\t\t\"cached_tokens\",\n46\t\t\t\"cachedContentTokenCount\",\n47\t\t)\n48\t\n49\t\t// 映射缓存创建的输入 Token 数量（目前仅 Anthropic 使用）\n50\t\tresult[\"cache_creation_input_tokens\"] = firstInt64(usage,\n51\t\t\t\"cache_creation_input_tokens\",\n52\t\t)\n53\t\n54\t\t// 处理嵌套结构：OpenAI 风格的 usage.input_tokens_details.cached_tokens\n55\t\tif details, ok := usage[\"input_tokens_details\"].(map[string]any); ok {\n56\t\t\tif v := intFromMap(details, \"cached_tokens\"); v > 0 {\n57\t\t\t\tresult[\"cache_read_input_tokens\"] += v\n58\t\t\t}\n59\t\t}\n60\t\t// 处理嵌套结构：OpenAI 风格的 usage.prompt_tokens_details.cached_tokens\n61\t\tif details, ok := usage[\"prompt_tokens_details\"].(map[string]any); ok {\n62\t\t\tif v := intFromMap(details, \"cached_tokens\"); v > 0 {\n63\t\t\t\tresult[\"cache_read_input_tokens\"] += v\n64\t\t\t}\n65\t\t}\n66\t\n67\t\tlogger.Debug(\"usage\", \"normalized: in=%d out=%d cache_read=%d cache_create=%d\",\n68\t\t\tresult[\"input_tokens\"], result[\"output_tokens\"],\n69\t\t\tresult[\"cache_read_input_tokens\"], result[\"cache_creation_input_tokens\"])\n70\t\n71\t\treturn result\n72\t}\n73\t\n74\t// firstInt64 在 map 中按给定 keys 的优先顺序查找第一个非零的 int64 值。\n75\t// 如果所有 key 都不存在或值为零，则返回 0。\n76\tfunc firstInt64(m map[string]any, keys ...string) int64 {\n77\t\tfor _, k := range keys {\n78\t\t\tif v := intFromMap(m, k); v != 0 {\n79\t\t\t\treturn v\n80\t\t\t}\n81\t\t}\n82\t\treturn 0\n83\t}\n84\t\n85\t// intFromMap 从 map 中按 key 提取 int64 值，兼容多种数值类型。\n86\t//\n87\t// 支持的类型：\n88\t//   - float64（JSON 反序列化后的数字默认类型）\n89\t//   - int\n90\t//   - int64\n91\t//   - json.Number（encoding/json 的数字类型，通过接口匹配避免引入包依赖）\n92\tfunc intFromMap(m map[string]any, key string) int64 {\n93\t\tv, ok := m[key]\n94\t\tif !ok {\n95\t\t\treturn 0\n96\t\t}\n97\t\tswitch n := v.(type) {\n98\t\tcase float64:\n99\t\t\treturn int64(n)\n100\t\tcase int:\n101\t\t\treturn int64(n)\n102\t\tcase int64:\n103\t\t\treturn n\n104\t\tcase json_number:\n105\t\t\tif i, err := n.Int64(); err == nil {\n106\t\t\t\treturn i\n107\t\t\t}\n108\t\t}\n109\t\treturn 0\n110\t}\n111\t\n112\t// json_number 是一个本地接口，用于匹配 encoding/json.Number 类型，\n113\t// 从而在不直接导入 encoding/json 包的情况下，安全地处理 JSON 数字值。\n114\ttype json_number interface{ Int64() (int64, error) }\n115\t\n116\t// mapKeys 返回 map 的 key 列表，用于调试日志。\n117\tfunc mapKeys(m map[string]any) []string {\n118\t\tkeys := make([]string, 0, len(m))\n119\t\tfor k := range m {\n120\t\t\tkeys = append(keys, k)\n121\t\t}\n122\t\treturn keys\n123\t}\n124\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\go.mod"},"tool_use_id":"call_a7b743a408fd40e09524bf73","tool_response":"1\tmodule github.com/liaohch3/claude-tap/claude_tap_plus\n2\t\n3\tgo 1.26.3\n4\t\n5\trequire (\n6\t\tgithub.com/dustin/go-humanize v1.0.1 // indirect\n7\t\tgithub.com/google/uuid v1.6.0 // indirect\n8\t\tgithub.com/mattn/go-isatty v0.0.20 // indirect\n9\t\tgithub.com/ncruces/go-strftime v1.0.0 // indirect\n10\t\tgithub.com/remyoudompheng/bigfft v0.0.0-20230129092748-24d4a6f8daec // indirect\n11\t\tgolang.org/x/sys v0.42.0 // indirect\n12\t\tmodernc.org/libc v1.72.3 // indirect\n13\t\tmodernc.org/mathutil v1.7.1 // indirect\n14\t\tmodernc.org/memory v1.11.0 // indirect\n15\t\tmodernc.org/sqlite v1.51.0 // indirect\n16\t)\n17\t"}]}
