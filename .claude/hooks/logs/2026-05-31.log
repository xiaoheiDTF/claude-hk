4db8f54d1c7","tool_response":"1\t#!/bin/bash\n2\t# 15-task-completed: 任务被标记为已完成时触发 (每次完成)\n3\t# 退出 2 可防止任务被标记为已完成\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\ttask_id=$(json_get '.task_id')\n9\tsubject=$(json_get '.subject')\n10\t\n11\tlog \"INFO\" \"id=$task_id subject=$subject\"\n12\t\n13\t# 示例: 阻止过早标记完成\n14\t# hook_output 2 '{\"continue\":false,\"stopReason\":\"任务验证未通过\"}'\n15\t\n16\tdispatch_to_skill \"15\" || true\n17\thook_output 0 '{}'\n18\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\17-stop-failure\\base.sh"},"tool_use_id":"call_b2ac01981bda4a7187da1ca9","tool_response":"1\t#!/bin/bash\n2\t# 17-stop-failure: 回合因 API 错误结束时触发 (每次失败)\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\terror=$(json_get '.error')\n8\t\n9\tlog \"ERROR\" \"API error=$error\"\n10\t\n11\tdispatch_to_skill \"17\" || true\n12\thook_output 0 '{}'\n13\t"}]}
