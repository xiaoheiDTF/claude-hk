ssionID string) (bool, error)\n40\t\tReleaseSessionIssues(ctx context.Context, sessionID string) ([]int, error)\n41\t}\n42\t\n43\t// IssueCheckResult 表示单个 Issue 的状态查询结果。\n44\ttype IssueCheckResult struct {\n45\t\tNumber    int     // Issue 编号\n46\t\tStatus    string  // 当前状态\n47\t\tSessionID *string // 领取者 session ID\n48\t\tClaimedAt *string // 领取时间\n49\t}\n50\t\n51\t// --- Session types ---\n52\t\n53\t// Session 表示会话实体（对应数据库 sessions 表）。\n54\ttype Session struct {\n55\t\tSessionID      string     // 会话唯一 ID\n56\t\tMachineID      string     // 机器标识\n57\t\tOS             string     // 操作系统\n58\t\tProjectSlug    string     // 项目标识\n59\t\tProjectCwd     string     // 项目工作目录\n60\t\tTranscriptPath string     // 对话记录路径\n61\t\tLocalTracePath string     // 本地跟踪路径\n62\t\tModel          string     // 使用的模型\n63\t\tSource         string     // 来源\n64\t\tStatus         string     // 状态\n65\t\tRegisteredAt   time.Time  // 注册时间\n66\t\tClosedAt       *time.Time // 关闭时间\n67\t\tCloseReason    string     // 关闭原因\n68\t}\n69\t\n70\t// SessionFilter 是会话列表的过滤条件（指针类型支持省略条件）。\n71\ttype SessionFilter struct {\n72\t\tMachineID   *string // 按机器 ID 过滤\n73\t\tProjectSlug *string // 按项目标识过滤\n74\t\tStatus      *string // 按状态过滤\n75\t}\n76\t\n77\t// SessionStore 定义 Session 数据存储的接口。\n78\ttype SessionStore interface {\n79\t\tRegisterSession(ctx context.Context, s Session) error\n80\t\tCloseSession(ctx context.Context, sessionID string, reason string) error\n81\t\tListSessions(ctx context.Context, filter SessionFilter) ([]Session, error)\n82\t\tGetSession(ctx context.Context, sessionID string) (*Session, error)\n83\t\tCleanupTimedOut(ctx context.Context) (int, error)\n84\t}\n85\t\n86\t// --- Store aggregate ---\n87\t\n88\t// Store 是统一的数据存储聚合接口。\n89\ttype Store interface {\n90\t\tIssues() IssueStore   // 返回 Issue 存储\n91\t\tSessions() SessionStore // 返回 Session 存储\n92\t\tClose() error         // 关闭存储连接\n93\t}\n94\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\sqlite.go"},"tool_use_id":"call_b7babcc2924d4bf0990c4784","tool_response":"1\t// Package store 提供数据持久化层，基于 SQLite 实现。\n2\tpackage store\n3\t\n4\timport (\n5\t\t\"database/sql\"\n6\t\t\"fmt\"\n7\t\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n9\t\n10\t\t_ \"modernc.org/sqlite\" // 注册 SQLite 驱动\n11\t)\n12\t\n13\t// SQLiteStore 是统一的 SQLite 存储入口，聚合了 Issue 和 Session 两个子存储。\n14\ttype SQLiteStore struct {\n15\t\tdb           *sql.DB          // SQLite 数据库连接\n16\t\tissueStore   *sqliteIssueStore // Issue 存储实现\n17\t\tsessionStore *sqliteSessionStore // Session 存储实现\n18\t}\n19\t\n20\t// NewSQLiteStore 创建并初始化 SQLite 存储。\n21\t// 打开数据库、设置 WAL 模式、执行迁移，然后初始化各子存储。\n22\tfunc NewSQLiteStore(dbPath string) (*SQLiteStore, error) {\n23\t\tlogger.Debug(\"store\", \"opening sqlite: %s\", dbPath)\n24\t\t// 打开数据库，设置 busy timeout 为 5 秒\n25\t\tdb, err := sql.Open(\"sqlite\", dbPath+\"?_pragma=busy_timeout(5000)\")\n26\t\tif err != nil {\n27\t\t\treturn nil, fmt.Errorf(\"open sqlite: %w\", err)\n28\t\t}\n29\t\n30\t\t// 启用 WAL 模式以提高并发性能\n31\t\tif _, err := db.Exec(\"PRAGMA journal_mode=WAL\"); err != nil {\n32\t\t\tdb.Close()\n33\t\t\treturn nil, fmt.Errorf(\"set WAL mode: %w\", err)\n34\t\t}\n35\t\tlogger.Debug(\"store\", \"WAL mode set\")\n36\t\n37\t\t// 执行数据库迁移\n38\t\tif err := runMigrations(db); err != nil {\n39\t\t\tdb.Close()\n40\t\t\treturn nil, fmt.Errorf(\"run migrations: %w\", err)\n41\t\t}\n42\t\tlogger.Debug(\"store\", \"migrations complete\")\n43\t\n44\t\tlogger.Info(\"store\", \"sqlite store ready: %s\", dbPath)\n45\t\treturn &SQLiteStore{\n46\t\t\tdb:           db,\n47\t\t\tissueStore:   &sqliteIssueStore{db: db},\n48\t\t\tsessionStore: &sqliteSessionStore{db: db},\n49\t\t}, nil\n50\t}\n51\t\n52\t// Issues 返回 Issue 存储接口。\n53\tfunc (s *SQLiteStore) Issues() IssueStore { return s.issueStore }\n54\t\n55\t// Sessions 返回 Session 存储接口。\n56\tfunc (s *SQLiteStore) Sessions() SessionStore { return s.sessionStore }\n57\t\n58\t// DB 返回底层的 *sql.DB 连接（主要用于测试）。\n59\tfunc (s *SQLiteStore) DB() *sql.DB { return s.db }\n60\t\n61\t// Close 关闭数据库连接。\n62\tfunc (s *SQLiteStore) Close() error {\n63\t\terr := s.db.Close()\n64\t\tlogger.Info(\"store\", \"sqlite store closed\")\n65\t\treturn err\n66\t}\n67\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\migrations.go"},"tool_use_id":"call_3a8f92d5350441c996058192","tool_response":"1\t// Package store 提供数据持久化层，基于 SQLite 实现。\n2\tpackage store\n3\t\n4\timport (\n5\t\t\"database/sql\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n8\t)\n9\t\n10\t// runMigrations 执行数据库迁移，创建必要的表和索引。\n11\t// 如果表或索引已存在则跳过（使用 IF NOT EXISTS）。\n12\tfunc runMigrations(db *sql.DB) error {\n13\t\tstmts := []string{\n14\t\t\t// machines 表：记录使用 claude-tap-plus 的机器信息\n15\t\t\t`CREATE TABLE IF NOT EXISTS machines (\n16\t\t\t\tid              INTEGER PRIMARY KEY AUTOINCREMENT,\n17\t\t\t\tmachine_id      TEXT NOT NULL UNIQUE,\n18\t\t\t\tos              TEXT NOT NULL,\n19\t\t\t\thostname        TEXT NOT NULL,\n20\t\t\t\tusername        TEXT NOT NULL,\n21\t\t\t\tfirst_seen_at   DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n22\t\t\t\tlast_seen_at    DATETIME\n23\t\t\t)`,\n24\t\t\t`CREATE INDEX IF NOT EXISTS idx_machines_hostname ON machines(hostname)`,\n25\t\n26\t\t\t// projects 表：记录 Claude Code 工作过的项目\n27\t\t\t`CREATE TABLE IF NOT EXISTS projects (\n28\t\t\t\tid              INTEGER PRIMARY KEY AUTOINCREMENT,\n29\t\t\t\tproject_slug    TEXT NOT NULL UNIQUE,\n30\t\t\t\tproject_cwd     TEXT NOT NULL,\n31\t\t\t\tfirst_seen_at   DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n32\t\t\t\tlast_seen_at    DATETIME\n33\t\t\t)`,\n34\t\t\t`CREATE INDEX IF NOT EXISTS idx_projects_slug ON projects(project_slug)`,\n35\t\n36\t\t\t// sessions 表：记录每次 Claude Code 会话的元数据\n37\t\t\t`CREATE TABLE IF NOT EXISTS sessions (\n38\t\t\t\tid               INTEGER PRIMARY KEY AUTOINCREMENT,\n39\t\t\t\tsession_id       TEXT NOT NULL UNIQUE,\n40\t\t\t\tmachine_id       TEXT NOT NULL,\n41\t\t\t\tos               TEXT NOT NULL,\n42\t\t\t\tproject_slug     TEXT NOT NULL,\n43\t\t\t\tproject_cwd      TEXT NOT NULL,\n44\t\t\t\ttranscript_path  TEXT NOT NULL,\n45\t\t\t\tlocal_trace_path TEXT,\n46\t\t\t\tmodel            TEXT,\n47\t\t\t\tsource           TEXT,\n48\t\t\t\tstatus           TEXT NOT NULL DEFAULT 'active',\n49\t\t\t\tregistered_at    DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n50\t\t\t\tclosed_at        DATETIME,\n51\t\t\t\tclose_reason     TEXT\n52\t\t\t)`,\n53\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_machine ON sessions(machine_id)`,\n54\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_project ON sessions(project_slug)`,\n55\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_status ON sessions(status)`,\n56\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_registered ON sessions(registered_at)`,\n57\t\n58\t\t\t// issue_claims 表：存储 Issue 领取关系和状态流转\n59\t\t\t`CREATE TABLE IF NOT EXISTS issue_claims (\n60\t\t\t\tid              INTEGER PRIMARY KEY AUTOINCREMENT,\n61\t\t\t\trepo_full_name  TEXT NOT NULL,\n62\t\t\t\tissue_number    INTEGER NOT NULL,\n63\t\t\t\tissue_title     TEXT,\n64\t\t\t\tstatus          TEXT NOT NULL DEFAULT 'idle',\n65\t\t\t\tsession_id      TEXT,\n66\t\t\t\tclaimed_at      DATETIME,\n67\t\t\t\tupdated_at      DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n68\t\t\t\tUNIQUE(repo_full_name, issue_number)\n69\t\t\t)`,\n70\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_repo ON issue_claims(repo_full_name)`,\n71\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_session ON issue_claims(session_id)`,\n72\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_status ON issue_claims(status)`,\n73\t\t}\n74\t\n75\t\tlogger.Debug(\"store\", \"running %d migration statements\", len(stmts))\n76\t\tfor _, stmt := range stmts {\n77\t\t\tif _, err := db.Exec(stmt); err != nil {\n78\t\t\t\tlogger.Error(\"store\", \"migration failed: %s: %v\", stmt[:60], err)\n79\t\t\t\treturn err\n80\t\t\t}\n81\t\t\tlogger.Debug(\"store\", \"migration OK: %.60s\", stmt)\n82\t\t}\n83\t\treturn nil\n84\t}\n85\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\issue_store.go"},"tool_use_id":"call_2a69b743795f456a8605cd6e","tool_response":"1\t// Package store 提供数据持久化层，基于 SQLite 实现。\n2\tpackage store\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"database/sql\"\n7\t\t\"fmt\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n11\t)\n12\t\n13\t// sqliteIssueStore 是 Issue 存储的 SQLite 实现。\n14\ttype sqliteIssueStore struct {\n15\t\tdb *sql.DB // SQLite 数据库连接\n16\t}\n17\t\n18\t// CheckIssues 检查指定仓库中多个 Issue 的状态。\n19\t// 如果 Issue 记录不存在，会自动创建 idle 状态的初始记录。\n20\tfunc (s *sqliteIssueStore) CheckIssues(ctx context.Context, repo string, numbers []int) ([]IssueCheckResult, error) {\n21\t\tif len(numbers) == 0 {\n22\t\t\treturn nil, nil\n23\t\t}\n24\t\n25\t\tlogger.Debug(\"store.issue\", \"check issues: repo=%s numbers=%v\", repo, numbers)\n26\t\n27\t\t// 为不存在的 Issue 自动创建 idle 初始记录\n28\t\tinsertStmt, err := s.db.PrepareContext(ctx,\n29\t\t\t`INSERT OR IGNORE INTO issue_claims (repo_full_name, issue_number, status, updated_at)\n30\t\t\t VALUES (?, ?, 'idle', CURRENT_TIMESTAMP)`)\n31\t\tif err != nil {\n32\t\t\treturn nil, fmt.Errorf(\"prepare insert: %w\", err)\n33\t\t}\n34\t\tdefer insertStmt.Close()\n35\t\n36\t\tautoCreated := 0\n37\t\tfor _, num := range numbers {\n38\t\t\tres, err := insertStmt.ExecContext(ctx, repo, num)\n39\t\t\tif err != nil {\n40\t\t\t\treturn nil, fmt.Errorf(\"insert issue %d: %w\", num, err)\n41\t\t\t}\n42\t\t\tif n, _ := res.RowsAffected(); n > 0 {\n43\t\t\t\tautoCreated++\n44\t\t\t}\n45\t\t}\n46\t\tif autoCreated > 0 {\n47\t\t\tlogger.Debug(\"store.issue\", \"auto-created idle records for %d issues\", autoCreated)\n48\t\t}\n49\t\n50\t\t// 查询所有匹配的记录\n51\t\tplaceholders := make([]string, len(numbers))\n52\t\targs := make([]any, 0, len(numbers)+1)\n53\t\targs = append(args, repo)\n54\t\tfor i, num := range numbers {\n55\t\t\tplaceholders[i] = \"?\"\n56\t\t\targs = append(args, num)\n57\t\t}\n58\t\n59\t\tquery := fmt.Sprintf(\n60\t\t\t`SELECT issue_number, status, session_id, claimed_at\n61\t\t\t   FROM issue_claims\n62\t\t\t  WHERE repo_full_name = ? AND issue_number IN (%s)`,\n63\t\t\tstrings.Join(placeholders, \",\"))\n64\t\n65\t\trows, err := s.db.QueryContext(ctx, query, args...)\n66\t\tif err != nil {\n67\t\t\treturn nil, fmt.Errorf(\"query issues: %w\", err)\n68\t\t}\n69\t\tdefer rows.Close()\n70\t\n71\t\tresults := make([]IssueCheckResult, 0, len(numbers))\n72\t\tfor rows.Next() {\n73\t\t\tvar r IssueCheckResult\n74\t\t\tvar sessionID sql.NullString\n75\t\t\tvar claimedAt sql.NullString\n76\t\t\tif err := rows.Scan(&r.Number, &r.Status, &sessionID, &claimedAt); err != nil {\n77\t\t\t\treturn nil, fmt.Errorf(\"scan row: %w\", err)\n78\t\t\t}\n79\t\t\tif sessionID.Valid {\n80\t\t\t\tr.SessionID = &sessionID.String\n81\t\t\t}\n82\t\t\tif claimedAt.Valid {\n83\t\t\t\tr.ClaimedAt = &claimedAt.String\n84\t\t\t}\n85\t\t\tresults = append(results, r)\n86\t\t}\n87\t\tlogger.Info(\"store.issue\", \"check issues: repo=%s found %d records\", repo, len(results))\n88\t\treturn results, rows.Err()\n89\t}\n90\t\n91\t// ClaimIssue 尝试领取指定 Issue。\n92\t// 使用乐观锁：仅在当前状态为 idle 时才能领取成功。\n93\t// 支持幂等：同一 session 重复领取返回成功。\n94\tfunc (s *sqliteIssueStore) ClaimIssue(ctx context.Context, repo string, number int, sessionID string, issueTitle string) (*ClaimResult, error) {\n95\t\tlogger.Debug(\"store.issue\", \"claim: repo=%s #%d session=%s\", repo, number, sessionID)\n96\t\n97\t\t// 确保记录存在（不存在时创建 idle 记录）\n98\t\t_, err := s.db.ExecContext(ctx,\n99\t\t\t`INSERT OR IGNORE INTO issue_claims (repo_full_name, issue_number, status, updated_at)\n100\t\t\t VALUES (?, ?, 'idle', CURRENT_TIMESTAMP)`,\n101\t\t\trepo, number)\n102\t\tif err != nil {\n103\t\t\treturn nil, fmt.Errorf(\"ensure issue: %w\", err)\n104\t\t}\n105\t\n106\t\t// 乐观锁：仅在 status = 'idle' 时更新为 claimed\n107\t\tres, err := s.db.ExecContext(ctx,\n108\t\t\t`UPDATE issue_claims\n109\t\t\t    SET status = 'claimed', session_id = ?, claimed_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP\n110\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND status = 'idle'`,\n111\t\t\tsessionID, repo, number)\n112\t\tif err != nil {\n113\t\t\treturn nil, fmt.Errorf(\"claim update: %w\", err)\n114\t\t}\n115\t\tn, _ := res.RowsAffected()\n116\t\tif n > 0 {\n117\t\t\tvar claimedAt string\n118\t\t\ts.db.QueryRowContext(ctx,\n119\t\t\t\t`SELECT claimed_at FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n120\t\t\t\trepo, number).Scan(&claimedAt)\n121\t\t\tlogger.Info(\"store.issue\", \"issue claimed: repo=%s #%d by %s\", repo, number, sessionID)\n122\t\t\treturn &ClaimResult{Success: true, Status: \"claimed\", ClaimedAt: &claimedAt}, nil\n123\t\t}\n124\t\n125\t\t// 领取失败，查询当前状态\n126\t\tvar curStatus string\n127\t\tvar curSession sql.NullString\n128\t\tvar curClaimedAt sql.NullString\n129\t\terr = s.db.QueryRowContext(ctx,\n130\t\t\t`SELECT status, session_id, claimed_at FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n131\t\t\trepo, number).Scan(&curStatus, &curSession, &curClaimedAt)\n132\t\tif err != nil {\n133\t\t\treturn nil, fmt.Errorf(\"query state: %w\", err)\n134\t\t}\n135\t\n136\t\t// 幂等：同一 session 已领取过\n137\t\tif curSession.Valid && curSession.String == sessionID {\n138\t\t\tlogger.Debug(\"store.issue\", \"claim idempotent: same session %s\", sessionID)\n139\t\t\tresult := &ClaimResult{Success: true, Status: curStatus}\n140\t\t\tif curClaimedAt.Valid {\n141\t\t\t\tresult.ClaimedAt = &curClaimedAt.String\n142\t\t\t}\n143\t\t\treturn result, nil\n144\t\t}\n145\t\n146\t\t// 已被其他 session 领取或处于终态\n147\t\tlogger.Warn(\"store.issue\", \"claim conflict: repo=%s #%d already claimed by %s\", repo, number, curSession.String)\n148\t\tresult := &ClaimResult{Success: false, Status: curStatus}\n149\t\tif curSession.Valid {\n150\t\t\tresult.ClaimedBy = &curSession.String\n151\t\t}\n152\t\tif curClaimedAt.Valid {\n153\t\t\tresult.ClaimedAt = &curClaimedAt.String\n154\t\t}\n155\t\treturn result, nil\n156\t}\n157\t\n158\t// UpdateIssueStatus 更新指定 Issue 的状态（仅当前持有者可更新）。\n159\tfunc (s *sqliteIssueStore) UpdateIssueStatus(ctx context.Context, repo string, number int, sessionID string, newStatus string) (*UpdateStatusResult, error) {\n160\t\tlogger.Debug(\"store.issue\", \"update status: repo=%s #%d -> %s\", repo, number, newStatus)\n161\t\n162\t\t// 查询当前状态\n163\t\tvar curStatus string\n164\t\tvar curOwner sql.NullString\n165\t\terr := s.db.QueryRowContext(ctx,\n166\t\t\t`SELECT status, session_id FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n167\t\t\trepo, number,\n168\t\t).Scan(&curStatus, &curOwner)\n169\t\tif err == sql.ErrNoRows {\n170\t\t\treturn &UpdateStatusResult{Updated: false}, nil\n171\t\t}\n172\t\tif err != nil {\n173\t\t\treturn nil, fmt.Errorf(\"query status: %w\", err)\n174\t\t}\n175\t\n176\t\t// 非持有者无法更新\n177\t\tif !curOwner.Valid || curOwner.String != sessionID {\n178\t\t\tlogger.Warn(\"store.issue\", \"status update rejected: not owner\")\n179\t\t\treturn &UpdateStatusResult{PreviousStatus: curStatus, Updated: false}, nil\n180\t\t}\n181\t\n182\t\t// 执行更新\n183\t\tres, err := s.db.ExecContext(ctx,\n184\t\t\t`UPDATE issue_claims SET status = ?, updated_at = CURRENT_TIMESTAMP\n185\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND session_id = ?`,\n186\t\t\tnewStatus, repo, number, sessionID,\n187\t\t)\n188\t\tif err != nil {\n189\t\t\treturn nil, fmt.Errorf(\"update status: %w\", err)\n190\t\t}\n191\t\tn, _ := res.RowsAffected()\n192\t\tif n > 0 {\n193\t\t\tlogger.Info(\"store.issue\", \"status updated: repo=%s #%d %s->%s\", repo, number, curStatus, newStatus)\n194\t\t}\n195\t\treturn &UpdateStatusResult{PreviousStatus: curStatus, NewStatus: newStatus, Updated: n > 0}, nil\n196\t}\n197\t\n198\t// ReleaseIssue 释放指定 session 持有的某个 Issue。\n199\t// 仅对非终态（非 merged/rejected）的 Issue 有效。\n200\tfunc (s *sqliteIssueStore) ReleaseIssue(ctx context.Context, repo string, number int, sessionID string) (bool, error) {\n201\t\tlogger.Debug(\"store.issue\", \"release: repo=%s #%d session=%s\", repo, number, sessionID)\n202\t\n203\t\t// 查询当前持有者\n204\t\tvar owner sql.NullString\n205\t\terr := s.db.QueryRowContext(ctx,\n206\t\t\t`SELECT session_id FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n207\t\t\trepo, number,\n208\t\t).Scan(&owner)\n209\t\tif err == sql.ErrNoRows {\n210\t\t\treturn false, nil\n211\t\t}\n212\t\tif err != nil {\n213\t\t\treturn false, fmt.Errorf(\"query owner: %w\", err)\n214\t\t}\n215\t\tif !owner.Valid || owner.String != sessionID {\n216\t\t\treturn false, nil\n217\t\t}\n218\t\n219\t\t// 释放：仅对非终态状态生效\n220\t\tres, err := s.db.ExecContext(ctx,\n221\t\t\t`UPDATE issue_claims\n222\t\t\t    SET status = 'idle', session_id = NULL, claimed_at = NULL, updated_at = CURRENT_TIMESTAMP\n223\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND session_id = ?\n224\t\t\t    AND status NOT IN ('merged', 'rejected')`,\n225\t\t\trepo, number, sessionID,\n226\t\t)\n227\t\tif err != nil {\n228\t\t\treturn false, fmt.Errorf(\"update: %w\", err)\n229\t\t}\n230\t\tn, _ := res.RowsAffected()\n231\t\treleased := n > 0\n232\t\tlogger.Info(\"store.issue\", \"issue released: repo=%s #%d released=%v\", repo, number, released)\n233\t\treturn released, nil\n234\t}\n235\t\n236\t// ReleaseSessionIssues 释放指定 session 持有的所有非终态 Issue。\n237\t// 返回被释放的 Issue 编号列表。\n238\tfunc (s *sqliteIssueStore) ReleaseSessionIssues(ctx context.Context, sessionID string) ([]int, error) {\n239\t\tlogger.Debug(\"store.issue\", \"release session: %s\", sessionID)\n240\t\n241\t\t// 先收集将要释放的 Issue 编号\n242\t\trows, err := s.db.QueryContext(ctx,\n243\t\t\t`SELECT issue_number FROM issue_claims\n244\t\t\t  WHERE session_id = ? AND status NOT IN ('merged', 'rejected')`,\n245\t\t\tsessionID,\n246\t\t)\n247\t\tif err != nil {\n248\t\t\treturn nil, fmt.Errorf(\"query session issues: %w\", err)\n249\t\t}\n250\t\n251\t\tvar numbers []int\n252\t\tfor rows.Next() {\n253\t\t\tvar n int\n254\t\t\tif err := rows.Scan(&n); err != nil {\n255\t\t\t\trows.Close()\n256\t\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n257\t\t\t}\n258\t\t\tnumbers = append(numbers, n)\n259\t\t}\n260\t\trows.Close()\n261\t\n262\t\tif len(numbers) == 0 {\n263\t\t\treturn nil, nil\n264\t\t}\n265\t\n266\t\t// 批量更新释放\n267\t\t_, err = s.db.ExecContext(ctx,\n268\t\t\t`UPDATE issue_claims\n269\t\t\t    SET status = 'idle', session_id = NULL, claimed_at = NULL, updated_at = CURRENT_TIMESTAMP\n270\t\t\t  WHERE session_id = ? AND status NOT IN ('merged', 'rejected')`,\n271\t\t\tsessionID,\n272\t\t)\n273\t\tif err != nil {\n274\t\t\treturn nil, fmt.Errorf(\"batch release: %w\", err)\n275\t\t}\n276\t\n277\t\tlogger.Info(\"store.issue\", \"released %d issues for session %s\", len(numbers), sessionID)\n278\t\treturn numbers, nil\n279\t}\n280\t"}]}
