ed for #$ISSUE_NUM\"\r\n#!/bin/bash\r\n# 003-6-issue-done 16Stop: Claude 响应结束后按 session_id 清理 .active\r\nPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\r\nSKILL_TAG=\"003-6-issue-done\"\r\nsource \"$PROJECT_DIR/.claude/skills/log.sh\"\r\nsource \"$PROJECT_DIR/.claude/skills/active.sh\"\r\n\r\nSESSION_ID=\"$1\"\r\n\r\nskill_log \"INFO\" \"[stop] skill completed | session: $SESSION_ID\"\r\n\r\nif [ -n \"$SESSION_ID\" ]; then\r\n  active_remove \"$SESSION_ID\"\r\n  skill_log \"INFO\" \"[stop] .active removed session: $SESSION_ID\"\r\nelse\r\n  active_remove_by_skill \"$SKILL_TAG\"\r\n  skill_log \"WARN\" \"[stop] no session_id, cleaned by skill name: $SKILL_TAG\"\r\nfi\r\nskill_log \"INFO\" \"[stop] skill lifecycle end\"\r\n#!/bin/bash\r\n# 003-6-issue-done 巡检：检查 gh + git\r\nPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\r\nSKILL_TAG=\"003-6-issue-done\"\r\nsource \"$PROJECT_DIR/.claude/skills/log.sh\"\r\n\r\nif command -v gh &>/dev/null && command -v git &>/dev/null; then\r\n  skill_log \"INFO\" \"[check] gh + git 可用\"\r\n  exit 0\r\nelse\r\n  skill_log \"WARN\" \"[check] gh 或 git 不可用\"\r\n  exit 1\r\nfi","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_use_id":"call_4ebd7b875d0c4c2d8a28e158","duration_ms":2757}
