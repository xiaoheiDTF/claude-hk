dAt     *time.Time `json:\"closed_at,omitempty\"` // 关闭时间（未关闭时为 null）\n71\t}\n72\t\n73\t// SessionDetail 是会话详情的响应体。\n74\ttype SessionDetail struct {\n75\t\tSessionID      string     `json:\"session_id\"`      // 会话 ID\n76\t\tMachineID      string     `json:\"machine_id\"`      // 机器 ID\n77\t\tOS             string     `json:\"os\"`              // 操作系统\n78\t\tProjectSlug    string     `json:\"project_slug\"`    // 项目标识\n79\t\tProjectCwd     string     `json:\"project_cwd\"`     // 项目工作目录\n80\t\tTranscriptPath string     `json:\"transcript_path\"` // 对话记录路径\n81\t\tLocalTracePath string     `json:\"local_trace_path\"` // 本地跟踪路径\n82\t\tModel          string     `json:\"model\"`           // 使用的模型\n83\t\tSource         string     `json:\"source\"`          // 来源\n84\t\tStatus         string     `json:\"status\"`          // 状态\n85\t\tRegisteredAt   time.Time  `json:\"registered_at\"`   // 注册时间\n86\t\tClosedAt       *time.Time `json:\"closed_at,omitempty\"` // 关闭时间\n87\t\tCloseReason    string     `json:\"close_reason,omitempty\"` // 关闭原因\n88\t}\n89\t\n90\t// --- Shared helpers ---\n91\t\n92\t// APIError 是统一的 API 错误结构体。\n93\ttype APIError struct {\n94\t\tCode    string `json:\"error\"`   // 错误码\n95\t\tMessage string `json:\"message\"` // 错误描述\n96\t}\n97\t\n98\t// writeJSON 向响应中写入 JSON 数据，设置 Content-Type 为 application/json。\n99\tfunc writeJSON(w http.ResponseWriter, status int, v any) {\n100\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n101\t\tw.WriteHeader(status)\n102\t\tjson.NewEncoder(w).Encode(v)\n103\t}\n104\t\n105\t// writeError 向响应中写入统一的 API 错误信息。\n106\tfunc writeError(w http.ResponseWriter, status int, code, message string) {\n107\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n108\t\tw.WriteHeader(status)\n109\t\tjson.NewEncoder(w).Encode(APIError{Code: code, Message: message})\n110\t}\n111\t"}]}
