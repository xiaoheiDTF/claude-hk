[2026-05-31 12:20:05] [INFO] [PreToolUse] Input: {"session_id":"7b2b89f2-ee5f-44be-9351-b88ec9fac19c","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\7b2b89f2-ee5f-44be-9351-b88ec9fac19c.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PreToolUse","tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\issue_store.go"},"tool_use_id":"call_0068bbde298f402f8ea90467"}
