\t\t\trunSessionPush(os.Args[2:])\n46\t\t\t\treturn\n47\t\t\tcase \"session-pull\":\n48\t\t\t\trunSessionPull(os.Args[2:])\n49\t\t\t\treturn\n50\t\t\tcase \"session-status\":\n51\t\t\t\trunSessionStatus(os.Args[2:])\n52\t\t\t\treturn\n53\t\t\tcase \"backend\":\n54\t\t\t\trunBackend(os.Args[2:])\n55\t\t\t\treturn\n56\t\t\tcase \"help\", \"--help\", \"-h\":\n57\t\t\t\tprintUsage()\n58\t\t\t\treturn\n59\t\t\t}\n60\t\t}\n61\t\n62\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n63\t\trunProxy(os.Args[1:])\n64\t}\n65\t\n66\t// printUsage 打印命令行使用帮助信息到标准输出。\n67\tfunc printUsage() {\n68\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n69\t\tfmt.Println()\n70\t\tfmt.Println(\"Usage:\")\n71\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n72\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n73\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n74\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n75\t\tfmt.Println()\n76\t\tfmt.Println(\"Proxy flags:\")\n77\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n78\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n79\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n80\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n81\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n82\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n83\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n84\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n85\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n86\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n87\t\tfmt.Println()\n88\t\tfmt.Println(\"Session-push flags:\")\n89\t\tfmt.Println(\"  --all                  Collect all projects\")\n90\t\tfmt.Println(\"  --force                Overwrite existing files\")\n91\t\tfmt.Println(\"  --dry-run              Preview only\")\n92\t\tfmt.Println(\"  --project NAME         Override project name\")\n93\t\tfmt.Println()\n94\t\tfmt.Println(\"Session-pull flags:\")\n95\t\tfmt.Println(\"  --all                  Restore all projects\")\n96\t\tfmt.Println(\"  --project NAME         Override project name\")\n97\t\tfmt.Println(\"  --dry-run              Preview only\")\n98\t\tfmt.Println()\n99\t\tfmt.Println(\"Session-status flags:\")\n100\t\tfmt.Println(\"  --verbose              Show file-level details\")\n101\t}\n102\t\n103\t// runProxy 是默认的代理模式主逻辑。\n104\t//\n105\t// 工作流程：\n106\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n107\t//  2. 自动探测上游 API 目标地址\n108\t//  3. 启动本地反向代理监听指定端口\n109\t//  4. 解析 Claude Code 可执行文件路径\n110\t//  5. 构建子进程环境变量（注入代理地址）\n111\t//  6. 启动 Claude Code 作为子进程\n112\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n113\t//  8. 子进程退出后打印 API 调用统计摘要\n114\tfunc runProxy(args []string) {\n115\t\t// 记录原始命令行参数，用于生成 resume 命令\n116\t\toriginalArgs := append([]string{}, args...)\n117\t\n118\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n119\t\tvar (\n120\t\t\ttapTarget    string // 上游 API 目标地址\n121\t\t\ttapPort      int    // 本地代理监听端口\n122\t\t\ttapOutputDir string // 追踪记录输出目录\n123\t\t\ttapVerbose   bool   // 是否启用详细日志\n124\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n125\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n126\t\t\ttapAPIKey    string // 直接传入 API Key\n127\t\t\ttapAuthToken string // 直接传入 OAuth Token\n128\t\t\ttapBaseURL   string // 直接传入上游地址\n129\t\t)\n130\t\n131\t\tvar claudeArgs []string\n132\t\tfor i := 0; i < len(args); i++ {\n133\t\t\targ := args[i]\n134\t\t\tswitch {\n135\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n136\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n137\t\t\t\ti++\n138\t\t\t\ttapTarget = args[i]\n139\t\t\t// 解析 --tap-target=URL 形式\n140\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n141\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n142\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n143\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n144\t\t\t\ti++\n145\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n146\t\t\t// 解析 --tap-port=PORT 形式\n147\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n148\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n149\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n150\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n151\t\t\t\ti++\n152\t\t\t\ttapOutputDir = args[i]\n153\t\t\t// 解析 --tap-output-dir=DIR 形式\n154\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n155\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n156\t\t\t// 启用详细日志\n157\t\t\tcase arg == \"--tap-verbose\":\n158\t\t\t\ttapVerbose = true\n159\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n160\t\t\tcase arg == \"--tap-console\":\n161\t\t\t\ttapConsole = true\n162\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n163\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n164\t\t\t\ti++\n165\t\t\t\ttapProfile = args[i]\n166\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n167\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n168\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n169\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n170\t\t\t\ti++\n171\t\t\t\ttapAPIKey = args[i]\n172\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n173\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n174\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n175\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n176\t\t\t\ti++\n177\t\t\t\ttapAuthToken = args[i]\n178\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n179\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n180\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n181\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n182\t\t\t\ti++\n183\t\t\t\ttapBaseURL = args[i]\n184\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n185\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n186\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n187\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n188\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n189\t\t\t\ti = len(args) // 停止解析\n190\t\t\t// 未知的 --tap-* 标志，直接忽略\n191\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n192\t\t\t// 其他参数视为 Claude Code 的参数\n193\t\t\tdefault:\n194\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n195\t\t\t}\n196\t\t}\n197\t\n198\t\t// 如果未指定输出目录，使用默认追踪目录\n199\t\tif tapOutputDir == \"\" {\n200\t\t\ttapOutputDir = trace.DefaultTraceDir()\n201\t\t}\n202\t\n203\t\t// 校验：--tap-console 必须配合 --tap-verbose\n204\t\tif tapConsole && !tapVerbose {\n205\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n206\t\t\tos.Exit(1)\n207\t\t}\n208\t\n209\t\t// 根据详细程度重新初始化日志器\n210\t\tif tapVerbose {\n211\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n212\t\t} else {\n213\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n214\t\t}\n215\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n216\t\n217\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n218\t\tresolved, err := config.ResolveTargetConfig(\n219\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n220\t\t\ttapAPIKey,\n221\t\t\ttapAuthToken,\n222\t\t\ttapProfile,\n223\t\t\t&config.ClaudeClient,\n224\t\t)\n225\t\tif err != nil {\n226\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n227\t\t}\n228\t\ttarget := resolved.BaseURL\n229\t\tif tapVerbose {\n230\t\t\tlog.Printf(\"upstream target: %s\", target)\n231\t\t}\n232\t\n233\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n234\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n235\t\tport := tapPort\n236\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n237\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n238\t\tif err != nil {\n239\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n240\t\t}\n241\t\t// 函数退出时停止代理\n242\t\tdefer rp.Stop()\n243\t\n244\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n245\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n246\t\n247\t\t// 自动检测并启动后端服务（如果未运行）\n248\t\tensureBackend()\n249\t\n250\t\t// 向后端注册本代理（hooks 通过后端转发 trace-init）\n251\t\tregisterProxyWithBackend(proxyURL)\n252\t\t// 代理退出时注销\n253\t\tdefer unregisterProxyFromBackend()\n254\t\n255\t\t// 设置会话初始化回调：注册到 proxy.json\n256\t\trp.OnSessionInit = func(sessionID, projectSlug string) {\n257\t\t\tkey := ProxySessionKey(projectSlug, sessionID)\n258\t\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\n259\t\t\t\tlogger.Warn(\"main\", \"register proxy session failed: %v\", err)\n260\t\t\t}\n261\t\t}\n262\t\t// 代理退出时注销 proxy.json 中的会话\n263\t\tdefer func() {\n264\t\t\tif sid := rp.SessionID(); sid != \"\" {\n265\t\t\t\tslug := rp.ProjectSlug()\n266\t\t\t\tkey := ProxySessionKey(slug, sid)\n267\t\t\t\tif err := UnregisterProxySession(key); err != nil {\n268\t\t\t\t\tlogger.Warn(\"main\", \"unregister proxy session failed: %v\", err)\n269\t\t\t\t}\n270\t\t\t}\n271\t\t}()\n272\t\n273\t\t// 解析 Claude Code 可执行文件路径\n274\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n275\t\tif err != nil {\n276\t\t\tlog.Fatal(err)\n277\t\t}\n278\t\n279\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n280\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n281\t\n282\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n283\t\tif resolved.APIKey != \"\" {\n284\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n285\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n286\t\t} else if resolved.AuthToken != \"\" {\n287\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n288\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n289\t\t}\n290\t\n291\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n292\t\tfinalArgs := claudeArgs\n293\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n294\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n295\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n296\t\t}\n297\t\n298\t\t// 启动 Claude Code 作为子进程\n299\t\tcmd := exec.Command(claudePath, finalArgs...)\n300\t\tcmd.Env = childEnv\n301\t\tcmd.Stdin = os.Stdin\n302\t\tcmd.Stdout = os.Stdout\n303\t\tcmd.Stderr = os.Stderr\n304\t\n305\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n306\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n307\t\n308\t\tif err := cmd.Start(); err != nil {\n309\t\t\tlog.Fatalf(\"start claude: %v\", err)\n310\t\t}\n311\t\n312\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n313\t\tsigChan := make(chan os.Signal, 2)\n314\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n315\t\n316\t\tgo func() {\n317\t\t\tsigCount := 0\n318\t\t\tfor sig := range sigChan {\n319\t\t\t\tsigCount++\n320\t\t\t\tif sigCount == 1 {\n321\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n322\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n323\t\t\t\t\t_ = cmd.Process.Signal(sig)\n324\t\t\t\t} else {\n325\t\t\t\t\t// 再次收到信号：强制终止子进程\n326\t\t\t\t\t_ = cmd.Process.Kill()\n327\t\t\t\t}\n328\t\t\t}\n329\t\t}()\n330\t\n331\t\t// 等待子进程结束\n332\t\twaitErr := cmd.Wait()\n333\t\n334\t\t// 停止信号处理器，释放资源\n335\t\tsignal.Stop(sigChan)\n336\t\tclose(sigChan)\n337\t\n338\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n339\t\tsummary := rp.Summary()\n340\t\ttracePath := rp.TracePath()\n341\t\n342\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n343\t\tif waitErr != nil {\n344\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n345\t\t}\n346\t\tfmt.Printf(\"\\n\")\n347\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n348\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n349\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n350\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n351\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n352\t\tif tracePath != \"\" {\n353\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n354\t\t}\n355\t\tfmt.Printf(\"\\n\")\n356\t\n357\t\t// 生成 Resume 命令（仅在有 session_id 时）\n358\t\tsessionID := rp.SessionID()\n359\t\tif sessionID != \"\" {\n360\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n361\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n362\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n363\t\t}\n364\t}\n365\t\n366\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n367\t//\n368\t// 支持的参数：\n369\t//   --all       收集所有项目的会话\n370\t//   --force     覆盖已存在的会话文件\n371\t//   --dry-run   仅预览，不实际执行\n372\t//   --project   指定项目名称，覆盖自动检测\n373\tfunc runSessionPush(args []string) {\n374\t\tvar opts session.PushOptions\n375\t\tfor i := 0; i < len(args); i++ {\n376\t\t\targ := args[i]\n377\t\t\tswitch {\n378\t\t\tcase arg == \"--all\":\n379\t\t\t\topts.All = true\n380\t\t\tcase arg == \"--force\":\n381\t\t\t\topts.Force = true\n382\t\t\tcase arg == \"--dry-run\":\n383\t\t\t\topts.DryRun = true\n384\t\t\tcase arg == \"--project\" && i+1 < len(args):\n385\t\t\t\ti++\n386\t\t\t\topts.Project = args[i]\n387\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n388\t\t\t\topts.Project = arg[len(\"--project=\"):]\n389\t\t\t}\n390\t\t}\n391\t\n392\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n393\t\tresults, err := session.SessionPush(opts)\n394\t\tif err != nil {\n395\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n396\t\t\tos.Exit(1)\n397\t\t}\n398\t\n399\t\t// 汇总各项目的收集结果\n400\t\tfmt.Println()\n401\t\ttotalNew, totalSkipped := 0, 0\n402\t\tfor _, r := range results {\n403\t\t\ttotalNew += r.SessionsNew\n404\t\t\ttotalSkipped += r.SessionsSkipped\n405\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n406\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n407\t\t\t}\n408\t\t}\n409\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n410\t}\n411\t\n412\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n413\t//\n414\t// 支持的参数：\n415\t//   --all       恢复所有项目的会话\n416\t//   --dry-run   仅预览，不实际执行\n417\t//   --project   指定项目名称，覆盖自动检测\n418\tfunc runSessionPull(args []string) {\n419\t\tvar opts session.PullOptions\n420\t\tfor i := 0; i < len(args); i++ {\n421\t\t\targ := args[i]\n422\t\t\tswitch {\n423\t\t\tcase arg == \"--all\":\n424\t\t\t\topts.All = true\n425\t\t\tcase arg == \"--dry-run\":\n426\t\t\t\topts.DryRun = true\n427\t\t\tcase arg == \"--project\" && i+1 < len(args):\n428\t\t\t\ti++\n429\t\t\t\topts.Project = args[i]\n430\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n431\t\t\t\topts.Project = arg[len(\"--project=\"):]\n432\t\t\t}\n433\t\t}\n434\t\n435\t\tfmt.Println(\"📤 Restoring sessions...\")\n436\t\tresults, err := session.SessionPull(opts)\n437\t\tif err != nil {\n438\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n439\t\t\tos.Exit(1)\n440\t\t}\n441\t\n442\t\t// 汇总各项目的恢复结果\n443\t\tfmt.Println()\n444\t\ttotalRestored, totalSkipped := 0, 0\n445\t\tfor _, r := range results {\n446\t\t\ttotalRestored += r.SessionsRestored\n447\t\t\ttotalSkipped += r.SessionsSkipped\n448\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n449\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n450\t\t\t}\n451\t\t}\n452\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n453\t}\n454\t\n455\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n456\t//\n457\t// 支持的参数：\n458\t//   --verbose   显示文件级别的详细信息\n459\tfunc runSessionStatus(args []string) {\n460\t\tvar opts session.StatusOptions\n461\t\tfor i := 0; i < len(args); i++ {\n462\t\t\targ := args[i]\n463\t\t\tswitch {\n464\t\t\tcase arg == \"--verbose\":\n465\t\t\t\topts.Verbose = true\n466\t\t\t}\n467\t\t}\n468\t\n469\t\tif err := session.SessionStatus(opts); err != nil {\n470\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n471\t\t\tos.Exit(1)\n472\t\t}\n473\t}\n474\t\n475\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n476\t// 如果参数中包含空格或制表符，则使用引号包裹。\n477\tfunc formatArgs(args []string) string {\n478\t\tresult := \"\"\n479\t\tfor _, a := range args {\n480\t\t\tif containsSpace(a) {\n481\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n482\t\t\t} else {\n483\t\t\t\tresult += \" \" + a\n484\t\t\t}\n485\t\t}\n486\t\treturn strings.TrimSpace(result)\n487\t}\n488\t\n489\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n490\tfunc containsSpace(s string) bool {\n491\t\tfor _, c := range s {\n492\t\t\tif c == ' ' || c == '\\t' {\n493\t\t\t\treturn true\n494\t\t\t}\n495\t\t}\n496\t\treturn false\n497\t}\n498\t\n499\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n500\tfunc firstNonEmpty(ss ...string) string {\n501\t\tfor _, s := range ss {\n502\t\t\tif s != \"\" {\n503\t\t\t\treturn s\n504\t\t\t}\n505\t\t}\n506\t\treturn \"\"\n507\t}\n508\t\n509\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n510\t//\n511\t// 逻辑：\n512\t//  1. 复制原始参数\n513\t//  2. 移除已有的 --resume <old-id>（如果存在）\n514\t//  3. 追加 --resume <new-session-id>\n515\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n516\t\tfiltered := make([]string, 0, len(originalArgs))\n517\t\tskip := false\n518\t\tfor i, arg := range originalArgs {\n519\t\t\tif skip {\n520\t\t\t\tskip = false\n521\t\t\t\tcontinue\n522\t\t\t}\n523\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n524\t\t\t\tskip = true // 跳过 --resume 及其值\n525\t\t\t\tcontinue\n526\t\t\t}\n527\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n528\t\t\t\tcontinue // 跳过 --resume=id 形式\n529\t\t\t}\n530\t\t\tfiltered = append(filtered, arg)\n531\t\t}\n532\t\tfiltered = append(filtered, \"--resume\", sessionID)\n533\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n534\t}\n535\t\n536\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n537\tfunc shortenPath(path string) string {\n538\t\thome, err := os.UserHomeDir()\n539\t\tif err != nil {\n540\t\t\treturn path\n541\t\t}\n542\t\tif strings.HasPrefix(path, home) {\n543\t\t\treturn \"~\" + path[len(home):]\n544\t\t}\n545\t\treturn path\n546\t}\n547\t\n548\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n549\tfunc removeEnvVar(env []string, name string) []string {\n550\t\tprefix := name + \"=\"\n551\t\tresult := make([]string, 0, len(env))\n552\t\tfor _, e := range env {\n553\t\t\tif !strings.HasPrefix(e, prefix) {\n554\t\t\t\tresult = append(result, e)\n555\t\t\t}\n556\t\t}\n557\t\treturn result\n558\t}\n559\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\backend_cmd.go"},"tool_use_id":"call_210beeed0dc243a181ff2d73","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"log\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n12\t)\n13\t\n14\t// runBackend 启动后端服务器模式。\n15\t//\n16\t// 支持的命令行参数：\n17\t//   --port, -p PORT    指定服务器监听端口（默认随机）\n18\t//   --db, -d PATH      指定数据库文件路径\n19\t//   --host HOST        指定服务器绑定地址\n20\tfunc runBackend(args []string) {\n21\t\t// 使用默认配置初始化后端服务器配置\n22\t\tcfg := backend.DefaultConfig()\n23\t\n24\t\t// 遍历命令行参数，解析并覆盖默认配置\n25\t\tfor i := 0; i < len(args); i++ {\n26\t\t\targ := args[i]\n27\t\t\tswitch {\n28\t\t\t// 解析 --port 或 -p 参数（空格分隔形式，如 --port 8080）\n29\t\t\tcase (arg == \"--port\" || arg == \"-p\") && i+1 < len(args):\n30\t\t\t\ti++\n31\t\t\t\tfmt.Sscanf(args[i], \"%d\", &cfg.Port)\n32\t\t\t// 解析 --port=PORT 形式（等号连接，如 --port=8080）\n33\t\t\tcase strings.HasPrefix(arg, \"--port=\"):\n34\t\t\t\tfmt.Sscanf(arg[len(\"--port=\"):], \"%d\", &cfg.Port)\n35\t\t\t// 解析 --db 或 -d 参数（空格分隔形式）\n36\t\t\tcase (arg == \"--db\" || arg == \"-d\") && i+1 < len(args):\n37\t\t\t\ti++\n38\t\t\t\tcfg.DBPath = args[i]\n39\t\t\t// 解析 --db=PATH 形式\n40\t\t\tcase strings.HasPrefix(arg, \"--db=\"):\n41\t\t\t\tcfg.DBPath = arg[len(\"--db=\"):]\n42\t\t\t// 解析 --host 参数（空格分隔形式）\n43\t\t\tcase arg == \"--host\" && i+1 < len(args):\n44\t\t\t\ti++\n45\t\t\t\tcfg.Host = args[i]\n46\t\t\t// 解析 --host=HOST 形式\n47\t\t\tcase strings.HasPrefix(arg, \"--host=\"):\n48\t\t\t\tcfg.Host = arg[len(\"--host=\"):]\n49\t\t\t}\n50\t\t}\n51\t\n52\t\t// 初始化文件日志器\n53\t\tlogDir := trace.DefaultTraceDir()\n54\t\tif cfg.DBPath != \"\" && cfg.DBPath != \"backend.db\" {\n55\t\t\tlogDir = filepath.Dir(cfg.DBPath)\n56\t\t}\n57\t\tif err := logger.Init(logDir, true, logger.DEBUG); err != nil {\n58\t\t\tlog.Printf(\"warning: logger init failed: %v\", err)\n59\t\t}\n60\t\tdefer logger.Close()\n61\t\tlogger.Info(\"backend.cmd\", \"backend starting: host=%s port=%d db=%s\", cfg.Host, cfg.Port, cfg.DBPath)\n62\t\n63\t\t// 写入 backend.json，让代理进程知道后端在哪里\n64\t\tif err := WriteBackendInfo(BackendInfo{Host: cfg.Host, Port: cfg.Port}); err != nil {\n65\t\t\tlogger.Warn(\"backend.cmd\", \"write backend.json failed: %v\", err)\n66\t\t}\n67\t\t// 后端退出时删除 backend.json\n68\t\tdefer func() {\n69\t\t\tif err := RemoveBackendInfo(); err != nil {\n70\t\t\t\tlogger.Warn(\"backend.cmd\", \"remove backend.json failed: %v\", err)\n71\t\t\t}\n72\t\t}()\n73\t\n74\t\t// 根据配置创建后端服务器实例\n75\t\tsrv, err := backend.NewServer(cfg)\n76\t\tif err != nil {\n77\t\t\tlog.Fatalf(\"create server: %v\", err)\n78\t\t}\n79\t\t// 函数退出时确保关闭服务器资源\n80\t\tdefer srv.Close()\n81\t\n82\t\t// 启动服务器并开始监听请求\n83\t\tif err := srv.Start(); err != nil {\n84\t\t\tlog.Fatalf(\"server error: %v\", err)\n85\t\t}\n86\t}\n87\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\backend_autostart.go"},"tool_use_id":"call_1ff9ee02071d4f9e90d65450","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"net/http\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"runtime\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n14\t)\n15\t\n16\t// backendHealthURL 根据 backend.json 中的信息构建 /health 检测 URL。\n17\t// 如果 backend.json 不存在或内容无效，使用默认地址 127.0.0.1:8080。\n18\tfunc backendHealthURL() string {\n19\t\tif info := ReadBackendInfo(); info != nil {\n20\t\t\treturn fmt.Sprintf(\"http://%s:%d/health\", info.Host, info.Port)\n21\t\t}\n22\t\treturn \"http://127.0.0.1:8080/health\"\n23\t}\n24\t\n25\t// isBackendRunning 检测后端服务是否在运行（GET /health）。\n26\tfunc isBackendRunning() bool {\n27\t\tclient := &http.Client{Timeout: 2 * time.Second}\n28\t\tresp, err := client.Get(backendHealthURL())\n29\t\tif err != nil {\n30\t\t\treturn false\n31\t\t}\n32\t\tdefer resp.Body.Close()\n33\t\treturn resp.StatusCode == http.StatusOK\n34\t}\n35\t\n36\t// startBackendProcess 启动后端作为独立子进程。\n37\t// 使用当前可执行文件路径 + \"backend\" 子命令，进程完全脱离父进程。\n38\tfunc startBackendProcess() error {\n39\t\texePath, err := os.Executable()\n40\t\tif err != nil {\n41\t\t\treturn fmt.Errorf(\"get executable path: %w\", err)\n42\t\t}\n43\t\n44\t\tcmd := exec.Command(exePath, \"backend\")\n45\t\tcmd.Stdin = nil\n46\t\tcmd.Stdout = nil\n47\t\tcmd.Stderr = nil\n48\t\n49\t\t// 使后端进程独立于代理进程，不受父进程信号影响\n50\t\tif runtime.GOOS == \"windows\" {\n51\t\t\t// Windows: 创建新进程组，脱离父进程控制台\n52\t\t\tcmd.SysProcAttr = syscallSysProcAttr()\n53\t\t} else {\n54\t\t\t// Unix: 创建新进程组\n55\t\t\tcmd.SysProcAttr = unixSysProcAttr()\n56\t\t}\n57\t\n58\t\tif err := cmd.Start(); err != nil {\n59\t\t\treturn fmt.Errorf(\"start backend: %w\", err)\n60\t\t}\n61\t\n62\t\tlogger.Info(\"autostart\", \"backend process started: pid=%d\", cmd.Process.Pid)\n63\t\t// 释放子进程，让其独立运行，父进程不等待\n64\t\tcmd.Process.Release()\n65\t\treturn nil\n66\t}\n67\t\n68\t// waitForBackend 轮询 /health 端点，等待后端就绪。\n69\t// timeout 为最长等待时间，interval 为轮询间隔。\n70\t// 返回 true 表示后端已就绪，false 表示超时。\n71\tfunc waitForBackend(timeout, interval time.Duration) bool {\n72\t\tdeadline := time.Now().Add(timeout)\n73\t\tclient := &http.Client{Timeout: 500 * time.Millisecond}\n74\t\n75\t\tfor time.Now().Before(deadline) {\n76\t\t\tresp, err := client.Get(backendHealthURL())\n77\t\t\tif err == nil {\n78\t\t\t\tresp.Body.Close()\n79\t\t\t\tif resp.StatusCode == http.StatusOK {\n80\t\t\t\t\treturn true\n81\t\t\t\t}\n82\t\t\t}\n83\t\t\ttime.Sleep(interval)\n84\t\t}\n85\t\treturn false\n86\t}\n87\t\n88\t// ensureBackend 检测后端是否在运行，如果未运行则自动启动。\n89\t// 启动失败不阻塞代理，仅记录警告。\n90\tfunc ensureBackend() {\n91\t\t// 步骤 1：检查后端是否已在运行\n92\t\tif isBackendRunning() {\n93\t\t\tlogger.Info(\"autostart\", \"backend already running\")\n94\t\t\treturn\n95\t\t}\n96\t\n97\t\t// 步骤 2：后端未运行，启动新进程\n98\t\tlogger.Info(\"autostart\", \"backend not running, starting...\")\n99\t\tif err := startBackendProcess(); err != nil {\n100\t\t\tlogger.Warn(\"autostart\", \"failed to start backend: %v\", err)\n101\t\t\treturn\n102\t\t}\n103\t\n104\t\t// 步骤 3：等待后端就绪（最多 5 秒）\n105\t\tif waitForBackend(5*time.Second, 200*time.Millisecond) {\n106\t\t\tinfo := ReadBackendInfo()\n107\t\t\tif info != nil {\n108\t\t\t\tfmt.Printf(\"   Backend started at http://%s:%d\\n\", info.Host, info.Port)\n109\t\t\t}\n110\t\t\tlogger.Info(\"autostart\", \"backend ready\")\n111\t\t} else {\n112\t\t\tlogger.Warn(\"autostart\", \"backend did not become healthy within 5s\")\n113\t\t}\n114\t}\n115\t\n116\t// backendAPIBase 返回后端 API 的基础 URL（从 backend.json 读取）。\n117\tfunc backendAPIBase() string {\n118\t\tif info := ReadBackendInfo(); info != nil {\n119\t\t\treturn fmt.Sprintf(\"http://%s:%d\", info.Host, info.Port)\n120\t\t}\n121\t\treturn \"http://127.0.0.1:8080\"\n122\t}\n123\t\n124\t// registerProxyWithBackend 向后端注册本代理进程。\n125\tfunc registerProxyWithBackend(proxyURL string) {\n126\t\tpid := fmt.Sprintf(\"%d\", os.Getpid())\n127\t\tbody, _ := json.Marshal(map[string]string{\"pid\": pid, \"proxy_url\": proxyURL})\n128\t\tresp, err := http.Post(backendAPIBase()+\"/api/proxy/register\", \"application/json\", bytes.NewReader(body))\n129\t\tif err != nil {\n130\t\t\tlogger.Warn(\"autostart\", \"proxy register failed: %v\", err)\n131\t\t\treturn\n132\t\t}\n133\t\tdefer resp.Body.Close()\n134\t\tlogger.Info(\"autostart\", \"proxy registered: pid=%s url=%s\", pid, proxyURL)\n135\t}\n136\t\n137\t// unregisterProxyFromBackend 从后端注销本代理进程。\n138\tfunc unregisterProxyFromBackend() {\n139\t\tpid := fmt.Sprintf(\"%d\", os.Getpid())\n140\t\tbody, _ := json.Marshal(map[string]string{\"pid\": pid})\n141\t\tresp, err := http.Post(backendAPIBase()+\"/api/proxy/unregister\", \"application/json\", bytes.NewReader(body))\n142\t\tif err != nil {\n143\t\t\tlogger.Warn(\"autostart\", \"proxy unregister failed: %v\", err)\n144\t\t\treturn\n145\t\t}\n146\t\tdefer resp.Body.Close()\n147\t\tlogger.Info(\"autostart\", \"proxy unregistered: pid=%s\", pid)\n148\t}\n149\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\session_files.go"},"tool_use_id":"call_9fdff08279704be8bf2fac3c","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"sync\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t)\n11\t\n12\t// BaseDir 返回 ~/.claude-tap-plus/ 根目录。\n13\tfunc BaseDir() string {\n14\t\thome, err := os.UserHomeDir()\n15\t\tif err != nil {\n16\t\t\treturn \".claude-tap-plus\"\n17\t\t}\n18\t\treturn filepath.Join(home, \".claude-tap-plus\")\n19\t}\n20\t\n21\t// --- backend.json ---\n22\t\n23\t// BackendInfo 记录后端服务的连接信息，存储在 ~/.claude-tap-plus/backend.json 中。\n24\ttype BackendInfo struct {\n25\t\tHost string `json:\"host\"` // 后端监听地址，如 127.0.0.1\n26\t\tPort int    `json:\"port\"` // 后端监听端口，如 8080\n27\t}\n28\t\n29\t// BackendJSONPath 返回 backend.json 的完整路径。\n30\tfunc BackendJSONPath() string {\n31\t\treturn filepath.Join(BaseDir(), \"backend.json\")\n32\t}\n33\t\n34\t// ReadBackendInfo 读取 backend.json，失败返回 nil。\n35\tfunc ReadBackendInfo() *BackendInfo {\n36\t\tdata, err := os.ReadFile(BackendJSONPath())\n37\t\tif err != nil {\n38\t\t\treturn nil\n39\t\t}\n40\t\tvar info BackendInfo\n41\t\tif json.Unmarshal(data, &info) != nil {\n42\t\t\treturn nil\n43\t\t}\n44\t\treturn &info\n45\t}\n46\t\n47\t// WriteBackendInfo 写入 backend.json（自动创建目录）。\n48\tfunc WriteBackendInfo(info BackendInfo) error {\n49\t\tdir := filepath.Dir(BackendJSONPath())\n50\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n51\t\t\treturn err\n52\t\t}\n53\t\tdata, err := json.MarshalIndent(info, \"\", \"  \")\n54\t\tif err != nil {\n55\t\t\treturn err\n56\t\t}\n57\t\treturn os.WriteFile(BackendJSONPath(), data, 0o644)\n58\t}\n59\t\n60\t// RemoveBackendInfo 删除 backend.json。\n61\tfunc RemoveBackendInfo() error {\n62\t\terr := os.Remove(BackendJSONPath())\n63\t\tif err != nil && !os.IsNotExist(err) {\n64\t\t\treturn err\n65\t\t}\n66\t\treturn nil\n67\t}\n68\t\n69\t// --- proxy.json ---\n70\t\n71\t// ProxySession 记录一个活跃的代理会话。\n72\ttype ProxySession struct {\n73\t\tStartedAt string `json:\"started_at\"` // 会话启动时间（ISO 8601）\n74\t}\n75\t\n76\t// ProxyJSONPath 返回 proxy.json 的完整路径。\n77\tfunc ProxyJSONPath() string {\n78\t\treturn filepath.Join(BaseDir(), \"proxy.json\")\n79\t}\n80\t\n81\tvar proxyMu sync.Mutex // 保护 proxy.json 并发读写\n82\t\n83\t// ProxySessionKey 生成 proxy.json 中的唯一键：{projectSlug}_{sessionID}。\n84\tfunc ProxySessionKey(projectSlug, sessionID string) string {\n85\t\treturn projectSlug + \"_\" + sessionID\n86\t}\n87\t\n88\t// RegisterProxySession 向 proxy.json 注册一个会话。\n89\t// key 格式为 {projectSlug}_{sessionID}，确保同一项目同一会话唯一。\n90\tfunc RegisterProxySession(key string, startedAt string) error {\n91\t\tproxyMu.Lock()\n92\t\tdefer proxyMu.Unlock()\n93\t\n94\t\tsessions := readProxySessions()\n95\t\tsessions[key] = ProxySession{StartedAt: startedAt}\n96\t\treturn writeProxySessions(sessions)\n97\t}\n98\t\n99\t// UnregisterProxySession 从 proxy.json 注销一个会话。\n100\tfunc UnregisterProxySession(key string) error {\n101\t\tproxyMu.Lock()\n102\t\tdefer proxyMu.Unlock()\n103\t\n104\t\tsessions := readProxySessions()\n105\t\tdelete(sessions, key)\n106\t\treturn writeProxySessions(sessions)\n107\t}\n108\t\n109\t// ReadProxySessions 读取 proxy.json 中的所有会话（不加锁，供 watchdog 使用）。\n110\tfunc ReadProxySessions() map[string]ProxySession {\n111\t\tproxyMu.Lock()\n112\t\tdefer proxyMu.Unlock()\n113\t\treturn readProxySessions()\n114\t}\n115\t\n116\t// readProxySessions 内部读取函数，不加锁。\n117\tfunc readProxySessions() map[string]ProxySession {\n118\t\tresult := make(map[string]ProxySession)\n119\t\tdata, err := os.ReadFile(ProxyJSONPath())\n120\t\tif err != nil {\n121\t\t\treturn result\n122\t\t}\n123\t\tjson.Unmarshal(data, &result)\n124\t\treturn result\n125\t}\n126\t\n127\t// writeProxySessions 内部写入函数，不加锁。\n128\tfunc writeProxySessions(sessions map[string]ProxySession) error {\n129\t\tdir := filepath.Dir(ProxyJSONPath())\n130\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n131\t\t\treturn err\n132\t\t}\n133\t\tdata, err := json.MarshalIndent(sessions, \"\", \"  \")\n134\t\tif err != nil {\n135\t\t\treturn err\n136\t\t}\n137\t\tlogger.Debug(\"session_files\", \"proxy.json updated: %d sessions\", len(sessions))\n138\t\treturn os.WriteFile(ProxyJSONPath(), data, 0o644)\n139\t}\n140\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\sysproc_unix.go"},"tool_use_id":"call_80fcb074f9c742fc928e5ee2","tool_response":"1\t//go:build !windows\n2\t\n3\tpackage main\n4\t\n5\timport \"syscall\"\n6\t\n7\tfunc syscallSysProcAttr() *syscall.SysProcAttr {\n8\t\treturn nil\n9\t}\n10\t\n11\tfunc unixSysProcAttr() *syscall.SysProcAttr {\n12\t\treturn &syscall.SysProcAttr{\n13\t\t\tSetpgid: true,\n14\t\t}\n15\t}\n16\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\sysproc_windows.go"},"tool_use_id":"call_fde2a84acbb146c7a4834353","tool_response":"1\t//go:build windows\n2\t\n3\tpackage main\n4\t\n5\timport \"syscal