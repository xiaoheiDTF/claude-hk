 http.Header, redact bool) http.Header {\n\tout := make(http.Header)\n\tfor k, vals := range headers {\n\t\tlower := strings.ToLower(k)\n\t\t// 跳过逐跳头\n\t\tif hopByHopHeaders[lower] {\n\t\t\tcontinue\n\t\t}\n\t\t// 敏感头脱敏处理\n\t\tif redact && sensitiveHeaderKeys[lower] {\n\t\t\tfor _, v := range vals {\n\t\t\t\tif prefixRedactedKeys[lower] && len(v) > 12 {\n\t\t\t\t\tout.Set(k, v[:12]+\"...\")\n\t\t\t\t} else {\n\t\t\t\t\tout.Set(k, \"***\")\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tfor _, v := range vals {\n\t\t\tout.Add(k, v)\n\t\t}\n\t}\n\treturn out\n}\n\n// HeadersToMap 将 http.Header 转换为 map[string]string，用于 Trace 记录。\n// 每个键只保留第一个值。\nfunc HeadersToMap(h http.Header) map[string]string {\n\tm := make(map[string]string, len(h))\n\tfor k, vals := range h {\n\t\tif len(vals) > 0 {\n\t\t\tm[k] = vals[0]\n\t\t}\n\t}\n\treturn m\n}\n","numLines":83,"startLine":1,"totalLines":83}},"tool_use_id":"call_3df838ef16a9490ea3d87ade","duration_ms":4}
