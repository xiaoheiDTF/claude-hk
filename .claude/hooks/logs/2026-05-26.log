ngs.TrimRight(line, \"\\r\")\n48\t\n49\t\tif strings.HasPrefix(line, \"event:\") {\n50\t\t\tev := strings.TrimSpace(line[len(\"event:\"):])\n51\t\t\tr.curEv = &ev\n52\t\t\tr.curData = nil\n53\t\t} else if strings.HasPrefix(line, \"data:\") {\n54\t\t\tr.curData = append(r.curData, strings.TrimSpace(line[len(\"data:\"):]))\n55\t\t} else if line == \"\" {\n56\t\t\t// Emit on blank line if we have event or data lines.\n57\t\t\tif r.curEv == nil && len(r.curData) == 0 {\n58\t\t\t\treturn\n59\t\t\t}\n60\t\t\traw := strings.Join(r.curData, \"\\n\")\n61\t\n62\t\t\t// Skip [DONE] sentinel.\n63\t\t\tif raw == \"[DONE]\" && r.curEv == nil {\n64\t\t\t\tr.curEv = nil\n65\t\t\t\tr.curData = nil\n66\t\t\t\treturn\n67\t\t\t}\n68\t\n69\t\t\tvar data any\n70\t\t\tif err := json.Unmarshal([]byte(raw), &data); err != nil {\n71\t\t\t\tdata = raw\n72\t\t\t}\n73\t\n74\t\t\tevType := \"message\"\n75\t\t\tif r.curEv != nil {\n76\t\t\t\tevType = *r.curEv\n77\t\t\t}\n78\t\t\tr.addEvent(evType, data)\n79\t\t\tr.curEv = nil\n80\t\t\tr.curData = nil\n81\t\t}\n82\t}\n83\t\n84\tfunc (r *SSEReassembler) addEvent(eventType string, data any) {\n85\t\tr.Events = append(r.Events, map[string]any{\"event\": eventType, \"data\": data})\n86\t\tr.accumulate(eventType, data)\n87\t}\n88\t\n89\tfunc (r *SSEReassembler) accumulate(eventType string, data any) {\n90\t\tm, ok := data.(map[string]any)\n91\t\tif !ok {\n92\t\t\treturn\n93\t\t}\n94\t\n95\t\tswitch eventType {\n96\t\tcase \"message_start\":\n97\t\t\tif msg, ok := m[\"message\"].(map[string]any); ok {\n98\t\t\t\tr.snap = deepCopy(msg)\n99\t\t\t}\n100\t\n101\t\tcase \"response.created\", \"response.completed\", \"response.done\":\n102\t\t\tif resp, ok := m[\"response\"].(map[string]any); ok {\n103\t\t\t\tr.snap = deepCopy(resp)\n104\t\t\t} else if eventType == \"response.completed\" || eventType == \"response.done\" {\n105\t\t\t\tr.snap = deepCopy(m)\n106\t\t\t}\n107\t\n108\t\tcase \"message\":\n109\t\t\tif _, hasChoices := m[\"choices\"]; hasChoices {\n