read_tokens\"`\n48\t\tCacheCreateTokens int64          `json:\"cache_create_tokens\"`\n49\t\tModelsUsed        map[string]int `json:\"models_used\"`\n50\t}\n51\t\n52\t// NewAnthropicTraceRecord creates a TraceRecord with auto-generated fields.\n53\tfunc NewAnthropicTraceRecord(turn, durationMs int, method, path string) *AnthropicTraceRecord {\n54\t\treturn &AnthropicTraceRecord{\n55\t\t\tTimestamp: time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n56\t\t\tRequestID: fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12),\n57\t\t\tTurn:       turn,\n58\t\t\tDurationMs: durationMs,\n59\t\t\tRequest: AnthropicRequest{\n60\t\t\t\tMethod:  method,\n61\t\t\t\tPath:    path,\n62\t\t\t\tHeaders: make(map[string]string),\n63\t\t\t},\n64\t\t\tResponse: AnthropicResponse{\n65\t\t\t\tHeaders: make(map[string]string),\n66\t\t\t},\n67\t\t}\n68\t}\n69\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\sse\\types.go"},"tool_use_id":"call_b0dc6511511d4ea0a1f94e2b","tool_response":"1\tpackage sse\n2\t\n3\t// AnthropicContentBlock represents a content block in an Anthropic API response.\n4\ttype AnthropicContentBlock struct {\n5\t\tType      string `json:\"type\"`                // \"text\", \"thinking\", \"tool_use\", \"tool_result\"\n6\t\tText      string `json:\"text,omitempty\"`       // for type=\"text\"\n7\t\tThinking  string `json:\"thinking,omitempty\"`   // for type=\"thinking\"\n8\t\tID        string `json:\"id,omitempty\"`         // for type=\"tool_use\" / \"tool_result\"\n9\t\tName      string `json:\"name,omitempty\"`       // for type=\"tool_use\"\n10\t\tInput     any    `json:\"input,omitempty\"`      // for type=\"tool_use\"\n11\t\tContent   any    `json:\"content,omitempty\"`    // for type=\"tool_result\"\n12\t\tToolUseID string `json:\"tool_use_id,omitempty\"` // for type=\"tool_result\"\n13\t\tSignature string `json:\"signature,omitempty\"`  // thinking block signature\n14\t}\n15\t\n16\t