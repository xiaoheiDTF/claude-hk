ects dir: %w\", err)\n44\t\t}\n45\t\n46\t\tvar results []PushResult\n47\t\tfor _, entry := range entries {\n48\t\t\tif !entry.IsDir() {\n49\t\t\t\tcontinue\n50\t\t\t}\n51\t\t\tslug := entry.Name()\n52\t\t\tresult, err := collectProject(baseDir, slug, filepath.Join(projectsDir, slug), opts)\n53\t\t\tif err != nil {\n54\t\t\t\tfmt.Printf(\"  ⚠ %s: %v\\n\", slug, err)\n55\t\t\t\tcontinue\n56\t\t\t}\n57\t\t\tresults = append(results, result)\n58\t\t}\n59\t\treturn results, nil\n60\t}\n61\t\n62\tfunc pushSingleProject(baseDir string, opts PushOptions) ([]PushResult, error) {\n63\t\tslug, _ := DetectLocalSlug()\n64\t\tproject := opts.Project\n65\t\tif project == \"\" {\n66\t\t\tproject = trace.DetectProjectName()\n67\t\t}\n68\t\n69\t\tclaudeDir := filepath.Join(ClaudeProjectsDir(), slug)\n70\t\n71\t\tif _, err := os.Stat(claudeDir); os.IsNotExist(err) {\n72\t\t\treturn nil, fmt.Errorf(\"no Claude session directory found for slug %q\", slug)\n73\t\t}\n74\t\n75\t\tfmt.Printf(\"Project: %s | Slug: %s | Claude dir: %s\\n\", project, slug, claudeDir)\n76\t\n77\t\tresult, err := collectProject(baseDir, slug, claudeDir, opts)\n78\t\tif err != nil {\n79\t\t\treturn nil, err\n80\t\t}\n81\t\n82\t\treturn []PushResult{result}, nil\n83\t}\n84\t\n85\tfunc collectProject(baseDir, slug, claudeDir string, opts PushOptions) (PushResult, error) {\n86\t\tsessionDir := SessionDir(baseDir, slug)\n87\t\n88\t\t// Load existing meta.\n89\t\tmeta, err := LoadMeta(sessionDir)\n90\t\tif err != nil {\n91\t\t\treturn PushResult{}, err\n92\t\t}\n93\t\n94\t\t// Find session JSONL files in Claude's project directory.\n95\t\tfiles, err := FindSessionJSONLFiles(claudeDir)\n96\t\tif err != nil {\n97\t\t\treturn PushResult{}, fmt.Errorf(\"scan sessions: %w\", err)\n98\t\t}\n99\t\n100\t\t// Build set of already-collected session IDs.\n101\t\texisting := make(map[string]bool)\n102\t\tfor _, s := range meta.Sessions {\n103\t\t\texisting[s.SessionID] = true\n104\t\t}\n105\t\n106\t\tproject := slugToProjectName(slug)\n107\t\n108\t\tvar result PushResult\n109\t\tresult.Project = project\n110\t\n111\t\tfor _, file := range files {\n112\t\t\tsessionID := strings.TrimSuffix(filepath.Base(file), \".jsonl\")\n113\t\n114\t\t\tif existing[sessionID] && !opts.Force {\n115\t\t\t\tresult.SessionsSkipped++\n116\t\t\t\tif opts.DryRun {\n117\t\t\t\t\tfmt.Printf(\"  [skip] %s (already collected)\\n\", filepath.Base(file))\n118\t\t\t\t}\n119\t\t\t\tcontinue\n120\t\t\t}\n121\t\n122\t\t\t// Parse session metadata.\n123\t\t\tentry, err := ParseSessionJSONL(file, slug)\n124\t\t\tif err != nil {\n125\t\t\t\tfmt.Printf(\"  ⚠ parse %s: %v\\n\", filepath.Base(file), err)\n126\t\t\t\tcontinue\n127\t\t\t}\n128\t\n129\t\t\tif opts.DryRun {\n130\t\t\t\tfmt.Printf(\"  [would copy] %s (%d records, %s)\\n\",\n131\t\t\t\t\tentry.File, entry.RecordCount, formatSize(entry.FileSize))\n132\t\t\t\tresult.SessionsNew++\n133\t\t\t\tresult.BytesCopied += entry.FileSize\n134\t\t\t\tcontinue\n135\t\t\t}\n136\t\n137\t\t\t// Copy file to local storage.\n138\t\t\tdst := filepath.Join(sessionDir, entry.File)\n139\t\t\tif err := copyFile(dst, file); err != nil {\n140\t\t\t\tfmt.Printf(\"  ⚠ copy %s: %v\\n\", entry.File, err)\n141\t\t\t\tcontinue\n142\t\t\t}\n143\t\n144\t\t\t// Update or add entry in meta.\n145\t\t\tif existing[sessionID] {\n146\t\t\t\tfor i, s := range meta.Sessions {\n147\t\t\t\t\tif s.SessionID == sessionID {\n148\t\t\t\t\t\tmeta.Sessions[i] = *entry\n149\t\t\t\t\t\tbreak\n150\t\t\t\t\t}\n151\t\t\t\t}\n152\t\t\t} else {\n153\t\t\t\tmeta.Sessions = append(meta.Sessions, *entry)\n154\t\t\t}\n155\t\n156\t\t\tresult.SessionsNew++\n157\t\t\tresult.BytesCopied += entry.FileSize\n158\t\t\tfmt.Printf(\"  ✓ %s (%d records, %s)\\n\", entry.File, entry.RecordCount, formatSize(entry.FileSize))\n159\t\n160\t\t\t// Copy subagents directory if present.\n161\t\t\tsubagentsDir := filepath.Join(claudeDir, sessionID, \"subagents\")\n162\t\t\tif info, err := os.Stat(subagentsDir); err == nil && info.IsDir() {\n163\t\t\t\tdstSubagents := filepath.Join(sessionDir, sessionID, \"subagents\")\n164\t\t\t\tif err := copyDir(dstSubagents, subagentsDir); err == nil {\n165\t\t\t\t\tfmt.Printf(\"    ✓ subagents/ copied\\n\")\n166\t\t\t\t}\n167\t\t\t}\n168\t\t}\n169\t\n170\t\t// Update meta project info.\n171\t\tmeta.Project = project\n172\t\tmeta.LocalSlug = slug\n173\t\tmeta.GitRemote = gitRemoteURL()\n174\t\tif cwd, err := os.Getwd(); err == nil {\n175\t\t\tmeta.LocalCwd = cwd\n176\t\t}\n177\t\n178\t\tif !opts.DryRun {\n179\t\t\tif err := SaveMeta(sessionDir, meta); err != nil {\n180\t\t\t\treturn result, fmt.Errorf(\"save meta.json: %w\", err)\n181\t\t\t}\n182\t\t}\n183\t\n184\t\treturn result, nil\n185\t}\n186\t\n187\t// slugToProjectName attempts to extract a project name from a slug.\n188\t// e.g. \"D--development-code-claude-tap\" → \"claude-tap\"\n189\tfunc slugToProjectName(slug string) string {\n190\t\t// Try to find last meaningful segment.\n191\t\t// Common patterns:\n192\t\t//   D--development-code-claude-tap → claude-tap\n193\t\t//   -home-user-projects-myapp → myapp\n194\t\tparts := strings.Split(slug, \"-\")\n195\t\tif len(parts) <= 1 {\n196\t\t\treturn slug\n197\t\t}\n198\t\t// Heuristic: take last 1-2 segments that look like a project name.\n199\t\t// Skip drive letter or empty first segment.\n200\t\tstart := 0\n201\t\tif parts[0] == \"\" {\n202\t\t\tstart = 1 // leading \"-\" (Unix path)\n203\t\t}\n204\t\tif len(parts)-start <= 2 {\n205\t\t\treturn strings.Join(parts[start:], \"-\")\n206\t\t}\n207\t\t// Take last 2 segments as project name guess.\n208\t\treturn strings.Join(parts[len(parts)-2:], \"-\")\n209\t}\n210\t\n211\t// gitRemoteURL returns the git remote origin URL for the current working directory.\n212\tfunc gitRemoteURL() string {\n213\t\tcwd, _ := os.Getwd()\n214\t\tif cwd == \"\" {\n215\t\t\treturn \"\"\n216\t\t}\n217\t\tconfigPath := filepath.Join(cwd, \".git\", \"config\")\n218\t\tdata, err := os.ReadFile(configPath)\n219\t\tif err != nil {\n220\t\t\treturn \"\"\n221\t\t}\n222\t\tcontent := string(data)\n223\t\tlines := strings.Split(content, \"\\n\")\n224\t\tinOrigin := false\n225\t\tfor _, line := range lines {\n226\t\t\ttrimmed := strings.TrimSpace(line)\n227\t\t\tif trimmed == `[remote \"origin\"]` {\n228\t\t\t\tinOrigin = true\n229\t\t\t\tcontinue\n230\t\t\t}\n231\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"url = \") {\n232\t\t\t\treturn strings.TrimPrefix(trimmed, \"url = \")\n233\t\t\t}\n234\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"[\") {\n235\t\t\t\tbreak\n236\t\t\t}\n237\t\t}\n238\t\treturn \"\"\n239\t}\n240\t\n241\tfunc formatSize(bytes int64) string {\n242\t\tconst (\n243\t\t\tKB = 1024\n244\t\t\tMB = 1024 * KB\n245\t\t)\n246\t\tswitch {\n247\t\tcase bytes >= MB:\n248\t\t\treturn fmt.Sprintf(\"%.1fMB\", float64(bytes)/float64(MB))\n249\t\tcase bytes >= KB:\n250\t\t\treturn fmt.Sprintf(\"%.1fKB\", float64(bytes)/float64(KB))\n251\t\tdefault:\n252\t\t\treturn fmt.Sprintf(\"%dB\", bytes)\n253\t\t}\n254\t}\n255\t\n256\t// copyDir recursively copies a directory.\n257\tfunc copyDir(dst, src string) error {\n258\t\treturn filepath.Walk(src, func(path string, info os.FileInfo, err error) error {\n259\t\t\tif err != nil {\n260\t\t\t\treturn err\n261\t\t\t}\n262\t\t\trel, _ := filepath.Rel(src, path)\n263\t\t\tdstPath := filepath.Join(dst, rel)\n264\t\n265\t\t\tif info.IsDir() {\n266\t\t\t\treturn os.MkdirAll(dstPath, 0o755)\n267\t\t\t}\n268\t\t\treturn copyFile(dstPath, path)\n269\t\t})\n270\t}\n271\t"}]}
