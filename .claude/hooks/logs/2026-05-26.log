claude-tap-plus tool claude --sandbox fix-auth --name \"auth-fix-session\"","+claude-tap-plus tool claude --name \"auth-fix-session\""," "," # 详细输出","-claude-tap-plus tool claude --sandbox fix-auth --verbose","+claude-tap-plus tool claude --verbose"," "," # 调试模式","-claude-tap-plus tool claude --sandbox fix-auth --debug","-claude-tap-plus tool claude --sandbox fix-auth --debug \"api,hooks\"","+claude-tap-plus tool claude --debug","+claude-tap-plus tool claude --debug \"api,hooks\""," "," # 调试日志写入文件","-claude-tap-plus tool claude --sandbox fix-auth --debug-file ./debug.log","+claude-tap-plus tool claude --debug-file ./debug.log"," "," # 添加额外可访问目录","-claude-tap-plus tool claude --sandbox fix-auth --add-dir ../shared-lib","+claude-tap-plus tool claude --add-dir ../shared-lib"," "," # IDE 集成","-claude-tap-plus tool claude --sandbox fix-auth --ide","+claude-tap-plus tool claude --ide"," "," # Chrome 集成","-claude-tap-plus tool claude --sandbox fix-auth --chrome","+claude-tap-plus tool claude --chrome"," "," # 禁用 slash commands","-claude-tap-plus tool claude --sandbox fix-auth --disable-slash-commands","+claude-tap-plus tool claude --disable-slash-commands"," "," # Remote Control 模式","-claude-tap-plus tool claude --sandbox fix-auth --remote-control my-session","+claude-tap-plus tool claude --remote-control my-session"," "," # JSON Schema 约束输出（仅 --print）","-claude-tap-plus tool claude --sandbox fix-auth -p \"列出文件\" --json-schema '{\"type\":\"object\",\"properties\":{\"files\":{\"type\":\"array\"}}}'","+claude-tap-plus tool claude -p \"列出文件\" --json-schema '{\"type\":\"object\",\"properties\":{\"files\":{\"type\":\"array\"}}}'"," "," # 设置文件来源","-claude-tap-plus tool claude --sandbox fix-auth --file file_abc:doc.txt","+claude-tap-plus tool claude --file file_abc:doc.txt"," "," # 设置来源","-claude-tap-plus tool claude --sandbox fix-auth --setting-sources user,project","+claude-tap-plus tool claude --setting-sources user,project"," ```"," "," **claude-tap-plus 扩展参数（与 Claude 原生参数共存）：**"]},{"oldStart":717,"oldLines":7,"newStart":717,"newLines":7,"lines":[" **示例流程：**"," "," ```text","-输入: claude-tap-plus tool claude --sandbox fix-auth -p \"hello\" --model sonnet","+输入: claude-tap-plus tool claude -p \"hello\" --model sonnet"," "," 解析:","   tap-plus 提取: --sandbox fix-auth"]}],"userModified":false,"replaceAll":true},"tool_use_id":"call_7930a2cab3b34ae3b08383b1","duration_ms":9}
