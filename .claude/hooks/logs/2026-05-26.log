: nil,\n231\t\t\t\t\t},\n232\t\t\t\t},\n233\t\t\t\t\"content\": []any{map[string]any{\"type\": \"text\", \"text\": \"\"}},\n234\t\t\t}\n235\t\t\tif role := strVal(fieldStr(delta, \"role\")); role == \"\" {\n236\t\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)[\"role\"] = \"assistant\"\n237\t\t\t}\n238\t\t}\n239\t\n240\t\tmsg := r.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n241\t\ttextBlock := r.chatTextBlock()\n242\t\n243\t\tif role := strVal(fieldStr(delta, \"role\")); role != \"\" {\n244\t\t\tmsg[\"role\"] = role\n245\t\t}\n246\t\tif rc := strVal(fieldStr(delta, \"reasoning_content\")); rc != \"\" {\n247\t\t\tmsg[\"reasoning_content\"] = strVal(msg[\"reasoning_content\"]) + rc\n248\t\t\tr.mirrorReasoning(strVal(msg[\"reasoning_content\"]))\n249\t\t}\n250\t\tif c := strVal(fieldStr(delta, \"content\")); c != \"\" {\n251\t\t\tmsg[\"content\"] = strVal(msg[\"content\"]) + c\n252\t\t\ttextBlock[\"text\"] = strVal(textBlock[\"text\"]) + c\n253\t\t}\n254\t\n255\t\t// Tool calls.\n256\t\tfor _, tcRaw := range sliceField(delta, \"tool_calls\") {\n257\t\t\ttcDelta, _ := tcRaw.(map[string]any)\n258\t\t\tif tcDelta == nil {\n259\t\t\t\tcontinue\n260\t\t\t}\n261\t\t\tidx := int(float64Val(tcDelta[\"index\"]))\n262\t\t\ttoolCalls, _ := msg[\"tool_calls\"].([]any)\n263\t\t\tif toolCalls == nil {\n264\t\t\t\ttoolCalls = []any{}\n265\t\t\t}\n266\t\t\tfor len(toolCalls) <= idx {\n267\t\t\t\ttoolCalls = append(toolCalls, map[string]any{\n268\t\t\t\t\t\"id\":   \"\",\n269\t\t\t\t\t\"type\": \"function\",\n270\t\t\t\t\t\"function\": map[string]any{\n271\t\t\t\t\t\t\"name\":      \"\",\n272\t\t\t\t\t\t\"arguments\": \"\",\n273\t\t\t\t\t},\n274\t\t\t\t})\n275\t\t\t}\n276\t\t\texisting := toolCalls[idx].(map[string]any)\n277\t\t\tif id := strVal(tcDelta[\"id\"]); id != \"\" {\n278\t\t\t\texisting[\"id\"] = id\n279\t\t\t}\n280\t\t\tif t := strVal(tcDelta[\"type\"]); t != \"\" {\n281\t\t\t\texisting[\"type\"] = t\n282\t\t\t}\n283\t\t\tif fnDelta, ok := tcDelta[\"function\"].(map[string]any); ok {\n284\t\t\t\tfn, _ := existing[\"function\"].(map[string]any)\n285\t\t\t\tif fn == nil {\n286\t\t\t\t\tfn = map[string]any{\"name\": \"\", \"arguments\": \"\"}\n287\t\t\t\t}\n288\t\t\t\tif n := strVal(fnDelta[\"name\"]); n != \"\" {\n289\t\t\t\t\tfn[\"name\"] = strVal(fn[\"name\"]) + n\n290\t\t\t\t}\n291\t\t\t\tif a := strVal(fnDelta[\"arguments\"]); a != \"\" {\n292\t\t\t\t\tfn[\"arguments\"] = strVal(fn[\"arguments\"]) + a\n293\t\t\t\t}\n294\t\t\t\texisting[\"function\"] = fn\n295\t\t\t}\n296\t\t\ttoolCalls[idx] = existing\n297\t\t\tmsg[\"tool_calls\"] = toolCalls\n298\t\t\tr.mirrorToolCall(idx, existing)\n299\t\t}\n300\t\n301\t\tif finishReason != nil && finishReason != \"\" {\n302\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"finish_reason\"] = finishReason\n303\t\t}\n304\t\n305\t\tif u, ok := rawUsage.(map[string]any); ok {\n306\t\t\tr.mergeChatUsage(u)\n307\t\t}\n308\t\tif choiceUsage != nil {\n309\t\t\tr.mergeChatUsage(choiceUsage)\n310\t\t}\n311\t}\n312\t\n313\tfunc (r *SSEReassembler) chatTextBlock() map[string]any {\n314\t\tcontent := r.snap[\"content\"].([]any)\n315\t\tfor _, b := range content {\n316\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"text\" {\n317\t\t\t\treturn block\n318\t\t\t}\n319\t\t}\n320\t\tblock := map[string]any{\"type\": \"text\", \"text\": \"\"}\n321\t\tr.snap[\"content\"] = append(content, block)\n322\t\treturn block\n323\t}\n324\t\n325\tfunc (r *SSEReassembler) mirrorReasoning(reasoning string) {\n326\t\tcontent := r.snap[\"content\"].([]any)\n327\t\tfor _, b := range content {\n328\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n329\t\t\t\tblock[\"thinking\"] = reasoning\n330\t\t\t\treturn\n331\t\t\t}\n332\t\t}\n333\t\tblock := map[string]any{\"type\": \"thinking\", \"thinking\": reasoning}\n334\t\tr.snap[\"content\"] = append([]any{block}, content...)\n335\t}\n336\t\n337\tfunc (r *SSEReassembler) mirrorToolCall(idx int, tc map[string]any) {\n338\t\tcontent := r.snap[\"content\"].([]any)\n339\t\t// Count thinking block for offset.\n340\t\toffset := 1\n341\t\tfor _, b := range content {\n342\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n343\t\t\t\toffset = 2\n344\t\t\t\tbreak\n345\t\t\t}\n346\t\t}\n347\t\ttarget := idx + offset\n348\t\tfor len(content) <= target {\n349\t\t\tcontent = append(content, map[string]any{\"type\": \"tool_use\", \"id\": \"\", \"name\": \"\", \"input\": map[string]any{}})\n350\t\t}\n351\t\tblock := content[target].(map[string]any)\n352\t\tif id := strVal(tc[\"id\"]); id != \"\" {\n353\t\t\tblock[\"id\"] = id\n354\t\t}\n355\t\tif fn, ok := tc[\"function\"].(map[string]any); ok {\n356\t\t\tif n := strVal(fn[\"name\"]); n != \"\" {\n357\t\t\t\tblock[\"name\"] = n\n358\t\t\t}\n359\t\t\tif args := strVal(fn[\"arguments\"]); args != \"\" {\n360\t\t\t\tvar parsed any\n361\t\t\t\tif json.Unmarshal([]byte(args), &parsed) == nil {\n362\t\t\t\t\tblock[\"input\"] = parsed\n363\t\t\t\t}\n364\t\t\t}\n365\t\t}\n366\t\tr.snap[\"content\"] = content\n367\t}\n368\t\n369\tfunc (r *SSEReassembler) mergeChatUsage(u map[string]any) {\n370\t\tr.snap[\"usage\"] = usage.NormalizeUsage(u)\n371\t}\n372\t\n373\t// --- helpers ---\n374\t\n375\tfunc deepCopy(m map[string]any) map[string]any {\n376\t\tif m == nil {\n377\t\t\treturn nil\n378\t\t}\n379\t\tdata, _ := json.Marshal(m)\n380\t\tresult := make(map[string]any)\n381\t\t_ = json.Unmarshal(data, &result)\n382\t\treturn result\n383\t}\n384\t\n385\tfunc float64Val(v any) float64 {\n386\t\tswitch n := v.(type) {\n387\t\tcase float64:\n388\t\t\treturn n\n389\t\tcase int:\n390\t\t\treturn float64(n)\n391\t\tcase int64:\n392\t\t\treturn float64(n)\n393\t\t}\n394\t\treturn 0\n395\t}\n396\t\n397\tfunc strVal(v any) string {\n398\t\tif v == nil {\n399\t\t\treturn \"\"\n400\t\t}\n401\t\tif s, ok := v.(string); ok {\n402\t\t\treturn s\n403\t\t}\n404\t\treturn fmt.Sprintf(\"%v\",