sion_id\\\":\\\"3cc83fcb-...\\\"}\" }\n35\t    }\n36\t  },\n37\t  \"response\": {\n38\t    \"status\": 200,\n39\t    \"headers\": { ... },\n40\t    \"body\": {\n41\t      \"id\": \"msg_01XGQ...\",\n42\t      \"type\": \"message\",\n43\t      \"role\": \"assistant\",\n44\t      \"model\": \"claude-sonnet-4-6\",\n45\t      \"content\": [\n46\t        { \"type\": \"text\", \"text\": \"好的，我来帮你...\" },\n47\t        { \"type\": \"tool_use\", \"id\": \"tu_2\", \"name\": \"Write\", \"input\": { \"file_path\": \"/tmp/test.py\", \"content\": \"def hello(): ...\" } },\n48\t        { \"type\": \"thinking\", \"thinking\": \"用户要求...\" }\n49\t      ],\n50\t      \"stop_reason\": \"end_turn\",\n51\t      \"usage\": {\n52\t        \"input_tokens\": 1200,\n53\t        \"output_tokens\": 800,\n54\t        \"cache_read_input_tokens\": 500,\n55\t        \"cache_creation_input_tokens\": 200\n56\t      }\n57\t    }\n58\t  }\n59\t}\n60\t```\n61\t\n62\t**问题**：这个记录太大了。一次流式调用的 `request.body.messages` 可能包含几十轮对话历史，`response.body.content` 里可能有大量的 thinking/text/tool_use 块。直接存原始数据会导致：\n63\t- 单条记录体积大（几十 KB 到几百 KB）\n64\t- 重复存储（每轮都带完整的 messages 历史）\n65\t- 查询困难（想找\"用户说了什么\"，要遍历 messages 数组）\n66\t\n67\t---\n68\t\n69\t## 二、存储方案：分层存储\n70\t\n71\t将一次 API 调用拆成两层：\n72\t\n73\t### 第一层：调用索引（轻量，每条 < 1KB）\n74\t\n75\t只记录元数据，不含实际内容。用于快速查询和统计。\n76\t\n77\t```json\n78\t{\n79\t  \"type\": \"call_index\",\n80\t  \"timestamp\": \"2026-05-26T14:20:24.123456Z\",\n81\t  \"call_id\": \"call_834927165038\",\n82\t  \"session_id\": \"3cc83fcb-2849-4beb-9df0-6c638ab60566\",\n83\t  \"turn\": 3,\n84\t  \"duration_ms\": 4500,\n85\t  \"model\": \"claude-sonnet-4-6\",\n86\t  \"stop_reason\": \"end_turn\",\n87\t  \"is_streaming\": true,\n88\t  \"tokens\": {\n89\t    \"input\": 1200,\n90\t    \"output\": 800,\n91\t    \"cache_read\": 500,\n92\t    \"cache_create\": 200\n93\t  },\n94\t  \"content_summary\": [\n95\t    { \"type\": \"text\", \"chars\": 150 },\n96\t    { \"type\": \"tool_use\", \"name\": \"Write\", \"target\": \"/tmp/test.py\" },\n97\t    { \"type\": \"thinking\", \"chars\": 2000 }\n98\t  ]\n99\t}\n100\t```\n101\t\n102\t### 第二层：完整内容（按需加载）\n103\t\n104\t存储原始 request/response body，但拆分存储：\n105\t\n106\t```\n107\tcall_834927165038/\n108\t├── request_body.json    ← 完整请求体（含 messages 历史）\n109\t├── response_body.json   ← 完整响应体（含所有 content blocks）\n110\t└── sse_events.jsonl     ← 原始 SSE 事件流（可选，调试用）\n111\t```\n112\t\n113\t---\n114\t\n115\t## 三、目录结构\n116\t\n117\t参考 Claude Code 本地存储（`~/.claude/projects/{slug}/{session}.jsonl`），后端存储采用类似层级：\n118\t\n119\t```\n120\tstorage/\n121\t├── machines/\n122\t│   └── {machine_id}/\n123\t│       └── info.json                    ← 机器信息（hostname, os, 首次注册时间）\n124\t│\n125\t├── projects/\n126\t│   └── {project_hash}/\n127\t│       ├── info.json                    ← 项目信息（cwd, git remote, 名称）\n128\t│       └── sessions/\n129\t│           └── {session_id}/\n130\t│               ├── register.json        ← SessionStart 注册信息\n131\t│               ├── close.json           ← SessionEnd 注销信息（会话结束时写入）\n132\t│               ├── index.jsonl          ← 调用索引，每行一条（第一层）\n133\t│               └── calls/\n134\t│                   └── {call_id}/\n135\t│                       ├── request_body.json\n136\t│                       └── response_body.json\n137\t```\n138\t\n139\t### 各文件内容\n140\t\n141\t**`info.json`（项目信息）**\n142\t```json\n143\t{\n144\t  \"name\": \"claude-hk\",\n145\t  \"cwd\": \"D:\\\\CodeDevelopment\\\\CodeProject\\\\claude-hk\",\n146\t  \"git_remote\": \"https://github.com/user/claude-hk.git\",\n147\t  \"first_seen\": \"2026-05-26T14:20:24Z\",\n148\t  \"last_seen\": \"2026-05-26T15:30:00Z\",\n149\t  \"session_count\": 12\n150\t}\n151\t```\n152\t\n153\t**`register.json`（会话注册）**\n154\t```json\n155\t{\n156\t  \"session_id\": \"3cc83fcb-2849-4beb-9df0-6c638ab60566\",\n157\t  \"machine_id\": \"DESKTOP-XXX\",\n158\t  \"model\": \"GLM-5.1\",\n159\t  \"source\": \"startup\",\n160\t  \"transcript_path\": \"C:\\\\Users\\\\Administrator\\\\.claude\\\\projects\\\\...\",\n161\t  \"registered_at\": \"2026-05-26T14:20:24Z\"\n162\t}\n163\t```\n164\t\n165\t**`close.json`（会话注销）**\n166\t```json\n167\t{\n168\t  \"session_id\": \"3cc83fcb-2849-4beb-9df0-6c638ab60566\",\n169\t  \"reason\": \"prompt_input_exit\",\n170\t  \"closed_at\": \"2026-05-26T15:30:00Z\",\n171\t  \"total_calls\": 28,\n172\t  \"total_tokens\": {\n173\t    \"input\": 45000,\n174\t    \"output\": 12000\n175\t  }\n176\t}\n177\t```\n178\t\n179\t**`index.jsonl`（调用索引，追加写入）**\n180\t```\n181\t{\"type\":\"call_index\",\"timestamp\":\"...\",\"call_id\":\"call_001\",\"session_id\":\"...\",\"turn\":1,\"duration_ms\":3200,\"model\":\"...\",\"tokens\":{...},\"content_summary\":[...]}\n182\t{\"type\":\"call_index\",\"timestamp\":\"...\",\"call_id\":\"call_002\",\"session_id\":\"...\",\"turn\":2,\"duration_ms\":5100,\"model\":\"...\",\"tokens\":{...},\"content_summary\":[...]}\n183\t```\n184\t\n185\t**`calls/{call_id}/request_body.json`**（完整请求体）\n186\t```json\n187\t{\n188\t  \"model\": \"claude-sonnet-4-6\",\n189\t  \"max_tokens\": 16384,\n190\t  \"stream\": true,\n191\t  \"system\": [...],\n192\t  \"messages\": [...],\n193\t  \"tools\": [...]\n194\t}\n195\t```\n196\t\n197\t**`calls/{call_id}/response_body.json`**（完整响应体）\n198\t```json\n199\t{\n200\t  \"id\": \"msg_01XGQ...\",\n201\t  \"role\": \"assistant\",\n202\t  \"content\": [...],\n203\t  \"usage\": {...}\n204\t}\n205\t```\n206\t\n207\t---\n208\t\n209\t## 四、存储流程（代理内部处理）\n210\t\n211\t全部在 `reverse.go` 的 `buildRecord()` 之后完成，不需要额外 API：\n212\t\n213\t```\n214\t代理拦截到一次 API 调用\n215\t  │\n216\t  ├─ 提取 session_id（已有 extractSessionID）\n217\t  ├─ 生成 call_id（用 request_id 即可）\n218\t  │\n219\t  ├─ 写入 index.jsonl（追加一行调用索引）\n220\t  │   └─ 只写元数据：turn, model, tokens, duration, content_summary\n221\t  │\n222\t  ├─ 写入 calls/{call_id}/request_body.json\n223\t  │   └─ 只存 request.body（不含 headers，headers 索引里已有摘要）\n224\t  │\n225\t  └─ 写入 calls/{call_id}/response_body.json\n226\t      └─ 只存 response.body（不含 status/headers，索引里已有）\n227\t```\n228\t\n229\t### 具体改造点\n230\t\n231\t**在 `reverse.go` 的 `serveHTTP()` 中**，`buildRecord()` 之后：\n232\t\n233\t```go\n234\t// 现有：写 JSONL trace\n235\tp.writer.Write(record)\n236\t\n237\t// 新增：写分层存储\n238\tp.store.WriteCall(sessionID, callID, record)\n239\t```\n240\t\n241\t**新增 `internal/store/` 模块**：\n242\t\n243\t```go\n244\ttype CallStore struct {\n245\t    baseDir string  // 存储根目录\n246\t    mu      sync.Mutex\n247\t}\n248\t\n249\tfunc (s *CallStore) WriteCall(sessionID, callID string, record map[string]any) error {\n250\t    // 1. 确保 session 目录存在\n251\t    // 2. 追加一行到 index.jsonl（轻量索引）\n252\t    // 3. 写 request_body.json\n253\t    // 4. 写 response_body.json\n254\t}\n255\t```\n256\t\n257\t---\n258\t\n259\t## 五、查询场景\n260\t\n261\t| 想查什么 | 查哪里 | 怎么查 |\n262\t|----------|--------|--------|\n263\t| 某个会话调了几次 API | `index.jsonl` | 统计行数 |\n264\t| 某个会话的 token 总量 | `index.jsonl` | 累加 tokens 字段 |\n265\t| 某次调用用了什么工具 | `index.jsonl` 的 content_summary | 过滤 type=tool_use |\n266\t| 某次调用的完整对话 | `calls/{call_id}/` | 读 request_body + response_body |\n267\t| 用户的原始输入 | `calls/{call_id}/request_body.json` | 读 messages 数组最后一项 |\n268\t| AI 的完整回复 | `calls/{call_id}/response_body.json` | 读 content 数组 |\n269\t| 某个会话是否还活跃 | `close.json` 是否存在 | 存在=已结束，不存在=活跃 |\n270\t\n271\t---\n272\t\n273\t## 六、与现有 JSONL trace 的关系\n274\t\n275\t| | 现有 trace | 新增分层存储 |\n276\t|---|---|---|\n277\t| 格式 | 单一 JSONL，每条完整记录 | 索引 JSONL + 独立 JSON 文件 |\n278\t| 大小 | 大（每条含完整 messages） | 索引小，内容按需加载 |\n279\t| 用途 | 本地调试、退出汇总 | 后端持久化、跨机器查询 |\n280\t| 位置 | `.traces/{project}/` | 后端 `storage/` 或本地配置目录 |\n281\t\n282\t两者不冲突：trace 继续写本地用于调试，分层存储写后端用于持久化和 Issue 等业务查询。\n283\t"}]}
