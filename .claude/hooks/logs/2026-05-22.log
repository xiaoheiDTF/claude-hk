\n# 查看\ngh issue list --state open\ngh issue view <编号>\n\n# 关闭\ngh issue close <编号>\n```\n","numLines":90,"startLine":1,"totalLines":90}},"tool_use_id":"call_0f156b9f49dc488a897bf630","duration_ms":9}
