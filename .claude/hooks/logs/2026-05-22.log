CTIVE_FILE\"\n69\t\n70\t  lock_release\n71\t}\n72\t\n73\t# 列出所有 skill 名（去重）\n74\tactive_skills() {\n75\t  [ -f \"$ACTIVE_FILE\" ] || return\n76\t  cut -d'|' -f2 \"$ACTIVE_FILE\" | sort -u\n77\t}\n78\t\n79\t# 列出全部\n80\tactive_list() {\n81\t  _ensure_active\n82\t  cat \"$ACTIVE_FILE\"\n83\t}\n84\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\skills\\lock.sh"},"tool_use_id":"call_81ab234e7e0649579820c152","tool_response":"1\t#!/bin/bash\n2\t# 文件锁模块 — 使用 mkdir 原子操作（跨平台兼容）\n3\t# 用法:\n4\t#   source lock.sh\n5\t#   lock_acquire \"/path/to/lockdir\"\n6\t#   ... 临界区操作 ...\n7\t#   lock_release \"/path/to/lockdir\"\n8\t\n9\t_LOCK_DIR=\"\"\n10\t\n11\t# 获取锁（阻塞等待，带超时）\n12\t# $1 = 锁目录路径\n13\t# $2 = 超时秒数（默认 10）\n14\tlock_acquire() {\n15\t  local lock_dir=\"$1\"\n16\t  local timeout=\"${2:-10}\"\n17\t  local elapsed=0\n18\t\n19\t  while ! mkdir \"$lock_dir\" 2>/dev/null; do\n20\t    elapsed=$((elapsed + 1))\n21\t    if [ \"$elapsed\" -ge \"$timeout\" ]; then\n22\t      # 超时：检查锁是否是僵尸（超过 60 秒）\n23\t      if [ -d \"$lock_dir\" ]; then\n24\t        local lock_age\n25\t        lock_age=$(($(date +%s) - $(stat -c %Y \"$lock_dir\" 2>/dev/null || echo 0)))\n26\t        if [ \"$lock_age\" -gt 60 ]; then\n27\t          rm -rf \"$lock_dir\" 2>/dev/null\n28\t          continue\n29\t        fi\n30\t      fi\n31\t      return 1\n32\t    fi\n33\t    sleep 1\n34\t  done\n35\t\n36\t  _LOCK_DIR=\"$lock_dir\"\n37\t  return 0\n38\t}\n39\t\n40\t# 释放锁\n41\tlock_release() {\n42\t  [ -n \"$_LOCK_DIR\" ] && rm -rf \"$_LOCK_DIR\" 2>/dev/null\n43\t  _LOCK_DIR=\"\"\n44\t}\n45\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\skills\\enforce_boundary.sh"},"tool_use_id":"call_c2e466a2e3c846aa86764a10","tool_response":"1\t#!/bin/bash\n2\t# enforce_boundary.sh — A 层：工具级白名单拦截\n3\t# 读取 .active 中当前 session 的 skill，解析 SKILL.md frontmatter allowed-tools，\n4\t# 比对当前 tool_name，不在白名单则 deny\n5\t\n6\tenforce_boundary() {\n7\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n8\t  local active_file=\"$skills_dir/.active\"\n9\t\n10\t  # 无 .active 或为空 → 放行\n11\t  [ -s \"$active_file\" ] || return 0\n12\t\n13\t  # 获取当前 session_id\n14\t  local sid\n15\t  sid=$(json_get '.session_id')\n16\t  [ -z \"$sid\" ] && return 0\n17\t\n18\t  # 查找当前 session 激活的 skill\n19\t  source \"$skills_dir/active.sh\"\n20\t  local skill_name\n21\t  skill_name=$(active_get \"$sid\")\n22\t  [ -z \"$skill_name\" ] && return 0\n23\t\n24\t  # 解析 SKILL.md frontmatter 中的 allowed-tools\n25\t  local skill_md=\"$skills_dir/$skill_name/SKILL.md\"\n26\t  if [ ! -f \"$skill_md\" ]; then\n27\t    log \"WARN\" \"enforce_boundary: SKILL.md not found for $skill_name, allowing\"\n28\t    return 0\n29\t  fi\n30\t\n31\t  # 提取 allowed-tools 列表（frontmatter 中 \"  - ToolName\" 格式的行）\n32\t  local allowed=\"\"\n33\t  local in_frontmatter=0\n34\t  while IFS= read -r line; do\n35\t    if [ \"$line\" = \"---\" ]; then\n36\t      if [ \"$in_frontmatter\" -eq 0 ]; then\n37\t        in_frontmatter=1\n38\t        continue\n39\t      else\n40\t        break\n41\t      fi\n42\t    fi\n43\t    if [ \"$in_frontmatter\" -eq 1 ]; then\n44\t      if echo \"$line\" | grep -qE '^\\s+-\\s+\\S+'; then\n45\t        local tool\n46\t        tool=$(echo \"$line\" | sed -E 's/^\\s+-\\s+//')\n47\t        allowed=\"$allowed $tool\"\n48\t      fi\n49\t    fi\n50\t  done < \"$skill_md\"\n51\t\n52\t  # 空白名单 → 无约束，放行\n53\t  if [ -z \"$allowed\" ]; then\n54\t    log \"WARN\" \"enforce_boundary: no allowed-tools for $skill_name, allowing\"\n55\t    return 0\n56\t  fi\n57\t\n58\t  # 比对当前 tool_name\n59\t  local current_tool\n60\t  current_tool=$(json_get '.tool_name')\n61\t  [ -z \"$current_tool\" ] && return 0\n62\t\n63\t  # 检查是否在白名单中\n64\t  for t in $allowed; do\n65\t    if [ \"$t\" = \"$current_tool\" ]; then\n66\t      log \"DEBUG\" \"enforce_boundary: $current_tool allowed for $skill_name\"\n67\t      return 0\n68\t    fi\n69\t  done\n70\t\n71\t  # 不在白名单 → deny\n72\t  log \"WARN\" \"enforce_boundary: DENY $current_tool for $skill_name (allowed:$allowed)\"\n73\t  hook_output 2 \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"permissionDecision\\\":\\\"deny\\\",\\\"permissionDecisionReason\\\":\\\"${current_tool} 不在 ${skill_name} 的 allowed-tools 白名单中\\\"}}\"\n74\t}\n75\t\n76\tenforce_boundary\n77\t"}]}
