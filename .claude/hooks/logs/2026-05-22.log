on=$PYTHON_CMD\"\n46\tlog \"INFO\" \"Input: $HOOK_INPUT\"\n47\t\n48\thook_output() {\n49\t  local exit_code=\"${1:-0}\"\n50\t  local json=\"${2:-{}}\"\n51\t  log \"INFO\" \"Output (exit=$exit_code): $json\"\n52\t  echo \"$json\"\n53\t  exit \"$exit_code\"\n54\t}\n55\t\n56\t# Skill 感知分发：根据 .active 中的 session_id 匹配活跃 skill，\n57\t# 调用对应 skill 目录下的生命周期脚本。\n58\t# 用法: dispatch_to_skill \"05\" [额外参数...]\n59\t# 返回: 0=成功或无活跃 skill，非 0=skill 脚本执行失败\n60\t# stdout: skill 脚本的输出（如有）\n61\tdispatch_to_skill() {\n62\t  local event_num=\"$1\"\n63\t  shift\n64\t\n65\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n66\t  local active_file=\"$skills_dir/.active\"\n67\t\n68\t  # 无 .active 或为空 → 跳过\n69\t  [ -s \"$active_file\" ] || return 0\n70\t\n71\t  # 获取当前 session_id\n72\t  local sid\n73\t  sid=$(json_get '.session_id')\n74\t  [ -z \"$sid\" ] && return 0\n75\t\n76\t  # 查找当前 session 激活的 skill\n77\t  source \"$skills_dir/active.sh\"\n78\t  local skill_name\n79\t  skill_name=$(active_get \"$sid\")\n80\t  [ -z \"$skill_name\" ] && return 0\n81\t\n82\t  # 按事件编号映射脚本名\n83\t  local script_name\n84\t  case \"$event_num\" in\n85\t    02) script_name=\"02Setup\" ;;\n86\t    04) script_name=\"04UserPromptExpansion\" ;;\n87\t    05) script_name=\"05PreToolUse\" ;;\n88\t    06) script_name=\"06PermissionRequest\" ;;\n89\t    07) script_name=\"07PermissionDenied\" ;;\n90\t    08) script_name=\"08PostToolUse\" ;;\n91\t    09) script_name=\"09PostToolUseFailure\" ;;\n92\t    10) script_name=\"10PostToolBatch\" ;;\n93\t    11) script_name=\"11Notification\" ;;\n94\t    12) script_name=\"12SubagentStart\" ;;\n95\t    13) script_name=\"13SubagentStop\" ;;\n96\t    14) script_name=\"14TaskCreated\" ;;\n97\t    15) script_name=\"15TaskCompleted\" ;;\n98\t    17) script_name=\"17StopFailure\" ;;\n99\t    18) script_name=\"18TeammateIdle\" ;;\n100\t    19) script_name=\"19InstructionsLoaded\" ;;\n101\t    20) script_name=\"20ConfigChange\" ;;\n102\t    21) script_name=\"21CwdChanged\" ;;\n103\t    22) script_name=\"22FileChanged\" ;;\n104\t    23) script_name=\"23WorktreeCreate\" ;;\n105\t    24) script_name=\"24WorktreeRemove\" ;;\n106\t    25) script_name=\"25PreCompact\" ;;\n107\t    26) script_name=\"26PostCompact\" ;;\n108\t    27) script_name=\"27Elicitation\" ;;\n109\t    28) script_name=\"28ElicitationResult\" ;;\n110\t    29) script_name=\"29SessionEnd\" ;;\n111\t    *) return 0 ;;\n112\t  esac\n113\t\n114\t  local script_path=\"$skills_dir/$skill_name/scripts/$script_name.sh\"\n115\t  [ -f \"$script_path\" ] || return 0\n116\t\n117\t  log \"INFO\" \"Dispatching to skill=$skill_name script=$script_name.sh\"\n118\t  bash \"$script_path\" \"$@\" 2>>\"$LOG_FILE\"\n119\t}\n120\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\01-session-start\\base.sh"},"tool_use_id":"call_228c3ff563844fefb2036790","tool_response":"1\t#!/bin/bash\n2\t# 01-session-start: 会话开始或恢复时触发 (每个会话一次)\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\tsource_type=$(json_get '.source')\n8\tlog \"INFO\" \"source=$source_type\"\n9\t\n10\t# 首次运行 → 触发统一初始化\n11\t[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/.initialized\" ] && bash \"$CLAUDE_PROJECT_DIR/.claude/init.sh\"\n12\t\n13\t# ---- 每次会话确保基础环境 ----\n14\t\n15\t# 1. UTF-8 编码\n16\tensure_utf8() {\n17\t  local os_type\n18\t  case \"$(uname -s)\" in\n19\t    Linux*)   os_type=\"linux\" ;;\n20\t    Darwin*)  os_type=\"macos\" ;;\n21\t    MINGW*|MSYS*|CYGWIN*) os_type=\"windows\" ;;\n22\t    *)        os_type=\"unknown\" ;;\n23\t  esac\n24\t\n25\t  export LANG=\"${LANG:-en_US.UTF-8}\"\n26\t  export LC_ALL=\"${LC_ALL:-en_US.UTF-8}\"\n27\t\n28\t  if [ \"$os_type\" = \"windows\" ]; then\n29\t    chcp.com 65001 > /dev/null 2>&1\n30\t    log \"INFO\" \"Windows code page set to 65001\"\n31\t  fi\n32\t\n33\t  log \"INFO\" \"UTF-8 ensured (OS=$os_type, LANG=$LANG)\"\n34\t}\n35\t\n36\t# 2. Python 可用性（巡检 + 自动修复）\n37\tensure_python_check() {\n38\t  source \"$CLAUDE_PROJECT_DIR/.claude/scripts/ensure_python.sh\"\n39\t  local result\n40\t  result=$(ensure_python)\n41\t  if [ -n \"$result\" ]; then\n42\t    log \"INFO\" \"Python 已就绪: $result\"\n43\t  else\n44\t    log \"WARN\" \"Python 不可用，部分功能受限\"\n45\t  fi\n46\t}\n47\t\n48\t# 3. 目录完整性\n49\tensure_dirs() {\n50\t  source \"$CLAUDE_PROJECT_DIR/.claude/scripts/ensure_dirs.sh\"\n51\t  local missing\n52\t  missing=$(check_dirs 2>&1)\n53\t  if [ \"$missing\" = \"ALL OK\" ]; then\n54\t    log \"INFO\" \"目录检查通过\"\n55\t  else\n56\t    log \"WARN\" \"目录缺失，重新创建: $missing\"\n57\t    ensure_all_dirs \"$LOG_FILE\" > /dev/null\n58\t  fi\n59\t}\n60\t\n61\tensure_utf8\n62\tensure_python_check\n63\tensure_dirs\n64\t\n65\t# 4. Skill 级巡检\n66\tensure_skill_checks() {\n67\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n68\t  [ -d \"$skills_dir\" ] || return\n69\t  for check_script in \"$skills_dir\"/*/scripts/init_check.sh; do\n70\t    [ -f \"$check_script\" ] || continue\n71\t    local skill_name\n72\t    skill_name=$(basename \"$(dirname \"$(dirname \"$check_script\")\")\")\n73\t    if bash \"$check_script\" >> \"$LOG_FILE\" 2>&1; then\n74\t      log \"INFO\" \"Skill check OK: $skill_name\"\n75\t    else\n76\t      log \"WARN\" \"Skill check failed: $skill_name (non-blocking)\"\n77\t    fi\n78\t  done\n79\t}\n80\t\n81\tensure_skill_checks\n82\t\n83\thook_output 0 '{}'\n84\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\03-user-prompt-submit\\base.sh"},"tool_use_id":"call_d0d2d5243b85448b89ec5b9d","tool_response":"1\t#!/bin/bash\n2\t# 03-user-prompt-submit: 用户提交提示后、Claude 处理之前触发 (每轮一次)\n3\t# 退出 2 可阻止提示处理并从上下文中删除提示\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tprompt=$(json_get '.prompt')\n9\tsession_id=$(json_get '.session_id')\n10\t\n11\tlog \"INFO\" \"prompt=$prompt session=$session_id\"\n12\t\n13\t# skill 注入：检测 /xxx 格式调用（首字符必须是 /）\n14\tOUTPUT=$(bash \"$SCRIPT_DIR/skill-inject.sh\" \"$prompt\" \"$session_id\" 2>/dev/null)\n15\tif [ -n \"$OUTPUT\" ]; then\n16\t  # 第一行：skill_name|args\n17\t  META=$(echo \"$OUTPUT\" | head -1)\n18\t  # 第二行起：CONTEXT（完整 hook JSON）\n19\t  CONTEXT=$(echo \"$OUTPUT\" | tail -n +2)\n20\t\n21\t  SKILL_NAME=$(echo \"$META\" | cut -d'|' -f1)\n22\t  SKILL_ARGS=$(echo \"$META\" | cut -d'|' -f2)\n23\t\n24\t  log \"INFO\" \"Skill matched: $SKILL_NAME | session: $session_id | args: $SKILL_ARGS\"\n25\t  hook_output 0 \"$CONTEXT\"\n26\tfi\n27\t\n28\thook_output 0 '{}'\n29\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\03-user-prompt-submit\\skill-inject.sh"},"tool_use_id":"call_aea2d7d2caf14c39aeb21381","tool_response":"1\t#!/bin/bash\n2\t# skill-inject: 从用户 prompt 提取 skill 名，匹配注册表后注入上下文\n3\t# 被 03-user-prompt-submit/base.sh 调用\n4\t# 参数: $1 = 用户 prompt, $2 = session_id（来自 hook 输入 JSON）\n5\t#\n6\t# 匹配规则:\n7\t#   - 首字符必须是 /\n8\t#   - skill 名到第一个空格结束\n9\t#   - /xxx 后面的内容作为参数传递\n10\t\n11\tPROMPT=\"$1\"\n12\tSESSION_ID=\"$2\"\n13\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n14\tSKILLS_DIR=\"$PROJECT_DIR/.claude/skills\"\n15\tREGISTRY=\"$SKILLS_DIR/registry.conf\"\n16\t\n17\t# 首字符不是 / → 不是 skill 调用\n18\t[[ \"$PROMPT\" != /* ]] && exit 0\n19\t\n20\t# 提取 skill 名：去掉开头的 /，取到第一个空格\n21\tPROMPT_TRIMMED=\"${PROMPT#/}\"\n22\tSKILL_NAME=\"${PROMPT_TRIMMED%% *}\"\n23\t\n24\t# 提取参数：skill 名之后的内容\n25\tSKILL_ARGS=\"\"\n26\tif [[ \"$PROMPT_TRIMMED\" == *\" \"* ]]; then\n27\t  SKILL_ARGS=\"${PROMPT_TRIMMED#* }\"\n28\tfi\n29\t\n30\t[ -z \"$SKILL_NAME\" ] && exit 0\n31\t\n32\t# 注册表匹配（纯 ASCII）\n33\tMATCH=$(awk -v name=\"$SKILL_NAME\" '$1 == name {print $1}' \"$REGISTRY\" 2>/dev/null)\n34\t[ -z \"$MATCH\" ] && exit 0\n35\t\n36\t# 查找并运行 03UserPromptSubmit.sh\n37\tON_LOAD=\"$SKILLS_DIR/$MATCH/scripts/03UserPromptSubmit.sh\"\n38\t[ ! -f \"$ON_LOAD\" ] && exit 0\n39\t\n40\t# 执行获取上下文\n41\tCONTEXT=$(bash \"$ON_LOAD\" 2>/dev/null)\n42\t[ -z \"$CONTEXT\" ] && exit 0\n43\t\n44\t# 写入 .active（使用真实 session_id）\n45\tsource \"$SKILLS_DIR/active.sh\"\n46\tactive_add \"$SESSION_ID\" \"$MATCH\" 2>/dev/null\n47\t\n48\t# 输出：第一行元数据，第二行起 CONTEXT\n49\techo \"$MATCH|$SKILL_ARGS\"\n50\techo \"$CONTEXT\"\n51\t"}]}
