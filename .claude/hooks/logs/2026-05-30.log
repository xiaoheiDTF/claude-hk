[2026-05-30 19:29:49] [INFO] [PostToolBatch] Input: {"session_id":"9bf82fe9-e376-4adb-95bb-300f36566835","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\9bf82fe9-e376-4adb-95bb-300f36566835.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"plan","effort":{"level":"xhigh"},"hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\trace\\writer.go"},"tool_use_id":"call_dda45750b167475eb6edd74a","tool_response":"1\tpackage trace\n2\t\n3\timport (\n4\t\t\"bufio\"\n5\t\t\"crypto/rand\"\n6\t\t\"encoding/hex\"\n7\t\t\"encoding/json\"\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"os/user\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\t\"time\"\n15\t\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/usage\"\n18\t)\n19\t\n20\t// TraceWriter 负责将 API 调用记录以 JSONL 格式追加写入追踪文件，\n21\t// 并在写入过程中累计 Token 用量统计。\n22\t//\n23\t// 使用方式：\n24\t//\n25\t//\ttw, err := trace.NewTraceWriter(path)\n26\t//\ttw.Write(record)\n27\t//\tsummary := tw.Summary()\n28\t//\ttw.Close()\n29\ttype TraceWriter struct {\n30\t\tmu           sync.Mutex     // 保护并发写入和统计更新\n31\t\tfile         *os.File       // 底层追踪文件句柄\n32\t\twriter       *bufio.Writer  // 缓冲写入器，提升写入性能\n33\t\tcount        int            // 已写入记录数（API 调用次数）\n34\t\tinputTokens  int64          // 累计输入 Token\n35\t\toutputTokens int64          // 累计输出 Token\n36\t\tcacheRead    int64          // 累计缓存读取 Token\n37\t\tcacheCreate  int64          // 累计缓存创建 Token\n38\t\tmodelsUsed   map[string]int // 各模型使用次数统计\n39\t\tpath         string         // 追踪文件路径\n40\t\tsessionID    string         // 从首条记录提取的 session_id\n41\t}\n42\t\n43\t// NewTraceWriter 创建 TraceWriter 实例，按需创建输出目录并打开追踪文件。\n44\t//\n45\t// 参数 path 为追踪文件的完整路径。函数会自动创建路径中缺失的目录，\n46\t// 并以追加模式打开文件（如果不存在则创建）。\n47\tfunc NewTraceWriter(path string) (*TraceWriter, error) {\n48\t\tdir := filepath.Dir(path)\n49\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n50\t\t\treturn nil, fmt.Errorf(\"create trace dir: %w\", err)\n51\t\t}\n52\t\tlogger.Debug(\"trace\", \"ensured directory: %s\", dir)\n53\t\n54\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)\n55\t\tif err != nil {\n56\t\t\treturn nil, fmt.Errorf(\"open trace file: %w\", err)\n57\t\t}\n58\t\n59\t\tlogger.Info(\"trace\", \"trace writer opened: %s\", path)\n60\t\n61\t\treturn &TraceWriter{\n62\t\t\tfile:       f,\n63\t\t\twriter:     bufio.NewWriter(f),\n64\t\t\tmodelsUsed: make(map[string]int),\n65\t\t\tpath:       path,\n66\t\t}, nil\n67\t}\n68\t\n69\t// Write 将单条记录序列化为 JSON 行写入文件，并立即刷新缓冲区，\n70\t// 同时更新内部统计计数。\n71\t//\n72\t// 记录格式为 JSON Lines（每行一条独立 JSON，以换行符分隔），\n73\t// 便于后续按行读取和解析。\n74\tfunc (w *TraceWriter) Write(record map[string]any) error {\n75\t\tw.mu.Lock()\n76\t\tdefer w.mu.Unlock()\n77\t\n78\t\tdata, err := json.Marshal(record)\n79\t\tif err != nil {\n80\t\t\treturn fmt.Errorf(\"marshal trace record: %w\", err)\n81\t\t}\n82\t\n83\t\tif _, err := w.writer.Write(data); err != nil {\n84\t\t\treturn err\n85\t\t}\n86\t\tif _, err := w.writer.WriteString(\"\\n\"); err != nil {\n87\t\t\treturn err\n88\t\t}\n89\t\tif err := w.writer.Flush(); err != nil {\n90\t\t\treturn err\n91\t\t}\n92\t\n93\t\tlogger.Debug(\"trace\", \"record #%d written: %d bytes\", w.count+1, len(data))\n94\t\n95\t\tw.count++\n96\t\tw.updateStats(record)\n97\t\n98\t\t// 从首条记录提取 session_id\n99\t\tif w.count == 1 {\n100\t\t\tif sid, ok := record[\"session_id\"].(string); ok {\n101\t\t\t\tw.sessionID = sid\n102\t\t\t}\n103\t\t}\n104\t\treturn nil\n105\t}\n106\t\n107\t// Close 刷新缓冲区并关闭底层文件。\n108\t// 应在追踪会话结束时调用，以确保所有数据落盘。\n109\tfunc (w *TraceWriter) Close() error {\n110\t\tw.mu.Lock()\n111\t\tdefer w.mu.Unlock()\n112\t\tlogger.Info(\"trace\", \"trace writer closed: %d records written\", w.count)\n113\t\tif w.writer != nil {\n114\t\t\t_ = w.writer.Flush()\n115\t\t}\n116\t\tif w.file != nil {\n117\t\t\treturn w.file.Close()\n118\t\t}\n119\t\treturn nil\n120\t}\n121\t\n122\t// Path 返回追踪文件的完整路径。\n123\tfunc (w *TraceWriter) Path() string {\n124\t\treturn w.path\n125\t}\n126\t\n127\t// SessionID 返回从追踪记录中提取的 session_id。\n128\t// 如果尚无记录或首条记录不含 session_id，返回空字符串。\n129\tfunc (w *TraceWriter) SessionID() string {\n130\t\treturn w.sessionID\n131\t}\n132\t\n133\t// Summary 返回当前追踪会话的聚合统计信息。\n134\t//\n135\t// 返回的 map 包含以下字段：\n136\t//   - api_calls:            API 调用总次数\n137\t//   - input_tokens:         累计输入 Token\n138\t//   - output_tokens:        累计输出 Token\n139\t//   - cache_read_tokens:    累计缓存读取 Token\n140\t//   - cache_create_tokens:  累计缓存创建 Token\n141\t//   - models_used:          各模型调用次数 map[string]int\n142\tfunc (w *TraceWriter) Summary() map[string]any {\n143\t\tw.mu.Lock()\n144\t\tdefer w.mu.Unlock()\n145\t\n146\t\treturn map[string]any{\n147\t\t\t\"api_calls\":           w.count,\n148\t\t\t\"input_tokens\":        w.inputTokens,\n149\t\t\t\"output_tokens\":       w.outputTokens,\n150\t\t\t\"cache_read_tokens\":   w.cacheRead,\n151\t\t\t\"cache_create_tokens\": w.cacheCreate,\n152\t\t\t\"models_used\":         w.modelsUsed,\n153\t\t}\n154\t}\n155\t\n156\t// updateStats 从单条记录中提取模型信息和 Token 用量，更新累计统计。\n157\t//\n158\t// 提取逻辑：\n159\t//  1. 从 request.body.model 获取模型名称，归入 modelsUsed 计数\n160\t//  2. 从 response.body.usage 或 body 顶层提取 usage 数据\n161\t//  3. 使用 usage.NormalizeUsage 标准化后累加到各 Token 计数器\n162\tfunc (w *TraceWriter) updateStats(record map[string]any) {\n163\t\t// 从请求体中提取模型名称\n164\t\treqBody, _ := record[\"request\"].(map[string]any)\n165\t\tif reqBody != nil {\n166\t\t\tif body, ok := reqBody[\"body\"].(map[string]any); ok {\n167\t\t\t\tmodel, _ := body[\"model\"].(string)\n168\t\t\t\tif model == \"\" {\n169\t\t\t\t\tmodel = \"unknown\"\n170\t\t\t\t}\n171\t\t\t\tw.modelsUsed[model]++\n172\t\t\t}\n173\t\t}\n174\t\n175\t\t// 从响应体中提取 Token 用量\n176\t\trespBody, _ := record[\"response\"].(map[string]any)\n177\t\tif respBody == nil {\n178\t\t\treturn\n179\t\t}\n180\t\tbody, _ := respBody[\"body\"].(map[string]any)\n181\t\tif body == nil {\n182\t\t\treturn\n183\t\t}\n184\t\n185\t\trawUsage, _ := body[\"usage\"].(map[string]any)\n186\t\tif rawUsage == nil {\n187\t\t\t// 某些情况下 usage 直接位于 body 顶层\n188\t\t\trawUsage = body\n189\t\t}\n190\t\n191\t\tnorm := usage.NormalizeUsage(rawUsage)\n192\t\tw.inputTokens += norm[\"input_tokens\"]\n193\t\tw.outputTokens += norm[\"output_tokens\"]\n194\t\tw.cacheRead += norm[\"cache_read_input_tokens\"]\n195\t\tw.cacheCreate += norm[\"cache_creation_input_tokens\"]\n196\t}\n197\t\n198\t// DefaultTraceDir 返回默认的追踪文件存储目录，位于用户主目录下。\n199\t//\n200\t// 默认路径：$HOME/.claude-tap-plus/.traces\n201\t// 如果无法获取用户主目录，则返回相对路径 \".claude-tap-plus/.traces\"。\n202\tfunc DefaultTraceDir() string {\n203\t\thome, err := os.UserHomeDir()\n204\t\tif err != nil {\n205\t\t\treturn \".claude-tap-plus/.traces\"\n206\t\t}\n207\t\tdir := filepath.Join(home, \".claude-tap-plus\", \".traces\")\n208\t\tlogger.Debug(\"trace\", \"default trace dir: %s\", dir)\n209\t\treturn dir\n210\t}\n211\t\n212\t// DetectProjectName 返回当前工作目录对应的项目名称。\n213\t//\n214\t// 优先级：\n215\t//  1. 从 git remote origin URL 提取仓库名（如 my-project）\n216\t//  2. 当前工作目录的目录名作为兜底\n217\tfunc DetectProjectName() string {\n218\t\tcwd, _ := os.Getwd()\n219\t\t// 优先尝试从 git 远程地址获取仓库名\n220\t\tif cwd != \"\" {\n221\t\t\trepo := gitRemoteRepoName(cwd)\n222\t\t\tif repo != \"\" {\n223\t\t\t\tlogger.Debug(\"trace\", \"detected project name: %s (from git)\", repo)\n224\t\t\t\treturn repo\n225\t\t\t}\n226\t\t}\n227\t\t// 兜底：使用当前目录名\n228\t\tproject := filepath.Base(cwd)\n229\t\tif project == \"\" || project == \".\" {\n230\t\t\tproject = \"default\"\n231\t\t}\n232\t\tlogger.Debug(\"trace\", \"detected project name: %s (from cwd)\", project)\n233\t\treturn project\n234\t}\n235\t\n236\t// NewTracePath 根据当前机器和项目信息生成追踪文件路径（fallback 用）。\n237\t//\n238\t// 路径格式：baseDir/{machine_id}/{project_slug}/{date}/{time}/pending.jsonl\n239\t// 使用 pending 作为文件名标记，表示 session_id 尚未确定。\n240\t// 当 _internal/trace-init 提供真实 session_id 后，由调用方负责重命名。\n241\tfunc NewTracePath(baseDir string) string {\n242\t\tmachineID := MachineID()\n243\t\tproject := DetectProjectName()\n244\t\n245\t\tnow := time.Now()\n246\t\tdate := now.Format(\"2006-01-02\")\n247\t\tt := now.Format(\"150405\")\n248\t\n249\t\tpath := filepath.Join(baseDir, machineID, project, date, t, \"pending.jsonl\")\n250\t\tlogger.Debug(\"trace\", \"trace path: %s\", path)\n251\t\treturn path\n252\t}\n253\t\n254\t// gitRemoteRepoName 从 .git/config 文件中提取 remote origin 对应的仓库名。\n255\t//\n256\t// 示例：\n257\t//\n258\t//\t\"https://github.com/user/my-project.git\" → \"my-project\"\n259\t//\n260\t// 直接读取配置文件以避免依赖 git 命令。\n261\tfunc gitRemoteRepoName(dir string) string {\n262\t\tconfigPath := filepath.Join(dir, \".git\", \"config\")\n263\t\tdata, err := os.ReadFile(configPath)\n264\t\tif err != nil {\n265\t\t\treturn \"\"\n266\t\t}\n267\t\tcontent := string(data)\n268\t\t// 定位 [remote \"origin\"] 区域并提取 URL\n269\t\tlines := strings.Split(content, \"\\n\")\n270\t\tinOrigin := false\n271\t\tfor _, line := range lines {\n272\t\t\ttrimmed := strings.TrimSpace(line)\n273\t\t\tif trimmed == `[remote \"origin\"]` {\n274\t\t\t\tinOrigin = true\n275\t\t\t\tcontinue\n276\t\t\t}\n277\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"url = \") {\n278\t\t\t\turl := strings.TrimPrefix(trimmed, \"url = \")\n279\t\t\t\t// 提取 URL 最后一段并去掉 .git 后缀\n280\t\t\t\tbase := filepath.Base(url)\n281\t\t\t\tbase = strings.TrimSuffix(base, \".git\")\n282\t\t\t\treturn base\n283\t\t\t}\n284\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"[\") {\n285\t\t\t\tbreak // 已进入下一个配置区域\n286\t\t\t}\n287\t\t}\n288\t\treturn \"\"\n289\t}\n290\t\n291\t// randomHex 生成 n 个随机字节并以十六进制字符串返回（共 2*n 个字符）。\n292\tfunc randomHex(n int) string {\n293\t\tb := make([]byte, n)\n294\t\t_, _ = rand.Read(b)\n295\t\treturn hex.EncodeToString(b)\n296\t}\n297\t\n298\t// MachineID 返回 \"用户名@主机名\" 格式的机器标识符。\n299\t// 用于区分不同机器的追踪数据。\n300\tfunc MachineID() string {\n301\t\thostname, _ := os.Hostname()\n302\t\tif hostname == \"\" {\n303\t\t\thostname = \"unknown\"\n304\t\t}\n305\t\tusername := \"unknown\"\n306\t\tif u, err := user.Current(); err == nil && u.Username != \"\" {\n307\t\t\tusername = u.Username\n308\t\t}\n309\t\treturn username + \"@\" + hostname\n310\t}\n311\t\n312\t// ExtractProjectSlug 从 Claude Code 的会话转录文件路径中提取项目标识（slug）。\n313\t//\n314\t// 输入示例：\n315\t//\n316\t//\t\"C:\\Users\\Admin\\.claude\\projects\\D--xxx-yyy\\uuid.jsonl\"\n317\t//\n318\t// 输出：\n319\t//\n320\t//\t\"D--xxx-yyy\"\n321\t//\n322\t// 如果路径不符合预期的 .claude/projects/ 模式，则返回空字符串。\n323\tfunc ExtractProjectSlug(transcriptPath string) string {\n324\t\tif transcriptPath == \"\" {\n325\t\t\treturn \"\"\n326\t\t}\n327\t\t// 统一路径分隔符为 /\n328\t\tnormalized := filepath.ToSlash(transcriptPath)\n329\t\n330\t\t// 定位 \".claude/projects/\" 标记段\n331\t\tmarker := \".claude/projects/\"\n332\t\tidx := strings.Index(normalized, marker)\n333\t\tif idx < 0 {\n334\t\t\treturn \"\"\n335\t\t}\n336\t\n337\t\t// 提取标记后的第一段目录名\n338\t\trest := normalized[idx+len(marker):]\n339\t\tif slashIdx := strings.Index(rest, \"/\"); slashIdx >= 0 {\n340\t\t\trest = rest[:slashIdx]\n341\t\t}\n342\t\n343\t\tif rest == \"\" {\n344\t\t\treturn \"\"\n345\t\t}\n346\t\treturn rest\n347\t}\n348\t\n349\t// NewSessionTracePath 基于会话信息构建追踪文件路径。\n350\t//\n351\t// 路径格式：baseDir/{machineID}/{projectSlug}/{date}/{time}/{sessionID}.jsonl\n352\t//\n353\t// 参数说明：\n354\t//   - baseDir:     基础追踪目录\n355\t//   - machineID:   机器标识（如 username@hostname）\n356\t//   - projectSlug: 项目标识（如 D--xxx-yyy）\n357\t//   - sessionID:   会话唯一标识\n358\tfunc NewSessionTracePath(baseDir, machineID, projectSlug, sessionID string) string {\n359\t\tnow := time.Now()\n360\t\tdate := now.Format(\"2006-01-02\")\n361\t\tt := now.Format(\"150405\")\n362\t\tpath := filepath.Join(baseDir, machineID, projectSlug, date, t, sessionID+\".jsonl\")\n363\t\tlogger.Debug(\"trace\", \"session trace path: %s\", path)\n364\t\treturn path\n365\t}\n366\t"}]}
