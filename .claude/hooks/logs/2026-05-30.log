RL=$url\" > \"$BACKEND_CONF\"\n  BACKEND_URL=\"\"\n  source \"$BACKEND_SH\"\n\n  CLAUDE_SESSION_ID=\"sess_b6_2_e2e\"\n\n  # 1. Claim issue\n  local claim_result\n  claim_result=$(_call_backend \"/api/issue/claim\" '{\n    \"repo_full_name\":\"test/b6_2\",\n    \"issue_number\":500,\n    \"session_id\":\"sess_b6_2_e2e\"\n  }')\n  if [ $? -ne 0 ]; then\n    echo \"FAIL: claim failed\"\n    return 1\n  fi\n\n  # 2. update_issue_status fixing（模拟 003-5）\n  local output\n  output=$(update_issue_status 500 \"fixing\" 2>&1)\n  if [ $? -ne 0 ]; then\n    echo \"FAIL: fixing update returned non-zero: $output\"\n    return 1\n  fi\n\n  # 3. 验证状态\n  local check\n  check=$(_call_backend \"/api/issue/check\" '{\"repo_full_name\":\"test/b6_2\",\"issue_numbers\":[500]}')\n  local status\n  status=$(echo \"$check\" | jq -r '.issues[0].status')\n  if [ \"$status\" != \"fixing\" ]; then\n    echo \"FAIL: expected fixing, got $status\"\n    return 1\n  fi\n\n  # 4. ready-for-pr（模拟 003-6）\n  update_issue_status 500 \"ready-for-pr\" 2>/dev/null\n  check=$(_call_backend \"/api/issue/check\" '{\"repo_full_name\":\"test/b6_2\",\"issue_numbers\":[500]}')\n  status=$(echo \"$check\" | jq -r '.issues[0].status')\n  if [ \"$status\" != \"ready-for-pr\" ]; then\n    echo \"FAIL: expected ready-for-pr, got $status\"\n    return 1\n  fi\n\n  # 5. pr-created（模拟 003-7）\n  update_issue_status 500 \"pr-created\" 2>/dev/null\n  check=$(_call_backend \"/api/issue/check\" '{\"repo_full_name\":\"test/b6_2\",\"issue_numbers\":[500]}')\n  status=$(echo \"$check\" | jq -r '.issues[0].status')\n  if [ \"$status\" != \"pr-created\" ]; then\n    echo \"FAIL: expected pr-created, got $status\"\n    return 1\n  fi\n\n  # 6. testing（模拟 003-8）\n  update_issue_status 500 \"testing\" 2>/dev/null\n  check=$(_call_backend \"/api/issue/check\" '{\"repo_full_name\":\"test/b6_2\",\"issue_numbers\":[500]}')\n  status=$(echo \"$check\" | jq -r '.issues[0].status')\n  if [ \"$status\" != \"testing\" ]; then\n    echo \"FAIL: expected testing, got $status\"\n    return 1\n  fi\n\n  # 7. reviewing（模拟 003-9 开始）\n  update_issue_status 500 \"reviewing\" 2>/dev/null\n  check=$(_call_backend \"/api/issue/check\" '{\"repo_full_name\":\"test/b6_2\",\"issue_numbers\":[500]}')\n  status=$(echo \"$check\" | jq -r '.issues[0].status')\n  if [ \"$status\" != \"reviewing\" ]; then\n    echo \"FAIL: expected reviewing, got $status\"\n    return 1\n  fi\n\n  # 8. merged（模拟 003-9 merge）\n  update_issue_status 500 \"merged\" 2>/dev/null\n  check=$(_call_backend \"/api/issue/check\" '{\"repo_full_name\":\"test/b6_2\",\"issue_numbers\":[500]}')\n  status=$(echo \"$check\" | jq -r '.issues[0].status')\n  if [ \"$status\" != \"merged\" ]; then\n    echo \"FAIL: expected merged, got $status\"\n    return 1\n  fi\n\n  # Cleanup\n  _call_backend \"/api/issue/release-session\" '{\"session_id\":\"sess_b6_2_e2e\"}' > /dev/null 2>&1\n\n  echo \"OK: full skill flow claim→fixing→ready-for-pr→pr-created→testing→reviewing→merged\"\n  return 0\n}\n\n# --- Test 7: 后端可用时 reject 流程 ---\n\ntest_backend_up_reject_flow() {\n  local url=\"${1:-}\"\n  if [ -z \"$url\" ]; then\n    echo \"SKIP: no backend URL\"\n    return 0\n  fi\n\n  echo \"BACKEND_URL=$url\" > \"$BACKEND_CONF\"\n  BACKEND_URL=\"\"\n  source \"$BACKEND_SH\"\n  CLAUDE_SESSION_ID=\"sess_b6_2_reject\"\n\n  # Claim + advance to reviewing\n  _call_backend \"/api/issue/claim\" '{\"repo_full_name\":\"test/b6_2\",\"issue_number\":501,\"session_id\":\"sess_b6_2_reject\"}' > /dev/null\n  for s in \"fixing\" \"ready-for-pr\" \"pr-created\" \"testing\" \"reviewing\"; do\n    update_issue_status 501 \"$s\" 2>/dev/null\n  done\n\n  # Reject\n  update_issue_status 501 \"rejected\" 2>/dev/null\n  local check\n  check=$(_call_backend \"/api/issue/check\" '{\"repo_full_name\":\"test/b6_2\",\"issue_numbers\":[501]}')\n  local status\n  status=$(echo \"$check\" | jq -r '.issues[0].status')\n  if [ \"$status\" != \"rejected\" ]; then\n    echo \"FAIL: expected rejected, got $status\"\n    return 1\n  fi\n\n  echo \"OK: reject flow works\"\n  return 0\n}\n\n# --- Main ---\n\necho \"=== B6-2: 003-5 ~ 003-9 技能改造 — Shell 集成测试 ===\"\necho \"Project: $PROJECT_DIR\"\necho \"\"\n\nrun_test \"backend_down_silent_skip\" test_backend_down_silent_skip\nrun_test \"no_conf_silent_skip\" test_no_conf_silent_skip\nrun_test \"session_id_passed_correctly\" test_session_id_passed_correctly\nrun_test \"all_skill_status_labels_mapped\" test_all_skill_status_labels_mapped\nrun_test \"sync_github_label_merged_calls_close\" test_sync_github_label_merged_calls_close\n\nBACKEND_URL_ARG=\"${1:-}\"\nif [ -n \"$BACKEND_URL_ARG\" ]; then\n  if command -v jq &>/dev/null; then\n    run_test \"backend_up_status_flow\" test_backend_up_status_flow \"$BACKEND_URL_ARG\"\n    run_test \"backend_up_reject_flow\" test_backend_up_reject_flow \"$BACKEND_URL_ARG\"\n  else\n    echo \"\"\n    echo -e \"${YELLOW}NOTE: Skipping backend-up tests (jq not found).${NC}\"\n  fi\nelse\n  echo \"\"\n  echo -e \"${YELLOW}NOTE: Skipping backend-up tests. To run:${NC}\"\n  echo \"  1. Start backend: go run ./cmd/claude-tap backend --port 18080 --db /tmp/b6_2_test.db\"\n  echo \"  2. Run: bash $0 http://127.0.0.1:18080\"\nfi\n\necho \"\"\necho \"================================\"\necho \"Results: $PASS/$TOTAL passed, $FAIL failed\"\necho \"================================\"\n\n[ $FAIL -eq 0 ] || exit 1\n","numLines":203,"startLine":140,"totalLines":342}},"tool_use_id":"call_3b343f48bd004ce88ee9eeaa","duration_ms":8}
