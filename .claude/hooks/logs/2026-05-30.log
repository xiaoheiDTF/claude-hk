ss_test\",\"status\":\"fixing\"}`)\n1262\t\t\tenv.post(t, \"/api/issue/status\",\n1263\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"ready-for-pr\"}`)\n1264\t\t\tenv.post(t, \"/api/issue/status\",\n1265\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"pr-created\"}`)\n1266\t\n1267\t\t\tresp := env.post(t, \"/api/issue/status\",\n1268\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"testing\"}`)\n1269\t\t\tvar result struct {\n1270\t\t\t\tSuccess        bool   `json:\"success\"`\n1271\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1272\t\t\t\tNewStatus      string `json:\"new_status\"`\n1273\t\t\t}\n1274\t\t\treadJSON(t, resp, &result)\n1275\t\t\tif !result.Success {\n1276\t\t\t\tt.Fatal(\"testing update failed\")\n1277\t\t\t}\n1278\t\t\tif result.PreviousStatus != \"pr-created\" {\n1279\t\t\t\tt.Errorf(\"expected previous=pr-created, got %s\", result.PreviousStatus)\n1280\t\t\t}\n1281\t\n1282\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{50})\n1283\t\t\tif s[50] != \"testing\" {\n1284\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[50])\n1285\t\t\t}\n1286\t\t})\n1287\t}\n1288\t\n1289\t// --- D6: Issue Status Update → reviewing/merged/rejected tests ---\n1290\t// 验收标准：\n1291\t//   - testing → reviewing 状态更新成功\n1292\t//   - reviewing → merged 终态更新成功\n1293\t//   - reviewing → rejected 状态更新成功\n1294\t//   - merged 不被 session end 释放\n1295\t//   - rejected 不被 session end 释放\n1296\t//   - 完整流程：idle → ... → testing → reviewing → merged/rejected\n1297\t\n1298\tfunc TestUpdateStatus_Review(t *testing.T) {\n1299\t\tt.Run(\"testing_to_reviewing\", func(t *testing.T) {\n1300\t\t\tenv := setupTest(t)\n1301\t\t\tdb := env.store.DB()\n1302\t\t\tseedIssue(db, \"test/repo\", 10, \"testing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1303\t\n1304\t\t\tresp := env.post(t, \"/api/issue/status\",\n1305\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"reviewing\"}`)\n1306\t\n1307\t\t\tvar result struct {\n1308\t\t\t\tSuccess        bool   `json:\"success\"`\n1309\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1310\t\t\t\tNewStatus      string `json:\"new_status\"`\n1311\t\t\t}\n1312\t\t\treadJSON(t, resp, &result)\n1313\t\n1314\t\t\tif !result.Success {\n1315\t\t\t\tt.Fatalf(\"expected success=true, got error: %s\", result.NewStatus)\n1316\t\t\t}\n1317\t\t\tif result.PreviousStatus != \"testing\" {\n1318\t\t\t\tt.Errorf(\"expected previous=testing, got %s\", result.PreviousStatus)\n1319\t\t\t}\n1320\t\t\tif result.NewStatus != \"reviewing\" {\n1321\t\t\t\tt.Errorf(\"expected new=reviewing, got %s\", result.NewStatus)\n1322\t\t\t}\n1323\t\t})\n1324\t\n1325\t\tt.Run(\"reviewing_to_merged\", func(t *testing.T) {\n1326\t\t\tenv := setupTest(t)\n1327\t\t\tdb := env.store.DB()\n1328\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1329\t\n1330\t\t\tresp := env.post(t, \"/api/issue/status\",\n1331\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"merged\"}`)\n1332\t\n1333\t\t\tvar result struct {\n1334\t\t\t\tSuccess        bool   `json:\"success\"`\n1335\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1336\t\t\t\tNewStatus      string `json:\"new_status\"`\n1337\t\t\t}\n1338\t\t\treadJSON(t, resp, &result)\n1339\t\n1340\t\t\tif !result.Success {\n1341\t\t\t\tt.Fatal(\"expected success=true\")\n1342\t\t\t}\n1343\t\t\tif result.PreviousStatus != \"reviewing\" {\n1344\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1345\t\t\t}\n1346\t\t\tif result.NewStatus != \"merged\" {\n1347\t\t\t\tt.Errorf(\"expected new=merged, got %s\", result.NewStatus)\n1348\t\t\t}\n1349\t\t})\n1350\t\n1351\t\tt.Run(\"reviewing_to_rejected\", func(t *testing.T) {\n1352\t\t\tenv := setupTest(t)\n1353\t\t\tdb := env.store.DB()\n1354\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1355\t\n1356\t\t\tresp := env.post(t, \"/api/issue/status\",\n1357\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"rejected\"}`)\n1358\t\n1359\t\t\tvar result struct {\n1360\t\t\t\tSuccess        bool   `json:\"success\"`\n1361\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1362\t\t\t\tNewStatus      string `json:\"new_status\"`\n1363\t\t\t}\n1364\t\t\treadJSON(t, resp, &result)\n1365\t\n1366\t\t\tif !result.Success {\n1367\t\t\t\tt.Fatal(\"expected success=true\")\n1368\t\t\t}\n1369\t\t\tif result.PreviousStatus != \"reviewing\" {\n1370\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1371\t\t\t}\n1372\t\t\tif result.NewStatus != \"rejected\" {\n1373\t\t\t\tt.Errorf(\"expected new=rejected, got %s\", result.NewStatus)\n1374\t\t\t}\n1375\t\t})\n1376\t\n1377\t\tt.Run(\"non_owner_cannot_review\", func(t *testing.T) {\n1378\t\t\tenv := setupTest(t)\n1379\t\t\tdb := env.store.DB()\n1380\t\t\tseedIssue(db, \"test/repo\", 10, \"testing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1381\t\n1382\t\t\tresp := env.post(t, \"/api/issue/status\",\n1383\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"reviewing\"}`)\n1384\t\n1385\t\t\tvar result struct {\n1386\t\t\t\tSuccess bool   `json:\"success\"`\n1387\t\t\t\tError   string `json:\"error\"`\n1388\t\t\t}\n1389\t\t\treadJSON(t, resp, &result)\n1390\t\n1391\t\t\tif result.Success {\n1392\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1393\t\t\t}\n1394\t\t\tif result.Error != \"not_owner\" {\n1395\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1396\t\t\t}\n1397\t\t})\n1398\t\n1399\t\tt.Run(\"full_merge_flow\", func(t *testing.T) {\n1400\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr → pr-created → testing → reviewing → merged\n1401\t\t\tenv := setupTest(t)\n1402\t\n1403\t\t\tenv.post(t, \"/api/issue/check\",\n1404\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[60]}`)\n1405\t\n1406\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 60, \"sess_merge\")\n1407\t\t\tif code != http.StatusOK || !ok {\n1408\t\t\t\tt.Fatalf(\"claim failed\")\n1409\t\t\t}\n1410\t\n1411\t\t\tfor _, status := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n1412\t\t\t\tresp := env.post(t, \"/api/issue/status\",\n1413\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"test/repo\",\"issue_number\":60,\"session_id\":\"sess_merge\",\"status\":\"%s\"}`, status))\n1414\t\t\t\tvar r struct{ Success bool `json:\"success\"` }\n1415\t\t\t\treadJSON(t, resp, &r)\n1416\t\t\t\tif !r.Success {\n1417\t\t\t\t\tt.Fatalf(\"update to %s failed\", status)\n1418\t\t\t\t}\n1419\t\t\t}\n1420\t\n1421\t\t\t// merged\n1422\t\t\tresp := env.post(t, \"/api/issue/status\",\n1423\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":60,\"session_id\":\"sess_merge\",\"status\":\"merged\"}`)\n1424\t\t\tvar result struct {\n1425\t\t\t\tSuccess        bool   `json:\"success\"`\n1426\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1427\t\t\t\tNewStatus      string `json:\"new_status\"`\n1428\t\t\t}\n1429\t\t\treadJSON(t, resp, &result)\n1430\t\t\tif !result.Success {\n1431\t\t\t\tt.Fatal(\"merged update failed\")\n1432\t\t\t}\n1433\t\t\tif result.PreviousStatus != \"reviewing\" {\n1434\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1435\t\t\t}\n1436\t\n1437\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{60})\n1438\t\t\tif s[60] != \"merged\" {\n1439\t\t\t\tt.Fatalf(\"expected merged, got %s\", s[60])\n1440\t\t\t}\n1441\t\t})\n1442\t\n1443\t\tt.Run(\"full_reject_flow\", func(t *testing.T) {\n1444\t\t\t// 端到端：idle → ... → testing → reviewing → rejected\n1445\t\t\tenv := setupTest(t)\n1446\t\n1447\t\t\tenv.post(t, \"/api/issue/check\",\n1448\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[70]}`)\n1449\t\n1450\t\t\tclaimIssue(t, env, \"test/repo\", 70, \"sess_reject\")\n1451\t\t\tfor _, status := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n1452\t\t\t\tenv.post(t, \"/api/issue/status\",\n1453\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"test/repo\",\"issue_number\":70,\"session_id\":\"sess_reject\",\"status\":\"%s\"}`, status))\n1454\t\t\t}\n1455\t\n1456\t\t\tresp := env.post(t, \"/api/issue/status\",\n1457\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":70,\"session_id\":\"sess_reject\",\"status\":\"rejected\"}`)\n1458\t\t\tvar result struct {\n1459\t\t\t\tSuccess        bool   `json:\"success\"`\n1460\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1461\t\t\t\tNewStatus      string `json:\"new_status\"`\n1462\t\t\t}\n1463\t\t\treadJSON(t, resp, &result)\n1464\t\t\tif !result.Success {\n1465\t\t\t\tt.Fatal(\"rejected update failed\")\n1466\t\t\t}\n1467\t\t\tif result.PreviousStatus != \"reviewing\" {\n1468\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1469\t\t\t}\n1470\t\n1471\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{70})\n1472\t\t\tif s[70] != \"rejected\" {\n1473\t\t\t\tt.Fatalf(\"expected rejected, got %s\", s[70])\n1474\t\t\t}\n1475\t\t})\n1476\t}\n1477\t"}]}
