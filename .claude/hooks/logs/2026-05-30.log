r.Flush()\n112\t\t}\n113\t\tif w.file != nil {\n114\t\t\treturn w.file.Close()\n115\t\t}\n116\t\treturn nil\n117\t}\n118\t\n119\t// Path 返回追踪文件的完整路径。\n120\tfunc (w *TraceWriter) Path() string {\n121\t\treturn w.path\n122\t}\n123\t\n124\t// SessionID 返回从追踪记录中提取的 session_id。\n125\t// 如果尚无记录或首条记录不含 session_id，返回空字符串。\n126\tfunc (w *TraceWriter) SessionID() string {\n127\t\treturn w.sessionID\n128\t}\n129\t\n130\t// Summary 返回当前追踪会话的聚合统计信息。\n131\t//\n132\t// 返回的 map 包含以下字段：\n133\t//   - api_calls:            API 调用总次数\n134\t//   - input_tokens:         累计输入 Token\n135\t//   - output_tokens:        累计输出 Token\n136\t//   - cache_read_tokens:    累计缓存读取 Token\n137\t//   - cache_create_tokens:  累计缓存创建 Token\n138\t//   - models_used:          各模型调用次数 map[string]int\n139\tfunc (w *TraceWriter) Summary() map[string]any {\n140\t\tw.mu.Lock()\n141\t\tdefer w.mu.Unlock()\n142\t\n143\t\treturn map[string]any{\n144\t\t\t\"api_calls\":           w.count,\n145\t\t\t\"input_tokens\":        w.inputTokens,\n146\t\t\t\"output_tokens\":       w.outputTokens,\n147\t\t\t\"cache_read_tokens\":   w.cacheRead,\n148\t\t\t\"cache_create_tokens\": w.cacheCreate,\n149\t\t\t\"models_used\":         w.modelsUsed,\n150\t\t}\n151\t}\n152\t\n153\t// updateStats 从单条记录中提取模型信息和 Token 用量，更新累计统计。\n154\t//\n155\t// 提取逻辑：\n156\t//  1. 从 request.body.model 获取模型名称，归入 modelsUsed 计数\n157\t//  2. 从 response.body.usage 或 body 顶层提取 usage 数据\n158\t//  3. 使用 usage.NormalizeUsage 标准化后累加到各 Token 计数器\n159\tfunc (w *TraceWriter) updateStats(record map[string]any) {\n160\t\t// 从请求体中提取模型名称\n161\t\treqBody, _ := record[\"request\"].(map[string]any)\n162\t\tif reqBody != nil {\n163\t\t\tif body, ok := reqBody[\"body\"].(map[string]any); ok {\n164\t\t\t\tmodel, _ := body[\"model\"].(string)\n165\t\t\t\tif model == \"\" {\n166\t\t\t\t\tmodel = \"unknown\"\n167\t\t\t\t}\n168\t\t\t\tw.modelsUsed[model]++\n169\t\t\t}\n170\t\t}\n171\t\n172\t\t// 从响应体中提取 Token 用量\n173\t\trespBody, _ := record[\"response\"].(map[string]any)\n174\t\tif respBody == nil {\n175\t\t\treturn\n176\t\t}\n177\t\tbody, _ := respBody[\"body\"].(map[string]any)\n178\t\tif body == nil {\n179\t\t\treturn\n180\t\t}\n181\t\n182\t\trawUsage, _ := body[\"usage\"].(map[string]any)\n183\t\tif rawUsage == nil {\n184\t\t\t// 某些情况下 usage 直接位于 body 顶层\n185\t\t\trawUsage = body\n186\t\t}\n187\t\n188\t\tnorm := usage.NormalizeUsage(rawUsage)\n189\t\tw.inputTokens += norm[\"input_tokens\"]\n190\t\tw.outputTokens += norm[\"output_tokens\"]\n191\t\tw.cacheRead += norm[\"cache_read_input_tokens\"]\n192\t\tw.cacheCreate += norm[\"cache_creation_input_tokens\"]\n193\t}\n194\t\n195\t// DefaultTraceDir 返回默认的追踪文件存储目录，位于用户主目录下。\n196\t//\n197\t// 默认路径：$HOME/.claude-tap-plus/.traces\n198\t// 如果无法获取用户主目录，则返回相对路径 \".claude-tap-plus/.traces\"。\n199\tfunc DefaultTraceDir() string {\n200\t\thome, err := os.UserHomeDir()\n201\t\tif err != nil {\n202\t\t\treturn \".claude-tap-plus/.traces\"\n203\t\t}\n204\t\tdir := filepath.Join(home, \".claude-tap-plus\", \".traces\")\n205\t\tlogger.Debug(\"trace\", \"default trace dir: %s\", dir)\n206\t\treturn dir\n207\t}\n208\t\n209\t// DetectProjectName 返回当前工作目录对应的项目名称。\n210\t//\n211\t// 优先级：\n212\t//  1. 从 git remote origin URL 提取仓库名（如 my-project）\n213\t//  2. 当前工作目录的目录名作为兜底\n214\tfunc DetectProjectName() string {\n215\t\tcwd, _ := os.Getwd()\n216\t\t// 优先尝试从 git 远程地址获取仓库名\n217\t\tif cwd != \"\" {\n218\t\t\trepo := gitRemoteRepoName(cwd)\n219\t\t\tif repo != \"\" {\n220\t\t\t\tlogger.Debug(\"trace\", \"detected project name: %s (from git)\", repo)\n221\t\t\t\treturn repo\n222\t\t\t}\n223\t\t}\n224\t\t// 兜底：使用当前目录名\n225\t\tproject := filepath.Base(cwd)\n226\t\tif project == \"\" || project == \".\" {\n227\t\t\tproject = \"default\"\n228\t\t}\n229\t\tlogger.Debug(\"trace\", \"detected project name: %s (from cwd)\", project)\n230\t\treturn project\n231\t}\n232\t\n233\t// gitRemoteRepoName 从 .git/config 文件中提取 remote origin 对应的仓库名。\n234\t//\n235\t// 示例：\n236\t//\n237\t//\t\"https://github.com/user/my-project.git\" → \"my-project\"\n238\t//\n239\t// 直接读取配置文件以避免依赖 git 命令。\n240\tfunc gitRemoteRepoName(dir string) string {\n241\t\tconfigPath := filepath.Join(dir, \".git\", \"config\")\n242\t\tdata, err := os.ReadFile(configPath)\n243\t\tif err != nil {\n244\t\t\treturn \"\"\n245\t\t}\n246\t\tcontent := string(data)\n247\t\t// 定位 [remote \"origin\"] 区域并提取 URL\n248\t\tlines := strings.Split(content, \"\\n\")\n249\t\tinOrigin := false\n250\t\tfor _, line := range lines {\n251\t\t\ttrimmed := strings.TrimSpace(line)\n252\t\t\tif trimmed == `[remote \"origin\"]` {\n253\t\t\t\tinOrigin = true\n254\t\t\t\tcontinue\n255\t\t\t}\n256\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"url = \") {\n257\t\t\t\turl := strings.TrimPrefix(trimmed, \"url = \")\n258\t\t\t\t// 提取 URL 最后一段并去掉 .git 后缀\n259\t\t\t\tbase := filepath.Base(url)\n260\t\t\t\tbase = strings.TrimSuffix(base, \".git\")\n261\t\t\t\treturn base\n262\t\t\t}\n263\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"[\") {\n264\t\t\t\tbreak // 已进入下一个配置区域\n265\t\t\t}\n266\t\t}\n267\t\treturn \"\"\n268\t}\n269\t\n270\t// MachineID 返回 \"用户名@主机名\" 格式的机器标识符。\n271\t// 用于区分不同机器的追踪数据。\n272\tfunc MachineID() string {\n273\t\thostname, _ := os.Hostname()\n274\t\tif hostname == \"\" {\n275\t\t\thostname = \"unknown\"\n276\t\t}\n277\t\tusername := \"unknown\"\n278\t\tif u, err := user.Current(); err == nil && u.Username != \"\" {\n279\t\t\tusername = u.Username\n280\t\t}\n281\t\treturn username + \"@\" + hostname\n282\t}\n283\t\n284\t// ExtractProjectSlug 从 Claude Code 的会话转录文件路径中提取项目标识（slug）。\n285\t//\n286\t// 输入示例：\n287\t//\n288\t//\t\"C:\\Users\\Admin\\.claude\\projects\\D--xxx-yyy\\uuid.jsonl\"\n289\t//\n290\t// 输出：\n291\t//\n292\t//\t\"D--xxx-yyy\"\n293\t//\n294\t// 如果路径不符合预期的 .claude/projects/ 模式，则返回空字符串。\n295\tfunc ExtractProjectSlug(transcriptPath string) string {\n296\t\tif transcriptPath == \"\" {\n297\t\t\treturn \"\"\n298\t\t}\n299\t\t// 统一路径分隔符为 /\n300\t\tnormalized := filepath.ToSlash(transcriptPath)\n301\t\n302\t\t// 定位 \".claude/projects/\" 标记段\n303\t\tmarker := \".claude/projects/\"\n304\t\tidx := strings.Index(normalized, marker)\n305\t\tif idx < 0 {\n306\t\t\treturn \"\"\n307\t\t}\n308\t\n309\t\t// 提取标记后的第一段目录名\n310\t\trest := normalized[idx+len(marker):]\n311\t\tif slashIdx := strings.Index(rest, \"/\"); slashIdx >= 0 {\n312\t\t\trest = rest[:slashIdx]\n313\t\t}\n314\t\n315\t\tif rest == \"\" {\n316\t\t\treturn \"\"\n317\t\t}\n318\t\treturn rest\n319\t}\n320\t\n321\t// NewSessionTracePath 基于会话信息构建追踪文件路径。\n322\t//\n323\t// 路径格式：baseDir/{machineID}/{projectSlug}/{sessionID}.jsonl\n324\t//\n325\t// 同一 session_id 对应唯一路径，resume 时追加写入而非创建新文件。\n326\t//\n327\t// 参数说明：\n328\t//   - baseDir:     基础追踪目录\n329\t//   - machineID:   机器标识（如 username@hostname）\n330\t//   - projectSlug: 项目标识（如 D--xxx-yyy）\n331\t//   - sessionID:   会话唯一标识\n332\tfunc NewSessionTracePath(baseDir, machineID, projectSlug, sessionID string) string {\n333\t\tpath := filepath.Join(baseDir, machineID, projectSlug, sessionID+\".jsonl\")\n334\t\tlogger.Debug(\"trace\", \"session trace path: %s\", path)\n335\t\treturn path\n336\t}\n337\t"}]}
