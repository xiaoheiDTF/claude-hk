d.Start(); err != nil {\n282\t\t\tlog.Fatalf(\"start claude: %v\", err)\n283\t\t}\n284\t\n285\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n286\t\tsigChan := make(chan os.Signal, 2)\n287\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n288\t\n289\t\tgo func() {\n290\t\t\tsigCount := 0\n291\t\t\tfor sig := range sigChan {\n292\t\t\t\tsigCount++\n293\t\t\t\tif sigCount == 1 {\n294\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n295\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n296\t\t\t\t\t_ = cmd.Process.Signal(sig)\n297\t\t\t\t} else {\n298\t\t\t\t\t// 再次收到信号：强制终止子进程\n299\t\t\t\t\t_ = cmd.Process.Kill()"}]}
