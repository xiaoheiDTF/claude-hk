n55\t}\n56\t\n57\tfunc (e *env) post(t *testing.T, path, body string) *http.Response {\n58\t\tt.Helper()\n59\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n60\t\tif err != nil {\n61\t\t\tt.Fatal(err)\n62\t\t}\n63\t\treturn resp\n64\t}\n65\t\n66\tfunc readJSON(t *testing.T, resp *http.Response, v any) {\n67\t\tt.Helper()\n68\t\tdefer resp.Body.Close()\n69\t\tb, err := io.ReadAll(resp.Body)\n70\t\tif err != nil {\n71\t\t\tt.Fatal(err)\n72\t\t}\n73\t\tif err := json.Unmarshal(b, v); err != nil {\n74\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n75\t\t}\n76\t}\n77\t\n78\tfunc seedIssue(db *sql.DB, repo string, number int, status, sessionID, claimedAt string) {\n79\t\tdb.Exec(\n80\t\t\t`INSERT INTO issue_claims (repo_full_name, issue_number, status, session_id, claimed_at, updated_at)\n81\t\t\t VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)`,\n82\t\t\trepo, number, status,\n83\t\t\tnilIfEmpty(sessionID), nilIfEmpty(claimedAt),\n84\t\t)\n85\t}\n86\t\n87\t// claimIssue calls the claim API and returns (statusCode, success, claimed_by).\n88\tfunc claimIssue(t *testing.T, e *env, repo string, number int, sessionID string) (int, bool, string) {\n89\t\tt.Helper()\n90\t\n91\t\tbody := fmt.Sprintf(\n92\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n93\t\t\trepo, number, sessionID)\n94\t\tresp := e.post(t, \"/api/issue/claim\", body)\n95\t\n96\t\tvar result struct {\n97\t\t\tSuccess   bool    `json:\"success\"`\n98\t\t\tError     string  `json:\"error\"`\n99\t\t\tClaimedBy *string `json:\"claimed_by\"`\n100\t\t\tStatus    string  `json:\"status\"`\n101\t\t}\n102\t\treadJSON(t, resp, &result)\n103\t\n104\t\tclaimedBy := \"\"\n105\t\tif result.ClaimedBy != nil {\n106\t\t\tclaimedBy = *result.ClaimedBy\n107\t\t}\n108\t\treturn resp.StatusCode, result.Success, claimedBy\n109\t}\n110\t\n111\tfunc nilIfEmpty(s string) any {\n112\t\tif s == \"\" {\n113\t\t\treturn nil\n114\t\t}\n115\t\treturn s\n116\t}\n117\t\n118\t// checkStatuses queries the check API and returns a map of issue_number → status.\n119\tfunc checkStatuses(t *testing.T, e *env, repo string, numbers []int) map[int]string {\n120\t\tt.Helper()\n121\t\n122\t\tnums := make([]string, len(numbers))\n123\t\tfor i, n := range numbers {\n124\t\t\tnums[i] = fmt.Sprintf(\"%d\", n)\n125\t\t}\n126\t\n127\t\tbody := `{\"repo_full_name\":\"` + repo + `\",\"issue_numbers\":[` + strings.Join(nums, \",\") + `]}`\n128\t\tresp := e.post(t, \"/api/issue/check\", body)\n129\t\n130\t\tvar result struct {\n131\t\t\tIssues []struct {\n132\t\t\t\tNumber int    `json:\"number\"`\n133\t\t\t\tStatus string `json:\"status\"`\n134\t\t\t} `json:\"issues\"`\n135\t\t}\n136\t\treadJSON(t, resp, &result)\n137\t\n138\t\tm := map[int]string{}\n139\t\tfor _, iss := range result.Issues {\n140\t\t\tm[iss.Number] = iss.Status\n141\t\t}\n142\t\treturn m\n143\t}\n144\t\n145\t// --- B6-3 SessionEnd Hook 集成测试 ---\n146\t// 模拟 SessionEnd hook 调用 release-session API 的完整流程\n147\t// 验收标准：\n148\t//   - session 正常结束时，领取的 issue 被自动释放\n149\t//   - 已合并/打回的 issue 不被释放\n150\t//   - 无领取记录的 session 不报错\n151\t\n152\tfunc TestSessionEndHook(t *testing.T) {\n153\t\tt.Run(\"session_end_releases_claimed_issues\", func(t *testing.T) {\n154\t\t\t// 验收：session 正常结束时，领取的 issue 被自动释放\n155\t\t\t// 模拟场景：sess_test 领取了 #10(claimed) 和 #11(fixing)\n156\t\t\t// SessionEnd hook 调用 release-session → #10/#11 回到 idle\n157\t\t\te := setup(t)\n158\t\t\tdb := e.store.DB()\n159\t\n160\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n161\t\t\tseedIssue(db, \"test/repo\", 11, \"fixing\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n162\t\n163\t\t\t// 模拟 hook 调用 release-session\n164\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n165\t\t\t\t`{\"session_id\":\"sess_test\"}`)\n166\t\n167\t\t\tvar result struct {\n168\t\t\t\tReleased []int `json:\"released\"`\n169\t\t\t\tCount    int   `json:\"count\"`\n170\t\t\t}\n171\t\t\treadJSON(t, resp, &result)\n172\t\n173\t\t\tif result.Count != 2 {\n174\t\t\t\tt.Fatalf(\"expected 2 released, got %d\", result.Count)\n175\t\t\t}\n176\t\n177\t\t\t// 验证两个 issue 都回到了 idle\n178\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10, 11})\n179\t\t\tif statuses[10] != \"idle\" {\n180\t\t\t\tt.Errorf(\"expected #10 idle, got %s\", statuses[10])\n181\t\t\t}\n182\t\t\tif statuses[11] != \"idle\" {\n183\t\t\t\tt.Errorf(\"expected #11 idle, got %s\", statuses[11])\n184\t\t\t}\n185\t\t})\n186\t\n187\t\tt.Run(\"merged_and_rejected_not_released\", func(t *testing.T) {\n188\t\t\t// 验收：已合并/打回的 issue 不被释放\n189\t\t\t// 模拟场景：sess_test 有 #10(claimed) #11(merged) #12(rejected)\n190\t\t\t// SessionEnd → 只有 #10 被释放，#11/#12 不变\n191\t\t\te := setup(t)\n192\t\t\tdb := e.store.DB()\n193\t\n194\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n195\t\t\tseedIssue(db, \"test/repo\", 11, \"merged\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n196\t\t\tseedIssue(db, \"test/repo\", 12, \"rejected\", \"sess_test\", \"2026-05-26T10:00:00Z\")\n197\t\n198\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n199\t\t\t\t`{\"session_id\":\"sess_test\"}`)\n200\t\n201\t\t\tvar result struct {\n202\t\t\t\tReleased []int `json:\"released\"`\n203\t\t\t\tCount    int   `json:\"count\"`\n204\t\t\t}\n205\t\t\treadJSON(t, resp, &result)\n206\t\n207\t\t\tif result.Count != 1 {\n208\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n209\t\t\t}\n210\t\t\tif len(result.Released) != 1 || result.Released[0] != 10 {\n211\t\t\t\tt.Fatalf(\"expected [10], got %v\", result.Released)\n212\t\t\t}\n213\t\n214\t\t\t// 验证终态不变\n215\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10, 11, 12})\n216\t\t\tif statuses[10] != \"idle\" {\n217\t\t\t\tt.Errorf(\"expected #10 idle after release, got %s\", statuses[10])\n218\t\t\t}\n219\t\t\tif statuses[11] != \"merged\" {\n220\t\t\t\tt.Errorf(\"expected #11 still merged, got %s\", statuses[11])\n221\t\t\t}\n222\t\t\tif statuses[12] != \"rejected\" {\n223\t\t\t\tt.Errorf(\"expected #12 still rejected, got %s\", statuses[12])\n224\t\t\t}\n225\t\t})\n226\t\n227\t\tt.Run(\"no_claims_returns_empty_no_error\", func(t *testing.T) {\n228\t\t\t// 验收：无领取记录的 session 不报错\n229\t\t\t// 模拟场景：sess_empty 没有领取任何 issue\n230\t\t\t// SessionEnd → released=[], count=0，无报错\n231\t\t\te := setup(t)\n232\t\n233\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n234\t\t\t\t`{\"session_id\":\"sess_empty\"}`)\n235\t\n236\t\t\tvar result struct {\n237\t\t\t\tReleased []int `json:\"released\"`\n238\t\t\t\tCount    int   `json:\"count\"`\n239\t\t\t}\n240\t\t\treadJSON(t, resp, &result)\n241\t\n242\t\t\tif resp.StatusCode != http.StatusOK {\n243\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n244\t\t\t}\n245\t\t\tif result.Count != 0 {\n246\t\t\t\tt.Errorf(\"expected 0, got %d\", result.Count)\n247\t\t\t}\n248\t\t\tif len(result.Released) != 0 {\n249\t\t\t\tt.Errorf(\"expected empty, got %v\", result.Released)\n250\t\t\t}\n251\t\t})\n252\t\n253\t\tt.Run(\"only_releases_target_session\", func(t *testing.T) {\n254\t\t\t// 补充：只释放目标 session 的 issue，其他 session 的 issue 不受影响\n255\t\t\t// 模拟场景：sess_a 领取 #10, sess_b 领取 #11, #12(merged)属于 sess_a\n256\t\t\t// SessionEnd(sess_a) → 释放 #10，#11(属于sess_b)和 #12(merged)不变\n257\t\t\te := setup(t)\n258\t\t\tdb := e.store.DB()\n259\t\n260\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n261\t\t\tseedIssue(db, \"test/repo\", 11, \"claimed\", \"sess_b\", \"2026-05-26T10:00:00Z\")\n262\t\t\tseedIssue(db, \"test/repo\", 12, \"merged\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n263\t\n264\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n265\t\t\t\t`{\"session_id\":\"sess_a\"}`)\n266\t\n267\t\t\tvar result struct {\n268\t\t\t\tReleased []int `json:\"released\"`\n269\t\t\t\tCount    int   `json:\"count\"`\n270\t\t\t}\n271\t\t\treadJSON(t, resp, &result)\n272\t\n273\t\t\tif result.Count != 1 {\n274\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n275\t\t\t}\n276\t\t\tif len(result.Released) != 1 || result.Released[0] != 10 {\n277\t\t\t\tt.Fatalf(\"expected [10], got %v\", result.Released)\n278\t\t\t}\n279\t\n280\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10, 11, 12})\n281\t\t\tif statuses[10] != \"idle\" {\n282\t\t\t\tt.Errorf(\"expected #10 idle, got %s\", statuses[10])\n283\t\t\t}\n284\t\t\tif statuses[11] != \"claimed\" {\n285\t\t\t\tt.Errorf(\"expected #11 still claimed (sess_b), got %s\", statuses[11])\n286\t\t\t}\n287\t\t\tif statuses[12] != \"merged\" {\n288\t\t\t\tt.Errorf(\"expected #12 still merged, got %s\", statuses[12])\n289\t\t\t}\n290\t\t})\n291\t\n292\t\tt.Run(\"full_flow_claim_then_session_end\", func(t *testing.T) {\n293\t\t\t// 端到端流程：先 check（自动创建 idle）→ 模拟 claim → SessionEnd 释放\n294\t\t\t// 模拟完整生命周期：idle → claimed → SessionEnd → idle\n295\t\t\te := setup(t)\n296\t\n297\t\t\t// 1. check 创建 idle 记录\n298\t\t\te.post(t, \"/api/issue/check\",\n299\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[20]}`)\n300\t\n301\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{20})\n302\t\t\tif statuses[20] != \"idle\" {\n303\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", statuses[20])\n304\t\t\t}\n305\t\n306\t\t\t// 2. 模拟 claim（直接 SQL，claim API 后续实现）\n307\t\t\te.store.DB().Exec(\n308\t\t\t\t`UPDATE issue_claims SET status='claimed', session_id='sess_e2e', claimed_at=CURRENT_TIMESTAMP\n309\t\t\t\t WHERE repo_full_name='test/repo' AND issue_number=20`)\n310\t\n311\t\t\tstatuses = checkStatuses(t, e, \"test/repo\", []int{20})\n312\t\t\tif statuses[20] != \"claimed\" {\n313\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", statuses[20])\n314\t\t\t}\n315\t\n316\t\t\t// 3. SessionEnd 触发释放\n317\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n318\t\t\t\t`{\"session_id\":\"sess_e2e\"}`)\n319\t\n320\t\t\tvar result struct {\n321\t\t\t\tCount int `json:\"count\"`\n322\t\t\t}\n323\t\t\treadJSON(t, resp, &result)\n324\t\t\tif result.Count != 1 {\n325\t\t\t\tt.Fatalf(\"step 3: expected 1 released, got %d\", result.Count)\n326\t\t\t}\n327\t\n328\t\t\t// 4. 验证回到 idle\n329\t\t\tstatuses = checkStatuses(t, e, \"test/repo\", []int{20})\n330\t\t\tif statuses[20] != \"idle\" {\n331\t\t\t\tt.Fatalf(\"step 4: expected idle after release, got %s\", statuses[20])\n332\t\t\t}\n333\t\t})\n334\t}\n335\t\n336\t// --- B3: Claim API 集成测试 ---\n337\t// 验收标准：\n338\t//   - 空闲 issue 可被成功领取\n339\t//   - 已被其他 session 领取的 issue 返回 already_claimed\n340\t//   - 同一 session 重复领取同一 issue 返回成功（幂等）\n341\t//   - 已合并/打回的 issue 不可领取\n342\t//   - 首次出现的 issue 自动创建记录后领取\n343\t//   - 并发领取时只有一个成功（原子性）\n344\t\n345\tfunc TestClaimAPI(t *testing.T) {\n346\t\tt.Run(\"claim_idle_issue_success\", func(t *testing.T) {\n347\t\t\t// 验收：空闲 issue 可被成功领取\n348\t\t\te := setup(t)\n349\t\t\tdb := e.store.DB()\n350\t\n351\t\t\tseedIssue(db, \"test/repo\", 10, \"idle\", \"\", \"\")\n352\t\n353\t\t\tcode, success, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_a\")\n354\t\t\tif code != http.StatusOK {\n355\t\t\t\tt.Fatalf(\"expected 200, got %d\", code)\n356\t\t\t}\n357\t\t\tif !success {\n358\t\t\t\tt.Fatal(\"expected success=true\")\n359\t\t\t}\n360\t\n361\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{10})\n362\t\t\tif statuses[10] != \"claimed\" {\n363\t\t\t\tt.Errorf(\"expected claimed, got %s\", statuses[10])\n364\t\t\t}\n365\t\t})\n366\t\n367\t\tt.Run(\"claim_already_claimed_by_other\", func(t *testing.T) {\n368\t\t\t// 验收：已被其他 session 领取的 issue 返回 already_claimed\n369\t\t\te := setup(t)\n370\t\t\tdb := e.store.DB()\n371\t\n372\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n373\t\n374\t\t\tcode, success, claimedBy := claimIssue(t, e, \"test/repo\", 10, \"sess_b\")\n375\t\t\tif code != http.StatusConflict {\n376\t\t\t\tt.Fatalf(\"expected 409, got %d\", code)\n377\t\t\t}\n378\t\t\tif success {\n379\t\t\t\tt.Fatal(\"expected success=false\")\n380\t\t\t}\n381\t\t\tif claimedBy != \"sess_a\" {\n382\t\t\t\tt.Errorf(\"expected claimed_by=sess_a, got %s\", claimedBy)\n383\t\t\t}\n384\t\t})\n385\t\n386\t\tt.Run(\"claim_idempotent_same_session\", func(t *testing.T) {\n387\t\t\t// 验收：同一 session 重复领取同一 issue 返回成功（幂等）\n388\t\t\te := setup(t)\n389\t\t\tdb := e.store.DB()\n390\t\n391\t\t\tseedIssue(db, \"test/repo\", 10, \"idle\", \"\", \"\")\n392\t\n393\t\t\tcode1, ok1, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_a\")\n394\t\t\tif code1 != http.StatusOK || !ok1 {\n395\t\t\t\tt.Fatalf(\"first claim should succeed: code=%d ok=%v\", code1, ok1)\n396\t\t\t}\n397\t\n398\t\t\tcode2, ok2, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_a\")\n399\t\t\tif code2 != http.StatusOK || !ok2 {\n400\t\t\t\tt.Fatalf(\"idempotent claim should succeed: code=%d ok=%v\", code2, ok2)\n401\t\t\t}\n402\t\t})\n403\t\n404\t\tt.Run(\"claim_merged_rejected_blocked\", func(t *testing.T) {\n405\t\t\t// 验收：已合并/打回的 issue 不可领取\n406\t\t\te := setup(t)\n407\t\t\tdb := e.store.DB()\n408\t\n409\t\t\tseedIssue(db, \"test/repo\", 10, \"merged\", \"sess_old\", \"2026-05-26T10:00:00Z\")\n410\t\t\tseedIssue(db, \"test/repo\", 11, \"rejected\", \"sess_old\", \"2026-05-26T10:00:00Z\")\n411\t\n412\t\t\tcode10, ok10, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_new\")\n413\t\t\tif code10 != http.StatusConflict || ok10 {\n414\t\t\t\tt.Errorf(\"merged issue should not be claimable: code=%d ok=%v\", code10, ok10)\n415\t\t\t}\n416\t\n417\t\t\tcode11, ok11, _ := claimIssue(t, e, \"test/repo\", 11, \"sess_new\")\n418\t\t\tif code11 != http.StatusConflict || ok11 {\n419\t\t\t\tt.Errorf(\"rejected issue should not be claimable: code=%d ok=%v\", code11, ok11)\n420\t\t\t}\n421\t\t})\n422\t\n423\t\tt.Run(\"claim_new_issue_auto_create\", func(t *testing.T) {\n424\t\t\t// 验收：首次出现的 issue 自动创建记录后领取\n425\t\t\te := setup(t)\n426\t\n427\t\t\tcode, success, _ := claimIssue(t, e, \"test/repo\", 99, \"sess_new\")\n428\t\t\tif code != http.StatusOK || !success {\n429\t\t\t\tt.Fatalf(\"first-time claim should succeed: code=%d ok=%v\", code, success)\n430\t\t\t}\n431\t\n432\t\t\tstatuses := checkStatuses(t, e, \"test/repo\", []int{99})\n433\t\t\tif statuses[99] != \"claimed\" {\n434\t\t\t\tt.Errorf(\"expected claimed, got %s\", statuses[99])\n435\t\t\t}\n436\t\t})\n437\t\n438\t\tt.Run(\"claim_missing_params_returns_error\", func(t *testing.T) {\n439\t\t\t// 补充：缺少必填参数时返回 400\n440\t\t\te := setup(t)\n441\t\n442\t\t\tresp := e.post(t, \"/api/issue/claim\", `{\"repo_full_name\":\"test/repo\",\"issue_number\":10}`)\n443\t\t\tif resp.StatusCode != http.StatusBadRequest {\n444\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n445\t\t\t}\n446\t\t})\n447\t\n448\t\tt.Run(\"claim_after_release_succeeds\", func(t *testing.T) {\n449\t\t\t// 补充：issue 被释放后可被重新领取\n450\t\t\te := setup(t)\n451\t\t\tdb := e.store.DB()\n452\t\n453\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_a\", \"2026-05-26T10:00:00Z\")\n454\t\n455\t\t\t// 释放\n456\t\t\te.post(t, \"/api/issue/release\",\n457\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_a\"}`)\n458\t\n459\t\t\t// 新 session 领取\n460\t\t\tcode, success, _ := claimIssue(t, e, \"test/repo\", 10, \"sess_b\")\n461\t\t\tif code != http.StatusOK || !success {\n462\t\t\t\tt.Fatalf(\"claim after release should succeed: code=%d ok=%v\", code, success)\n463\t\t\t}\n464\t\t})\n465\t}\n466\t\n467\t// --- D2: 003-5-issue-fix 技能集成测试 ---\n468\t// 模拟 003-5-issue-fix 技能调用后端的完整流程\n469\t// 验收标准：\n470\t//   - claim 后调 status API 可将状态更新为 fixing\n471\t//   - 非 owner session 无法标记 fixing\n472\t//   - 后端不可用时 skill 脚本静默降级（此处验证 API 层行为）\n473\t//   - fixing 状态的 issue 可被 session end 正常释放\n474\t//   - 完整技能流程：claim → fixing → session end 释放\n475\t\n476\tfunc TestIssueFixFlow(t *testing.T) {\n477\t\tt.Run(\"claim_then_fixing\", func(t *testing.T) {\n478\t\t\t// D2 核心验收：claim → fixing 状态流转\n479\t\t\t// 模拟 /003-4-issue-claim 后，/003-5-issue-fix 标记 fixing\n480\t\t\te := setup(t)\n481\t\n482\t\t\t// 1. check 创建 idle\n483\t\t\te.post(t, \"/api/issue/check\",\n484\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[10]}`)\n485\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n486\t\t\tif s[10] != \"idle\" {\n487\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[10])\n488\t\t\t}\n489\t\n490\t\t\t// 2. claim（模拟 003-4-issue-claim）\n491\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 10, \"sess_fix_001\")\n492\t\t\tif code != http.StatusOK || !ok {\n493\t\t\t\tt.Fatalf(\"step 2: claim failed: code=%d ok=%v\", code, ok)\n494\t\t\t}\n495\t\n496\t\t\t// 3. 标记 fixing（模拟 003-5-issue-fix 调用 update_issue_status）\n497\t\t\tresp := e.post(t, \"/api/issue/status\",\n498\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":10,\"session_id\":\"sess_fix_001\",\"status\":\"fixing\"}`)\n499\t\t\tvar result struct {\n500\t\t\t\tSuccess        bool   `json:\"success\"`\n501\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n502\t\t\t\tNewStatus      string `json:\"new_status\"`\n503\t\t\t}\n504\t\t\treadJSON(t, resp, &result)\n505\t\t\tif !result.Success {\n506\t\t\t\tt.Fatalf(\"step 3: fixing update failed\")\n507\t\t\t}\n508\t\t\tif result.PreviousStatus != \"claimed\" {\n509\t\t\t\tt.Errorf(\"step 3: expected previous=claimed, got %s\", result.PreviousStatus)\n510\t\t\t}\n511\t\t\tif result.NewStatus != \"fixing\" {\n512\t\t\t\tt.Errorf(\"step 3: expected new=fixing, got %s\", result.NewStatus)\n513\t\t\t}\n514\t\n515\t\t\t// 4. check 确认状态为 fixing\n516\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n517\t\t\tif s[10] != \"fixing\" {\n518\t\t\t\tt.Fatalf(\"step 4: expected fixing, got %s\", s[10])\n519\t\t\t}\n520\t\t})\n521\t\n522\t\tt.Run(\"non_owner_cannot_fix\", func(t *testing.T) {\n523\t\t\t// 验收：非领取者无法标记 fixing\n524\t\t\te := setup(t)\n525\t\t\tdb := e.store.DB()\n526\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"claimed\", \"sess_owner\", \"2026-05-27T10:00:00Z\")\n527\t\n528\t\t\tresp := e.post(t, \"/api/issue/status\",\n529\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"fixing\"}`)\n530\t\n531\t\t\tvar result struct {\n532\t\t\t\tSuccess bool   `json:\"success\"`\n533\t\t\t\tError   string `json:\"error\"`\n534\t\t\t}\n535\t\t\treadJSON(t, resp, &result)\n536\t\t\tif result.Success {\n537\t\t\t\tt.Fatal(\"non-owner should not be able to update status\")\n538\t\t\t}\n539\t\t\tif result.Error != \"not_owner\" {\n540\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n541\t\t\t}\n542\t\t})\n543\t\n544\t\tt.Run(\"fixing_released_on_session_end\", func(t *testing.T) {\n545\t\t\t// 验收：fixing 状态的 issue 在 session 结束时被释放回到 idle\n546\t\t\t// 模拟：claim → fixing → session end → idle\n547\t\t\te := setup(t)\n548\t\t\tdb := e.store.DB()\n549\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"claimed\", \"sess_fix_end\", \"2026-05-27T10:00:00Z\")\n550\t\n551\t\t\t// 标记 fixing\n552\t\t\te.post(t, \"/api/issue/status\",\n553\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":10,\"session_id\":\"sess_fix_end\",\"status\":\"fixing\"}`)\n554\t\n555\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n556\t\t\tif s[10] != \"fixing\" {\n557\t\t\t\tt.Fatalf(\"expected fixing before session end, got %s\", s[10])\n558\t\t\t}\n559\t\n560\t\t\t// session end 释放\n561\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n562\t\t\t\t`{\"session_id\":\"sess_fix_end\"}`)\n563\t\t\tvar rel struct {\n564\t\t\t\tCount int `json:\"count\"`\n565\t\t\t}\n566\t\t\treadJSON(t, resp, &rel)\n567\t\t\tif rel.Count != 1 {\n568\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n569\t\t\t}\n570\t\n571\t\t\t// 验证回到 idle\n572\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n573\t\t\tif s[10] != \"idle\" {\n574\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n575\t\t\t}\n576\t\t})\n577\t\n578\t\tt.Run(\"full_lifecycle_claim_fix_release\", func(t *testing.T) {\n579\t\t\t// 完整生命周期：idle → claimed → fixing → session end → idle → re-claim\n580\t\t\te := setup(t)\n581\t\n582\t\t\t// 1. idle\n583\t\t\te.post(t, \"/api/issue/check\",\n584\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[15]}`)\n585\t\n586\t\t\t// 2. claim\n587\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 15, \"sess_lifecycle\")\n588\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n589\t\t\tif s[15] != \"claimed\" {\n590\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", s[15])\n591\t\t\t}\n592\t\n593\t\t\t// 3. fixing\n594\t\t\te.post(t, \"/api/issue/status\",\n595\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":15,\"session_id\":\"sess_lifecycle\",\"status\":\"fixing\"}`)\n596\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n597\t\t\tif s[15] != \"fixing\" {\n598\t\t\t\tt.Fatalf(\"step 3: expected fixing, got %s\", s[15])\n599\t\t\t}\n600\t\n601\t\t\t// 4. session end 释放\n602\t\t\te.post(t, \"/api/issue/release-session\",\n603\t\t\t\t`{\"session_id\":\"sess_lifecycle\"}`)\n604\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n605\t\t\tif s[15] != \"idle\" {\n606\t\t\t\tt.Fatalf(\"step 4: expected idle, got %s\", s[15])\n607\t\t\t}\n608\t\n609\t\t\t// 5. 重新被另一个 session 领取\n610\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 15, \"sess_new\")\n611\t\t\tif code != http.StatusOK || !ok {\n612\t\t\t\tt.Fatalf(\"step 5: re-claim failed: code=%d ok=%v\", code, ok)\n613\t\t\t}\n614\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{15})\n615\t\t\tif s[15] != \"claimed\" {\n616\t\t\t\tt.Fatalf(\"step 5: expected claimed, got %s\", s[15])\n617\t\t\t}\n618\t\t})\n619\t\n620\t\tt.Run(\"fixing_merged_not_released_on_session_end\", func(t *testing.T) {\n621\t\t\t// 补充：如果 fixing 的 issue 在期间被外部标记为 merged，\n622\t\t\t// session end 不应释放它（虽然正常流程不会出现这种场景，但验证边界条件）\n623\t\t\te := setup(t)\n624\t\t\tdb := e.store.DB()\n625\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_merged\", \"2026-05-27T10:00:00Z\")\n626\t\n627\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n628\t\t\t\t`{\"session_id\":\"sess_merged\"}`)\n629\t\t\tvar rel struct {\n630\t\t\t\tCount int `json:\"count\"`\n631\t\t\t}\n632\t\t\treadJSON(t, resp, &rel)\n633\t\t\tif rel.Count != 0 {\n634\t\t\t\tt.Fatalf(\"merged should not be released, got count=%d\", rel.Count)\n635\t\t\t}\n636\t\n637\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n638\t\t\tif s[10] != \"merged\" {\n639\t\t\t\tt.Errorf(\"expected merged unchanged, got %s\", s[10])\n640\t\t\t}\n641\t\t})\n642\t}\n643\t\n644\t// --- D3: 003-6-issue-done 技能集成测试 ---\n645\t// 验收标准：\n646\t//   - fixing → ready-for-pr 状态更新\n647\t//   - ready-for-pr 状态在 session end 时被释放\n648\t//   - 完整技能流程：claim → fixing → ready-for-pr → session end\n649\t\n650\tfunc TestIssueDoneFlow(t *testing.T) {\n651\t\tt.Run(\"fixing_to_ready_for_pr\", func(t *testing.T) {\n652\t\t\te := setup(t)\n653\t\n654\t\t\t// claim → fixing → ready-for-pr\n655\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 20, \"sess_done_001\")\n656\t\t\te.post(t, \"/api/issue/status\",\n657\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":20,\"session_id\":\"sess_done_001\",\"status\":\"fixing\"}`)\n658\t\n659\t\t\tresp := e.post(t, \"/api/issue/status\",\n660\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":20,\"session_id\":\"sess_done_001\",\"status\":\"ready-for-pr\"}`)\n661\t\t\tvar result struct {\n662\t\t\t\tSuccess        bool   `json:\"success\"`\n663\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n664\t\t\t\tNewStatus      string `json:\"new_status\"`\n665\t\t\t}\n666\t\t\treadJSON(t, resp, &result)\n667\t\t\tif !result.Success {\n668\t\t\t\tt.Fatal(\"ready-for-pr update failed\")\n669\t\t\t}\n670\t\t\tif result.PreviousStatus != \"fixing\" {\n671\t\t\t\tt.Errorf(\"expected previous=fixing, got %s\", result.PreviousStatus)\n672\t\t\t}\n673\t\n674\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{20})\n675\t\t\tif s[20] != \"ready-for-pr\" {\n676\t\t\t\tt.Fatalf(\"expected ready-for-pr, got %s\", s[20])\n677\t\t\t}\n678\t\t})\n679\t\n680\t\tt.Run(\"ready_for_pr_released_on_session_end\", func(t *testing.T) {\n681\t\t\te := setup(t)\n682\t\t\tdb := e.store.DB()\n683\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"ready-for-pr\", \"sess_done_end\", \"2026-05-27T10:00:00Z\")\n684\t\n685\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n686\t\t\t\t`{\"session_id\":\"sess_done_end\"}`)\n687\t\t\tvar rel struct{ Count int `json:\"count\"` }\n688\t\t\treadJSON(t, resp, &rel)\n689\t\t\tif rel.Count != 1 {\n690\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n691\t\t\t}\n692\t\n693\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n694\t\t\tif s[10] != \"idle\" {\n695\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n696\t\t\t}\n697\t\t})\n698\t\n699\t\tt.Run(\"full_lifecycle_claim_fix_done_release\", func(t *testing.T) {\n700\t\t\te := setup(t)\n701\t\n702\t\t\t// idle\n703\t\t\te.post(t, \"/api/issue/check\",\n704\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[25]}`)\n705\t\n706\t\t\t// claim\n707\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 25, \"sess_lc_done\")\n708\t\n709\t\t\t// fixing\n710\t\t\te.post(t, \"/api/issue/status\",\n711\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":25,\"session_id\":\"sess_lc_done\",\"status\":\"fixing\"}`)\n712\t\n713\t\t\t// ready-for-pr\n714\t\t\te.post(t, \"/api/issue/status\",\n715\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":25,\"session_id\":\"sess_lc_done\",\"status\":\"ready-for-pr\"}`)\n716\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{25})\n717\t\t\tif s[25] != \"ready-for-pr\" {\n718\t\t\t\tt.Fatalf(\"expected ready-for-pr, got %s\", s[25])\n719\t\t\t}\n720\t\n721\t\t\t// session end\n722\t\t\te.post(t, \"/api/issue/release-session\",\n