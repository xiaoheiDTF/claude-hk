http.Request) {\n20\t\tif r.Method != http.MethodPost {\n21\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n22\t\t\treturn\n23\t\t}\n24\t\n25\t\tvar req RegisterSessionRequest\n26\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n27\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n28\t\t\treturn\n29\t\t}\n30\t\n31\t\tif req.SessionID == \"\" || req.MachineID == \"\" || req.ProjectSlug == \"\" || req.TranscriptPath == \"\" {\n32\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\",\n33\t\t\t\t\"session_id, machine_id, project_slug and transcript_path are required\")\n34\t\t\treturn\n35\t\t}\n36\t\n37\t\tsess := store.Session{\n38\t\t\tSessionID:      req.SessionID,\n39\t\t\tMachineID:      req.MachineID,\n40\t\t\tOS:             req.OS,\n41\t\t\tProjectSlug:    req.ProjectSlug,\n42\t\t\tProjectCwd:     req.ProjectCwd,\n43\t\t\tTranscriptPath: req.TranscriptPath,\n44\t\t\tLocalTracePath: req.LocalTracePath,\n45\t\t\tModel:          req.Model,\n46\t\t\tSource:         req.Source,\n47\t\t}\n48\t\n49\t\tif err := h.svc.Register(r.Context(), sess); err != nil {\n50\t\t\tif err == store.ErrSessionExists {\n51\t\t\t\twriteError(w, http.StatusConflict, \"session_exists\", \"session already registered\")\n52\t\t\t\treturn\n53\t\t\t}\n54\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to register session\")\n55\t\t\treturn\n56\t\t}\n57\t\n58\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"registered\"})\n59\t}\n60\t\n61\tfunc (h *SessionHandler) Close(w http.ResponseWriter, r *http.Request) {\n62\t\tif r.Method != http.MethodPost {\n63\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n64\t\t\treturn\n65\t\t}\n66\t\n67\t\tvar req CloseSessionRequest\n68\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n69\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n70\t\t\treturn\n71\t\t}\n72\t\n73\t\tif req.SessionID == \"\" {\n74\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"session_id is required\")\n75\t\t\treturn\n76\t\t}\n77\t\n78\t\tif err := h.svc.Close(r.Context(), req.SessionID, req.Reason); err != nil {\n79\t\t\tif err == store.ErrSessionNotFound {\n80\t\t\t\twriteError(w, http.StatusNotFound, \"not_found\", \"session not found or already closed\")\n81\t\t\t\treturn\n82\t\t\t}\n83\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to close session\")\n84\t\t\treturn\n85\t\t}\n86\t\n87\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"closed\"})\n88\t}\n89\t\n90\tfunc (h *SessionHandler) List(w http.ResponseWriter, r *http.Request) {\n91\t\tif r.Method != http.MethodGet {\n92\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n93\t\t\treturn\n94\t\t}\n95\t\n96\t\tvar filter store.SessionFilter\n97\t\tif v := r.URL.Query().Get(\"machine_id\"); v != \"\" {\n98\t\t\tfilter.MachineID = &v\n99\t\t}\n100\t\tif v := r.URL.Query().Get(\"project_slug\"); v != \"\" {\n101\t\t\tfilter.ProjectSlug = &v\n102\t\t}\n103\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\n104\t\t\tfilter.Status = &v\n105\t\t}\n106\t\n107\t\tsessions, err := h.svc.List(r.Context(), filter)\n108\t\tif err != nil {\n109\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list sessions\")\n110\t\t\treturn\n111\t\t}\n112\t\n113\t\tif sessions == nil {\n114\t\t\tsessions = []store.Session{}\n115\t\t}\n116\t\n117\t\titems := make([]SessionListItem, len(sessions))\n118\t\tfor i, s := range sessions {\n119\t\t\titems[i] = toSessionListItem(s)\n120\t\t}\n121\t\n122\t\twriteJSON(w, http.StatusOK, SessionListResponse{Sessions: items})\n123\t}\n124\t\n125\tfunc (h *SessionHandler) Get(w http.ResponseWriter, r *http.Request) {\n126\t\tif r.Method != http.MethodGet {\n127\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method