if n, _ := res.RowsAffected(); n > 0 {\n43\t\t\t\tautoCreated++\n44\t\t\t}\n45\t\t}\n46\t\tif autoCreated > 0 {\n47\t\t\tlogger.Debug(\"store.issue\", \"auto-created idle records for %d issues\", autoCreated)\n48\t\t}\n49\t\n50\t\t// 查询所有匹配的记录\n51\t\tplaceholders := make([]string, len(numbers))\n52\t\targs := make([]any, 0, len(numbers)+1)\n53\t\targs = append(args, repo)\n54\t\tfor i, num := range numbers {\n55\t\t\tplaceholders[i] = \"?\"\n56\t\t\targs = append(args, num)\n57\t\t}\n58\t\n59\t\tquery := fmt.Sprintf(\n60\t\t\t`SELECT issue_number, status, session_id, claimed_at\n61\t\t\t   FROM issue_claims\n62\t\t\t  WHERE repo_full_name = ? AND issue_number IN (%s)`,\n63\t\t\tstrings.Join(placeholders, \",\"))\n64\t\n65\t\trows, err := s.db.QueryContext(ctx, query, args...)\n66\t\tif err != nil {\n67\t\t\treturn nil, fmt.Errorf(\"query issues: %w\", err)\n68\t\t}\n69\t\tdefer rows.Close()\n70\t\n71\t\tresults := make([]IssueCheckResult, 0, len(numbers))\n72\t\tfor rows.Next() {\n73\t\t\tvar r IssueCheckResult\n74\t\t\tvar sessionID sql.NullString\n75\t\t\tvar claimedAt sql.NullString\n76\t\t\tif err := rows.Scan(&r.Number, &r.Status, &sessionID, &claimedAt); err != nil {\n77\t\t\t\treturn nil, fmt.Errorf(\"scan row: %w\", err)\n78\t\t\t}\n79\t\t\tif sessionID.Valid {\n80\t\t\t\tr.SessionID = &sessionID.String\n81\t\t\t}\n82\t\t\tif claimedAt.Valid {\n83\t\t\t\tr.ClaimedAt = &claimedAt.String\n84\t\t\t}\n85\t\t\tresults = append(results, r)\n86\t\t}\n87\t\tlogger.Info(\"store.issue\", \"check issues: repo=%s found %d records\", repo, len(results))\n88\t\treturn results, rows.Err()\n89\t}\n90\t\n91\t// ClaimIssue 尝试领取指定 Issue。\n92\t// 使用乐观锁：仅在当前状态为 idle 时才能领取成功。\n93\t// 支持幂等：同一 session 重复领取返回成功。\n94\tfunc (s *sqliteIssueStore) ClaimIssue(ctx context.Context, repo string, number int, sessionID string, issueTitle string) (*ClaimResult, error) {\n95\t\tlogger.Debug(\"store.issue\", \"claim: repo=%s #%d session=%s\", repo, number, sessionID)\n96\t\n97\t\t// 确保记录存在（不存在时创建 idle 记录）\n98\t\t_, err := s.db.ExecContext(ctx,\n99\t\t\t`INSERT OR IGNORE INTO issue_claims (repo_full_name, issue_number, status, updated_at)\n100\t\t\t VALUES (?, ?, 'idle', CURRENT_TIMESTAMP)`,\n101\t\t\trepo, number)\n102\t\tif err != nil {\n103\t\t\treturn nil, fmt.Errorf(\"ensure issue: %w\", err)\n104\t\t}\n105\t\n106\t\t// 乐观锁：仅在 status = 'idle' 时更新为 claimed\n107\t\tres, err := s.db.ExecContext(ctx,\n108\t\t\t`UPDATE issue_claims\n109\t\t\t    SET status = 'claimed', session_id = ?, claimed_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP\n110\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND status = 'idle'`,\n111\t\t\tsessionID, repo, number)\n112\t\tif err != nil {\n113\t\t\treturn nil, fmt.Errorf(\"claim update: %w\", err)\n114\t\t}\n115\t\tn, _ := res.RowsAffected()\n116\t\tif n > 0 {\n117\t\t\tvar claimedAt string\n118\t\t\ts.db.QueryRowContext(ctx,\n119\t\t\t\t`SELECT claimed_at FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n120\t\t\t\trepo, number).Scan(&claimedAt)\n121\t\t\tlogger.Info(\"store.issue\", \"issue claimed: repo=%s #%d by %s\", repo, number, sessionID)\n122\t\t\treturn &ClaimResult{Success: true, Status: \"claimed\", ClaimedAt: &claimedAt}, nil\n123\t\t}\n124\t\n125\t\t// 领取失败，查询当前状态\n126\t\tvar curStatus string\n127\t\tvar curSession sql.NullString\n128\t\tvar curClaimedAt sql.NullString\n129\t\terr = s.db.QueryRowContext(ctx,\n130\t\t\t`SELECT status, session_id, claimed_at FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n131\t\t\trepo, number).Scan(&curStatus, &curSession, &curClaimedAt)\n132\t\tif err != nil {\n133\t\t\treturn nil, fmt.Errorf(\"query state: %w\", err)\n134\t\t}\n135\t\n136\t\t// 幂等：同一 session 已领取过\n137\t\tif curSession.Valid && curSession.String == sessionID {\n138\t\t\tlogger.Debug(\"store.issue\", \"claim idempotent: same session %s\", sessionID)\n139\t\t\tresult := &ClaimResult{Success: true, Status: curStatus}\n140\t\t\tif curClaimedAt.Valid {\n141\t\t\t\tresult.ClaimedAt = &curClaimedAt.String\n142\t\t\t}\n143\t\t\treturn result, nil\n144\t\t}\n145\t\n146\t\t// 已被其他 session 领取或处于终态\n147\t\tlogger.Warn(\"store.issue\", \"claim conflict: repo=%s #%d already claimed by %s\", repo, number, curSession.String)\n148\t\tresult := &ClaimResult{Success: false, Status: curStatus}\n149\t\tif curSession.Valid {\n150\t\t\tresult.ClaimedBy = &curSession.String\n151\t\t}\n152\t\tif curClaimedAt.Valid {\n153\t\t\tresult.ClaimedAt = &curClaimedAt.String\n154\t\t}\n155\t\treturn result, nil\n156\t}\n157\t\n158\t// UpdateIssueStatus 更新指定 Issue 的状态（仅当前持有者可更新）。\n159\tfunc (s *sqliteIssueStore) UpdateIssueStatus(ctx context.Context, repo string, number int, sessionID string, newStatus string) (*UpdateStatusResult, error) {\n160\t\tlogger.Debug(\"store.issue\", \"update status: repo=%s #%d -> %s\", repo, number, newStatus)\n161\t\n162\t\t// 查询当前状态\n163\t\tvar curStatus string\n164\t\tvar curOwner sql.NullString\n165\t\terr := s.db.QueryRowContext(ctx,\n166\t\t\t`SELECT status, session_id FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n167\t\t\trepo, number,\n168\t\t).Scan(&curStatus, &curOwner)\n169\t\tif err == sql.ErrNoRows {\n170\t\t\treturn &UpdateStatusResult{Updated: false}, nil\n171\t\t}\n172\t\tif err != nil {\n173\t\t\treturn nil, fmt.Errorf(\"query status: %w\", err)\n174\t\t}\n175\t\n176\t\t// 非持有者无法更新\n177\t\tif !curOwner.Valid || curOwner.String != sessionID {\n178\t\t\tlogger.Warn(\"store.issue\", \"status update rejected: not owner\")\n179\t\t\treturn &UpdateStatusResult{PreviousStatus: curStatus, Updated: false}, nil\n180\t\t}\n181\t\n182\t\t// 执行更新\n183\t\tres, err := s.db.ExecContext(ctx,\n184\t\t\t`UPDATE issue_claims SET status = ?, updated_at = CURRENT_TIMESTAMP\n185\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND session_id = ?`,\n186\t\t\tnewStatus, repo, number, sessionID,\n187\t\t)\n188\t\tif err != nil {\n189\t\t\treturn nil, fmt.Errorf(\"update status: %w\", err)\n190\t\t}\n191\t\tn, _ := res.RowsAffected()\n192\t\tif n > 0 {\n193\t\t\tlogger.Info(\"store.issue\", \"status updated: repo=%s #%d %s->%s\", repo, number, curStatus, newStatus)\n194\t\t}\n195\t\treturn &UpdateStatusResult{PreviousStatus: curStatus, NewStatus: newStatus, Updated: n > 0}, nil\n196\t}\n197\t\n198\t// ReleaseIssue 释放指定 session 持有的某个 Issue。\n199\t// 仅对非终态（非 merged/rejected）的 Issue 有效。\n200\tfunc (s *sqliteIssueStore) ReleaseIssue(ctx context.Context, repo string, number int, sessionID string) (bool, error) {\n201\t\tlogger.Debug(\"store.issue\", \"release: repo=%s #%d session=%s\", repo, number, sessionID)\n202\t\n203\t\t// 查询当前持有者\n204\t\tvar owner sql.NullString\n205\t\terr := s.db.QueryRowContext(ctx,\n206\t\t\t`SELECT session_id FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n207\t\t\trepo, number,\n208\t\t).Scan(&owner)\n209\t\tif err == sql.ErrNoRows {\n210\t\t\treturn false, nil\n211\t\t}\n212\t\tif err != nil {\n213\t\t\treturn false, fmt.Errorf(\"query owner: %w\", err)\n214\t\t}\n215\t\tif !owner.Valid || owner.String != sessionID {\n216\t\t\treturn false, nil\n217\t\t}\n218\t\n219\t\t// 释放：仅对非终态状态生效\n220\t\tres, err := s.db.ExecContext(ctx,\n221\t\t\t`UPDATE issue_claims\n222\t\t\t    SET status = 'idle', session_id = NULL, claimed_at = NULL, updated_at = CURRENT_TIMESTAMP\n223\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND session_id = ?\n224\t\t\t    AND status NOT IN ('merged', 'rejected')`,\n225\t\t\trepo, number, sessionID,\n226\t\t)\n227\t\tif err != nil {\n228\t\t\treturn false, fmt.Errorf(\"update: %w\", err)\n229\t\t}\n230\t\tn, _ := res.RowsAffected()\n231\t\treleased := n > 0\n232\t\tlogger.Info(\"store.issue\", \"issue released: repo=%s #%d released=%v\", repo, number, released)\n233\t\treturn released, nil\n234\t}\n235\t\n236\t// ReleaseSessionIssues 释放指定 session 持有的所有非终态 Issue。\n237\t// 返回被释放的 Issue 编号列表。\n238\tfunc (s *sqliteIssueStore) ReleaseSessionIssues(ctx context.Context, sessionID string) ([]int, error) {\n239\t\tlogger.Debug(\"store.issue\", \"release session: %s\", sessionID)\n240\t\n241\t\t// 先收集将要释放的 Issue 编号\n242\t\trows, err := s.db.QueryContext(ctx,\n243\t\t\t`SELECT issue_number FROM issue_claims\n244\t\t\t  WHERE session_id = ? AND status NOT IN ('merged', 'rejected')`,\n245\t\t\tsessionID,\n246\t\t)\n247\t\tif err != nil {\n248\t\t\treturn nil, fmt.Errorf(\"query session issues: %w\", err)\n249\t\t}\n250\t\n251\t\tvar numbers []int\n252\t\tfor rows.Next() {\n253\t\t\tvar n int\n254\t\t\tif err := rows.Scan(&n); err != nil {\n255\t\t\t\trows.Close()\n256\t\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n257\t\t\t}\n258\t\t\tnumbers = append(numbers, n)\n259\t\t}\n260\t\trows.Close()\n261\t\n262\t\tif len(numbers) == 0 {\n263\t\t\treturn nil, nil\n264\t\t}\n265\t\n266\t\t// 批量更新释放\n267\t\t_, err = s.db.ExecContext(ctx,\n268\t\t\t`UPDATE issue_claims\n269\t\t\t    SET status = 'idle', session_id = NULL, claimed_at = NULL, updated_at = CURRENT_TIMESTAMP\n270\t\t\t  WHERE session_id = ? AND status NOT IN ('merged', 'rejected')`,\n271\t\t\tsessionID,\n272\t\t)\n273\t\tif err != nil {\n274\t\t\treturn nil, fmt.Errorf(\"batch release: %w\", err)\n275\t\t}\n276\t\n277\t\tlogger.Info(\"store.issue\", \"released %d issues for session %s\", len(numbers), sessionID)\n278\t\treturn numbers, nil\n279\t}\n280\t"}]}
