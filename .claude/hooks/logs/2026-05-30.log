readJSON(t, resp, &result)\n92\t\n93\t\t\tif resp.StatusCode != http.StatusOK {\n94\t\t\t\tt.Fatalf(\"transition to %s: expected 200, got %d\", tr.to, resp.StatusCode)\n95\t\t\t}\n96\t\t\tif !result.Success {\n97\t\t\t\tt.Fatalf(\"transition to %s: expected success=true\", tr.to)\n98\t\t\t}\n99\t\t\tif result.PreviousStatus != tr.from {\n100\t\t\t\tt.Errorf(\"transition to %s: expected previous=%s, got %s\", tr.to, tr.from, result.PreviousStatus)\n101\t\t\t}\n102\t\t\tif result.NewStatus != tr.to {\n103\t\t\t\tt.Errorf(\"transition to %s: expected new=%s, got %s\", tr.to, tr.to, result.NewStatus)\n104\t\t\t}\n105\t\t}\n106\t\n107\t\t// 验证最终状态为 merged\n108\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{100})\n109\t\tif statuses[100] != \"merged\" {\n110\t\t\tt.Fatalf(\"expected merged, got %s\", statuses[100])\n111\t\t}\n112\t}\n113\t\n114\t// TestB4_FullStatusTransitionChain_Reject 验收：完整状态流转链 reviewing → rejected。\n115\t// 验证 issue 可以从 reviewing 状态流转到 rejected 终态。\n116\tfunc TestB4_FullStatusTransitionChain_Reject(t *testing.T) {\n117\t\tenv := setupTest(t)\n118\t\n119\t\tseedIssue(env.store.DB(), \"test/repo\", 101, \"reviewing\", \"sess_reject\", \"2026-05-27T10:00:00Z\")\n120\t\n121\t\tresp := env.post(t, \"/api/issue/status\",\n122\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":101,\"session_id\":\"sess_reject\",\"status\":\"rejected\"}`)\n123\t\n124\t\tvar result struct {\n125\t\t\tSuccess        bool   `json:\"success\"`\n126\t\t\tPreviousStatus string `json:\"previous_status\"`\n127\t\t\tNewStatus      string `json:\"new_status\"`\n128\t\t}\n129\t\treadJSON(t, resp, &result)\n130\t\n131\t\tif !result.Success {\n132\t\t\tt.Fatal(\"reject should succeed\")\n133\t\t}\n134\t\tif result.PreviousStatus != \"reviewing\" {\n135\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n136\t\t}\n137\t\tif result.NewStatus != \"rejected\" {\n138\t\t\tt.Errorf(\"expected new=rejected, got %s\", result.NewStatus)\n139\t\t}\n140\t}\n141\t\n142\t// TestB4_PreviousStatusInResponse 验收：previous_status 在响应中正确返回（每个阶段）。\n143\t// 验证从 claimed 更新到 fixing，以及从 fixing 更新到 ready-for-pr 时，响应都包含正确的前一状态。\n144\tfunc TestB4_PreviousStatusInResponse(t *testing.T) {\n145\t\tenv := setupTest(t)\n146\t\tseedIssue(env.store.DB(), \"test/repo\", 200, \"claimed\", \"sess_prev\", \"2026-05-27T10:00:00Z\")\n147\t\n148\t\t// 验证 claimed → fixing 的 previous_status\n149\t\tresp := env.post(t, \"/api/issue/status\",\n150\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":200,\"session_id\":\"sess_prev\",\"status\":\"fixing\"}`)\n151\t\tvar r struct {\n152\t\t\tSuccess        bool   `json:\"success\"`\n153\t\t\tPreviousStatus string `json:\"previous_status\"`\n154\t\t}\n155\t\treadJSON(t, resp, &r)\n156\t\tif !r.Success || r.PreviousStatus != \"claimed\" {\n157\t\t\tt.Fatalf(\"fixing: success=%v previous=%s\", r.Success, r.PreviousStatus)\n158\t\t}\n159\t\n160\t\t// 验证 fixing → ready-for-pr 的 previous_status\n161\t\tresp = env.post(t, \"/api/issue/status\",\n162\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":200,\"session_id\":\"sess_prev\",\"status\":\"ready-for-pr\"}`)\n163\t\treadJSON(t, resp, &r)\n164\t\tif !r.Success || r.PreviousStatus != \"fixing\" {\n165\t\t\tt.Fatalf(\"ready-for-pr: success=%v previous=%s\", r.Success, r.PreviousStatus)\n166\t\t}\n167\t}\n168\t\n169\t// TestB4_NonexistentIssueReturnsNotFound 验收：不存在的 issue 返回 not_found。\n170\t// 当尝试更新一个不存在的 issue 状态时，API 应返回 success=false 且 error=not_found。\n171\tfunc TestB4_NonexistentIssueReturnsNotFound(t *testing.T) {\n172\t\tenv := setupTest(t)\n173\t\n174\t\tresp := env.post(t, \"/api/issue/status\",\n175\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":99999,\"session_id\":\"sess_x\",\"status\":\"fixing\"}`)\n176\t\n177\t\tvar result struct {\n178\t\t\tSuccess bool   `json:\"success\"`\n179\t\t\tError   string `json:\"error\"`\n180\t\t}\n181\t\treadJSON(t, resp, &result)\n182\t\n183\t\tif result.Success {\n184\t\t\tt.Fatal(\"expected success=false for nonexistent issue\")\n185\t\t}\n186\t\tif result.Error != \"not_found\" {\n187\t\t\tt.Errorf(\"expected error=not_found, got %s\", result.Error)\n188\t\t}\n189\t}\n190\t\n191\t// TestB4_NonOwnerBlockedAcrossStatuses 验收：非领取者无法更新（跨所有状态阶段）。\n192\t// 遍历所有状态阶段，验证非 issue 拥有者尝试更新状态时都会被拒绝，返回 not_owner 错误。\n193\tfunc TestB4_NonOwnerBlockedAcrossStatuses(t *testing.T) {\n194\t\tenv := setupTest(t)\n195\t\tdb := env.store.DB()\n196\t\n197\t\tstatuses := []string{\"claimed\", \"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"}\n198\t\ttargets := []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\", \"merged\"}\n199\t\n200\t\tfor i, from := range statuses {\n201\t\t\tt.Run(from+\"_blocked\", func(t *testing.T) {\n202\t\t\t\tseedIssue(db, \"test/repo\", 300+i, from, \"sess_owner\", \"2026-05-27T10:00:00Z\")\n203\t\n204\t\t\t\tresp := env.post(t, \"/api/issue/status\",\n205\t\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":`+fmt.Sprintf(\"%d\", 300+i)+`,\"session_id\":\"sess_other\",\"status\":\"`+targets[i]+`\"}`)\n206\t\n207\t\t\t\tvar result struct {\n208\t\t\t\t\tSuccess bool   `json:\"success\"`\n209\t\t\t\t\tError   string `json:\"error\"`\n210\t\t\t\t}\n211\t\t\t\treadJSON(t, resp, &result)\n212\t\n213\t\t\t\tif result.Success {\n214\t\t\t\t\tt.Errorf(\"%s→%s: non-owner should not be able to update\", from, targets[i])\n215\t\t\t\t}\n216\t\t\t\tif result.Error != \"not_owner\" {\n217\t\t\t\t\tt.Errorf(\"%s→%s: expected not_owner, got %s\", from, targets[i], result.Error)\n218\t\t\t\t}\n219\t\t\t})\n220\t\t}\n221\t}\n222\t\n223\t// TestB4_StatusMethodNotAllowed 验收：POST /api/issue/status 非 POST 方法返回 405。\n224\t// 验证使用 GET 请求访问状态更新接口时，服务器返回 405 Method Not Allowed。\n225\tfunc TestB4_StatusMethodNotAllowed(t *testing.T) {\n226\t\tenv := setupTest(t)\n227\t\n228\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/status\")\n229\t\tif err != nil {\n230\t\t\tt.Fatal(err)\n231\t\t}\n232\t\tdefer resp.Body.Close()\n233\t\n234\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n235\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n236\t\t}\n237\t}\n238\t"}]}
