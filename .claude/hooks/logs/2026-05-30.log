nch      string   `json:\"git_branch,omitempty\"` // Git 分支（可选）\n35\t\tSourceSlug     string   `json:\"source_slug\"`     // 来源 slug\n36\t\tCollectedAt    string   `json:\"collected_at\"`    // 收集时间（RFC3339 格式）\n37\t}\n38\t\n39\t// SessionDir 返回指定 slug 在 baseDir 下的会话存储目录。\n40\t// 使用 slug（由路径派生，全局唯一）作为目录名，可避免不同路径下同名的项目发生冲突\n41\t//（例如 D:\\work\\app 与 D:\\personal\\app）。\n42\tfunc SessionDir(baseDir, slug string) string {\n43\t\treturn filepath.Join(baseDir, \"sessions\", slug)\n44\t}\n45\t\n46\t// BaseDir 返回可执行文件所在的目录，作为所有本地存储的根目录。\n47\tfunc BaseDir() string {\n48\t\texe, err := os.Executable()\n49\t\tif err != nil {\n50\t\t\treturn \".\"\n51\t\t}\n52\t\treturn filepath.Dir(exe)\n53\t}\n54\t\n55\t// LoadMeta 从指定目录读取 meta.json 文件。\n56\t// 如果文件不存在，则返回一个空的 SessionMeta（含空会话列表）。\n57\tfunc LoadMeta(dir string) (*SessionMeta, error) {\n58\t\tpath := filepath.Join(dir, \"meta.json\")\n59\t\tdata, err := os.ReadFile(path)\n60\t\tif err != nil {\n61\t\t\tif os.IsNotExist(err) {\n62\t\t\t\treturn &SessionMeta{Sessions: []SessionEntry{}}, nil\n63\t\t\t}\n64\t\t\treturn nil, fmt.Errorf(\"read meta.json: %w\", err)\n65\t\t}\n66\t\tvar meta SessionMeta\n67\t\tif err := json.Unmarshal(data, &meta); err != nil {\n68\t\t\treturn nil, fmt.Errorf(\"parse meta.json: %w\", err)\n69\t\t}\n70\t\treturn &meta, nil\n71\t}\n72\t\n73\t// SaveMeta 将 meta.json 写入指定目录。\n74\t// 如果目录不存在会自动创建。\n75\tfunc SaveMeta(dir string, meta *SessionMeta) error {\n76\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n77\t\t\treturn fmt.Errorf(\"create session dir: %w\", err)\n78\t\t}\n79\t\tdata, err := json.MarshalIndent(meta, \"\", \"  \")\n80\t\tif err != nil {\n81\t\t\treturn fmt.Errorf(\"marshal meta.json: %w\", err)\n82\t\t}\n83\t\tpath := filepath.Join(dir, \"meta.json\")\n84\t\treturn os.WriteFile(path, data, 0o644)\n85\t}\n86\t\n87\t// ParseSessionJSONL 扫描一个 JSONL 文件以提取会话元数据。\n88\t// 逐行读取文件，收集：会话 ID、时间戳、使用的模型、Git 分支、记录条数等。\n89\tfunc ParseSessionJSONL(path string, sourceSlug string) (*SessionEntry, error) {\n90\t\tf, err := os.Open(path)\n91\t\tif err != nil {\n92\t\t\treturn nil, fmt.Errorf(\"open jsonl: %w\", err)\n93\t\t}\n94\t\tdefer f.Close()\n95\t\n96\t\tfi, err := f.Stat()\n97\t\tif err != nil {\n98\t\t\treturn nil, fmt.Errorf(\"stat jsonl: %w\", err)\n99\t\t}\n100\t\n101\t\tscanner := bufio.NewScanner(f)\n102\t\t// 允许每行最大 1MB（Claude 的 JSONL 行可能很大）。\n103\t\tscanner.Buffer(make([]byte, 0, 64*1024), 1024*1024)\n104\t\n105\t\tvar (\n106\t\t\tcount     int\n107\t\t\tsessionID string\n108\t\t\tfirstTS   string\n109\t\t\tlastTS    string\n110\t\t\tmodelsMap = map[string]bool{}\n111\t\t\tgitBranch string\n112\t\t)\n113\t\n114\t\tfor scanner.Scan() {\n115\t\t\tline := scanner.Text()\n116\t\t\tif len(line) == 0 {\n117\t\t\t\tcontinue\n118\t\t\t}\n119\t\t\tcount++\n120\t\n121\t\t\tvar record map[string]any\n122\t\t\tif err := json.Unmarshal([]byte(line), &record); err != nil {\n123\t\t\t\tcontinue\n124\t\t\t}\n125\t\n126\t\t\t// 从第一条记录中提取 session_id。\n127\t\t\tif sessionID == \"\" {\n128\t\t\t\tif sid, ok := record[\"sessionId\"].(string); ok {\n129\t\t\t\t\tsessionID = sid\n130\t\t\t\t}\n131\t\t\t}\n132\t\n133\t\t\t// 追踪最早和最晚的时间戳。\n134\t\t\tif ts, ok := record[\"timestamp\"].(string); ok && ts != \"\" {\n135\t\t\t\tif firstTS == \"\" {\n136\t\t\t\t\tfirstTS = ts\n137\t\t\t\t}\n138\t\t\t\tlastTS = ts\n139\t\t\t}\n140\t\n141\t\t\t// 从 message 字段中提取模型信息（助手回复记录）。\n142\t\t\tif msg, ok := record[\"message\"].(map[string]any); ok {\n143\t\t\t\tif model, ok := msg[\"model\"].(string); ok && model != \"\" {\n144\t\t\t\t\tmodelsMap[model] = true\n145\t\t\t\t}\n146\t\t\t}\n147\t\n148\t\t\t// 从用户记录中提取 Git 分支。\n149\t\t\tif branch, ok := record[\"gitBranch\"].(string); ok && branch != \"\" {\n150\t\t\t\tgitBranch = branch\n151\t\t\t}\n152\t\t}\n153\t\n154\t\t// 如果 JSONL 中未提取到 session_id，则使用文件名作为回退。\n155\t\tif sessionID == \"\" {\n156\t\t\tsessionID = strings.TrimSuffix(filepath.Base(path), \".jsonl\")\n157\t\t}\n158\t\n159\t\tmodels := make([]string, 0, len(modelsMap))\n160\t\tfor m := range modelsMap {\n161\t\t\tmodels = append(models, m)\n162\t\t}\n163\t\n164\t\treturn &SessionEntry{\n165\t\t\tSessionID:      sessionID,\n166\t\t\tFile:           filepath.Base(path),\n167\t\t\tFileSize:       fi.Size(),\n168\t\t\tRecordCount:    count,\n169\t\t\tFirstTimestamp: firstTS,\n170\t\t\tLastTimestamp:  lastTS,\n171\t\t\tModelsUsed:     models,\n172\t\t\tGitBranch:      gitBranch,\n173\t\t\tSourceSlug:     sourceSlug,\n174\t\t\tCollectedAt:    time.Now().UTC().Format(time.RFC3339),\n175\t\t}, nil\n176\t}\n177\t\n178\t// FindSessionJSONLFiles 列出目录中所有看起来像会话文件的 .jsonl 文件。\n179\t// 会话文件名需符合 UUID 模式：{sessionId}.jsonl（至少包含 4 个短横线）。\n180\tfunc FindSessionJSONLFiles(dir string) ([]string, error) {\n181\t\tentries, err := os.ReadDir(dir)\n182\t\tif err != nil {\n183\t\t\treturn nil, err\n184\t\t}\n185\t\tvar files []string\n186\t\tfor _, entry := range entries {\n187\t\t\tname := entry.Name()\n188\t\t\tif entry.IsDir() {\n189\t\t\t\tcontinue\n190\t\t\t}\n191\t\t\t// 会话文件格式为 {uuid}.jsonl — UUID 包含 4 个短横线。\n192\t\t\tif strings.HasSuffix(name, \".jsonl\") && strings.Count(name, \"-\") >= 4 {\n193\t\t\t\tfiles = append(files, filepath.Join(dir, name))\n194\t\t\t}\n195\t\t}\n196\t\treturn files, nil\n197\t}\n198\t\n199\t// copyFile 将单个文件从 src 复制到 dst。\n200\t// 会自动创建目标文件所在目录。\n201\tfunc copyFile(dst, src string) error {\n202\t\tin, err := os.Open(src)\n203\t\tif err != nil {\n204\t\t\treturn err\n205\t\t}\n206\t\tdefer in.Close()\n207\t\n208\t\tif err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {\n209\t\t\treturn err\n210\t\t}\n211\t\n212\t\tout, err := os.Create(dst)\n213\t\tif err != nil {\n214\t\t\treturn err\n215\t\t}\n216\t\tdefer out.Close()\n217\t\n218\t\t_, err = io.Copy(out, in)\n219\t\treturn err\n220\t}\n221\t"}]}
