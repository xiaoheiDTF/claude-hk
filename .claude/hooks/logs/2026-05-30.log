45\t\t}\n46\t\tlogger.Debug(\"config\", \"claude config loaded: base_url=%s\", cfg.BaseURL)\n47\t\treturn &cfg, nil\n48\t}\n49\t\n50\t// ClaudeBaseURLFromConfig 从 ClaudeConfig 中提取 base URL，\n51\t// 优先检查 env 下的 AnthropicBaseURL，其次使用顶层的 BaseURL。\n52\tfunc ClaudeBaseURLFromConfig(cfg *ClaudeConfig) string {\n53\t\tif cfg == nil {\n54\t\t\treturn \"\"\n55\t\t}\n56\t\tif cfg.Env.AnthropicBaseURL != \"\" {\n57\t\t\treturn cfg.Env.AnthropicBaseURL\n58\t\t}\n59\t\treturn cfg.BaseURL\n60\t}\n61\t\n62\t// HomeDir 返回跨平台的用户主目录。\n63\t// Windows 下优先使用 USERPROFILE 环境变量。\n64\tfunc HomeDir() string {\n65\t\tif runtime.GOOS == \"windows\" {\n66\t\t\tif home := os.Getenv(\"USERPROFILE\"); home != \"\" {\n67\t\t\t\treturn home\n68\t\t\t}\n69\t\t}\n70\t\thome, _ := os.UserHomeDir()\n71\t\treturn home\n72\t}\n73\t"}]}
