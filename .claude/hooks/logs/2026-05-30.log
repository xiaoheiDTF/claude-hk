[2026-05-30 14:54:48] [INFO] [PostToolBatch] Input: {"session_id":"b63b113f-845a-45c4-bb3d-eca702572f62","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\b63b113f-845a-45c4-bb3d-eca702572f62.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"auto","agent_id":"a500bc0bd925f53d4","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\logger\\logger.go"},"tool_use_id":"call_bcaa7fbfd132429e8ae8887e","tool_response":"1\t// Package logger 提供按日期分割的文件日志功能。\n2\t//\n3\t// 日志文件命名格式：{dir}/YYYY-MM-DD.log\n4\t// 日志行格式：15:04:05.000 [LEVEL] module: message\n5\t//\n6\t// 使用方式：\n7\t//\n8\t//\tlogger.Init(dir, true, logger.DEBUG)\n9\t//\tdefer logger.Close()\n10\t//\tlogger.Info(\"proxy\", \"started on :8080\")\n11\t//\tlogger.Debug(\"store\", \"query: %s\", sql)\n12\tpackage logger\n13\t\n14\timport (\n15\t\t\"fmt\"\n16\t\t\"io\"\n17\t\t\"os\"\n18\t\t\"path/filepath\"\n19\t\t\"sync\"\n20\t\t\"time\"\n21\t)\n22\t\n23\t// Level 表示日志级别。\n24\ttype Level int\n25\t\n26\tconst (\n27\t\tDEBUG Level = iota // DEBUG 调试级别\n28\t\tINFO               // INFO  信息级别\n29\t\tWARN               // WARN  警告级别\n30\t\tERROR              // ERROR 错误级别\n31\t)\n32\t\n33\tvar (\n34\t\tmu          sync.Mutex // 保护文件句柄与全局状态\n35\t\tfile        *os.File   // 当前日志文件\n36\t\tdir         string     // 日志存放目录\n37\t\tconsole     bool       // 是否同时输出到 stderr\n38\t\tminLevel    Level = INFO\n39\t\tcurrentDate string     // 当前日志文件对应的日期\n40\t\twriter      io.Writer  // 包装 file 的写入器\n41\t)\n42\t\n43\t// Init 初始化全局日志器。\n44\t//\n45\t// 参数：\n46\t//   - dir: 日志文件存放目录（自动创建）\n47\t//   - consoleEnabled: 是否同时输出到 stderr（仅 INFO 及以上）\n48\t//   - level: 最低日志级别\n49\t//\n50\t// 可多次调用以切换目录或级别。\n51\tfunc Init(d string, consoleEnabled bool, level Level) error {\n52\t\tmu.Lock()\n53\t\tdefer mu.Unlock()\n54\t\n55\t\tminLevel = level\n56\t\tconsole = consoleEnabled\n57\t\n58\t\tif d == \"\" {\n59\t\t\t// 空目录：静默模式，所有写入被丢弃\n60\t\t\tif file != nil {\n61\t\t\t\tfile.Close()\n62\t\t\t}\n63\t\t\tfile = nil\n64\t\t\tdir = \"\"\n65\t\t\tcurrentDate = \"\"\n66\t\t\twriter = nil\n67\t\t\treturn nil\n68\t\t}\n69\t\n70\t\t// 创建目录\n71\t\tif err := os.MkdirAll(d, 0o755); err != nil {\n72\t\t\treturn fmt.Errorf(\"logger: create dir %s: %w\", d, err)\n73\t\t}\n74\t\n75\t\tdir = d\n76\t\n77\t\t// 打开当天的日志文件\n78\t\ttoday := time.Now().Format(\"2006-01-02\")\n79\t\tif err := rotateFile(today); err != nil {\n80\t\t\treturn err\n81\t\t}\n82\t\n83\t\treturn nil\n84\t}\n85\t\n86\t// Close 刷新并关闭当前日志文件。\n87\tfunc Close() error {\n88\t\tmu.Lock()\n89\t\tdefer mu.Unlock()\n90\t\tif file != nil {\n91\t\t\terr := file.Close()\n92\t\t\tfile = nil\n93\t\t\twriter = nil\n94\t\t\tcurrentDate = \"\"\n95\t\t\treturn err\n96\t\t}\n97\t\treturn nil\n98\t}\n99\t\n100\t// SetLevel 运行时调整最低日志级别。\n101\tfunc SetLevel(level Level) {\n102\t\tmu.Lock()\n103\t\tdefer mu.Unlock()\n104\t\tminLevel = level\n105\t}\n106\t\n107\t// Debug 记录 DEBUG 级别日志。\n108\tfunc Debug(module, format string, args ...any) {\n109\t\twrite(DEBUG, module, format, args...)\n110\t}\n111\t\n112\t// Info 记录 INFO 级别日志。\n113\tfunc Info(module, format string, args ...any) {\n114\t\twrite(INFO, module, format, args...)\n115\t}\n116\t\n117\t// Warn 记录 WARN 级别日志。\n118\tfunc Warn(module, format string, args ...any) {\n119\t\twrite(WARN, module, format, args...)\n120\t}\n121\t\n122\t// Error 记录 ERROR 级别日志。\n123\tfunc Error(module, format string, args ...any) {\n124\t\twrite(ERROR, module, format, args...)\n125\t}\n126\t\n127\tvar levelNames = [4]string{\"DEBUG\", \"INFO \", \"WARN \", \"ERROR\"}\n128\t\n129\t// write 是所有日志方法的核心实现。\n130\t//\n131\t// 检查级别 → 加锁 → 检查日期轮转 → 格式化 → 写文件 → 可选写 stderr\n132\tfunc write(level Level, module, format string, args ...any) {\n133\t\tif level < minLevel {\n134\t\t\treturn\n135\t\t}\n136\t\n137\t\tmu.Lock()\n138\t\tdefer mu.Unlock()\n139\t\n140\t\t// 日期轮转检查（懒检测）\n141\t\ttoday := time.Now().Format(\"2006-01-02\")\n142\t\tif today != currentDate && dir != \"\" {\n143\t\t\t_ = rotateFile(today)\n144\t\t}\n145\t\n146\t\t// 格式化日志行：15:04:05.000 [LEVEL] module: message\n147\t\tts := time.Now().Format(\"15:04:05.000\")\n148\t\tmsg := fmt.Sprintf(format, args...)\n149\t\tline := fmt.Sprintf(\"%s [%s] %s: %s\\n\", ts, levelNames[level], module, msg)\n150\t\n151\t\t// 写入文件\n152\t\tif writer != nil {\n153\t\t\t_, _ = writer.Write([]byte(line))\n154\t\t}\n155\t\n156\t\t// 可选：同时输出到 stderr（仅 INFO 及以上）\n157\t\tif console && level >= INFO {\n158\t\t\t_, _ = fmt.Fprint(os.Stderr, line)\n159\t\t}\n160\t}\n161\t\n162\t// rotateFile 关闭旧文件并打开新日期的日志文件。\n163\t// 调用方必须持有 mu 锁。\n164\tfunc rotateFile(date string) error {\n165\t\tif file != nil {\n166\t\t\tfile.Close()\n167\t\t\tfile = nil\n168\t\t\twriter = nil\n169\t\t}\n170\t\n171\t\tpath := filepath.Join(dir, date+\".log\")\n172\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)\n173\t\tif err != nil {\n174\t\t\tfmt.Fprintf(os.Stderr, \"logger: failed to open %s: %v\\n\", path, err)\n175\t\t\treturn err\n176\t\t}\n177\t\n178\t\tfile = f\n179\t\twriter = f\n180\t\tcurrentDate = date\n181\t\treturn nil\n182\t}\n183\t"}]}
