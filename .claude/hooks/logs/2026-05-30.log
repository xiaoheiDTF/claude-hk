))]'\n38\t}\n39\t\n40\t# 原子领取 issue\n41\tclaim_issue_backend() {\n42\t  local issue_num=\"$1\"\n43\t  local issue_title=\"$2\"\n44\t\n45\t  _load_backend_url\n46\t  [ -z \"$BACKEND_URL\" ] && return 0  # 未配置后端，跳过（单 agent 模式）\n47\t\n48\t  local session_id\n49\t  session_id=$(_get_session_id)\n50\t  [ -z \"$session_id\" ] && return 0\n51\t\n52\t  local repo\n53\t  repo=$(_get_repo)\n54\t  [ -z \"$repo\" ] && return 0\n55\t\n56\t  # 后端已配置但不可达 → 阻止领取（防多 agent 冲突）\n57\t  if ! _backend_available; then\n58\t    skill_log \"ERROR\" \"Backend unreachable, BLOCKING claim for #$issue_num\"\n59\t    echo \"ERROR: Backend server is unreachable. Cannot safely claim issue #$issue_num (risk of multi-agent conflict).\"\n60\t    echo \"Please ensure the backend is running at $BACKEND_URL and try again.\"\n61\t    return 1\n62\t  fi\n63\t\n64\t  local result\n65\t  result=$(_call_backend \"/api/issue/claim\" \"{\n66\t    \\\"repo_full_name\\\":\\\"$repo\\\",\n67\t    \\\"issue_number\\\":$issue_num,\n68\t    \\\"session_id\\\":\\\"$session_id\\\",\n69\t    \\\"issue_title\\\":\\\"$issue_title\\\"\n70\t  }\")\n71\t\n72\t  if [ -z \"$result\" ]; then\n73\t    skill_log \"ERROR\" \"Backend claim call returned empty for #$issue_num\"\n74\t    echo \"ERROR: Backend claim call failed unexpectedly for issue #$issue_num.\"\n75\t    return 1\n76\t  fi\n77\t\n78\t  if ! echo \"$result\" | jq -e '.success' > /dev/null 2>&1; then\n79\t    local claimed_by\n80\t    claimed_by=$(echo \"$result\" | jq -r '.claimed_by // \"unknown\"')\n81\t    echo \"ERROR: Issue #$issue_num 已被 $claimed_by 领取\"\n82\t    return 1\n83\t  fi\n84\t\n85\t  return 0\n86\t}\n87\t\n88\t# 从 prompt 提取 issue 编号\n89\tPROMPT=\"$1\"\n90\tISSUE_NUM=$(echo \"$PROMPT\" | grep -oE '#[0-9]+' | head -1 | tr -d '#')\n91\t\n92\techo \"=== Issue 领取上下文 ===\"\n93\techo \"日期: $(date +%Y-%m-%d)\"\n94\t\n95\tif [ -n \"$ISSUE_NUM\" ]; then\n96\t  if _gh --version &>/dev/null; then\n97\t    echo \"Issue #$ISSUE_NUM 状态:\"\n98\t    _gh issue view \