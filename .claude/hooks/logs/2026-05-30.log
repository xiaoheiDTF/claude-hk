json:\"session_id\"`     // 当前持有者的会话 ID\n35\t\tStatus       string `json:\"status\"`         // 新状态\n36\t}\n37\t\n38\t// --- Session request types ---\n39\t\n40\t// RegisterSessionRequest 是注册新会话的请求体。\n41\ttype RegisterSessionRequest struct {\n42\t\tSessionID      string `json:\"session_id\"`      // 会话唯一 ID（UUID）\n43\t\tMachineID      string `json:\"machine_id\"`      // 机器标识，格式为 whoami@hostname\n44\t\tOS             string `json:\"os\"`              // 操作系统类型\n45\t\tProjectSlug    string `json:\"project_slug\"`    // 项目标识\n46\t\tProjectCwd     string `json:\"project_cwd\"`     // 项目工作目录\n47\t\tTranscriptPath string `json:\"transcript_path\"` // 对话记录文件路径\n48\t\tLocalTracePath string `json:\"local_trace_path\"` // 本地跟踪文件路径\n49\t\tModel          string `json:\"model\"`           // 使用的模型\n50\t\tSource         string `json:\"source\"`          // 会话来源（如 startup/resume）\n51\t}\n52\t\n53\t// CloseSessionRequest 是关闭会话的请求体。\n54\ttype CloseSessionRequest struct {\n55\t\tSessionID string `json:\"session_id\"` // 要关闭的会话 ID\n56\t\tReason    string `json:\"reason\"`     // 关闭原因\n57\t}\n58\t"}]}
