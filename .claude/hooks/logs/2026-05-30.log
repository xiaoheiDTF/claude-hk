[2026-05-30 16:50:22] [INFO] [PostToolBatch] Input: {"session_id":"85b4b220-e119-417e-b974-e5edde848812","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\85b4b220-e119-417e-b974-e5edde848812.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"plan","agent_id":"a0576172aca06ebad","agent_type":"Plan","effort":{"level":"xhigh"},"hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\tests\\trace\\writer_test.go"},"tool_use_id":"call_0924734817ff45dc86a21340","tool_response":"1\t// Package trace_test 包含追踪写入器的单元测试，覆盖文件创建、记录写入、统计汇总等功能。\n2\tpackage trace_test\n3\t\n4\timport (\n5\t\t\"encoding/json\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n12\t)\n13\t\n14\t// TestNewTracePath 验证：追踪文件路径格式正确。\n15\t// 路径应包含日期、时间和随机十六进制后缀，以 .jsonl 结尾。\n16\tfunc TestNewTracePath(t *testing.T) {\n17\t\tpath := trace.NewTracePath(\"/tmp/traces\")\n18\t\t// 路径格式：/tmp/traces/{project}/{date}_{time}_{hex}.jsonl\n19\t\tfilename := filepath.Base(path)\n20\t\tif !strings.HasSuffix(filename, \".jsonl\") {\n21\t\t\tt.Errorf(\"expected .jsonl suffix, got %q\", filename)\n22\t\t}\n23\t\t// 文件名格式：2006-01-02_150405_a1b2c3.jsonl\n24\t\tparts := strings.Split(strings.TrimSuffix(filename, \".jsonl\"), \"_\")\n25\t\tif len(parts) != 3 {\n26\t\t\tt.Errorf(\"expected 3-part filename (date_time_hex), got %d parts: %q\", len(parts), parts)\n27\t\t}\n28\t\tif len(parts[0]) != 10 || parts[0][4] != '-' {\n29\t\t\tt.Errorf(\"expected date prefix YYYY-MM-DD, got %q\", parts[0])\n30\t\t}\n31\t}\n32\t\n33\t// TestTraceWriterWriteAndSummary 验证：追踪写入器能正确写入记录并汇总统计。\n34\t// 写入两条记录后，验证 API 调用次数、输入/输出 token 数、模型使用次数。\n35\tfunc TestTraceWriterWriteAndSummary(t *testing.T) {\n36\t\tdir := t.TempDir()\n37\t\ttracePath := filepath.Join(dir, \"test_trace.jsonl\")\n38\t\n39\t\tw, err := trace.NewTraceWriter(tracePath)\n40\t\tif err != nil {\n41\t\t\tt.Fatalf(\"NewTraceWriter: %v\", err)\n42\t\t}\n43\t\n44\t\t// 写入第一条记录\n45\t\trecord := map[string]any{\n46\t\t\t\"request_id\": \"req_001\",\n47\t\t\t\"turn\":       1,\n48\t\t\t\"request\": map[string]any{\n49\t\t\t\t\"method\": \"POST\",\n50\t\t\t\t\"path\":   \"/v1/messages\",\n51\t\t\t\t\"body\":   map[string]any{\"model\": \"claude-3\"},\n52\t\t\t},\n53\t\t\t\"response\": map[string]any{\n54\t\t\t\t\"status\": 200,\n55\t\t\t\t\"body\": map[string]any{\n56\t\t\t\t\t\"usage\": map[string]any{\n57\t\t\t\t\t\t\"input_tokens\":  float64(100),\n58\t\t\t\t\t\t\"output_tokens\": float64(50),\n59\t\t\t\t\t},\n60\t\t\t\t},\n61\t\t\t},\n62\t\t}\n63\t\n64\t\tif err := w.Write(record); err != nil {\n65\t\t\tt.Fatalf(\"Write: %v\", err)\n66\t\t}\n67\t\n68\t\t// 写入第二条记录\n69\t\trecord2 := map[string]any{\n70\t\t\t\"request_id\": \"req_002\",\n71\t\t\t\"turn\":       2,\n72\t\t\t\"request\": map[string]any{\n73\t\t\t\t\"method\": \"POST\",\n74\t\t\t\t\"path\":   \"/v1/messages\",\n75\t\t\t\t\"body\":   map[string]any{\"model\": \"claude-3\"},\n76\t\t\t},\n77\t\t\t\"response\": map[string]any{\n78\t\t\t\t\"status\": 200,\n79\t\t\t\t\"body\": map[string]any{\n80\t\t\t\t\t\"usage\": map[string]any{\n81\t\t\t\t\t\t\"input_tokens\":  float64(200),\n82\t\t\t\t\t\t\"output_tokens\": float64(80),\n83\t\t\t\t\t},\n84\t\t\t\t},\n85\t\t\t},\n86\t\t}\n87\t\tif err := w.Write(record2); err != nil {\n88\t\t\tt.Fatalf(\"Write second record: %v\", err)\n89\t\t}\n90\t\n91\t\t// 验证汇总统计\n92\t\tsummary := w.Summary()\n93\t\tif summary[\"api_calls\"] != 2 {\n94\t\t\tt.Errorf(\"expected 2 api_calls, got %v\", summary[\"api_calls\"])\n95\t\t}\n96\t\tif summary[\"input_tokens\"] != int64(300) {\n97\t\t\tt.Errorf(\"expected 300 input_tokens, got %v\", summary[\"input_tokens\"])\n98\t\t}\n99\t\tif summary[\"output_tokens\"] != int64(130) {\n100\t\t\tt.Errorf(\"expected 130 output_tokens, got %v\", summary[\"output_tokens\"])\n101\t\t}\n102\t\n103\t\tmodels := summary[\"models_used\"].(map[string]int)\n104\t\tif models[\"claude-3\"] != 2 {\n105\t\t\tt.Errorf(\"expected claude-3 count 2, got %v\", models)\n106\t\t}\n107\t\n108\t\tif err := w.Close(); err != nil {\n109\t\t\tt.Fatalf(\"Close: %v\", err)\n110\t\t}\n111\t\n112\t\t// 验证文件内容\n113\t\tdata, err := os.ReadFile(tracePath)\n114\t\tif err != nil {\n115\t\t\tt.Fatalf(\"read trace file: %v\", err)\n116\t\t}\n117\t\n118\t\tlines := splitLines(string(data))\n119\t\tif len(lines) != 2 {\n120\t\t\tt.Fatalf(\"expected 2 JSONL lines, got %d\", len(lines))\n121\t\t}\n122\t\n123\t\tvar first map[string]any\n124\t\tif err := json.Unmarshal([]byte(lines[0]), &first); err != nil {\n125\t\t\tt.Fatalf(\"parse first line: %v\", err)\n126\t\t}\n127\t\tif first[\"request_id\"] != \"req_001\" {\n128\t\t\tt.Errorf(\"first record request_id: got %v, want req_001\", first[\"request_id\"])\n129\t\t}\n130\t}\n131\t\n132\t// TestTraceWriterCreatesDirectory 验证：追踪写入器能自动创建嵌套目录。\n133\tfunc TestTraceWriterCreatesDirectory(t *testing.T) {\n134\t\tdir := t.TempDir()\n135\t\tnestedPath := filepath.Join(dir, \"sub1\", \"sub2\", \"trace.jsonl\")\n136\t\n137\t\tw, err := trace.NewTraceWriter(nestedPath)\n138\t\tif err != nil {\n139\t\t\tt.Fatalf(\"NewTraceWriter with nested dirs: %v\", err)\n140\t\t}\n141\t\tdefer w.Close()\n142\t\n143\t\tif _, err := os.Stat(filepath.Dir(nestedPath)); os.IsNotExist(err) {\n144\t\t\tt.Error(\"expected nested directories to be created\")\n145\t\t}\n146\t}\n147\t\n148\t// TestTraceWriterCacheTokenStats 验证：缓存 token（cache_read_tokens、cache_create_tokens）被正确统计。\n149\tfunc TestTraceWriterCacheTokenStats(t *testing.T) {\n150\t\tdir := t.TempDir()\n151\t\tw, err := trace.NewTraceWriter(filepath.Join(dir, \"cache_test.jsonl\"))\n152\t\tif err != nil {\n153\t\t\tt.Fatalf(\"NewTraceWriter: %v\", err)\n154\t\t}\n155\t\tdefer w.Close()\n156\t\n157\t\trecord := map[string]any{\n158\t\t\t\"request\": map[string]any{\n159\t\t\t\t\"body\": map[string]any{\"model\": \"claude-3\"},\n160\t\t\t},\n161\t\t\t\"response\": map[string]any{\n162\t\t\t\t\"body\": map[string]any{\n163\t\t\t\t\t\"usage\": map[string]any{\n164\t\t\t\t\t\t\"input_tokens\":                float64(100),\n165\t\t\t\t\t\t\"output_tokens\":               float64(50),\n166\t\t\t\t\t\t\"cache_read_input_tokens\":     float64(30),\n167\t\t\t\t\t\t\"cache_creation_input_tokens\": float64(10),\n168\t\t\t\t\t},\n169\t\t\t\t},\n170\t\t\t},\n171\t\t}\n172\t\n173\t\tif err := w.Write(record); err != nil {\n174\t\t\tt.Fatalf(\"Write: %v\", err)\n175\t\t}\n176\t\n177\t\tsummary := w.Summary()\n178\t\tif summary[\"cache_read_tokens\"] != int64(30) {\n179\t\t\tt.Errorf(\"cache_read_tokens: got %v, want 30\", summary[\"cache_read_tokens\"])\n180\t\t}\n181\t\tif summary[\"cache_create_tokens\"] != int64(10) {\n182\t\t\tt.Errorf(\"cache_create_tokens: got %v, want 10\", summary[\"cache_create_tokens\"])\n183\t\t}\n184\t}\n185\t\n186\t// splitLines 将字符串按换行符分割，过滤空行。\n187\tfunc splitLines(s string) []string {\n188\t\tvar lines []string\n189\t\tfor _, line := range strings.Split(s, \"\\n\") {\n190\t\t\tif line != \"\" {\n191\t\t\t\tlines = append(lines, line)\n192\t\t\t}\n193\t\t}\n194\t\treturn lines\n195\t}\n196\t\n197\t// TestMachineID 验证：MachineID 返回非空字符串，且包含用户名和主机名。\n198\tfunc TestMachineID(t *testing.T) {\n199\t\tmid := trace.MachineID()\n200\t\tif mid == \"\" {\n201\t\t\tt.Fatal(\"MachineID should not be empty\")\n202\t\t}\n203\t\tif !strings.Contains(mid, \"@\") {\n204\t\t\tt.Errorf(\"MachineID should contain '@', got %q\", mid)\n205\t\t}\n206\t\tparts := strings.SplitN(mid, \"@\", 2)\n207\t\tif parts[0] == \"\" || parts[1] == \"\" {\n208\t\t\tt.Errorf(\"MachineID should have non-empty username and hostname, got %q\", mid)\n209\t\t}\n210\t}\n211\t\n212\t// TestExtractProjectSlug 验证：从追踪文件路径中提取项目 slug。\n213\tfunc TestExtractProjectSlug(t *testing.T) {\n214\t\ttests := []struct {\n215\t\t\tname  string\n216\t\t\tinput string\n217\t\t\twant  string\n218\t\t}{\n219\t\t\t{\"windows_path\", `C:\\Users\\Admin\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\uuid.jsonl`, \"D--CodeDevelopment-CodeProject-claude-hk\"},\n220\t\t\t{\"unix_path\", \"/home/user/.claude/projects/D--CodeDevelopment-CodeProject-claude-hk/uuid.jsonl\", \"D--CodeDevelopment-CodeProject-claude-hk\"},\n221\t\t\t{\"empty\", \"\", \"\"},\n222\t\t\t{\"no_projects_segment\", \"/some/random/path.jsonl\", \"\"},\n223\t\t}\n224\t\n225\t\tfor _, tt := range tests {\n226\t\t\tt.Run(tt.name, func(t *testing.T) {\n227\t\t\t\tgot := trace.ExtractProjectSlug(tt.input)\n228\t\t\t\tif got != tt.want {\n229\t\t\t\t\tt.Errorf(\"ExtractProjectSlug(%q) = %q, want %q\", tt.input, got, tt.want)\n230\t\t\t\t}\n231\t\t\t})\n232\t\t}\n233\t}\n234\t\n235\t// TestNewSessionTracePath 验证：Session 追踪路径按 machine_id/project_slug/session_id.jsonl 格式生成。\n236\tfunc TestNewSessionTracePath(t *testing.T) {\n237\t\tpath := trace.NewSessionTracePath(\"/tmp/traces\", \"user@host\", \"D--my-project\", \"abc-123\")\n238\t\texpected := filepath.Join(\"/tmp/traces\", \"user@host\", \"D--my-project\", \"abc-123.jsonl\")\n239\t\tif path != expected {\n240\t\t\tt.Errorf(\"NewSessionTracePath = %q, want %q\", path, expected)\n241\t\t}\n242\t}\n243\t\n244\t// TestDefaultTraceDir 验证：默认追踪目录包含 .claude-tap-plus 和 .traces 后缀。\n245\tfunc TestDefaultTraceDir(t *testing.T) {\n246\t\tdir := trace.DefaultTraceDir()\n247\t\tif dir == \"\" {\n248\t\t\tt.Fatal(\"DefaultTraceDir should not be empty\")\n249\t\t}\n250\t\tif !strings.Contains(dir, \".claude-tap-plus\") {\n251\t\t\tt.Errorf(\"DefaultTraceDir should contain .claude-tap-plus, got %q\", dir)\n252\t\t}\n253\t\tif !strings.HasSuffix(dir, \".traces\") {\n254\t\t\tt.Errorf(\"DefaultTraceDir should end with .traces, got %q\", dir)\n255\t\t}\n256\t}\n257\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\tests\\e2e\\proxy_trace_test.go"},"tool_use_id":"call_3e233a3314284e1bbc41c724","tool_response":"1\t// Package e2e_test 包含代理层的端到端测试，覆盖请求转发、流式响应、追踪记录等完整链路。\n2\tpackage e2e_test\n3\t\n4\timport (\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"net/http\"\n9\t\t\"net/http/httptest\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"testing\"\n14\t\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/proxy\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/testutil\"\n17\t)\n18\t\n19\t// setupProxyWithTrace 创建带追踪初始化的代理，返回代理 URL、追踪文件路径。\n20\t// 通过调用内部 /_internal/trace-init 端点初始化 session 追踪。\n21\tfunc setupProxyWithTrace(t *testing.T, mockServerURL string) (string, string) {\n22\t\tt.Helper()\n23\t\n24\t\ttraceDir := t.TempDir()\n25\t\trp := proxy.NewReverseProxy(mockServerURL, traceDir)\n26\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n27\t\tif err != nil {\n28\t\t\tt.Fatalf(\"start proxy: %v\", err)\n29\t\t}\n30\t\tt.Cleanup(func() { rp.Stop() })\n31\t\n32\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n33\t\n34\t\t// 通过内部端点初始化追踪\n35\t\tsessionID := \"test-session-001\"\n36\t\tmachineID := \"testuser@testhost\"\n37\t\tprojectSlug := \"test-project\"\n38\t\tinitBody := fmt.Sprintf(\n39\t\t\t`{\"session_id\":\"%s\",\"machine_id\":\"%s\",\"project_slug\":\"%s\"}`,\n40\t\t\tsessionID, machineID, projectSlug,\n41\t\t)\n42\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(initBody))\n43\t\tif err != nil {\n44\t\t\tt.Fatalf(\"trace-init: %v\", err)\n45\t\t}\n46\t\tdefer resp.Body.Close()\n47\t\n48\t\tvar initResult struct {\n49\t\t\tStatus    string `json:\"status\"`\n50\t\t\tTracePath string `json:\"trace_path\"`\n51\t\t}\n52\t\tif err := json.NewDecoder(resp.Body).Decode(&initResult); err != nil {\n53\t\t\tt.Fatalf(\"parse trace-init response: %v\", err)\n54\t\t}\n55\t\tif initResult.Status != \"ok\" {\n56\t\t\tt.Fatalf(\"trace-init failed: %s\", initResult.Status)\n57\t\t}\n58\t\n59\t\ttracePath := initResult.TracePath\n60\t\n61\t\treturn proxyURL, tracePath\n62\t}\n63\t\n64\t// TestNonStreamingRequest 验证：非流式请求正常转发，响应正确，且追踪记录包含脱敏后的请求头。\n65\tfunc TestNonStreamingRequest(t *testing.T) {\n66\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n67\t\tmockServer := testutil.CreateMockServer(t, fx)\n68\t\tdefer mockServer.Close()\n69\t\n70\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n71\t\n72\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n73\t\ttestutil.AssertResponseStatus(t, resp, 200)\n74\t\n75\t\tbody := testutil.DrainAndClose(t, resp)\n76\t\tvar respBody map[string]any\n77\t\tif err := json.Unmarshal(body, &respBody); err != nil {\n78\t\t\tt.Fatalf(\"parse response: %v\", err)\n79\t\t}\n80\t\n81\t\tif respBody[\"type\"] != \"message\" {\n82\t\t\tt.Errorf(\"response type: got %v, want message\", respBody[\"type\"])\n83\t\t}\n84\t\tif respBody[\"stop_reason\"] != \"tool_use\" {\n85\t\t\tt.Errorf(\"stop_reason: got %v, want tool_use\", respBody[\"stop_reason\"])\n86\t\t}\n87\t\n88\t\t// 验证追踪记录\n89\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n90\t\tif len(records) != 1 {\n91\t\t\tt.Fatalf(\"expected 1 trace record, got %d\", len(records))\n92\t\t}\n93\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n94\t\n95\t\t// 验证请求头中的敏感信息已被脱敏\n96\t\treqHeaders, _ := records[0][\"request\"].(map[string]any)[\"headers\"].(map[string]any)\n97\t\tif auth, ok := reqHeaders[\"Authorization\"].(string); ok {\n98\t\t\tif auth == \"Bearer sk-ant-test-key-12345678\" {\n99\t\t\t\tt.Error(\"Authorization header not redacted in trace\")\n100\t\t\t}\n101\t\t}\n102\t\tif apiKey, ok := reqHeaders[\"X-Api-Key\"].(string); ok {\n103\t\t\tif apiKey == \"sk-ant-test-key-12345678\" {\n104\t\t\t\tt.Error(\"X-Api-Key not redacted in trace\")\n105\t\t\t}\n106\t\t}\n107\t}\n108\t\n109\t// TestStreamingSSE 验证：SSE 流式请求正常转发，响应包含所有事件，且追踪记录正确。\n110\tfunc TestStreamingSSE(t *testing.T) {\n111\t\tfx := testutil.LoadFixture(t, \"streaming_anthropic.json\")\n112\t\tmockServer := testutil.CreateMockServer(t, fx)\n113\t\tdefer mockServer.Close()\n114\t\n115\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n116\t\n117\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n118\t\ttestutil.AssertResponseStatus(t, resp, 200)\n119\t\n120\t\tbody := testutil.DrainAndClose(t, resp)\n121\t\tbodyStr := string(body)\n122\t\n123\t\t// 验证响应中包含所有 SSE 事件\n124\t\tif !strings.Contains(bodyStr, \"message_start\") {\n125\t\t\tt.Error(\"response missing message_start event\")\n126\t\t}\n127\t\tif !strings.Contains(bodyStr, \"content_block_delta\") {\n128\t\t\tt.Error(\"response missing content_block_delta event\")\n129\t\t}\n130\t\tif !strings.Contains(bodyStr, \"message_stop\") {\n131\t\t\tt.Error(\"response missing message_stop event\")\n132\t\t}\n133\t\n134\t\t// 验证追踪记录\n135\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n136\t\tif len(records) != 1 {\n137\t\t\tt.Fatalf(\"expected 1 trace record, got %d\", len(records))\n138\t\t}\n139\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n140\t\n141\t\trespMap, _ := records[0][\"response\"].(map[string]any)\n142\t\tif sseEvents, ok := respMap[\"sse_events\"].([]any); ok {\n143\t\t\tif len(sseEvents) == 0 {\n144\t\t\t\tt.Error(\"trace has no sse_events for streaming response\")\n145\t\t\t}\n146\t\t}\n147\t}\n148\t\n149\t// TestMultiTurn 验证：多轮对话请求会在追踪文件中生成多条记录，且 turn 编号递增。\n150\tfunc TestMultiTurn(t *testing.T) {\n151\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n152\t\tmockServer := testutil.CreateMockServer(t, fx)\n153\t\tdefer mockServer.Close()\n154\t\n155\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n156\t\n157\t\t// 发送 3 轮请求\n158\t\tfor i := 0; i < 3; i++ {\n159\t\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n160\t\t\ttestutil.AssertResponseStatus(t, resp, 200)\n161\t\t\tio.ReadAll(resp.Body)\n162\t\t\tresp.Body.Close()\n163\t\t}\n164\t\n165\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n166\t\tif len(records) != 3 {\n167\t\t\tt.Fatalf(\"expected 3 trace records, got %d\", len(records))\n168\t\t}\n169\t\n170\t\t// 验证每轮记录的 turn 编号和 session_id\n171\t\tfor i, rec := range records {\n172\t\t\tturn, _ := rec[\"turn\"].(float64)\n173\t\t\tif int(turn) != i+1 {\n174\t\t\t\tt.Errorf(\"record %d: turn = %v, want %d\", i, turn, i+1)\n175\t\t\t}\n176\t\t\tsid, _ := rec[\"session_id\"].(string)\n177\t\t\tif sid != \"test-session-001\" {\n178\t\t\t\tt.Errorf(\"record %d: session_id = %q, want test-session-001\", i, sid)\n179\t\t\t}\n180\t\t}\n181\t}\n182\t\n183\t// TestSessionIDExtraction 验证：追踪记录中正确提取了 session_id。\n184\tfunc TestSessionIDExtraction(t *testing.T) {\n185\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n186\t\tmockServer := testutil.CreateMockServer(t, fx)\n187\t\tdefer mockServer.Close()\n188\t\n189\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n190\t\n191\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n192\t\tio.ReadAll(resp.Body)\n193\t\tresp.Body.Close()\n194\t\n195\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n196\t\tif len(records) == 0 {\n197\t\t\tt.Fatal(\"no trace records\")\n198\t\t}\n199\t\n200\t\tsid, _ := records[0][\"session_id\"].(string)\n201\t\tif sid != \"test-session-001\" {\n202\t\t\tt.Errorf(\"session_id: got %q, want %q\", sid, \"test-session-001\")\n203\t\t}\n204\t}\n205\t\n206\t// TestTokenStats 验证：代理正确统计 API 调用次数和输入/输出 token 数量。\n207\tfunc TestTokenStats(t *testing.T) {\n208\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n209\t\tmockServer := testutil.CreateMockServer(t, fx)\n210\t\tdefer mockServer.Close()\n211\t\n212\t\ttraceDir := t.TempDir()\n213\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n214\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n215\t\tif err != nil {\n216\t\t\tt.Fatalf(\"start proxy: %v\", err)\n217\t\t}\n218\t\tdefer rp.Stop()\n219\t\n220\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n221\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n222\t\tio.ReadAll(resp.Body)\n223\t\tresp.Body.Close()\n224\t\n225\t\tsummary := rp.Summary()\n226\t\n227\t\t// 验证 API 调用次数\n228\t\tapiCalls, _ := summary[\"api_calls\"].(int)\n229\t\tif apiCalls != 1 {\n230\t\t\tt.Errorf(\"api_calls: got %d, want 1\", apiCalls)\n231\t\t}\n232\t\n233\t\t// 验证输入 token 数\n234\t\tinputTokens, _ := summary[\"input_tokens\"].(int64)\n235\t\tif inputTokens != 1234 {\n236\t\t\tt.Errorf(\"input_tokens: got %d, want 1234\", inputTokens)\n237\t\t}\n238\t\n239\t\t// 验证输出 token 数\n240\t\toutputTokens, _ := summary[\"output_tokens\"].(int64)\n241\t\tif outputTokens != 56 {\n242\t\t\tt.Errorf(\"output_tokens: got %d, want 56\", outputTokens)\n243\t\t}\n244\t}\n245\t\n246\t// TestHeaderRedaction 验证：追踪记录中的敏感请求头（Authorization、X-Api-Key）已被脱敏。\n247\tfunc TestHeaderRedaction(t *testing.T) {\n248\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n249\t\tmockServer := testutil.CreateMockServer(t, fx)\n250\t\tdefer mockServer.Close()\n251\t\n252\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n253\t\n254\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n255\t\tio.ReadAll(resp.Body)\n256\t\tresp.Body.Close()\n257\t\n258\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n259\t\tif len(records) == 0 {\n260\t\t\tt.Fatal(\"no trace records\")\n261\t\t}\n262\t\n263\t\treqMap, _ := records[0][\"request\"].(map[string]any)\n264\t\theaders, _ := reqMap[\"headers\"].(map[string]any)\n265\t\n266\t\t// 验证 X-Api-Key 被脱敏\n267\t\tif apiKey, ok := headers[\"X-Api-Key\"].(string); ok {\n268\t\t\tif apiKey == \"sk-ant-test-key-12345678\" {\n269\t\t\t\tt.Error(\"X-Api-Key not redacted in trace\")\n270\t\t\t}\n271\t\t}\n272\t\t// 验证 Authorization 被脱敏\n273\t\tif auth, ok := headers[\"Authorization\"].(string); ok {\n274\t\t\tif auth == \"Bearer sk-ant-test-key-12345678\" {\n275\t\t\t\tt.Error(\"Authorization not redacted in trace\")\n276\t\t\t}\n277\t\t}\n278\t}\n279\t\n280\t// TestBlockedPath 验证：被屏蔽的路径（如 /admin/config）返回 404，不会转发到上游。\n281\tfunc TestBlockedPath(t *testing.T) {\n282\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n283\t\t\tw.WriteHeader(200)\n284\t\t\tw.Write([]byte(\"should not reach\"))\n285\t\t})\n286\t\tmockServer := httptest.NewServer(mockHandler)\n287\t\tdefer mockServer.Close()\n288\t\n289\t\ttraceDir := t.TempDir()\n290\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n291\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n292\t\tif err != nil {\n293\t\t\tt.Fatalf(\"start proxy: %v\", err)\n294\t\t}\n295\t\tdefer rp.Stop()\n296\t\n297\t\tresp, err := http.Get(\"http://127.0.0.1:\" + fmt.Sprint(port) + \"/admin/config\")\n298\t\tif err != nil {\n299\t\t\tt.Fatalf(\"send request: %v\", err)\n300\t\t}\n301\t\tdefer resp.Body.Close()\n302\t\n303\t\tif resp.StatusCode != 404 {\n304\t\t\tt.Errorf(\"blocked path status: got %d, want 404\", resp.StatusCode)\n305\t\t}\n306\t}\n307\t\n308\t// TestGzipResponse 验证：代理能正确处理 gzip 压缩的响应并解压。\n309\tfunc TestGzipResponse(t *testing.T) {\n310\t\tfx := testutil.LoadFixture(t, \"gzip_response.json\")\n311\t\tmockServer := testutil.CreateMockServer(t, fx)\n312\t\tdefer mockServer.Close()\n313\t\n314\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n315\t\n316\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n317\t\ttestutil.AssertResponseStatus(t, resp, 200)\n318\t\n319\t\tbody := testutil.DrainAndClose(t, resp)\n320\t\tvar respBody map[string]any\n321\t\tif err := json.Unmarshal(body, &respBody); err != nil {\n322\t\t\tt.Fatalf(\"parse response (should be decompressed): %v\", err)\n323\t\t}\n324\t\tif respBody[\"type\"] != \"message\" {\n325\t\t\tt.Errorf(\"response type: got %v, want message\", respBody[\"type\"])\n326\t\t}\n327\t\n328\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n329\t\tif len(records) == 0 {\n330\t\t\tt.Fatal(\"no trace records\")\n331\t\t}\n332\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n333\t}\n334\t\n335\t// TestTraceInitEndpoint 验证：/_internal/trace-init 端点能正确初始化追踪文件并返回路径。\n336\tfunc TestTraceInitEndpoint(t *testing.T) {\n337\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n338\t\t\tw.WriteHeader(200)\n339\t\t\tw.Write([]byte(`{\"id\":\"msg_test\"}`))\n340\t\t})\n341\t\tmockServer := httptest.NewServer(mockHandler)\n342\t\tdefer mockServer.Close()\n343\t\n344\t\ttraceDir := t.TempDir()\n345\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n346\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n347\t\tif err != nil {\n348\t\t\tt.Fatalf(\"start proxy: %v\", err)\n349\t\t}\n350\t\tdefer rp.Stop()\n351\t\n352\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n353\t\n354\t\t// 调用 trace-init\n355\t\tbody := `{\"session_id\":\"sess-abc\",\"machine_id\":\"user@host\",\"project_slug\":\"my-project\"}`\n356\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(body))\n357\t\tif err != nil {\n358\t\t\tt.Fatalf(\"trace-init: %v\", err)\n359\t\t}\n360\t\tdefer resp.Body.Close()\n361\t\n362\t\tif resp.StatusCode != 200 {\n363\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n364\t\t}\n365\t\n366\t\tvar result struct {\n367\t\t\tStatus    string `json:\"status\"`\n368\t\t\tTracePath string `json:\"trace_path\"`\n369\t\t}\n370\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n371\t\t\tt.Fatalf(\"parse response: %v\", err)\n372\t\t}\n373\t\n374\t\tif result.Status != \"ok\" {\n375\t\t\tt.Errorf(\"status: got %q, want ok\", result.Status)\n376\t\t}\n377\t\n378\t\t// 验证追踪文件路径后缀包含 machine_id/project_slug/session_id\n379\t\texpectedSuffix := filepath.Join(\"user@host\", \"my-project\", \"sess-abc.jsonl\")\n380\t\tif !strings.HasSuffix(filepath.ToSlash(result.TracePath), filepath.ToSlash(expectedSuffix)) {\n381\t\t\tt.Errorf(\"trace_path suffix: got %q, want ending with %q\", result.TracePath, expectedSuffix)\n382\t\t}\n383\t\n384\t\t// 验证追踪文件已被创建\n385\t\tif _, err := os.Stat(result.TracePath); os.IsNotExist(err) {\n386\t\t\tt.Errorf(\"trace file not created: %s\", result.TracePath)\n387\t\t}\n388\t\n389\t\t// 验证目录结构包含 machine_id 和 project_slug\n390\t\trel, _ := filepath.Rel(traceDir, result.TracePath)\n391\t\tparts := strings.Split(filepath.ToSlash(rel), \"/\")\n392\t\tif len(parts) != 3 {\n393\t\t\tt.Errorf(\"expected 3 path components (machine/project/file), got %d: %v\", len(parts), parts)\n394\t\t}\n395\t\tif parts[0] != \"user@host\" {\n396\t\t\tt.Errorf(\"machine_id dir: got %q, want user@host\", parts[0])\n397\t\t}\n398\t\tif parts[1] != \"my-project\" {\n399\t\t\tt.Errorf(\"project_slug dir: got %q, want my-project\", parts[1])\n400\t\t}\n401\t}\n402\t\n403\t// TestTraceInitMissingSessionID 验证：trace-init 请求缺少 session_id 时返回 400。\n404\tfunc TestTraceInitMissingSessionID(t *testing.T) {\n405\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n406\t\t\tw.WriteHeader(200)\n407\t\t})\n408\t\tmockServer := httptest.NewServer(mockHandler)\n409\t\tdefer mockServer.Close()\n410\t\n411\t\ttraceDir := t.TempDir()\n412\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n413\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n414\t\tif err != nil {\n415\t\t\tt.Fatalf(\"start proxy: %v\", err)\n416\t\t}\n417\t\tdefer rp.Stop()\n418\t\n419\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n420\t\n421\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(`{\"session_id\":\"\"}`))\n422\t\tif err != nil {\n423\t\t\tt.Fatalf(\"trace-init: %v\", err)\n424\t\t}\n425\t\tdefer resp.Body.Close()\n426\t\n427\t\tif resp.StatusCode != 400 {\n428\t\t\tt.Errorf(\"expected 400, got %d\", resp.StatusCode)\n429\t\t}\n430\t}\n431\t"}]}
