rue,\n42\t}\n43\t\n44\t// FilterHeaders 返回过滤掉逐跳头后的 Header 副本。\n45\t// 若 redact 为 true，敏感头将被部分遮蔽。\n46\tfunc FilterHeaders(headers http.Header, redact bool) http.Header {\n47\t\tout := make(http.Header)\n48\t\tfor k, vals := range headers {\n49\t\t\tlower := strings.ToLower(k)\n50\t\t\t// 跳过逐跳头\n51\t\t\tif hopByHopHeaders[lower] {\n52\t\t\t\tcontinue\n53\t\t\t}\n54\t\t\t// 敏感头脱敏处理\n55\t\t\tif redact && sensitiveHeaderKeys[lower] {\n56\t\t\t\tfor _, v := range vals {\n57\t\t\t\t\tif prefixRedactedKeys[lower] && len(v) > 12 {\n58\t\t\t\t\t\tout.Set(k, v[:12]+\"...\")\n59\t\t\t\t\t} else {\n60\t\t\t\t\t\tout.Set(k, \"***\")\n61\t\t\t\t\t}\n62\t\t\t\t}\n63\t\t\t\tcontinue\n64\t\t\t}\n65\t\t\tfor _, v := range vals {\n66\t\t\t\tout.Add(k, v)\n67\t\t\t}\n68\t\t}\n69\t\treturn out\n70\t}\n71\t\n72\t// HeadersToMap 将 http.Header 转换为 map[string]string，用于 Trace 记录。\n73\t// 每个键只保留第一个值。\n74\tfunc HeadersToMap(h http.Header) map[string]string {\n75\t\tm := make(map[string]string, len(h))\n76\t\tfor k, vals := range h {\n77\t\t\tif len(vals) > 0 {\n78\t\t\t\tm[k] = vals[0]\n79\t\t\t}\n80\t\t}\n81\t\treturn m\n82\t}\n83\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\usage\\normalize.go"},"tool_use_id":"call_c162d4e784e24507988739cb","tool_response":"1\tpackage usage\n2\t\n3\timport (\n4\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n5\t)\n6\t\n7\t// NormalizeUsage 将不同 Provider 特定的 Token 字段名统一映射到 Anthropic 规范的标准名称。\n8\t//\n9\t// 支持的 Provider 及其字段映射关系：\n10\t//   - Anthropic: input_tokens / output_tokens / cache_read_input_tokens / cache_creation_input_tokens\n11\t//   - OpenAI:    prompt_tokens / completion_tokens / cached_tokens\n12\t//   - Google Gemini: promptTokenCount / candidatesTokenCount / cachedContentTokenCount\n13\t//\n14\t// 此外，该函数还会检查嵌套结构（如 input_tokens_details.cached_tokens、\n15\t// prompt_tokens_details.cached_tokens），将其累加到 cache_read_input_tokens 中。\n16\t//\n17\t// 参数 us