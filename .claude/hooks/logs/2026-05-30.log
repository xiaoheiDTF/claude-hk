\", `C:\\Users\\Admin\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\uuid.jsonl`, \"D--CodeDevelopment-CodeProject-claude-hk\"},\n220\t\t\t{\"unix_path\", \"/home/user/.claude/projects/D--CodeDevelopment-CodeProject-claude-hk/uuid.jsonl\", \"D--CodeDevelopment-CodeProject-claude-hk\"},\n221\t\t\t{\"empty\", \"\", \"\"},\n222\t\t\t{\"no_projects_segment\", \"/some/random/path.jsonl\", \"\"},\n223\t\t}\n224\t\n225\t\tfor _, tt := range tests {\n226\t\t\tt.Run(tt.name, func(t *testing.T) {\n227\t\t\t\tgot := trace.ExtractProjectSlug(tt.input)\n228\t\t\t\tif got != tt.want {\n229\t\t\t\t\tt.Errorf(\"ExtractProjectSlug(%q) = %q, want %q\", tt.input, got, tt.want)\n230\t\t\t\t}\n231\t\t\t})\n232\t\t}\n233\t}\n234\t\n235\t// TestNewSessionTracePath 验证：Session 追踪路径按 machine_id/project_slug/session_id.jsonl 格式生成。\n236\tfunc TestNewSessionTracePath(t *testing.T) {\n237\t\tpath := trace.NewSessionTracePath(\"/tmp/traces\", \"user@host\", \"D--my-project\", \"abc-123\")\n238\t\texpected := filepath.Join(\"/tmp/traces\", \"user@host\", \"D--my-project\", \"abc-123.jsonl\")\n239\t\tif path != expected {\n240\t\t\tt.Errorf(\"NewSessionTracePath = %q, want %q\", path, expected)\n241\t\t}\n242\t}\n243\t\n244\t// TestDefaultTraceDir 验证：默认追踪目录包含 .claude-tap-plus 和 .traces 后缀。\n245\tfunc TestDefaultTraceDir(t *testing.T) {\n246\t\tdir := trace.DefaultTraceDir()\n247\t\tif dir == \"\" {\n248\t\t\tt.Fatal(\"DefaultTraceDir should not be empty\")\n249\t\t}\n250\t\tif !strings.Contains(dir, \".claude-tap-plus\") {\n251\t\t\tt.Errorf(\"DefaultTraceDir should contain .claude-tap-plus, got %q\", dir)\n252\t\t}\n253\t\tif !strings.HasSuffix(dir, \".traces\") {\n254\t\t\tt.Errorf(\"DefaultTraceDir should end with .traces, got %q\", dir)\n255\t\t}\n256\t}\n257\t"}]}
