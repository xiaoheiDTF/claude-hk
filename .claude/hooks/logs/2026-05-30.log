urn nil, fmt.Errorf(\"create trace dir: %w\", err)\n47\t\t}\n48\t\n49\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)\n50\t\tif err != nil {\n51\t\t\treturn nil, fmt.Errorf(\"open trace file: %w\", err)\n52\t\t}\n53\t\n54\t\treturn &TraceWriter{\n55\t\t\tfile:       f,\n56\t\t\twriter:     bufio.NewWriter(f),\n57\t\t\tmodelsUsed: make(map[string]int),\n58\t\t}, nil\n59\t}\n60\t\n61\t// Write 将单条记录序列化为 JSON 行写入文件，并立即刷新缓冲区，\n62\t// 同时更新内部统计计数。\n63\t//\n64\t// 记录格式为 JSON Lines（每行一条独立 JSON，以换行符分隔），\n65\t// 便于后续按行读取和解析。\n66\tfunc (w *TraceWriter) Write(record map[string]any) error {\n67\t\tw.mu.Lock()\n68\t\tdefer w.mu.Unlock()\n69\t\n70\t\tdata, err := json.Marshal(record)\n71\t\tif err != nil {\n72\t\t\treturn fmt.Errorf(\"marshal trace record: %w\", err)\n73\t\t}\n74\t\n75\t\tif _, err := w.writer.Write(data); err != nil {\n76\t\t\treturn err\n77\t\t}\n78\t\tif _, err := w.writer.WriteString(\"\\n\"); err != nil {\n79\t\t\treturn err\n80\t\t}\n81\t\tif err := w.writer.Flush(); err != nil {\n82\t\t\treturn err\n83\t\t}\n84\t\n85\t\tw.count++\n86\t\tw.updateStats(record)\n87\t\treturn nil\n88\t}\n89\t\n90\t// Close 刷新缓冲区并关闭底层文件。\n91\t// 应在追踪会话结束时调用，以确保所有数据落盘。\n92\tfunc (w *TraceWriter) Close() error {\n93\t\tw.mu.Lock()\n94\t\tdefer w.mu.Unlock()\n95\t\tif w.writer != nil {\n96\t\t\t_ = w.writer.Flush()\n97\t\t}\n98\t\tif w.file != nil {\n99\t\t\treturn w.file.Close()\n100\t\t}\n101\t\treturn nil\n102\t}\n103\t\n104\t// Summary 返回当前追踪会话的聚合统计信息。\n105\t//\n106\t// 返回的 map 包含以下字段：\n107\t//   - api_calls:            API 调用总次数\n108\t//   - input_tokens:         累计输入 Token\n109\t//   - output_tokens:        累计输出 Token\n110\t//   - cache_read_tokens:    累计缓存读取 Token\n111\t//   - cache_create_tokens:  累计缓存创建 Token\n112\t//   - models_used:          各模型调用次数 map[string]int\n113\tfunc (w *TraceWriter) Summary() map[string]any {\n114\t\tw.mu.Lock()\n115\t\tdefer w.mu.Unlock()\n116\t\n117\t\treturn map[string]any{\n118\t\t\t\"api_calls\":           w.count,\n119\t\t\t\"input_tokens\":        w.inputTokens,\n120\t\t\t\"output_tokens\":       w.outputTokens,\n121\t\t\t\"cache_read_tokens\":   w.cacheRead,\n122\t\t\t\"cache_create_tokens\": w.cacheCreate,\n123\t\t\t\"models_used\":         w.modelsUsed,\n124\t\t}\n125\t}\n126\t\n127\t// updateStats 从单条记录中提取模型信息和 Token 用量，更新累计统计。\n128\t//\n129\t// 提取逻辑：\n130\t//  1. 从 request.body.model 获取模型名称，归入 modelsUsed 计数\n131\t//  2. 从 response.body.usage 或 body 顶层提取 usage 数据\n132\t//  3. 使用 usage.NormalizeUsage 标准化后累加到各 Token 计数器\n133\tfunc (w *TraceWriter) updateStats(record map[string]any) {\n134\t\t// 从请求体中提取模型名称\n135\t\treqBody, _ := record[\"request\"].(map[string]any)\n136\t\tif reqBody != nil {\n137\t\t\tif body, ok := reqBody[\"body\"].(map[string]any); ok {\n138\t\t\t\tmodel, _ := body[\"model\"].(string)\n139\t\t\t\tif model == \"\" {\n140\t\t\t\t\tmodel = \"unknown\"\n141\t\t\t\t}\n142\t\t\t\tw.modelsUsed[model]++\n143\t\t\t}\n144\t\t}\n145\t\n146\t\t// 从响应体中提取 Token 用量\n147\t\trespBody, _ := record[\"response\"].(map[string]any)\n148\t\tif respBody == nil {\n149\t\t\treturn\n150\t\t}\n151\t\tbody, _ := respBody[\"body\"].(map[string]any)\n152\t\tif body == nil {\n153\t\t\treturn\n154\t\t}\n155\t\n156\t\trawUsage, _ := body[\"usage\"].(map[string]any)\n157\t\tif rawUsage == nil {\n158\t\t\t// 某些情况下 usage 直接位于 body 顶层\n159\t\t\trawUsage = body\n160\t\t}\n161\t\n162\t\tnorm := usage.NormalizeUsage(rawUsage)\n163\t\tw.inputTokens += norm[\"input_tokens\"]\n164\t\tw.outputTokens += norm[\"output_tokens\"]\n165\t\tw.cacheRead += norm[\"cache_read_input_tokens\"]\n166\t\tw.cacheCreate += norm[\"cache_creation_input_tokens\"]\n167\t}\n168\t\n169\t// DefaultTraceDir 返回默认的追踪文件存储目录，位于用户主目录下。\n170\t//\n171\t// 默认路径：$HOME/.claude-tap-plus/.traces\n172\t// 如果无法获取用户主目录，则返回相对路径 \".claude-tap-plus/.traces\"。\n173\tfunc DefaultTraceDir() string {\n174\t\thome, err := os.UserHomeDir()\n175\t\tif err != nil {\n176\t\t\treturn \".claude-tap-plus/.traces\"\n177\t\t}\n178\t\treturn filepath.Join(home, \".claude-tap-plus\", \".traces\")\n179\t}\n180\t\n181\t// DetectProjectName 返回当前工作目录对应的项目名称。\n182\t//\n183\t// 优先级：\n184\t//  1. 从 git remote origin URL 提取仓库名（如 my-project）\n185\t//  2. 当前工作目录的目录名作为兜底\n186\tfunc DetectProjectName() string {\n187\t\tcwd, _ := os.Getwd()\n188\t\t// 优先尝试从 git 远程地址获取仓库名\n189\t\tif cwd != \"\" {\n190\t\t\trepo := gitRemoteRepoName(cwd)\n191\t\t\tif repo != \"\" {\n192\t\t\t\treturn repo\n193\t\t\t}\n194\t\t}\n195\t\t// 兜底：使用当前目录名\n196\t\tproject := filepath.Base(cwd)\n197\t\tif project == \"\" || project == \".\" {\n198\t\t\tproject = \"default\"\n199\t\t}\n200\t\treturn project\n201\t}\n202\t\n203\t// NewTracePath 根据当前项目和时间信息生成追踪文件路径。\n204\t//\n205\t// 路径格式：baseDir/{project}/{date}_{time}_{shortID}.jsonl\n206\t//   - project:  通过 DetectProjectName() 自动检测\n207\t//   - dateTime: 本地时间，格式 \"2006-01-02_150405\"\n208\t//   - shortID:  3 字节（6 位十六进制）随机字符串，用于保证唯一性且便于云同步\n209\tfunc NewTracePath(baseDir string) string {\n210\t\tproject := DetectProjectName()\n211\t\n212\t\tnow := time.Now()\n213\t\tdateTime := now.Format(\"2006-01-02_150405\")\n214\t\tshortID := randomHex(3) // 3 字节 = 6 位十六进制字符\n215\t\tfilename := fmt.Sprintf(\"%s_%s.jsonl\", dateTime, shortID)\n216\t\n217\t\treturn filepath.Join(baseDir, project, filename)\n218\t}\n219\t\n220\t// gitRemoteRepoName 从 .git/config 文件中提取 remote origin 对应的仓库名。\n221\t//\n222\t// 示例：\n223\t//   \"https://github.com/user/my-project.git\" → \"my-project\"\n224\t//\n225\t// 直接读取配置文件以避免依赖 git 命令。\n226\tfunc gitRemoteRepoName(dir string) string {\n227\t\tconfigPath := filepath.Join(dir, \".git\", \"config\")\n228\t\tdata, err := os.ReadFile(configPath)\n229\t\tif err != nil {\n230\t\t\treturn \"\"\n231\t\t}\n232\t\tcontent := string(data)\n233\t\t// 定位 [remote \"origin\"] 区域并提取 URL\n234\t\tlines := strings.Split(content, \"\\n\")\n235\t\tinOrigin := false\n236\t\tfor _, line := range lines {\n237\t\t\ttrimmed := strings.TrimSpace(line)\n238\t\t\tif trimmed == `[remote \"origin\"]` {\n239\t\t\t\tinOrigin = true\n240\t\t\t\tcontinue\n241\t\t\t}\n242\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"url = \") {\n243\t\t\t\turl := strings.TrimPrefix(trimmed, \"url = \")\n244\t\t\t\t// 提取 URL 最后一段并去掉 .git 后缀\n245\t\t\t\tbase := filepath.Base(url)\n246\t\t\t\tbase = strings.TrimSuffix(base, \".git\")\n247\t\t\t\treturn base\n248\t\t\t}\n249\t\t\tif inOrigin && strings.HasPrefix(trimmed, \"[\") {\n250\t\t\t\tbreak // 已进入下一个配置区域\n251\t\t\t}\n252\t\t}\n253\t\treturn \"\"\n254\t}\n255\t\n256\t// randomHex 生成 n 个随机字节并以十六进制字符串返回（共 2*n 个字符）。\n257\tfunc randomHex(n int) string {\n258\t\tb := make([]byte, n)\n259\t\t_, _ = rand.Read(b)\n260\t\treturn hex.EncodeToString(b)\n261\t}\n262\t\n263\t// MachineID 返回 \"用户名@主机名\" 格式的机器标识符。\n264\t// 用于区分不同机器的追踪数据。\n265\tfunc MachineID() string {\n266\t\thostname, _ := os.Hostname()\n267\t\tif hostname == \"\" {\n268\t\t\thostname = \"unknown\"\n269\t\t}\n270\t\tusername := \"unknown\"\n271\t\tif u, err := user.Current(); err == nil && u.Username != \"\" {\n272\t\t\tusername = u.Username\n273\t\t}\n274\t\treturn username + \"@\" + hostname\n275\t}\n276\t\n277\t// ExtractProjectSlug 从 Claude Code 的会话转录文件路径中提取项目标识（slug）。\n278\t//\n279\t// 输入示例：\n280\t//   \"C:\\Users\\Admin\\.claude\\projects\\D--xxx-yyy\\uuid.jsonl\"\n281\t//\n282\t// 输出：\n283\t//   \"D--xxx-yyy\"\n284\t//\n285\t// 如果路径不符合预期的 .claude/projects/ 模式，则返回空字符串。\n286\tfunc ExtractProjectSlug(transcriptPath string) string {\n287\t\tif transcriptPath == \"\" {\n288\t\t\treturn \"\"\n289\t\t}\n290\t\t// 统一路径分隔符为 /\n291\t\tnormalized := filepath.ToSlash(transcriptPath)\n292\t\n293\t\t// 定位 \".claude/projects/\" 标记段\n294\t\tmarker := \".claude/projects/\"\n295\t\tidx := strings.Index(normalized, marker)\n296\t\tif idx < 0 {\n297\t\t\treturn \"\"\n298\t\t}\n299\t\n300\t\t// 提取标记后的第一段目录名\n301\t\trest := normalized[idx+len(marker):]\n302\t\tif slashIdx := strings.Index(rest, \"/\"); slashIdx >= 0 {\n303\t\t\trest = rest[:slashIdx]\n304\t\t}\n305\t\n306\t\tif rest == \"\" {\n307\t\t\treturn \"\"\n308\t\t}\n309\t\treturn rest\n310\t}\n311\t\n312\t// NewSessionTracePath 基于会话信息构建追踪文件路径。\n313\t//\n314\t// 路径格式：baseDir/{machineID}/{projectSlug}/{sessionID}.jsonl\n315\t//\n316\t// 参数说明：\n317\t//   - baseDir:     基础追踪目录\n318\t//   - machineID:   机器标识（如 username@hostname）\n319\t//   - projectSlug: 项目标识（如 D--xxx-yyy）\n320\t//   - sessionID:   会话唯一标识\n321\tfunc NewSessionTracePath(baseDir, machineID, projectSlug, sessionID string) string {\n322\t\treturn filepath.Join(baseDir, machineID, projectSlug, sessionID+\".jsonl\")\n323\t}\n324\t"}]}
