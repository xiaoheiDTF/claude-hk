ssionID string) (bool, error)\n40\t\tReleaseSessionIssues(ctx context.Context, sessionID string) ([]int, error)\n41\t}\n42\t\n43\t// IssueCheckResult 表示单个 Issue 的状态查询结果。\n44\ttype IssueCheckResult struct {\n45\t\tNumber    int     // Issue 编号\n46\t\tStatus    string  // 当前状态\n47\t\tSessionID *string // 领取者 session ID\n48\t\tClaimedAt *string // 领取时间\n49\t}\n50\t\n51\t// --- Session types ---\n52\t\n53\t// Session 表示会话实体（对应数据库 sessions 表）。\n54\ttype Session struct {\n55\t\tSessionID      string     // 会话唯一 ID\n56\t\tMachineID      string     // 机器标识\n57\t\tOS             string     // 操作系统\n58\t\tProjectSlug    string     // 项目标识\n59\t\tProjectCwd     string     // 项目工作目录\n60\t\tTranscriptPath string     // 对话记录路径\n61\t\tLocalTracePath string     // 本地跟踪路径\n62\t\tModel          string     // 使用的模型\n63\t\tSource         string     // 来源\n64\t\tStatus         string     // 状态\n65\t\tRegisteredAt   time.Time  // 注册时间\n66\t\tClosedAt       *time.Time // 关闭时间\n67\t\tCloseReason    string     // 关闭原因\n68\t}\n69\t\n70\t// SessionFilter 是会话列表的过滤条件（指针类型支持省略条件）。\n71\ttype SessionFilter struct {\n72\t\tMachineID   *string // 按机器 ID 过滤\n73\t\tProjectSlug *string // 按项目标识过滤\n74\t\tStatus      *string // 按状态过滤\n75\t}\n76\t\n77\t// SessionStore 定义 Session 数据存储的接口。\n78\ttype SessionStore interface {\n79\t\tRegisterSession(ctx context.Context, s Session) error\n80\t\tCloseSession(ctx context.Context, sessionID string, reason string) error\n81\t\tListSessions(ctx context.Context, filter SessionFilter) ([]Session, error)\n82\t\tGetSession(ctx context.Context, sessionID string) (*Session, error)\n83\t\tCleanupTimedOut(ctx context.Context) (int, error)\n84\t}\n85\t\n86\t// --- Store aggregate ---\n87\t\n88\t// Store 是统一的数据存储聚合接口。\n89\ttype Store interface {\n90\t\tIssues() IssueStore   // 返回 Issue 存储\n91\t\tSessions() SessionStore // 返回 Session 存储\n92\t\tClose() error         // 关闭存储连接\n93\t}\n94\t"}]}
