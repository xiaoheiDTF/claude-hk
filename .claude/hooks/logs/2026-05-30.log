ecords[0][\"request\"].(map[string]any)[\"headers\"].(map[string]any)\n97\t\tif auth, ok := reqHeaders[\"Authorization\"].(string); ok {\n98\t\t\tif auth == \"Bearer sk-ant-test-key-12345678\" {\n99\t\t\t\tt.Error(\"Authorization header not redacted in trace\")\n100\t\t\t}\n101\t\t}\n102\t\tif apiKey, ok := reqHeaders[\"X-Api-Key\"].(string); ok {\n103\t\t\tif apiKey == \"sk-ant-test-key-12345678\" {\n104\t\t\t\tt.Error(\"X-Api-Key not redacted in trace\")\n105\t\t\t}\n106\t\t}\n107\t}\n108\t\n109\tfunc TestStreamingSSE(t *testing.T) {\n110\t\tfx := testutil.LoadFixture(t, \"streaming_anthropic.json\")\n111\t\tmockServer := testutil.CreateMockServer(t, fx)\n112\t\tdefer mockServer.Close()\n113\t\n114\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n115\t\n116\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n117\t\ttestutil.AssertResponseStatus(t, resp, 200)\n118\t\n119\t\tbody := testutil.DrainAndClose(t, resp)\n120\t\tbodyStr := string(body)\n121\t\n122\t\tif !strings.Contains(bodyStr, \"message_start\") {\n123\t\t\tt.Error(\"response missing message_start event\")\n124\t\t}\n125\t\tif !strings.Contains(bodyStr, \"content_block_delta\") {\n126\t\t\tt.Error(\"response missing content_block_delta event\")\n127\t\t}\n128\t\tif !strings.Contains(bodyStr, \"message_stop\") {\n129\t\t\tt.Error(\"response missing message_stop event\")\n130\t\t}\n131\t\n132\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n133\t\tif len(records) != 1 {\n134\t\t\tt.Fatalf(\"expected 1 trace record, got %d\", len(records))\n135\t\t}\n136\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n137\t\n138\t\trespMap, _ := records[0][\"response\"].(map[string]any)\n139\t\tif sseEvents, ok := respMap[\"sse_events\"].([]any); ok {\n140\t\t\tif len(sseEvents) == 0 {\n141\t\t\t\tt.Error(\"trace has no sse_events for streaming response\")\n142\t\t\t}\n143\t\t}\n144\t}\n145\t\n146\tfunc TestMultiTurn(t *testing.T) {\n147\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n148\t\tmockServer := testutil.CreateMockServer(t, fx)\n149\t\tdefer mockServer.Close()\n150\t\n151\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n152\t\n153\t\tfor i := 0; i < 3; i++ {\n154\t\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n155\t\t\ttestutil.AssertResponseStatus(t, resp, 200)\n156\t\t\tio.ReadAll(resp.Body)\n157\t\t\tresp.Body.Close()\n158\t\t}\n159\t\n160\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n161\t\tif len(records) != 3 {\n162\t\t\tt.Fatalf(\"expected 3 trace records, got %d\", len(records))\n163\t\t}\n164\t\n165\t\tfor i, rec := range records {\n166\t\t\tturn, _ := rec[\"turn\"].(float64)\n167\t\t\tif int(turn) != i+1 {\n168\t\t\t\tt.Errorf(\"record %d: turn = %v, want %d\", i, turn, i+1)\n169\t\t\t}\n170\t\t\tsid, _ := rec[\"session_id\"].(string)\n171\t\t\tif sid != \"test-session-001\" {\n172\t\t\t\tt.Errorf(\"record %d: session_id = %q, want test-session-001\", i, sid)\n173\t\t\t}\n174\t\t}\n175\t}\n176\t\n177\tfunc TestSessionIDExtraction(t *testing.T) {\n178\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n179\t\tmockServer := testutil.CreateMockServer(t, fx)\n180\t\tdefer mockServer.Close()\n181\t\n182\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n183\t\n184\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n185\t\tio.ReadAll(resp.Body)\n186\t\tresp.Body.Close()\n187\t\n188\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n189\t\tif len(records) == 0 {\n190\t\t\tt.Fatal(\"no trace records\")\n191\t\t}\n192\t\n193\t\tsid, _ := records[0][\"session_id\"].(string)\n194\t\tif sid != \"test-session-001\" {\n195\t\t\tt.Errorf(\"session_id: got %q, want %q\", sid, \"test-session-001\")\n196\t\t}\n197\t}\n198\t\n199\tfunc TestTokenStats(t *testing.T) {\n200\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n201\t\tmockServer := testutil.CreateMockServer(t, fx)\n202\t\tdefer mockServer.Close()\n203\t\n204\t\ttraceDir := t.TempDir()\n205\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n206\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n207\t\tif err != nil {\n208\t\t\tt.Fatalf(\"start proxy: %v\", err)\n209\t\t}\n210\t\tdefer rp.Stop()\n211\t\n212\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n213\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n214\t\tio.ReadAll(resp.Body)\n215\t\tresp.Body.Close()\n216\t\n217\t\tsummary := rp.Summary()\n218\t\n219\t\tapiCalls, _ := summary[\"api_calls\"].(int)\n220\t\tif apiCalls != 1 {\n221\t\t\tt.Errorf(\"api_calls: got %d, want 1\", apiCalls)\n222\t\t}\n223\t\n224\t\tinputTokens, _ := summary[\"input_tokens\"].(int64)\n225\t\tif inputTokens != 1234 {\n226\t\t\tt.Errorf(\"input_tokens: got %d, want 1234\", inputTokens)\n227\t\t}\n228\t\n229\t\toutputTokens, _ := summary[\"output_tokens\"].(int64)\n230\t\tif outputTokens != 56 {\n231\t\t\tt.Errorf(\"output_tokens: got %d, want 56\", outputTokens)\n232\t\t}\n233\t}\n234\t\n235\tfunc TestHeaderRedaction(t *testing.T) {\n236\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n237\t\tmockServer := testutil.CreateMockServer(t, fx)\n238\t\tdefer mockServer.Close()\n239\t\n240\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n241\t\n242\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n243\t\tio.ReadAll(resp.Body)\n244\t\tresp.Body.Close()\n245\t\n246\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n247\t\tif len(records) == 0 {\n248\t\t\tt.Fatal(\"no trace records\")\n249\t\t}\n250\t\n251\t\treqMap, _ := records[0][\"request\"].(map[string]any)\n252\t\theaders, _ := reqMap[\"headers\"].(map[string]any)\n253\t\n254\t\tif apiKey, ok := headers[\"X-Api-Key\"].(string); ok {\n255\t\t\tif apiKey == \"sk-ant-test-key-12345678\" {\n256\t\t\t\tt.Error(\"X-Api-Key not redacted in trace\")\n257\t\t\t}\n258\t\t}\n259\t\tif auth, ok := headers[\"Authorization\"].(string); ok {\n260\t\t\tif auth == \"Bearer sk-ant-test-key-12345678\" {\n261\t\t\t\tt.Error(\"Authorization not redacted in trace\")\n262\t\t\t}\n263\t\t}\n264\t}\n265\t\n266\tfunc TestBlockedPath(t *testing.T) {\n267\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n268\t\t\tw.WriteHeader(200)\n269\t\t\tw.Write([]byte(\"should not reach\"))\n270\t\t})\n271\t\tmockServer := httptest.NewServer(mockHandler)\n272\t\tdefer mockServer.Close()\n273\t\n274\t\ttraceDir := t.TempDir()\n275\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n276\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n277\t\tif err != nil {\n278\t\t\tt.Fatalf(\"start proxy: %v\", err)\n279\t\t}\n280\t\tdefer rp.Stop()\n281\t\n282\t\tresp, err := http.Get(\"http://127.0.0.1:\" + fmt.Sprint(port) + \"/admin/config\")\n283\t\tif err != nil {\n284\t\t\tt.Fatalf(\"send request: %v\", err)\n285\t\t}\n286\t\tdefer resp.Body.Close()\n287\t\n288\t\tif resp.StatusCode != 404 {\n289\t\t\tt.Errorf(\"blocked path status: got %d, want 404\", resp.StatusCode)\n290\t\t}\n291\t}\n292\t\n293\tfunc TestGzipResponse(t *testing.T) {\n294\t\tfx := testutil.LoadFixture(t, \"gzip_response.json\")\n295\t\tmockServer := testutil.CreateMockServer(t, fx)\n296\t\tdefer mockServer.Close()\n297\t\n298\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n299\t\n300\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n301\t\ttestutil.AssertResponseStatus(t, resp, 200)\n302\t\n303\t\tbody := testutil.DrainAndClose(t, resp)\n304\t\tvar respBody map[string]any\n305\t\tif err := json.Unmarshal(body, &respBody); err != nil {\n306\t\t\tt.Fatalf(\"parse response (should be decompressed): %v\", err)\n307\t\t}\n308\t\tif respBody[\"type\"] != \"message\" {\n309\t\t\tt.Errorf(\"response type: got %v, want message\", respBody[\"type\"])\n310\t\t}\n311\t\n312\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n313\t\tif len(records) == 0 {\n314\t\t\tt.Fatal(\"no trace records\")\n315\t\t}\n316\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n317\t}\n318\t\n319\tfunc TestTraceInitEndpoint(t *testing.T) {\n320\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n321\t\t\tw.WriteHeader(200)\n322\t\t\tw.Write([]byte(`{\"id\":\"msg_test\"}`))\n323\t\t})\n324\t\tmockServer := httptest.NewServer(mockHandler)\n325\t\tdefer mockServer.Close()\n326\t\n327\t\ttraceDir := t.TempDir()\n328\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n329\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n330\t\tif err != nil {\n331\t\t\tt.Fatalf(\"start proxy: %v\", err)\n332\t\t}\n333\t\tdefer rp.Stop()\n334\t\n335\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n336\t\n337\t\t// Call trace-init\n338\t\tbody := `{\"session_id\":\"sess-abc\",\"machine_id\":\"user@host\",\"project_slug\":\"my-project\"}`\n339\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(body))\n340\t\tif err != nil {\n341\t\t\tt.Fatalf(\"trace-init: %v\", err)\n342\t\t}\n343\t\tdefer resp.Body.Close()\n344\t\n345\t\tif resp.StatusCode != 200 {\n346\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n347\t\t}\n348\t\n349\t\tvar result struct {\n350\t\t\tStatus    string `json:\"status\"`\n351\t\t\tTracePath string `json:\"trace_path\"`\n352\t\t}\n353\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n354\t\t\tt.Fatalf(\"parse response: %v\", err)\n355\t\t}\n356\t\n357\t\tif result.Status != \"ok\" {\n358\t\t\tt.Errorf(\"status: got %q, want ok\", result.Status)\n359\t\t}\n360\t\n361\t\texpectedSuffix := filepath.Join(\"user@host\", \"my-project\", \"sess-abc.jsonl\")\n362\t\tif !strings.HasSuffix(filepath.ToSlash(result.TracePath), filepath.ToSlash(expectedSuffix)) {\n363\t\t\tt.Errorf(\"trace_path suffix: got %q, want ending with %q\", result.TracePath, expectedSuffix)\n364\t\t}\n365\t\n366\t\t// Verify file was created\n367\t\tif _, err := os.Stat(result.TracePath); os.IsNotExist(err) {\n368\t\t\tt.Errorf(\"trace file not created: %s\", result.TracePath)\n369\t\t}\n370\t\n371\t\t// Verify directory structure contains machine_id and project_slug\n372\t\trel, _ := filepath.Rel(traceDir, result.TracePath)\n373\t\tparts := strings.Split(filepath.ToSlash(rel), \"/\")\n374\t\tif len(parts) != 3 {\n375\t\t\tt.Errorf(\"expected 3 path components (machine/project/file), got %d: %v\", len(parts), parts)\n376\t\t}\n377\t\tif parts[0] != \"user@host\" {\n378\t\t\tt.Errorf(\"machine_id dir: got %q, want user@host\", parts[0])\n379\t\t}\n380\t\tif parts[1] != \"my-project\" {\n381\t\t\tt.Errorf(\"project_slug dir: got %q, want my-project\", parts[1])\n382\t\t}\n383\t}\n384\t\n385\tfunc TestTraceInitMissingSessionID(t *testing.T) {\n386\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n387\t\t\tw.WriteHeader(200)\n388\t\t})\n389\t\tmockServer := httptest.NewServer(mockHandler)\n390\t\tdefer mockServer.Close()\n391\t\n392\t\ttraceDir := t.TempDir()\n393\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n394\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n395\t\tif err != nil {\n396\t\t\tt.Fatalf(\"start proxy: %v\", err)\n397\t\t}\n398\t\tdefer rp.Stop()\n399\t\n400\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n401\t\n402\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(`{\"session_id\":\"\"}`))\n403\t\tif err != nil {\n404\t\t\tt.Fatalf(\"trace-init: %v\", err)\n405\t\t}\n406\t\tdefer resp.Body.Close()\n407\t\n408\t\tif resp.StatusCode != 400 {\n409\t\t\tt.Errorf(\"expected 400, got %d\", resp.StatusCode)\n410\t\t}\n411\t}\n412\t"}]}
