性\n49\tensure_dirs() {\n50\t  source \"$CLAUDE_PROJECT_DIR/.claude/scripts/ensure_dirs.sh\"\n51\t  local missing\n52\t  missing=$(check_dirs 2>&1)\n53\t  if [ \"$missing\" = \"ALL OK\" ]; then\n54\t    log \"INFO\" \"目录检查通过\"\n55\t  else\n56\t    log \"WARN\" \"目录缺失，重新创建: $missing\"\n57\t    ensure_all_dirs \"$LOG_FILE\" > /dev/null\n58\t  fi\n59\t}\n60\t\n61\tensure_utf8\n62\tensure_python_check\n63\tensure_dirs\n64\t\n65\t# 4. Skill 级巡检\n66\tensure_skill_checks() {\n67\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n68\t  [ -d \"$skills_dir\" ] || return\n69\t  for check_script in \"$skills_dir\"/*/scripts/init_check.sh; do\n70\t    [ -f \"$check_script\" ] || continue\n71\t    local skill_name\n72\t    skill_name=$(basename \"$(dirname \"$(dirname \"$check_script\")\")\")\n73\t    if bash \"$check_script\" >> \"$LOG_FILE\" 2>&1; then\n74\t      log \"INFO\" \"Skill check OK: $skill_name\"\n75\t    else\n76\t      log \"WARN\" \"Skill check failed: $skill_name (non-blocking)\"\n77\t    fi\n78\t  done\n79\t}\n80\t\n81\tensure_skill_checks\n82\t\n83\t# 5. 初始化代理 trace 路径（通过 ANTHROPIC_BASE_URL 告知代理）\n84\tinit_trace_path() {\n85\t  local proxy_url=\"${ANTHROPIC_BASE_URL:-}\"\n86\t  [ -z \"$proxy_url\" ] && return 0\n87\t\n88\t  local sid\n89\t  sid=$(json_get '.session_id')\n90\t  [ -z \"$sid\" ] && return 0\n91\t\n92\t  local machine_id\n93\t  machine_id=\"$(whoami 2>/dev/null || echo unknown)@$(hostname 2>/dev/null || echo unknown)\"\n94\t\n95\t  local transcript_path\n96\t  transcript_path=$(json_get '.transcript_path')\n97\t\n98\t  local project_slug\n99\t  project_slug=$(echo \"$transcript_path\" | sed -n 's/.*[\\.]claude[\\\\/]\\{1\\}projects[\\\\/]\\{1\\}\\([^\\\\/]*\\).*/\\1/p')\n100\t  [ -z \"$project_slug\" ] && project_slug=$(basename \"$(json_get '.cwd')\" 2>/dev/null)\n101\t\n102\t  local result\n103\t  result=$(curl -s --max-time 3 -X POST \"$proxy_url/_internal/trace-init\" \\\n104\t    -H \"Content-Type: application/json\" \\\n105\t    -d \"