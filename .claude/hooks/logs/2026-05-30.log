\n269\t\t\t})\n270\t\t}\n271\t}\n272\t\n273\tfunc TestMalformedRequest_ExtraFieldsIgnored(t *testing.T) {\n274\t\tenv, _ := setupDegradationTest(t)\n275\t\tt.Cleanup(func() { env.store.Close() })\n276\t\n277\t\t// Extra fields should be silently ignored\n278\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/check\", \"application/json\",\n279\t\t\tstrings.NewReader(`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1],\"extra\":\"ignored\"}`))\n280\t\tif err != nil {\n281\t\t\tt.Fatal(err)\n282\t\t}\n283\t\tdefer resp.Body.Close()\n284\t\n285\t\tif resp.StatusCode != http.StatusOK {\n286\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n287\t\t}\n288\t}\n289\t\n290\tfunc TestMalformedRequest_InvalidMethod(t *testing.T) {\n291\t\tenv, _ := setupDegradationTest(t)\n292\t\tt.Cleanup(func() { env.store.Close() })\n293\t\n294\t\t// GET instead of POST\n295\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/claim\")\n296\t\tif err != nil {\n297\t\t\tt.Fatal(err)\n298\t\t}\n299\t\tdefer resp.Body.Close()\n300\t\n301\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n302\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n303\t\t}\n304\t}\n305\t\n306\tfunc TestMalformedRequest_ReleaseSessionEmptySessionID(t *testing.T) {\n307\t\tenv, _ := setupDegradationTest(t)\n308\t\tt.Cleanup(func() { env.store.Close() })\n309\t\n310\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/release-session\", \"application/json\",\n311\t\t\tstrings.NewReader(`{\"session_id\":\"\"}`))\n312\t\tif err != nil {\n313\t\t\tt.Fatal(err)\n314\t\t}\n315\t\tdefer resp.Body.Close()\n316\t\n317\t\tif resp.StatusCode != http.StatusBadRequest {\n318\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n319\t\t}\n320\t}\n321\t\n322\tfunc TestMalformedRequest_UnicodeInFields(t *testing.T) {\n323\t\tenv, _ := setupDegradationTest(t)\n324\t\tt.Cleanup(func() { env.store.Close() })\n325\t\n326\t\tbody := `{\"repo_full_name\":\"测试/仓库\",\"issue_numbers\":[1]}`\n327\t\tresp, err := http.