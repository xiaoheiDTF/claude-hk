evious_status\"`\n854\t\t\t\tNewStatus      string `json:\"new_status\"`\n855\t\t\t}\n856\t\t\treadJSON(t, resp, &result)\n857\t\t\tif !result.Success {\n858\t\t\t\tt.Fatal(\"testing update failed\")\n859\t\t\t}\n860\t\t\tif result.PreviousStatus != \"pr-created\" {\n861\t\t\t\tt.Errorf(\"expected previous=pr-created, got %s\", result.PreviousStatus)\n862\t\t\t}\n863\t\n864\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{40})\n865\t\t\tif s[40] != \"testing\" {\n866\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[40])\n867\t\t\t}\n868\t\t})\n869\t\n870\t\tt.Run(\"testing_released_on_session_end\", func(t *testing.T) {\n871\t\t\te := setup(t)\n872\t\t\tdb := e.store.DB()\n873\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"testing\", \"sess_test_end\", \"2026-05-27T10:00:00Z\")\n874\t\n875\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n876\t\t\t\t`{\"session_id\":\"sess_test_end\"}`)\n877\t\t\tvar rel struct{ Count int `json:\"count\"` }\n878\t\t\treadJSON(t, resp, &rel)\n879\t\t\tif rel.Count != 1 {\n880\t\t\t\tt.Fatalf(\"expected 1 released, got %d\", rel.Count)\n881\t\t\t}\n882\t\n883\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n884\t\t\tif s[10] != \"idle\" {\n885\t\t\t\tt.Errorf(\"expected idle after session end, got %s\", s[10])\n886\t\t\t}\n887\t\t})\n888\t\n889\t\tt.Run(\"full_lifecycle_to_testing\", func(t *testing.T) {\n890\t\t\te := setup(t)\n891\t\n892\t\t\t// idle\n893\t\t\te.post(t, \"/api/issue/check\",\n894\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[45]}`)\n895\t\n896\t\t\t// claim → fixing → ready-for-pr → pr-created → testing\n897\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 45, \"sess_test_lc\")\n898\t\t\te.post(t, \"/api/issue/status\",\n899\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"fixing\"}`)\n900\t\t\te.post(t, \"/api/issue/status\",\n901\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"ready-for-pr\"}`)\n902\t\t\te.post(t, \"/api/issue/status\",\n903\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"pr-created\"}`)\n904\t\t\te.post(t, \"/api/issue/status\",\n905\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"testing\"}`)\n906\t\n907\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{45})\n908\t\t\tif s[45] != \"testing\" {\n909\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[45])\n910\t\t\t}\n911\t\n912\t\t\t// session end 释放 testing\n913\t\t\te.post(t, \"/api/issue/release-session\",\n914\t\t\t\t`{\"session_id\":\"sess_test_lc\"}`)\n915\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{45})\n916\t\t\tif s[45] != \"idle\" {\n917\t\t\t\tt.Fatalf(\"expected idle after session end, got %s\", s[45])\n918\t\t\t}\n919\t\n920\t\t\t// re-claim\n921\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 45, \"sess_new\")\n922\t\t\tif code != http.StatusOK || !ok {\n923\t\t\t\tt.Fatalf(\"re-claim failed\")\n924\t\t\t}\n925\t\t})\n926\t}\n927\t\n928\t// --- D6: 003-9-issue-review 技能集成测试 ---\n929\t// 验收标准：\n930\t//   - testing → reviewing → merged 完整流程\n931\t//   - merged 终态不被 session end 释放\n932\t//   - rejected 终态不被 session end 释放\n933\t//   - rejected issue 释放后可被重新 claim\n934\t\n935\tfunc TestIssueReviewFlow(t *testing.T) {\n936\t\tt.Run(\"merge_full_flow\", func(t *testing.T) {\n937\t\t\te := setup(t)\n938\t\n939\t\t\t// claim → fixing → ready-for-pr → pr-created → testing → reviewing → merged\n940\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 50, \"sess_merge\")\n941\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n942\t\t\t\te.post(t, \"/api/issue/status\",\n943\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":50,\"session_id\":\"sess_merge\",\"status\":\"%s\"}`, s))\n944\t\t\t}\n945\t\n946\t\t\tresp := e.post(t, \"/api/issue/status\",\n947\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":50,\"session_id\":\"sess_merge\",\"status\":\"merged\"}`)\n948\t\t\tvar result struct {\n949\t\t\t\tSuccess        bool   `json:\"success\"`\n950\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n951\t\t\t\tNewStatus      string `json:\"new_status\"`\n952\t\t\t}\n953\t\t\treadJSON(t, resp, &result)\n954\t\t\tif !result.Success {\n955\t\t\t\tt.Fatal(\"merged update failed\")\n956\t\t\t}\n957\t\t\tif result.PreviousStatus != \"reviewing\" {\n958\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n959\t\t\t}\n960\t\n961\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{50})\n962\t\t\tif s[50] != \"merged\" {\n963\t\t\t\tt.Fatalf(\"expected merged, got %s\", s[50])\n964\t\t\t}\n965\t\t})\n966\t\n967\t\tt.Run(\"merged_not_released_on_session_end\", func(t *testing.T) {\n968\t\t\t// 验收：merged 终态不被 session end 释放\n969\t\t\te := setup(t)\n970\t\t\tdb := e.store.DB()\n971\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"merged\", \"sess_merged\", \"2026-05-27T10:00:00Z\")\n972\t\n973\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n974\t\t\t\t`{\"session_id\":\"sess_merged\"}`)\n975\t\t\tvar rel struct{ Count int `json:\"count\"` }\n976\t\t\treadJSON(t, resp, &rel)\n977\t\t\tif rel.Count != 0 {\n978\t\t\t\tt.Fatalf(\"merged should not be released, got count=%d\", rel.Count)\n979\t\t\t}\n980\t\n981\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10})\n982\t\t\tif s[10] != \"merged\" {\n983\t\t\t\tt.Errorf(\"expected merged unchanged, got %s\", s[10])\n984\t\t\t}\n985\t\t})\n986\t\n987\t\tt.Run(\"reject_full_flow\", func(t *testing.T) {\n988\t\t\te := setup(t)\n989\t\n990\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 55, \"sess_reject\")\n991\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n992\t\t\t\te.post(t, \"/api/issue/status\",\n993\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":55,\"session_id\":\"sess_reject\",\"status\":\"%s\"}`, s))\n994\t\t\t}\n995\t\n996\t\t\tresp := e.post(t, \"/api/issue/status\",\n997\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":55,\"session_id\":\"sess_reject\",\"status\":\"rejected\"}`)\n998\t\t\tvar result struct {\n999\t\t\t\tSuccess        bool   `json:\"success\"`\n1000\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1001\t\t\t}\n1002\t\t\treadJSON(t, resp, &result)\n1003\t\t\tif !result.Success {\n1004\t\t\t\tt.Fatal(\"rejected update failed\")\n1005\t\t\t}\n1006\t\t\tif result.PreviousStatus != \"reviewing\" {\n1007\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1008\t\t\t}\n1009\t\n1010\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{55})\n1011\t\t\tif s[55] != \"rejected\" {\n1012\t\t\t\tt.Fatalf(\"expected rejected, got %s\", s[55])\n1013\t\t\t}\n1014\t\t})\n1015\t\n1016\t\tt.Run(\"rejected_not_released_on_session_end\", func(t *testing.T) {\n1017\t\t\t// 验收：rejected 终态不被 session end 释放\n1018\t\t\te := setup(t)\n1019\t\t\tdb := e.store.DB()\n1020\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"rejected\", \"sess_rejected\", \"2026-05-27T10:00:00Z\")\n1021\t\n1022\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1023\t\t\t\t`{\"session_id\":\"sess_rejected\"}`)\n1024\t\t\tvar rel struct{ Count int `json:\"count\"` }\n1025\t\t\treadJSON(t, resp, &rel)\n1026\t\t\tif rel.Count != 0 {\n1027\t\t\t\tt.Fatalf(\"rejected should not be released, got count=%d\", rel.Count)\n1028\t\t\t}\n1029\t\n1030\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{11})\n1031\t\t\tif s[11] != \"rejected\" {\n1032\t\t\t\tt.Errorf(\"expected rejected unchanged, got %s\", s[11])\n1033\t\t\t}\n1034\t\t})\n1035\t\n1036\t\tt.Run(\"non_terminal_reviewing_released_on_session_end\