)\n54\t\n55\t\tminLevel = level\n56\t\tconsole = consoleEnabled\n57\t\n58\t\tif d == \"\" {\n59\t\t\t// 空目录：静默模式，所有写入被丢弃\n60\t\t\tif file != nil {\n61\t\t\t\tfile.Close()\n62\t\t\t}\n63\t\t\tfile = nil\n64\t\t\tdir = \"\"\n65\t\t\tcurrentDate = \"\"\n66\t\t\twriter = nil\n67\t\t\treturn nil\n68\t\t}\n69\t\n70\t\t// 创建目录\n71\t\tif err := os.MkdirAll(d, 0o755); err != nil {\n72\t\t\treturn fmt.Errorf(\"logger: create dir %s: %w\", d, err)\n73\t\t}\n74\t\n75\t\tdir = d\n76\t\n77\t\t// 打开当天的日志文件\n78\t\ttoday := time.Now().Format(\"2006-01-02\")\n79\t\tif err := rotateFile(today); err != nil {\n80\t\t\treturn err\n81\t\t}\n82\t\n83\t\treturn nil\n84\t}\n85\t\n86\t// Close 刷新并关闭当前日志文件。\n87\tfunc Close() error {\n88\t\tmu.Lock()\n89\t\tdefer mu.Unlock()\n90\t\tif file != nil {\n91\t\t\terr := file.Close()\n92\t\t\tfile = nil\n93\t\t\twriter = nil\n94\t\t\tcurrentDate = \"\"\n95\t\t\treturn err\n96\t\t}\n97\t\treturn nil\n98\t}\n99\t\n100\t// SetLevel 运行时调整最低日志级别。\n101\tfunc SetLevel(level Level) {\n102\t\tmu.Lock()\n103\t\tdefer mu.Unlock()\n104\t\tminLevel = level\n105\t}\n106\t\n107\t// Debug 记录 DEBUG 级别日志。\n108\tfunc Debug(module, format string, args ...any) {\n109\t\twrite(DEBUG, module, format, args...)\n110\t}\n111\t\n112\t// Info 记录 INFO 级别日志。\n113\tfunc Info(module, format string, args ...any) {\n114\t\twrite(INFO, module, format, args...)\n115\t}\n116\t\n117\t// Warn 记录 WARN 级别日志。\n118\tfunc Warn(module, format string, args ...any) {\n119\t\twrite(WARN, module, format, args...)\n120\t}\n121\t\n122\t// Error 记录 ERROR 级别日志。\n123\tfunc Error(module, format string, args ...any) {\n124\t\twrite(ERROR, module, format, args...)\n125\t}\n126\t\n127\tvar levelNames = [4]string{\"DEBUG\", \"INFO \", \"WARN \", \"ERROR\"}\n128\t\n129\t// write 是所有日志方法的核心实现。\n130\t//\n131\t// 检查级别 → 加锁 → 检查日期轮转 → 格式化 → 写文件 → 可选写 stderr\n132\tfunc write(level Level, module, format string, args ...any) {\n133\t\tif level < minLevel {\n134\t\t\treturn\n135\t\t}\n136\t\n137\t\tmu.Lock()\n138\t\tdefer mu.Unlock()\n139\t\n140\t\t// 日期轮转检查（懒检测）\n141\t\ttoday := time.Now().Format(\"2006-01-02\")\n142\t\tif today != currentDate && dir != \"\" {\n143\t\t\t_ = rotateFile(today)\n144\t\t}\n145\t\n146\t\t// 格式化日志行：15:04:05.000 [LEVEL] module: message\n147\t\tts := time.Now().Format(\"15:04:05.000\")\n148\t\tmsg := fmt.Sprintf(format, args...)\n149\t\tline := fmt.Sprintf(\"%s [%s] %s: %s\\n\", ts, levelNames[level], module, msg)\n150\t\n151\t\t// 写入文件\n152\t\tif writer != nil {\n153\t\t\t_, _ = writer.Write([]byte(line))\n154\t\t}\n155\t\n156\t\t// 可选：同时输出到 stderr（仅 INFO 及以上）\n157\t\tif console && level >= INFO {\n158\t\t\t_, _ = fmt.Fprint(os.Stderr, line)\n159\t\t}\n160\t}\n161\t\n162\t// rotateFile 关闭旧文件并打开新日期的日志文件。\n163\t// 调用方必须持有 mu 锁。\n164\tfunc rotateFile(date string) error {\n165\t\tif file != nil {\n166\t\t\tfile.Close()\n167\t\t\tfile = nil\n168\t\t\twriter = nil\n169\t\t}\n170\t\n171\t\tpath := filepath.Join(dir, date+\".log\")\n172\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)\n173\t\tif err != nil {\n174\t\t\tfmt.Fprintf(os.Stderr, \"logger: failed to open %s: %v\\n\", path, err)\n175\t\t\treturn err\n176\t\t}\n177\t\n178\t\tfile = f\n179\t\twriter = f\n180\t\tcurrentDate = date\n181\t\treturn nil\n182\t}\n183\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\config\\client.go"},"tool_use_id":"call_81b86aa9b9ed412c89b7a91b","tool_response":"1\t// Package config 提供代理所需的配置读取与解析功能。\n2\tpackage config\n3\t\n4\timport (\n5\t\t\"fmt\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n11\t)\n12\t\n13\t// ClientConfig 定义通过代理启动 AI CLI 时的单客户端配置。\n14\ttype ClientConfig struct {\n15\t\tCmd               string   // 要定位的二进制文件名\n16\t\tBaseURLEnv         string   // 用于覆盖 base URL 的环境变量名\n17\t\tDefaultTarget      string   // 无覆盖时的默认上游 API 地址\n18\t\tNestingEnvKeys     []string // 启动前需清空的环境变量（防止嵌套代理）\n19\t\tInjectSettingsEnv  bool     // 是否通过 --settings 参数注入 base URL（Claude Code 专用）\n20\t}\n21\t\n22\t// ClaudeClient 是 Claude Code 的默认配置。\n23\tvar ClaudeClient = ClientConfig{\n24\t\tCmd:              \"claude\",\n25\t\tBaseURLEnv:       \"ANTHROPIC_BASE_URL\",\n26\t\tDefaultTarget:    \"https://api.anthropic.com\",\n27\t\tNestingEnvKeys:   []string{\"CLAUDECODE\", \"CLAUDE_CODE_SSE_PORT\"},\n28\t\tInjectSettingsEnv: true,\n29\t}\n30\t\n31\t// DetectTarget 按优先级确定上游 API URL：\n32\t//  1. 显式环境变量（如 ANTHROPIC_BASE_URL）\n33\t//  2. ~/.claude.json 配置文件\n34\t//  3. 默认目标地址\n35\tfunc DetectTarget(cfg *ClientConfig) string {\n36\t\t// 优先检查环境变量\n37\t\tif envURL := os.Getenv(cfg.BaseURLEnv); envURL != \"\" {\n38\t\t\tlogger.Debug(\"config\", \"detected target from env %s=%s\", cfg.BaseURLEnv, envURL)\n39\t\t\treturn envURL\n40\t\t}\n41\t\tlogger.Debug(\"config\", \"env %s not set\", cfg.BaseURLEnv)\n42\t\n43\t\t// 若为 ClaudeClient，则尝试读取 ~/.claude.json\n44\t\tif cfg == &ClaudeClient {\n45\t\t\tcc, err := ReadClaudeConfig()\n46\t\t\tif err == nil && cc != nil {\n47\t\t\t\tif url := ClaudeBaseURLFromConfig(cc); url != \"\" {\n48\t\t\t\t\tlogger.Debug(\"config\", \"detected target from claude config: %s\", url)\n49\t\t\t\t\treturn url\n50\t\t\t\t}\n51\t\t\t}\n52\t\t}\n53\t\n54\t\tlogger.Info(\"config\", \"upstream target: %s\", cfg.DefaultTarget)\n55\t\treturn cfg.DefaultTarget\n56\t}\n57\t\n58\t// ResolveCmd 在 PATH 中查找客户端二进制文件的完整路径。\n59\tfunc ResolveCmd(cfg *ClientConfig) (string, error) {\n60\t\tpath, err := exec.LookPath(cfg.Cmd)\n61\t\tif err != nil {\n62\t\t\treturn \"\", fmt.Errorf(\"'%s' command not found in PATH.\\nPlease install it first\", cfg.Cmd)\n63\t\t}\n64\t\tlogger.Debug(\"config\", \"resolved command: %s -> %s\", cfg.Cmd, path)\n65\t\treturn path, nil\n66\t}\n67\t\n68\t// BuildChildEnv 创建子进程所需的环境变量：\n69\t//   - 继承当前环境\n70\t//   - 将 base URL 环境变量指向本地代理\n71\t//   - 清空嵌套代理相关环境变量\n72\tfunc BuildChildEnv(cfg *ClientConfig, proxyURL string) []string {\n73\t\tenv := os.Environ()\n74\t\n75\t\tresult := make([]string, 0, len(env)+1)\n76\t\tcleared := make(map[string]bool)\n77\t\tfor _, k := range cfg.NestingEnvKeys {\n78\t\t\tcleared[k] = true\n79\t\t}\n80\t\n81\t\tfor _, e := range env {\n82\t\t\t// 跳过嵌套键与 base URL 环境变量（我们自己设置）\n83\t\t\tskip := false\n84\t\t\tfor _, prefix := range append(clearedKeys(cleared), cfg.BaseURLEnv) {\n85\t\t\t\tif len(e) > len(prefix) && e[:len(prefix)+1] == prefix+\"=\" {\n86\t\t\t\t\tskip = true\n87\t\t\t\t\tbreak\n88\t\t\t\t}\n89\t\t\t}\n90\t\t\tif !skip {\n91\t\t\t\tresult = append(result, e)\n92\t\t\t}\n93\t\t}\n94\t\n95\t\tresult = append(result, cfg.BaseURLEnv+\"=\"+proxyURL)\n96\t\tlogger.Debug(\"config\", \"built child env: %s=%s, cleared %v\", cfg.BaseURLEnv, proxyURL, cfg.NestingEnvKeys)\n97\t\treturn result\n98\t}\n99\t\n100\t// clearedKeys 将 map 的键提取为字符串切片。\n101\tfunc clearedKeys(m map[string]bool) []string {\n102\t\tkeys := make([]string, 0, len(m))\n103\t\tfor k := range m {\n104\t\t\tkeys = append(keys, k)\n105\t\t}\n106\t\treturn keys\n107\t}\n108\t\n109\t// HasSettingsArg 判断参数列表中是否已包含 --settings。\n110\tfunc HasSettingsArg(args []string) bool {\n111\t\tfor _, arg := range args {\n112\t\t\tif arg == \"--settings\" || strings.HasPrefix(arg, \"--settings=\") {\n113\t\t\t\treturn true\n114\t\t\t}\n115\t\t}\n116\t\treturn false\n117\t}\n118\t\n119\t// BuildSettingsArgs 返回 [\"--settings\", JSON] 用于通过 Claude 的 settings 注入代理 URL。\n120\tfunc BuildSettingsArgs(cfg *ClientConfig, proxyURL string) []string {\n121\t\tenvJSON := fmt.Sprintf(`{\"env\":{\"%s\":\"%s\"}}`, cfg.BaseURLEnv, proxyURL)\n122\t\treturn []string{\"--settings\", envJSON}\n123\t}\n124\t"}]}
