result\n72\t}\n73\t\n74\t// firstInt64 在 map 中按给定 keys 的优先顺序查找第一个非零的 int64 值。\n75\t// 如果所有 key 都不存在或值为零，则返回 0。\n76\tfunc firstInt64(m map[string]any, keys ...string) int64 {\n77\t\tfor _, k := range keys {\n78\t\t\tif v := intFromMap(m, k); v != 0 {\n79\t\t\t\treturn v\n80\t\t\t}\n81\t\t}\n82\t\treturn 0\n83\t}\n84\t\n85\t// intFromMap 从 map 中按 key 提取 int64 值，兼容多种数值类型。\n86\t//\n87\t// 支持的类型：\n88\t//   - float64（JSON 反序列化后的数字默认类型）\n89\t//   - int\n90\t//   - int64\n91\t//   - json.Number（encoding/json 的数字类型，通过接口匹配避免引入包依赖）\n92\tfunc intFromMap(m map[string]any, key string) int64 {\n93\t\tv, ok := m[key]\n94\t\tif !ok {\n95\t\t\treturn 0\n96\t\t}\n97\t\tswitch n := v.(type) {\n98\t\tcase float64:\n99\t\t\treturn int64(n)\n100\t\tcase int:\n101\t\t\treturn int64(n)\n102\t\tcase int64:\n103\t\t\treturn n\n104\t\tcase json_number:\n105\t\t\tif i, err := n.Int64(); err == nil {\n106\t\t\t\treturn i\n107\t\t\t}\n108\t\t}\n109\t\treturn 0\n110\t}\n111\t\n112\t// json_number 是一个本地接口，用于匹配 encoding/json.Number 类型，\n113\t// 从而在不直接导入 encoding/json 包的情况下，安全地处理 JSON 数字值。\n114\ttype json_number interface{ Int64() (int64, error) }\n115\t\n116\t// mapKeys 返回 map 的 key 列表，用于调试日志。\n117\tfunc mapKeys(m map[string]any) []string {\n118\t\tkeys := make([]string, 0, len(m))\n119\t\tfor k := range m {\n120\t\t\tkeys = append(keys, k)\n121\t\t}\n122\t\treturn keys\n123\t}\n124\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\usage\\anthropic.go"},"tool_use_id":"call_7d0abaad254a438fb83ad512","tool_response":"1\tpackage usage\n2\t\n3\t// AnthropicNormalizedUsage 定义了 Anthropic 风格的标准化 Token 用量结构体。\n4\t//\n5\t// 该结构体将不同 Provider（如 Anthropic、OpenAI、Google Gemini）各自的 Token 字段名\n6\t// 统一映射到 Anthropic 规范下的标准名称，便于后续统计和展示。\n7\ttype AnthropicNormalizedUsage struct {\n8\t\tInputTokens              int64 `json:\"input_tokens\"`                            // 输入 Token 数量（prompt tokens）\n9\t\tOutputTokens             int64 `json:\"output_tokens\"`                           // 输出 Token 数量（completion tokens）\n10\t\tCacheReadInputTokens     int64 `json:\"cache_read_input_tokens,omitempty\"`       // 缓存命中读取的输入 Token 数量（可选）\n11\t\tCacheCreationInputTokens int64 `json:\"cache_creation_input_tokens,omitempty\"`   // 缓存创建时写入的输入 Token 数量（可选）\n12\t}\n13\t"}]}
