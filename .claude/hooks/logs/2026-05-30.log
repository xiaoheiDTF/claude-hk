 := api.NewRouter(api.Handlers{\n52\t\t\tIssue: api.NewIssueHandler(issueSvc),\n53\t\t})\n54\t\n55\t\tsrv := httptest.NewServer(router)\n56\t\tt.Cleanup(srv.Close)\n57\t\n58\t\treturn &env{srv: srv, store: s}\n59\t}\n60\t\n61\t// post 发送 POST 请求到集成测试环境。\n62\tfunc (e *env) post(t *testing.T, path, body string) *http.Response {\n63\t\tt.Helper()\n64\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n65\t\tif err != nil {\n66\t\t\tt.Fatal(err)\n67\t\t}\n68\t\treturn resp\n69\t}\n70\t\n71\t// readJSON 读取 HTTP 响应并解析为 JSON。\n72\tfunc readJSON(t *testing.T, resp *http.Response, v any) {\n73\t\tt.Helper()\n74\t\tdefer resp.Body.Close()\n75\t\tb, err := io.ReadAll(resp.Body)\n76\t\tif err != nil {\n77\t\t\tt.Fatal(err)\n78\t\t}\n79\t\tif err := json.Unmarshal(b, v); err != nil {\n80\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n81\t\t}\n82\t}\n83\t\n84\t// seedIssue 在数据库中预置一条 issue 记录。\n85\tfunc seedIssue(db *sql.DB, repo string, number int, status, sessionID, claimedAt string) {\n86\t\tdb.Exec(\n87\t\t\t`INSERT INTO issue_claims (repo_full_name, issue_number, status, session_id, claimed_at, updated_at)\n88\t\t\t VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)`,\n89\t\t\trepo, number, status,\n90\t\t\tnilIfEmpty(sessionID), nilIfEmpty(claimedAt),\n91\t\t)\n92\t}\n93\t\n94\t// claimIssue 调用 claim API 并返回 (statusCode, success, claimed_by)。\n95\tfunc claimIssue(t *testing.T, e *env, repo string, number int, sessionID string) (int, bool, string) {\n96\t\tt.Helper()\n97\t\n98\t\tbody := fmt.Sprintf(\n99\t\t\t`{\"repo_full_name\":\"%s\",\"issue_number\":%d,\"session_id\":\"%s\"}`,\n100\t\t\trepo, number, sessionID)"}]}
