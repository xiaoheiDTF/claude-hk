t)\n1168\t\t\t}\n1169\t\t\tif len(result.Released) != 1 || result.Released[0] != 11 {\n1170\t\t\t\tt.Fatalf(\"expected [11], got %v\", result.Released)\n1171\t\t\t}\n1172\t\n1173\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11})\n1174\t\t\tif s[10] != \"merged\" {\n1175\t\t\t\tt.Errorf(\"merged should stay, got %s\", s[10])\n1176\t\t\t}\n1177\t\t\tif s[11] != \"idle\" {\n1178\t\t\t\tt.Errorf(\"fixing should be idle, got %s\", s[11])\n1179\t\t\t}\n1180\t\t})\n1181\t\n1182\t\tt.Run(\"rejected_not_released\", func(t *testing.T) {\n1183\t\t\t// 验收：rejected 终态不被释放\n1184\t\t\te := setup(t)\n1185\t\t\tdb := e.store.DB()\n1186\t\n1187\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"rejected\", \"sess_d7_r\", \"2026-05-27T10:00:00Z\")\n1188\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 11, \"claimed\", \"sess_d7_r\", \"2026-05-27T10:00:00Z\")\n1189\t\n1190\t\t\tresp := e.post(t, \"/api/issue/release-session\",\n1191\t\t\t\t`{\"session_id\":\"sess_d7_r\"}`)\n1192\t\t\tvar result struct{ Count int `json:\"count\"` }\n1193\t\t\treadJSON(t, resp, &result)\n1194\t\n1195\t\t\tif result.Count != 1 {\n1196\t\t\t\tt.Fatalf(\"expected 1 released (claimed only), got %d\", result.Count)\n1197\t\t\t}\n1198\t\n1199\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{10, 11})\n1200\t\t\tif s[10] != \"rejected\" {\n1201\t\t\t\tt.Errorf(\"rejected should stay, got %s\", s[10])\n1202\t\t\t}\n1203\t\t\tif s[11] != \"idle\" {\n1204\t\t\t\tt.Errorf(\"claimed should be idle, got %s\", s[11])\n1205\t\t\t}\n1206\t\t})\n1207\t\n1208\t\tt.Run(\"released_issue_can_be_reclaimed\", func(t *testing.T) {\n1209\t\t\t// 验收：释放后 issue 可被重新 claim\n1210\t\t\te := setup(t)\n1211\t\t\tdb := e.store.DB()\n1212\t\n1213\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"fixing\", \"sess_old\", \"2026-05-27T10:00:00Z\")\n1214\t\n1215\t\t\t// 释放\n1216\t\t\te.post(t, \"/api/issue/release-session\",\n1217\t\t\t\t`{\"session_id\":\"sess_old\"}`)\n1218\t\n1219\t\t\t// 新 session claim\n1220