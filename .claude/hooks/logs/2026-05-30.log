decoded, err := io.ReadAll(reader); err == nil {\n\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n\t\t\t\tdecodeBytes = decoded\n\t\t\t}\n\t\t\t_ = reader.Close()\n\t\t}\n\t}\n\n\t// 解析解压后的 JSON 响应体\n\tvar respBody any\n\tif len(decodeBytes) > 0 {\n\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n\t}","numLines":50,"startLine":240,"totalLines":496}},"tool_use_id":"call_335178686a134fbf94d09ab3","duration_ms":1}
