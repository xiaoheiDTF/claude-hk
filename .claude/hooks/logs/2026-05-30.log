()\n\n\t// 等待子进程结束\n\twaitErr := cmd.Wait()\n\n\t// 停止信号处理器，释放资源\n\tsignal.Stop(sigChan)\n\tclose(sigChan)\n\n\t// 打印运行摘要：API 调用次数和 token 使用情况","numLines":50,"startLine":200,"totalLines":396}},"tool_use_id":"call_f5d2cf926fc04815a15b20bd","duration_ms":6}
