-f \"$BACKEND_CONF\"\n50\t}\n51\t\n52\trun_test() {\n53\t  local name=\"$1\"\n54\t  shift\n55\t  TOTAL=$((TOTAL + 1))\n56\t  echo \"\"\n57\t  echo \"--- [$name] ---\"\n58\t  if \"$@\"; then\n59\t    PASS=$((PASS + 1))\n60\t    echo -e \"${GREEN}PASS${NC}: $name\"\n61\t  else\n62\t    FAIL=$((FAIL + 1))\n63\t    echo -e \"${RED}FAIL${NC}: $name\"\n64\t  fi\n65\t}\n66\t\n67\tcleanup() {\n68\t  restore_conf\n69\t  if [ -n \"${BACKEND_PID:-}\" ]; then\n70\t    kill \"$BACKEND_PID\" 2>/dev/null || true\n71\t    wait \"$BACKEND_PID\" 2>/dev/null || true\n72\t  fi\n73\t  [ -n \"${TEMP_DB:-}\" ] && rm -f \"$TEMP_DB\"\n74\t}\n75\ttrap cleanup EXIT\n76\t\n77\t# --- Test: no backend.conf, all backend calls skip ---\n78\t\n79\ttest_no_conf_all_pass() {\n80\t  remove_conf\n81\t\n82\t  # Reset BACKEND_URL\n83\t  BACKEND_URL=\"\"\n84\t  source \"$BACKEND_SH\"\n85\t\n86\t  # _load_backend_url should fail\n87\t  BACKEND_URL=\"\"\n88\t  _load_backend_url\n89\t  [ $? -ne 0 ] || { echo \"FAIL: _load_backend_url should return non-zero without conf\"; return 1; }\n90\t\n91\t  # _backend_available should return false\n92\t  BACKEND_URL=\"\"\n93\t  if _backend_available; then\n94\t    echo \"FAIL: _backend_available should be false without conf\"\n95\t    return 1\n96\t  fi\n97\t\n98\t  # update_issue_status should silently return 0\n99\t  BACKEND_URL=\"\"\n100\t  update_issue_status 1 \"fixing\"\n101\t  [ $? -eq 0 ] || { echo \"FAIL: update_issue_status should return 0 without conf\"; return 1; }\n102\t\n103\t  echo \"OK: no conf, all calls skip gracefully\"\n104\t  return 0\n105\t}\n106\t\n107\t# --- Test: malformed backend.conf does not crash ---\n108\t\n109\ttest_malformed_conf_no_crash() {\n110\t  local test_cases=(\n111\t    \"\"                                            # empty value\n112\t    \"not-a-url\"                                   # no protocol\n113\t    \"ftp://example.com\"                           # wrong protocol\n114\t    \"http://example.com with spaces\"              # spaces in URL\n115\t    \"http://example.com\ttab\"                     # tab in URL\n116\t    \"BACKEND_URL=\"                                # empty assignment\n117\t  )\n118\t\n119\t  for raw in \"${test_cases[@]}\"; do\n120\t    if [ -z \"$raw\" ] || [ \"$raw\" = \"BACKEND_URL=\" ]; then\n121\t      echo \"BACKEND_URL=\" > \"$BACKEND_CONF\"\n122\t    else\n123\t      echo \"BACKEND_URL=$raw\" > \"$BACKEND_CONF\"\n124\t    fi\n125\t\n126\t    BACKEND_URL=\"\"\n127\t    source \"$BACKEND_SH\"\n128\t\n129\t    if _load_backend_url && [ -n \"$BACKEND_URL\" ]; then\n130\t      echo \"FAIL: _load_backend_url should reject '$raw'\"\n131\t      return 1\n132\t    fi\n133\t  done\n134\t\n135\t  echo \"OK: all malformed configs rejected without crash\"\n136\t  return 0\n137\t}\n138\t\n139\t# --- Test: backend down, claim should be blocked ---\n140\t\n141\ttest_backend_down_claim_blocked() {\n142\t  write_conf \"http://127.0.0.1:19999\"\n143\t\n144\t  BACKEND_URL=\"\"\n145\t  source \"$BACKEND_SH\"\n146\t\n147\t  # _backend_available should return false\n148\t  if _backend_available; then\n149\t    echo \"FAIL: _backend_available should be false when backend is down\"\n150\t    return 1\n151\t  fi\n152\t\n153\t  # _require_backend should return 1 (configured but unreachable)\n154\t  _require_backend\n155\t  local rc=$?\n156\t  if [ $rc -ne 1 ]; then\n157\t    echo \"FAIL: _require_backend should return 1 when configured but unreachable, got $rc\"\n158\t    return 1\n159\t  fi\n160\t\n161\t  echo \"OK: backend down, claim blocked\"\n162\t  return 0\n163\t}\n164\t\n165\t# --- Test: backend down, status update is silent ---\n166\t\n167\ttest_backend_down_status_silent() {\n168\t  write_conf \"http://127.0.0.1:19999\"\n169\t\n170\t  BACKEND_URL=\"\"\n171\t  source \"$BACKEND_SH\"\n172\t\n173\t  # update_issue_status should silently return 0 (no stdout, no error)\n174\t  local output\n175\t  output=$(update_issue_status 1 \"fixing\" 2>&1)\n176\t  local rc=$?\n177\t  if [ $rc -ne 0 ]; then\n178\t    echo \"FAIL: update_issue_status should return 0 when backend down, got $rc\"\n179\t    return 1\n180\t  fi\n181\t  if [ -n \"$output\" ]; then\n182\t    echo \"FAIL: update_issue_status should produce no output, got: $output\"\n183\t    return 1\n184\t  fi\n185\t\n186\t  echo \"OK: status update silent when backend down\"\n187\t  return 0\n188\t}\n189\t\n190\t# --- Test: _call_backend returns failure on unreachable backend ---\n191\t\n192\ttest_backend_down_call_fails() {\n193\t  write_conf \"http://127.0.0.1:19999\"\n194\t\n195\t  BACKEND_URL=\"\"\n196\t  source \"$BACKEND_SH\"\n197\t\n198\t  local result\n199\t  result=$(_call_backend \"/api/issue/check\" '{\"repo\":\"test\",\"issue_numbers\":[1]}')\n200\t  local rc=$?\n201\t  if [ $rc -eq 0 ]; then\n202\t    echo \"FAIL: _call_backend should return non-zero when backend unreachable\"\n203\t    return 1\n204\t  fi\n205\t  if [ -n \"$result\" ]; then\n206\t    echo \"FAIL: _call_backend should return empty when backend unreachable\"\n207\t    return 1\n208\t  fi\n209\t\n210\t  echo \"OK: _call_backend fails cleanly when backend unreachable\"\n211\t  return 0\n212\t}\n213\t\n214\t# --- Test: backend up and healthy ---\n215\t\n216\ttest_backend_up_works() {\n217\t  local url=\"${1:-}\"\n218\t  if [ -z \"$url\" ]; then\n219\t    echo \"SKIP: no backend URL provided\"\n220\t    return 0\n221\t  fi\n222\t\n223\t  write_conf \"$url\"\n224\t\n225\t  BACKEND_URL=\"\"\n226\t  source \"$BACKEND_SH\"\n227\t\n228\t  if ! _backend_available; then\n229\t    echo \"FAIL: _backend_available should return true when backend is up\"\n230\t    return 1\n231\t  fi\n232\t\n233\t  _require_backend\n234\t  local rc=$?\n235\t  if [ $rc -ne 0 ]; then\n236\t    echo \"FAIL: _require_backend should return 0 when backend is up, got $rc\"\n237\t    return 1\n238\t  fi\n239\t\n240\t  # Check issues should work\n241\t  local result\n242\t  result=$(_call_backend \"/api/issue/check\" '{\"repo_full_name\":\"test/degradation\",\"issue_numbers\":[100]}')\n243\t  if [ $? -ne 0 ] || [ -z \"$result\" ]; then\n244\t    echo \"FAIL: /api/issue/check should succeed\"\n245\t    return 1\n246\t  fi\n247\t\n248\t  echo \"$result\" | jq -e '.issues' > /dev/null || {\n249\t    echo \"FAIL: response should have .issues array\"\n250\t    return 1\n251\t  }\n252\t\n253\t  echo \"OK: backend up, all calls work\"\n254\t  return 0\n255\t}\n256\t\n257\t# --- Test: backend recovery preserves state ---\n258\t\n259\ttest_recovery_no_conflict() {\n260\t  local url=\"${1:-}\"\n261\t  if [ -z \"$url\" ]; then\n262\t    echo \"SKIP: no backend URL provided\"\n263\t    return 0\n264\t  fi\n265\t\n266\t  write_conf \"$url\"\n267\t  BACKEND_URL=\"\"\n268\t  source \"$BACKEND_SH\"\n269\t\n270\t  # Claim issue 200\n271\t  local claim_result\n272\t  claim_result=$(_call_backend \"/api/issue/claim\" '{\n273\t    \"repo_full_name\":\"test/degradation\",\n274\t    \"issue_number\":200,\n275\t    \"session_id\":\"sess_recovery_test\",\n276\t    \"issue_title\":\"Recovery test\"\n277\t  }')\n278\t  if [ $? -ne 0 ]; then\n279\t    echo \"FAIL: initial claim should succeed\"\n280\t    return 1\n281\t  fi\n282\t  echo \"$claim_result\" | jq -e '.success' > /dev/null || {\n283\t    echo \"FAIL: claim response should have success=true\"\n284\t    return 1\n285\t  }\n286\t\n287\t  # Try to claim same issue with different session (should fail)\n288\t  local claim2_result\n289\t  claim2_result=$(_call_backend \"/api/issue/claim\" '{\n290\t    \"repo_full_name\":\"test/degradation\",\n291\t    \"issue_number\":200,\n292\t    \"session_id\":\"sess_other\",\n293\t    \"issue_title\":\"Recovery test\"\n294\t  }')\n295\t  local claim2_success\n296\t  claim2_success=$(echo \"$claim2_result\" | jq -r '.success')\n297\t  if [ \"$claim2_success\" = \"true\" ]; then\n298\t    echo \"FAIL: second claim should fail (already claimed)\"\n299\t    return 1\n300\t  fi\n301\t\n302\t  # Release via session\n303\t  local release_result\n304\t  release_result=$(_call_backend \"/api/issue/release-session\" '{\"session_id\":\"sess_recovery_test\"}')\n305\t  if [ $? -ne 0 ]; then\n306\t    echo \"FAIL: release-session should succeed\"\n307\t    return 1\n308\t  fi\n309\t  local released_count\n310\t  released_count=$(echo \"$release_result\" | jq '.count')\n311\t  if [ \"$released_count\" -lt 1 ]; then\n312\t    echo \"FAIL: should release at least 1 issue\"\n313\t    return 1\n314\t  fi\n315\t\n316\t  # Re-claim should now succeed\n317\t  local claim3_result\n318\t  claim3_result=$(_call_backend \"/api/issue/claim\" '{\n319\t    \"repo_full_name\":\"test/degradation\",\n320\t    \"issue_number\":200,\n321\t    \"session_id\":\"sess_other\",\n322\t    \"issue_title\":\"Recovery test\"\n323\t  }')\n324\t  echo \"$claim3_result\" | jq -e '.success' > /dev/null || {\n325\t    echo \"FAIL: re-claim after release should succeed\"\n326\t    return 1\n327\t  }\n328\t\n329\t  # Cleanup: release\n330\t  _call_backend \"/api/issue/release-session\" '{\"session_id\":\"sess_other\"}' > /dev/null\n331\t\n332\t  echo \"OK: recovery scenario works correctly\"\n333\t  return 0\n334\t}\n335\t\n336\t# --- Test: _require_backend distinguishes not-configured vs unreachable ---\n337\t\n338\ttest_require_backend_return_codes() {\n339\t  # Case 1: No backend.conf → return 2 (not configured)\n340\t  remove_conf\n341\t  BACKEND_URL=\"\"\n342\t  source \"$BACKEND_SH\"\n343\t  _require_backend\n344\t  local rc1=$?\n345\t  if [ $rc1 -ne 2 ]; then\n346\t    echo \"FAIL: _require_backend should return 2 when not configured, got $rc1\"\n347\t    return 1\n348\t  fi\n349\t\n350\t  # Case 2: Backend configured but unreachable → return 1\n351\t  write_conf \"http://127.0.0.1:19999\"\n352\t  BACKEND_URL=\"\"\n353\t  source \"$BACKEND_SH\"\n354\t  _require_backend\n355\t  local rc2=$?\n356\t  if [ $rc2 -ne 1 ]; then\n357\t    echo \"FAIL: _require_backend should return 1 when unreachable, got $rc2\"\n358\t    return 1\n359\t  fi\n360\t\n361\t  echo \"OK: _require_backend return codes correct\"\n362\t  return 0\n363\t}\n364\t\n365\t# --- Main ---\n366\t\n367\techo \"=== Shell Degradation Tests ===\"\n368\techo \"Project: $PROJECT_DIR\"\n369\techo \"\"\n370\t\n371\t# Tests that don't need a running backend\n372\trun_test \"no_conf_all_pass\" test_no_conf_all_pass\n373\trun_test \"malformed_conf_no_crash\" test_malformed_conf_no_crash\n374\trun_test \"backend_down_claim_blocked\" test_backend_down_claim_blocked\n375\trun_test \"backend_down_status_silent\" test_backend_down_status_silent\n376\trun_test \"backend_down_call_fails\" test_backend_down_call_fails\n377\trun_test \"require_backend_return_codes\" test_require_backend_return_codes\n378\t\n379\t# Tests that need a running backend (if URL provided)\n380\tBACKEND_URL_ARG=\"${1:-}\"\n381\tif [ -n \"$BACKEND_URL_ARG\" ]; then\n382\t  if command -v jq &>/dev/null; then\n383\t    run_test \"backend_up_works\" test_backend_up_works \"$BACKEND_URL_ARG\"\n384\t    run_test \"recovery_no_conflict\" test_recovery_no_conflict \"$BACKEND_URL_ARG\"\n385\t  else\n386\t    echo \"\"\n387\t    echo \"NOTE: Skipping backend-up tests (jq not found in PATH).\"\n388\t    echo \"  Install jq to run these tests.\"\n389\t  fi\n390\telse\n391\t  echo \"\"\n392\t  echo \"NOTE: Skipping backend-up tests. To run them:\"\n393\t  echo \"  1. Start backend: go run ./cmd/claude-tap backend --db /tmp/test-degradation.db\"\n394\t  echo \"  2. Run: bash $0 http://127.0.0.1:8080\"\n395\tfi\n396\t\n397\t# --- Summary ---\n398\techo \"\"\n399\techo \"================================\"\n400\techo \"Results: $PASS/$TOTAL passed, $FAIL failed\"\n401\techo \"================================\"\n402\t\n403\t[ $FAIL -eq 0 ] || exit 1\n404\t"}]}
