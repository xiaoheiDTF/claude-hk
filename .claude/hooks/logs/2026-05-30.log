[2026-05-30 20:53:32] [INFO] [PostToolBatch] Input: {"session_id":"9bf82fe9-e376-4adb-95bb-300f36566835","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\9bf82fe9-e376-4adb-95bb-300f36566835.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus","permission_mode":"acceptEdits","agent_id":"a29f20c16fdafc740","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\proxy_handler.go"},"tool_use_id":"call_36e9e274fb7643fc9adbb868","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"encoding/json\"\n7\t\t\"io\"\n8\t\t\"net/http\"\n9\t\t\"sync\"\n10\t\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n12\t)\n13\t\n14\t// ProxyHandler 处理代理注册和 trace-init 转发。\n15\ttype ProxyHandler struct {\n16\t\tmu      sync.RWMutex\n17\t\tproxies map[string]string // pid -> proxy_url，注册的代理列表\n18\t}\n19\t\n20\t// NewProxyHandler 创建代理处理器。\n21\tfunc NewProxyHandler() *ProxyHandler {\n22\t\treturn &ProxyHandler{\n23\t\t\tproxies: make(map[string]string),\n24\t\t}\n25\t}\n26\t\n27\t// Register 处理代理注册请求。\n28\t// POST /api/proxy/register\n29\t// Body: {\"pid\": \"28364\", \"proxy_url\": \"http://127.0.0.1:64902\"}\n30\tfunc (h *ProxyHandler) Register(w http.ResponseWriter, r *http.Request) {\n31\t\tif r.Method != http.MethodPost {\n32\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n33\t\t\treturn\n34\t\t}\n35\t\n36\t\tvar req struct {\n37\t\t\tPID      string `json:\"pid\"`\n38\t\t\tProxyURL string `json:\"proxy_url\"`\n39\t\t}\n40\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n41\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n42\t\t\treturn\n43\t\t}\n44\t\n45\t\tif req.PID == \"\" || req.ProxyURL == \"\" {\n46\t\t\thttp.Error(w, \"pid and proxy_url required\", http.StatusBadRequest)\n47\t\t\treturn\n48\t\t}\n49\t\n50\t\th.mu.Lock()\n51\t\th.proxies[req.PID] = req.ProxyURL\n52\t\th.mu.Unlock()\n53\t\n54\t\tlogger.Info(\"api.proxy\", \"registered: pid=%s url=%s\", req.PID, req.ProxyURL)\n55\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n56\t}\n57\t\n58\t// Unregister 处理代理注销请求。\n59\t// POST /api/proxy/unregister\n60\t// Body: {\"pid\": \"28364\"}\n61\tfunc (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request) {\n62\t\tif r.Method != http.MethodPost {\n63\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n64\t\t\treturn\n65\t\t}\n66\t\n67\t\tvar req struct {\n68\t\t\tPID string `json:\"pid\"`\n69\t\t}\n70\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n71\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n72\t\t\treturn\n73\t\t}\n74\t\n75\t\th.mu.Lock()\n76\t\tdelete(h.proxies, req.PID)\n77\t\th.mu.Unlock()\n78\t\n79\t\tlogger.Info(\"api.proxy\", \"unregistered: pid=%s\", req.PID)\n80\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n81\t}\n82\t\n83\t// TraceInit 转发 trace-init 请求到所有注册的代理。\n84\t// POST /api/proxy/trace-init\n85\t// 将请求体原样转发给每个代理的 /_internal/trace-init，返回第一个成功的响应。\n86\tfunc (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request) {\n87\t\tif r.Method != http.MethodPost {\n88\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n89\t\t\treturn\n90\t\t}\n91\t\n92\t\t// 读取请求体\n93\t\tbody, err := io.ReadAll(r.Body)\n94\t\tif err != nil {\n95\t\t\thttp.Error(w, \"read body failed\", http.StatusBadRequest)\n96\t\t\treturn\n97\t\t}\n98\t\n99\t\t// 获取所有注册的代理\n100\t\th.mu.RLock()\n101\t\turls := make([]string, 0, len(h.proxies))\n102\t\tfor _, url := range h.proxies {\n103\t\t\turls = append(urls, url)\n104\t\t}\n105\t\th.mu.RUnlock()\n106\t\n107\t\tif len(urls) == 0 {\n108\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: no proxies registered\")\n109\t\t\thttp.Error(w, \"no proxies registered\", http.StatusServiceUnavailable)\n110\t\t\treturn\n111\t\t}\n112\t\n113\t\t// 转发到每个代理，返回第一个成功的响应\n114\t\tfor _, proxyURL := range urls {\n115\t\t\tresp, err := relayTraceInit(proxyURL, body)\n116\t\t\tif err != nil {\n117\t\t\t\tlogger.Debug(\"api.proxy\", \"trace-init relay to %s failed: %v\", proxyURL, err)\n118\t\t\t\tcontinue\n119\t\t\t}\n120\t\t\twriteJSON(w, http.StatusOK, resp)\n121\t\t\treturn\n122\t\t}\n123\t\n124\t\tlogger.Warn(\"api.proxy\", \"trace-init: all proxies failed\")\n125\t\thttp.Error(w, \"all proxies unreachable\", http.StatusBadGateway)\n126\t}\n127\t\n128\t// relayTraceInit 将 trace-init 请求转发到指定代理。\n129\tfunc relayTraceInit(proxyURL string, body []byte) (map[string]any, error) {\n130\t\tclient := &http.Client{}\n131\t\treq, err := http.NewRequest(\"POST\", proxyURL+\"/_internal/trace-init\", bytes.NewReader(body))\n132\t\tif err != nil {\n133\t\t\treturn nil, err\n134\t\t}\n135\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n136\t\n137\t\tresp, err := client.Do(req)\n138\t\tif err != nil {\n139\t\t\treturn nil, err\n140\t\t}\n141\t\tdefer resp.Body.Close()\n142\t\n143\t\tif resp.StatusCode != http.StatusOK {\n144\t\t\treturn nil, err\n145\t\t}\n146\t\n147\t\tvar result map[string]any\n148\t\tif json.NewDecoder(resp.Body).Decode(&result) != nil {\n149\t\t\treturn nil, err\n150\t\t}\n151\t\treturn result, nil\n152\t}\n153\t"}]}
