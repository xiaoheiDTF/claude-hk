ackend.NewServer(cfg)\n\tif err != nil {\n\t\tlog.Fatalf(\"create server: %v\", err)\n\t}\n\t// 函数退出时确保关闭服务器资源\n\tdefer srv.Close()\n\n\t// 启动服务器并开始监听请求\n\tif err := srv.Start(); err != nil {\n\t\tlog.Fatalf(\"server error: %v\", err)\n\t}\n}\n"}],"tool_use_id":"call_24451f71d8e045a69a644248","duration_ms":4}
