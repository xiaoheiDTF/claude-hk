\n18\t}\n19\t\n20\t// NewSQLiteStore 创建并初始化 SQLite 存储。\n21\t// 打开数据库、设置 WAL 模式、执行迁移，然后初始化各子存储。\n22\tfunc NewSQLiteStore(dbPath string) (*SQLiteStore, error) {\n23\t\tlogger.Debug(\"store\", \"opening sqlite: %s\", dbPath)\n24\t\t// 打开数据库，设置 busy timeout 为 5 秒\n25\t\tdb, err := sql.Open(\"sqlite\", dbPath+\"?_pragma=busy_timeout(5000)\")\n26\t\tif err != nil {\n27\t\t\treturn nil, fmt.Errorf(\"open sqlite: %w\", err)\n28\t\t}\n29\t\n30\t\t// 启用 WAL 模式以提高并发性能\n31\t\tif _, err := db.Exec(\"PRAGMA journal_mode=WAL\"); err != nil {\n32\t\t\tdb.Close()\n33\t\t\treturn nil, fmt.Errorf(\"set WAL mode: %w\", err)\n34\t\t}\n35\t\tlogger.Debug(\"store\", \"WAL mode set\")\n36\t\n37\t\t// 执行数据库迁移\n38\t\tif err := runMigrations(db); err != nil {\n39\t\t\tdb.Close()\n40\t\t\treturn nil, fmt.Errorf(\"run migrations: %w\", err)\n41\t\t}\n42\t\tlogger.Debug(\"store\", \"migrations complete\")\n43\t\n44\t\tlogger.Info(\"store\", \"sqlite store ready: %s\", dbPath)\n45\t\treturn &SQLiteStore{\n46\t\t\tdb:           db,\n47\t\t\tissueStore:   &sqliteIssueStore{db: db},\n48\t\t\tsessionStore: &sqliteSessionStore{db: db},\n49\t\t}, nil\n50\t}\n51\t\n52\t// Issues 返回 Issue 存储接口。\n53\tfunc (s *SQLiteStore) Issues() IssueStore { return s.issueStore }\n54\t\n55\t// Sessions 返回 Session 存储接口。\n56\tfunc (s *SQLiteStore) Sessions() SessionStore { return s.sessionStore }\n57\t\n58\t// DB 返回底层的 *sql.DB 连接（主要用于测试）。\n59\tfunc (s *SQLiteStore) DB() *sql.DB { return s.db }\n60\t\n61\t// Close 关闭数据库连接。\n62\tfunc (s *SQLiteStore) Close() error {\n63\t\terr := s.db.Close()\n64\t\tlogger.Info(\"store\", \"sqlite store closed\")\n65\t\treturn err\n66\t}\n67\t"}]}
