 if curl -s --max-time 2 \"$BACKEND_URL/health\" > /dev/null 2>&1; then\n50\t    return 0\n51\t  fi\n52\t  [ -n \"${SKILL_TAG:-}\" ] && skill_log \"ERROR\" \"Backend configured but unreachable at $BACKEND_URL\"\n53\t  return 1\n54\t}\n55\t\n56\t# 调用后端 API，失败时静默返回空\n57\t_call_backend() {\n58\t  local endpoint=\"$1\"\n59\t  local data=\"$2\"\n60\t  _load_backend_url\n61\t  [ -z \"$BACKEND_URL\" ] && return 1\n62\t\n63\t  local resp\n64\t  resp=$(curl -s --max-time 5 -X POST \"$BACKEND_URL$endpoint\" \\\n65\t    -H \"Content-Type: application/json\" \\\n66\t    -d \"$data\" 2>/dev/null)\n67\t  local rc=$?\n68\t  if [ $rc -ne 0 ] || [ -z \"$resp\" ]; then\n69\t    [ -n \"${SKILL_TAG:-}\" ] && skill_log \"DEBUG\" \"Backend call failed: $endpoint (curl rc=$rc)\"\n70\t    return 1\n71\t  fi\n72\t  echo \"$resp\"\n73\t}\n74\t\n75\t# 获取当前 session_id\n76\t_get_session_id() {\n77\t  if [ -n \"${CLAUDE_SESSION_ID:-}\" ]; then\n78\t    echo \"$CLAUDE_SESSION_ID\"\n79\t    return\n80\t  fi\n81\t  if command -v json_get >/dev/null 2>&1; then\n82\t    json_get '.session_id' 2>/dev/null\n83\t  fi\n84\t}\n85\t\n86\t# 通用状态更新函数（D2-D6 使用）— 静默降级\n87\tupdate_issue_status() {\n88\t  local issue_num=\"$1\"\n89\t  local new_status=\"$2\"\n90\t\n91\t  _load_backend_url\n92\t  [ -z \"$BACKEND_URL\" ] && return 0\n93\t\n94\t  local session_id\n95\t  session_id=$(_get_session_id)\n96\t  [ -z \"$session_id\" ] && return 0\n97\t\n98\t  local repo\n99\t  repo=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null)\n100\t  [ -z \"$repo\" ] && return 0\n101\t\n102\t  # 1. 调后端更新状态\n103\t  local result\n104\t  result=$(_call_backend \"/api/issue/status\" \"{\n105\t    \\\"repo_full_name\\\":\\\"$repo\\\",\n106\t    \\\"issue_number\\\":$issue_num,\n107\t    \\\"session_id\\\":\\\"$session_id\\\",\n108\t    \\\"status\\\":\\\"$new_status\\\"\n109\t  }\")\n110\t\n111\t  # 2. 从响应中获取 previous_status，同步 GitHub label\n112\t  local old_status\n113\t  old_status=$(echo \"$result\" | jq -r '.previous_status // empty' 2>/dev/null)\n114\t  [ -n \"$old_status\" ] && _sync_github_label \"$issue_num\" \"$old_status\" \"$new_status\"\n115\t}\n116\t\n117\t# 状态→GitHub Label 映射\n118\t_status_to_label() {\n119\t  case \"$1\" in\n120\t    claimed)       echo \"in-progress\" ;;\n121\t    fixing)        echo \"fixing\" ;;\n122\t    ready-for-pr)  echo \"ready-for-pr\" ;;\n123\t    pr-created)    echo \"pr-created\" ;;\n124\t    testing)       echo \"testing\" ;;\n125\t    reviewing)     echo \"reviewing\" ;;\n126\t    rejected)      echo \"rejected\" ;;\n127\t    merged|idle)   echo \"\" ;;\n128\t    *)             echo \"\" ;;\n129\t  esac\n130\t}\n131\t\n132\t# 同步 GitHub label（后端状态变更后调用）\n133\t_sync_github_label() {\n134\t  local issue_num=\"$1\"\n135\t  local old_status=\"$2\"\n136\t  local new_status=\"$3\"\n137\t\n138\t  local old_label\n139\t  old_label=$(_status_to_label \"$old_status\")\n140\t  local new_label\n141\t  new_label=$(_status_to_label \"$new_status\")\n142\t\n143\t  # 移除旧 label\n144\t  [ -n \"$old_label\" ] && [ \"$old_label\" != \"$new_label\" ] && \\\n145\t    gh issue edit \"$issue_num\" --remove-label \"$old_label\" 2>/dev/null\n146\t\n147\t  # 添加新 label\n148\t  [ -n \"$new_label\" ] && \\\n149\t    gh issue edit \"$issue_num\" --add-label \"$new_label\" 2>/dev/null\n150\t\n151\t  # merged 特殊处理：关闭 issue\n152\t  [ \"$new_status\" = \"merged\" ] && gh issue close \"$issue_num\" 2>/dev/null\n153\t}\n154\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\backend.conf"},"tool_use_id":"call_0e511453aca84c3d88f7583b","tool_response":"1\tBACKEND_URL=http://127.0.0.1:8080\n2\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\health_handler.go"},"tool_use_id":"call_f3d02f1b2d554ccea9a0db8f","tool_response":"1\tpackage api\n2\t\n3\timport (\n4\t\t\"net/http\"\n5\t)\n6\t\n7\tfunc Health(w http.ResponseWriter, r *http.Request) {\n8\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n9\t}\n10\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\server.go"},"tool_use_id":"call_3f3c7d47718c4312886f79cf","tool_response":"1\tpackage backend\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"log\"\n7\t\t\"net/http\"\n8\t\t\"os\"\n9\t\t\"os/signal\"\n10\t\t\"syscall\"\n11\t\n12\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n15\t)\n16\t\n17\ttype Server struct {\n18\t\tcfg   Config\n19\t\tstore *store.SQLiteStore\n20\t}\n21\t\n22\tfunc NewServer(cfg Config) (*Server, error) {\n23\t\ts, err := store.NewSQLiteStore(cfg.DBPath)\n24\t\tif err != nil {\n25\t\t\treturn nil, fmt.Errorf(\"open database: %w\", err)\n26\t\t}\n27\t\treturn &Server{cfg: cfg, store: s}, nil\n28\t}\n29\t\n30\tfunc (s *Server) Start() error {\n31\t\t// Startup cleanup: mark stale sessions as closed.\n32\t\tcleanupSvc := service.NewCleanupService(s.store.Sessions())\n33\t\tcleanupSvc.CleanupTimedOutSessions(context.Background())\n34\t\n35\t\tissueSvc := service.NewIssueService(s.store.Issues())\n36\t\tsessionSvc := service.NewSessionService(s.store.Sessions())\n37\t\n38\t\trouter := api.NewRouter(api.Handlers{\n39\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n40\t\t\tSession: api.NewSessionHandler(sessionSvc),\n41\t\t})\n42\t\n43\t\tsrv := &http.Server{\n44\t\t\tAddr:    s.cfg.Addr(),\n45\t\t\tHandler: router,\n46\t\t}\n47\t\n48\t\tquit := make(chan os.Signal, 1)\n49\t\tsignal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)\n50\t\n51\t\tgo func() {\n52\t\t\t<-quit\n53\t\t\tlog.Println(\"shutting down backend server...\")\n54\t\t\tsrv.Shutdown(context.Background())\n55\t\t}()\n56\t\n57\t\tlog.Printf(\"backend server listening on %s\", s.cfg.Addr())\n58\t\tif err := srv.ListenAndServe(); err != http.ErrServerClosed {\n59\t\t\treturn err\n60\t\t}\n61\t\treturn nil\n62\t}\n63\t\n64\tfunc (s *Server) Close() error {\n65\t\treturn s.store.Close()\n66\t}\n67\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\main.go"},"tool_use_id":"call_f07c7f4b8e2c435d88329f2b","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"log\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"os/signal\"\n9\t\t\"strings\"\n10\t\t\"syscall\"\n11\t\n12\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/config\"\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/proxy\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/session\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n16\t)\n17\t\n18\tfunc main() {\n19\t\tlog.SetFlags(log.Ltime | log.Lmicroseconds)\n20\t\n21\t\t// Detect subcommand.\n22\t\tif len(os.Args) > 1 {\n23\t\t\tswitch os.Args[1] {\n24\t\t\tcase \"session-push\":\n25\t\t\t\trunSessionPush(os.Args[2:])\n26\t\t\t\treturn\n27\t\t\tcase \"session-pull\":\n28\t\t\t\trunSessionPull(os.Args[2:])\n29\t\t\t\treturn\n30\t\t\tcase \"session-status\":\n31\t\t\t\trunSessionStatus(os.Args[2:])\n32\t\t\t\treturn\n33\t\t\tcase \"backend\":\n34\t\t\t\trunBackend(os.Args[2:])\n35\t\t\t\treturn\n36\t\t\tcase \"help\", \"--help\", \"-h\":\n37\t\t\t\tprintUsage()\n38\t\t\t\treturn\n39\t\t\t}\n40\t\t}\n41\t\n42\t\t// Default: proxy mode.\n43\t\trunProxy(os.Args[1:])\n44\t}\n45\t\n46\tfunc printUsage() {\n47\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n48\t\tfmt.Println()\n49\t\tfmt.Println(\"Usage:\")\n50\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n51\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n52\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n53\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n54\t\tfmt.Println()\n55\t\tfmt.Println(\"Proxy flags:\")\n56\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n57\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n58\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n59\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n60\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n61\t\tfmt.Println()\n62\t\tfmt.Println(\"Session-push flags:\")\n63\t\tfmt.Println(\"  --all                  Collect all projects\")\n64\t\tfmt.Println(\"  --force                Overwrite existing files\")\n65\t\tfmt.Println(\"  --dry-run              Preview only\")\n66\t\tfmt.Println(\"  --project NAME         Override project name\")\n67\t\tfmt.Println()\n68\t\tfmt.Println(\"Session-pull flags:\")\n69\t\tfmt.Println(\"  --all                  Restore all projects\")\n70\t\tfmt.Println(\"  --project NAME         Override project name\")\n71\t\tfmt.Println(\"  --dry-run              Preview only\")\n72\t\tfmt.Println()\n73\t\tfmt.Println(\"Session-status flags:\")\n74\t\tfmt.Println(\"  --verbose              Show file-level details\")\n75\t}\n76\t\n77\t// runProxy is the default proxy mode — intercepts Claude Code API traffic.\n78\tfunc runProxy(args []string) {\n79\t\t// Parse --tap-* flags, collect remaining args for claude.\n80\t\tvar (\n81\t\t\ttapTarget    string\n82\t\t\ttapPort      int\n83\t\t\ttapOutputDir string\n84\t\t\ttapVerbose   bool\n85\t\t)\n86\t\n87\t\tvar claudeArgs []string\n88\t\tfor i := 0; i < len(args); i++ {\n89\t\t\targ := args[i]\n90\t\t\tswitch {\n91\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n92\t\t\t\ti++\n93\t\t\t\ttapTarget = args[i]\n94\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n95\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n96\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n97\t\t\t\ti++\n98\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n99\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n100\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n101\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n102\t\t\t\ti++\n103\t\t\t\ttapOutputDir = args[i]\n104\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n105\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n106\t\t\tcase arg == \"--tap-verbose\":\n107\t\t\t\ttapVerbose = true\n108\t\t\tcase arg == \"--\", arg == \"--claude\":\n109\t\t\t\t// Everything after -- (or --claude) goes to claude.\n110\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n111\t\t\t\ti = len(args) // stop parsing\n112\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n113\t\t\t\t// Unknown tap flag, skip.\n114\t\t\tdefault:\n115\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n116\t\t\t}\n117\t\t}\n118\t\n119\t\tif tapOutputDir == \"\" {\n120\t\t\ttapOutputDir = trace.DefaultTraceDir()\n121\t\t}\n122\t\n123\t\t// Detect upstream target.\n124\t\ttarget := tapTarget\n125\t\tif target == \"\" {\n126\t\t\ttarget = config.DetectTarget(&config.ClaudeClient)\n127\t\t}\n128\t\tif tapVerbose {\n129\t\t\tlog.Printf(\"upstream target: %s\", target)\n130\t\t}\n131\t\n132\t\t// Setup trace writer (proxy creates trace file on trace-init or first request).\n133\t\t// Start reverse proxy.\n134\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n135\t\tport := tapPort\n136\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n137\t\tif err != nil {\n138\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n139\t\t}\n140\t\tdefer rp.Stop()\n141\t\n142\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n143\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n144\t\n145\t\t// Resolve claude binary.\n146\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n147\t\tif err != nil {\n148\t\t\tlog.Fatal(err)\n149\t\t}\n150\t\n151\t\t// Build child environment.\n152\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n153\t\n154\t\t// Inject --settings for clients that need it (e.g. Claude Code).\n155\t\tfinalArgs := claudeArgs\n156\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n157\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n158\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n159\t\t}\n160\t\n161\t\t// Launch claude as child process.\n162\t\tcmd := exec.Command(claudePath, finalArgs...)\n163\t\tcmd.Env = childEnv\n164\t\tcmd.Stdin = os.Stdin\n165\t\tcmd.Stdout = os.Stdout\n166\t\tcmd.Stderr = os.Stderr\n167\t\n168\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n169\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n170\t\n171\t\tif err := cmd.Start(); err != nil {\n172\t\t\tlog.Fatalf(\"start claude: %v\", err)\n173\t\t}\n174\t\n175\t\t// Handle signals: forward to child process.\n176\t\tsigChan := make(chan os.Signal, 2)\n177\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n178\t\n179\t\tgo func() {\n180\t\t\tsigCount := 0\n181\t\t\tfor sig := range sigChan {\n182\t\t\t\tsigCount++\n183\t\t\t\tif sigCount == 1 {\n184\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n185\t\t\t\t\t_ = cmd.Process.Signal(sig)\n186\t\t\t\t} else {\n187\t\t\t\t\t_ = cmd.Process.Kill()\n188\t\t\t\t}\n189\t\t\t}\n190\t\t}()\n191\t\n192\t\t// Wait for child to exit.\n193\t\twaitErr := cmd.Wait()\n194\t\n195\t\t// Stop signal handler.\n196\t\tsignal.Stop(sigChan)\n197\t\tclose(sigChan)\n198\t\n199\t\t// Print summary.\n200\t\tsummary := rp.Summary()\n201\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n202\t\tif waitErr != nil {\n203\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n204\t\t}\n205\t\tfmt.Printf(\"\\n\")\n206\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n207\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n208\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n209\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n210\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n211\t\tfmt.Printf(\"   Trace: %s\\n\", tapOutputDir)\n212\t}\n213\t\n214\tfunc runSessionPush(args []string) {\n215\t\tvar opts session.PushOptions\n216\t\tfor i := 0; i < len(args); i++ {\n217\t\t\targ := args[i]\n218\t\t\tswitch {\n219\t\t\tcase arg == \"--all\":\n220\t\t\t\topts.All = true\n221\t\t\tcase arg == \"--force\":\n222\t\t\t\topts.Force = true\n223\t\t\tcase arg == \"--dry-run\":\n224\t\t\t\topts.DryRun = true\n225\t\t\tcase arg == \"--project\" && i+1 < len(args):\n226\t\t\t\ti++\n227\t\t\t\topts.Project = args[i]\n228\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n229\t\t\t\topts.Project = arg[len(\"--project=\"):]\n230\t\t\t}\n231\t\t}\n232\t\n233\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n234\t\tresults, err := session.SessionPush(opts)\n235\t\tif err != nil {\n236\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n237\t\t\tos.Exit(1)\n238\t\t}\n239\t\n240\t\tfmt.Println()\n241\t\ttotalNew, totalSkipped := 0, 0\n242\t\tfor _, r := range results {\n243\t\t\ttotalNew += r.SessionsNew\n244\t\t\ttotalSkipped += r.SessionsSkipped\n245\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n246\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n247\t\t\t}\n248\t\t}\n249\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n250\t}\n251\t\n252\tfunc runSessionPull(args []string) {\n253\t\tvar opts session.PullOptions\n254\t\tfor i := 0; i < len(args); i++ {\n255\t\t\targ := args[i]\n256\t\t\tswitch {\n257\t\t\tcase arg == \"--all\":\n258\t\t\t\topts.All = true\n259\t\t\tcase arg == \"--dry-run\":\n260\t\t\t\topts.DryRun = true\n261\t\t\tcase arg == \"--project\" && i+1 < len(args):\n262\t\t\t\ti++\n263\t\t\t\topts.Project = args[i]\n264\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n265\t\t\t\topts.Project = arg[len(\"--project=\"):]\n266\t\t\t}\n267\t\t}\n268\t\n269\t\tfmt.Println(\"📤 Restoring sessions...\")\n270\t\tresults, err := session.SessionPull(opts)\n271\t\tif err != nil {\n272\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n273\t\t\tos.Exit(1)\n274\t\t}\n275\t\n276\t\tfmt.Println()\n277\t\ttotalRestored, totalSkipped := 0, 0\n278\t\tfor _, r := range results {\n279\t\t\ttotalRestored += r.SessionsRestored\n280\t\t\ttotalSkipped += r.SessionsSkipped\n281\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n282\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n283\t\t\t}\n284\t\t}\n285\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n286\t}\n287\t\n288\tfunc runSessionStatus(args []string) {\n289\t\tvar opts session.StatusOptions\n290\t\tfor i := 0; i < len(args); i++ {\n291\t\t\targ := args[i]\n292\t\t\tswitch {\n293\t\t\tcase arg == \"--verbose\":\n294\t\t\t\topts.Verbose = true\n295\t\t\t}\n296\t\t}\n297\t\n298\t\tif err := session.SessionStatus(opts); err != nil {\n299\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n300\t\t\tos.Exit(1)\n301\t\t}\n302\t}\n303\t\n304\tfunc formatArgs(args []string) string {\n305\t\tresult := \"\"\n306\t\tfor _, a := range args {\n307\t\t\tif containsSpace(a) {\n308\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n309\t\t\t} else {\n310\t\t\t\tresult += \" \" + a\n311\t\t\t}\n312\t\t}\n313\t\treturn strings.TrimSpace(result)\n314\t}\n315\t\n316\tfunc containsSpace(s string) bool {\n317\t\tfor _, c := range s {\n318\t\t\tif c == ' ' || c == '\\t' {\n319\t\t\t\treturn true\n320\t\t\t}\n321\t\t}\n322\t\treturn false\n323\t}\n324\t"}]}
