le-level details\")\n87\t}\n88\t\n89\t// runProxy 是默认的代理模式主逻辑。\n90\t//\n91\t// 工作流程：\n92\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n93\t//  2. 自动探测上游 API 目标地址\n94\t//  3. 启动本地反向代理监听指定端口\n95\t//  4. 解析 Claude Code 可执行文件路径\n96\t//  5. 构建子进程环境变量（注入代理地址）\n97\t//  6. 启动 Claude Code 作为子进程\n98\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n99\t//  8. 子进程退出后打印 API 调用统计摘要\n100\tfunc runProxy(args []string) {\n101\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n102\t\tvar (\n103\t\t\ttapTarget    string // 上游 API 目标地址\n104\t\t\ttapPort      int    // 本地代理监听端口\n105\t\t\ttapOutputDir string // 追踪记录输出目录\n106\t\t\ttapVerbose   bool   // 是否启用详细日志\n107\t\t)\n108\t\n109\t\tvar claudeArgs []string\n110\t\tfor i := 0; i < len(args); i++ {\n111\t\t\targ := args[i]\n112\t\t\tswitch {\n113\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n114\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n115\t\t\t\ti++\n116\t\t\t\ttapTarget = args[i]\n117\t\t\t// 解析 --tap-target=URL 形式\n118\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n119\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n120\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n121\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n122\t\t\t\ti++\n123\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n124\t\t\t// 解析 --tap-port=PORT 形式\n125\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n126\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n127\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n128\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n129\t\t\t\ti++\n130\t\t\t\ttapOutputDir = args[i]\n131\t\t\t// 解析 --tap-output-dir=DIR 形式\n132\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n133\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n134\t\t\t// 启用详细日志\n135\t\t\tcase arg == \"--tap-verbose\":\n136\t\t\t\ttapVerbose = true\n137\t\t\t// -- 或 --claude 后的所有参数都传递给 Claude Code\n138\t\t\tcase arg == \"--\", arg == \"--claude\":\n139\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n140\t\t\t\ti = len(args) // 停止解析\n141\t\t\t// 未知的 --tap-* 标志，直接忽略\n142\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n143\t\t\t// 其他参数视为 Claude Code 的参数\n144\t\t\tdefault:\n145\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n146\t\t\t}\n147\t\t}\n148\t\n149\t\t// 如果未指定输出目录，使用默认追踪目录\n150\t\tif tapOutputDir == \"\" {\n151\t\t\ttapOutputDir = trace.DefaultTraceDir()\n152\t\t}\n153\t\n154\t\t// 探测上游目标地址：如果用户未指定，则自动探测\n155\t\ttarget := tapTarget\n156\t\tif target == \"\" {\n157\t\t\ttarget = config.DetectTarget(&config.ClaudeClient)\n158\t\t}\n159\t\tif tapVerbose {\n160\t\t\tlog.Printf(\"upstream target: %s\", target)\n161\t\t}\n162\t\n163\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n164\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n165\t\tport := tapPort\n166\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n167\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n168\t\tif err != nil {\n169\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n170\t\t}\n171\t\t// 函数退出时停止代理\n172\t\tdefer rp.Stop()\n173\t\n174\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n175\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n176\t\n177\t\t// 解析 Claude Code 可执行文件路径\n178\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n179\t\tif err != nil {\n180\t\t\tlog.Fatal(err)\n181\t\t}\n182\t\n183\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n184\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n185\t\n186\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n187\t\tfinalArgs := claudeArgs\n188\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n189\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n190\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n191\t\t}\n192\t\n193\t\t// 启动 Claude Code 作为子进程\n194\t\tcmd := exec.Command(claudePath, finalArgs...)\n195\t\tcmd.Env = childEnv\n196\t\tcmd.Stdin = os.Stdin\n197\t\tcmd.Stdout = os.Stdout\n198\t\tcmd.Stderr = os.Stderr\n199\t\n200\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n201\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n202\t\n203\t\tif err := cmd.Start(); err != nil {\n204\t\t\tlog.Fatalf(\"start claude: %v\", err)\n205\t\t}\n206\t\n207\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n208\t\tsigChan := make(chan os.Signal, 2)\n209\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n210\t\n211\t\tgo func() {\n212\t\t\tsigCount := 0\n213\t\t\tfor sig := range sigChan {\n214\t\t\t\tsigCount++\n215\t\t\t\tif sigCount == 1 {\n216\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n217\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n218\t\t\t\t\t_ = cmd.Process.Signal(sig)\n219\t\t\t\t} else {\n220\t\t\t\t\t// 再次收到信号：强制终止子进程\n221\t\t\t\t\t_ = cmd.Process.Kill()\n222\t\t\t\t}\n223\t\t\t}\n224\t\t}()\n225\t\n226\t\t// 等待子进程结束\n227\t\twaitErr := cmd.Wait()\n228\t\n229\t\t// 停止信号处理器，释放资源\n230\t\tsignal.Stop(sigChan)\n231\t\tclose(sigChan)\n232\t\n233\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n234\t\tsummary := rp.Summary()\n235\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n236\t\tif waitErr != nil {\n237\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n238\t\t}\n239\t\tfmt.Printf(\"\\n\")\n240\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n241\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n242\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n243\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n244\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n245\t\tfmt.Printf(\"   Trace: %s\\n\", tapOutputDir)\n246\t}\n247\t\n248\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n249\t//\n250\t// 支持的参数：\n251\t//   --all       收集所有项目的会话\n252\t//   --force     覆盖已存在的会话文件\n253\t//   --dry-run   仅预览，不实际执行\n254\t//   --project   指定项目名称，覆盖自动检测\n255\tfunc runSessionPush(args []string) {\n256\t\tvar opts session.PushOptions\n257\t\tfor i := 0; i < len(args); i++ {\n258\t\t\targ := args[i]\n259\t\t\tswitch {\n260\t\t\tcase arg == \"--all\":\n261\t\t\t\topts.All = true\n262\t\t\tcase arg == \"--force\":\n263\t\t\t\topts.Force = true\n264\t\t\tcase arg == \"--dry-run\":\n265\t\t\t\topts.DryRun = true\n266\t\t\tcase arg == \"--project\" && i+1 < len(args):\n267\t\t\t\ti++\n268\t\t\t\topts.Project = args[i]\n269\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n270\t\t\t\topts.Project = arg[len(\"--project=\"):]\n271\t\t\t}\n272\t\t}\n273\t\n274\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n275\t\tresults, err := session.SessionPush(opts)\n276\t\tif err != nil {\n277\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n278\t\t\tos.Exit(1)\n279\t\t}\n280\t\n281\t\t// 汇总各项目的收集结果\n282\t\tfmt.Println()\n283\t\ttotalNew, totalSkipped := 0, 0\n284\t\tfor _, r := range results {\n285\t\t\ttotalNew += r.SessionsNew\n286\t\t\ttotalSkipped += r.SessionsSkipped\n287\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n288\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n289\t\t\t}\n290\t\t}\n291\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n292\t}\n293\t\n294\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n295\t//\n296\t// 支持的参数：\n297\t//   --all       恢复所有项目的会话\n298\t//   --dry-run   仅预览，不实际执行\n299\t//   --project   指定项目名称，覆盖自动检测\n300\tfunc runSessionPull(args []string) {\n301\t\tvar opts session.PullOptions\n302\t\tfor i := 0; i < len(args); i++ {\n303\t\t\targ := args[i]\n304\t\t\tswitch {\n305\t\t\tcase arg == \"--all\":\n306\t\t\t\topts.All = true\n307\t\t\tcase arg == \"--dry-run\":\n308\t\t\t\topts.DryRun = true\n309\t\t\tcase arg == \"--project\" && i+1 < len(args):\n310\t\t\t\ti++\n311\t\t\t\topts.Project = args[i]\n312\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n313\t\t\t\topts.Project = arg[len(\"--project=\"):]\n314\t\t\t}\n315\t\t}\n316\t\n317\t\tfmt.Println(\"📤 Restoring sessions...\")\n318\t\tresults, err := session.SessionPull(opts)\n319\t\tif err != nil {\n320\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n321\t\t\tos.Exit(1)\n322\t\t}\n323\t\n324\t\t// 汇总各项目的恢复结果\n325\t\tfmt.Println()\n326\t\ttotalRestored, totalSkipped := 0, 0\n327\t\tfor _, r := range results {\n328\t\t\ttotalRestored += r.SessionsRestored\n329\t\t\ttotalSkipped += r.SessionsSkipped\n330\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n331\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n332\t\t\t}\n333\t\t}\n334\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n335\t}\n336\t\n337\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n338\t//\n339\t// 支持的参数：\n340\t//   --verbose   显示文件级别的详细信息\n341\tfunc runSessionStatus(args []string) {\n342\t\tvar opts session.StatusOptions\n343\t\tfor i := 0; i < len(args); i++ {\n344\t\t\targ := args[i]\n345\t\t\tswitch {\n346\t\t\tcase arg == \"--verbose\":\n347\t\t\t\topts.Verbose = true\n348\t\t\t}\n349\t\t}\n350\t\n351\t\tif err := session.SessionStatus(opts); err != nil {\n352\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n353\t\t\tos.Exit(1)\n354\t\t}\n355\t}\n356\t\n357\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n358\t// 如果参数中包含空格或制表符，则使用引号包裹。\n359\tfunc formatArgs(args []string) string {\n360\t\tresult := \"\"\n361\t\tfor _, a := range args {\n362\t\t\tif containsSpace(a) {\n363\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n364\t\t\t} else {\n365\t\t\t\tresult += \" \" + a\n366\t\t\t}\n367\t\t}\n368\t\treturn strings.TrimSpace(result)\n369\t}\n370\t\n371\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n372\tfunc containsSpace(s string) bool {\n373\t\tfor _, c := range s {\n374\t\t\tif c == ' ' || c == '\\t' {\n375\t\t\t\treturn true\n376\t\t\t}\n377\t\t}\n378\t\treturn false\n379\t}\n380\t"}]}
