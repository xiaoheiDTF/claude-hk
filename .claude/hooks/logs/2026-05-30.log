L=$((TOTAL + 1))\n47\t  echo \"\"\n48\t  echo \"--- [$name] ---\"\n49\t  if \"$@\"; then\n50\t    PASS=$((PASS + 1))\n51\t    echo -e \"${GREEN}PASS${NC}: $name\"\n52\t  else\n53\t    FAIL=$((FAIL + 1))\n54\t    echo -e \"${RED}FAIL${NC}: $name\"\n55\t  fi\n56\t}\n57\t\n58\t# --- Test 1: backend.sh 可被正确 source ---\n59\t\n60\ttest_source_backend_sh() {\n61\t  BACKEND_URL=\"\"\n62\t  # source 在当前 shell 中执行（不能用 $() 子 shell）\n63\t  source \"$BACKEND_SH\" 2>&1\n64\t  if [ $? -ne 0 ]; then\n65\t    echo \"FAIL: source returned non-zero\"\n66\t    return 1\n67\t  fi\n68\t\n69\t  # 验证关键函数已定义\n70\t  for fn in _load_backend_url _backend_available _call_backend _get_session_id update_issue_status _status_to_label _sync_github_label; do\n71\t    if ! type \"$fn\" &>/dev/null; then\n72\t      echo \"FAIL: function $fn not defined after source\"\n73\t      return 1\n74\t    fi\n75\t  done\n76\t\n77\t  echo \"OK: source succeeded, all functions defined\"\n78\t  return 0\n79\t}\n80\t\n81\t# --- Test 2: 未配置 backend.conf 时静默跳过 ---\n82\t\n83\ttest_no_config_silent_skip() {\n84\t  rm -f \"$BACKEND_CONF\"\n85\t  BACKEND_URL=\"\"\n86\t  source \"$BACKEND_SH\"\n87\t\n88\t  # _load_backend_url 应失败\n89\t  if _load_backend_url; then\n90\t    echo \"FAIL: _load_backend_url should fail without conf\"\n91\t    return 1\n92\t  fi\n93\t\n94\t  # _backend_available 应返回失败\n95\t  if _backend_available; then\n96\t    echo \"FAIL: _backend_available should be false without conf\"\n97\t    return 1\n98\t  fi\n99\t\n100\t  # _call_backend 应返回失败（无输出）"}]}
