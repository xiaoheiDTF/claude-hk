[2026-05-30 19:27:42] [INFO] [PostToolBatch] Input: {"session_id":"9bf82fe9-e376-4adb-95bb-300f36566835","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\9bf82fe9-e376-4adb-95bb-300f36566835.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"plan","agent_id":"a10aec38eea64be08","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\session_store.go"},"tool_use_id":"call_07ce04d56cc44255a8930a26","tool_response":"1\t// Package store 提供数据持久化层，基于 SQLite 实现。\n2\tpackage store\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"database/sql\"\n7\t\t\"fmt\"\n8\t\t\"strings\"\n9\t\t\"time\"\n10\t\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n12\t)\n13\t\n14\t// sqliteSessionStore 是 Session 存储的 SQLite 实现。\n15\ttype sqliteSessionStore struct {\n16\t\tdb *sql.DB // SQLite 数据库连接\n17\t}\n18\t\n19\t// RegisterSession 注册一个新会话。\n20\t// 使用事务同时更新 machines 表（upsert）、projects 表（upsert）和 sessions 表（insert）。\n21\tfunc (s *sqliteSessionStore) RegisterSession(ctx context.Context, sess Session) error {\n22\t\tlogger.Debug(\"store.session\", \"register: id=%s machine=%s slug=%s\", sess.SessionID, sess.MachineID, sess.ProjectSlug)\n23\t\n24\t\t// 开启事务\n25\t\ttx, err := s.db.BeginTx(ctx, nil)\n26\t\tif err != nil {\n27\t\t\treturn fmt.Errorf(\"begin tx: %w\", err)\n28\t\t}\n29\t\tdefer tx.Rollback()\n30\t\n31\t\t// 解析 machine_id 为 username 和 hostname\n32\t\tusername, hostname := parseMachineID(sess.MachineID)\n33\t\n34\t\t// Upsert machine：不存在则插入，存在则更新 last_seen_at\n35\t\t_, err = tx.ExecContext(ctx,\n36\t\t\t`INSERT INTO machines (machine_id, os, hostname, username, first_seen_at, last_seen_at)\n37\t\t\t VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)\n38\t\t\t ON CONFLICT(machine_id) DO UPDATE SET last_seen_at = CURRENT_TIMESTAMP`,\n39\t\t\tsess.MachineID, sess.OS, hostname, username)\n40\t\tif err != nil {\n41\t\t\treturn fmt.Errorf(\"upsert machine: %w\", err)\n42\t\t}\n43\t\n44\t\t// Upsert project：不存在则插入，存在则更新 last_seen_at\n45\t\t_, err = tx.ExecContext(ctx,\n46\t\t\t`INSERT INTO projects (project_slug, project_cwd, first_seen_at, last_seen_at)\n47\t\t\t VALUES (?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)\n48\t\t\t ON CONFLICT(project_slug) DO UPDATE SET last_seen_at = CURRENT_TIMESTAMP`,\n49\t\t\tsess.ProjectSlug, sess.ProjectCwd)\n50\t\tif err != nil {\n51\t\t\treturn fmt.Errorf(\"upsert project: %w\", err)\n52\t\t}\n53\t\n54\t\t// 插入 session 记录\n55\t\t_, err = tx.ExecContext(ctx,\n56\t\t\t`INSERT INTO sessions (session_id, machine_id, os, project_slug, project_cwd,\n57\t\t\t    transcript_path, local_trace_path, model, source, status, registered_at)\n58\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'active', CURRENT_TIMESTAMP)`,\n59\t\t\tsess.SessionID, sess.MachineID, sess.OS, sess.ProjectSlug, sess.ProjectCwd,\n60\t\t\tnilIfEmpty(sess.TranscriptPath), nilIfEmpty(sess.LocalTracePath),\n61\t\t\tnilIfEmpty(sess.Model), nilIfEmpty(sess.Source))\n62\t\tif err != nil {\n63\t\t\tif strings.Contains(err.Error(), \"UNIQUE constraint failed\") {\n64\t\t\t\treturn ErrSessionExists\n65\t\t\t}\n66\t\t\treturn fmt.Errorf(\"insert session: %w\", err)\n67\t\t}\n68\t\n69\t\tlogger.Info(\"store.session\", \"session registered: %s slug=%s\", sess.SessionID, sess.ProjectSlug)\n70\t\treturn tx.Commit()\n71\t}\n72\t\n73\t// CloseSession 关闭指定会话。\n74\t// 仅对状态为 active 的会话生效，将其标记为 closed 并记录关闭时间和原因。\n75\tfunc (s *sqliteSessionStore) CloseSession(ctx context.Context, sessionID string, reason string) error {\n76\t\tlogger.Debug(\"store.session\", \"close: id=%s reason=%s\", sessionID, reason)\n77\t\n78\t\tres, err := s.db.ExecContext(ctx,\n79\t\t\t`UPDATE sessions\n80\t\t\t    SET status = 'closed', closed_at = CURRENT_TIMESTAMP, close_reason = ?\n81\t\t\t  WHERE session_id = ? AND status = 'active'`,\n82\t\t\treason, sessionID)\n83\t\tif err != nil {\n84\t\t\treturn fmt.Errorf(\"close session: %w\", err)\n85\t\t}\n86\t\tn, _ := res.RowsAffected()\n87\t\tif n == 0 {\n88\t\t\treturn ErrSessionNotFound\n89\t\t}\n90\t\tlogger.Info(\"store.session\", \"session closed: %s reason=%s\", sessionID, reason)\n91\t\treturn nil\n92\t}\n93\t\n94\t// ListSessions 获取会话列表，支持按 machine_id、project_slug、status 过滤。\n95\t// 结果按注册时间倒序排列。\n96\tfunc (s *sqliteSessionStore) ListSessions(ctx context.Context, filter SessionFilter) ([]Session, error) {\n97\t\tlogger.Debug(\"store.session\", \"list: filter applied\")\n98\t\n99\t\tquery := `SELECT session_id, machine_id, os, project_slug, project_cwd,\n100\t\t                 transcript_path, local_trace_path, model, source,\n101\t\t                 status, registered_at, closed_at, close_reason\n102\t\t            FROM sessions WHERE 1=1`\n103\t\targs := []any{}\n104\t\n105\t\t// 动态构建过滤条件\n106\t\tif filter.MachineID != nil {\n107\t\t\tquery += \" AND machine_id = ?\"\n108\t\t\targs = append(args, *filter.MachineID)\n109\t\t}\n110\t\tif filter.ProjectSlug != nil {\n111\t\t\tquery += \" AND project_slug = ?\"\n112\t\t\targs = append(args, *filter.ProjectSlug)\n113\t\t}\n114\t\tif filter.Status != nil {\n115\t\t\tquery += \" AND status = ?\"\n116\t\t\targs = append(args, *filter.Status)\n117\t\t}\n118\t\tquery += \" ORDER BY registered_at DESC\"\n119\t\n120\t\trows, err := s.db.QueryContext(ctx, query, args...)\n121\t\tif err != nil {\n122\t\t\treturn nil, fmt.Errorf(\"list sessions: %w\", err)\n123\t\t}\n124\t\tdefer rows.Close()\n125\t\n126\t\tvar sessions []Session\n127\t\tfor rows.Next() {\n128\t\t\tvar sess Session\n129\t\t\tvar localTracePath, model, source, closedAt, closeReason sql.NullString\n130\t\t\tif err := rows.Scan(\n131\t\t\t\t&sess.SessionID, &sess.MachineID, &sess.OS, &sess.ProjectSlug, &sess.ProjectCwd,\n132\t\t\t\t&sess.TranscriptPath, &localTracePath, &model, &source,\n133\t\t\t\t&sess.Status, &sess.RegisteredAt, &closedAt, &closeReason,\n134\t\t\t); err != nil {\n135\t\t\t\treturn nil, fmt.Errorf(\"scan session: %w\", err)\n136\t\t\t}\n137\t\t\t// 处理 NULL 值\n138\t\t\tif localTracePath.Valid {\n139\t\t\t\tsess.LocalTracePath = localTracePath.String\n140\t\t\t}\n141\t\t\tif model.Valid {\n142\t\t\t\tsess.Model = model.String\n143\t\t\t}\n144\t\t\tif source.Valid {\n145\t\t\t\tsess.Source = source.String\n146\t\t\t}\n147\t\t\tif closedAt.Valid {\n148\t\t\t\tt, _ := time.Parse(\"2006-01-02 15:04:05\", closedAt.String)\n149\t\t\t\tsess.ClosedAt = &t\n150\t\t\t}\n151\t\t\tif closeReason.Valid {\n152\t\t\t\tsess.CloseReason = closeReason.String\n153\t\t\t}\n154\t\t\tsessions = append(sessions, sess)\n155\t\t}\n156\t\treturn sessions, rows.Err()\n157\t}\n158\t\n159\t// GetSession 获取单个会话的详细信息。\n160\t// 如果会话不存在，返回 nil。\n161\tfunc (s *sqliteSessionStore) GetSession(ctx context.Context, sessionID string) (*Session, error) {\n162\t\tlogger.Debug(\"store.session\", \"get: id=%s\", sessionID)\n163\t\n164\t\tvar sess Session\n165\t\tvar localTracePath, model, source, closedAt, closeReason sql.NullString\n166\t\terr := s.db.QueryRowContext(ctx,\n167\t\t\t`SELECT session_id, machine_id, os, project_slug, project_cwd,\n168\t\t\t        transcript_path, local_trace_path, model, source,\n169\t\t\t        status, registered_at, closed_at, close_reason\n170\t\t\t   FROM sessions WHERE session_id = ?`,\n171\t\t\tsessionID,\n172\t\t).Scan(\n173\t\t\t&sess.SessionID, &sess.MachineID, &sess.OS, &sess.ProjectSlug, &sess.ProjectCwd,\n174\t\t\t&sess.TranscriptPath, &localTracePath, &model, &source,\n175\t\t\t&sess.Status, &sess.RegisteredAt, &closedAt, &closeReason,\n176\t\t)\n177\t\tif err == sql.ErrNoRows {\n178\t\t\treturn nil, nil\n179\t\t}\n180\t\tif err != nil {\n181\t\t\treturn nil, fmt.Errorf(\"get session: %w\", err)\n182\t\t}\n183\t\n184\t\t// 处理 NULL 值\n185\t\tif localTracePath.Valid {\n186\t\t\tsess.LocalTracePath = localTracePath.String\n187\t\t}\n188\t\tif model.Valid {\n189\t\t\tsess.Model = model.String\n190\t\t}\n191\t\tif source.Valid {\n192\t\t\tsess.Source = source.String\n193\t\t}\n194\t\tif closedAt.Valid {\n195\t\t\tt, _ := time.Parse(\"2006-01-02 15:04:05\", closedAt.String)\n196\t\t\tsess.ClosedAt = &t\n197\t\t}\n198\t\tif closeReason.Valid {\n199\t\t\tsess.CloseReason = closeReason.String\n200\t\t}\n201\t\treturn &sess, nil\n202\t}\n203\t\n204\t// CleanupTimedOut 清理注册超过 24 小时仍处于 active 状态的会话。\n205\t// 返回被清理的会话数量。\n206\tfunc (s *sqliteSessionStore) CleanupTimedOut(ctx context.Context) (int, error) {\n207\t\tres, err := s.db.ExecContext(ctx,\n208\t\t\t`UPDATE sessions\n209\t\t\t    SET status = 'closed', closed_at = CURRENT_TIMESTAMP, close_reason = 'timeout_cleanup'\n210\t\t\t  WHERE status = 'active'\n211\t\t\t    AND registered_at < datetime('now', '-24 hours')`)\n212\t\tif err != nil {\n213\t\t\treturn 0, fmt.Errorf(\"cleanup timed out: %w\", err)\n214\t\t}\n215\t\tn, _ := res.RowsAffected()\n216\t\treturn int(n), nil\n217\t}\n218\t\n219\t// parseMachineID 将 machine_id（格式为 username@hostname）分割为 username 和 hostname。\n220\t// 如果不含 @，则整个字符串作为 username，hostname 为空。\n221\tfunc parseMachineID(machineID string) (username, hostname string) {\n222\t\tparts := strings.SplitN(machineID, \"@\", 2)\n223\t\tif len(parts) == 2 {\n224\t\t\treturn parts[0], parts[1]\n225\t\t}\n226\t\treturn machineID, \"\"\n227\t}\n228\t\n229\t// nilIfEmpty 如果字符串为空则返回 nil，否则返回原字符串。\n230\t// 用于将空字符串存储为 SQL NULL。\n231\tfunc nilIfEmpty(s string) any {\n232\t\tif s == \"\" {\n233\t\t\treturn nil\n234\t\t}\n235\t\treturn s\n236\t}\n237\t"}]}
