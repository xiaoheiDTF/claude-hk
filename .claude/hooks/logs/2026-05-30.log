input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\issue_store.go"},"tool_use_id":"call_1b9858cb283746fc9a4e112d","tool_response":"1\tpackage store\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"database/sql\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t)\n9\t\n10\ttype sqliteIssueStore struct {\n11\t\tdb *sql.DB\n12\t}\n13\t\n14\tfunc (s *sqliteIssueStore) CheckIssues(ctx context.Context, repo string, numbers []int) ([]IssueCheckResult, error) {\n15\t\tif len(numbers) == 0 {\n16\t\t\treturn nil, nil\n17\t\t}\n18\t\n19\t\t// Auto-create idle records for any issue_number not yet in the table.\n20\t\tinsertStmt, err := s.db.PrepareContext(ctx,\n21\t\t\t`INSERT OR IGNORE INTO issue_claims (repo_full_name, issue_number, status, updated_at)\n22\t\t\t VALUES (?, ?, 'idle', CURRENT_TIMESTAMP)`)\n23\t\tif err != nil {\n24\t\t\treturn nil, fmt.Errorf(\"prepare insert: %w\", err)\n25\t\t}\n26\t\tdefer insertStmt.Close()\n27\t\n28\t\tfor _, num := range numbers {\n29\t\t\tif _, err := insertStmt.ExecContext(ctx, repo, num); err != nil {\n30\t\t\t\treturn nil, fmt.Errorf(\"insert issue %d: %w\", num, err)\n31\t\t\t}\n32\t\t}\n33\t\n34\t\t// Query all matching records.\n35\t\tplaceholders := make([]string, len(numbers))\n36\t\targs := make([]any, 0, len(numbers)+1)\n37\t\targs = append(args, repo)\n38\t\tfor i, num := range numbers {\n39\t\t\tplaceholders[i] = \"?\"\n40\t\t\targs = append(args, num)\n41\t\t}\n42\t\n43\t\tquery := fmt.Sprintf(\n44\t\t\t`SELECT issue_number, status, session_id, claimed_at\n45\t\t\t   FROM issue_claims\n46\t\t\t  WHERE repo_full_name = ? AND issue_number IN (%s)`,\n47\t\t\tstrings.Join(placeholders, \",\"))\n48\t\n49\t\trows, err := s.db.QueryContext(ctx, query, args...)\n50\t\tif err != nil {\n51\t\t\treturn nil, fmt.Errorf(\"query issues: %w\", err)\n52\t\t}\n53\t\tdefer rows.Close()\n54\t\n55\t\tresults := make([]IssueCheckResult, 0, len(numbers))\n56\t\tfor rows.Next() {\n57\t\t\tvar r IssueCheckResult\n58\t\t\tvar sessionID sql.NullString\n59\t\t\tvar claimedAt sql.NullString\n60\t\t\tif err := rows.Scan(&r.Number, &r.Status, &sessionID, &claimedAt); err != nil {\n61\t\t\t\treturn nil, fmt.Errorf(\"scan row: %w\", err)\n62\t\t\t}\n63\t\t\tif sessionID.Valid {\n64\t\t\t\tr.SessionID = &sessionID.String\n65\t\t\t}\n66\t\t\tif claimedAt.Valid {\n67\t\t\t\tr.ClaimedAt = &claimedAt.String\n68\t\t\t}\n69\t\t\tresults = append(results, r)\n70\t\t}\n71\t\treturn results, rows.Err()\n72\t}\n73\t\n74\tfunc (s *sqliteIssueStore) ClaimIssue(ctx context.Context, repo string, number int, sessionID string, issueTitle string) (*ClaimResult, error) {\n75\t\t// Ensure the record exists.\n76\t\t_, err := s.db.ExecContext(ctx,\n77\t\t\t`INSERT OR IGNORE INTO issue_claims (repo_full_name, issue_number, status, updated_at)\n78\t\t\t VALUES (?, ?, 'idle', CURRENT_TIMESTAMP)`,\n79\t\t\trepo, number)\n80\t\tif err != nil {\n81\t\t\treturn nil, fmt.Errorf(\"ensure issue: %w\", err)\n82\t\t}\n83\t\n84\t\t// Optimistic lock: try to claim only if status = 'idle'.\n85\t\tres, err := s.db.ExecContext(ctx,\n86\t\t\t`UPDATE issue_claims\n87\t\t\t    SET status = 'claimed', session_id = ?, claimed_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP\n88\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND status = 'idle'`,\n89\t\t\tsessionID, repo, number)\n90\t\tif err != nil {\n91\t\t\treturn nil, fmt.Errorf(\"claim update: %w\", err)\n92\t\t}\n93\t\tn, _ := res.RowsAffected()\n94\t\tif n > 0 {\n95\t\t\tvar claimedAt string\n96\t\t\ts.db.QueryRowContext(ctx,\n97\t\t\t\t`SELECT claimed_at FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n98\t\t\t\trepo, number).Scan(&claimedAt)\n99\t\t\treturn &ClaimResult{Success: true, Status: \"claimed\", ClaimedAt: &claimedAt}, nil\n100\t\t}\n101\t\n102\t\t// Claim failed — check current state.\n103\t\tvar curStatus string\n104\t\tvar curSession sql.NullString\n105\t\tvar curClaimedAt sql.NullString\n106\t\terr = s.db.QueryRowContext(ctx,\n107\t\t\t`SELECT status, session_id, claimed_at FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n108\t\t\trepo, number).Scan(&curStatus, &curSession, &curClaimedAt)\n109\t\tif err != nil {\n110\t\t\treturn nil, fmt.Errorf(\"query state: %w\", err)\n111\t\t}\n112\t\n113\t\t// Idempotent: same session already claimed it.\n114\t\tif curSession.Valid && curSession.String == sessionID {\n115\t\t\tresult := &ClaimResult{Success: true, Status: curStatus}\n116\t\t\tif curClaimedAt.Valid {\n117\t\t\t\tresult.ClaimedAt = &curClaimedAt.String\n118\t\t\t}\n119\t\t\treturn result, nil\n120\t\t}\n121\t\n122\t\t// Already claimed by another session or in terminal state.\n123\t\tresult := &ClaimResult{Success: false, Status: curStatus}\n124\t\tif curSession.Valid {\n125\t\t\tresult.ClaimedBy = &curSession.String\n126\t\t}\n127\t\tif curClaimedAt.Valid {\n128\t\t\tresult.ClaimedAt = &curClaimedAt.String\n129\t\t}\n130\t\treturn result, nil\n131\t}\n132\t\n133\tfunc (s *sqliteIssueStore) UpdateIssueStatus(ctx context.Context, repo string, number int, sessionID string, newStatus string) (*UpdateStatusResult, error) {\n134\t\t// Check current state.\n135\t\tvar curStatus string\n136\t\tvar curOwner sql.NullString\n137\t\terr := s.db.QueryRowContext(ctx,\n138\t\t\t`SELECT status, session_id FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n139\t\t\trepo, number,\n140\t\t).Scan(&curStatus, &curOwner)\n141\t\tif err == sql.ErrNoRows {\n142\t\t\treturn &UpdateStatusResult{Updated: false}, nil\n143\t\t}\n144\t\tif err != nil {\n145\t\t\treturn nil, fmt.Errorf(\"query status: %w\", err)\n146\t\t}\n147\t\n148\t\t// Only the owning session can update status.\n149\t\tif !curOwner.Valid || curOwner.String != sessionID {\n150\t\t\treturn &UpdateStatusResult{PreviousStatus: curStatus, Updated: false}, nil\n151\t\t}\n152\t\n153\t\t// Update.\n154\t\tres, err := s.db.ExecContext(ctx,\n155\t\t\t`UPDATE issue_claims SET status = ?, updated_at = CURRENT_TIMESTAMP\n156\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND session_id = ?`,\n157\t\t\tnewStatus, repo, number, sessionID,\n158\t\t)\n159\t\tif err != nil {\n160\t\t\treturn nil, fmt.Errorf(\"update status: %w\", err)\n161\t\t}\n162\t\tn, _ := res.RowsAffected()\n163\t\treturn &UpdateStatusResult{PreviousStatus: curStatus, NewStatus: newStatus, Updated: n > 0}, nil\n164\t}\n165\t\n166\tfunc (s *sqliteIssueStore) ReleaseIssue(ctx context.Context, repo string, number int, sessionID string) (bool, error) {\n167\t\t// Check current owner.\n168\t\tvar owner sql.NullString\n169\t\terr := s.db.QueryRowContext(ctx,\n170\t\t\t`SELECT session_id FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n171\t\t\trepo, number,\n172\t\t).Scan(&owner)\n173\t\tif err == sql.ErrNoRows {\n174\t\t\treturn false, nil\n175\t\t}\n176\t\tif err != nil {\n177\t\t\treturn false, fmt.Errorf(\"query owner: %w\", err)\n178\t\t}\n179\t\tif !owner.Valid || owner.String != sessionID {\n180\t\t\treturn false, nil\n181\t\t}\n182\t\n183\t\t// Release: only non-terminal statuses.\n184\t\tres, err := s.db.ExecContext(ctx,\n185\t\t\t`UPDATE issue_claims\n186\t\t\t    SET status = 'idle', session_id = NULL, claimed_at = NULL, updated_at = CURRENT_TIMESTAMP\n187\t\t\t  WHERE repo_full_name = ? AND issue_number = ? AND session_id = ?\n188\t\t\t    AND status NOT IN ('merged', 'rejected')`,\n189\t\t\trepo, number, sessionID,\n190\t\t)\n191\t\tif err != nil {\n192\t\t\treturn false, fmt.Errorf(\"update: %w\", err)\n193\t\t}\n194\t\tn, _ := res.RowsAffected()\n195\t\treturn n > 0, nil\n196\t}\n197\t\n198\tfunc (s *sqliteIssueStore) ReleaseSessionIssues(ctx context.Context, sessionID string) ([]int, error) {\n199\t\t// Collect issue numbers that will be released.\n200\t\trows, err := s.db.QueryContext(ctx,\n201\t\t\t`SELECT issue_number FROM issue_claims\n202\t\t\t  WHERE session_id = ? AND status NOT IN ('merged', 'rejected')`,\n203\t\t\tsessionID,\n204\t\t)\n205\t\tif err != nil {\n206\t\t\treturn nil, fmt.Errorf(\"query session issues: %w\", err)\n207\t\t}\n208\t\n209\t\tvar numbers []int\n210\t\tfor rows.Next() {\n211\t\t\tvar n int\n212\t\t\tif err := rows.Scan(&n); err != nil {\n213\t\t\t\trows.Close()\n214\t\t\t\treturn nil, fmt.Errorf(\"scan: %w\", err)\n215\t\t\t}\n216\t\t\tnumbers = append(numbers, n)\n217\t\t}\n218\t\trows.Close()\n219\t\n220\t\tif len(numbers) == 0 {\n221\t\t\treturn nil, nil\n222\t\t}\n223\t\n224\t\t// Batch update.\n225\t\t_, err = s.db.ExecContext(ctx,\n226\t\t\t`UPDATE issue_claims\n227\t\t\t    SET status = 'idle', session_id = NULL, claimed_at = NULL, updated_at = CURRENT_TIMESTAMP\n228\t\t\t  WHERE session_id = ? AND status NOT IN ('merged', 'rejected')`,\n229\t\t\tsessionID,\n230\t\t)\n231\t\tif err != nil {\n232\t\t\treturn nil, fmt.Errorf(\"batch release: %w\", err)\n233\t\t}\n234\t\n235\t\treturn numbers, nil\n236\t}\n237\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\session_store.go"},"tool_use_id":"call_38b02ed02d704bf9ac9f8bfd","tool_response":"1\tpackage store\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"database/sql\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t\t\"time\"\n9\t)\n10\t\n11\ttype sqliteSessionStore struct {\n12\t\tdb *sql.DB\n13\t}\n14\t\n15\tfunc (s *sqliteSessionStore) RegisterSession(ctx context.Context, sess Session) error {\n16\t\ttx, err := s.db.BeginTx(ctx, nil)\n17\t\tif err != nil {\n18\t\t\treturn fmt.Errorf(\"begin tx: %w\", err)\n19\t\t}\n20\t\tdefer tx.Rollback()\n21\t\n22\t\t// Parse machine_id into username and hostname.\n23\t\tusername, hostname := parseMachineID(sess.MachineID)\n24\t\n25\t\t// Upsert machine.\n26\t\t_, err = tx.ExecContext(ctx,\n27\t\t\t`INSERT INTO machines (machine_id, os, hostname, username, first_seen_at, last_seen_at)\n28\t\t\t VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)\n29\t\t\t ON CONFLICT(machine_id) DO UPDATE SET last_seen_at = CURRENT_TIMESTAMP`,\n30\t\t\tsess.MachineID, sess.OS, hostname, username)\n31\t\tif err != nil {\n32\t\t\treturn fmt.Errorf(\"upsert machine: %w\", err)\n33\t\t}\n34\t\n35\t\t// Upsert project.\n36\t\t_, err = tx.ExecContext(ctx,\n37\t\t\t`INSERT INTO projects (project_slug, project_cwd, first_seen_at, last_seen_at)\n38\t\t\t VALUES (?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)\n39\t\t\t ON CONFLICT(project_slug) DO UPDATE SET last_seen_at = CURRENT_TIMESTAMP`,\n40\t\t\tsess.ProjectSlug, sess.ProjectCwd)\n41\t\tif err != nil {\n42\t\t\treturn fmt.Errorf(\"upsert project: %w\", err)\n43\t\t}\n44\t\n45\t\t// Insert session.\n46\t\t_, err = tx.ExecContext(ctx,\n47\t\t\t`INSERT INTO sessions (session_id, machine_id, os, project_slug, project_cwd,\n48\t\t\t    transcript_path, local_trace_path, model, source, status, registered_at)\n49\t\t\t VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'active', CURRENT_TIMESTAMP)`,\n50\t\t\tsess.SessionID, sess.MachineID, sess.OS, sess.ProjectSlug, sess.ProjectCwd,\n51\t\t\tnilIfEmpty(sess.TranscriptPath), nilIfEmpty(sess.LocalTracePath),\n52\t\t\tnilIfEmpty(sess.Model), nilIfEmpty(sess.Source))\n53\t\tif err != nil {\n54\t\t\tif strings.Contains(err.Error(), \"UNIQUE constraint failed\") {\n55\t\t\t\treturn ErrSessionExists\n56\t\t\t}\n57\t\t\treturn fmt.Errorf(\"insert session: %w\", err)\n58\t\t}\n59\t\n60\t\treturn tx.Commit()\n61\t}\n62\t\n63\tfunc (s *sqliteSessionStore) CloseSession(ctx context.Context, sessionID string, reason string) error {\n64\t\tres, err := s.db.ExecContext(ctx,\n65\t\t\t`UPDATE sessions\n66\t\t\t    SET status = 'closed', closed_at = CURRENT_TIMESTAMP, close_reason = ?\n67\t\t\t  WHERE session_id = ? AND status = 'active'`,\n68\t\t\treason, sessionID)\n69\t\tif err != nil {\n70\t\t\treturn fmt.Errorf(\"close session: %w\", err)\n71\t\t}\n72\t\tn, _ := res.RowsAffected()\n73\t\tif n == 0 {\n74\t\t\treturn ErrSessionNotFound\n75\t\t}\n76\t\treturn nil\n77\t}\n78\t\n79\tfunc (s *sqliteSessionStore) ListSessions(ctx context.Context, filter SessionFilter) ([]Session, error) {\n80\t\tquery := `SELECT session_id, machine_id, os, project_slug, project_cwd,\n81\t\t                 transcript_path, local_trace_path, model, source,\n82\t\t                 status, registered_at, closed_at, close_reason\n83\t\t            FROM sessions WHERE 1=1`\n84\t\targs := []any{}\n85\t\n86\t\tif filter.MachineID != nil {\n87\t\t\tquery += \" AND machine_id = ?\"\n88\t\t\targs = append(args, *filter.MachineID)\n89\t\t}\n90\t\tif filter.ProjectSlug != nil {\n91\t\t\tquery += \" AND project_slug = ?\"\n92\t\t\targs = append(args, *filter.ProjectSlug)\n93\t\t}\n94\t\tif filter.Status != nil {\n95\t\t\tquery += \" AND status = ?\"\n96\t\t\targs = append(args, *filter.Status)\n97\t\t}\n98\t\tquery += \" ORDER BY registered_at DESC\"\n99\t\n100\t\trows, err := s.db.QueryContext(ctx, query, args...)\n101\t\tif err != nil {\n102\t\t\treturn nil, fmt.Errorf(\"list sessions: %w\", err)\n103\t\t}\n104\t\tdefer rows.Close()\n105\t\n106\t\tvar sessions []Session\n107\t\tfor rows.Next() {\n108\t\t\tvar sess Session\n109\t\t\tvar localTracePath, model, source, closedAt, closeReason sql.NullString\n110\t\t\tif err := rows.Scan(\n111\t\t\t\t&sess.SessionID, &sess.MachineID, &sess.OS, &sess.ProjectSlug, &sess.ProjectCwd,\n112\t\t\t\t&sess.TranscriptPath, &localTracePath, &model, &source,\n113\t\t\t\t&sess.Status, &sess.RegisteredAt, &closedAt, &closeReason,\n114\t\t\t); err != nil {\n115\t\t\t\treturn nil, fmt.Errorf(\"scan session: %w\", err)\n116\t\t\t}\n117\t\t\tif localTracePath.Valid {\n118\t\t\t\tsess.LocalTracePath = localTracePath.String\n119\t\t\t}\n120\t\t\tif model.Valid {\n121\t\t\t\tsess.Model = model.String\n122\t\t\t}\n123\t\t\tif source.Valid {\n124\t\t\t\tsess.Source = source.String\n125\t\t\t}\n126\t\t\tif closedAt.Valid {\n127\t\t\t\tt, _ := time.Parse(\"2006-01-02 15:04:05\", closedAt.String)\n128\t\t\t\tsess.ClosedAt = &t\n129\t\t\t}\n130\t\t\tif closeReason.Valid {\n131\t\t\t\tsess.CloseReason = closeReason.String\n132\t\t\t}\n133\t\t\tsessions = append(sessions, sess)\n134\t\t}\n135\t\treturn sessions, rows.Err()\n136\t}\n137\t\n138\tfunc (s *sqliteSessionStore) GetSession(ctx context.Context, sessionID string) (*Session, error) {\n139\t\tvar sess Session\n140\t\tvar localTracePath, model, source, closedAt, closeReason sql.NullString\n141\t\terr := s.db.QueryRowContext(ctx,\n142\t\t\t`SELECT session_id, machine_id, os, project_slug, project_cwd,\n143\t\t\t        transcript_path, local_trace_path, model, source,\n144\t\t\t        status, registered_at, closed_at, close_reason\n145\t\t\t   FROM sessions WHERE session_id = ?`,\n146\t\t\tsessionID,\n147\t\t).Scan(\n148\t\t\t&sess.SessionID, &sess.MachineID, &sess.OS, &sess.ProjectSlug, &sess.ProjectCwd,\n149\t\t\t&sess.TranscriptPath, &localTracePath, &model, &source,\n150\t\t\t&sess.Status, &sess.RegisteredAt, &closedAt, &closeReason,\n151\t\t)\n152\t\tif err == sql.ErrNoRows {\n153\t\t\treturn nil, nil\n154\t\t}\n155\t\tif err != nil {\n156\t\t\treturn nil, fmt.Errorf(\"get session: %w\", err)\n157\t\t}\n158\t\n159\t\tif localTracePath.Valid {\n160\t\t\tsess.LocalTracePath = localTracePath.String\n161\t\t}\n162\t\tif model.Valid {\n163\t\t\tsess.Model = model.String\n164\t\t}\n165\t\tif source.Valid {\n166\t\t\tsess.Source = source.String\n167\t\t}\n168\t\tif closedAt.Valid {\n169\t\t\tt, _ := time.Parse(\"2006-01-02 15:04:05\", closedAt.String)\n170\t\t\tsess.ClosedAt = &t\n171\t\t}\n172\t\tif closeReason.Valid {\n173\t\t\tsess.CloseReason = closeReason.String\n174\t\t}\n175\t\treturn &sess, nil\n176\t}\n177\t\n178\tfunc (s *sqliteSessionStore) CleanupTimedOut(ctx context.Context) (int, error) {\n179\t\tres, err := s.db.ExecContext(ctx,\n180\t\t\t`UPDATE sessions\n181\t\t\t    SET status = 'closed', closed_at = CURRENT_TIMESTAMP, close_reason = 'timeout_cleanup'\n182\t\t\t  WHERE status = 'active'\n183\t\t\t    AND registered_at < datetime('now', '-24 hours')`)\n184\t\tif err != nil {\n185\t\t\treturn 0, fmt.Errorf(\"cleanup timed out: %w\", err)\n186\t\t}\n187\t\tn, _ := res.RowsAffected()\n188\t\treturn int(n), nil\n189\t}\n190\t\n191\tfunc parseMachineID(machineID string) (username, hostname string) {\n192\t\tparts := strings.SplitN(machineID, \"@\", 2)\n193\t\tif len(parts) == 2 {\n194\t\t\treturn parts[0], parts[1]\n195\t\t}\n196\t\treturn machineID, \"\"\n197\t}\n198\t\n199\tfunc nilIfEmpty(s string) any {\n200\t\tif s == \"\" {\n201\t\t\treturn nil\n202\t\t}\n203\t\treturn s\n204\t}\n205\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\router.go"},"tool_use_id":"call_46d319502d79447db1dd831b","tool_response":"1\tpackage api\n2\t\n3\timport \"net/http\"\n4\t\n5\ttype Handlers struct {\n6\t\tIssue   *IssueHandler\n7\t\tSession *SessionHandler\n8\t}\n9\t\n10\tfunc NewRouter(h Handlers) http.Handler {\n11\t\tmux := http.NewServeMux()\n12\t\tmux.HandleFunc(\"/health\", Health)\n13\t\n14\t\t// Issue routes.\n15\t\tmux.HandleFunc(\"/api/issue/check\", h.Issue.CheckIssues)\n16\t\tmux.HandleFunc(\"/api/issue/claim\", h.Issue.ClaimIssue)\n17\t\tmux.HandleFunc(\"/api/issue/release\", h.Issue.ReleaseIssue)\n18\t\tmux.HandleFunc(\"/api/issue/release-session\", h.Issue.ReleaseSession)\n19\t\tmux.HandleFunc(\"/api/issue/status\", h.Issue.UpdateStatus)\n20\t\n21\t\t// Session routes.\n22\t\tmux.HandleFunc(\"/api/session/register\", h.Session.Register)\n23\t\tmux.HandleFunc(\"/api/session/close\", h.Session.Close)\n24\t\tmux.HandleFunc(\"/api/sessions\", h.Session.List)\n25\t\tmux.HandleFunc(\"/api/session/\", h.Session.Get)\n26\t\n27\t\treturn mux\n28\t}\n29\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\issue_handler.go"},"tool_use_id":"call_82fbad5bf69c4bbdacfff689","tool_response":"1\tpackage api\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"net/http\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n8\t)\n9\t\n10\ttype IssueHandler struct {\n11\t\tsvc *service.IssueService\n12\t}\n13\t\n14\tfunc NewIssueHandler(svc *service.IssueService) *IssueHandler {\n15\t\treturn &IssueHandler{svc: svc}\n16\t}\n17\t\n18\tfunc (h *IssueHandler) CheckIssues(w http.ResponseWriter, r *http.Request) {\n19\t\tif r.Method != http.MethodPost {\n20\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n21\t\t\treturn\n22\t\t}\n23\t\n24\t\tvar req CheckIssuesRequest\n25\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n26\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n27\t\t\treturn\n28\t\t}\n29\t\n30\t\tif req.RepoFullName == \"\" {\n31\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name is required\")\n32\t\t\treturn\n33\t\t}\n34\t\tif req.IssueNumbers == nil {\n35\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"issue_numbers is required\")\n36\t\t\treturn\n37\t\t}\n38\t\n39\t\tresults, err := h.svc.Check(r.Context(), req.RepoFullName, req.IssueNumbers)\n40\t\tif err != nil {\n41\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to check issues\")\n42\t\t\treturn\n43\t\t}\n44\t\n45\t\titems := make([]IssueStatusItem, len(results))\n46\t\tfor i, r := range results {\n47\t\t\titems[i] = IssueStatusItem{\n48\t\t\t\tNumber:    r.Number,\n49\t\t\t\tStatus:    r.Status,\n50\t\t\t\tSessionID: r.SessionID,\n51\t\t\t\tClaimedAt: r.ClaimedAt,\n52\t\t\t}\n53\t\t}\n54\t\n55\t\tif items == nil {\n56\t\t\titems = []IssueStatusItem{}\n57\t\t}\n58\t\n59\t\twriteJSON(w, http.StatusOK, CheckIssuesResponse{Issues: items})\n60\t}\n61\t\n62\tfunc (h *IssueHandler) ClaimIssue(w http.ResponseWriter, r *http.Request) {\n63\t\tif r.Method != http.MethodPost {\n64\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n65\t\t\treturn\n66\t\t}\n67\t\n68\t\tvar req ClaimIssueRequest\n69\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n70\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n71\t\t\treturn\n72\t\t}\n73\t\n74\t\tif req.RepoFullName == \"\" || req.IssueNumber == 0 || req.SessionID == \"\" {\n75\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name, issue_number and session_id are required\")\n76\t\t\treturn\n77\t\t}\n78\t\n79\t\tresult, err := h.svc.Claim(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID, req.IssueTitle)\n80\t\tif err != nil {\n81\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to claim issue\")\n82\t\t\treturn\n83\t\t}\n84\t\n85\t\tif result.Success {\n86\t\t\twriteJSON(w, http.StatusOK, ClaimIssueResponse{\n87\t\t\t\tSuccess:   true,\n88\t\t\t\tStatus:    result.Status,\n89\t\t\t\tClaimedAt: result.ClaimedAt,\n90\t\t\t})\n91\t\t\treturn\n92\t\t}\n93\t\n94\t\twriteJSON(w, http.StatusConflict, ClaimIssueResponse{\n95\t\t\tSuccess:   false,\n96\t\t\tError:     \"already_claimed\",\n97\t\t\tClaimedBy: result.ClaimedBy,\n98\t\t\tClaimedAt: result.ClaimedAt,\n99\t\t})\n100\t}\n101\t\n102\tfunc (h *IssueHandler) ReleaseIssue(w http.ResponseWriter, r *http.Request) {\n103\t\tif r.Method != http.MethodPost {\n104\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n105\t\t\treturn\n106\t\t}\n107\t\n108\t\tvar req ReleaseIssueRequest\n109\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n110\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n111\t\t\treturn\n112\t\t}\n113\t\n114\t\tif req.RepoFullName == \"\" || req.IssueNumber == 0 || req.SessionID == \"\" {\n115\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name, issue_number and session_id are required\")\n116\t\t\treturn\n117\t\t}\n118\t\n119\t\treleased, err := h.svc.Release(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID)\n120\t\tif err != nil 