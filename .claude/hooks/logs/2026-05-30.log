t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"pr-created\"}`)\n904\t\t\te.post(t, \"/api/issue/status\",\n905\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":45,\"session_id\":\"sess_test_lc\",\"status\":\"testing\"}`)\n906\t\n907\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{45})\n908\t\t\tif s[45] != \"testing\" {\n909\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[45])\n910\t\t\t}\n911\t\n912\t\t\t// session end 释放 testing\n913\t\t\te.post(t, \"/api/issue/release-session\",\n914\t\t\t\t`{\"session_id\":\"sess_test_lc\"}`)\n915\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{45})\n916\t\t\tif s[45] != \"idle\" {\n917\t\t\t\tt.Fatalf(\"expected idle after session end, got %s\", s[45])\n918\t\t\t}\n919\t\n920\t\t\t// re-claim\n921\t\t\tcode, ok, _ := claimIssue(t, e, \"xiaoheiDTF/claude-hk\", 45, \"sess_new\")\n922\t\t\tif code != http.StatusOK || !ok {\n923\t\t\t\tt.Fatalf(\"re-claim failed\")\n924\t\t\t}\n925\t\t})\n926\t}\n927\t\n928\t// --- D6: 003-9-issue-review 技能集成测试 ---\n929\t// 验收标准：\n930\t//   - testing → reviewing → merged 完整流程\n931\t//   - merged 终态不被 session end 释放\n932\t//   - rejected 终态不被 session end 释放\n933\t//   - rejected issue 释放后可被重新 claim\n934\t\n935\tfunc TestIssueReviewFlow(t *testing.T) {\n936\t\tt.Run(\"merge_full_flow\", func(t *testing.T) {\n937\t\t\te := setup(t)\n938\t\n939\t\t\t// claim → fixing → ready-for-pr → pr-created → testing → reviewing → merged\n940\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 50, \"sess_merge\")\n941\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\"} {\n942\t\t\t\te.post(t, \"/api/issue/status\",\n943\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":50,\"session_id\":\"sess_merge\",\"status\":\"%s\"}`, s))\n944\t\t\t}\n945\t\n946\t\t\tresp := e.post(t, \"/api/issue/status\",\n947\t\t\t\t`{\"repo_fu