t\tcase arg == \"--host\" && i+1 < len(args):\n44\t\t\t\ti++\n45\t\t\t\tcfg.Host = args[i]\n46\t\t\t// 解析 --host=HOST 形式\n47\t\t\tcase strings.HasPrefix(arg, \"--host=\"):\n48\t\t\t\tcfg.Host = arg[len(\"--host=\"):]\n49\t\t\t}\n50\t\t}\n51\t\n52\t\t// 初始化文件日志器\n53\t\tlogDir := trace.DefaultTraceDir()\n54\t\tif cfg.DBPath != \"\" && cfg.DBPath != \"backend.db\" {\n55\t\t\tlogDir = filepath.Dir(cfg.DBPath)\n56\t\t}\n57\t\tif err := logger.Init(logDir, true, logger.DEBUG); err != nil {\n58\t\t\tlog.Printf(\"warning: logger init failed: %v\", err)\n59\t\t}\n60\t\tdefer logger.Close()\n61\t\tlogger.Info(\"backend.cmd\", \"backend starting: host=%s port=%d db=%s\", cfg.Host, cfg.Port, cfg.DBPath)\n62\t\n63\t\t// 根据配置创建后端服务器实例\n64\t\tsrv, err := backend.NewServer(cfg)\n65\t\tif err != nil {\n66\t\t\tlog.Fatalf(\"create server: %v\", err)\n67\t\t}\n68\t\t// 函数退出时确保关闭服务器资源\n69\t\tdefer srv.Close()\n70\t\n71\t\t// 启动服务器并开始监听请求\n72\t\tif err := srv.Start(); err != nil {\n73\t\t\tlog.Fatalf(\"server error: %v\", err)\n74\t\t}\n75\t}\n76\t"}]}
