77\t\t\t\t\t\t\"input_tokens\":  float64(200),\n78\t\t\t\t\t\t\"output_tokens\": float64(80),\n79\t\t\t\t\t},\n80\t\t\t\t},\n81\t\t\t},\n82\t\t}\n83\t\tif err := w.Write(record2); err != nil {\n84\t\t\tt.Fatalf(\"Write second record: %v\", err)\n85\t\t}\n86\t\n87\t\t// 验证汇总统计\n88\t\tsummary := w.Summary()\n89\t\tif summary[\"api_calls\"] != 2 {\n90\t\t\tt.Errorf(\"expected 2 api_calls, got %v\", summary[\"api_calls\"])\n91\t\t}\n92\t\tif summary[\"input_tokens\"] != int64(300) {\n93\t\t\tt.Errorf(\"expected 300 input_tokens, got %v\", summary[\"input_tokens\"])\n94\t\t}\n95\t\tif summary[\"output_tokens\"] != int64(130) {\n96\t\t\tt.Errorf(\"expected 130 output_tokens, got %v\", summary[\"output_tokens\"])\n97\t\t}\n98\t\n99\t\tmodels := summary[\"models_used\"].(map[string]int)\n100\t\tif models[\"claude-3\"] != 2 {\n101\t\t\tt.Errorf(\"expected claude-3 count 2, got %v\", models)\n102\t\t}\n103\t\n104\t\tif err := w.Close(); err != nil {\n105\t\t\tt.Fatalf(\"Close: %v\", err)\n106\t\t}\n107\t\n108\t\t// 验证文件内容\n109\t\tdata, err := os.ReadFile(tracePath)\n110\t\tif err != nil {\n111\t\t\tt.Fatalf(\"read trace file: %v\", err)\n112\t\t}\n113\t\n114\t\tlines := splitLines(string(data))\n115\t\tif len(lines) != 2 {\n116\t\t\tt.Fatalf(\"expected 2 JSONL lines, got %d\", len(lines))\n117\t\t}\n118\t\n119\t\tvar first map[string]any\n120\t\tif err := json.Unmarshal([]byte(lines[0]), &first); err != nil {\n121\t\t\tt.Fatalf(\"parse first line: %v\", err)\n122\t\t}\n123\t\tif first[\"request_id\"] != \"req_001\" {\n124\t\t\tt.Errorf(\"first record request_id: got %v, want req_001\", first[\"request_id\"])\n125\t\t}\n126\t}\n127\t\n128\t// TestTraceWriterCreatesDirectory 验证：追踪写入器能自动创建嵌套目录。\n129\tfunc TestTraceWriterCreatesDirectory(t *testing.T) {\n130\t\tdir := t.TempDir()\n131\t\tnestedPath := filepath.Join(dir, \"sub1\", \"sub2\", \"trace.jsonl\")\n132\t\n133\t\tw, err := trace.NewTraceWriter(nestedPath)\n134\t\tif err != nil {\n135\t\t\tt.Fatalf(\"NewTraceWriter with nested dirs: %v\", err)\n136\t\t}\n137\t\tdefer w.Close()\n138\t\n139\t\tif _, err := os.Stat(filepath.Dir(nestedPath)); os.IsNotExist(err) {\n140\t\t\tt.Error(\"expected nested directories to be created\")\n141\t\t}\n142\t}\n143\t\n144\t// TestTraceWriterCacheTokenStats 验证：缓存 token（cache_read_tokens、cache_create_tokens）被正确统计。\n145\tfunc TestTraceWriterCacheTokenStats(t *testing.T) {\n146\t\tdir := t.TempDir()\n147\t\tw, err := trace.NewTraceWriter(filepath.Join(dir, \"cache_test.jsonl\"))\n148\t\tif err != nil {\n149\t\t\tt.Fatalf(\"NewTraceWriter: %v\", err)\n150\t\t}\n151\t\tdefer w.Close()\n152\t\n153\t\trecord := map[string]any{\n154\t\t\t\"request\": map[string]any{\n155\t\t\t\t\"body\": map[string]any{\"model\": \"claude-3\"},\n156\t\t\t},\n157\t\t\t\"response\": map[string]any{\n158\t\t\t\t\"body\": map[string]any{\n159\t\t\t\t\t\"usage\": map[string]any{\n160\t\t\t\t\t\t\"input_tokens\":                float64(100),\n161\t\t\t\t\t\t\"output_tokens\":               float64(50),\n162\t\t\t\t\t\t\"cache_read_input_tokens\":     float64(30),\n163\t\t\t\t\t\t\"cache_creation_input_tokens\": float64(10),\n164\t\t\t\t\t},\n165\t\t\t\t},\n166\t\t\t},\n167\t\t}\n168\t\n169\t\tif err := w.Write(record); err != nil {\n170\t\t\tt.Fatalf(\"Write: %v\", err)\n171\t\t}\n172\t\n173\t\tsummary := w.Summary()\n174\t\tif summary[\"cache_read_tokens\"] != int64(30) {\n175\t\t\tt.Errorf(\"cache_read_tokens: got %v, want 30\", summary[\"cache_read_tokens\"])\n176\t\t}\n177\t\tif summary[\"cache_create_tokens\"] != int64(10) {\n178\t\t\tt.Errorf(\"cache_create_tokens: got %v, want 10\", summary[\"cache_create_tokens\"])\n179\t\t}\n180\t}\n181\t\n182\t// splitLines 将字符串按换行符分割，过滤空行。\n183\tfunc splitLines(s string) []string {\n184\t\tvar lines []string\n185\t\tfor _, line := range strings.Split(s, \"\\n\") {\n186\t\t\tif line != \"\" {\n187\t\t\t\tlines = append(lines, line)\n188\t\t\t}\n189\t\t}\n190\t\treturn lines\n191\t}\n192\t\n193\t// TestMachineID 验证：MachineID 返回非空字符串，且包含用户名和主机名。\n194\tfunc TestMachineID(t *testing.T) {\n195\t\tmid := trace.MachineID()\n196\t\tif mid == \"\" {\n197\t\t\tt.Fatal(\"MachineID should not be empty\")\n198\t\t}\n199\t\tif !strings.Contains(mid, \"@\") {\n200\t\t\tt.Errorf(\"MachineID should contain '@', got %q\", mid)\n201\t\t}\n202\t\tparts := strings.SplitN(mid, \"@\", 2)\n203\t\tif parts[0] == \"\" || parts[1] == \"\" {\n204\t\t\tt.Errorf(\"MachineID should have non-empty username and hostname, got %q\", mid)\n205\t\t}\n206\t}\n207\t\n208\t// TestExtractProjectSlug 验证：从追踪文件路径中提取项目 slug。\n209\tfunc TestExtractProjectSlug(t *testing.T) {\n210\t\ttests := []struct {\n211\t\t\tname  string\n212\t\t\tinput string\n213\t\t\twant  string\n214\t\t}{\n215\t\t\t{\"windows_path\", `C:\\Users\\Admin\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\uuid.jsonl`, \"D--CodeDevelopment-CodeProject-claude-hk\"},\n216\t\t\t{\"unix_path\", \"/home/user/.claude/projects/D--CodeDevelopment-CodeProject-claude-hk/uuid.jsonl\", \"D--CodeDevelopment-CodeProject-claude-hk\"},\n217\t\t\t{\"empty\", \"\", \"\"},\n218\t\t\t{\"no_projects_segment\", \"/some/random/path.jsonl\", \"\"},\n219\t\t}\n220\t\n221\t\tfor _, tt := range tests {\n222\t\t\tt.Run(tt.name, func(t *testing.T) {\n223\t\t\t\tgot := trace.ExtractProjectSlug(tt.input)\n224\t\t\t\tif got != tt.want {\n225\t\t\t\t\tt.Errorf(\"ExtractProjectSlug(%q) = %q, want %q\", tt.input, got, tt.want)\n226\t\t\t\t}\n227\t\t\t})\n228\t\t}\n229\t}\n230\t\n231\t// TestNewSessionTracePath 验证：Session 追踪路径按 machine_id/project_slug/session_id.jsonl 格式生成。\n232\tfunc TestNewSessionTracePath(t *testing.T) {\n233\t\tpath := trace.NewSessionTracePath(\"/tmp/traces\", \"user@host\", \"D--my-project\", \"abc-123\")\n234\t\t// 路径格式：/tmp/traces/user@host/D--my-project/{date}/{time}/abc-123.jsonl\n235\t\tif !strings.HasSuffix(path, \"abc-123.jsonl\") {\n236\t\t\tt.Errorf(\"expected path to end with abc-123.jsonl, got %q\", path)\n237\t\t}\n238\t\tif !strings.Contains(path, filepath.Join(\"user@host\", \"D--my-project\")) {\n239\t\t\tt.Errorf(\"expected path to contain machine_id/project_slug dirs, got %q\", path)\n240\t\t}\n241\t}\n242\t\n243\t// TestDefaultTraceDir 验证：默认追踪目录包含 .claude-tap-plus 和 .traces 后缀。\n244\tfunc TestDefaultTraceDir(t *testing.T) {\n245\t\tdir := trace.DefaultTraceDir()\n246\t\tif dir == \"\" {\n247\t\t\tt.Fatal(\"DefaultTraceDir should not be empty\")\n248\t\t}\n249\t\tif !strings.Contains(dir, \".claude-tap-plus\") {\n250\t\t\tt.Errorf(\"DefaultTraceDir should contain .claude-tap-plus, got %q\", dir)\n251\t\t}\n252\t\tif !strings.HasSuffix(dir, \".traces\") {\n253\t\t\tt.Errorf(\"DefaultTraceDir should end with .traces, got %q\", dir)\n254\t\t}\n255\t}\n256\t"}]}
