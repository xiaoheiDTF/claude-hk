 err != nil {\n106\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n107\t\t\treturn\n108\t\t}\n109\t\t_ = r.Body.Close()\n110\t\n111\t\t// Parse request body as JSON.\n112\t\tvar reqBody any\n113\t\tif len(bodyBytes) > 0 {\n114\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n115\t\t}\n116\t\n117\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n118\t\tturn := int(p.turn.Add(1))\n119\t\tt0 := time.Now()\n120\t\n121\t\t// Build upstream request URL.\n122\t\tupstreamURL := p.target + r.URL.Path\n123\t\tif r.URL.RawQuery != \"\" {\n124\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n125\t\t}\n126\t\n127\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n128\t\tif err != nil {\n129\t\t\thttp.Error(w, \"create upstream request: \"+err.Error(), http.StatusBadGateway)\n130\t\t\treturn\n131\t\t}\n132\t\n133\t\t// Copy headers, filter hop-by-hop.\n134\t\tfor k, vals := range r.Header {\n135\t\t\tlower := strings.ToLower(k)\n136\t\t\tif hopByHopHeaders[lower] {\n137\t\t\t\tcontinue\n138\t\t\t}\n139\t\t\tfor _, v := range vals {\n140\t\t\t\tupstreamReq.Header.Add(k, v)\n141\t\t\t}\n142\t\t}\n143\t\tupstreamReq.Header.Del(\"Host\")\n144\t\n145\t\tupstreamResp, err := p.client.Do(upstreamReq)\n146\t\tif err != nil {\n147\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error: %v\", turn, err)\n148\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n149\t\t\treturn\n150\t\t}\n151\t\tdefer upstreamResp.Body.Close()\n152\t\n153\t\tduration := time.Since(t0).Milliseconds()\n154\t\tmodel := \"\"\n155\t\tif m, ok := reqBody.(map[string]any); ok {\n156\t\t\tif v, ok := m[\"model\"].(string); ok {\n157\t\t\t\tmodel = v\n158\t\t\t}\n159\t\t}\n160\t\n161\t\t// Detect streaming.\n162\t\tisStreaming := false\n163\t\tif m, ok := reqBody.(map[string]any); ok {\n164\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n165\t\t\t\tisStreaming = s\n166\t\t\t}\n167\t\t}\n168\t\n169\t\tif isStreaming {\n170\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n171\t\t} else {\n172\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n173\t\t}\n174\t}\n175\t\n176\tfunc (p *ReverseProxy) handleStreaming(\n177\t\tw http.ResponseWriter,\n178\t\tupstreamResp *http.Response,\n179\t\treqID string, turn, durationMs int,\n180\t\tr *http.Request, reqBody any,\n181\t\tt0 time.Time, model string,\n182\t) {\n183\t\t// Copy response headers.\n184\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n185\t\tfor k, vals := range respHeaders {\n186\t\t\tfor _, v := range vals {\n187\t\t\t\tw.Header().Add(k, v)\n188\t\t\t}\n189\t\t}\n190\t\tw.WriteHeader(upstreamResp.StatusCode)\n191\t\n192\t\tflusher, canFlush := w.(http.Flusher)\n193\t\treassembler := sse.NewSSEReassembler()\n194\t\n195\t\tbuf := make([]byte, 32*1024)\n196\t\tfor {\n197\t\t\tn, err := upstreamResp.Body.Read(buf)\n198\t\t\tif n > 0 {\n199\t\t\t\t_, _ = w.Write(buf[:n])\n200\t\t\t\tif canFlush {\n201\t\t\t\t\tflusher.Flush()\n202\t\t\t\t}\n203\t\t\t\treassembler.FeedBytes(buf[:n])\n204\t\t\t}\n205\t\t\tif err != nil {\n206\t\t\t\tbreak\n207\t\t\t}\n208\t\t}\n209\t\n210\t\tdurationMs = int(time.Since(t0).Milliseconds())\n211\t\treconstructed := reassembler.Reconstruct()\n212\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n213\t\n214\t\trecord := buildRecord(\n215\t\t\treqID, turn, durationMs,\n216\t\t\tr.Method, r.URL.RequestURI(),\n217\t\t\tr.Header, reqBody,\n218\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n219\t\t\treconstructed,\n220\t\t\treassembler.Events,\n221\t\t\tp.target,\n222\t\t)\n223\t\n224\t\tif err := p.getWriter().Write(record); err != nil {\n225\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n226\t\t}\n227\t\n228\t\tlogger.Info(\"proxy\", \"[Turn %d] ← %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n229\t}\n230\t\n231\tfunc (p *ReverseProxy) handleNonStreaming(\n232\t\tw http.ResponseWriter,\n233\t\tupstreamResp *http.Response,\n234\t\treqID string, turn, durationMs int,\n235\t\tr *http.Request, reqBody any, model string,\n236\t) {\n237\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n238\t\tif err != nil {\n239\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n240\t\t\treturn\n241\t\t}\n242\t\n243\t\t// Decompress if needed.\n244\t\tdecodeBytes := respBytes\n245\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n246\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n247\t\t\tvar reader io.ReadCloser\n248\t\t\tif encoding == \"gzip\" {\n249\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n250\t\t\t} else {\n251\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n252\t\t\t}\n253\t\t\tif reader != nil {\n254\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n255\t\t\t\t\tdecodeBytes = decoded\n256\t\t\t\t}\n257\t\t\t\t_ = reader.Close()\n258\t\t\t}\n259\t\t}\n260\t\n261\t\tvar respBody any\n262\t\tif len(decodeBytes) > 0 {\n263\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n264\t\t}\n265\t\n266\t\trecord := buildRecord(\n267\t\t\treqID, turn, durationMs,\n268\t\t\tr.Method, r.URL.RequestURI(),\n269\t\t\tr.Header, reqBody,\n270\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n271\t\t\trespBody,\n272\t\t\tnil,\n273\t\t\tp.target,\n274\t\t)\n275\t\n276\t\tif err := p.getWriter().Write(record); err != nil {\n277\t\t\tlog.Printf(\"[Turn %d] trace write error: %v\", turn, err)\n278\t\t}\n279\t\n280\t\t// Write response to client.\n281\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n282\t\tfor k, vals := range respHeaders {\n283\t\t\tfor _, v := range vals {\n284\t\t\t\tw.Header().Add(k, v)\n285\t\t\t}\n286\t\t}\n287\t\tw.WriteHeader(upstreamResp.StatusCode)\n288\t\t_, _ = w.Write(respBytes)\n289\t\n290\t\tlog.Printf(\"[Turn %d] ← %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n291\t}\n292\t\n293\tfunc buildRecord(\n294\t\treqID string, turn, durationMs int,\n295\t\tmethod, path string,\n296\t\treqHeaders http.Header, reqBody any,\n297\t\tstatus int, respHeaders http.Header,\n298\t\trespBody any,\n299\t\tsseEvents []map[string]any,\n300\t\tupstreamBaseURL string,\n301\t) map[string]any {\n302\t\trecord := map[string]any{\n303\t\t\t\"timestamp\":    time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n304\t\t\t\"request_id\":   reqID,\n305\t\t\t\"session_id\":   extractSessionID(reqBody),\n306\t\t\t\"turn\":         turn,\n307\t\t\t\"duration_ms\":  durationMs,\n308\t\t\t\"request\": map[string]any{\n309\t\t\t\t\"method\":  method,\n310\t\t\t\t\"path\":    path,\n311\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n312\t\t\t\t\"body\":    reqBody,\n313\t\t\t},\n314\t\t\t\"response\": map[string]any{\n315\t\t\t\t\"status\":  status,\n316\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n317\t\t\t\t\"body\":    respBody,\n318\t\t\t},\n319\t\t}\n320\t\tif len(sseEvents) > 0 {\n321\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n322\t\t}\n323\t\tif upstreamBaseURL != \"\" {\n324\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n325\t\t}\n326\t\treturn record\n327\t}\n328\t\n329\t// extractSessionID extracts session_id from request.body.metadata.user_id (JSON string).\n330\t// Claude Code sends: metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n331\tfunc extractSessionID(reqBody any) string {\n332\t\tbody, ok := reqBody.(map[string]any)\n333\t\tif !ok {\n334\t\t\treturn \"\"\n335\t\t}\n336\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n337\t\tif metadata == nil {\n338\t\t\treturn \"\"\n339\t\t}\n340\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n341\t\tif userIDRaw == \"\" {\n342\t\t\treturn \"\"\n343\t\t}\n344\t\tvar userData map[string]string\n345\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n346\t\t\treturn \"\"\n347\t\t}\n348\t\treturn userData[\"session_id\"]\n349\t}\n350\t\n351\t// handleInternal dispatches internal proxy endpoints.\n352\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n353\t\tswitch r.URL.Path {\n354\t\tcase \"/_internal/trace-init\":\n355\t\t\tp.handleTraceInit(w, r)\n356\t\tdefault:\n357\t\t\thttp.NotFound(w, r)\n358\t\t}\n359\t}\n360\t\n361\t// handleTraceInit receives session info from SessionStart hook and creates the trace writer.\n362\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n363\t\tif r.Method != http.MethodPost {\n364\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n365\t\t\treturn\n366\t\t}\n367\t\n368\t\tvar req struct {\n369\t\t\tSessionID     string `json:\"session_id\"`\n370\t\t\tMachineID     string `json:\"machine_id\"`\n371\t\t\tProjectSlug   string `json:\"project_slug\"`\n372\t\t\tTranscriptPath string `json:\"transcript_path\"`\n373\t\t}\n374\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n375\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n376\t\t\treturn\n377\t\t}\n378\t\n379\t\tif req.SessionID == \"\" {\n380\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n381\t\t\treturn\n382\t\t}\n383\t\n384\t\tmachineID := req.MachineID\n385\t\tif machineID == \"\" {\n386\t\t\tmachineID = trace.MachineID()\n387\t\t}\n388\t\n389\t\tprojectSlug := req.ProjectSlug\n390\t\tif projectSlug == \"\" {\n391\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n392\t\t\tif projectSlug == \"\" {\n393\t\t\t\tprojectSlug = trace.DetectProjectName()\n394\t\t\t}\n395\t\t}\n396\t\n397\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n398\t\twriter, err := trace.NewTraceWriter(tracePath)\n399\t\tif err != nil {\n400\t\t\tlog.Printf(\"trace-init: failed to create writer: %v\", err)\n401\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n402\t\t\treturn\n403\t\t}\n404\t\n405\t\t// Close fallback writer if it exists\n406\t\tif p.fallbackW != nil {\n407\t\t\tp.fallbackW.Close()\n408\t\t\tp.fallbackW = nil\n409\t\t}\n410\t\n411\t\tp.writer = writer\n412\t\tlog.Printf(\"trace initialized: %s\", tracePath)\n413\t\n414\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n415\t\tjson.NewEncoder(w).Encode(map[string]string{\n416\t\t\t\"status\":     \"ok\",\n417\t\t\t\"trace_path\": tracePath,\n418\t\t})\n419\t}\n420\t\n421\t// getWriter returns the session writer, or creates a fallback if not yet initialized.\n422\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n423\t\tif p.writer != nil {\n424\t\t\treturn p.writer\n425\t\t}\n426\t\t// Fallback: create a temp writer using old-style path\n427\t\tif p.fallbackW == nil {\n428\t\t\tfallbackPath := trace.NewTracePath(p.baseDir)\n429\t\t\tw, err := trace.NewTraceWriter(fallbackPath)\n430\t\t\tif err != nil {\n431\t\t\t\tlog.Printf(\"fallback trace: %v\", err)\n432\t\t\t\treturn nil\n433\t\t\t}\n434\t\t\tp.fallbackW = w\n435\t\t\tlog.Printf(\"using fallback trace: %s\", fallbackPath)\n436\t\t}\n437\t\treturn p.fallbackW\n438\t}\n439\t\n440\t// Summary returns aggregate statistics for the active trace writer.\n441\tfunc (p *ReverseProxy) Summary() map[string]any {\n442\t\tif w := p.getWriter(); w != nil {\n443\t\t\treturn w.Summary()\n444\t\t}\n445\t\treturn map[string]any{\n446\t\t\t\"api_calls\":           0,\n447\t\t\t\"input_tokens\":        int64(0),\n448\t\t\t\"output_tokens\":       int64(0),\n449\t\t\t\"cache_read_tokens\":   int64(0),\n450\t\t\t\"cache_create_tokens\": int64(0),\n451\t\t}\n452\t}\n453\t"}]}
