31\t\tlog.SetFlags(log.Ltime | log.Lmicroseconds)\n32\t\n33\t\t// 初始化文件日志器（使用默认 trace 目录）\n34\t\tlogDir := trace.DefaultTraceDir()\n35\t\tif err := logger.Init(logDir, false, logger.INFO); err != nil {\n36\t\t\tlog.Printf(\"warning: logger init failed: %v\", err)\n37\t\t}\n38\t\tdefer logger.Close()\n39\t\n40\t\t// 检测子命令，如果第一个参数是已知子命令则分发执行\n41\t\tif len(os.Args) > 1 {\n42\t\t\tswitch os.Args[1] {\n43\t\t\tcase \"session-push\":\n44\t\t\t\trunSessionPush(os.Args[2:])\n45\t\t\t\treturn\n46\t\t\tcase \"session-pull\":\n47\t\t\t\trunSessionPull(os.Args[2:])\n48\t\t\t\treturn\n49\t\t\tcase \"session-status\":\n50\t\t\t\trunSessionStatus(os.Args[2:])\n51\t\t\t\treturn\n52\t\t\tcase \"backend\":\n53\t\t\t\trunBackend(os.Args[2:])\n54\t\t\t\treturn\n55\t\t\tcase \"help\", \"--help\", \"-h\":\n56\t\t\t\tprintUsage()\n57\t\t\t\treturn\n58\t\t\t}\n59\t\t}\n60\t\n61\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n62\t\trunProxy(os.Args[1:])\n63\t}\n64\t\n65\t// printUsage 打印命令行使用帮助信息到标准输出。\n66\tfunc printUsage() {\n67\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n68\t\tfmt.Println()\n69\t\tfmt.Println(\"Usage:\")\n70\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n71\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n72\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n73\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n74\t\tfmt.Println()\n75\t\tfmt.Println(\"Proxy flags:\")\n76\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n77\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n78\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n79\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n80\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n81\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n82\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n83\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n84\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n85\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n86\t\tfmt.Println()\n87\t\tfmt.Println(\"Session-push flags:\")\n88\t\tfmt.Println(\"  --all                  Collect all projects\")\n89\t\tfmt.Println(\"  --force                Overwrite existing files\")\n90\t\tfmt.Println(\"  --dry-run              Preview only\")\n91\t\tfmt.Println(\"  --project NAME         Override project name\")\n92\t\tfmt.Println()\n93\t\tfmt.Println(\"Session-pull flags:\")\n94\t\tfmt.Println(\"  --all                  Restore all projects\")\n95\t\tfmt.Println(\"  --project NAME         Override project name\")\n96\t\tfmt.Println(\"  --dry-run              Preview only\")\n97\t\tfmt.Println()\n98\t\tfmt.Println(\"Session-status flags:\")\n99\t\tfmt.Println(\"  --verbose              Show file-level details\")\n100\t}\n101\t\n102\t// runProxy 是默认的代理模式主逻辑。\n103\t//\n104\t// 工作流程：\n105\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n106\t//  2. 自动探测上游 API 目标地址\n107\t//  3. 启动本地反向代理监听指定端口\n108\t//  4. 解析 Claude Code 可执行文件路径\n109\t//  5. 构建子进程环境变量（注入代理地址）\n110\t//  6. 启动 Claude Code 作为子进程\n111\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n112\t//  8. 子进程退出后打印 API 调用统计摘要\n113\tfunc runProxy(args []string) {\n114\t\t// 记录原始命令行参数，用于生成 resume 命令\n115\t\toriginalArgs := append([]string{}, args...)\n116\t\n117\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n118\t\tvar (\n119\t\t\ttapTarget    string // 上游 API 目标地址\n120\t\t\ttapPort      int    // 本地代理监听端口\n121\t\t\ttapOutputDir string // 追踪记录输出目录\n122\t\t\ttapVerbose   bool   // 是否启用详细日志\n123\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n124\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n125\t\t\ttapAPIKey    string // 直接传入 API Key\n126\t\t\ttapAuthToken string // 直接传入 OAuth Token\n127\t\t\ttapBaseURL   string // 直接传入上游地址\n128\t\t)\n129\t\n130\t\tvar claudeArgs []string\n131\t\tfor i := 0; i < len(args); i++ {\n132\t\t\targ := args[i]\n133\t\t\tswitch {\n134\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n135\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n136\t\t\t\ti++\n137\t\t\t\ttapTarget = args[i]\n138\t\t\t// 解析 --tap-target=URL 形式\n139\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n140\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n141\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n142\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n143\t\t\t\ti++\n144\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n145\t\t\t// 解析 --tap-port=PORT 形式\n146\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n147\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n148\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n149\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n150\t\t\t\ti++\n151\t\t\t\ttapOutputDir = args[i]\n152\t\t\t// 解析 --tap-output-dir=DIR 形式\n153\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n154\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n155\t\t\t// 启用详细日志\n156\t\t\tcase arg == \"--tap-verbose\":\n157\t\t\t\ttapVerbose = true\n158\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n159\t\t\tcase arg == \"--tap-console\":\n160\t\t\t\ttapConsole = true\n161\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n162\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n163\t\t\t\ti++\n164\t\t\t\ttapProfile = args[i]\n165\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n166\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n167\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n168\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n169\t\t\t\ti++\n170\t\t\t\ttapAPIKey = args[i]\n171\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n172\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n173\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n174\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n175\t\t\t\ti++\n176\t\t\t\ttapAuthToken = args[i]\n177\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n178\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n179\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n180\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n181\t\t\t\ti++\n182\t\t\t\ttapBaseURL = args[i]\n183\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n184\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n185\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n186\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n187\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n188\t\t\t\ti = len(args) // 停止解析\n189\t\t\t// 未知的 --tap-* 标志，直接忽略\n190\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n191\t\t\t// 其他参数视为 Claude Code 的参数\n192\t\t\tdefault:\n193\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n194\t\t\t}\n195\t\t}\n196\t\n197\t\t// 如果未指定输出目录，使用默认追踪目录\n198\t\tif tapOutputDir == \"\" {\n199\t\t\ttapOutputDir = trace.DefaultTraceDir()\n200\t\t}\n201\t\n202\t\t// 校验：--tap-console 必须配合 --tap-verbose\n203\t\tif tapConsole && !tapVerbose {\n204\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n205\t\t\tos.Exit(1)\n206\t\t}\n207\t\n208\t\t// 根据详细程度重新初始化日志器\n209\t\tif tapVerbose {\n210\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n211\t\t} else {\n212\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n213\t\t}\n214\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n215\t\n216\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n217\t\tresolved, err := config.ResolveTargetConfig(\n218\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n219\t\t\ttapAPIKey,\n220\t\t\ttapAuthToken,\n221\t\t\ttapProfile,\n222\t\t\t&config.ClaudeClient,\n223\t\t)\n224\t\tif err != nil {\n225\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n226\t\t}\n227\t\ttarget := resolved.BaseURL\n228\t\tif tapVerbose {\n229\t\t\tlog.Printf(\"upstream target: %s\", target)\n230\t\t}\n231\t\n232\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n233\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n234\t\tport := tapPort\n235\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n236\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n237\t\tif err != nil {\n238\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n239\t\t}\n240\t\t// 函数退出时停止代理\n241\t\tdefer rp.Stop()\n242\t\n243\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n244\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n245\t\n246\t\t// 解析 Claude Code 可执行文件路径\n247\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n248\t\tif err != nil {\n249\t\t\tlog.Fatal(err)\n250\t\t}\n251\t\n252\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n253\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n254\t\n255\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n256\t\tif resolved.APIKey != \"\" {\n257\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n258\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n259\t\t} else if resolved.AuthToken != \"\" {\n260\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n261\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n262\t\t}\n263\t\n264\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n265\t\tfinalArgs := claudeArgs\n266\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n267\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n268\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n269\t\t}\n270\t\n271\t\t// 启动 Claude Code 作为子进程\n272\t\tcmd := exec.Command(claudePath, finalArgs...)\n273\t\tcmd.Env = childEnv\n274\t\tcmd.Stdin = os.Stdin\n275\t\tcmd.Stdout = os.Stdout\n276\t\tcmd.Stderr = os.Stderr\n277\t\n278\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n279\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n280\t\n281\t\tif err := cmd.Start(); err != nil {\n282\t\t\tlog.Fatalf(\"start claude: %v\", err)\n283\t\t}\n284\t\n285\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n286\t\tsigChan := make(chan os.Signal, 2)\n287\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n288\t\n289\t\tgo func() {\n290\t\t\tsigCount := 0\n291\t\t\tfor sig := range sigChan {\n292\t\t\t\tsigCount++\n293\t\t\t\tif sigCount == 1 {\n294\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n295\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n296\t\t\t\t\t_ = cmd.Process.Signal(sig)\n297\t\t\t\t} else {\n298\t\t\t\t\t// 再次收到信号：强制终止子进程\n299\t\t\t\t\t_ = cmd.Process.Kill()\n300\t\t\t\t}\n301\t\t\t}\n302\t\t}()\n303\t\n304\t\t// 等待子进程结束\n305\t\twaitErr := cmd.Wait()\n306\t\n307\t\t// 停止信号处理器，释放资源\n308\t\tsignal.Stop(sigChan)\n309\t\tclose(sigChan)\n310\t\n311\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n312\t\tsummary := rp.Summary()\n313\t\ttracePath := rp.TracePath()\n314\t\n315\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n316\t\tif waitErr != nil {\n317\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n318\t\t}\n319\t\tfmt.Printf(\"\\n\")\n320\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n321\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n322\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n323\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n324\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n325\t\tif tracePath != \"\" {\n326\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n327\t\t}\n328\t\tfmt.Printf(\"\\n\")\n329\t\n330\t\t// 生成 Resume 命令（仅在有 session_id 时）\n331\t\tsessionID := rp.SessionID()\n332\t\tif sessionID != \"\" {\n333\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n334\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n335\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n336\t\t}\n337\t}\n338\t\n339\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n340\t//\n341\t// 支持的参数：\n342\t//   --all       收集所有项目的会话\n343\t//   --force     覆盖已存在的会话文件\n344\t//   --dry-run   仅预览，不实际执行\n345\t//   --project   指定项目名称，覆盖自动检测\n346\tfunc runSessionPush(args []string) {\n347\t\tvar opts session.PushOptions\n348\t\tfor i := 0; i < len(args); i++ {\n349\t\t\targ := args[i]\n350\t\t\tswitch {\n351\t\t\tcase arg == \"--all\":\n352\t\t\t\topts.All = true\n353\t\t\tcase arg == \"--force\":\n354\t\t\t\topts.Force = true\n355\t\t\tcase arg == \"--dry-run\":\n356\t\t\t\topts.DryRun = true\n357\t\t\tcase arg == \"--project\" && i+1 < len(args):\n358\t\t\t\ti++\n359\t\t\t\topts.Project = args[i]\n360\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n361\t\t\t\topts.Project = arg[len(\"--project=\"):]\n362\t\t\t}\n363\t\t}\n364\t\n365\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n366\t\tresults, err := session.SessionPush(opts)\n367\t\tif err != nil {\n368\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n369\t\t\tos.Exit(1)\n370\t\t}\n371\t\n372\t\t// 汇总各项目的收集结果\n373\t\tfmt.Println()\n374\t\ttotalNew, totalSkipped := 0, 0\n375\t\tfor _, r := range results {\n376\t\t\ttotalNew += r.SessionsNew\n377\t\t\ttotalSkipped += r.SessionsSkipped\n378\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n379\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n380\t\t\t}\n381\t\t}\n382\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n383\t}\n384\t\n385\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n386\t//\n387\t// 支持的参数：\n388\t//   --all       恢复所有项目的会话\n389\t//   --dry-run   仅预览，不实际执行\n390\t//   --project   指定项目名称，覆盖自动检测\n391\tfunc runSessionPull(args []string) {\n392\t\tvar opts session.PullOptions\n393\t\tfor i := 0; i < len(args); i++ {\n394\t\t\targ := args[i]\n395\t\t\tswitch {\n396\t\t\tcase arg == \"--all\":\n397\t\t\t\topts.All = true\n398\t\t\tcase arg == \"--dry-run\":\n399\t\t\t\topts.DryRun = true\n400\t\t\tcase arg == \"--project\" && i+1 < len(args):\n401\t\t\t\ti++\n402\t\t\t\topts.Project = args[i]\n403\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n404\t\t\t\topts.Project = arg[len(\"--project=\"):]\n405\t\t\t}\n406\t\t}\n407\t\n408\t\tfmt.Println(\"📤 Restoring sessions...\")\n409\t\tresults, err := session.SessionPull(opts)\n410\t\tif err != nil {\n411\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n412\t\t\tos.Exit(1)\n413\t\t}\n414\t\n415\t\t// 汇总各项目的恢复结果\n416\t\tfmt.Println()\n417\t\ttotalRestored, totalSkipped := 0, 0\n418\t\tfor _, r := range results {\n419\t\t\ttotalRestored += r.SessionsRestored\n420\t\t\ttotalSkipped += r.SessionsSkipped\n421\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n422\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n423\t\t\t}\n424\t\t}\n425\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n426\t}\n427\t\n428\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n429\t//\n430\t// 支持的参数：\n431\t//   --verbose   显示文件级别的详细信息\n432\tfunc runSessionStatus(args []string) {\n433\t\tvar opts session.StatusOptions\n434\t\tfor i := 0; i < len(args); i++ {\n435\t\t\targ := args[i]\n436\t\t\tswitch {\n437\t\t\tcase arg == \"--verbose\":\n438\t\t\t\topts.Verbose = true\n439\t\t\t}\n440\t\t}\n441\t\n442\t\tif err := session.SessionStatus(opts); err != nil {\n443\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n444\t\t\tos.Exit(1)\n445\t\t}\n446\t}\n447\t\n448\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n449\t// 如果参数中包含空格或制表符，则使用引号包裹。\n450\tfunc formatArgs(args []string) string {\n451\t\tresult := \"\"\n452\t\tfor _, a := range args {\n453\t\t\tif containsSpace(a) {\n454\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n455\t\t\t} else {\n456\t\t\t\tresult += \" \" + a\n457\t\t\t}\n458\t\t}\n459\t\treturn strings.TrimSpace(result)\n460\t}\n461\t\n462\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n463\tfunc containsSpace(s string) bool {\n464\t\tfor _, c := range s {\n465\t\t\tif c == ' ' || c == '\\t' {\n466\t\t\t\treturn true\n467\t\t\t}\n468\t\t}\n469\t\treturn false\n470\t}\n471\t\n472\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n473\tfunc firstNonEmpty(ss ...string) string {\n474\t\tfor _, s := range ss {\n475\t\t\tif s != \"\" {\n476\t\t\t\treturn s\n477\t\t\t}\n478\t\t}\n479\t\treturn \"\"\n480\t}\n481\t\n482\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n483\t//\n484\t// 逻辑：\n485\t//  1. 复制原始参数\n486\t//  2. 移除已有的 --resume <old-id>（如果存在）\n487\t//  3. 追加 --resume <new-session-id>\n488\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n489\t\tfiltered := make([]string, 0, len(originalArgs))\n490\t\tskip := false\n491\t\tfor i, arg := range originalArgs {\n492\t\t\tif skip {\n493\t\t\t\tskip = false\n494\t\t\t\tcontinue\n495\t\t\t}\n496\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n497\t\t\t\tskip = true // 跳过 --resume 及其值\n498\t\t\t\tcontinue\n499\t\t\t}\n500\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n501\t\t\t\tcontinue // 跳过 --resume=id 形式\n502\t\t\t}\n503\t\t\tfiltered = append(filtered, arg)\n504\t\t}\n505\t\tfiltered = append(filtered, \"--resume\", sessionID)\n506\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n507\t}\n508\t\n509\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n510\tfunc shortenPath(path string) string {\n511\t\thome, err := os.UserHomeDir()\n512\t\tif err != nil {\n513\t\t\treturn path\n514\t\t}\n515\t\tif strings.HasPrefix(path, home) {\n516\t\t\treturn \"~\" + path[len(home):]\n517\t\t}\n518\t\treturn path\n519\t}\n520\t\n521\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n522\tfunc removeEnvVar(env []string, name string) []string {\n523\t\tprefix := name + \"=\"\n524\t\tresult := make([]string, 0, len(env))\n525\t\tfor _, e := range env {\n526\t\t\tif !strings.HasPrefix(e, prefix) {\n527\t\t\t\tresult = append(result, e)\n528\t\t\t}\n529\t\t}\n530\t\treturn result\n531\t}\n532\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\backend_cmd.go"},"tool_use_id":"call_ae8afc756edb4ee389bda99f","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"log\"\n6\t\t\"path/filepath\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n12\t)\n13\t\n14\t// runBackend 启动后端服务器模式。\n15\t//\n16\t// 支持的命令行参数：\n17\t//   --port, -p PORT    指定服务器监听端口（默认随机）\n18\t//   --db, -d PATH      指定数据库文件路径\n19\t//   --host HOST        指定服务器绑定地址\n20\tfunc runBackend(args []string) {\n21\t\t// 使用默认配置初始化后端服务器配置\n22\t\tcfg := backend.DefaultConfig()\n23\t\n24\t\t// 遍历命令行参数，解析并覆盖默认配置\n25\t\tfor i := 0; i < len(args); i++ {\n26\t\t\targ := args[i]\n27\t\t\tswitch {\n28\t\t\t// 解析 --port 或 -p 参数（空格分隔形式，如 --port 8080）\n29\t\t\tcase (arg == \"--port\" || arg == \"-p\") && i+1 < len(args):\n30\t\t\t\ti++\n31\t\t\t\tfmt.Sscanf(args[i], \"%d\", &cfg.Port)\n32\t\t\t// 解析 --port=PORT 形式（等号连接，如 --port=8080）\n33\t\t\tcase strings.HasPrefix(arg, \"--port=\"):\n34\t\t\t\tfmt.Sscanf(arg[len(\"--port=\"):], \"%d\", &cfg.Port)\n35\t\t\t// 解析 --db 或 -d 参数（空格分隔形式）\n36\t\t\tcase (arg == \"--db\" || arg == \"-d\") && i+1 < len(args):\n37\t\t\t\ti++\n38\t\t\t\tcfg.DBPath = args[i]\n39\t\t\t// 解析 --db=PATH 形式\n40\t\t\tcase strings.HasPrefix(arg, \"--db=\"):\n41\t\t\t\tcfg.DBPath = arg[len(\"--db=\"):]\n42\t\t\t// 解析 --host 参数（空格分隔形式）\n43\t\t\tcase arg == \"--host\" && i+1 < len(args):\n44\t\t\t\ti++\n45\t\t\t\tcfg.Host = args[i]\n46\t\t\t// 解析 --host=HOST 形式\n47\t\t\tcase strings.HasPrefix(arg, \"--host=\"):\n48\t\t\t\tcfg.Host = arg[len(\"--host=\"):]\n49\t\t\t}\n50\t\t}\n51\t\n52\t\t// 初始化文件日志器\n53\t\tlogDir := trace.DefaultTraceDir()\n54\t\tif cfg.DBPath != \"\" && cfg.DBPath != \"backend.db\" {\n55\t\t\tlogDir = filepath.Dir(cfg.DBPath)\n56\t\t}\n57\t\tif err := logger.Init(logDir, true, logger.DEBUG); err != nil {\n58\t\t\tlog.Printf(\"warning: logger init failed: %v\", err)\n59\t\t}\n60\t\tdefer logger.Close()\n61\t\tlogger.Info(\"backend.cmd\", \"backend starting: host=%s port=%d db=%s\", cfg.Host, cfg.Port, cfg.DBPath)\n62\t\n63\t\t// 根据配置创建后端服务器实例\n64\t\tsrv, err := backend.NewServer(cfg)\n65\t\tif err != nil {\n66\t\t\tlog.Fatalf(\"create server: %v\", err)\n67\t\t}\n68\t\t// 函数退出时确保关闭服务器资源\n69\t\tdefer srv.Close()\n70\t\n71\t\t// 启动服务器并开始监听请求\n72\t\tif err := srv.Start(); err != nil {\n73\t\t\tlog.Fatalf(\"server error: %v\", err)\n74\t\t}\n75\t}\n76\t"}]}
