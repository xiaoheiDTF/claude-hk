\t\t\tcase strings.HasPrefix(arg, \"--host=\"):\n45\t\t\t\tcfg.Host = arg[len(\"--host=\"):]\n46\t\t\t}\n47\t\t}\n48\t\n49\t\t// 根据配置创建后端服务器实例\n50\t\tsrv, err := backend.NewServer(cfg)\n51\t\tif err != nil {\n52\t\t\tlog.Fatalf(\"create server: %v\", err)\n53\t\t}\n54\t\t// 函数退出时确保关闭服务器资源\n55\t\tdefer srv.Close()\n56\t\n57\t\t// 启动服务器并开始监听请求\n58\t\tif err := srv.Start(); err != nil {\n59\t\t\tlog.Fatalf(\"server error: %v\", err)\n60\t\t}\n61\t}\n62\t"}]}
