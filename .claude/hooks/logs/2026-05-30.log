o\\\",\\\"issue_number\\\":700,\\\"session_id\\\":\\\"$sid_a\\\"}\")","   local success_idem"]},{"oldStart":278,"oldLines":9,"newStart":265,"newLines":9,"lines":["   return 0"," }"," ","-# --- Test 8: 后端可用时 claim 后状态为 claimed ---","+# --- Test 9: claim 后 status 为 claimed ---"," ","-test_claim_status_with_backend() {","+test_claim_sets_claimed_status() {","   local url=\"${1:-}\"","   if [ -z \"$url\" ]; then","     echo \"SKIP: no backend URL\""]},{"oldStart":294,"oldLines":13,"newStart":281,"newLines":9,"lines":["   local repo=\"test/b6_1\"","   local sid=\"sess_b6_1_status\""," ","-  # 确保 #800 存在","   _call_backend \"/api/issue/check\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_numbers\\\":[800]}\" > /dev/null","-","-  # Claim","   _call_backend \"/api/issue/claim\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_number\\\":800,\\\"session_id\\\":\\\"$sid\\\"}\" > /dev/null"," ","-  # Check status","   local check","   check=$(_call_backend \"/api/issue/check\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_numbers\\\":[800]}\")","   local status"]},{"oldStart":320,"oldLines":14,"newStart":303,"newLines":15,"lines":[" echo \"Project: $PROJECT_DIR\""," echo \"\""," ","-run_test \"filter_backend_down_returns_all\" test_filter_backend_down_returns_all","-run_test \"filter_no_conf_returns_all\" test_filter_no_conf_returns_all","-run_test \"claim_no_conf_returns_ok\" test_claim_no_conf_returns_ok","-run_test \"claim_backend_unreachable_blocks\" test_claim_backend_unreachable_blocks","+run_test \"backend_down_silent_fail\" test_backend_down_silent_fail","+run_test \"no_conf_load_fails\" test_no_conf_load_fails","+run_test \"backend_available_returns_false\" test_backend_available_returns_false"," run_test \"claimed_label_mapping\" test_claimed_label_mapping","-run_test \"filter_with_backend\" test_filter_with_backend","-run_test \"claim_atomic_with_backend\" test_claim_atomic_with_backend","-run_test \"claim_status_with_backend\" test_claim_status_with_backend","+run_test \"require_backend_unreachable\" test_require_backend_unreachable","+run_test \"require_backend_not_configured\" test_require_backend_not_configured","+run_test \"check_filters_non_idle\" test_check_filters_non_idle","+run_test \"claim_atomic\" test_claim_atomic","+run_test \"claim_sets_claimed_status\" test_claim_sets_claimed_status"," "," echo \"\""," echo \"================================\""]}],"originalFile":"#!/bin/bash\n# B6-1: 003-4-issue-claim 技能改造 — Shell 集成测试\n# 验收标准：\n#   1. 后端可用时，只展示空闲 issue（filter_claimed_issues 过滤非 idle）\n#   2. 后端可用时，领取操作是原子的（先锁后 gh）\n#   3. 后端可用时，领取成功后 GitHub 自动添加 in-progress label\n#   4. 后端不可用时，回退到原有行为\n#   5. 已被领取的 issue 不出现在列表中\nset -uo pipefail\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nPROJECT_DIR=\"$(cd \"$SCRIPT_DIR/../../..\" && pwd)\"\nBACKEND_SH=\"$PROJECT_DIR/.claude/skills/backend.sh\"\nBACKEND_CONF=\"$PROJECT_DIR/.claude/backend.conf\"\nCLAIM_SH=\"$PROJECT_DIR/.claude/skills/003-4-issue-claim/scripts/03UserPromptSubmit.sh\"\n\nexport CLAUDE_PROJECT_DIR=\"$PROJECT_DIR\"\nexport SKILL_TAG=\"b6_1-test\"\nskill_log() { :; }\nexport -f skill_log\n\nRED='\\033[0;31m'\nGREEN='\\033[0;32m'\nYELLOW='\\033[0;33m'\nNC='\\033[0m'\n\nTOTAL=0\nPASS=0\nFAIL=0\n\nORIG_CONF=\"\"\n[ -f \"$BACKEND_CONF\" ] && ORIG_CONF=$(cat \"$BACKEND_CONF\")\ncleanup() {\n  if [ -n \"$ORIG_CONF\" ]; then\n    echo \"$ORIG_CONF\" > \"$BACKEND_CONF\"\n  elif [ -f \"$BACKEND_CONF\" ]; then\n    rm -f \"$BACKEND_CONF\"\n  fi\n  [ -n \"${BACKEND_PID:-}\" ] && { kill \"$BACKEND_PID\" 2>/dev/null; wait \"$BACKEND_PID\" 2>/dev/null; }\n  [ -n \"${TEMP_DB:-}\" ] && rm -f \"$TEMP_DB\"\n}\ntrap cleanup EXIT\n\nrun_test() {\n  local name=\"$1\"; shift\n  TOTAL=$((TOTAL + 1))\n  echo \"\"\n  echo \"--- [$name] ---\"\n  if \"$@\"; then\n    PASS=$((PASS + 1))\n    echo -e \"${GREEN}PASS${NC}: $name\"\n  else\n    FAIL=$((FAIL + 1))\n    echo -e \"${RED}FAIL${NC}: $name\"\n  fi\n}\n\n# --- Test 1: 后端不可用时 filter_claimed_issues 返回原始列表 ---\n\ntest_filter_backend_down_returns_all() {\n  echo \"BACKEND_URL=http://127.0.0.1:19999\" > \"$BACKEND_CONF\"\n  BACKEND_URL=\"\"\n  source \"$BACKEND_SH\"\n\n  # source claim script to get filter_claimed_issues\n  source \"$CLAIM_SH\" 2>/dev/null || true\n\n  local issues='[{\"number\":1,\"title\":\"bug\"},{\"number\":2,\"title\":\"feat\"},{\"number\":3,\"title\":\"docs\"}]'\n  local result\n  result=$(filter_claimed_issues \"$issues\" 2>/dev/null)\n  local rc=$?\n\n  # backend down → _call_backend fails → should return original list\n  if [ \"$result\" != \"$issues\" ]; then\n    echo \"FAIL: expected original list, got: $result\"\n    return 1\n  fi\n\n  echo \"OK: filter returns original list when backend down\"\n  return 0\n}\n\n# --- Test 2: 未配置 backend.conf 时 filter_claimed_issues 返回原始列表 ---\n\ntest_filter_no_conf_returns_all() {\n  rm -f \"$BACKEND_CONF\"\n  BACKEND_URL=\"\"\n  source \"$BACKEND_SH\"\n  source \"$CLAIM_SH\" 2>/dev/null || true\n\n  local issues='[{\"number\":1,\"title\":\"bug\"},{\"number\":2,\"title\":\"feat\"}]'\n  local result\n  result=$(filter_claimed_issues \"$issues\" 2>/dev/null)\n\n  if [ \"$result\" != \"$issues\" ]; then\n    echo \"FAIL: expected original list, got: $result\"\n    return 1\n  fi\n\n  echo \"OK: filter returns original list without conf\"\n  return 0\n}\n\n# --- Test 3: 未配置 backend.conf 时 claim_issue_backend 返回 0（单 agent 模式）---\n\ntest_claim_no_conf_returns_ok() {\n  rm -f \"$BACKEND_CONF\"\n  BACKEND_URL=\"\"\n  source \"$BACKEND_SH\"\n  source \"$CLAIM_SH\" 2>/dev/null || true\n\n  # 无后端配置 → 返回 0（单 agent 模式，跳过后端 claim）\n  claim_issue_backend 10 \"test title\" 2>/dev/null\n  local rc=$?\n  if [ $rc -ne 0 ]; then\n    echo \"FAIL: expected return 0 without conf, got $rc\"\n    return 1\n  fi\n\n  echo \"OK: claim returns 0 without conf (single-agent mode)\"\n  return 0\n}\n\n# --- Test 4: 后端配置但不可达时 claim_issue_backend 返回 1（阻塞领取）---\n\ntest_claim_backend_unreachable_blocks() {\n  echo \"BACKEND_URL=http://127.0.0.1:19999\" > \"$BACKEND_CONF\"\n  BACKEND_URL=\"\"\n  source \"$BACKEND_SH\"\n  source \"$CLAIM_SH\" 2>/dev/null || true\n\n  local output\n  output=$(claim_issue_backend 10 \"test title\" 2>&1)\n  local rc=$?\n  if [ $rc -eq 0 ]; then\n    echo \"FAIL: expected non-zero return when backend unreachable\"\n    return 1\n  fi\n\n  # 应该包含错误信息\n  if [ -z \"$output\" ]; then\n    echo \"FAIL: expected error message but got empty output\"\n    return 1\n  fi\n\n  echo \"OK: claim blocks when backend configured but unreachable\"\n  return 0\n}\n\n# --- Test 5: _status_to_label(\"claimed\") 返回 \"in-progress\" ---\n\ntest_claimed_label_mapping() {\n  source \"$BACKEND_SH\"\n\n  local label\n  label=$(_status_to_label \"claimed\")\n  if [ \"$label\" != \"in-progress\" ]; then\n    echo \"FAIL: _status_to_label(claimed)='$label', expected 'in-progress'\"\n    return 1\n  fi\n\n  echo \"OK: _status_to_label(claimed) = in-progress\"\n  return 0\n}\n\n# --- Test 6: 后端可用时 filter_claimed_issues 只返回 idle issue ---\n\ntest_filter_with_backend() {\n  local url=\"${1:-}\"\n  if [ -z \"$url\" ]; then\n    echo \"SKIP: no backend URL\"\n    return 0\n  fi\n\n  echo \"BACKEND_URL=$url\" > \"$BACKEND_CONF\"\n  BACKEND_URL=\"\"\n  source \"$BACKEND_SH\"\n  source \"$CLAIM_SH\" 2>/dev/null || true\n\n  local repo=\"test/b6_1\"\n  local sid=\"sess_b6_1_filter\"\n\n  # 预置：#600 idle, #601 claimed, #602 fixing\n  _call_backend \"/api/issue/check\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_numbers\\\":[600,601,602]}\" > /dev/null\n  _call_backend \"/api/issue/claim\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_number\\\":601,\\\"session_id\\\":\\\"$sid\\\"}\" > /dev/null\n  # 手动更新 602 为 fixing\n  _call_backend \"/api/issue/status\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_number\\\":602,\\\"session_id\\\":\\\"$sid\\\",\\\"status\\\":\\\"fixing\\\"}\" > /dev/null\n  # 先 claim 602 才能 status\n  _call_backend \"/api/issue/claim\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_number\\\":602,\\\"session_id\\\":\\\"$sid\\\"}\" > /dev/null\n  _call_backend \"/api/issue/status\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_number\\\":602,\\\"session_id\\\":\\\"$sid\\\",\\\"status\\\":\\\"fixing\\\"}\" > /dev/null\n\n  # filter_claimed_issues 依赖 _get_repo 获取 repo，测试环境无 gh\n  # 直接验证 check API 返回正确的 status\n  local check\n  check=$(_call_backend \"/api/issue/check\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_numbers\\\":[600,601,602]}\")\n\n  local s600 s601 s602\n  s600=$(echo \"$check\" | jq -r '.issues[] | select(.number==600) | .status')\n  s601=$(echo \"$check\" | jq -r '.issues[] | select(.number==601) | .status')\n  s602=$(echo \"$check\" | jq -r '.issues[] | select(.number==602) | .status')\n\n  if [ \"$s600\" != \"idle\" ]; then\n    echo \"FAIL: #600 expected idle, got $s600\"\n    return 1\n  fi\n  if [ \"$s601\" != \"claimed\" ]; then\n    echo \"FAIL: #601 expected claimed, got $s601\"\n    return 1\n  fi\n  if [ \"$s602\" != \"fixing\" ]; then\n    echo \"FAIL: #602 expected fixing, got $s602\"\n    return 1\n  fi\n\n  echo \"OK: check API returns correct statuses (idle/claimed/fixing)\"\n  return 0\n}\n\n# --- Test 7: 后端可用时原子领取 ---\n\ntest_claim_atomic_with_backend() {\n  local url=\"${1:-}\"\n  if [ -z \"$url\" ]; then\n    echo \"SKIP: no backend URL\"\n    return 0\n  fi\n\n  echo \"BACKEND_URL=$url\" > \"$BACKEND_CONF\"\n  BACKEND_URL=\"\"\n  source \"$BACKEND_SH\"\n\n  local repo=\"test/b6_1\"\n  local sid_a=\"sess_b6_1_a\"\n  local sid_b=\"sess_b6_1_b\"\n\n  # 确保 #700 存在且为 idle\n  _call_backend \"/api/issue/check\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_numbers\\\":[700]}\" > /dev/null\n\n  # Session A claim → success\n  local result_a\n  result_a=$(_call_backend \"/api/issue/claim\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_number\\\":700,\\\"session_id\\\":\\\"$sid_a\\\"}\")\n  local success_a\n  success_a=$(echo \"$result_a\" | jq -r '.success')\n  if [ \"$success_a\" != \"true\" ]; then\n    echo \"FAIL: session A claim failed: $result_a\"\n    return 1\n  fi\n\n  # Session B claim → fail (already claimed)\n  local result_b\n  result_b=$(_call_backend \"/api/issue/claim\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_number\\\":700,\\\"session_id\\\":\\\"$sid_b\\\"}\")\n  local success_b\n  success_b=$(echo \"$result_b\" | jq -r '.success')\n  if [ \"$success_b\" != \"false\" ]; then\n    echo \"FAIL: session B should not claim: $result_b\"\n    return 1\n  fi\n\n  # 验证 claimed_by\n  local claimed_by\n  claimed_by=$(echo \"$result_b\" | jq -r '.claimed_by // empty')\n  if [ \"$claimed_by\" != \"$sid_a\" ]; then\n    echo \"FAIL: expected claimed_by=$sid_a, got $claimed_by\"\n    return 1\n  fi\n\n  # Session A 幂等领取 → success\n  local result_idem\n  result_idem=$(_call_backend \"/api/issue/claim\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_number\\\":700,\\\"session_id\\\":\\\"$sid_a\\\"}\")\n  local success_idem\n  success_idem=$(echo \"$result_idem\" | jq -r '.success')\n  if [ \"$success_idem\" != \"true\" ]; then\n    echo \"FAIL: idempotent claim should succeed: $result_idem\"\n    return 1\n  fi\n\n  echo \"OK: atomic claim works (A succeeds, B blocked, A idempotent)\"\n  return 0\n}\n\n# --- Test 8: 后端可用时 claim 后状态为 claimed ---\n\ntest_claim_status_with_backend() {\n  local url=\"${1:-}\"\n  if [ -z \"$url\" ]; then\n    echo \"SKIP: no backend URL\"\n    return 0\n  fi\n\n  echo \"BACKEND_URL=$url\" > \"$BACKEND_CONF\"\n  BACKEND_URL=\"\"\n  source \"$BACKEND_SH\"\n\n  local repo=\"test/b6_1\"\n  local sid=\"sess_b6_1_status\"\n\n  # 确保 #800 存在\n  _call_backend \"/api/issue/check\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_numbers\\\":[800]}\" > /dev/null\n\n  # Claim\n  _call_backend \"/api/issue/claim\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_number\\\":800,\\\"session_id\\\":\\\"$sid\\\"}\" > /dev/null\n\n  # Check status\n  local check\n  check=$(_call_backend \"/api/issue/check\" \"{\\\"repo_full_name\\\":\\\"$repo\\\",\\\"issue_numbers\\\":[800]}\")\n  local status\n  status=$(echo \"$check\" | jq -r '.issues[0].status')\n  if [ \"$status\" != \"claimed\" ]; then\n    echo \"FAIL: expected claimed, got $status\"\n    return 1\n  fi\n\n  echo \"OK: claim sets status to claimed\"\n  return 0\n}\n\n# --- Main ---\n\necho \"=== B6-1: 003-4-issue-claim 技能改造 — Shell 集成测试 ===\"\necho \"Project: $PROJECT_DIR\"\necho \"\"\n\nrun_test \"filter_backend_down_returns_all\" test_filter_backend_down_returns_all\nrun_test \"filter_no_conf_returns_all\" test_filter_no_conf_returns_all\nrun_test \"claim_no_conf_returns_ok\" test_claim_no_conf_returns_ok\nrun_test \"claim_backend_unreachable_blocks\" test_claim_backend_unreachable_blocks\nrun_test \"claimed_label_mapping\" test_claimed_label_mapping\nrun_test \"filter_with_backend\" test_filter_with_backend\nrun_test \"claim_atomic_with_backend\" test_claim_atomic_with_backend\nrun_test \"claim_status_with_backend\" test_claim_status_with_backend\n\necho \"\"\necho \"================================\"\necho \"Results: $PASS/$TOTAL passed, $FAIL failed\"\necho \"================================\"\n\n[ $FAIL -eq 0 ] || exit 1\n","userModified":false},"tool_use_id":"call_94dbab209d7d413cbea435ff","duration_ms":14}
