21\t\t\tif statuses[10] != \"testing\" {\n1222\t\t\t\tt.Errorf(\"expected testing, got %s\", statuses[10])\n1223\t\t\t}\n1224\t\t})\n1225\t\n1226\t\tt.Run(\"non_owner_cannot_mark_testing\", func(t *testing.T) {\n1227\t\t\tenv := setupTest(t)\n1228\t\t\tdb := env.store.DB()\n1229\t\t\tseedIssue(db, \"test/repo\", 10, \"pr-created\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1230\t\n1231\t\t\tresp := env.post(t, \"/api/issue/status\",\n1232\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"testing\"}`)\n1233\t\n1234\t\t\tvar result struct {\n1235\t\t\t\tSuccess bool   `json:\"success\"`\n1236\t\t\t\tError   string `json:\"error\"`\n1237\t\t\t}\n1238\t\t\treadJSON(t, resp, &result)\n1239\t\n1240\t\t\tif result.Success {\n1241\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n1242\t\t\t}\n1243\t\t\tif result.Error != \"not_owner\" {\n1244\t\t\t\tt.Errorf(\"expected not_owner, got %s\", result.Error)\n1245\t\t\t}\n1246\t\t})\n1247\t\n1248\t\tt.Run(\"full_flow_to_testing\", func(t *testing.T) {\n1249\t\t\t// 端到端：idle → claimed → fixing → ready-for-pr → pr-created → testing\n1250\t\t\tenv := setupTest(t)\n1251\t\n1252\t\t\tenv.post(t, \"/api/issue/check\",\n1253\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[50]}`)\n1254\t\n1255\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 50, \"sess_test\")\n1256\t\t\tif code != http.StatusOK || !ok {\n1257\t\t\t\tt.Fatalf(\"claim failed\")\n1258\t\t\t}\n1259\t\n1260\t\t\tenv.post(t, \"/api/issue/status\",\n1261\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"fixing\"}`)\n1262\t\t\tenv.post(t, \"/api/issue/status\",\n1263\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"ready-for-pr\"}`)\n1264\t\t\tenv.post(t, \"/api/issue/status\",\n1265\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"pr-created\"}`)\n1266\t\n1267\t\t\tresp := env.post(t, \"/api/issue/status\",\n1268\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":50,\"session_id\":\"sess_test\",\"status\":\"testing\"}`)\n1269\t\t\tvar result struct {\n1270\t\t\t\tSuccess        bool   `json:\"success\"`\n1271\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1272\t\t\t\tNewStatus      string `json:\"new_status\"`\n1273\t\t\t}\n1274\t\t\treadJSON(t, resp, &result)\n1275\t\t\tif !result.Success {\n1276\t\t\t\tt.Fatal(\"testing update failed\")\n1277\t\t\t}\n1278\t\t\tif result.PreviousStatus != \"pr-created\" {\n1279\t\t\t\tt.Errorf(\"expected previous=pr-created, got %s\", result.PreviousStatus)\n1280\t\t\t}\n1281\t\n1282\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{50})\n1283\t\t\tif s[50] != \"testing\" {\n1284\t\t\t\tt.Fatalf(\"expected testing, got %s\", s[50])\n1285\t\t\t}\n1286\t\t})\n1287\t}\n1288\t\n1289\t// --- D6: Issue Status Update → reviewing/merged/rejected tests ---\n1290\t// 验收标准：\n1291\t//   - testing → reviewing 状态更新成功\n1292\t//   - reviewing → merged 终态更新成功\n1293\t//   - reviewing → rejected 状态更新成功\n1294\t//   - merged 不被 session end 释放\n1295\t//   - rejected 不被 session end 释放\n1296\t//   - 完整流程：idle → ... → testing → reviewing → merged/rejected\n1297\t\n1298\tfunc TestUpdateStatus_Review(t *testing.T) {\n1299\t\tt.Run(\"testing_to_reviewing\", func(t *testing.T) {\n1300\t\t\tenv := setupTest(t)\n1301\t\t\tdb := env.store.DB()\n1302\t\t\tseedIssue(db, \"test/repo\", 10, \"testing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1303\t\n1304\t\t\tresp := env.post(t, \"/api/issue/status\",\n1305\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"reviewing\"}`)\n1306\t\n1307\t\t\tvar result struct {\n1308\t\t\t\tSuccess        bool   `json:\"success\"`\n1309\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1310\t\t\t\tNewStatus      string `json:\"new_status\"`\n1311\t\t\t}\n1312\t\t\treadJSON(t, resp, &result)\n1313\t\n1314\t\t\tif !result.Success {\n1315\t\t\t\tt.Fatalf(\"expected success=true, got error: %s\", result.NewStatus)\n1316\t\t\t}\n1317\t\t\tif result.PreviousStatus != \"testing\" {\n1318\t\t\t\tt.Errorf(\"expected previous=testing, got %s\", result.PreviousStatus)\n1319\t\t\t}\n1320\t\t\tif result.NewStatus != \"reviewing\" {\n1321\t\t\t\tt.Errorf(\"expected new=reviewing, got %s\", result.NewStatus)\n1322\t\t\t}\n1323\t\t})\n1324\t\n1325\t\tt.Run(\"reviewing_to_merged\", func(t *testing.T) {\n1326\t\t\tenv := setupTest(t)\n1327\t\t\tdb := env.store.DB()\n1328\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1329\t\n1330\t\t\tresp := env.post(t, \"/api/issue/status\",\n1331\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"merged\"}`)\n1332\t\n1333\t\t\tvar result struct {\n1334\t\t\t\tSuccess        bool   `json:\"success\"`\n1335\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n1336\t\t\t\tNewStatus      string `json:\"new_status\"`\n1337\t\t\t}\n1338\t\t\treadJSON(t, resp, &result)\n1339\t\n1340\t\t\tif !result.Success {\n1341\t\t\t\tt.Fatal(\"expected success=true\")\n1342\t\t\t}\n1343\t\t\tif result.PreviousStatus != \"reviewing\" {\n1344\t\t\t\tt.Errorf(\"expected previous=reviewing, got %s\", result.PreviousStatus)\n1345\t\t\t}\n1346\t\t\tif result.NewStatus != \"merged\" {\n1347\t\t\t\tt.Errorf(\"expected new=merged, got %s\", result.NewStatus)\n1348\t\t\t}\n1349\t\t})\n1350\t\n1351\t\tt.Run(\"reviewing_to_rejected\", func(t *testing.T) {\n1352\t\t\tenv := setupTest(t)\n1353\t\t\tdb := env.store.DB()\n1354\t\t\tseedIssue(db, \"test/repo\", 10, \"reviewing\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n1355\t\n1356\t\t\tresp := env.post(t, \"/api/issue/status\",\n1357\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"rejected\"}`)\n1358\t\n1359\t\t\tvar result struct {\n1360\t\t\t\tSuccess    