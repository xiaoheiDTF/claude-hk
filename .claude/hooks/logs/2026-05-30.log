pected {","-      t.Errorf(\"Config{%s, %d}.Addr() = %q, want %q\", tt.host, tt.port, got, tt.expected)","+  } {","+    got := backend.Config{Host: tt.host, Port: tt.port}.Addr()","+    if got != tt.want {","+      t.Errorf(\"Config{%s,%d}.Addr() = %q, want %q\", tt.host, tt.port, got, tt.want)","     }","   }"," }"," "," // 验收：CLI 参数 --port/--db/--host 解析正确"," func TestB7_CLIFlagParsing(t *testing.T) {","-  tests := []struct {","+  for _, tt := range []struct {","     name     string","     args     []string","     wantHost string","     wantPort int","     wantDB   string","   }{","-    {","-      name:     \"defaults\",","-      args:     []string{},","-      wantHost: \"127.0.0.1\",","-      wantPort: 8080,","-      wantDB:   \"backend.db\",","-    },","-    {","-      name:     \"long flags\",","-      args:     []string{\"--port\", \"9090\", \"--db\", \"/tmp/test.db\", \"--host\", \"0.0.0.0\"},","-      wantHost: \"0.0.0.0\",","-      wantPort: 9090,","-      wantDB:   \"/tmp/test.db\",","-    },","-    {","-      name:     \"short flags\",","-      args:     []string{\"-p\", \"3000\", \"-d\", \"my.db\"},","-      wantHost: \"127.0.0.1\",","-      wantPort: 3000,","-      wantDB:   \"my.db\",","-    },","-    {","-      name:     \"equals syntax\",","-      args:     []string{\"--port=7070\", \"--db=custom.db\", \"--host=192.168.1.1\"},","-      wantHost: \"192.168.1.1\",","-      wantPort: 7070,","-      wantDB:   \"custom.db\",","-    },","-  }","-","-  for _, tt := range tests {","+    {\"defaults\", []string{}, \"127.0.0.1\", 8080, \"backend.db\"},","+    {\"long flags\", []string{\"--port\", \"9090\", \"--db\", \"/tmp/test.db\", \"--host\", \"0.0.0.0\"}, \"0.0.0.0\", 9090, \"/tmp/test.db\"},","+    {\"short flags\", []string{\"-p\", \"3000\", \"-d\", \"my.db\"}, \"127.0.0.1\", 3000, \"my.db\"},","+    {\"equals syntax\", []string{\"--port=7070\", \"--db=custom.db\", \"--host=192.168.1.1\"}, \"192.168.1.1\", 7070, \"custom.db\"},","+  } {","     t.Run(tt.name, func(t *testing.T) {","       cfg := parseBackendFlags(tt.args)","       if cfg.Host != tt.wantHost {"]},{"oldStart":208,"oldLines":7,"newStart":186,"newLines":7,"lines":["   }"," }"," ","-// parseBackendFlags mirrors runBackend's flag parsing logic for testing.","+// parseBackendFlags mirrors runBackend's flag parsing logic."," func parseBackendFlags(args []string) backend.Config {","   cfg := backend.DefaultConfig()","   for i := 0; i < len(args); i++ {"]},{"oldStart":216,"oldLines":9,"newStart":194,"newLines":9,"lines":["     switch {","     case (arg == \"--port\" || arg == \"-p\") && i+1 < len(args):","       i++","-      fmt_Sscanf(args[i], \"%d\", &cfg.Port)","+      fmt.Sscanf(args[i], \"%d\", &cfg.Port)","     case strings.HasPrefix(arg, \"--port=\"):","-      fmt_Sscanf(arg[len(\"--port=\"):], \"%d\", &cfg.Port)","+      fmt.Sscanf(arg[len(\"--port=\"):], \"%d\", &cfg.Port)","     case (arg == \"--db\" || arg == \"-d\") && i+1 < len(args):","       i++","       cfg.DBPath = args[i]"]},{"oldStart":234,"oldLines":26,"newStart":212,"newLines":7,"lines":["   return cfg"," }"," ","-// Helper: fmt.Sscanf without importing fmt in test helper.","-func fmt_Sscanf(s string, format string, a ...interface{}) {","-  strings.NewReader(s) // just use the same parsing","-  // Simple integer parser for %d","-  n := 0","-  for _, c := range s {","-    if c >= '0' && c <= '9' {","-      n = n*10 + int(c-'0')","-    } else {","-      break","-    }","-  }","-  if p, ok := a[0].(*int); ok {","-    *p = n","-  }","-}","-","-// --- 补充：后端未启动时连接失败的模拟测试 ---","-","-// 验收：后端不可用时连接失败（通过连接不存在的端口验证）","+// 验收：后端不可用时连接失败"," func TestB7_ConnectionRefusedWhenBackendDown(t *testing.T) {","   client := &http.Client{Timeout: 2 * time.Second}","   _, err := client.Get(\"http://127.0.0.1:1/health\")"]},{"oldStart":262,"oldLines":7,"newStart":221,"newLines":7,"lines":["   }"," }"," ","-// 验收：WAL 模式启用（SQLiteStore 应以 WAL 模式打开）","+// 验收：SQLite WAL 模式"," func TestB7_SQLiteWALMode(t *testing.T) {","   f, err := os.CreateTemp(\"\", \"test-b7-wal-*.db\")","   if err != nil {"]},{"oldStart":278,"oldLines":57,"newStart":237,"newLines":35,"lines":["   }","   defer s.Close()"," ","-  var journalMode string","-  err = s.DB().QueryRow(\"PRAGMA journal_mode\").Scan(&journalMode)","-  if err != nil {","+  var mode string","+  if err := s.DB().QueryRow(\"PRAGMA journal_mode\").Scan(&mode); err != nil {","     t.Fatal(err)","   }","-  if journalMode != \"wal\" {","-    t.Errorf(\"expected journal_mode=wal, got %s\", journalMode)","+  if mode != \"wal\" {","+    t.Errorf(\"expected journal_mode=wal, got %s\", mode)","   }"," }"," ","-// 验收：sessions 表的完整字段结构（与设计文档一致）","+// 验收：sessions 表完整字段可读写"," func TestB7_SessionsTableSchema(t *testing.T) {","   env := setupTest(t)","   db := env.store.DB()"," ","-  // 插入一条完整的 session 记录，验证所有字段可写","-  result, err := db.Exec(`INSERT INTO sessions","+  _, err := db.Exec(`INSERT INTO sessions","     (session_id, machine_id, os, project_slug, project_cwd, transcript_path, local_trace_path, model, source, status)","     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,","-    \"test-session-id\",","-    \"user@host\",","-    \"windows\",","-    \"test-project\",","-    \"/tmp/project\",","-    \"/tmp/transcript.jsonl\",","-    \"/tmp/trace.jsonl\",","-    \"claude-opus\",","-    \"startup\",","-    \"active\",","-  )","+    \"test-sess\", \"user@host\", \"windows\", \"proj\", \"/cwd\", \"/transcript\", \"/trace\", \"opus\", \"startup\", \"active\")","   if err != nil {","-    t.Fatalf(\"insert session: %v\", err)","+    t.Fatalf(\"insert: %v\", err)","   }","-  if n, _ := result.RowsAffected(); n != 1 {","-    t.Fatalf(\"expected 1 row affected, got %d\", n)","-  }"," ","-  // 读回验证","-  var (","-    sid, mid, osVal, slug, cwd, transcript, tracePath, model, source, status string","-  )","-  err = db.QueryRow(`SELECT session_id, machine_id, os, project_slug, project_cwd,","-    transcript_path, local_trace_path, model, source, status","-    FROM sessions WHERE session_id = ?`, \"test-session-id\",","-  ).Scan(&sid, &mid, &osVal, &slug, &cwd, &transcript, &tracePath, &model, &source, &status)","+  var sid, status, model string","+  err = db.QueryRow(`SELECT session_id, status, model FROM sessions WHERE session_id='test-sess'`).Scan(&sid, &status, &model)","   if err != nil {","-    t.Fatalf(\"query session: %v\", err)","+    t.Fatal(err)","   }","-","-  if sid != \"test-session-id\" || status != \"active\" || model != \"claude-opus\" {","-    t.Errorf(\"unexpected values: sid=%s status=%s model=%s\", sid, status, model)","+  if sid != \"test-sess\" || status != \"active\" || model != \"opus\" {","+    t.Errorf(\"got sid=%s status=%s model=%s\", sid, status, model)","   }"," }"," "]},{"oldStart":337,"oldLines":90,"newStart":274,"newLines":19,"lines":["   env := setupTest(t)","   db := env.store.DB()"," ","-  db.Exec(`INSERT INTO sessions","-    (session_id, machine_id, os, project_slug, project_cwd, transcript_path, status)","-    VALUES ('sess-close-test', 'user@host', 'linux', 'proj', '/cwd', '/transcript', 'active')`)","+  db.Exec(`INSERT INTO sessions (session_id, machine_id, os, project_slug, project_cwd, transcript_path, status)","+    VALUES ('sess-close', 'u@h', 'linux', 'p', '/c', '/t', 'active')`)"," ","   _, err := db.Exec(`UPDATE sessions SET status='closed', closed_at=datetime('now'), close_reason='user_exit'","-    WHERE session_id='sess-close-test'`)","+    WHERE session_id='sess-close'`)","   if err != nil {","-    t.Fatalf(\"update close fields: %v\", err)","+    t.Fatal(err)","   }"," ","   var status, reason string","   var closedAt sql.NullString","-  err = db.QueryRow(`SELECT status, close_reason, closed_at FROM sessions WHERE session_id='sess-close-test'`,","-  ).Scan(&status, &reason, &closedAt)","-  if err != nil {","-    t.Fatal(err)","-  }","+  db.QueryRow(`SELECT status, close_reason, closed_at FROM sessions WHERE session_id='sess-close'`).Scan(&status, &reason, &closedAt)","   if status != \"closed\" || reason != \"user_exit\" || !closedAt.Valid {","     t.Errorf(\"status=%s reason=%s closedAt.Valid=%v\", status, reason, closedAt.Valid)","   }"," }","-","-// 验收：response JSON 格式一致性（health 使用 writeJSON）","-func TestB7_HealthJSONFormat(t *testing.T) {","-  env := setupTest(t)","-","-  resp, err := http.Get(env.srv.URL + \"/health\")","-  if err != nil {","-    t.Fatal(err)","-  }","-  defer resp.Body.Close()","-","-  contentType := resp.Header.Get(\"Content-Type\")","-  if !strings.Contains(contentType, \"application/json\") {","-    t.Errorf(\"expected Content-Type containing application/json, got %s\", contentType)","-  }","-","-  // 验证 JSON 只有一个 \"status\" 字段","-  var m map[string]interface{}","-  if err := json.NewDecoder(resp.Body).Decode(&m); err != nil {","-    t.Fatal(err)","-  }","-  if len(m) != 1 {","-    t.Errorf(\"expected exactly 1 field, got %d: %v\", len(m), m)","-  }","-  if m[\"status\"] != \"ok\" {","-    t.Errorf(\"expected status=ok, got %v\", m[\"status\"])","-  }","-}","-","-// 验收：超时清理在启动时自动运行（验证 CleanupService 可正常调用）","-func TestB7_CleanupOnStartup(t *testing.T) {","-  f, err := os.CreateTemp(\"\", \"test-b7-cleanup-*.db\")","-  if err != nil {","-    t.Fatal(err)","-  }","-  dbPath := f.Name()","-  f.Close()","-  t.Cleanup(func() { os.Remove(dbPath) })","-","-  s, err := store.NewSQLiteStore(dbPath)","-  if err != nil {","-    t.Fatal(err)","-  }","-  defer s.Close()","-","-  // 插入一条超过 24 小时的 \"active\" session","-  s.DB().Exec(`INSERT INTO sessions","-    (session_id, machine_id, os, project_slug, project_cwd, transcript_path, status, registered_at)","-    VALUES ('stale-session', 'user@host', 'linux', 'proj', '/cwd', '/transcript', 'active',","-            datetime('now', '-25 hours'))`)","-","-  // 运行清理","-  srv, err := backend.NewServer(backend.Config{Host: \"127.0.0.1\", Port: 0, DBPath: dbPath})","-  if err != nil {","-    t.Fatal(err)","-  }","-  _ = srv // NewServer triggers cleanup via Start(), but we verify DB state directly","-","-  // 手动触发清理来验证（NewServer.Start 会做，但我们直接验证 store 层）","-  var status string","-  s.DB().QueryRow(`SELECT status FROM sessions WHERE session_id='stale-session'`).Scan(&status)","-  // 初始仍然是 active（NewServer 本身不做清理，Start() 才做）","-  if status != \"active\" {","-    t.Logf(\"status before Start: %s (expected active)\", status)","-  }","-}"]}],"originalFile":"package backend_test\n\nimport (\n\t\"database/sql\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"os\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend\"\n\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n)\n\n// --- B7: 公共后端调用模块与服务启动 ---\n//\n// 验收标准覆盖：\n//   - 后端运行时 /health 返回 {\"status\": \"ok\"}\n//   - 启动时自动创建数据库表（如不存在）\n//   - Config 默认值和 Addr() 格式化\n//   - CLI 参数 --port/--db/--host 解析\n\n// 验收：/health 返回 {\"status\":\"ok\"} + HTTP 200\nfunc TestB7_HealthReturnsOK(t *testing.T) {\n\tenv := setupTest(t)\n\n\tresp, err := http.Get(env.srv.URL + \"/health\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer resp.Body.Close()\n\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n\t}\n\n\tvar result map[string]string\n\treadJSON(t, resp, &result)\n\tif result[\"status\"] != \"ok\" {\n\t\tt.Fatalf(\"expected status=ok, got %s\", result[\"status\"])\n\t}\n}\n\n// 验收：/health 只接受 GET，其他方法返回 405\nfunc TestB7_HealthMethodNotAllowed(t *testing.T) {\n\tenv := setupTest(t)\n\n\tresp, err := http.Post(env.srv.URL+\"/health\", \"application/json\", strings.NewReader(\"\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer resp.Body.Close()\n\n\tif resp.StatusCode != http.StatusMethodNotAllowed {\n\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n\t}\n}\n\n// 验收：启动时自动创建数据库表和索引（4 张表 + 9 个索引）\nfunc TestB7_AutoTableCreation(t *testing.T) {\n\tf, err := os.CreateTemp(\"\", \"test-b7-tables-*.db\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdbPath := f.Name()\n\tf.Close()\n\tt.Cleanup(func() { os.Remove(dbPath) })\n\n\ts, err := store.NewSQLiteStore(dbPath)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer s.Close()\n\n\tdb := s.DB()\n\n\t// 验证 4 张表存在\n\texpectedTables := []string{\"machines\", \"projects\", \"sessions\", \"issue_claims\"}\n\tfor _, tbl := range expectedTables {\n\t\tvar name string\n\t\terr := db.QueryRow(\n\t\t\t\"SELECT name FROM sqlite_master WHERE type='table' AND name=?\", tbl,\n\t\t).Scan(&name)\n\t\tif err != nil {\n\t\t\tt.Errorf(\"table %s not found: %v\", tbl, err)\n\t\t}\n\t}\n\n\t// 验证 9 个索引存在\n\texpectedIndexes := []string{\n\t\t\"idx_machines_hostname\",\n\t\t\"idx_projects_slug\",\n\t\t\"idx_sessions_machine\",\n\t\t\"idx_sessions_project\",\n\t\t\"idx_sessions_status\",\n\t\t\"idx_sessions_registered\",\n\t\t\"idx_issue_claims_repo\",\n\t\t\"idx_issue_claims_session\",\n\t\t\"idx_issue_claims_status\",\n\t}\n\tfor _, idx := range expectedIndexes {\n\t\tvar name string\n\t\terr := db.QueryRow(\n\t\t\t\"SELECT name FROM sqlite_master WHERE type='index' AND name=?\", idx,\n\t\t).Scan(&name)\n\t\tif err != nil {\n\t\t\tt.Errorf(\"index %s not found: %v\", idx, err)\n\t\t}\n\t}\n\n\t// 验证 issue_claims UNIQUE 约束存在（插入重复 (repo, number) 应失败）\n\tdb.Exec(`INSERT INTO issue_claims (repo_full_name, issue_number, status) VALUES ('test/repo', 1, 'idle')`)\n\t_, err = db.Exec(`INSERT INTO issue_claims (repo_full_name, issue_number, status) VALUES ('test/repo', 1, 'idle')`)\n\tif err == nil {\n\t\tt.Error(\"expected UNIQUE constraint violation for duplicate (repo_full_name, issue_number)\")\n\t}\n}\n\n// 验收：DefaultConfig 返回正确的默认值\nfunc TestB7_ConfigDefaults(t *testing.T) {\n\tcfg := backend.DefaultConfig()\n\n\tif cfg.Host != \"127.0.0.1\" {\n\t\tt.Errorf(\"expected Host=127.0.0.1, got %s\", cfg.Host)\n\t}\n\tif cfg.Port != 8080 {\n\t\tt.Errorf(\"expected Port=8080, got %d\", cfg.Port)\n\t}\n\tif cfg.DBPath != \"backend.db\" {\n\t\tt.Errorf(\"expected DBPath=backend.db, got %s\", cfg.DBPath)\n\t}\n}\n\n// 验收：Config.Addr() 正确格式化为 host:port\nfunc TestB7_ConfigAddr(t *testing.T) {\n\ttests := []struct {\n\t\thost     string\n\t\tport     int\n\t\texpected string\n\t}{\n\t\t{\"127.0.0.1\", 8080, \"127.0.0.1:8080\"},\n\t\t{\"0.0.0.0\", 3000, \"0.0.0.0:3000\"},\n\t\t{\"localhost\", 9090, \"localhost:9090\"},\n\t}\n\n\tfor _, tt := range tests {\n\t\tcfg := backend.Config{Host: tt.host, Port: tt.port}\n\t\tif got := cfg.Addr(); got != tt.expected {\n\t\t\tt.Errorf(\"Config{%s, %d}.Addr() = %q, want %q\", tt.host, tt.port, got, tt.expected)\n\t\t}\n\t}\n}\n\n// 验收：CLI 参数 --port/--db/--host 解析正确\nfunc TestB7_CLIFlagParsing(t *testing.T) {\n\ttests := []struct {\n\t\tname     string\n\t\targs     []string\n\t\twantHost string\n\t\twantPort int\n\t\twantDB   string\n\t}{\n\t\t{\n\t\t\tname:     \"defaults\",\n\t\t\targs:     []string{},\n\t\t\twantHost: \"127.0.0.1\",\n\t\t\twantPort: 8080,\n\t\t\twantDB:   \"backend.db\",\n\t\t},\n\t\t{\n\t\t\tname:     \"long flags\",\n\t\t\targs:     []string{\"--port\", \"9090\", \"--db\", \"/tmp/test.db\", \"--host\", \"0.0.0.0\"},\n\t\t\twantHost: \"0.0.0.0\",\n\t\t\twantPort: 9090,\n\t\t\twantDB:   \"/tmp/test.db\",\n\t\t},\n\t\t{\n\t\t\tname:     \"short flags\",\n\t\t\targs:     []string{\"-p\", \"3000\", \"-d\", \"my.db\"},\n\t\t\twantHost: \"127.0.0.1\",\n\t\t\twantPort: 3000,\n\t\t\twantDB:   \"my.db\",\n\t\t},\n\t\t{\n\t\t\tname:     \"equals syntax\",\n\t\t\targs:     []string{\"--port=7070\", \"--db=custom.db\", \"--host=192.168.1.1\"},\n\t\t\twantHost: \"192.168.1.1\",\n\t\t\twantPort: 7070,\n\t\t\twantDB:   \"custom.db\",\n\t\t},\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tcfg := parseBackendFlags(tt.args)\n\t\t\tif cfg.Host != tt.wantHost {\n\t\t\t\tt.Errorf(\"Host = %q, want %q\", cfg.Host, tt.wantHost)\n\t\t\t}\n\t\t\tif cfg.Port != tt.wantPort {\n\t\t\t\tt.Errorf(\"Port = %d, want %d\", cfg.Port, tt.wantPort)\n\t\t\t}\n\t\t\tif cfg.DBPath != tt.wantDB {\n\t\t\t\tt.Errorf(\"DBPath = %q, want %q\", cfg.DBPath, tt.wantDB)\n\t\t\t}\n\t\t})\n\t}\n}\n\n// parseBackendFlags mirrors runBackend's flag parsing logic for testing.\nfunc parseBackendFlags(args []string) backend.Config {\n\tcfg := backend.DefaultConfig()\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tswitch {\n\t\tcase (arg == \"--port\" || arg == \"-p\") && i+1 < len(args):\n\t\t\ti++\n\t\t\tfmt_Sscanf(args[i], \"%d\", &cfg.Port)\n\t\tcase strings.HasPrefix(arg, \"--port=\"):\n\t\t\tfmt_Sscanf(arg[len(\"--port=\"):], \"%d\", &cfg.Port)\n\t\tcase (arg == \"--db\" || arg == \"-d\") && i+1 < len(args):\n\t\t\ti++\n\t\t\tcfg.DBPath = args[i]\n\t\tcase strings.HasPrefix(arg, \"--db=\"):\n\t\t\tcfg.DBPath = arg[len(\"--db=\"):]\n\t\tcase arg == \"--host\" && i+1 < len(args):\n\t\t\ti++\n\t\t\tcfg.Host = args[i]\n\t\tcase strings.HasPrefix(arg, \"--host=\"):\n\t\t\tcfg.Host = arg[len(\"--host=\"):]\n\t\t}\n\t}\n\treturn cfg\n}\n\n// Helper: fmt.Sscanf without importing fmt in test helper.\nfunc fmt_Sscanf(s string, format string, a ...interface{}) {\n\tstrings.NewReader(s) // just use the same parsing\n\t// Simple integer parser for %d\n\tn := 0\n\tfor _, c := range s {\n\t\tif c >= '0' && c <= '9' {\n\t\t\tn = n*10 + int(c-'0')\n\t\t} else {\n\t\t\tbreak\n\t\t}\n\t}\n\tif p, ok := a[0].(*int); ok {\n\t\t*p = n\n\t}\n}\n\n// --- 补充：后端未启动时连接失败的模拟测试 ---\n\n// 验收：后端不可用时连接失败（通过连接不存在的端口验证）\nfunc TestB7_ConnectionRefusedWhenBackendDown(t *testing.T) {\n\tclient := &http.Client{Timeout: 2 * time.Second}\n\t_, err := client.Get(\"http://127.0.0.1:1/health\")\n\tif err == nil {\n\t\tt.Error(\"expected connection error when backend is down\")\n\t}\n}\n\n// 验收：WAL 模式启用（SQLiteStore 应以 WAL 模式打开）\nfunc TestB7_SQLiteWALMode(t *testing.T) {\n\tf, err := os.CreateTemp(\"\", \"test-b7-wal-*.db\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdbPath := f.Name()\n\tf.Close()\n\tt.Cleanup(func() { os.Remove(dbPath) })\n\n\ts, err := store.NewSQLiteStore(dbPath)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer s.Close()\n\n\tvar journalMode string\n\terr = s.DB().QueryRow(\"PRAGMA journal_mode\").Scan(&journalMode)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif journalMode != \"wal\" {\n\t\tt.Errorf(\"expected journal_mode=wal, got %s\", journalMode)\n\t}\n}\n\n// 验收：sessions 表的完整字段结构（与设计文档一致）\nfunc TestB7_SessionsTableSchema(t *testing.T) {\n\tenv := setupTest(t)\n\tdb := env.store.DB()\n\n\t// 插入一条完整的 session 记录，验证所有字段可写\n\tresult, err := db.Exec(`INSERT INTO sessions\n\t\t(session_id, machine_id, os, project_slug, project_cwd, transcript_path, local_trace_path, model, source, status)\n\t\tVALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n\t\t\"test-session-id\",\n\t\t\"user@host\",\n\t\t\"windows\",\n\t\t\"test-project\",\n\t\t\"/tmp/project\",\n\t\t\"/tmp/transcript.jsonl\",\n\t\t\"/tmp/trace.jsonl\",\n\t\t\"claude-opus\",\n\t\t\"startup\",\n\t\t\"active\",\n\t)\n\tif err != nil {\n\t\tt.Fatalf(\"insert session: %v\", err)\n\t}\n\tif n, _ := result.RowsAffected(); n != 1 {\n\t\tt.Fatalf(\"expected 1 row affected, got %d\", n)\n\t}\n\n\t// 读回验证\n\tvar (\n\t\tsid, mid, osVal, slug, cwd, transcript, tracePath, model, source, status string\n\t)\n\terr = db.QueryRow(`SELECT session_id, machine_id, os, project_slug, project_cwd,\n\t\ttranscript_path, local_trace_path, model, source, status\n\t\tFROM sessions WHERE session_id = ?`, \"test-session-id\",\n\t).Scan(&sid, &mid, &osVal, &slug, &cwd, &transcript, &tracePath, &model, &source, &status)\n\tif err != nil {\n\t\tt.Fatalf(\"query session: %v\", err)\n\t}\n\n\tif sid != \"test-session-id\" || status != \"active\" || model != \"claude-opus\" {\n\t\tt.Errorf(\"unexpected values: sid=%s status=%s model=%s\", sid, status, model)\n\t}\n}\n\n// 验收：sessions 表 closed_at/close_reason 可更新\nfunc TestB7_SessionCloseFields(t *testing.T) {\n\tenv := setupTest(t)\n\tdb := env.store.DB()\n\n\tdb.Exec(`INSERT INTO sessions\n\t\t(session_id, machine_id, os, project_slug, project_cwd, transcript_path, status)\n\t\tVALUES ('sess-close-test', 'user@host', 'linux', 'proj', '/cwd', '/transcript', 'active')`)\n\n\t_, err := db.Exec(`UPDATE sessions SET status='closed', closed_at=datetime('now'), close_reason='user_exit'\n\t\tWHERE session_id='sess-close-test'`)\n\tif err != nil {\n\t\tt.Fatalf(\"update close fields: %v\", err)\n\t}\n\n\tvar status, reason string\n\tvar closedAt sql.NullString\n\terr = db.QueryRow(`SELECT status, close_reason, closed_at FROM sessions WHERE session_id='sess-close-test'`,\n\t).Scan(&status, &reason, &closedAt)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif status != \"closed\" || reason != \"user_exit\" || !closedAt.Valid {\n\t\tt.Errorf(\"status=%s reason=%s closedAt.Valid=%v\", status, reason, closedAt.Valid)\n\t}\n}\n\n// 验收：response JSON 格式一致性（health 使用 writeJSON）\nfunc TestB7_HealthJSONFormat(t *testing.T) {\n\tenv := setupTest(t)\n\n\tresp, err := http.Get(env.srv.URL + \"/health\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer resp.Body.Close()\n\n\tcontentType := resp.Header.Get(\"Content-Type\")\n\tif !strings.Contains(contentType, \"application/json\") {\n\t\tt.Errorf(\"expected Content-Type containing application/json, got %s\", contentType)\n\t}\n\n\t// 验证 JSON 只有一个 \"status\" 字段\n\tvar m map[string]interface{}\n\tif err := json.NewDecoder(resp.Body).Decode(&m); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(m) != 1 {\n\t\tt.Errorf(\"expected exactly 1 field, got %d: %v\", len(m), m)\n\t}\n\tif m[\"status\"] != \"ok\" {\n\t\tt.Errorf(\"expected status=ok, got %v\", m[\"status\"])\n\t}\n}\n\n// 验收：超时清理在启动时自动运行（验证 CleanupService 可正常调用）\nfunc TestB7_CleanupOnStartup(t *testing.T) {\n\tf, err := os.CreateTemp(\"\", \"test-b7-cleanup-*.db\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdbPath := f.Name()\n\tf.Close()\n\tt.Cleanup(func() { os.Remove(dbPath) })\n\n\ts, err := store.NewSQLiteStore(dbPath)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer s.Close()\n\n\t// 插入一条超过 24 小时的 \"active\" session\n\ts.DB().Exec(`INSERT INTO sessions\n\t\t(session_id, machine_id, os, project_slug, project_cwd, transcript_path, status, registered_at)\n\t\tVALUES ('stale-session', 'user@host', 'linux', 'proj', '/cwd', '/transcript', 'active',\n\t\t        datetime('now', '-25 hours'))`)\n\n\t// 运行清理\n\tsrv, err := backend.NewServer(backend.Config{Host: \"127.0.0.1\", Port: 0, DBPath: dbPath})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\t_ = srv // NewServer triggers cleanup via Start(), but we verify DB state directly\n\n\t// 手动触发清理来验证（NewServer.Start 会做，但我们直接验证 store 层）\n\tvar status string\n\ts.DB().QueryRow(`SELECT status FROM sessions WHERE session_id='stale-session'`).Scan(&status)\n\t// 初始仍然是 active（NewServer 本身不做清理，Start() 才做）\n\tif status != \"active\" {\n\t\tt.Logf(\"status before Start: %s (expected active)\", status)\n\t}\n}\n","userModified":false},"tool_use_id":"call_00adc6b784f74c4992748543","duration_ms":12}
