\t\tcleanupSvc.CleanupTimedOutSessions(context.Background())\n41\t\tlogger.Info(\"backend\", \"startup cleanup done\")\n42\t\n43\t\t// 初始化业务服务和处理器\n44\t\tissueSvc := service.NewIssueService(s.store.Issues())\n45\t\tsessionSvc := service.NewSessionService(s.store.Sessions())\n46\t\n47\t\trouter := api.NewRouter(api.Handlers{\n48\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n49\t\t\tSession: api.NewSessionHandler(sessionSvc),\n50\t\t})\n51\t\n52\t\t// 创建 HTTP 服务器\n53\t\tsrv := &http.Server{\n54\t\t\tAddr:    s.cfg.Addr(),\n55\t\t\tHandler: router,\n56\t\t}\n57\t\n58\t\t// 监听系统信号以实现优雅关闭\n59\t\tquit := make(chan os.Signal, 1)\n60\t\tsignal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)\n61\t\n62\t\tgo func() {\n63\t\t\t<-quit\n64\t\t\tlogger.Info(\"backend\", \"shutdown signal received\")\n65\t\t\tsrv.Shutdown(context.Background())\n66\t\t}()\n67\t\n68\t\tlogger.Info(\"backend\", \"backend listening on %s\", s.cfg.Addr())\n69\t\tif err := srv.ListenAndServe(); err != http.ErrServerClosed {\n70\t\t\treturn err\n71\t\t}\n72\t\treturn nil\n73\t}\n74\t\n75\t// Close 关闭后端服务器及其数据库连接。\n76\tfunc (s *Server) Close() error {\n77\t\terr := s.store.Close()\n78\t\tlogger.Info(\"backend\", \"backend server closed\")\n79\t\treturn err\n80\t}\n81\t"}]}
