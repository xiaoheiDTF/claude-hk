ler(sessionSvc),\n54\t\t})\n55\t\n56\t\tsrv := httptest.NewServer(router)\n57\t\tt.Cleanup(srv.Close)\n58\t\n59\t\treturn &sessionTestEnv{srv: srv, store: s, db: s.DB()}\n60\t}\n61\t\n62\tfunc (e *sessionTestEnv) post(t *testing.T, path, body string) *http.Response {\n63\t\tt.Helper()\n64\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n65\t\tif err != nil {\n66\t\t\tt.Fatal(err)\n67\t\t}\n68\t\treturn resp\n69\t}\n70\t\n71\tfunc (e *sessionTestEnv) get(t *testing.T, path string) *http.Response {\n72\t\tt.Helper()\n73\t\tresp, err := http.Get(e.srv.URL + path)\n74\t\tif err != nil {\n75\t\t\tt.Fatal(err)\n76\t\t}\n77\t\treturn resp\n78\t}\n79\t\n80\tfunc sessionReadJSON(t *testing.T, resp *http.Response, v any) {\n81\t\tt.Helper()\n82\t\tdefer resp.Body.Close()\n83\t\tb, err := io.ReadAll(resp.Body)\n84\t\tif err != nil {\n85\t\t\tt.Fatal(err)\n86\t\t}\n87\t\tif err := json.Unmarshal(b, v); err != nil {\n88\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n89\t\t}\n90\t}\n91\t\n92\t// --- Register tests ---\n93\t\n94\tfunc TestSessionRegister(t *testing.T) {\n95\t\tt.Run(\"success_writes_three_tables\", func(t *testing.T) {\n96\t\t\tenv := setupSessionTest(t)\n97\t\n98\t\t\tresp := env.post(t, \"/api/session/register\", `{\n99\t\t\t\t\"session_id\": \"sess-001\",\n100\t\t\t\t\"machine_id\": \"admin@host1\",\n101\t\t\t\t\"os\": \"windows\",\n102\t\t\t\t\"project_slug\": \"test-project\",\n103\t\t\t\t\"project_cwd\": \"C:\\\\Projects\\\\test\",\n104\t\t\t\t\"transcript_path\": \"C:\\\\Users\\\\.claude\\\\transcript.jsonl\",\n105\t\t\t\t\"model\": \"GLM-5.1\",\n106\t\t\t\t\"source\": \"startup\"\n107\t\t\t}`)\n108\t\n109\t\t\tvar result map[string]string\n110\t\t\tsessionReadJSON(t, resp, &result)\n111\t\n112\t\t\tif resp.StatusCode != http.StatusOK {\n113\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n114\t\t\t}\n115\t\t\tif result[\"status\"] != \"registered\" {\n116\t\t\t\tt.Errorf(\"expected status=registered, got %s\", result[\"status\"])\n117\t\t\t}\n118\t\n119\t\t\t// Verify machines table.\n120\t\t\tvar machineCount int\n121\t\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM machines WHERE machine_id = 'admin@host1'\").Scan(&machineCount)\n122\t\t\tif machineCount != 1 {\n123\t\t\t\tt.Errorf(\"expected 1 machine row, got %d\", machineCount)\n124\t\t\t}\n125\t\t\tvar username, hostname string\n126\t\t\tenv.db.QueryRow(\"SELECT username, hostname FROM machines WHERE machine_id = 'admin@host1'\").Scan(&username, &hostname)\n127\t\t\tif username != \"admin\" {\n128\t\t\t\tt.Errorf(\"expected username=admin, got %s\", username)\n129\t\t\t}\n130\t\t\tif hostname != \"host1\" {\n131\t\t\t\tt.Errorf(\"expected hostname=host1, got %s\", hostname)\n132\t\t\t}\n133\t\n134\t\t\t// Verify projects table.\n135\t\t\tvar projectCount int\n136\t\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM projects WHERE project_slug = 'test-project'\").Scan(&projectCount)\n137\t\t\tif projectCount != 1 {\n138\t\t\t\tt.Errorf(\"expected 1 project row, got %d\", projectCount)\n139\t\t\t}\n140\t\n141\t\t\t// Verify sessions table.\n142\t\t\tvar sessionStatus, sessMachineID, sessProject string\n143\t\t\tenv.db.QueryRow(\"SELECT status, machine_id, project_slug FROM sessions WHERE session_id = 'sess-001'\").\n144\t\t\t\tScan(&sessionStatus, &sessMachineID, &sessProject)\n145\t\t\tif sessionStatus != \"active\" {\n146\t\t\t\tt.Errorf(\"expected active, got %s\", sessionStatus)\n147\t\t\t}\n148\t\t\tif sessMachineID != \"admin@host1\" {\n149\t\t\t\tt.Errorf(\"expected admin@host1, got %s\", sessMachineID)\n150\t\t\t}\n151\t\t\tif sessProject != \"test-project\" {\n152\t\t\t\tt.Errorf(\"expected test-project, got %s\", sessProject)\n153\t\t\t}\n154\t\t})\n155\t\n156\t\tt.Run(\"duplicate_returns_409\", func(t *testing.T) {\n157\t\t\tenv := setupSessionTest(t)\n158\t\n159\t\t\tbody := `{\"session_id\":\"sess-dup\",\"machine_id\":\"admin@host1\",\"os\":\"windows\",\"project_slug\":\"proj\",\"project_cwd\":\"/proj\",\"transcript_path\":\"/t.jsonl\"}`\n160\t\t\tenv.post(t, \"/api/session/register\", body)\n161\t\n162\t\t\tresp := env.post(t, \"/api/session/register\", body)\n163\t\n164\t\t\tvar errResp struct {\n165\t\t\t\tCode    string `json:\"error\"`\n166\t\t\t\tMessage string `json:\"message\"`\n167\t\t\t}\n168\t\t\tsessionReadJSON(t, resp, &errResp)\n169\t\n170\t\t\tif resp.StatusCode != http.StatusConflict {\n171\t\t\t\tt.Fatalf(\"expected 409, got %d\", resp.StatusCode)\n172\t\t\t}\n173\t\t\tif errResp.Code != \"session_exists\" {\n174\t\t\t\tt.Errorf(\"expected error=session_exists, got %s\", errResp.Code)\n175\t\t\t}\n176\t\t})\n177\t\n178\t\tt.Run(\"missing_required_fields_returns_400\", func(t *testing.T) {\n179\t\t\tenv := setupSessionTest(t)\n180\t\n181\t\t\tcases := []struct {\n182\t\t\t\tname string\n183\t\t\t\tbody string\n184\t\t\t}{\n185\t\t\t\t{\"missing_session_id\", `{\"machine_id\":\"m\",\"os\":\"windows\",\"project_slug\":\"p\",\"project_cwd\":\"/p\",\"transcript_path\":\"/t\"}`},\n186\t\t\t\t{\"missing_machine_id\", `{\"session_id\":\"s\",\"os\":\"windows\",\"project_slug\":\"p\",\"project_cwd\":\"/p\",\"transcript_path\":\"/t\"}`},\n187\t\t\t\t{\"missing_project_slug\", `{\"session_id\":\"s\",\"machine_id\":\"m\",\"os\":\"windows\",\"project_cwd\":\"/p\",\"transcript_path\":\"/t\"}`},\n188\t\t\t\t{\"missing_transcript_path\", `{\"session_id\":\"s\",\"machine_id\":\"m\",\"os\":\"windows\",\"project_slug\":\"p\",\"project_cwd\":\"/p\"}`},\n189\t\t\t}\n190\t\n191\t\t\tfor _, tc := range cases {\n192\t\t\t\tt.Run(tc.name, func(t *testing.T) {\n193\t\t\t\t\tresp := env.post(t, \"/api/session/register\", tc.body)\n194\t\t\t\t\tif resp.StatusCode != http.StatusBadRequest {\n195\t\t\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n196\t\t\t\t\t}\n197\t\t\t\t})\n198\t\t\t}\n199\t\t})\n200\t\n201\t\tt.Run(\"invalid_json_returns_400\", func(t *testing.T) {\n202\t\t\tenv := setupSessionTest(t)\n203\t\t\tresp := env.post(t, \"/api/session/register\", \"not json\")\n204\t\t\tif resp.StatusCode != http.StatusBadRequest {\n205\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n206\t\t\t}\n207\t\t})\n208\t\n209\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n210\t\t\tenv := setupSessionTest(t)\n211\t\t\tresp, err := http.Get(env.srv.URL + \"/api/session/register\")\n212\t\t\tif err != nil {\n213\t\t\t\tt.Fatal(err)\n214\t\t\t}\n215\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n216\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n217\t\t\t}\n218\t\t})\n219\t\n220\t\tt.Run(\"machine_id_update_last_seen\", func(t *testing.T) {\n221\t\t\tenv := setupSessionTest(t)\n222\t\n223\t\t\t// Register first session.\n224\t\t\tenv.post(t, \"/api/session/register\", `{\n225\t\t\t\t\"session_id\":\"sess-a\",\"machine_id\":\"admin@host1\",\"os\":\"windows\",\n226\t\t\t\t\"project_slug\":\"proj-a\",\"project_cwd\":\"/a\",\"transcript_path\":\"/ta.jsonl\"}`)\n227\t\n228\t\t\t// Register second session with same machine_id.\n229\t\t\tenv.post(t, \"/api/session/register\", `{\n230\t\t\t\t\"session_id\":\"sess-b\",\"machine_id\":\"admin@host1\",\"os\":\"windows\",\n231\t\t\t\t\"project_slug\":\"proj-b\",\"project_cwd\":\"/b\",\"transcript_path\":\"/tb.jsonl\"}`)\n232\t\n233\t\t\t// Machine should have only 1 row.\n234\t\t\tvar count int\n235\t\t\tenv.db.QueryRow(\"SELECT COUNT(*) FROM machines WHERE machine_id = 'admin@host1'\").Scan(&count)\n236\t\t\tif count != 1 {\n237\t\t\t\tt.Errorf(\"expected 1 machine row, got %d\", count)\n238\t\t\t}\n239\t\n240\t\t\t// last_seen_at should be updated (not null).\n241\t\t\tvar lastSeen sql.NullString\n242\t\t\tenv.db.QueryRow(\"SELECT last_seen_at FROM machines WHERE machine_id = 'admin@host1'\").Scan(&lastSeen)\n243\t\t\tif !lastSeen.Valid {\n244\t\t\t\tt.Error(\"expected last_seen_at to be set\")\n245\t\t\t}\n246\t\t})\n247\t}\n248\t\n249\t// --- Close tests ---\n250\t\n251\tfunc TestSessionClose(t *testing.T) {\n252\t\tt.Run(\"success\", func(t *testing.T) {\n253\t\t\tenv := setupSessionTest(t)\n254\t\t\tregisterSession(t, env, \"sess-close-1\")\n255\t\n256\t\t\tresp := env.post(t, \"/api/session/close\",\n257\t\t\t\t`{\"session_id\":\"sess-close-1\",\"reason\":\"prompt_input_exit\"}`)\n258\t\n259\t\t\tvar result map[string]string\n260\t\t\tsessionReadJSON(t, resp, &result)\n261\t\n262\t\t\tif resp.StatusCode != http.StatusOK {\n263\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n264\t\t\t}\n265\t\t\tif result[\"status\"] != \"closed\" {\n266\t\t\t\tt.Errorf(\"expected status=closed, got %s\", result[\"status\"])\n267\t\t\t}\n268\t\n269\t\t\t// Verify DB.\n270\t\t\tvar status, reason string\n271\t\t\tenv.db.QueryRow(\"SELECT status, close_reason FROM sessions WHERE session_id = 'sess-close-1'\").Scan(&status, &reason)\n272\t\t\tif status != \"closed\" {\n273\t\t\t\tt.Errorf(\"expected closed, got %s\", status)\n274\t\t\t}\n275\t\t\tif reason != \"prompt_input_exit\" {\n276\t\t\t\tt.Errorf(\"expected prompt_input_exit, got %s\", reason)\n277\t\t\t}\n278\t\t})\n279\t\n280\t\tt.Run(\"not_found_returns_404\", func(t *testing.T) {\n281\t\t\tenv := setupSessionTest(t)\n282\t\n283\t\t\tresp := env.post(t, \"/api/session/close\",\n284\t\t\t\t`{\"session_id\":\"nonexistent\",\"reason\":\"exit\"}`)\n285\t\n286\t\t\tif resp.StatusCode != http.StatusNotFound {\n287\t\t\t\tt.Fatalf(\"expected 404, got %d\", resp.StatusCode)\n288\t\t\t}\n289\t\t})\n290\t\n291\t\tt.Run(\"already_closed_returns_404\", func(t *testing.T) {\n292\t\t\tenv := setupSessionTest(t)\n293\t\t\tregisterSession(t, env, \"sess-dbl-close\")\n294\t\n295\t\t\tenv.post(t, \"/api/session/close\",\n296\t\t\t\t`{\"session_id\":\"sess-dbl-close\",\"reason\":\"first\"}`)\n297\t\n298\t\t\tresp := env.post(t, \"/api/session/close\",\n299\t\t\t\t`{\"session_id\":\"sess-dbl-close\",\"reason\":\"second\"}`)\n300\t\n301\t\t\tif resp.StatusCode != http.StatusNotFound {\n302\t\t\t\tt.Fatalf(\"expected 404, got %d\", resp.StatusCode)\n303\t\t\t}\n304\t\t})\n305\t\n306\t\tt.Run(\"missing_session_id_returns_400\", func(t *testing.T) {\n307\t\t\tenv := setupSessionTest(t)\n308\t\t\tresp := env.post(t, \"/api/session/close\", `{}`)\n309\t\t\tif resp.StatusCode != http.StatusBadRequest {\n310\t\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n311\t\t\t}\n312\t\t})\n313\t\n314\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n315\t\t\tenv := setupSessionTest(t)\n316\t\t\tresp, err := http.Get(env.srv.URL + \"/api/session/close\")\n317\t\t\tif err != nil {\n318\t\t\t\tt.Fatal(err)\n319\t\t\t}\n320\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n321\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n322\t\t\t}\n323\t\t})\n324\t}\n325\t\n326\t// --- List tests ---\n327\t\n328\tfunc TestSessionList(t *testing.T) {\n329\t\tseedSessions := func(t *testing.T, env *sessionTestEnv) {\n330\t\t\tregisterSession(t, env, \"sess-list-1\")\n331\t\t\tregisterSessionWith(t, env, \"sess-list-2\", \"other@host2\", \"linux\", \"proj-b\", \"/b\")\n332\t\t\tregisterSessionWith(t, env, \"sess-list-3\", \"admin@host1\", \"windows\", \"proj-a\", \"/a\")\n333\t\t\t// Close the third one.\n334\t\t\tenv.post(t, \"/api/session/close\", `{\"session_id\":\"sess-list-3\",\"reason\":\"done\"}`)\n335\t\t}\n336\t\n337\t\tt.Run(\"all_sessions\", func(t *testing.T) {\n338\t\t\tenv := setupSessionTest(t)\n339\t\t\tseedSessions(t, env)\n340\t\n341\t\t\tresp := env.get(t, \"/api/sessions\")\n342\t\n343\t\t\tvar result struct {\n344\t\t\t\tSessions []struct {\n345\t\t\t\t\tSessionID string `json:\"session_id\"`\n346\t\t\t\t\tStatus    string `json:\"status\"`\n347\t\t\t\t} `json:\"sessions\"`\n348\t\t\t}\n349\t\t\tsessionReadJSON(t, resp, &result)\n350\t\n351\t\t\tif resp.StatusCode != http.StatusOK {\n352\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n353\t\t\t}\n354\t\t\tif len(result.Sessions) != 3 {\n355\t\t\t\tt.Fatalf(\"expected 3 sessions, got %d\", len(result.Sessions))\n356\t\t\t}\n357\t\t})\n358\t\n359\t\tt.Run(\"filter_by_machine_id\", func(t *testing.T) {\n360\t\t\tenv := setupSessionTest(t)\n361\t\t\tseedSessions(t, env)\n362\t\n363\t\t\tresp := env.get(t, \"/api/sessions?machine_id=other@host2\")\n364\t\n365\t\t\tvar result struct {\n366\t\t\t\tSessions []struct {\n367\t\t\t\t\tSessionID string `json:\"session_id\"`\n368\t\t\t\t} `json:\"sessions\"`\n369\t\t\t}\n370\t\t\tsessionReadJSON(t, resp, &result)\n371\t\n372\t\t\tif len(result.Sessions) != 1 {\n373\t\t\t\tt.Fatalf(\"expected 1 session, got %d\", len(result.Sessions))\n374\t\t\t}\n375\t\t\tif result.Sessions[0].SessionID != \"sess-list-2\" {\n376\t\t\t\tt.Errorf(\"expected sess-list-2, got %s\", result.Sessions[0].SessionID)\n377\t\t\t}\n378\t\t})\n379\t\n380\t\tt.Run(\"filter_by_status_active\", func(t *testing.T) {\n381\t\t\tenv := setupSessionTest(t)\n382\t\t\tseedSessions(t, env)\n383\t\n384\t\t\tresp := env.get(t, \"/api/sessions?status=active\")\n385\t\n386\t\t\tvar result struct {\n387\t\t\t\tSessions []struct {\n388\t\t\t\t\tSessionID string `json:\"session_id\"`\n389\t\t\t\t\tStatus    string `json:\"status\"`\n390\t\t\t\t} `json:\"sessions\"`\n391\t\t\t}\n392\t\t\tsessionReadJSON(t, resp, &result)\n393\t\n394\t\t\tif len(result.Sessions) != 2 {\n395\t\t\t\tt.Fatalf(\"expected 2 active sessions, got %d\", len(result.Sessions))\n396\t\t\t}\n397\t\t\tfor _, s := range result.Sessions {\n398\t\t\t\tif s.Status != \"active\" {\n399\t\t\t\t\tt.Errorf(\"expected active, got %s\", s.Status)\n400\t\t\t\t}\n401\t\t\t}\n402\t\t})\n403\t\n404\t\tt.Run(\"filter_by_project_slug\", func(t *testing.T) {\n405\t\t\tenv := setupSessionTest(t)\n406\t\t\tseedSessions(t, env)\n407\t\n408\t\t\tresp := env.get(t, \"/api/sessions?project_slug=proj-b\")\n409\t\n410\t\t\tvar result struct {\n411\t\t\t\tSessions []struct {\n412\t\t\t\t\tSessionID string `json:\"session_id\"`\n413\t\t\t\t} `json:\"sessions\"`\n414\t\t\t}\n415\t\t\tsessionReadJSON(t, resp, &result)\n416\t\n417\t\t\tif len(result.Sessions) != 1 {\n418\t\t\t\tt.Fatalf(\"expected 1 session, got %d\", len(result.Sessions))\n419\t\t\t}\n420\t\t})\n421\t\n422\t\tt.Run(\"empty_result\", func(t *testing.T) {\n423\t\t\tenv := setupSessionTest(t)\n424\t\n425\t\t\tresp := env.get(t, \"/api/sessions\")\n426\t\n427\t\t\tvar result struct {\n428\t\t\t\tSessions []any `json:\"sessions\"`\n429\t\t\t}\n430\t\t\tsessionReadJSON(t, resp, &result)\n431\t\n432\t\t\tif len(result.Sessions) != 0 {\n433\t\t\t\tt.Fatalf(\"expected 0 sessions, got %d\", len(result.Sessions))\n434\t\t\t}\n435\t\t})\n436\t\n437\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n438\t\t\tenv := setupSessionTest(t)\n439\t\t\tresp := env.post(t, \"/api/sessions\", \"\")\n440\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n441\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n442\t\t\t}\n443\t\t})\n444\t}\n445\t\n446\t// --- Get tests ---\n447\t\n448\tfunc TestSessionGet(t *testing.T) {\n449\t\tt.Run(\"existing_session\", func(t *testing.T) {\n450\t\t\tenv := setupSessionTest(t)\n451\t\t\tregisterSession(t, env, \"sess-get-1\")\n452\t\n453\t\t\tresp := env.get(t, \"/api/session/sess-get-1\")\n454\t\n455\t\t\tvar result struct {\n456\t\t\t\tSessionID      string `json:\"session_id\"`\n457\t\t\t\tMachineID      string `json:\"machine_id\"`\n458\t\t\t\tOS             string `json:\"os\"`\n459\t\t\t\tProjectSlug    string `json:\"project_slug\"`\n460\t\t\t\tProjectCwd     string `json:\"project_cwd\"`\n461\t\t\t\tTranscriptPath string `json:\"transcript_path\"`\n462\t\t\t\tModel          string `json:\"model\"`\n463\t\t\t\tSource         string `json:\"source\"`\n464\t\t\t\tStatus         string `json:\"status\"`\n465\t\t\t}\n466\t\t\tsessionReadJSON(t, resp, &result)\n467\t\n468\t\t\tif resp.StatusCode != http.StatusOK {\n469\t\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n470\t\t\t}\n471\t\t\tif result.SessionID != \"sess-get-1\" {\n472\t\t\t\tt.Errorf(\"expected sess-get-1, got %s\", result.SessionID)\n473\t\t\t}\n474\t\t\tif result.Status != \"active\" {\n475\t\t\t\tt.Errorf(\"expected active, got %s\", result.Status)\n476\t\t\t}\n477\t\t\tif result.MachineID != \"admin@host1\" {\n478\t\t\t\tt.Errorf(\"expected admin@host1, got %s\", result.MachineID)\n479\t\t\t}\n480\t\t\tif result.TranscriptPath == \"\" {\n481\t\t\t\tt.Error(\"expected non-empty transcript_path\")\n482\t\t\t}\n483\t\t})\n484\t\n485\t\tt.Run(\"not_found\", func(t *testing.T) {\n486\t\t\tenv := setupSessionTest(t)\n487\t\t\tresp := env.get(t, \"/api/session/nonexistent\")\n488\t\n489\t\t\tif resp.StatusCode != http.StatusNotFound {\n490\t\t\t\tt.Fatalf(\"expected 404, got %d\", resp.StatusCode)\n491\t\t\t}\n492\t\t})\n493\t\n494\t\tt.Run(\"closed_session_has_close_fields\", func(t *testing.T) {\n495\t\t\tenv := setupSessionTest(t)\n496\t\t\tregisterSession(t, env, \"sess-closed-detail\")\n497\t\t\tenv.post(t, \"/api/session/close\",\n498\t\t\t\t`{\"session_id\":\"sess-closed-detail\",\"reason\":\"prompt_input_exit\"}`)\n499\t\n500\t\t\tresp := env.get(t, \"/api/session/sess-closed-detail\")\n501\t\n502\t\t\tvar result struct {\n503\t\t\t\tStatus      string  `json:\"status\"`\n504\t\t\t\tCloseReason string  `json:\"close_reason\"`\n505\t\t\t\tClosedAt    *string `json:\"closed_at\"`\n506\t\t\t}\n507\t\t\tsessionReadJSON(t, resp, &result)\n508\t\n509\t\t\tif result.Status != \"closed\" {\n510\t\t\t\tt.Errorf(\"expected closed, got %s\", result.Status)\n511\t\t\t}\n512\t\t\tif result.CloseReason != \"prompt_input_exit\" {\n513\t\t\t\tt.Errorf(\"expected prompt_input_exit, got %s\", result.CloseReason)\n514\t\t\t}\n515\t\t\tif result.ClosedAt == nil {\n516\t\t\t\tt.Error(\"expected closed_at to be set\")\n517\t\t\t}\n518\t\t})\n519\t\n520\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n521\t\t\tenv := setupSessionTest(t)\n522\t\t\tresp := env.post(t, \"/api/session/some-id\", \"\")\n523\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n524\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n525\t\t\t}\n526\t\t})\n527\t}\n528\t\n529\t// --- Timeout cleanup tests ---\n530\t\n531\tfunc TestCleanupTimedOutSessions(t *testing.T) {\n532\t\tt.Run(\"marks_stale_sessions_closed\", func(t *testing.T) {\n533\t\t\tenv := setupSessionTest(t)\n534\t\n535\t\t\t// Insert a session with an old registered_at.\n536\t\t\tenv.db.Exec(`INSERT INTO sessions (session_id, machine_id, os, project_slug, project_cwd,\n537\t\t\t\ttranscript_path, status, registered_at)\n538\t\t\t\tVALUES ('stale-sess', 'admin@host', 'linux', 'proj', '/p', '/t.jsonl', 'active',\n539\t\t\t\tdatetime('now', '-25 hours'))`)\n540\t\n541\t\t\tsvc := service.NewCleanupService(env.store.Sessions())\n542\t\t\tsvc.CleanupTimedOutSessions(context.Background())\n543\t\n544\t\t\tvar status, reason string\n545\t\t\tenv.db.QueryRow(\"SELECT status, close_reason FROM sessions WHERE session_id = 'stale-sess'\").Scan(&status, &reason)\n546\t\t\tif status != \"closed\" {\n547\t\t\t\tt.Errorf(\"expected closed, got %s\", status)\n548\t\t\t}\n549\t\t\tif reason != \"timeout_cleanup\" {\n550\t\t\t\tt.Errorf(\"expected timeout_cleanup, got %s\", reason)\n551\t\t\t}\n552\t\t})\n553\t\n554\t\tt.Run(\"recent_sessions_untouched\", func(t *testing.T) {\n555\t\t\tenv := setupSessionTest(t)\n556\t\t\tregisterSession(t, env, \"fresh-sess\")\n557\t\n558\t\t\tsvc := service.NewCleanupService(env.store.Sessions())\n559\t\t\tsvc.CleanupTimedOutSessions(context.Background())\n560\t\n561\t\t\tvar status string\n562\t\t\tenv.db.QueryRow(\"SELECT status FROM sessions WHERE session_id = 'fresh-sess'\").Scan(&status)\n563\t\t\tif status != \"active\" {\n564\t\t\t\tt.Errorf(\"expected active, got %s\", status)\n565\t\t\t}\n566\t\t})\n567\t}\n568\t\n569\t// --- Full lifecycle test ---\n570\t\n571\tfunc TestSessionFullLifecycle(t *testing.T) {\n572\t\tenv := setupSessionTest(t)\n573\t\n574\t\t// 1. Register.\n575\t\tresp := env.post(t, \"/api/session/register\", fmt.Sprintf(`{\n576\t\t\t\"session_id\": \"lifecycle-1\",\n577\t\t\t\"machine_id\": \"admin@host1\",\n578\t\t\t\"os\": \"windows\",\n579\t\t\t\"project_slug\": \"proj-lifecycle\",\n580\t\t\t\"project_cwd\": \"/proj\",\n581\t\t\t\"transcript_path\": \"/t.jsonl\",\n582\t\t\t\"model\": \"GLM-5.1\",\n583\t\t\t\"source\": \"startup\",\n584\t\t\t\"local_trace_path\": \"/traces/lifecycle-1.jsonl\"\n585\t\t}`))\n586\t\tif resp.StatusCode != http.StatusOK {\n587\t\t\tt.Fatalf(\"step 1 register: expected 200, got %d\", resp.StatusCode)\n588\t\t}\n589\t\n590\t\t// 2. Get detail.\n591\t\tresp = env.get(t, \"/api/session/lifecycle-1\")\n592\t\tvar detail struct {\n593\t\t\tStatus         string `json:\"status\"`\n594\t\t\tModel          string `json:\"model\"`\n595\t\t\tLocalTracePath string `json:\"local_trace_path\"`\n596\t\t}\n597\t\tsessionReadJSON(t, resp, &detail)\n598\t\tif detail.Status != \"active\" {\n599\t\t\tt.Fatalf(\"step 2 get: expected active, got %s\", detail.Status)\n600\t\t}\n601\t\tif detail.Model != \"GLM-5.1\" {\n602\t\t\tt.Errorf(\"step 2 get: expected model=GLM-5.1, got %s\", detail.Model)\n603\t\t}\n604\t\tif detail.LocalTracePath != \"/traces/lifecycle-1.jsonl\" {\n605\t\t\tt.Errorf(\"step 2 get: expected local_trace_path set, got %s\", detail.LocalTracePath)\n606\t\t}\n607\t\n608\t\t// 3. List with filter.\n609\t\tresp = env.get(t, \"/api/sessions?status=active&machine_id=admin@host1\")\n610\t\tvar list struct {\n611\t\t\tSessions []struct {\n612\t\t\t\tSessionID string `json:\"session_id\"`\n613\t\t\t} `json:\"sessions\"`\n614\t\t}\n615\t\tsessionReadJSON(t, resp, &list)\n616\t\tif len(list.Sessions) != 1 {\n617\t\t\tt.Fatalf(\"step 3 list: expected 1, got %d\", len(list.Sessions))\n618\t\t}\n619\t\n620\t\t// 4. Close.\n621\t\tresp = env.post(t, \"/api/session/close\",\n622\t\t\t`{\"session_id\":\"lifecycle-1\",\"reason\":\"prompt_input_exit\"}`)\n623\t\tif resp.StatusCode != http.StatusOK {\n624\t\t\tt.Fatalf(\"step 4 close: expected 200, got %d\", resp.StatusCode)\n625\t\t}\n626\t\n627\t\t// 5. Verify closed via get.\n628\t\tresp = env.get(t, \"/api/session/lifecycle-1\")\n629\t\tsessionReadJSON(t, resp, &detail)\n630\t\tif detail.Status != \"closed\" {\n631\t\t\tt.Fatalf(\"step 5 verify: expected closed, got %s\", detail.Status)\n632\t\t}\n633\t\n634\t\t// 6. Double close returns 404.\n635\t\tresp = env.post(t, \"/api/session/close\",\n636\t\t\t`{\"session_id\":\"lifecycle-1\",\"reason\":\"again\"}`)\n637\t\tif resp.StatusCode != http.StatusNotFound {\n638\t\t\tt.Fatalf(\"step 6 double close: expected 404, got %d\", resp.StatusCode)\n639\t\t}\n640\t}\n641\t\n642\t// --- Helpers ---\n643\t\n644\tfunc registerSession(t *testing.T, env *sessionTestEnv, sessionID string) {\n645\t\tt.Helper()\n646\t\tregisterSessionWith(t, env, sessionID, \"admin@host1\", \"windows\", \"proj-a\", \"/a\")\n647\t}\n648\t\n649\tfunc registerSessionWith(t *testing.T, env *sessionTestEnv, sessionID, machineID, osName, projectSlug, projectCwd string) {\n650\t\tt.Helper()\n651\t\tbody := fmt.Sprintf(`{\n652\t\t\t\"session_id\": \"%s\",\n653\t\t\t\"machine_id\": \"%s\",\n654\t\t\t\"os\": \"%s\",\n655\t\t\t\"project_slug\": \"%s\",\n656\t\t\t\"project_cwd\": \"%s\",\n657\t\t\t\"transcript_path\": \"/transcripts/%s.jsonl\"\n658\t\t}`, sessionID, machineID, osName, projectSlug, projectCwd, sessionID)\n659\t\tresp := env.post(t, \"/api/session/register\", body)\n660\t\tif resp.StatusCode != http.StatusOK {\n661\t\t\tt.Fatalf(\"register session %s: expected 200, got %d\", sessionID, resp.StatusCode)\n662\t\t}\n663\t}\n664\t"}]}
