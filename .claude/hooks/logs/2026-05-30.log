[2026-05-30 11:24:09] [INFO] [PostToolBatch] Input: {"session_id":"b63b113f-845a-45c4-bb3d-eca702572f62","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\b63b113f-845a-45c4-bb3d-eca702572f62.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"plan","agent_id":"ada07ca36cfc53b6a","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\sse\\reassembler.go"},"tool_use_id":"call_174ffeb6fa574b5586932aaf","tool_response":"1\tpackage sse\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/usage\"\n10\t)\n11\t\n12\t// SSEReassembler 解析原始 SSE（Server-Sent Events）字节流，并将流式片段重组成完整的 API 响应。\n13\t//\n14\t// 支持的协议：\n15\t//   - Anthropic Messages API Streaming\n16\t//   - OpenAI Chat Completions Streaming\n17\t//   - OpenAI Responses API Streaming\n18\t//\n19\t// 使用方式：\n20\t//   r := sse.NewSSEReassembler()\n21\t//   r.FeedBytes(chunk)       // 多次调用，分块送入 SSE 数据\n22\t//   snapshot := r.Reconstruct() // 获取当前累积的完整响应快照\n23\t//   events := r.Events       // 获取所有解析出的原始事件列表\n24\ttype SSEReassembler struct {\n25\t\tEvents  []map[string]any // 解析出的所有原始 SSE 事件列表\n26\t\tbuf     []byte           // 未处理完的 SSE 字节缓冲区\n27\t\tcurEv   *string          // 当前正在解析的事件类型（event: xxx）\n28\t\tcurData []string         // 当前事件的 data 行累积（支持多行 data）\n29\t\tsnap    map[string]any   // 重建后的完整响应快照\n30\t}\n31\t\n32\t// NewSSEReassembler 创建一个新的 SSE 重组器实例。\n33\tfunc NewSSEReassembler() *SSEReassembler {\n34\t\treturn &SSEReassembler{}\n35\t}\n36\t\n37\t// FeedBytes 追加原始 SSE 字节数据并处理已完整的行。\n38\t//\n39\t// 该方法按 \\n 分割输入数据，逐行解析 SSE 协议中的 event、data 字段，\n40\t// 遇到空行时触发事件生成并调用累积逻辑更新快照。\n41\t// 可以多次调用以处理分块传输的数据。\n42\tfunc (r *SSEReassembler) FeedBytes(chunk []byte) {\n43\t\tr.buf = append(r.buf, chunk...)\n44\t\tfor {\n45\t\t\tidx := bytes.IndexByte(r.buf, '\\n')\n46\t\t\tif idx < 0 {\n47\t\t\t\tbreak\n48\t\t\t}\n49\t\t\tline := r.buf[:idx]\n50\t\t\tr.buf = r.buf[idx+1:]\n51\t\t\tr.feedLine(string(line))\n52\t\t}\n53\t}\n54\t\n55\t// Reconstruct 返回当前累积的消息快照。\n56\t//\n57\t// 如果尚未收到足够的事件来构建快照（如仅收到部分 SSE 帧），则返回 nil。\n58\tfunc (r *SSEReassembler) Reconstruct() map[string]any {\n59\t\treturn r.snap\n60\t}\n61\t\n62\t// feedLine 处理单条 SSE 文本行，解析 event、data 和空行分隔符。\n63\t//\n64\t// SSE 协议规则：\n65\t//   - 以 \"event:\" 开头的行设置当前事件类型\n66\t//   - 以 \"data:\" 开头的行追加到当前事件的数据 payload\n67\t//   - 空行表示当前事件结束，触发事件生成\n68\t//   - \"[DONE]\" 是 OpenAI 的流结束标记，直接忽略\n69\tfunc (r *SSEReassembler) feedLine(line string) {\n70\t\tline = strings.TrimRight(line, \"\\r\")\n71\t\n72\t\tif strings.HasPrefix(line, \"event:\") {\n73\t\t\tev := strings.TrimSpace(line[len(\"event:\"):])\n74\t\t\tr.curEv = &ev\n75\t\t\tr.curData = nil\n76\t\t} else if strings.HasPrefix(line, \"data:\") {\n77\t\t\tr.curData = append(r.curData, strings.TrimSpace(line[len(\"data:\"):]))\n78\t\t} else if line == \"\" {\n79\t\t\t// 空行触发事件：如果既没有 event 也没有 data 则跳过\n80\t\t\tif r.curEv == nil && len(r.curData) == 0 {\n81\t\t\t\treturn\n82\t\t\t}\n83\t\t\traw := strings.Join(r.curData, \"\\n\")\n84\t\n85\t\t\t// 跳过 OpenAI 的 [DONE] 哨兵标记\n86\t\t\tif raw == \"[DONE]\" && r.curEv == nil {\n87\t\t\t\tr.curEv = nil\n88\t\t\t\tr.curData = nil\n89\t\t\t\treturn\n90\t\t\t}\n91\t\n92\t\t\tvar data any\n93\t\t\tif err := json.Unmarshal([]byte(raw), &data); err != nil {\n94\t\t\t\tdata = raw\n95\t\t\t}\n96\t\n97\t\t\tevType := \"message\"\n98\t\t\tif r.curEv != nil {\n99\t\t\t\tevType = *r.curEv\n100\t\t\t}\n101\t\t\tr.addEvent(evType, data)\n102\t\t\tr.curEv = nil\n103\t\t\tr.curData = nil\n104\t\t}\n105\t}\n106\t\n107\t// addEvent 将解析出的单个 SSE 事件追加到事件列表，并触发累积更新。\n108\tfunc (r *SSEReassembler) addEvent(eventType string, data any) {\n109\t\tr.Events = append(r.Events, map[string]any{\"event\": eventType, \"data\": data})\n110\t\tr.accumulate(eventType, data)\n111\t}\n112\t\n113\t// accumulate 按事件类型将流式片段累积到响应快照中。\n114\t//\n115\t// 支持的事件类型及处理逻辑：\n116\t//   - message_start:      初始化快照为 message 对象\n117\t//   - response.created/completed/done: OpenAI Responses API，初始化或更新快照\n118\t//   - message:            OpenAI Chat Completions 流，调用 accumulateChatCompletionChunk\n119\t//   - content_block_start: 向快照 content 数组添加新的内容块\n120\t//   - content_block_delta: 更新指定索引的内容块（文本、推理、JSON 片段）\n121\t//   - content_block_stop:  将累积的 partial_json 解析为 input 字段\n122\t//   - message_delta:       更新 message 级别的 delta（如 stop_reason）和 usage\n123\tfunc (r *SSEReassembler) accumulate(eventType string, data any) {\n124\t\tm, ok := data.(map[string]any)\n125\t\tif !ok {\n126\t\t\treturn\n127\t\t}\n128\t\n129\t\tswitch eventType {\n130\t\tcase \"message_start\":\n131\t\t\tif msg, ok := m[\"message\"].(map[string]any); ok {\n132\t\t\t\tr.snap = deepCopy(msg)\n133\t\t\t}\n134\t\n135\t\tcase \"response.created\", \"response.completed\", \"response.done\":\n136\t\t\tif resp, ok := m[\"response\"].(map[string]any); ok {\n137\t\t\t\tr.snap = deepCopy(resp)\n138\t\t\t} else if eventType == \"response.completed\" || eventType == \"response.done\" {\n139\t\t\t\tr.snap = deepCopy(m)\n140\t\t\t}\n141\t\n142\t\tcase \"message\":\n143\t\t\tif _, hasChoices := m[\"choices\"]; hasChoices {\n144\t\t\t\tr.accumulateChatCompletionChunk(m)\n145\t\t\t\treturn\n146\t\t\t}\n147\t\n148\t\tcase \"content_block_start\":\n149\t\t\tif r.snap == nil {\n150\t\t\t\treturn\n151\t\t\t}\n152\t\t\tblock := deepCopy(m[\"content_block\"].(map[string]any))\n153\t\t\tif _, ok := r.snap[\"content\"]; !ok {\n154\t\t\t\tr.snap[\"content\"] = []any{}\n155\t\t\t}\n156\t\t\tcontent := r.snap[\"content\"].([]any)\n157\t\t\tidx := int(float64Val(m[\"index\"]))\n158\t\t\tfor len(content) <= idx {\n159\t\t\t\tcontent = append(content, map[string]any{})\n160\t\t\t}\n161\t\t\tcontent[idx] = block\n162\t\t\tr.snap[\"content\"] = content\n163\t\n164\t\tcase \"content_block_delta\":\n165\t\t\tif r.snap == nil {\n166\t\t\t\treturn\n167\t\t\t}\n168\t\t\tidx := int(float64Val(m[\"index\"]))\n169\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n170\t\t\tif delta == nil {\n171\t\t\t\treturn\n172\t\t\t}\n173\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n174\t\t\tif idx >= len(content) {\n175\t\t\t\treturn\n176\t\t\t}\n177\t\t\tblock, _ := content[idx].(map[string]any)\n178\t\t\tif block == nil {\n179\t\t\t\treturn\n180\t\t\t}\n181\t\t\tswitch delta[\"type\"] {\n182\t\t\tcase \"text_delta\":\n183\t\t\t\tblock[\"text\"] = strVal(block[\"text\"]) + strVal(delta[\"text\"])\n184\t\t\tcase \"thinking_delta\":\n185\t\t\t\tblock[\"thinking\"] = strVal(block[\"thinking\"]) + strVal(delta[\"thinking\"])\n186\t\t\tcase \"input_json_delta\":\n187\t\t\t\tblock[\"_partial_json\"] = strVal(block[\"_partial_json\"]) + strVal(delta[\"partial_json\"])\n188\t\t\t}\n189\t\n190\t\tcase \"content_block_stop\":\n191\t\t\tif r.snap == nil {\n192\t\t\t\treturn\n193\t\t\t}\n194\t\t\tidx := int(float64Val(m[\"index\"]))\n195\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n196\t\t\tif idx >= len(content) {\n197\t\t\t\treturn\n198\t\t\t}\n199\t\t\tblock, _ := content[idx].(map[string]any)\n200\t\t\tif block == nil {\n201\t\t\t\treturn\n202\t\t\t}\n203\t\t\t// 将累积的 JSON 字符串片段解析为结构化的 input 字段\n204\t\t\tif pj, ok := block[\"_partial_json\"]; ok {\n205\t\t\t\tvar parsed any\n206\t\t\t\tif json.Unmarshal([]byte(strVal(pj)), &parsed) == nil {\n207\t\t\t\t\tblock[\"input\"] = parsed\n208\t\t\t\t}\n209\t\t\t\tdelete(block, \"_partial_json\")\n210\t\t\t}\n211\t\n212\t\tcase \"message_delta\":\n213\t\t\tif r.snap == nil {\n214\t\t\t\treturn\n215\t\t\t}\n216\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n217\t\t\tif delta != nil {\n218\t\t\t\tfor k, v := range delta {\n219\t\t\t\t\tr.snap[k] = v\n220\t\t\t\t}\n221\t\t\t}\n222\t\t\tif u, ok := m[\"usage\"].(map[string]any); ok {\n223\t\t\t\tif _, exists := r.snap[\"usage\"]; !exists {\n224\t\t\t\t\tr.snap[\"usage\"] = map[string]any{}\n225\t\t\t\t}\n226\t\t\t\texisting := r.snap[\"usage\"].(map[string]any)\n227\t\t\t\tfor k, v := range u {\n228\t\t\t\t\texisting[k] = v\n229\t\t\t\t}\n230\t\t\t}\n231\t\t}\n232\t}\n233\t\n234\t// --- OpenAI Chat Completions 流式累积 ---\n235\t\n236\t// accumulateChatCompletionChunk 处理 OpenAI Chat Completions Streaming 的单个 chunk。\n237\t//\n238\t// 该函数将 choices[0].delta 中的内容逐块累积，同时处理：\n239\t//   - role、content、reasoning_content 的拼接\n240\t//   - tool_calls 的渐进式构建（id、name、arguments 分块到达）\n241\t//   - usage 信息的合并\n242\t//   - finish_reason 的更新\n243\t//\n244\t// 快照结构兼容 Anthropic 格式，content 数组中会同时维护文本块和工具调用块。\n245\tfunc (r *SSEReassembler) accumulateChatCompletionChunk(data map[string]any) {\n246\t\tchoices, _ := data[\"choices\"].([]any)\n247\t\trawUsage, _ := data[\"usage\"]\n248\t\n249\t\tif len(choices) == 0 {\n250\t\t\tif u, ok := rawUsage.(map[string]any); ok && r.snap != nil {\n251\t\t\t\tr.mergeChatUsage(u)\n252\t\t\t}\n253\t\t\treturn\n254\t\t}\n255\t\n256\t\tchoice, _ := choices[0].(map[string]any)\n257\t\tif choice == nil {\n258\t\t\treturn\n259\t\t}\n260\t\tdelta, _ := choice[\"delta\"].(map[string]any)\n261\t\tfinishReason := choice[\"finish_reason\"]\n262\t\tchoiceUsage, _ := choice[\"usage\"].(map[string]any)\n263\t\n264\t\t// 首个 chunk 时初始化快照\n265\t\tif r.snap == nil {\n266\t\t\tr.snap = map[string]any{\n267\t\t\t\t\"id\":     strVal(data[\"id\"]),\n268\t\t\t\t\"object\": \"chat.completion\",\n269\t\t\t\t\"model\":  strVal(data[\"model\"]),\n270\t\t\t\t\"choices\": []any{\n271\t\t\t\t\tmap[string]any{\n272\t\t\t\t\t\t\"index\":         0,\n273\t\t\t\t\t\t\"message\":       map[string]any{\"role\": strVal(fieldStr(delta, \"role\")), \"content\": \"\"},\n274\t\t\t\t\t\t\"finish_reason\": nil,\n275\t\t\t\t\t},\n276\t\t\t\t},\n277\t\t\t\t\"content\": []any{map[string]any{\"type\": \"text\", \"text\": \"\"}},\n278\t\t\t}\n279\t\t\tif role := strVal(fieldStr(delta, \"role\")); role == \"\" {\n280\t\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)[\"role\"] = \"assistant\"\n281\t\t\t}\n282\t\t}\n283\t\n284\t\tmsg := r.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n285\t\ttextBlock := r.chatTextBlock()\n286\t\n287\t\tif role := strVal(fieldStr(delta, \"role\")); role != \"\" {\n288\t\t\tmsg[\"role\"] = role\n289\t\t}\n290\t\tif rc := strVal(fieldStr(delta, \"reasoning_content\")); rc != \"\" {\n291\t\t\tmsg[\"reasoning_content\"] = strVal(msg[\"reasoning_content\"]) + rc\n292\t\t\tr.mirrorReasoning(strVal(msg[\"reasoning_content\"]))\n293\t\t}\n294\t\tif c := strVal(fieldStr(delta, \"content\")); c != \"\" {\n295\t\t\tmsg[\"content\"] = strVal(msg[\"content\"]) + c\n296\t\t\ttextBlock[\"text\"] = strVal(textBlock[\"text\"]) + c\n297\t\t}\n298\t\n299\t\t// 工具调用增量处理\n300\t\tfor _, tcRaw := range sliceField(delta, \"tool_calls\") {\n301\t\t\ttcDelta, _ := tcRaw.(map[string]any)\n302\t\t\tif tcDelta == nil {\n303\t\t\t\tcontinue\n304\t\t\t}\n305\t\t\tidx := int(float64Val(tcDelta[\"index\"]))\n306\t\t\ttoolCalls, _ := msg[\"tool_calls\"].([]any)\n307\t\t\tif toolCalls == nil {\n308\t\t\t\ttoolCalls = []any{}\n309\t\t\t}\n310\t\t\tfor len(toolCalls) <= idx {\n311\t\t\t\ttoolCalls = append(toolCalls, map[string]any{\n312\t\t\t\t\t\"id\":   \"\",\n313\t\t\t\t\t\"type\": \"function\",\n314\t\t\t\t\t\"function\": map[string]any{\n315\t\t\t\t\t\t\"name\":      \"\",\n316\t\t\t\t\t\t\"arguments\": \"\",\n317\t\t\t\t\t},\n318\t\t\t\t})\n319\t\t\t}\n320\t\t\texisting := toolCalls[idx].(map[string]any)\n321\t\t\tif id := strVal(tcDelta[\"id\"]); id != \"\" {\n322\t\t\t\texisting[\"id\"] = id\n323\t\t\t}\n324\t\t\tif t := strVal(tcDelta[\"type\"]); t != \"\" {\n325\t\t\t\texisting[\"type\"] = t\n326\t\t\t}\n327\t\t\tif fnDelta, ok := tcDelta[\"function\"].(map[string]any); ok {\n328\t\t\t\tfn, _ := existing[\"function\"].(map[string]any)\n329\t\t\t\tif fn == nil {\n330\t\t\t\t\tfn = map[string]any{\"name\": \"\", \"arguments\": \"\"}\n331\t\t\t\t}\n332\t\t\t\tif n := strVal(fnDelta[\"name\"]); n != \"\" {\n333\t\t\t\t\tfn[\"name\"] = strVal(fn[\"name\"]) + n\n334\t\t\t\t}\n335\t\t\t\tif a := strVal(fnDelta[\"arguments\"]); a != \"\" {\n336\t\t\t\t\tfn[\"arguments\"] = strVal(fn[\"arguments\"]) + a\n337\t\t\t\t}\n338\t\t\t\texisting[\"function\"] = fn\n339\t\t\t}\n340\t\t\ttoolCalls[idx] = existing\n341\t\t\tmsg[\"tool_calls\"] = toolCalls\n342\t\t\tr.mirrorToolCall(idx, existing)\n343\t\t}\n344\t\n345\t\tif finishReason != nil && finishReason != \"\" {\n346\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"finish_reason\"] = finishReason\n347\t\t}\n348\t\n349\t\tif u, ok := rawUsage.(map[string]any); ok {\n350\t\t\tr.mergeChatUsage(u)\n351\t\t}\n352\t\tif choiceUsage != nil {\n353\t\t\tr.mergeChatUsage(choiceUsage)\n354\t\t}\n355\t}\n356\t\n357\t// chatTextBlock 获取或创建快照中的文本内容块。\n358\t// 返回 content 数组中第一个 type=\"text\" 的块；如果不存在则新建一个。\n359\tfunc (r *SSEReassembler) chatTextBlock() map[string]any {\n360\t\tcontent := r.snap[\"content\"].([]any)\n361\t\tfor _, b := range content {\n362\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"text\" {\n363\t\t\t\treturn block\n364\t\t\t}\n365\t\t}\n366\t\tblock := map[string]any{\"type\": \"text\", \"text\": \"\"}\n367\t\tr.snap[\"content\"] = append(content, block)\n368\t\treturn block\n369\t}\n370\t\n371\t// mirrorReasoning 将 reasoning_content 同步到 content 数组中的 thinking 块。\n372\t// 如果 content 中不存在 thinking 块，则在开头插入一个。\n373\tfunc (r *SSEReassembler) mirrorReasoning(reasoning string) {\n374\t\tcontent := r.snap[\"content\"].([]any)\n375\t\tfor _, b := range content {\n376\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n377\t\t\t\tblock[\"thinking\"] = reasoning\n378\t\t\t\treturn\n379\t\t\t}\n380\t\t}\n381\t\tblock := map[string]any{\"type\": \"thinking\", \"thinking\": reasoning}\n382\t\tr.snap[\"content\"] = append([]any{block}, content...)\n383\t}\n384\t\n385\t// mirrorToolCall 将 Chat Completions 的 tool_call 同步到 Anthropic 格式的 content 数组中。\n386\t//\n387\t// 同步规则：\n388\t//   - 在 content 数组中查找或创建对应的 tool_use 块\n389\t//   - 将 function name 映射为 tool_use 的 name\n390\t//   - 将 arguments JSON 解析后映射为 tool_use 的 input\n391\t//   - thinking 块的存在会影响工具调用块在 content 中的索引偏移\n392\tfunc (r *SSEReassembler) mirrorToolCall(idx int, tc map[string]any) {\n393\t\tcontent := r.snap[\"content\"].([]any)\n394\t\t// 如果存在 thinking 块，工具调用的位置需要偏移 1\n395\t\toffset := 1\n396\t\tfor _, b := range content {\n397\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n398\t\t\t\toffset = 2\n399\t\t\t\tbreak\n400\t\t\t}\n401\t\t}\n402\t\ttarget := idx + offset\n403\t\tfor len(content) <= target {\n404\t\t\tcontent = append(content, map[string]any{\"type\": \"tool_use\", \"id\": \"\", \"name\": \"\", \"input\": map[string]any{}})\n405\t\t}\n406\t\tblock := content[target].(map[string]any)\n407\t\tif id := strVal(tc[\"id\"]); id != \"\" {\n408\t\t\tblock[\"id\"] = id\n409\t\t}\n410\t\tif fn, ok := tc[\"function\"].(map[string]any); ok {\n411\t\t\tif n := strVal(fn[\"name\"]); n != \"\" {\n412\t\t\t\tblock[\"name\"] = n\n413\t\t\t}\n414\t\t\tif args := strVal(fn[\"arguments\"]); args != \"\" {\n415\t\t\t\tvar parsed any\n416\t\t\t\tif json.Unmarshal([]byte(args), &parsed) == nil {\n417\t\t\t\t\tblock[\"input\"] = parsed\n418\t\t\t\t}\n419\t\t\t}\n420\t\t}\n421\t\tr.snap[\"content\"] = content\n422\t}\n423\t\n424\t// mergeChatUsage 将 OpenAI Chat Completions 的 usage 数据标准化后合并到快照。\n425\tfunc (r *SSEReassembler) mergeChatUsage(u map[string]any) {\n426\t\tr.snap[\"usage\"] = usage.NormalizeUsage(u)\n427\t}\n428\t\n429\t// --- 辅助函数 ---\n430\t\n431\t// deepCopy 通过 JSON 序列化/反序列化实现 map 的深拷贝。\n432\tfunc deepCopy(m map[string]any) map[string]any {\n433\t\tif m == nil {\n434\t\t\treturn nil\n435\t\t}\n436\t\tdata, _ := json.Marshal(m)\n437\t\tresult := make(map[string]any)\n438\t\t_ = json.Unmarshal(data, &result)\n439\t\treturn result\n440\t}\n441\t\n442\t// float64Val 将任意数值类型转换为 float64。\n443\t// 支持 float64、int、int64；不支持的类型返回 0。\n444\tfunc float64Val(v any) float64 {\n445\t\tswitch n := v.(type) {\n446\t\tcase float64:\n447\t\t\treturn n\n448\t\tcase int:\n449\t\t\treturn float64(n)\n450\t\tcase int64:\n451\t\t\treturn float64(n)\n452\t\t}\n453\t\treturn 0\n454\t}\n455\t\n456\t// strVal 将任意值转换为字符串。\n457\t// nil 返回空字符串，string 类型直接返回，其他类型使用 fmt.Sprintf 格式化。\n458\tfunc strVal(v any) string {\n459\t\tif v == nil {\n460\t\t\treturn \"\"\n461\t\t}\n462\t\tif s, ok := v.(string); ok {\n463\t\t\treturn s\n464\t\t}\n465\t\treturn fmt.Sprintf(\"%v\", v)\n466\t}\n467\t\n468\t// fieldStr 从 map 中安全获取字段值。\n469\tfunc fieldStr(m map[string]any, key string) any {\n470\t\tv, _ := m[key]\n471\t\treturn v\n472\t}\n473\t\n474\t// sliceField 从 map 中获取 []any 类型的字段，如果不存在或类型不匹配则返回 nil。\n475\tfunc sliceField(m map[string]any, key string) []any {\n476\t\tv, _ := m[key].([]any)\n477\t\tif v == nil {\n478\t\t\treturn nil\n479\t\t}\n480\t\treturn v\n481\t}\n482\t"}]}
