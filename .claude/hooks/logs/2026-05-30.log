issueSvc := service.NewIssueService(s.Issues())\n54\t\trouter := api.NewRouter(api.Handlers{\n55\t\t\tIssue: api.NewIssueHandler(issueSvc),\n56\t\t})\n57\t\n58\t\tsrv := httptest.NewServer(router)\n59\t\tt.Cleanup(srv.Close)\n60\t\n61\t\treturn &testEnv{srv: srv, store: s}\n62\t}\n63\t\n64\tfunc claimViaAPI(t *testing.T, url, repo string, number int, sessionID string) *http.Response {\n65\t\tt.Helper()\n66\t\tbody := `{\"repo_full_name\":\"` + repo + `\",\"issue_number\":` + strconv.Itoa(number) + `,\"session_id\":\"` + sessionID + `\"}`\n67\t\tresp, err := http.Post(url+\"/api/issue/claim\", \"application/json\", strings.NewReader(body))\n68\t\tif err != nil {\n69\t\t\tt.Fatal(err)\n70\t\t}\n71\t\treturn resp\n72\t}\n73\t\n74\tfunc statusViaAPI(t *testing.T, url, repo string, number int, sessionID, status string) *http.Response {\n75\t\tt.Helper()\n76\t\tbody := `{\"repo_full_name\":\"` + repo + `\",\"issue_number\":` + strconv.Itoa(number) + `,\"session_id\":\"` + sessionID + `\",\"status\":\"` + status + `\"}`\n77\t\tresp, err := http.Post(url+\"/api/issue/status\", \"application/json\", strings.NewReader(body))\n78\t\tif err != nil {\n79\t\t\tt.Fatal(err)\n80\t\t}\n81\t\treturn resp\n82\t}\n83\t\n84\tfunc releaseSessionViaAPI(t *testing.T, url, sessionID string) *http.Response {\n85\t\tt.Helper()\n86\t\tbody := `{\"session_id\":\"` + sessionID + `\"}`\n87\t\tresp, err := http.Post(url+\"/api/issue/release-session\", \"application/json\", strings.NewReader(body))\n88\t\tif err != nil {\n89\t\t\tt.Fatal(err)\n90\t\t}\n91\t\treturn resp\n92\t}\n93\t\n94\t// --- T12/T13: Recovery tests ---\n95\t\n96\tfunc TestRecovery_StatePreservedAcrossRestart(t *testing.T) {\n97\t\t// Phase 1: Create DB, seed data, start server\n98\t\tenv, dbPath := setupDegradationTest(t)\n99\t\n100\t\tclaimViaAPI(t, env.srv.URL, \"test/repo\", 10, \"sess_a\")\n101\t\tstatusViaAPI(t, env.srv.URL, \"test/repo\", 10, \"sess_a\", \"fixing\")\n102\t\n103\t\t// Phase 2: Shutdown server\n104\t\tenv.srv.Close()\n105\t\tenv.store.Close()\n106\t\n107\t\t// Phase 3: Start new server with same DB\n108\t\tenv2 := setupDegradationTestWithDB(t, dbPath)\n109\t\tt.Cleanup(func() { os.Remove(dbPath) })\n110\t\n111\t\t// Phase 4: Verify state is preserved\n112\t\tdb := env2.store.DB()\n113\t\tvar status, sid string\n114\t\terr := db.QueryRow(\n115\t\t\t`SELECT status, session_id FROM issue_claims WHERE repo_full_name = ? AND issue_number = ?`,\n116\t\t\t\"test/repo\", 10,\n117\t\t).Scan(&status, &sid)\n118\t\tif err != nil {\n119\t\t\tt.Fatalf(\"failed to query issue: %v\", err)\n120\t\t}\n121\t\tif status != \"fixing\" {\n122\t\t\tt.Errorf(\"expected status=fixing, got %s\", status)\n123\t\t}\n124\t\tif sid != \"sess_a\" {\n125\t\t\tt.Errorf(\"expected session_id=sess_a, got %s\", sid)\n126\t\t}\n127\t}\n128\t\n129\tfunc TestRecovery_ClaimFailsForAlreadyClaimedAfterRestart(t *testing.T) {\n130\t\tenv, dbPath := setupDegradationTest(t)\n131\t\n132\t\tclaimViaAPI(t, env.srv.URL, \"test/repo\", 20, \"sess_a\")\n133\t\n134\t\tenv.srv.Close()\n135\t\tenv.store.Close()\n136\t\n137\t\tenv2 := setupDegradationTestWithDB(t, dbPath)\n138\t\tt.Cleanup(func() { os.Remove(dbPath) })\n139\t\n140\t\tresp := claimViaAPI(t, env2.srv.URL, \"test/repo\", 20, \"sess_b\")\n141\t\tdefer resp.Body.Close()\n142\t\n143\t\tif resp.StatusCode != http.StatusConflict {\n144\t\t\tt.Fatalf(\"expected 409 Conflict, got %d\", resp.StatusCode)\n145\t\t}\n146\t\n147\t\tvar result map[string]interface{}\n148\t\treadJSON(t, resp, &result)\n149\t\tif result[\"success\"] == true {\n150\t\t\tt.Error(\"expected success=false for already claimed issue\")\n151\t\t}\n152\t}\n153\t\n154\tfunc TestRecovery_ReleaseSessionAfterRestart(t *testing.T) {\n155\t\tenv, dbPath := setupDegradationTest(t)\n156\t\n157\t\tclaimViaAPI(t, env.srv.URL, \"test/repo\", 30, \"sess_a\")\n158\t\tstatusViaAPI(t, env.srv.URL, \"test/repo\", 30, \"sess_a\", \"fixing\")\n159\t\n160\t\tenv.srv.Close()\n161\t\tenv.store.Close()\n162\t\n163\t\tenv2 := setupDegradationTestWithDB(t, dbPath)\n164\t\tt.Cleanup(func() { os.Remove(dbPath) })\n165\t\n166\t\tresp := releaseSessionViaAPI(t, env2.srv.URL, \"sess_a\")\n167\t\tdefer resp.Body.Close()\n168\t\n169\t\tvar result struct {\n170\t\t\tReleased []int `json:\"released\"`\n171\t\t\tCount    int   `json:\"count\"`\n172\t\t}\n173\t\treadJSON(t, resp, &result)\n174\t\n175\t\tif result.Count != 1 {\n176\t\t\tt.Fatalf(\"expected 1 released, got %d\", result.Count)\n177\t\t}\n178\t\tif len(result.Released) != 1 || result.Released[0] != 30 {\n179\t\t\tt.Errorf(\"expected released=[30], got %v\", result.Released)\n180\t\t}\n181\t}\n182\t\n183\t// --- T14: Malformed request tests ---\n184\t\n185\tfunc TestMalformedRequest_InvalidJSON(t *testing.T) {\n186\t\tenv, _ := setupDegradationTest(t)\n187\t\tt.Cleanup(func() { env.store.Close() })\n188\t\n189\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/claim\", \"application/json\", strings.NewReader(\"not json\"))\n190\t\tif err != nil {\n191\t\t\tt.Fatal(err)\n192\t\t}\n193\t\tdefer resp.Body.Close()\n194\t\n195\t\tif resp.StatusCode != http.StatusBadRequest {\n196\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n197\t\t}\n198\t}\n199\t\n200\tfunc TestMalformedRequest_EmptyRequiredFields(t *testing.T) {\n201\t\tenv, _ := setupDegradationTest(t)\n202\t\tt.Cleanup(func() { env.store.Close() })\n203\t\n204\t\ttests := []struct {\n205\t\t\tname string\n206\t\t\tbody string\n207\t\t}{\n208\t\t\t{\"empty repo\", `{\"repo_full_name\":\"\",\"issue_number\":1,\"session_id\":\"s1\"}`},\n209\t\t\t{\"zero issue_number\", `{\"repo_full_name\":\"r\",\"issue_number\":0,\"session_id\":\"s1\"}`},\n210\t\t\t{\"empty session_id\", `{\"repo_full_name\":\"r\",\"issue_number\":1,\"session_id\":\"\"}`},\n211\t\t}\n212\t\n213\t\tfor _, tt := range tests {\n214\t\t\tt.Run(tt.name, func(t *testing.T) {\n215\t\t\t\tresp, err := http.Post(env.srv.URL+\"/api/issue/claim\", \"application/json\", strings.NewReader(tt.body))\n216\t\t\t\tif err