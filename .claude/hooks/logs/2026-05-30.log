237\t\t}\n238\t\n239\t\t// Decompress if needed.\n240\t\tdecodeBytes := respBytes\n241\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n242\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n243\t\t\tvar reader io.ReadCloser\n244\t\t\tif encoding == \"gzip\" {\n245\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n246\t\t\t} else {\n247\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n248\t\t\t}\n249\t\t\tif reader != nil {\n250\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n251\t\t\t\t\tdecodeBytes = decoded\n252\t\t\t\t}\n253\t\t\t\t_ = reader.Close()\n254\t\t\t}\n255\t\t}\n256\t\n257\t\tvar respBody any\n258\t\tif len(decodeBytes) > 0 {\n259\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n260\t\t}\n261\t\n262\t\trecord := buildRecord(\n263\t\t\treqID, turn, durationMs,\n264\t\t\tr.Method, r.URL.RequestURI(),\n265\t\t\tr.Header, reqBody,\n266\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n267\t\t\trespBody,\n268\t\t\tnil,\n269\t\t\tp.target,\n270\t\t)\n271\t\n272\t\tif err := p.getWriter().Write(record); err != nil {\n273\t\t\tlog.Printf(\"[Turn %d] trace write error: %v\", turn, err)\n274\t\t}\n275\t\n276\t\t// Write response to client.\n277\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n278\t\tfor k, vals := range respHeaders {\n279\t\t\tfor _, v := range vals {\n280\t\t\t\tw.Header().Add(k, v)\n281\t\t\t}\n282\t\t}\n283\t\tw.WriteHeader(upstreamResp.StatusCode)\n284\t\t_, _ = w.Write(respBytes)\n285\t\n286\t\tlog.Printf(\"[Turn %d] ← %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n287\t}\n288\t\n289\tfunc buildRecord(\n290\t\treqID string, turn, durationMs int,\n291\t\tmethod, path string,\n292\t\treqHeaders http.Header, reqBody any,\n293\t\tstatus int, respHeaders http.Header,\n294\t\trespBody any,\n295\t\tsseEvents []map[string]any,\n296\t\tupstreamBaseURL string,\n297\t) map[string]any {\n298\t\trecord := map[string]any{\n299\t\t\t\"timestamp\":    time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n300\t\t\t\"request_id\":   reqID,\n301\t\t\t\"session_id\":   extractSessionID(reqBody),\n302\t\t\t\"turn\":         turn,\n303\t\t\t\"duration_ms\":  durationMs,\n304\t\t\t\"request\": map[string]any{\n305\t\t\t\t\"method\":  method,\n306\t\t\t\t\"path\":    path,\n307\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n308\t\t\t\t\"body\":    reqBody,\n309\t\t\t},\n310\t\t\t\"response\": map[string]any{\n311\t\t\t\t\"status\":  status,\n312\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n313\t\t\t\t\"body\":    respBody,\n314\t\t\t},\n315\t\t}\n316\t\tif len(sseEvents) > 0 {\n317\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n318\t\t}\n319\t\tif upstreamBaseURL != \"\" {\n320\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n321\t\t}\n322\t\treturn record\n323\t}\n324\t\n325\t// extractSessionID extracts session_id from request.body.metadata.user_id (JSON string).\n326\t// Claude Code sends: metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n327\tfunc extractSessionID(reqBody any) string {\n328\t\tbody, ok := reqBody.(map[string]any)\n329\t\tif !ok {\n330\t\t\treturn \"\"\n331\t\t}\n332\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n333\t\tif metadata == nil {\n334\t\t\treturn \"\"\n335\t\t}\n336\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n337\t\tif userIDRaw == \"\" {\n338\t\t\treturn \"\"\n339\t\t}\n340\t\tvar userData map[string]string\n341\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n342\t\t\treturn \"\"\n343\t\t}\n344\t\treturn userData[\"session_id\"]\n345\t}\n346\t\n347\t// handleInternal dispatches internal proxy endpoints.\n348\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n349\t\tswitch r.URL.Path {\n350\t\tcase \"/_internal/trace-init\":\n351\t\t\tp.handleTraceInit(w, r)\n352\t\tdefault:\n353\t\t\thttp.NotFound(w, r)\n354\t\t}\n355\t}\n356\t\n357\t// handleTraceInit receives session info from SessionStart hook and creates the trace writer.\n358\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n359\t\tif r.Method != http.MethodPost {\n360\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n361\t\t\treturn\n362\t\t}\n363\t\n364\t\tvar req struct {\n365\t\t\tSessionID     string `json:\"session_id\"`\n366\t\t\tMachineID     string `json:\"machine_id\"`\n367\t\t\tProjectSlug   string `json:\"project_slug\"`\n368\t\t\tTranscriptPath string `json:\"transcript_path\"`\n369\t\t}\n370\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n371\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n372\t\t\treturn\n373\t\t}\n374\t\n375\t\tif req.SessionID == \"\" {\n376\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n377\t\t\treturn\n378\t\t}\n379\t\n380\t\tmachineID := req.MachineID\n381\t\tif machineID == \"\" {\n382\t\t\tmachineID = trace.MachineID()\n383\t\t}\n384\t\n385\t\tprojectSlug := req.ProjectSlug\n386\t\tif projectSlug == \"\" {\n387\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n388\t\t\tif projectSlug == \"\" {\n389\t\t\t\tprojectSlug = trace.DetectProjectName()\n390\t\t\t}\n391\t\t}\n392\t\n393\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n394\t\twriter, err := trace.NewTraceWriter(tracePath)\n395\t\tif err != nil {\n396\t\t\tlog.Printf(\"trace-init: failed to create writer: %v\", err)\n397\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n398\t\t\treturn\n399\t\t}\n400\t\n401\t\t// Close fallback writer if it exists\n402\t\tif p.fallbackW != nil {\n403\t\t\tp.fallbackW.Close()\n404\t\t\tp.fallbackW = nil\n405\t\t}\n406\t\n407\t\tp.writer = writer\n408\t\tlog.Printf(\"trace initialized: %s\", tracePath)\n409\t\n410\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n411\t\tjson.NewEncoder(w).Encode(map[string]string{\n412\t\t\t\"status\":     \"ok\",\n413\t\t\t\"trace_path\": tracePath,\n414\t\t})\n415\t}\n416\t\n417\t// getWriter returns the session writer, or creates a fallback if not yet initialized.\n418\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n419\t\tif p.writer != nil {\n420\t\t\treturn p.writer\n421\t\t}\n422\t\t// Fallback: create a temp writer using old-style path\n423\t\tif p.fallbackW == nil {\n424\t\t\tfallbackPath := trace.NewTracePath(p.baseDir)\n425\t\t\tw, err := trace.NewTraceWriter(fallbackPath)\n426\t\t\tif err != nil {\n427\t\t\t\tlog.Printf(\"fallback trace: %v\", err)\n428\t\t\t\treturn nil\n429\t\t\t}\n430\t\t\tp.fallbackW = w\n431\t\t\tlog.Printf(\"using fallback trace: %s\", fallbackPath)\n432\t\t}\n433\t\treturn p.fallbackW\n434\t}\n435\t\n436\t// Summary returns aggregate statistics for the active trace writer.\n437\tfunc (p *ReverseProxy) Summary() map[string]any {\n438\t\tif w := p.getWriter(); w != nil {\n439\t\t\treturn w.Summary()\n440\t\t}\n441\t\treturn map[string]any{\n442\t\t\t\"api_calls\":           0,\n443\t\t\t\"input_tokens\":        int64(0),\n444\t\t\t\"output_tokens\":       int64(0),\n445\t\t\t\"cache_read_tokens\":   int64(0),\n446\t\t\t\"cache_create_tokens\": int64(0),\n447\t\t}\n448\t}\n449\t"}]}
