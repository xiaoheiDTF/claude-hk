可测试的 PRs ===\"\n38\t    prs=$(_gh pr list --state open --json number,title,headRefName 2>/dev/null)\n39\t    if [ -n \"$prs\" ] && [ \"$prs\" != \"[]\" ]; then\n40\t      echo \"$prs\" | jq -r '.[] | \"  PR #\\(.number): \\(.title) (分支: \\(.headRefName))\"'\n41\t    else\n42\t      echo \"(暂无 open PRs)\"\n43\t    fi\n44\t  fi\n45\tfi\n46\t\n47\tskill_log \"INFO\" \"[inject] issue-test context injected for #$ISSUE_NUM\"\n48\t"}]}
