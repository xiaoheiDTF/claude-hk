Push(os.Args[2:])\n45\t\t\t\treturn\n46\t\t\tcase \"session-pull\":\n47\t\t\t\trunSessionPull(os.Args[2:])\n48\t\t\t\treturn\n49\t\t\tcase \"session-status\":\n50\t\t\t\trunSessionStatus(os.Args[2:])\n51\t\t\t\treturn\n52\t\t\tcase \"backend\":\n53\t\t\t\trunBackend(os.Args[2:])\n54\t\t\t\treturn\n55\t\t\tcase \"help\", \"--help\", \"-h\":\n56\t\t\t\tprintUsage()\n57\t\t\t\treturn\n58\t\t\t}\n59\t\t}\n60\t\n61\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n62\t\trunProxy(os.Args[1:])\n63\t}\n64\t\n65\t// printUsage 打印命令行使用帮助信息到标准输出。\n66\tfunc printUsage() {\n67\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n68\t\tfmt.Println()\n69\t\tfmt.Println(\"Usage:\")\n70\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n71\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n72\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n73\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n74\t\tfmt.Println()\n75\t\tfmt.Println(\"Proxy flags:\")\n76\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n77\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n78\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n79\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n80\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n81\t\tfmt.Println()\n82\t\tfmt.Println(\"Session-push flags:\")\n83\t\tfmt.Println(\"  --all                  Collect all projects\")\n84\t\tfmt.Println(\"  --force                Overwrite existing files\")\n85\t\tfmt.Println(\"  --dry-run              Preview only\")\n86\t\tfmt.Println(\"  --project NAME         Override project name\")\n87\t\tfmt.Println()\n88\t\tfmt.Println(\"Session-pull flags:\")\n89\t\tfmt.Println(\"  --all                  Restore all projects\")\n90\t\tfmt.Println(\"  --project NAME         Override project name\")\n91\t\tfmt.Println(\"  --dry-run              Preview only\")\n92\t\tfmt.Println()\n93\t\tfmt.Println(\"Session-status flags:\")\n94\t\tfmt.Println(\"  --verbose              Show file-level details\")\n95\t}\n96\t\n97\t// runProxy 是默认的代理模式主逻辑。\n98\t//\n99\t// 工作流程：\n100\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n101\t//  2. 自动探测上游 API 目标地址\n102\t//  3. 启动本地反向代理监听指定端口\n103\t//  4. 解析 Claude Code 可执行文件路径\n104\t//  5. 构建子进程环境变量（注入代理地址）\n105\t//  6. 启动 Claude Code 作为子进程\n106\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n107\t//  8. 子进程退出后打印 API 调用统计摘要\n108\tfunc runProxy(args []string) {\n109\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n110\t\tvar (\n111\t\t\ttapTarget    string // 上游 API 目标地址\n112\t\t\ttapPort      int    // 本地代理监听端口\n113\t\t\ttapOutputDir string // 追踪记录输出目录\n114\t\t\ttapVerbose   bool   // 是否启用详细日志\n115\t\t)\n116\t\n117\t\tvar claudeArgs []string\n118\t\tfor i := 0; i < len(args); i++ {\n119\t\t\targ := args[i]\n120\t\t\tswitch {\n121\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n122\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n123\t\t\t\ti++\n124\t\t\t\ttapTarget = args[i]\n125\t\t\t// 解析 --tap-target=URL 形式\n126\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n127\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n128\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n129\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n130\t\t\t\ti++\n131\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n132\t\t\t// 解析 --tap-port=PORT 形式\n133\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n134\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n135\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n136\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n137\t\t\t\ti++\n138\t\t\t\ttapOutputDir = args[i]\n139\t\t\t// 解析 --tap-output-dir=DIR 形式\n140\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n141\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n142\t\t\t// 启用详细日志\n143\t\t\tcase arg == \"--tap-verbose\":\n144\t\t\t\ttapVerbose = true\n145\t\t\t// -- 或 --claude 后的所有参数都传递给 Claude Code\n146\t\t\tcase arg == \"--\", arg == \"--claude\":\n147\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n148\t\t\t\ti = len(args) // 停止解析\n149\t\t\t// 未知的 --tap-* 标志，直接忽略\n150\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n151\t\t\t// 其他参数视为 Claude Code 的参数\n152\t\t\tdefault:\n153\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n154\t\t\t}\n155\t\t}\n156\t\n157\t\t// 如果未指定输出目录，使用默认追踪目录\n158\t\tif tapOutputDir == \"\" {\n159\t\t\ttapOutputDir = trace.DefaultTraceDir()\n160\t\t}\n161\t\n162\t\t// 根据详细程度重新初始化日志器\n163\t\tif tapVerbose {\n164\t\t\tlogger.Init(tapOutputDir, true, logger.DEBUG)\n165\t\t} else {\n166\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n167\t\t}\n168\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n169\t\n170\t\t// 探测上游目标地址：如果用户未指定，则自动探测\n171\t\ttarget := tapTarget\n172\t\tif target == \"\" {\n173\t\t\ttarget = config.DetectTarget(&config.ClaudeClient)\n174\t\t}\n175\t\tif tapVerbose {\n176\t\t\tlog.Printf(\"upstream target: %s\", target)\n177\t\t}\n178\t\n179\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n180\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n181\t\tport := tapPort\n182\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n183\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n184\t\tif err != nil {\n185\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n186\t\t}\n187\t\t// 函数退出时停止代理\n188\t\tdefer rp.Stop()\n189\t\n190\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n191\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n192\t\n193\t\t// 解析 Claude Code 可执行文件路径\n194\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n195\t\tif err != nil {\n196\t\t\tlog.Fatal(err)\n197\t\t}\n198\t\n199\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n200\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n201\t\n202\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n203\t\tfinalArgs := claudeArgs\n204\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n205\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n206\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n207\t\t}\n208\t\n209\t\t// 启动 Claude Code 作为子进程\n210\t\tcmd := exec.Command(claudePath, finalArgs...)\n211\t\tcmd.Env = childEnv\n212\t\tcmd.Stdin = os.Stdin\n213\t\tcmd.Stdout = os.Stdout\n214\t\tcmd.Stderr = os.Stderr\n215\t\n216\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n217\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n218\t\n219\t\tif err := cmd.Start(); err != nil {\n220\t\t\tlog.Fatalf(\"start claude: %v\", err)\n221\t\t}\n222\t\n223\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n224\t\tsigChan := make(chan os.Signal, 2)\n225\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n226\t\n227\t\tgo func() {\n228\t\t\tsigCount := 0\n229\t\t\tfor sig := range sigChan {\n230\t\t\t\tsigCount++\n231\t\t\t\tif sigCount == 1 {\n232\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n233\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n234\t\t\t\t\t_ = cmd.Process.Signal(sig)\n235\t\t\t\t} else {\n236\t\t\t\t\t// 再次收到信号：强制终止子进程\n237\t\t\t\t\t_ = cmd.Process.Kill()\n238\t\t\t\t}\n239\t\t\t}\n240\t\t}()\n241\t\n242\t\t// 等待子进程结束\n243\t\twaitErr := cmd.Wait()\n244\t\n245\t\t// 停止信号处理器，释放资源\n246\t\tsignal.Stop(sigChan)\n247\t\tclose(sigChan)\n248\t\n249\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n250\t\tsummary := rp.Summary()\n251\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n252\t\tif waitErr != nil {\n253\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n254\t\t}\n255\t\tfmt.Printf(\"\\n\")\n256\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n257\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n258\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n259\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n260\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n261\t\tfmt.Printf(\"   Trace: %s\\n\", tapOutputDir)\n262\t}\n263\t\n264\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n265\t//\n266\t// 支持的参数：\n267\t//   --all       收集所有项目的会话\n268\t//   --force     覆盖已存在的会话文件\n269\t//   --dry-run   仅预览，不实际执行\n270\t//   --project   指定项目名称，覆盖自动检测\n271\tfunc runSessionPush(args []string) {\n272\t\tvar opts session.PushOptions\n273\t\tfor i := 0; i < len(args); i++ {\n274\t\t\targ := args[i]\n275\t\t\tswitch {\n276\t\t\tcase arg == \"--all\":\n277\t\t\t\topts.All = true\n278\t\t\tcase arg == \"--force\":\n279\t\t\t\topts.Force = true\n280\t\t\tcase arg == \"--dry-run\":\n281\t\t\t\topts.DryRun = true\n282\t\t\tcase arg == \"--project\" && i+1 < len(args):\n283\t\t\t\ti++\n284\t\t\t\topts.Project = args[i]\n285\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n286\t\t\t\topts.Project = arg[len(\"--project=\"):]\n287\t\t\t}\n288\t\t}\n289\t\n290\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n291\t\tresults, err := session.SessionPush(opts)\n292\t\tif err != nil {\n293\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n294\t\t\tos.Exit(1)\n295\t\t}\n296\t\n297\t\t// 汇总各项目的收集结果\n298\t\tfmt.Println()\n299\t\ttotalNew, totalSkipped := 0, 0\n300\t\tfor _, r := range results {\n301\t\t\ttotalNew += r.SessionsNew\n302\t\t\ttotalSkipped += r.SessionsSkipped\n303\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n304\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n305\t\t\t}\n306\t\t}\n307\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n308\t}\n309\t\n310\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n311\t//\n312\t// 支持的参数：\n313\t//   --all       恢复所有项目的会话\n314\t//   --dry-run   仅预览，不实际执行\n315\t//   --project   指定项目名称，覆盖自动检测\n316\tfunc runSessionPull(args []string) {\n317\t\tvar opts session.PullOptions\n318\t\tfor i := 0; i < len(args); i++ {\n319\t\t\targ := args[i]\n320\t\t\tswitch {\n321\t\t\tcase arg == \"--all\":\n322\t\t\t\topts.All = true\n323\t\t\tcase arg == \"--dry-run\":\n324\t\t\t\topts.DryRun = true\n325\t\t\tcase arg == \"--project\" && i+1 < len(args):\n326\t\t\t\ti++\n327\t\t\t\topts.Project = args[i]\n328\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n329\t\t\t\topts.Project = arg[len(\"--project=\"):]\n330\t\t\t}\n331\t\t}\n332\t\n333\t\tfmt.Println(\"📤 Restoring sessions...\")\n334\t\tresults, err := session.SessionPull(opts)\n335\t\tif err != nil {\n336\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n337\t\t\tos.Exit(1)\n338\t\t}\n339\t\n340\t\t// 汇总各项目的恢复结果\n341\t\tfmt.Println()\n342\t\ttotalRestored, totalSkipped := 0, 0\n343\t\tfor _, r := range results {\n344\t\t\ttotalRestored += r.SessionsRestored\n345\t\t\ttotalSkipped += r.SessionsSkipped\n346\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n347\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n348\t\t\t}\n349\t\t}\n350\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n351\t}\n352\t\n353\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n354\t//\n355\t// 支持的参数：\n356\t//   --verbose   显示文件级别的详细信息\n357\tfunc runSessionStatus(args []string) {\n358\t\tvar opts session.StatusOptions\n359\t\tfor i := 0; i < len(args); i++ {\n360\t\t\targ := args[i]\n361\t\t\tswitch {\n362\t\t\tcase arg == \"--verbose\":\n363\t\t\t\topts.Verbose = true\n364\t\t\t}\n365\t\t}\n366\t\n367\t\tif err := session.SessionStatus(opts); err != nil {\n368\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n369\t\t\tos.Exit(1)\n370\t\t}\n371\t}\n372\t\n373\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n374\t// 如果参数中包含空格或制表符，则使用引号包裹。\n375\tfunc formatArgs(args []string) string {\n376\t\tresult := \"\"\n377\t\tfor _, a := range args {\n378\t\t\tif containsSpace(a) {\n379\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n380\t\t\t} else {\n381\t\t\t\tresult += \" \" + a\n382\t\t\t}\n383\t\t}\n384\t\treturn strings.TrimSpace(result)\n385\t}\n386\t\n387\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n388\tfunc containsSpace(s string) bool {\n389\t\tfor _, c := range s {\n390\t\t\tif c == ' ' || c == '\\t' {\n391\t\t\t\treturn true\n392\t\t\t}\n393\t\t}\n394\t\treturn false\n395\t}\n396\t"}]}
