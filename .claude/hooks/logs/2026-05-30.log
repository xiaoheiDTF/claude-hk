dy,omitempty\"`      // 响应体（JSON 对象，与 RawSSE 二选一）\n39\t\tRawSSE  string            `json:\"raw_sse,omitempty\"`   // 原始 SSE 流文本（与 Body 二选一）\n40\t\tGzip    bool              `json:\"gzip,omitempty\"`      // 是否使用 gzip 压缩响应体\n41\t}\n42\t\n43\t// ExpectedTrace 定义需要在追踪输出中验证的字段。\n44\ttype ExpectedTrace struct {\n45\t\tSessionID         string `json:\"session_id\"`                    // 预期会话标识\n46\t\tInputTokens       int64  `json:\"input_tokens,omitempty\"`        // 预期输入 Token 数量\n47\t\tOutputTokens      int64  `json:\"output_tokens,omitempty\"`       // 预期输出 Token 数量\n48\t\tCacheReadTokens   int64  `json:\"cache_read_tokens,omitempty\"`   // 预期缓存读取 Token 数量\n49\t\tCacheCreateTokens int64  `json:\"cache_create_tokens,omitempty\"` // 预期缓存创建 Token 数量\n50\t}\n51\t\n52\t// LoadFixture 从 testdata/fixtures/ 目录读取夹具 JSON 文件。\n53\t//\n54\t// 搜索逻辑：从当前工作目录开始向上查找最多 10 层目录，\n55\t// 定位到 testdata/fixtures/{name} 文件。\n56\t// 如果读取或解析失败，调用 t.Fatalf 终止测试。\n57\tfunc LoadFixture(t *testing.T, name string) *Fixture {\n58\t\tt.Helper()\n59\t\tpath := findUpward(t, filepath.Join(\"testdata\", \"fixtures\", name))\n60\t\tdata, err := os.ReadFile(path)\n61\t\tif err != nil {\n62\t\t\tt.Fatalf(\"read fixture %s: %v\", name, err)\n63\t\t}\n64\t\tvar f Fixture\n65\t\tif err := json.Unmarshal(data, &f); err != nil {\n66\t\t\tt.Fatalf(\"parse fixture %s: %v\", name, err)\n67\t\t}\n68\t\treturn &f\n69\t}\n70\t\n71\t// FindDir 从当前目录向上搜索指定的相对路径目录。\n72\t//\n73\t// 最多向上搜索 10 层父目录，如果未找到则调用 t.Skip 跳过当前测试。\n74\tfunc FindDir(t *testing.T, relPath string) string {\n75\t\tt.Helper()\n76\t\tdir, _ := os.Getwd()\n77\t\tfor i := 0; i < 10; i++ {\n78\t\t\tcandidate := filepath.Join(dir, relPath)\n79\t\t\tif info, err := os.Stat(candidate); err == nil && info.IsDir() {\n80\t\t\t\treturn candidate\n81\t\t\t}\n82\t\t\tparent := filepath.Dir(dir)\n83\t\t\tif parent == dir {\n84\t\t\t\tbreak\n85\t\t\t}\n86\t\t\tdir = parent\n87\t\t}\n88\t\tt.Skipf(\"%s not found\", relPath)\n89\t\treturn \"\"\n90\t}\n91\t\n92\t// findUpward 从当前目录向上搜索指定的相对路径文件。\n93\t//\n94\t// 最多向上搜索 10 层父目录，如果未找到则调用 t.Fatal 终止测试。\n95\tfunc findUpward(t *testing.T, relPath string) string {\n96\t\tt.Helper()\n97\t\tdir, _ := os.Getwd()\n98\t\tfor i := 0; i < 10; i++ {\n99\t\t\tcandidate := filepath.Join(dir, relPath)\n100\t\t\tif _, err := os.Stat(candidate); err == nil {\n101\t\t\t\treturn candidate\n102\t\t\t}\n103\t\t\tparent := filepath.Dir(dir)\n104\t\t\tif parent == dir {\n105\t\t\t\tbreak\n106\t\t\t}\n107\t\t\tdir = parent\n108\t\t}\n109\t\tt.Fatalf(\"file not found: %s\", relPath)\n110\t\treturn \"\"\n111\t}\n112\t\n113\t// CreateMockServer 创建一个 httptest.Server，按夹具配置返回模拟响应。\n114\t//\n115\t// 响应生成逻辑：\n116\t//   - 如果 RawSSE 非空，按 SSE 格式返回（支持流式刷新）\n117\t//   - 如果 Gzip 为 true，对响应体进行 gzip 压缩\n118\t//   - 否则返回 JSON 序列化后的 Body\n119\tfunc CreateMockServer(t *testing.T, fx *Fixture) *httptest.Server {\n120\t\tt.Helper()\n121\t\treturn httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n122\t\t\tfor k, v := range fx.Response.Headers {\n123\t\t\t\tw.Header().Set(k, v)\n124\t\t\t}\n125\t\t\tw.WriteHeader(fx.Response.Status)\n126\t\n127\t\t\tif fx.Response.RawSSE != \"\" {\n128\t\t\t\tflusher, _ := w.(http.Flusher)\n129\t\t\t\t_, _ = io.WriteString(w, fx.Response.RawSSE)\n130\t\t\t\tif flusher != nil {\n131\t\t\t\t\tflusher.Flush()\n132\t\t\t\t}\n133\t\t\t\treturn\n134\t\t\t}\n135\t\n136\t\t\tbodyBytes, err := json.Marshal(fx.Response.Body)\n137\t\t\tif err != nil {\n138\t\t\t\tt.Fatalf(\"marshal response body: %v\", err)\n139\t\t\t}\n140\t\n141\t\t\tif fx.Response.Gzip {\n142\t\t\t\tw.Header().Set(\"Content-Encoding\", \"gzip\")\n143\t\t\t\tvar buf bytes.Buffer\n144\t\t\t\tgw := gzip.NewWriter(&buf)\n145\t\t\t\t_, _ = gw.Write(bodyBytes)\n146\t\t\t\tgw.Close()\n147\t\t\t\t_, _ = w.Write(buf.Bytes())\n148\t\t\t\treturn\n149\t\t\t}\n150\t\n151\t\t\t_, _ = w.Write(bodyBytes)\n152\t\t}))\n153\t}\n154\t\n155\t// SendRequestThroughProxy 将夹具中定义的请求发送到代理服务器。\n156\t//\n157\t// 请求体会被 JSON 序列化，目标地址为 proxyURL + fx.Request.Path。\n158\t// 如果请求构建或发送失败，调用 t.Fatalf 终止测试。\n159\tfunc SendRequestThroughProxy(t *testing.T, fx *Fixture, proxyURL string) *http.Response {\n160\t\tt.Helper()\n161\t\tbodyBytes, err := json.Marshal(fx.Request.Body)\n162\t\tif err != nil {\n163\t\t\tt.Fatalf(\"marshal request body: %v\", err)\n164\t\t}\n165\t\treq, err := http.NewRequest(fx.Request.Method, proxyURL+fx.Request.Path, bytes.NewReader(bodyBytes))\n166\t\tif err != nil {\n167\t\t\tt.Fatalf(\"create request: %v\", err)\n168\t\t}\n169\t\tfor k, v := range fx.Request.Headers {\n170\t\t\treq.Header.Set(k, v)\n171\t\t}\n172\t\tresp, err := http.DefaultClient.Do(req)\n173\t\tif err != nil {\n174\t\t\tt.Fatalf(\"send request: %v\", err)\n175\t\t}\n176\t\treturn resp\n177\t}\n178\t\n179\t// ReadTraceRecords 读取 JSONL 格式的追踪文件，返回所有解析后的记录。\n180\t//\n181\t// 逐行解析，跳过空行，忽略无法解析的行。\n182\tfunc ReadTraceRecords(t *testing.T, path string) []map[string]any {\n183\t\tt.Helper()\n184\t\tdata, err := os.ReadFile(path)\n185\t\tif err != nil {\n186\t\t\tt.Fatalf(\"read trace file: %v\", err)\n187\t\t}\n188\t\tvar records []map[string]any\n189\t\tfor _, line := range strings.Split(string(data), \"\\n\") {\n190\t\t\tline = strings.TrimSpace(line)\n191\t\t\tif line == \"\" {\n192\t\t\t\tcontinue\n193\t\t\t}\n194\t\t\tvar r map[string]any\n195\t\t\tif err := json.Unmarshal([]byte(line), &r); err != nil {\n196\t\t\t\tcontinue\n197\t\t\t}\n198\t\t\trecords = append(records, r)\n199\t\t}\n200\t\treturn records\n201\t}\n202\t\n203\t// AssertTrace 验证单条追踪记录是否符合预期。\n204\t//\n205\t// 检查项：\n206\t//   - session_id 是否匹配\n207\t//   - response.body.usage 中的 input_tokens、output_tokens、\n208\t//     cache_read_input_tokens、cache_creation_input_tokens 是否匹配\n209\t//\n210\t// 预期值为 0 的字段会被跳过验证（表示不检查该项）。\n211\tfunc AssertTrace(t *testing.T, record map[string]any, expected ExpectedTrace) {\n212\t\tt.Helper()\n213\t\tif expected.SessionID != \"\" {\n214\t\t\tgot, _ := record[\"session_id\"].(string)\n215\t\t\tif got != expected.SessionID {\n216\t\t\t\tt.Errorf(\"session_id: got %q, want %q\", got, expected.SessionID)\n217\t\t\t}\n218\t\t}\n219\t\tresp, _ := record[\"response\"].(map[string]any)\n220\t\tif resp == nil {\n221\t\t\tt.Fatal(\"trace record has no response field\")\n222\t\t}\n223\t\tbody, _ := resp[\"body\"].(map[string]any)\n224\t\tif body == nil {\n225\t\t\treturn\n226\t\t}\n227\t\tusage, _ := body[\"usage\"].(map[string]any)\n228\t\tif usage == nil {\n229\t\t\tusage = body\n230\t\t}\n231\t\tassertToken := func(key string, expected int64) {\n232\t\t\tif expected == 0 {\n233\t\t\t\treturn\n234\t\t\t}\n235\t\t\tgot, ok := toInt64(usage[key])\n236\t\t\tif !ok {\n237\t\t\t\treturn\n238\t\t\t}\n239\t\t\tif got != expected {\n240\t\t\t\tt.Errorf(\"%s: got %d, want %d\", key, got, expected)\n241\t\t\t}\n242\t\t}\n243\t\tassertToken(\"input_tokens\", expected.InputTokens)\n244\t\tassertToken(\"output_tokens\", expected.OutputTokens)\n245\t\tassertToken(\"cache_read_input_tokens\", expected.CacheReadTokens)\n246\t\tassertToken(\"cache_creation_input_tokens\", expected.CacheCreateTokens)\n247\t}\n248\t\n249\t// AssertResponseStatus 检查 HTTP 响应状态码是否与预期一致。\n250\tfunc AssertResponseStatus(t *testing.T, resp *http.Response, expected int) {\n251\t\tt.Helper()\n252\t\tif resp.StatusCode != expected {\n253\t\t\tt.Errorf(\"status: got %d, want %d\", resp.StatusCode, expected)\n254\t\t}\n255\t}\n256\t\n257\t// DrainAndClose 读取响应体的全部内容并关闭响应体。\n258\t// 如果读取失败，调用 t.Fatalf 终止测试。\n259\tfunc DrainAndClose(t *testing.T, resp *http.Response) []byte {\n260\t\tt.Helper()\n261\t\tdefer resp.Body.Close()\n262\t\tdata, err := io.ReadAll(resp.Body)\n263\t\tif err != nil {\n264\t\t\tt.Fatalf(\"read response body: %v\", err)\n265\t\t}\n266\t\treturn data\n267\t}\n268\t\n269\t// TempTraceFile 在临时目录中创建一个追踪文件并返回其路径。\n270\tfunc TempTraceFile(t *testing.T) string {\n271\t\tt.Helper()\n272\t\treturn filepath.Join(t.TempDir(), \"trace.jsonl\")\n273\t}\n274\t\n275\t// toInt64 将任意数值类型转换为 int64。\n276\t// 支持 float64、int、int64；不支持的类型返回 (0, false)。\n277\tfunc toInt64(v any) (int64, bool) {\n278\t\tswitch n := v.(type) {\n279\t\tcase float64:\n280\t\t\treturn int64(n), true\n281\t\tcase int:\n282\t\t\treturn int64(n), true\n283\t\tcase int64:\n284\t\t\treturn n, true\n285\t\tdefault:\n286\t\t\treturn 0, false\n287\t\t}\n288\t}\n289\t\n290\t// FixtureName 返回夹具的名称和描述，用于测试错误信息。\n291\tfunc FixtureName(fx *Fixture) string {\n292\t\treturn fmt.Sprintf(\"%s (%s)\", fx.Name, fx.Description)\n293\t}\n294\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\sse\\reassembler.go"},"tool_use_id":"call_d4d36aece50e4d749adee9f4","tool_response":"1\tpackage sse\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/usage\"\n11\t)\n12\t\n13\t// SSEReassembler 解析原始 SSE（Server-Sent Events）字节流，并将流式片段重组成完整的 API 响应。\n14\t//\n15\t// 支持的协议：\n16\t//   - Anthropic Messages API Streaming\n17\t//   - OpenAI Chat Completions Streaming\n18\t//   - OpenAI Responses API Streaming\n19\t//\n20\t// 使用方式：\n21\t//\n22\t//\tr := sse.NewSSEReassembler()\n23\t//\tr.FeedBytes(chunk)       // 多次调用，分块送入 SSE 数据\n24\t//\tsnapshot := r.Reconstruct() // 获取当前累积的完整响应快照\n25\t//\tevents := r.Events       // 获取所有解析出的原始事件列表\n26\ttype SSEReassembler struct {\n27\t\tEvents   []map[string]any // 解析出的所有原始 SSE 事件列表\n28\t\tbuf      []byte           // 未处理完的 SSE 字节缓冲区\n29\t\tcurEv    *string          // 当前正在解析的事件类型（event: xxx）\n30\t\tcurData  []string         // 当前事件的 data 行累积（支持多行 data）\n31\t\tsnap     map[string]any   // 重建后的完整响应快照\n32\t\tfedOnce  bool             // 是否已接收过首块数据（用于首次日志）\n33\t}\n34\t\n35\t// NewSSEReassembler 创建一个新的 SSE 重组器实例。\n36\tfunc NewSSEReassembler() *SSEReassembler {\n37\t\treturn &SSEReassembler{}\n38\t}\n39\t\n40\t// FeedBytes 追加原始 SSE 字节数据并处理已完整的行。\n41\t//\n42\t// 该方法按 \\n 分割输入数据，逐行解析 SSE 协议中的 event、data 字段，\n43\t// 遇到空行时触发事件生成并调用累积逻辑更新快照。\n44\t// 可以多次调用以处理分块传输的数据。\n45\tfunc (r *SSEReassembler) FeedBytes(chunk []byte) {\n46\t\tif !r.fedOnce {\n47\t\t\tlogger.Debug(\"sse\", \"FeedBytes: first chunk size=%d\", len(chunk))\n48\t\t\tr.fedOnce = true\n49\t\t}\n50\t\tr.buf = append(r.buf, chunk...)\n51\t\tfor {\n52\t\t\tidx := bytes.IndexByte(r.buf, '\\n')\n53\t\t\tif idx < 0 {\n54\t\t\t\tbreak\n55\t\t\t}\n56\t\t\tline := r.buf[:idx]\n57\t\t\tr.buf = r.buf[idx+1:]\n58\t\t\tr.feedLine(string(line))\n59\t\t}\n60\t}\n61\t\n62\t// Reconstruct 返回当前累积的消息快照。\n63\t//\n64\t// 如果尚未收到足够的事件来构建快照（如仅收到部分 SSE 帧），则返回 nil。\n65\tfunc (r *SSEReassembler) Reconstruct() map[string]any {\n66\t\treturn r.snap\n67\t}\n68\t\n69\t// feedLine 处理单条 SSE 文本行，解析 event、data 和空行分隔符。\n70\t//\n71\t// SSE 协议规则：\n72\t//   - 以 \"event:\" 开头的行设置当前事件类型\n73\t//   - 以 \"data:\" 开头的行追加到当前事件的数据 payload\n74\t//   - 空行表示当前事件结束，触发事件生成\n75\t//   - \"[DONE]\" 是 OpenAI 的流结束标记，直接忽略\n76\tfunc (r *SSEReassembler) feedLine(line string) {\n77\t\tline = strings.TrimRight(line, \"\\r\")\n78\t\n79\t\tif strings.HasPrefix(line, \"event:\") {\n80\t\t\tev := strings.TrimSpace(line[len(\"event:\"):])\n81\t\t\tr.curEv = &ev\n82\t\t\tr.curData = nil\n83\t\t} else if strings.HasPrefix(line, \"data:\") {\n84\t\t\tr.curData = append(r.curData, strings.TrimSpace(line[len(\"data:\"):]))\n85\t\t} else if line == \"\" {\n86\t\t\t// 空行触发事件：如果既没有 event 也没有 data 则跳过\n87\t\t\tif r.curEv == nil && len(r.curData) == 0 {\n88\t\t\t\treturn\n89\t\t\t}\n90\t\t\traw := strings.Join(r.curData, \"\\n\")\n91\t\n92\t\t\t// 跳过 OpenAI 的 [DONE] 哨兵标记\n93\t\t\tif raw == \"[DONE]\" && r.curEv == nil {\n94\t\t\t\tr.curEv = nil\n95\t\t\t\tr.curData = nil\n96\t\t\t\treturn\n97\t\t\t}\n98\t\n99\t\t\tvar data any\n100\t\t\tif err := json.Unmarshal([]byte(raw), &data); err != nil {\n101\t\t\t\tdata = raw\n102\t\t\t}\n103\t\n104\t\t\tevType := \"message\"\n105\t\t\tif r.curEv != nil {\n106\t\t\t\tevType = *r.curEv\n107\t\t\t}\n108\t\t\tr.addEvent(evType, data)\n109\t\t\tr.curEv = nil\n110\t\t\tr.curData = nil\n111\t\t}\n112\t}\n113\t\n114\t// addEvent 将解析出的单个 SSE 事件追加到事件列表，并触发累积更新。\n115\tfunc (r *SSEReassembler) addEvent(eventType string, data any) {\n116\t\tr.Events = append(r.Events, map[string]any{\"event\": eventType, \"data\": data})\n117\t\tr.accumulate(eventType, data)\n118\t}\n119\t\n120\t// accumulate 按事件类型将流式片段累积到响应快照中。\n121\t//\n122\t// 支持的事件类型及处理逻辑：\n123\t//   - message_start:      初始化快照为 message 对象\n124\t//   - response.created/completed/done: OpenAI Responses API，初始化或更新快照\n125\t//   - message:            OpenAI Chat Completions 流，调用 accumulateChatCompletionChunk\n126\t//   - content_block_start: 向快照 content 数组添加新的内容块\n127\t//   - content_block_delta: 更新指定索引的内容块（文本、推理、JSON 片段）\n128\t//   - content_block_stop:  将累积的 partial_json 解析为 input 字段\n129\t//   - message_delta:       更新 message 级别的 delta（如 stop_reason）和 usage\n130\tfunc (r *SSEReassembler) accumulate(eventType string, data any) {\n131\t\tm, ok := data.(map[string]any)\n132\t\tif !ok {\n133\t\t\treturn\n134\t\t}\n135\t\n136\t\tswitch eventType {\n137\t\tcase \"message_start\":\n138\t\t\tif msg, ok := m[\"message\"].(map[string]any); ok {\n139\t\t\t\tr.snap = deepCopy(msg)\n140\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_start, model=%v\", msg[\"model\"])\n141\t\t\t}\n142\t\n143\t\tcase \"response.created\", \"response.completed\", \"response.done\":\n144\t\t\tif resp, ok := m[\"response\"].(map[string]any); ok {\n145\t\t\t\tr.snap = deepCopy(resp)\n146\t\t\t} else if eventType == \"response.completed\" || eventType == \"response.done\" {\n147\t\t\t\tr.snap = deepCopy(m)\n148\t\t\t}\n149\t\n150\t\tcase \"message\":\n151\t\t\tif _, hasChoices := m[\"choices\"]; hasChoices {\n152\t\t\t\tr.accumulateChatCompletionChunk(m)\n153\t\t\t\treturn\n154\t\t\t}\n155\t\n156\t\tcase \"content_block_start\":\n157\t\t\tif r.snap == nil {\n158\t\t\t\treturn\n159\t\t\t}\n160\t\t\tblock := deepCopy(m[\"content_block\"].(map[string]any))\n161\t\t\tidx := int(float64Val(m[\"index\"]))\n162\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_start idx=%d type=%v\", idx, block[\"type\"])\n163\t\t\tif _, ok := r.snap[\"content\"]; !ok {\n164\t\t\t\tr.snap[\"content\"] = []any{}\n165\t\t\t}\n166\t\t\tcontent := r.snap[\"content\"].([]any)\n167\t\t\tfor len(content) <= idx {\n168\t\t\t\tcontent = append(content, map[string]any{})\n169\t\t\t}\n170\t\t\tcontent[idx] = block\n171\t\t\tr.snap[\"content\"] = content\n172\t\n173\t\tcase \"content_block_delta\":\n174\t\t\tif r.snap == nil {\n175\t\t\t\treturn\n176\t\t\t}\n177\t\t\tidx := int(float64Val(m[\"index\"]))\n178\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n179\t\t\tif delta == nil {\n180\t\t\t\treturn\n181\t\t\t}\n182\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n183\t\t\tif idx >= len(content) {\n184\t\t\t\treturn\n185\t\t\t}\n186\t\t\tblock, _ := content[idx].(map[string]any)\n187\t\t\tif block == nil {\n188\t\t\t\treturn\n189\t\t\t}\n190\t\t\tswitch delta[\"type\"] {\n191\t\t\tcase \"text_delta\":\n192\t\t\t\tblock[\"text\"] = strVal(block[\"text\"]) + strVal(delta[\"text\"])\n193\t\t\tcase \"thinking_delta\":\n194\t\t\t\tblock[\"thinking\"] = strVal(block[\"thinking\"]) + strVal(delta[\"thinking\"])\n195\t\t\tcase \"input_json_delta\":\n196\t\t\t\tblock[\"_partial_json\"] = strVal(block[\"_partial_json\"]) + strVal(delta[\"partial_json\"])\n197\t\t\t}\n198\t\n199\t\tcase \"content_block_stop\":\n200\t\t\tif r.snap == nil {\n201\t\t\t\treturn\n202\t\t\t}\n203\t\t\tidx := int(float64Val(m[\"index\"]))\n204\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n205\t\t\tif idx >= len(content) {\n206\t\t\t\treturn\n207\t\t\t}\n208\t\t\tblock, _ := content[idx].(map[string]any)\n209\t\t\tif block == nil {\n210\t\t\t\treturn\n211\t\t\t}\n212\t\t\t// 将累积的 JSON 字符串片段解析为结构化的 input 字段\n213\t\t\tif pj, ok := block[\"_partial_json\"]; ok {\n214\t\t\t\tvar parsed any\n215\t\t\t\tif json.Unmarshal([]byte(strVal(pj)), &parsed) == nil {\n216\t\t\t\t\tblock[\"input\"] = parsed\n217\t\t\t\t}\n218\t\t\t\tdelete(block, \"_partial_json\")\n219\t\t\t}\n220\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_stop idx=%d\", idx)\n221\t\n222\t\tcase \"message_delta\":\n223\t\t\tif r.snap == nil {\n224\t\t\t\treturn\n225\t\t\t}\n226\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n227\t\t\tif delta != nil {\n228\t\t\t\tfor k, v := range delta {\n229\t\t\t\t\tr.snap[k] = v\n230\t\t\t\t}\n231\t\t\t}\n232\t\t\tif u, ok := m[\"usage\"].(map[string]any); ok {\n233\t\t\t\tif _, exists := r.snap[\"usage\"]; !exists {\n234\t\t\t\t\tr.snap[\"usage\"] = map[string]any{}\n235\t\t\t\t}\n236\t\t\t\texisting := r.snap[\"usage\"].(map[string]any)\n237\t\t\t\tfor k, v := range u {\n238\t\t\t\t\texisting[k] = v\n239\t\t\t\t}\n240\t\t\t}\n241\t\t\tif delta != nil {\n242\t\t\t\tif sr, ok := delta[\"stop_reason\"]; ok && sr != nil {\n243\t\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_delta stop_reason=%v\", sr)\n244\t\t\t\t}\n245\t\t\t}\n246\t\t}\n247\t}\n248\t\n249\t// --- OpenAI Chat Completions 流式累积 ---\n250\t\n251\t// accumulateChatCompletionChunk 处理 OpenAI Chat Completions Streaming 的单个 chunk。\n252\t//\n253\t// 该函数将 choices[0].delta 中的内容逐块累积，同时处理：\n254\t//   - role、content、reasoning_content 的拼接\n255\t//   - tool_calls 的渐进式构建（id、name、arguments 分块到达）\n256\t//   - usage 信息的合并\n257\t//   - finish_reason 的更新\n258\t//\n259\t// 快照结构兼容 Anthropic 格式，content 数组中会同时维护文本块和工具调用块。\n260\tfunc (r *SSEReassembler) accumulateChatCompletionChunk(data map[string]any) {\n261\t\tchoices, _ := data[\"choices\"].([]any)\n262\t\trawUsage, _ := data[\"usage\"]\n263\t\n264\t\tif len(choices) == 0 {\n265\t\t\tif u, ok := rawUsage.(map[string]any); ok && r.snap != nil {\n266\t\t\t\tr.mergeChatUsage(u)\n267\t\t\t}\n268\t\t\treturn\n269\t\t}\n270\t\n271\t\tchoice, _ := choices[0].(map[string]any)\n272\t\tif choice == nil {\n273\t\t\treturn\n274\t\t}\n275\t\tdelta, _ := choice[\"delta\"].(map[string]any)\n276\t\tfinishReason := choice[\"finish_reason\"]\n277\t\tchoiceUsage, _ := choice[\"usage\"].(map[string]any)\n278\t\n279\t\t// 首个 chunk 时初始化快照\n280\t\tif r.snap == nil {\n281\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk init, model=%s\", strVal(data[\"model\"]))\n282\t\t\tr.snap = map[string]any{\n283\t\t\t\t\"id\":     strVal(data[\"id\"]),\n284\t\t\t\t\"object\": \"chat.completion\",\n285\t\t\t\t\"model\":  strVal(data[\"model\"]),\n286\t\t\t\t\"choices\": []any{\n287\t\t\t\t\tmap[string]any{\n288\t\t\t\t\t\t\"index\":         0,\n289\t\t\t\t\t\t\"message\":       map[string]any{\"role\": strVal(fieldStr(delta, \"role\")), \"content\": \"\"},\n290\t\t\t\t\t\t\"finish_reason\": nil,\n291\t\t\t\t\t},\n292\t\t\t\t},\n293\t\t\t\t\"content\": []any{map[string]any{\"type\": \"text\", \"text\": \"\"}},\n294\t\t\t}\n295\t\t\tif role := strVal(fieldStr(delta, \"role\")); role == \"\" {\n296\t\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)[\"role\"] = \"assistant\"\n297\t\t\t}\n298\t\t}\n299\t\n300\t\tmsg := r.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n301\t\ttextBlock := r.chatTextBlock()\n302\t\n303\t\tif role := strVal(fieldStr(delta, \"role\")); role != \"\" {\n304\t\t\tmsg[\"role\"] = role\n305\t\t}\n306\t\tif rc := strVal(fieldStr(delta, \"reasoning_content\")); rc != \"\" {\n307\t\t\tmsg[\"reasoning_content\"] = strVal(msg[\"reasoning_content\"]) + rc\n308\t\t\tr.mirrorReasoning(strVal(msg[\"reasoning_content\"]))\n309\t\t}\n310\t\tif c := strVal(fieldStr(delta, \"content\")); c != \"\" {\n311\t\t\tmsg[\"content\"] = strVal(msg[\"content\"]) + c\n312\t\t\ttextBlock[\"text\"] = strVal(textBlock[\"text\"]) + c\n313\t\t}\n314\t\n315\t\t// 工具调用增量处理\n316\t\tfor _, tcRaw := range sliceField(delta, \"tool_calls\") {\n317\t\t\ttcDelta, _ := tcRaw.(map[string]any)\n318\t\t\tif tcDelta == nil {\n319\t\t\t\tcontinue\n320\t\t\t}\n321\t\t\tidx := int(float64Val(tcDelta[\"index\"]))\n322\t\t\ttoolCalls, _ := msg[\"tool_calls\"].([]any)\n323\t\t\tif toolCalls == nil {\n324\t\t\t\ttoolCalls = []any{}\n325\t\t\t}\n326\t\t\tfor len(toolCalls) <= idx {\n327\t\t\t\ttoolCalls = append(toolCalls, map[string]any{\n328\t\t\t\t\t\"id\":   \"\",\n329\t\t\t\t\t\"type\": \"function\",\n330\t\t\t\t\t\"function\": map[string]any{\n331\t\t\t\t\t\t\"name\":      \"\",\n332\t\t\t\t\t\t\"arguments\": \"\",\n333\t\t\t\t\t},\n334\t\t\t\t})\n335\t\t\t}\n336\t\t\texisting := toolCalls[idx].(map[string]any)\n337\t\t\tif id := strVal(tcDelta[\"id\"]); id != \"\" {\n338\t\t\t\texisting[\"id\"] = id\n339\t\t\t}\n340\t\t\tif t := strVal(tcDelta[\"type\"]); t != \"\" {\n341\t\t\t\texisting[\"type\"] = t\n342\t\t\t}\n343\t\t\tif fnDelta, ok := tcDelta[\"function\"].(map[string]any); ok {\n344\t\t\t\tfn, _ := existing[\"function\"].(map[string]any)\n345\t\t\t\tif fn == nil {\n346\t\t\t\t\tfn = map[string]any{\"name\": \"\", \"arguments\": \"\"}\n347\t\t\t\t}\n348\t\t\t\tif n := strVal(fnDelta[\"name\"]); n != \"\" {\n349\t\t\t\t\tfn[\"name\"] = strVal(fn[\"name\"]) + n\n350\t\t\t\t}\n351\t\t\t\tif a := strVal(fnDelta[\"arguments\"]); a != \"\" {\n352\t\t\t\t\tfn[\"arguments\"] = strVal(fn[\"arguments\"]) + a\n353\t\t\t\t}\n354\t\t\t\texisting[\"function\"] = fn\n355\t\t\t}\n356\t\t\ttoolCalls[idx] = existing\n357\t\t\tmsg[\"tool_calls\"] = toolCalls\n358\t\t\tr.mirrorToolCall(idx, existing)\n359\t\t}\n360\t\n361\t\tif finishReason != nil && finishReason != \"\" {\n362\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"finish_reason\"] = finishReason\n363\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk finish_reason=%v\", finishReason)\n364\t\t}\n365\t\n366\t\tif u, ok := rawUsage.(map[string]any); ok {\n367\t\t\tr.mergeChatUsage(u)\n368\t\t}\n369\t\tif choiceUsage != nil {\n370\t\t\tr.mergeChatUsage(choiceUsage)\n371\t\t}\n372\t}\n373\t\n374\t// chatTextBlock 获取或创建快照中的文本内容块。\n375\t// 返回 content 数组中第一个 type=\"text\" 的块；如果不存在则新建一个。\n376\tfunc (r *SSEReassembler) chatTextBlock() map[string]any {\n377\t\tcontent := r.snap[\"content\"].([]any)\n378\t\tfor _, b := range content {\n379\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"text\" {\n380\t\t\t\treturn block\n381\t\t\t}\n382\t\t}\n383\t\tblock := map[string]any{\"type\": \"text\", \"text\": \"\"}\n384\t\tr.snap[\"content\"] = append(content, block)\n385\t\treturn block\n386\t}\n387\t\n388\t// mirrorReasoning 将 reasoning_content 同步到 content 数组中的 thinking 块。\n389\t// 如果 content 中不存在 thinking 块，则在开头插入一个。\n390\tfunc (r *SSEReassembler) mirrorReasoning(reasoning string) {\n391\t\tcontent := r.snap[\"content\"].([]any)\n392\t\tfor _, b := range content {\n393\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n394\t\t\t\tblock[\"thinking\"] = reasoning\n395\t\t\t\treturn\n396\t\t\t}\n397\t\t}\n398\t\tblock := map[string]any{\"type\": \"thinking\", \"thinking\": reasoning}\n399\t\tr.snap[\"content\"] = append([]any{block}, content...)\n400\t}\n401\t\n402\t// mirrorToolCall 将 Chat Completions 的 tool_call 同步到 Anthropic 格式的 content 数组中。\n403\t//\n404\t// 同步规则：\n405\t//   - 在 content 数组中查找或创建对应的 tool_use 块\n406\t//   - 将 function name 映射为 tool_use 的 name\n407\t//   - 将 arguments JSON 解析后映射为 tool_use 的 input\n408\t//   - thinking 块的存在会影响工具调用块在 content 中的索引偏移\n409\tfunc (r *SSEReassembler) mirrorToolCall(idx int, tc map[string]any) {\n410\t\tcontent := r.snap[\"content\"].([]any)\n411\t\t// 如果存在 thinking 块，工具调用的位置需要偏移 1\n412\t\toffset := 1\n413\t\tfor _, b := range content {\n414\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n415\t\t\t\toffset = 2\n416\t\t\t\tbreak\n417\t\t\t}\n418\t\t}\n419\t\ttarget := idx + offset\n420\t\tfor len(content) <= target {\n421\t\t\tcontent = append(content, map[string]any{\"type\": \"tool_use\", \"id\": \"\", \"name\": \"\", \"input\": map[string]any{}})\n422\t\t}\n423\t\tblock := content[target].(map[string]any)\n424\t\tif id := strVal(tc[\"id\"]); id != \"\" {\n425\t\t\tblock[\"id\"] = id\n426\t\t}\n427\t\tif fn, ok := tc[\"function\"].(map[string]any); ok {\n428\t\t\tif n := strVal(fn[\"name\"]); n != \"\" {\n429\t\t\t\tblock[\"name\"] = n\n430\t\t\t}\n431\t\t\tif args := strVal(fn[\"arguments\"]); args != \"\" {\n432\t\t\t\tvar parsed any\n433\t\t\t\tif json.Unmarshal([]byte(args), &parsed) == nil {\n434\t\t\t\t\tblock[\"input\"] = parsed\n435\t\t\t\t}\n436\t\t\t}\n437\t\t}\n438\t\tr.snap[\"content\"] = content\n439\t}\n440\t\n441\t// mergeChatUsage 将 OpenAI Chat Completions 的 usage 数据标准化后合并到快照。\n442\tfunc (r *SSEReassembler) mergeChatUsage(u map[string]any) {\n443\t\tr.snap[\"usage\"] = usage.NormalizeUsage(u)\n444\t}\n445\t\n446\t// --- 辅助函数 ---\n447\t\n448\t// deepCopy 通过 JSON 序列化/反序列化实现 map 的深拷贝。\n449\tfunc deepCopy(m map[string]any) map[string]any {\n450\t\tif m == nil {\n451\t\t\treturn nil\n452\t\t}\n453\t\tdata, _ := json.Marshal(m)\n454\t\tresult := make(map[string]any)\n455\t\t_ = json.Unmarshal(data, &result)\n456\t\treturn result\n457\t}\n458\t\n459\t// float64Val 将任意数值类型转换为 float64。\n460\t// 支持 float64、int、int64；不支持的类型返回 0。\n461\tfunc float64Val(v any) float64 {\n462\t\tswitch n := v.(type) {\n463\t\tcase float64:\n464\t\t\treturn n\n465\t\tcase int:\n466\t\t\treturn float64(n)\n467\t\tcase int64:\n468\t\t\treturn float64(n)\n469\t\t}\n470\t\treturn 0\n471\t}\n472\t\n473\t// strVal 将任意值转换为字符串。\n474\t// nil 返回空字符串，string 类型直接返回，其他类型使用 fmt.Sprintf 格式化。\n475\tfunc strVal(v any) string {\n476\t\tif v == nil {\n477\t\t\treturn \"\"\n478\t\t}\n479\t\tif s, ok := v.(string); ok {\n480\t\t\treturn s\n481\t\t}\n482\t\treturn fmt.Sprintf(\"%v\", v)\n483\t}\n484\t\n485\t// fieldStr 从 map 中安全获取字段值。\n486\tfunc fieldStr(m map[string]any, key string) any {\n487\t\tv, _ := m[key]\n488\t\treturn v\n489\t}\n490\t\n491\t// sliceField 从 map 中获取 []any 类型的字段，如果不存在或类型不匹配则返回 nil。\n492\tfunc sliceField(m map[string]any, key string) []any {\n493\t\tv, _ := m[key].([]any)\n494\t\tif v == nil {\n495\t\t\treturn nil\n496\t\t}\n497\t\treturn v\n498\t}\n499\t"}]}
