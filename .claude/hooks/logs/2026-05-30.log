sult.Error)\n741\t\t\t}\n742\t\t\tif result.PreviousStatus != \"claimed\" {\n743\t\t\t\tt.Errorf(\"expected previous_status=claimed, got %s\", result.PreviousStatus)\n744\t\t\t}\n745\t\t\tif result.NewStatus != \"fixing\" {\n746\t\t\t\tt.Errorf(\"expected new_status=fixing, got %s\", result.NewStatus)\n747\t\t\t}\n748\t\n749\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n750\t\t\tif statuses[10] != \"fixing\" {\n751\t\t\t\tt.Errorf(\"expected fixing after update, got %s\", statuses[10])\n752\t\t\t}\n753\t\t})\n754\t\n755\t\tt.Run(\"non_owner_cannot_update\", func(t *testing.T) {\n756\t\t\tenv := setupTest(t)\n757\t\t\tdb := env.store.DB()\n758\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n759\t\n760\t\t\tresp := env.post(t, \"/api/issue/status\",\n761\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\",\"status\":\"fixing\"}`)\n762\t\n763\t\t\tvar result struct {\n764\t\t\t\tSuccess        bool   `json:\"success\"`\n765\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n766\t\t\t\tError          string `json:\"error\"`\n767\t\t\t}\n768\t\t\treadJSON(t, resp, &result)\n769\t\n770\t\t\tif result.Success {\n771\t\t\t\tt.Fatal(\"expected success=false for non-owner\")\n772\t\t\t}\n773\t\t\tif result.Error != \"not_owner\" {\n774\t\t\t\tt.Errorf(\"expected error=not_owner, got %s\", result.Error)\n775\t\t\t}\n776\t\n777\t\t\tstatuses := checkStatuses(t, env, \"test/repo\", []int{10})\n778\t\t\tif statuses[10] != \"claimed\" {\n779\t\t\t\tt.Errorf(\"expected status unchanged (claimed), got %s\", statuses[10])\n780\t\t\t}\n781\t\t})\n782\t\n783\t\tt.Run(\"nonexistent_issue_returns_not_found\", func(t *testing.T) {\n784\t\t\tenv := setupTest(t)\n785\t\n786\t\t\tresp := env.post(t, \"/api/issue/status\",\n787\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":999,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n788\t\n789\t\t\tvar result struct {\n790\t\t\t\tSuccess bool   `json:\"success\"`\n791\t\t\t\tError   string `json:\"error\"`\n792\t\t\t}\n793\t\t\treadJSON(t, resp, &result)\n794\t\n795\t\t\tif result.Success {\n796\t\t\t\tt.Fatal(\"expected success=false for nonexistent issue\")\n797\t\t\t}\n798\t\t\tif result.Error != \"not_found\" {\n799\t\t\t\tt.Errorf(\"expected error=not_found, got %s\", result.Error)\n800\t\t\t}\n801\t\t})\n802\t\n803\t\tt.Run(\"missing_params_returns_400\", func(t *testing.T) {\n804\t\t\tenv := setupTest(t)\n805\t\n806\t\t\tresp := env.post(t, \"/api/issue/status\",\n807\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n808\t\t\tif resp.StatusCode != http.StatusBadRequest {\n809\t\t\t\tt.Fatalf(\"expected 400 missing status, got %d\", resp.StatusCode)\n810\t\t\t}\n811\t\n812\t\t\tresp = env.post(t, \"/api/issue/status\",\n813\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"status\":\"fixing\"}`)\n814\t\t\tif resp.StatusCode != http.StatusBadRequest {\n815\t\t\t\tt.Fatalf(\"expected 400 missing session_id, got %d\", resp.StatusCode)\n816\t\t\t}\n817\t\n818\t\t\tresp = env.post(t, \"/api/issue/status\",\n819\t\t\t\t`{\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n820\t\t\tif resp.StatusCode != http.StatusBadRequest {\n821\t\t\t\tt.Fatalf(\"expected 400 missing repo, got %d\", resp.StatusCode)\n822\t\t\t}\n823\t\t})\n824\t\n825\t\tt.Run(\"idempotent_same_status\", func(t *testing.T) {\n826\t\t\tenv := setupTest(t)\n827\t\t\tdb := env.store.DB()\n828\t\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-27T10:00:00Z\")\n829\t\n830\t\t\tresp := env.post(t, \"/api/issue/status\",\n831\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n832\t\t\tvar r1 struct{ Success bool `json:\"success\"` }\n833\t\t\treadJSON(t, resp, &r1)\n834\t\t\tif !r1.Success {\n835\t\t\t\tt.Fatal(\"first update should succeed\")\n836\t\t\t}\n837\t\n838\t\t\tresp = env.post(t, \"/api/issue/status\",\n839\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\",\"status\":\"fixing\"}`)\n840\t\t\tvar r2 struct {\n841\t\t\t\tSuccess   bool   `json:\"success\"`\n842\t\t\t\tNewStatus string `json:\"new_status\"`\n843\t\t\t}\n844\t\t\treadJSON(t, resp, &r2)\n845\t\t\tif !r2.Success {\n846\t\t\t\tt.Fatal(\"idempotent update should succeed\")\n847\t\t\t}\n848\t\t\tif r2.NewStatus != \"fixing\" {\n849\t\t\t\tt.Errorf(\"expected new_status=fixing, got %s\", r2.NewStatus)\n850\t\t\t}\n851\t\t})\n852\t\n853\t\tt.Run(\"full_claim_to_fix_flow\", func(t *testing.T) {\n854\t\t\tenv := setupTest(t)\n855\t\n856\t\t\t// 1. check 创建 idle\n857\t\t\tenv.post(t, \"/api/issue/check\",\n858\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[20]}`)\n859\t\t\ts := checkStatuses(t, env, \"test/repo\", []int{20})\n860\t\t\tif s[20] != \"idle\" {\n861\t\t\t\tt.Fatalf(\"step 1: expected idle, got %s\", s[20])\n862\t\t\t}\n863\t\n864\t\t\t// 2. claim\n865\t\t\tcode, ok, _ := claimIssue(t, env, \"test/repo\", 20, \"sess_fix\")\n866\t\t\tif code != http.StatusOK || !ok {\n867\t\t\t\tt.Fatalf(\"step 2: claim failed\")\n868\t\t\t}\n869\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{20})\n870\t\t\tif s[20] != \"claimed\" {\n871\t\t\t\tt.Fatalf(\"step 2: expected claimed, got %s\", s[20])\n872\t\t\t}\n873\t\n874\t\t\t// 3. 标记 fixing\n875\t\t\tresp := env.post(t, \"/api/issue/status\",\n876\t\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":20,\"session_id\":\"sess_fix\",\"status\":\"fixing\"}`)\n877\t\t\tvar r struct {\n878\t\t\t\tSuccess        bool   `json:\"success\"`\n879\t\t\t\tPreviousStatus string `json:\"previous_status\"`\n880\t\t\t\tNewStatus      string `json:\"new_status\"`\n881\t\t\t}\n882\t\t\treadJSON(t, resp, &r)\n883\t\t\tif !r.Success {\n884\t\t\t\tt.Fatal(\"step 3: update to fixing failed\")\n885\t\t\t}\n886\t\t\tif r.PreviousStatus != \"claimed\" {\n887\t\t\t\tt.Errorf(\"step 3: expected previous=claimed, got %s\", r.PreviousStatus)\n888\t\t\t}\n889\t\n890\t\t\t// 4. 验证最终状态\n891\t\t\ts = checkStatuses(t, env, \"test/repo\", []int{20})\n892\t\t\tif s[20] != \"fixing\" {\n893\t\t\t\tt.Fatalf(\"step 4: expected fixing, got %s\", s[20])\n894\t\t\t}\n895\t\t})\n896\t\n897\t\tt.Run(\"method_not_allowed\", func(t *testing.T) {\n898\t\t\tenv := setupTest(t)\n899\t\n900\t\t\tresp, err := http.Get(env.srv.URL + \"/api/issue/status\")\n901\t\t\tif err != nil {\n902\t\t\t\tt.Fatal(err)\n903\t\t\t}\n904\t\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n905\t\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n906\t\t\t}\n907\t\t})"}]}
