.Env.AnthropicBaseURL\n\t}\n\treturn cfg.BaseURL\n}\n\n// HomeDir returns the user's home directory across platforms.\nfunc HomeDir() string {\n\tif runtime.GOOS == \"windows\" {\n\t\tif home := os.Getenv(\"USERPROFILE\"); home != \"\" {\n\t\t\treturn home\n\t\t}\n\t}\n\thome, _ := os.UserHomeDir()\n\treturn home\n}\n","numLines":63,"startLine":1,"totalLines":63}},"tool_use_id":"call_a728b0de75a8405081b1fdad","duration_ms":16}
