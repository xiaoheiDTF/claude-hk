ted，手动 release 后可重新 claim\n1080\t\t\te := setup(t)\n1081\t\n1082\t\t\te.post(t, \"/api/issue/check\",\n1083\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_numbers\":[65]}`)\n1084\t\n1085\t\t\tclaimIssue(t, e, \"xiaoheiDTF/claude-hk\", 65, \"sess_rej\")\n1086\t\t\tfor _, s := range []string{\"fixing\", \"ready-for-pr\", \"pr-created\", \"testing\", \"reviewing\", \"rejected\"} {\n1087\t\t\t\te.post(t, \"/api/issue/status\",\n1088\t\t\t\t\tfmt.Sprintf(`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":65,\"session_id\":\"sess_rej\",\"status\":\"%s\"}`, s))\n1089\t\t\t}\n1090\t\n1091\t\t\t// rejected 是终态，session end 不释放\n1092\t\t\te.post(t, \"/api/issue/release-session\",\n1093\t\t\t\t`{\"session_id\":\"sess_rej\"}`)\n1094\t\t\ts := checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{65})\n1095\t\t\tif s[65] != \"rejected\" {\n1096\t\t\t\tt.Fatalf(\"expected rejected preserved, got %s\", s[65])\n1097\t\t\t}\n1098\t\n1099\t\t\t// 手动 release（由新的 fixing 周期触发）\n1100\t\t\te.post(t, \"/api/issue/release\",\n1101\t\t\t\t`{\"repo_full_name\":\"xiaoheiDTF/claude-hk\",\"issue_number\":65,\"session_id\":\"sess_rej\"}`)\n1102\t\t\ts = checkStatuses(t, e, \"xiaoheiDTF/claude-hk\", []int{65})\n1103\t\t\tif s[65] != \"rejected\" {\n1104\t\t\t\tt.Fatalf(\"rejected should not be releasable by owner either, got %s\", s[65])\n1105\t\t\t}\n1106\t\t})\n1107\t}\n1108\t\n1109\t// --- D7: SessionEnd Hook 自动释放集成测试 ---\n1110\t// 验收标准：\n1111\t//   - 会话结束时释放该 session 所有非终态 issue\n1112\t//   - merged 不被释放\n1113\t//   - rejected 不被释放\n1114\t//   - 无领取记录的 session 不报错\n1115\t//   - 释放后 issue 可被重新 claim\n1116\t\n1117\tfunc TestSessionEndRelease(t *testing.T) {\n1118\t\tt.Run(\"releases_fixing_ready_for_pr_pr_created_testing_reviewing\", func(t *testing.T) {\n1119\t\t\t// 验收：所有非终态（fixing/ready-for-pr/pr-created/testing/reviewing）都被释放\n1120\t\t\te := setup(t)\n1121\t\t\tdb := e.store.DB()\n1122\t\n1123\t\t\tseedIssue(db, \"xiaoheiDTF/claude-hk\", 10, \"fixing\", \"sess_d7\", \"