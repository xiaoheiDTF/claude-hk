on_files.go:84:func ProxySessionKey(projectSlug, sessionID string) string {\nclaude_tap_plus/cmd/claude-tap/session_files.go:88:// RegisterProxySession 向 proxy.json 注册一个会话。\nclaude_tap_plus/cmd/claude-tap/session_files.go:90:func RegisterProxySession(key string, startedAt string) error {\nclaude_tap_plus/cmd/claude-tap/session_files.go:94:\tsessions := readProxySessions()\nclaude_tap_plus/cmd/claude-tap/session_files.go:95:\tsessions[key] = ProxySession{StartedAt: startedAt}\nclaude_tap_plus/cmd/claude-tap/session_files.go:96:\treturn writeProxySessions(sessions)\nclaude_tap_plus/cmd/claude-tap/session_files.go:99:// UnregisterProxySession 从 proxy.json 注销一个会话。\nclaude_tap_plus/cmd/claude-tap/session_files.go:100:func UnregisterProxySession(key string) error {\nclaude_tap_plus/cmd/claude-tap/session_files.go:104:\tsessions := readProxySessions()\nclaude_tap_plus/cmd/claude-tap/session_files.go:106:\treturn writeProxySessions(sessions)\nclaude_tap_plus/cmd/claude-tap/session_files.go:109:// ReadProxySessions 读取 proxy.json 中的所有会话（不加锁，供 watchdog 使用）。\nclaude_tap_plus/cmd/claude-tap/session_files.go:110:func ReadProxySessions() map[string]ProxySession {\nclaude_tap_plus/cmd/claude-tap/session_files.go:113:\treturn readProxySessions()\nclaude_tap_plus/cmd/claude-tap/session_files.go:116:// readProxySessions 内部读取函数，不加锁。\nclaude_tap_plus/cmd/claude-tap/session_files.go:117:func readProxySessions() map[string]ProxySession {\nclaude_tap_plus/cmd/claude-tap/session_files.go:118:\tresult := make(map[string]ProxySession)\nclaude_tap_plus/cmd/claude-tap/session_files.go:127:// writeProxySessions 内部写入函数，不加锁。\nclaude_tap_plus/cmd/claude-tap/session_files.go:128:func writeProxySessions(sessions map[string]ProxySession) error {\nclaude_tap_plus/cmd/claude-tap/session_files.go:137:\tlogger.Debug(\"session_files\", \"proxy.json updated: %d sessions\", len(sessions))\nclaude_tap_plus/internal/backend/api/proxy_handler.go:64:// unbindProxySessions 清理指定 pid 下的所有 session 绑定（内部调用需持有写锁）。\ncl