fileConfig_WithModel(t *testing.T) {\n103\t\ttmpDir := t.TempDir()\n104\t\tconfigDir := filepath.Join(tmpDir, \".claude-tap-plus\")\n105\t\tif err := os.MkdirAll(configDir, 0o755); err != nil {\n106\t\t\tt.Fatal(err)\n107\t\t}\n108\t\n109\t\tprofilesContent := `{\n110\t\t\t\"default\": \"with-model\",\n111\t\t\t\"profiles\": {\n112\t\t\t\t\"with-model\": {\n113\t\t\t\t\t\"base_url\": \"https://api.example.com\",\n114\t\t\t\t\t\"model\": \"glm-5.1\"\n115\t\t\t\t},\n116\t\t\t\t\"without-model\": {\n117\t\t\t\t\t\"base_url\": \"https://api.anthropic.com\"\n118\t\t\t\t}\n119\t\t\t}\n120\t\t}`\n121\t\tif err := os.WriteFile(filepath.Join(configDir, \"profiles.json\"), []byte(profilesContent), 0o644); err != nil {\n122\t\t\tt.Fatal(err)\n123\t\t}\n124\t\n125\t\torigHomeDir := homeDir\n126\t\tSetHomeDir(func() string { return tmpDir })\n127\t\tdefer func() { SetHomeDir(origHomeDir) }()\n128\t\n129\t\ttests := []struct {\n130\t\t\tname         string\n131\t\t\tprofileName  string\n132\t\t\twantModel    string\n133\t\t\twantBaseURL  string\n134\t\t\twantErr      bool\n135\t\t}{\n136\t\t\t{\n137\t\t\t\tname:        \"profile with model\",\n138\t\t\t\tprofileName: \"with-model\",\n139\t\t\t\twantModel:   \"glm-5.1\",\n140\t\t\t\twantBaseURL: \"https://api.example.com\",\n141\t\t\t},\n142\t\t\t{\n143\t\t\t\tname:        \"profile without model\",\n144\t\t\t\tprofileName: \"without-model\",\n145\t\t\t\twantModel:   \"\",\n146\t\t\t\twantBaseURL: \"https://api.anthropic.com\",\n147\t\t\t},\n148\t\t\t{\n149\t\t\t\tname:        \"use default profile name\",\n150\t\t\t\tprofileName: \"\",\n151\t\t\t\twantModel:   \"glm-5.1\",\n152\t\t\t\twantBaseURL: \"https://api.example.com\",\n153\t\t\t},\n154\t\t}\n155\t\n156\t\tfor _, tt := range tests {\n157\t\t\tt.Run(tt.name, func(t *testing.T) {\n158\t\t\t\tp, err := ResolveProfileConfig(tt.profileName)\n159\t\t\t\tif (err != nil) != tt.wantErr {\n160\t\t\t\t\tt.Fatalf(\"ResolveProfileConfig(%q) error = %v, wantErr %v\", tt.profileName, err