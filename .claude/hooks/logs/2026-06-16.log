95\t\tpData, _ = json.Marshal(profiles)\n196\t\tos.WriteFile(filepath.Join(configDir, \"profiles.json\"), pData, 0o644)\n197\t\n198\t\t// 6. 解析配置（模拟 runProxy 的配置解析）\n199\t\tresolved, err := config.ResolveTargetConfig(\n200\t\t\t\"\",   // cliBaseURL\n201\t\t\t\"\",   // cliAPIKey\n202\t\t\t\"\",   // cliAuthToken\n203\t\t\t\"test-profile\",\n204\t\t\t&config.ClaudeClient,\n205\t\t)\n206\t\tif err != nil {\n207\t\t\tt.Fatalf(\"ResolveTargetConfig error: %v\", err)\n208\t\t}\n209\t\n210\t\t// 验证 resolved model\n211\t\tif resolved.Model != \"glm-5.1\" {\n212\t\t\tt.Fatalf(\"resolved.Model = %q, want %q\", resolved.Model, \"glm-5.1\")\n213\t\t}\n214\t\n215\t\t// 7. 创建代理并设置 model + fallback\n216\t\ttraceDir := t.TempDir()\n217\t\trp := proxy.NewReverseProxy(resolved.BaseURL, traceDir)\n218\t\trp.SetModel(resolved.Model)\n219\t\n220\t\tfbCfgs := loadFallbackConfigs(resolved.Model, \"test-profile\")\n221\t\tif len(fbCfgs) == 0 {\n222\t\t\tt.Fatal(\"loadFallbackConfigs returned empty\")\n223\t\t}\n224\t\trp.SetFallbackConfigs(fbCfgs)\n225\t\n226\t\t// 8. 启动代理\n227\t\t_, err = rp.Start(\"127.0.0.1\", 0)\n228\t\tif err != nil {\n229\t\t\tt.Fatalf(\"start proxy: %v\", err)\n230\t\t}\n231\t\tdefer rp.Stop()\n232\t\n233\t\t// 9. 通过代理发送请求\n234\t\treqBody := `{\"model\":\"claude-sonnet-4-6\",\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}`\n235\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader([]byte(reqBody)))\n236\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n237\t\n238\t\tresp, err := http.DefaultClient.Do(req)\n239\t\tif err != nil {\n240\t\t\tt.Fatalf(\"send request: %v\", err)\n241\t\t}\n242\t\tresp.Body.Close()\n243\t\n244\t\t// 10. 验证上游收到改写后的 model\n245\t\tvar upstreamBody map[string]any\n246\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n247\t\t\tt.Fatalf(\"parse upstream body: %v\", err)\n248\t\t}\n249\t\tgotModel, _ := upstreamBody[\"model\"].(string)\n250\t\tif gotModel != \"glm-5.1\" {\n251\t\t\tt.Errorf(\"upstream model = %q, want %q (should be overridden by profile model)\", gotModel, \"glm-5.1\")\n252\t\t}\n253\t\n254\t\t// 11. 验证 fallback 配置正确\n255\t\tif fbCfgs[0].Model != \"glm-5.1\" {\n256\t\t\tt.Errorf(\"fallback model = %q, want %q\", fbCfgs[0].Model, \"glm-5.1\")\n257\t\t}\n258\t}\n259\t"}]}
