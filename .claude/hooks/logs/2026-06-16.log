n94\t\tauthType := \"none\"\n95\t\tif result.APIKey != \"\" {\n96\t\t\tauthType = \"api_key\"\n97\t\t} else if result.AuthToken != \"\" {\n98\t\t\tauthType = \"auth_token\"\n99\t\t}\n100\t\tlogger.Info(\"config\", \"resolved: base_url=%s auth=%s model=%s\", result.BaseURL, authType, result.Model)\n101\t\treturn result, nil\n102\t}\n103\t"}]}
