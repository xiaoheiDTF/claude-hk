[2026-06-16 21:49:53] [INFO] [PreToolUse] Input: {"session_id":"349f583d-c3a1-4da9-8bc9-f328938cf700","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\349f583d-c3a1-4da9-8bc9-f328938cf700.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus","permission_mode":"default","effort":{"level":"high"},"hook_event_name":"PreToolUse","tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\reverse.go","offset":840,"limit":160},"tool_use_id":"call_046da22e787c4b96a597a5a4"}
