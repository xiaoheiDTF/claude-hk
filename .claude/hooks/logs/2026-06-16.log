tCached_Unit 直接测试 injectReasoningContentCached 函数的各种场景。\n45\tfunc TestInjectReasoningContentCached_Unit(t *testing.T) {\n46\t\ttests := []struct {\n47\t\t\tname     string\n48\t\t\treqBody  string\n49\t\t\tisKimi   bool\n50\t\t\twantSame bool // true = 输出应与输入完全一致\n51\t\t\twantLen  int  // 目标 assistant 消息的 content 数组期望长度\n52\t\t}{\n53\t\t\t{\n54\t\t\t\tname:     \"无 tool_use 的 assistant - 原样透传\",\n55\t\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}]}`,\n56\t\t\t\tisKimi:   true,\n57\t\t\t\twantSame: true,\n58\t\t\t},\n59\t\t\t{\n60\t\t\t\tname:     \"tool_use 无 thinking - 注入\",\n61\t\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n62\t\t\t\tisKimi:   true,\n63\t\t\t\twantSame: false,\n64\t\t\t\twantLen:  2,\n65\t\t\t},\n66\t\t\t{\n67\t\t\t\tname:     \"已有 thinking 块和 reasoning_content - 原样透传\",\n68\t\t\t\treqBody:  `{\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"reasoning\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}],\"reasoning_content\":\"reasoning\"}]}`,\n69\t\t\t\tisKimi:   true,\n70\t\t\t\twantSame: true,\n71\t\t\t},\n72\t\t\t{\n73\t\t\t\tname:     \"空 body - 原样透传\",\n74\t\t\t\treqBody:  \"\",\n75\t\t\t\tisKimi:   true,\n76\t\t\t\twantSame: true,\n77\t\t\t},\n78\t\t\t{\n79\t\t\t\tname:     \"非 JSON body - 原样透传\",\n80\t\t\t\treqBody:  \"this is not json\",\n81\t\t\t\tisKimi:   true,\n82\t\t\t\twantSame: true,\n83\t\t\t},\n84\t\t\t{\n85\t\t\t\tname:     \"JSON 数组 body - 原样透传\",\n86\t\t\t\treqBody:  `[1,2,3]`,\n87\t\t\t\tisKimi:   true,\n88\t\t\t\twantSame: true,\n89\t\t\t},\n90\t\t\t{\n91\t\t\t\tname:     \"纯 user 消息 - 原样透传\",\n92\t\t\t\treqBody:  `{\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}`,\n93\t\t\t\tisKimi:   true,\n94\t\t\t\twantSame: true,\n95\t\t\t},\n96\t\t\t{\n97\t\t\t\tname:     \"非 kimi 模式 - 原样透传（不注入）\",\n98\t\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n99\t\t\t\tisKimi:   false,\n100\t\t\t\twantSame: true,\n101\t\t\t},\n102\t\t}\n103\t\n104\t\tfor _, tt := range tests {\n105\t\t\tt.Run(tt.name, func(t *testing.T) {\n106\t\t\t\tvar parsed any\n107\t\t\t\tif tt.reqBody != \"\" {\n108\t\t\t\t\t_ = json.Unmarshal([]byte(tt.reqBody), &parsed)\n109\t\t\t\t}\n110\t\t\t\tresult := injectReasoningContentCached([]byte(tt.reqBody), parsed, nil, tt.isKimi)\n111\t\t\t\tif tt.wantSame {\n112\t\t\t\t\tif string(result) != tt.reqBody {\n113\t\t\t\t\t\tt.Errorf(\"expected passthrough, got: %s\", string(result))\n114\t\t\t\t\t}\n115\t\t\t\t} else {\n116\t\t\t\t\tvar m map[string]any\n117\t\t\t\t\tif err := json.Unmarshal(result, &m); err != nil {\n118\t\t\t\t\t\tt.Fatalf(\"result is not valid JSON: %v\", err)\n119\t\t\t\t\t}\n120\t\t\t\t\tmsgs := m[\"messages\"].([]any)\n121\t\t\t\t\tmsg := msgs[0].(map[string]any)\n122\t\t\t\t\tcontent := msg[\"content\"].([]any)\n123\t\t\t\t\tif len(content) != tt.wantLen {\n124\t\t\t\t\t\tt.Errorf(\"content length = %d, want %d\", len(content), tt.wantLen)\n125\t\t\t\t\t}\n126\t\t\t\t\t// 验证注入的 thinking 块在第一位\n127\t\t\t\t\tfirst := content[0].(map[string]any)\n128\t\t\t\t\tif first[\"type\"] != \"thinking\" {\n129\t\t\t\t\t\tt.Errorf(\"first block type = %q, want %q\", first[\"type\"], \"thinking\")\n130\t\t\t\t\t}\n131\t\t\t\t\t// 验证顶层 reasoning_content 字段被注入（无缓存时为空字符串）\n132\t\t\t\t\tif rc, ok := msg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n133\t\t\t\t\t\tt.Errorf(\"reasoning_content = %v, want empty string\", msg[\"reasoning_content\"])\n134\t\t\t\t\t}\n135\t\t\t\t}\n136\t\t\t})\n137\t\t}\n138\t}\n139\t\n140\t// TestInjectReasoningContentCached_MixedMessages 测试混合消息场景：只有 tool_call 消息被注入。\n141\tfunc TestInjectReasoningContentCached_MixedMessages(t *testing.T) {\n142\t\treqBody := `{\n143\t\t\t\"messages\": [\n144\t\t\t\t{\"role\": \"user\", \"content\": \"read the file\"},\n145\t\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"sure\"}]},\n146\t\t\t\t{\"role\": \"user\", \"content\": \"do it\"},\n147\t\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"Read\", \"input\": {\"file\": \"/tmp/x\"}}]},\n148\t\t\t\t{\"role\": \"user\", \"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"t1\", \"content\": \"file data\"}]},\n149\t\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"thinking\", \"thinking\":\"let me think\"},{\"type\": \"tool_use\", \"id\": \"t2\", \"name\": \"Bash\", \"input\": {\"cmd\": \"ls\"}}]}\n150\t\t\t]\n151\t\t}`\n152\t\n153\t\tvar parsed any\n154\t\t_ = json.Unmarshal([]byte(reqBody), &parsed)\n155\t\tresult := injectReasoningContentCached([]byte(reqBody), parsed, nil, true)\n156\t\n157\t\tvar m map[string]any\n158\t\tif err := json.Unmarshal(result, &m); err != nil {\n159\t\t\tt.Fatalf(\"parse result: %v\", err)\n160\t\t}\n161\t\tmsgs := m[\"messages\"].([]any)\n162\t\n163\t\t// user 消息不变\n164\t\tif msgs[0].(map[string]any)[\"role\"] != \"user\" {\n165\t\t\tt.Error(\"msg[0] should be user\")\n166\t\t}\n167\t\n168\t\t// 纯文本 assistant (msg[1]) 不变\n169\t\tassistantText := msgs[1].(map[string]any)[\"content\"].([]any)\n170\t\tif len(assistantText) != 1 {\n171\t\t\tt.Errorf(\"assistant text content length = %d, want 1\", len(assistantText))\n172\t\t}\n173\t\n174\t\t// tool_call 无 thinking (msg[3]) → 注入 thinking 块 + reasoning_content\n175\t\tassistantTool := msgs[3].(map[string]any)\n176\t\tcontent := assistantTool[\"content\"].([]any)\n177\t\tif len(content) != 2 {\n178\t\t\tt.Errorf(\"assistant tool content length = %d, want 2 (thinking + tool_use)\", len(content))\n179\t\t}\n180\t\tif content[0].(map[string]any)[\"type\"] != \"thinking\" {\n181\t\t\tt.Error(\"first block should be thinking\")\n182\t\t}\n183\t\tif content[1].(map[string]any)[\"type\"] != \"tool_use\" {\n184\t\t\tt.Error(\"second block should be tool_use\")\n185\t\t}\n186\t\tif rc, ok := assistantTool[\"reasoning_content\"].(string); !ok || rc != \"\" {\n187\t\t\tt.Errorf(\"msg[3] reasoning_content = %v, want empty string\", assistantTool[\"reasoning_content\"])\n188\t\t}\n189\t\n190\t\t// 已有 thinking 的 tool_call (msg[5]) → 不重复注入 thinking 块，但仍注入 reasoning_content（如果缺失）\n191\t\tassistantWithThinking := msgs[5].(map[string]any)\n192\t\tthinkingContent := assistantWithThinking[\"content\"].([]any)\n193\t\tif len(thinkingContent) != 2 {\n194\t\t\tt.Errorf(\"assistant with thinking content length = %d, want 2 (no duplicate)\", len(thinkingContent))\n195\t\t}\n196\t\tif rc, ok := assistantWithThinking[\"reasoning_content\"].(string); !ok || rc != \"\" {\n197\t\t\tt.Errorf(\"msg[5] reasoning_content = %v, want empty string\", assistantWithThinking[\"reasoning_content\"])\n198\t\t}\n199\t}\n200\t\n201\t// TestInjectReasoningContentCached_CacheHit 测试缓存命中时回填真实的 reasoning_content。\n202\tfunc TestInjectReasoningContentCached_CacheHit(t *testing.T) {\n203\t\tcache := NewReasoningCache()\n204\t\n205\t\t// 预缓存：模拟之前 API 响应中的 reasoning_content\n206\t\tassistantContent := \"I will read the file\"\n207\t\ttoolCalls := `[{\"type\":\"tool_use\",\"id\":\"tu_1\",\"name\":\"Read\",\"input\":{\"file_path\":\"/tmp/test.txt\"}}]`\n208\t\tfullKey := MakeFullKey(assistantContent, toolCalls)\n209\t\ttcKey := MakeToolcallKey(toolCalls)\n210\t\tcache.Store(fullKey, tcKey, \"Let me think about this step by step. The user wants to read a file.\")\n211\t\n212\t\t// 构造请求体：assistant 消息有 tool_use 但无 reasoning_content\n213\t\treqBody := map[string]any{\n214\t\t\t\"model\": \"kimi-for-coding\",\n215\t\t\t\"messages\": []any{\n216\t\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"read the file\"},\n217\t\t\t\tmap[string]any{\n218\t\t\t\t\t\"role\": \"assistant\",\n219\t\t\t\t\t\"content\": []any{\n220\t\t\t\t\t\tmap[string]any{\"type\": \"text\", \"text\": \"I will read the file\"},\n221\t\t\t\t\t\tmap[string]any{\"type\": \"tool_use\", \"id\": \"tu_1\", \"name\": \"Read\", \"input\": map[string]any{\"file_path\": \"/tmp/test.txt\"}},\n222\t\t\t\t\t},\n223\t\t\t\t},\n224\t\t\t},\n225\t\t}\n226\t\tbodyBytes, _ := json.Marshal(reqBody)\n227\t\n228\t\tvar parsed any\n229\t\t_ = json.Unmarshal(bodyBytes, &parsed)\n230\t\tresult := injectReasoningContentCached(bodyBytes, parsed, cache, true)\n231\t\n232\t\tvar m map[string]any\n233\t\tif err := json.Unmarshal(result, &m); err != nil {\n234\t\t\tt.Fatalf(\"parse result: %v\", err)\n235\t\t}\n236\t\n237\t\tmsgs := m[\"messages\"].([]any)\n238\t\tassistantMsg := msgs[1].(map[string]any)\n239\t\n240\t\t// reasoning_content 应该是缓存的值，不是空字符串\n241\t\trc, _ := assistantMsg[\"reasoning_content\"].(string)\n242\t\tif rc == \"\" {\n243\t\t\tt.Error(\"expected cached reasoning_content, got empty string\")\n244\t\t}\n245\t\tif rc != \"Let me think about this step by step. The user wants to read a file.\" {\n246\t\t\tt.Errorf(\"reasoning_content = %q, want cached value\", rc)\n247\t\t}\n248\t\n249\t\t// thinking 块应被注入\n250\t\tcontent := assistantMsg[\"content\"].([]any)\n251\t\tfirstBlock := content[0].(map[string]any)\n252\t\tif firstBlock[\"type\"] != \"thinking\" {\n253\t\t\tt.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")\n254\t\t}\n255\t}\n256\t\n257\t// TestInjectReasoningContentCached_CacheMissFallbackToEmpty 测试缓存未命中时回退到空字符串。\n258\tfunc TestInjectReasoningContentCached_CacheMissFallbackToEmpty(t *testing.T) {\n259\t\tcache := NewReasoningCache()\n260\t\t// 不存任何缓存\n261\t\n262\t\treqBody := `{\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"Read\",\"input\":{}}]}]}`\n263\t\tvar parsed any\n264\t\t_ = json.Unmarshal([]byte(reqBody), &parsed)\n265\t\n266\t\tresult := injectReasoningContentCached([]byte(reqBody), parsed, cache, true)\n267\t\n268\t\tvar m map[string]any\n269\t\tjson.Unmarshal(result, &m)\n270\t\tmsg := m[\"messages\"].([]any)[0].(map[string]any)\n271\t\n272\t\trc, _ := msg[\"reasoning_content\"].(string)\n273\t\tif rc != \"\" {\n274\t\t\tt.Errorf(\"cache miss should fallback to empty string, got %q\", rc)\n275\t\t}\n276\t}\n277\t\n278\t// TestInjectReasoningContentCached_NonKimiPassthrough 测试非 kimi 模式不做任何修改。\n279\tfunc TestInjectReasoningContentCached_NonKimiPassthrough(t *testing.T) {\n280\t\tcache := NewReasoningCache()\n281\t\tcache.Store(\"some-key\", \"tc-key\", \"should not be used\")\n282\t\n283\t\treqBody := `{\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"Read\",\"input\":{}}]}]}`\n284\t\tvar parsed any\n285\t\t_ = json.Unmarshal([]byte(reqBody), &parsed)\n286\t\n287\t\tresult := injectReasoningContentCached([]byte(reqBody), parsed, cache, false)\n288\t\n289\t\tif string(result) != reqBody {\n290\t\t\tt.Errorf(\"non-kimi mode should passthrough, got: %s\", string(result))\n291\t\t}\n292\t}\n293\t\n294\t// TestInjectReasoningContentCached_ExistingRCRefreshesCache 测试已有 reasoning_content 时刷新缓存。\n295\tfunc TestInjectReasoningContentCached_ExistingRCRefreshesCache(t *testing.T) {\n296\t\tcache := NewReasoningCache()\n297\t\n298\t\treqBody := map[string]any{\n299\t\t\t\"messages\": []any{\n300\t\t\t\tmap[string]any{\n301\t\t\t\t\t\"role\": \"assistant\",\n302\t\t\t\t\t\"content\": []any{\n303\t\t\t\t\t\tmap[string]any{\"type\": \"text\", \"text\": \"hello\"},\n304\t\t\t\t\t\tmap[string]any{\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"Read\", \"input\": map[string]any{}},\n305\t\t\t\t\t},\n306\t\t\t\t\t\"reasoning_content\": \"I am thinking deeply about this\",\n307\t\t\t\t},\n308\t\t\t},\n309\t\t}\n310\t\tbodyBytes, _ := json.Marshal(reqBody)\n311\t\n312\t\tvar parsed any\n313\t\t_ = json.Unmarshal(bodyBytes, &parsed)\n314\t\tresult := injectReasoningContentCached(bodyBytes, parsed, cache, true)\n315\t\n316\t\t// 缓存应该被刷新\n317\t\tf, _ := cache.Len()\n318\t\tif f == 0 {\n319\t\t\tt.Error(\"expected cache to be refreshed from existing reasoning_content\")\n320\t\t}\n321\t\n322\t\t// 结果应该是原样透传（已有 reasoning_content + 无 thinking 块 → 只注入 thinking 块）\n323\t\tvar m map[string]any\n324\t\tjson.Unmarshal(result, &m)\n325\t\tmsg := m[\"messages\"].([]any)[0].(map[string]any)\n326\t\tcontent := msg[\"content\"].([]any)\n327\t\n328\t\t// thinking 块被注入\n329\t\tif content[0].(map[string]any)[\"type\"] != \"thinking\" {\n330\t\t\tt.Error(\"expected thinking block to be injected\")\n331\t\t}\n332\t\n333\t\t// reasoning_content 保持原值\n334\t\trc, _ := msg[\"reasoning_content\"].(string)\n335\t\tif rc != \"I am thinking deeply about this\" {\n336\t\t\tt.Errorf(\"reasoning_content changed: got %q\", rc)\n337\t\t}\n338\t}\n339\t\n340\t// TestInjectReasoningContentCached_Integration 通过完整代理链路测试，验证上游收到注入后的请求体。\n341\tfunc TestInjectReasoningContentCached_Integration(t *testing.T) {\n342\t\tvar capturedBody []byte\n343\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n344\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n345\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n346\t\t\tw.WriteHeader(http.StatusOK)\n347\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n348\t\t}))\n349\t\tdefer mockUpstream.Close()\n350\t\n351\t\ttraceDir := t.TempDir()\n352\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n353\t\trp.model = \"kimi-for-coding\"\n354\t\trp.SetKimiMode(true) // 启用 kimi 模式\n355\t\n356\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n357\t\tif err != nil {\n358\t\t\tt.Fatalf(\"start proxy: %v\", err)\n359\t\t}\n360\t\tdefer rp.Stop()\n361\t\n362\t\t// 模拟 Kimi 场景：无 thinking 字段，但有 tool_call 消息\n363\t\treqBody := map[string]any{\n364\t\t\t\"model\":  \"kimi-for-coding\",\n365\t\t\t\"stream\": true,\n366\t\t\t\"messages\": []any{\n367\t\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"read the file\"},\n368\t\t\t\tmap[string]any{\n369\t\t\t\t\t\"role\": \"assistant\",\n370\t\t\t\t\t\"content\": []any{\n371\t\t\t\t\t\tmap[string]any{\n372\t\t\t\t\t\t\t\"type\":  \"tool_use\",\n373\t\t\t\t\t\t\t\"id\":    \"toolu_123\",\n374\t\t\t\t\t\t\t\"name\":  \"Read\",\n375\t\t\t\t\t\t\t\"input\": map[string]any{\"file_path\": \"/tmp/test.txt\"},\n376\t\t\t\t\t\t},\n377\t\t\t\t\t},\n378\t\t\t\t},\n379\t\t\t\tmap[string]any{\n380\t\t\t\t\t\"role\": \"user\",\n381\t\t\t\t\t\"content\": []any{\n382\t\t\t\t\t\tmap[string]any{\n383\t\t\t\t\t\t\t\"type\":        \"tool_result\",\n384\t\t\t\t\t\t\t\"tool_use_id\": \"toolu_123\",\n385\t\t\t\t\t\t\t\"content\":     \"file contents\",\n386\t\t\t\t\t\t},\n387\t\t\t\t\t},\n388\t\t\t\t},\n389\t\t\t},\n390\t\t}\n391\t\tbodyBytes, _ := json.Marshal(reqBody)\n392\t\n393\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n394\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n395\t\n396\t\tresp, err := http.DefaultClient.Do(req)\n397\t\tif err != nil {\n398\t\t\tt.Fatalf(\"send request: %v\", err)\n399\t\t}\n400\t\tresp.Body.Close()\n401\t\n402\t\t// 验证上游收到的请求体\n403\t\tvar upstreamBody map[string]any\n404\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n405\t\t\tt.Fatalf(\"parse upstream body: %v\", err)\n406\t\t}\n407\t\n408\t\t// model 被改写为 kimi-for-coding\n409\t\tif m, _ := upstreamBody[\"model\"].(string); m != \"kimi-for-coding\" {\n410\t\t\tt.Errorf(\"model = %q, want %q\", m, \"kimi-for-coding\")\n411\t\t}\n412\t\n413\t\t// assistant 消息被注入 thinking 块 + reasoning_content\n414\t\tmessages := upstreamBody[\"messages\"].([]any)\n415\t\tassistantMsg := messages[1].(map[string]any)\n416\t\tcontent := assistantMsg[\"content\"].([]any)\n417\t\n418\t\tif len(content) != 2 {\n419\t\t\tt.Fatalf(\"assistant content blocks = %d, want 2\", len(content))\n420\t\t}\n421\t\n422\t\t// thinking 块在第一位\n423\t\tfirstBlock := content[0].(map[string]any)\n424\t\tif firstBlock[\"type\"] != \"thinking\" {\n425\t\t\tt.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")\n426\t\t}\n427\t\n428\t\t// 顶层 reasoning_content 被注入（首次请求无缓存，应为空字符串）\n429\t\tif rc, ok := assistantMsg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n430\t\t\tt.Errorf(\"reasoning_content = %v, want empty string\", assistantMsg[\"reasoning_content\"])\n431\t\t}\n432\t\n433\t\t// 原 tool_use 块保持不变\n434\t\tsecondBlock := content[1].(map[string]any)\n435\t\tif secondBlock[\"type\"] != \"tool_use\" {\n436\t\t\tt.Errorf(\"second block type = %q, want %q\", secondBlock[\"type\"], \"tool_use\")\n437\t\t}\n438\t}\n439\t\n440\t// TestInjectReasoningContentCached_IntegrationWithCache 测试完整链路的缓存回填。\n441\tfunc TestInjectReasoningContentCached_IntegrationWithCache(t *testing.T) {\n442\t\tvar capturedBodies [][]byte\n443\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n444\t\t\tbody, _ := io.ReadAll(r.Body)\n445\t\t\tcapturedBodies = append(capturedBodies, body)\n446\t\t\t// 返回包含 reasoning_content 的响应\n447\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n448\t\t\tw.WriteHeader(http.StatusOK)\n449\t\t\tw.Write([]byte(`{\n450\t\t\t\t\"id\": \"msg_test\",\n451\t\t\t\t\"type\": \"message\",\n452\t\t\t\t\"role\": \"assistant\",\n453\t\t\t\t\"model\": \"test\",\n454\t\t\t\t\"content\": [{\"type\": \"text\", \"text\": \"done\"}],\n455\t\t\t\t\"stop_reason\": \"end_turn\",\n456\t\t\t\t\"usage\": {\"input_tokens\": 10, \"output_tokens\": 5}\n457\t\t\t}`))\n458\t\t}))\n459\t\tdefer mockUpstream.Close()\n460\t\n461\t\ttraceDir := t.TempDir()\n462\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n463\t\trp.model = \"kimi-for-coding\"\n464\t\trp.SetKimiMode(true)\n465\t\n466\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n467\t\tif err != nil {\n468\t\t\tt.Fatalf(\"start proxy: %v\", err)\n469\t\t}\n470\t\tdefer rp.Stop()\n471\t\n472\t\t// 请求 1：带 tool_use 的 assistant 消息（无 reasoning_content）\n473\t\treqBody1 := map[string]any{\n474\t\t\t\"model\": \"kimi-for-coding\",\n475\t\t\t\"messages\": []any{\n476\t\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"hello\"},\n477\t\t\t\tmap[string]any{\n478\t\t\t\t\t\"role\": \"assistant\",\n479\t\t\t\t\t\"content\": []any{\n480\t\t\t\t\t\tmap[string]any{\"type\": \"text\", \"text\": \"I will help\"},\n481\t\t\t\t\t\tmap[string]any{\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"Read\", \"input\": map[string]any{\"file\": \"a.go\"}},\n482\t\t\t\t\t},\n483\t\t\t\t},\n484\t\t\t},\n485\t\t}\n486\t\tbodyBytes1, _ := json.Marshal(reqBody1)\n487\t\treq1, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes1))\n488\t\treq1.Header.Set(\"Content-Type\", \"application/json\")\n489\t\tresp1, err := http.DefaultClient.Do(req1)\n490\t\tif err != nil {\n491\t\t\tt.Fatalf(\"request 1: %v\", err)\n492\t\t}\n493\t\tresp1.Body.Close()\n494\t\n495\t\t// 验证请求 1：reasoning_content 为空字符串（首次无缓存）\n496\t\tvar body1 map[string]any\n497\t\tjson.Unmarshal(capturedBodies[0], &body1)\n498\t\tmsg1 := body1[\"messages\"].([]any)[1].(map[string]any)\n499\t\trc1, _ := msg1[\"reasoning_content\"].(string)\n500\t\tif rc1 != \"\" {\n501\t\t\tt.Errorf(\"request 1 reasoning_content should be empty, got %q\", rc1)\n502\t\t}\n503\t}\n504\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\reverse.go","limit":70,"offset":30},"tool_use_id":"call_724076e4cb284ab390efba67","tool_response":"30\t)\n31\t\n32\t// ReverseProxy 拦截 HTTP 请求并转发到上游 API，同时记录请求/响应到 JSONL Trace，并处理 SSE 流式响应。\n33\ttype ReverseProxy struct {\n34\t\ttarget             string              // 上游 API 目标地址\n35\t\tbaseDir            string              // Trace 文件存放的基础目录\n36\t\twriter             *trace.TraceWriter  // 当前会话的 Trace 写入器（由 _internal/trace-init 创建）\n37\t\tclient             *http.Client        // 转发请求的 HTTP 客户端\n38\t\tturn               atomic.Int64        // 请求计数器，用于标记 Turn 编号\n39\t\tserver             *http.Server        // 本地代理 HTTP 服务器\n40\t\tstartOnce          sync.Once           // 确保 Start 只执行一次\n41\t\tsessionID          string              // 当前会话 ID（由 trace-init 设置）\n42\t\tprojectSlug        string              // 当前项目标识（由 trace-init 设置）\n43\t\tOnSessionInit      func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\n44\t\tmodel              string              // 强制替换的模型名（空=不改写）\n45\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n46\t\tfallbackConfigs    []*FallbackConfig   // 兜底配置列表（上游不可用时轮询）\n47\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfigs 的并发安全\n48\t\tactualAddr         string              // 实际监听地址（启动后设置）\n49\t\treasoningCache     *ReasoningCache     // reasoning_content 缓存（仅 kimi 模式）\n50\t\tkimiMode           bool                // 是否为 kimi 上游\n51\t\tfallbackIndex      int                 // fallback 轮询索引\n52\t\tretryInterval      time.Duration       // 重试间隔（默认 retryInterval，测试可覆盖）\n53\t}\n54\t\n55\t// FallbackConfig 存储上游不可用时的兜底配置。\n56\ttype FallbackConfig struct {\n57\t\tBaseURL   string // 兜底上游 API 地址\n58\t\tModel     string // 兜底模型名\n59\t\tAuthToken string // 兜底认证 Token\n60\t\tAPIKey    string // 兜底 API Key\n61\t}\n62\t\n63\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n64\t// traceDir 为 Trace 文件存放的基础目录。\n65\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n66\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n67\t\treturn &ReverseProxy{\n68\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n69\t\t\tbaseDir:           traceDir,\n70\t\t\tupstreamAvailable: true,\n71\t\t\tclient:            newProxyHTTPClient(),\n72\t\t}\n73\t}\n74\t\n75\t// newProxyHTTPClient 创建带 Transport 超时的 HTTP 客户端。\n76\t// 流式场景整体不设超时，但连接建立阶段有保护。\n77\tfunc newProxyHTTPClient() *http.Client {\n78\t\treturn &http.Client{\n79\t\t\tTimeout: 0, // 流式场景不设整体超时\n80\t\t\tTransport: &http.Transport{\n81\t\t\t\tDialContext: (&net.Dialer{\n82\t\t\t\t\tTimeout: proxyDialTimeout,\n83\t\t\t\t}).DialContext,\n84\t\t\t\tTLSHandshakeTimeout:   proxyTLSHandshake,\n85\t\t\t\tResponseHeaderTimeout: proxyResponseHdr,\n86\t\t\t\tIdleConnTimeout:       proxyIdleConn,\n87\t\t\t},\n88\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n89\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n90\t\t\t},\n91\t\t}\n92\t}\n93\t\n94\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n95\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n96\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n97\t\tmux := http.NewServeMux()\n98\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n99\t\tp.server = &http.Server{"}]}
