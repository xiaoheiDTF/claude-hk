n441\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n442\t\tif tracePath != \"\" {\n443\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))"}]}
