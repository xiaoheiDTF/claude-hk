= append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n\t}\n\n\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n\tfinalArgs := claudeArgs\n\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {","numLines":40,"startLine":285,"totalLines":633}},"tool_use_id":"call_9e1cafbff8fa491e8ebb3625","duration_ms":2}
