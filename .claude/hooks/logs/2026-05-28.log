, fmt.Errorf(\"run migrations: %w\", err)\n\t}\n\n\treturn &SQLiteStore{\n\t\tdb:         db,\n\t\tissueStore: &sqliteIssueStore{db: db},\n\t}, nil\n}\n\nfunc (s *SQLiteStore) Issues() IssueStore  { return s.issueStore }\nfunc (s *SQLiteStore) Close() error        { return s.db.Close() }\n","structuredPatch":[{"oldStart":35,"oldLines":4,"newStart":35,"newLines":5,"lines":[" }"," "," func (s *SQLiteStore) Issues() IssueStore  { return s.issueStore }","+func (s *SQLiteStore) DB() *sql.DB         { return s.db }"," func (s *SQLiteStore) Close() error        { return s.db.Close() }"]}],"userModified":false,"replaceAll":false},"tool_use_id":"call_3a999c0cf26741998b6226da","duration_ms":8}
