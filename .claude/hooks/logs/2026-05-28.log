result struct {\n\t\tSuccess  bool  `json:\"success\"`\n\t\tReleased *bool `json:\"released\"`\n\t\tError    string `json:\"error\"`\n\t}\n\treadJSON(t, resp, &result)\n\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n\t}\n\tif !result.Success {\n\t\tt.Errorf(\"expected success=true, got false (error: %s)\", result.Error)\n\t}\n\tif result.Released == nil || !*result.Released {\n\t\tt.Error(\"expected released=true\")\n\t}\n\n\t// Verify issue is now idle\n\tcheckResp := env.post(t, \"/api/issue/check\",\n\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[10]}`)\n\tvar check struct {\n\t\tIssues []struct {\n\t\t\tStatus    string  `json:\"status\"`\n\t\t\tSessionID *string `json:\"session_id\"`\n\t\t} `json:\"issues\"`\n\t}\n\treadJSON(t, checkResp, &check)\n\tif len(check.Issues) != 1 || check.Issues[0].Status != \"idle\" {\n\t\tt.Errorf(\"issue should be idle after release, got %v\", check.Issues)\n\t}\n\tif check.Issues[0].SessionID != nil {\n\t\tt.Error(\"session_id should be null after release\")\n\t}\n}\n\nfunc TestReleaseIssue_NonOwnerCannotRelease(t *testing.T) {\n\tenv := setupTest(t)\n\tdb := env.store.DB()\n\n\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n\n\tresp := env.post(t, \"/api/issue/release\",\n\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_other\"}`)\n\n\tvar result struct {\n\t\tSuccess bool   `json:\"success\"`\n\t\tError   string `json:\"error\"`\n\t}\n\treadJSON(t, resp, &result)\n\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n\t}\n\tif result.Success {\n\t\tt.Error(\"expected success=false for non-owner\")\n\t}\n\tif result.Error != \"not_owner\" {\n\t\tt.Errorf(\"expected error=not_owner, got %s\", result.Error)\n\t}\n}\n\nfunc TestReleaseIssue_MergedNotReleased(t *testing.T) {\n\tenv := setupTest(t)\n\tdb := env.store.DB()\n\n\tseedIssue(db, \"test/repo\", 10, \"merged\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n\n\tresp := env.post(t, \"/api/issue/release\",\n\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n\n\tvar result struct {\n\t\tSuccess bool   `json:\"success\"`\n\t\tError   string `json:\"error\"`\n\t}\n\treadJSON(t, resp, &result)\n\n\t// merged owner matches but status is terminal → treated as not_owner\n\tif result.Success {\n\t\tt.Error(\"merged issue should not be released\")\n\t}\n}\n\nfunc TestReleaseIssue_RejectedNotReleased(t *testing.T) {\n\tenv := setupTest(t)\n\tdb := env.store.DB()\n\n\tseedIssue(db, \"test/repo\", 10, \"rejected\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n\n\tresp := env.post(t, \"/api/issue/release\",\n\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10,\"session_id\":\"sess_abc\"}`)\n\n\tvar result struct {\n\t\tSuccess bool   `json:\"success\"`\n\t\tError   string `json:\"error\"`\n\t}\n\treadJSON(t, resp, &result)\n\n\tif result.Success {\n\t\tt.Error(\"rejected issue should not be released\")\n\t}\n}\n\nfunc TestReleaseIssue_MissingParams(t *testing.T) {\n\tenv := setupTest(t)\n\n\tresp := env.post(t, \"/api/issue/release\",\n\t\t`{\"repo_full_name\":\"test/repo\",\"issue_number\":10}`)\n\n\tif resp.StatusCode != http.StatusBadRequest {\n\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n\t}\n}\n\n// --- Release Session tests ---\n\nfunc TestReleaseSession_ReleasesAllNonTerminal(t *testing.T) {\n\tenv := setupTest(t)\n\tdb := env.store.DB()\n\n\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n\tseedIssue(db, \"test/repo\", 11, \"fixing\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n\tseedIssue(db, \"test/repo\", 12, \"merged\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n\n\tresp := env.post(t, \"/api/issue/release-session\",\n\t\t`{\"session_id\":\"sess_abc\"}`)\n\n\tvar result struct {\n\t\tReleased []int `json:\"released\"`\n\t\tCount    int   `json:\"count\"`\n\t}\n\treadJSON(t, resp, &result)\n\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n\t}\n\tif result.Count != 2 {\n\t\tt.Fatalf(\"expected 2 released, got %d\", result.Count)\n\t}\n\n\treleasedSet := map[int]bool{}\n\tfor _, n := range result.Released {\n\t\treleasedSet[n] = true\n\t}\n\tif !releasedSet[10] || !releasedSet[11] {\n\t\tt.Errorf(\"expected issues 10 and 11 released, got %v\", result.Released)\n\t}\n\n\t// Verify #12 (merged) is untouched\n\tcheckResp := env.post(t, \"/api/issue/check\",\n\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[10,11,12]}`)\n\tvar check struct {\n\t\tIssues []struct {\n\t\t\tNumber int    `json:\"number\"`\n\t\t\tStatus string `json:\"status\"`\n\t\t} `json:\"issues\"`\n\t}\n\treadJSON(t, checkResp, &check)\n\n\tbyNum := map[int]string{}\n\tfor _, iss := range check.Issues {\n\t\tbyNum[iss.Number] = iss.Status\n\t}\n\tif byNum[10] != \"idle\" || byNum[11] != \"idle\" {\n\t\tt.Errorf(\"expected 10,11 idle, got %v\", byNum)\n\t}\n\tif byNum[12] != \"merged\" {\n\t\tt.Errorf(\"expected 12 still merged, got %s\", byNum[12])\n\t}\n}\n\nfunc TestReleaseSession_EmptyForNoClaims(t *testing.T) {\n\tenv := setupTest(t)\n\n\tresp := env.post(t, \"/api/issue/release-session\",\n\t\t`{\"session_id\":\"sess_none\"}`)\n\n\tvar result struct {\n\t\tReleased []int `json:\"released\"`\n\t\tCount    int   `json:\"count\"`\n\t}\n\treadJSON(t, resp, &result)\n\n\tif resp.StatusCode != http.StatusOK {\n\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n\t}\n\tif result.Count != 0 {\n\t\tt.Errorf(\"expected 0 released, got %d\", result.Count)\n\t}\n\tif len(result.Released) != 0 {\n\t\tt.Errorf(\"expected empty released array, got %v\", result.Released)\n\t}\n}\n\nfunc TestReleaseSession_MissingSessionID(t *testing.T) {\n\tenv := setupTest(t)\n\n\tresp := env.post(t, \"/api/issue/release-session\", `{}`)\n\n\tif resp.StatusCode != http.StatusBadRequest {\n\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusC