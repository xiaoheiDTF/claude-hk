 \"merged\" {\n528\t\t\tt.Errorf(\"expected 12 still merged, got %s\", byNum[12])\n529\t\t}\n530\t}\n531\t\n532\tfunc TestReleaseSession_EmptyForNoClaims(t *testing.T) {\n533\t\tenv := setupTest(t)\n534\t\n535\t\tresp := env.post(t, \"/api/issue/release-session\",\n536\t\t\t`{\"session_id\":\"sess_none\"}`)\n537\t\n538\t\tvar result struct {\n539\t\t\tReleased []int `json:\"released\"`\n540\t\t\tCount    int   `json:\"count\"`\n541\t\t}\n542\t\treadJSON(t, resp, &result)\n543\t\n544\t\tif resp.StatusCode != http.StatusOK {\n545\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n546\t\t}\n547\t\tif result.Count != 0 {\n548\t\t\tt.Errorf(\"expected 0 released, got %d\", result.Count)\n549\t\t}\n550\t\tif len(result.Released) != 0 {\n551\t\t\tt.Errorf(\"expected empty released array, got %v\", result.Released)\n552\t\t}\n553\t}\n554\t\n555\tfunc TestReleaseSession_MissingSessionID(t *testing.T) {\n556\t\tenv := setupTest(t)\n557\t\n558\t\tresp := env.post(t, \"/api/issue/release-session\", `{}`)\n559\t\n560\t\tif resp.StatusCode != http.StatusBadRequest {\n561\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n562\t\t}\n563\t}\n564\t"}]}
