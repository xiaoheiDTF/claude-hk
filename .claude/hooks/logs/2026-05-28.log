strings.HasPrefix(arg, \"--host=\"):\n            cfg.Host = arg[len(\"--host=\"):]\n        }\n    }\n\n// 第35-36行：用解析好的配置创建 backend 服务器\n    srv, err := backend.NewServer(cfg)\n    if err != nil {\n        log.Fatalf(\"create server: %v\", err)  // 创建失败则打印错误并退出\n    }\n\n// 第39行：defer 保证函数返回时关闭服务器（释放资源）\n    defer srv.Close()\n\n// 第41-43行：启动服务器；如果启动失败，打印错误并退出\n    if err := srv.Start(); err != nil {\n        log.Fatalf(\"server error: %v\", err)\n    }\n}\n```\n\n---\n\n关于\"强制类型转换\"：这个文件里用的方式是 `fmt.Sscanf`，把字符串转成 `int`：\n\n```go\nfmt.Sscanf(args[i], \"%d\", &cfg.Port)\n// \"8080\" (string) → 8080 (int)\n```\n\nGo 中常见的字符串转数字还有两种写法：\n\n```go\n// 方法1：strconv（更常用，还有 error 返回值可以检查）\nn, err := strconv.Atoi(\"8080\")\n\n// 方法2：strconv.ParseInt（可以指定进制和位数）\nn, err := strconv.ParseInt(\"8080\", 10, 64)\n```\n\n这段代码用 `Sscanf` 是最简单的做法，缺点是没有检查返回值——如果用户传了非数字（如 `--port abc`），`cfg.Port` 会保持零值而不会报错。","background_tasks":[],"session_crons":[]}
