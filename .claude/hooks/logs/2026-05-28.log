6\t\n127\t\tif resp.StatusCode != http.StatusOK {\n128\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n129\t\t}\n130\t\tif len(result.Issues) != 0 {\n131\t\t\tt.Fatalf(\"expected empty issues, got %d\", len(result.Issues))\n132\t\t}\n133\t}\n134\t\n135\tfunc TestCheckIssues_NewIssuesAutoCreatedAsIdle(t *testing.T) {\n136\t\tenv := setupTest(t)\n137\t\n138\t\tresp := env.post(t, \"/api/issue/check\",\n139\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[1,2,3]}`)\n140\t\n141\t\tvar result struct {\n142\t\t\tIssues []struct {\n143\t\t\t\tNumber    int     `json:\"number\"`\n144\t\t\t\tStatus    string  `json:\"status\"`\n145\t\t\t\tSessionID *string `json:\"session_id\"`\n146\t\t\t\tClaimedAt *string `json:\"claimed_at\"`\n147\t\t\t} `json:\"issues\"`\n148\t\t}\n149\t\treadJSON(t, resp, &result)\n150\t\n151\t\tif resp.StatusCode != http.StatusOK {\n152\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n153\t\t}\n154\t\tif len(result.Issues) != 3 {\n155\t\t\tt.Fatalf(\"expected 3 issues, got %d\", len(result.Issues))\n156\t\t}\n157\t\n158\t\tfor _, issue := range result.Issues {\n159\t\t\tif issue.Status != \"idle\" {\n160\t\t\t\tt.Errorf(\"issue %d: expected idle, got %s\", issue.Number, issue.Status)\n161\t\t\t}\n162\t\t\tif issue.SessionID != nil {\n163\t\t\t\tt.Errorf(\"issue %d: expected null session_id, got %v\", issue.Number, *issue.SessionID)\n164\t\t\t}\n165\t\t\tif issue.ClaimedAt != nil {\n166\t\t\t\tt.Errorf(\"issue %d: expected null claimed_at, got %v\", issue.Number, *issue.ClaimedAt)\n167\t\t\t}\n168\t\t}\n169\t}\n170\t\n171\tfunc TestCheckIssues_ClaimedAndMerged(t *testing.T) {\n172\t\tenv := setupTest(t)\n173\t\tdb := env.store.DB()\n174\t\n175\t\tseedIssue(db, \"test/repo\", 10, \"claimed\", \"sess_abc\", \"2026-05-26T10:00:00Z\")\n176\t\tseedIssue(db, \"test/repo\", 11, \"merged\", \"\", \"\")\n177\t\n178\t\tresp := env.post(t, \"/api/issue/check\",\n179\t\t\t`{\"repo_full_name\":\"test/repo\",\"issue_numbers\":[9,10,11,12]}`)\n180\t\n181\t\tvar result struct {\n182\t\t\tIssues []struct {\n183\t\t\t\tNumber    int     `json:\"number\"`\n184\t\t\t\tStatus    string  `json:\"status\"`\n185\t\t\t\tSessionID *string `json:\"session_id\"`\n186\t\t\t\tClaimedAt *string `json:\"claimed_at\"`\n187\t\t\t} `json:\"issues\"`\n188\t\t}\n189\t\treadJSON(t, resp, &result)\n190\t\n191\t\tif resp.StatusCode != http.StatusOK {\n192\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n193\t\t}\n194\t\tif len(result.Issues) != 4 {\n195\t\t\tt.Fatalf(\"expected 4 issues, got %d\", len(result.Issues))\n196\t\t}\n197\t\n198\t\tbyNumber := map[int]*struct {\n199\t\t\tNumber    int     `json:\"number\"`\n200\t\t\tStatus    string  `json:\"status\"`\n201\t\t\tSessionID *string `json:\"session_id\"`\n202\t\t\tClaimedAt *string `json:\"claimed_at\"`\n203\t\t}{}\n204\t\tfor i := range result.Issues {\n205\t\t\tbyNumber[result.Issues[i].Number] = &result.Issues[i]\n206\t\t}\n207\t\n208\t\t// #9: new → idle\n209\t\tif byNumber[9].Status != \"idle\" {\n210\t\t\tt.Errorf(\"issue 9: expected idle, got %s\", byNumber[9].Status)\n211\t\t}\n212\t\n213\t\t// #10: claimed\n214\t\tif byNumber[10].Status != \"claimed\" {\n215\t\t\tt.Errorf(\"issue 10: expected claimed, got %s\", byNumber[10].Status)\n216\t\t}\n217\t\tif byNumber[10].SessionID == nil || *byNumber[10].SessionID != \"sess_abc\" {\n218\t\t\tt.Errorf(\"issue 10: expected session_id=sess_abc, got %v\", byNumber[10].SessionID)\n219\t\t}\n220\t\tif byNumber[10].ClaimedAt == nil {\n221\t\t\tt.Error(\"issue 10: expected non-nil claimed_at\")\n222\t\t}\n223\t\n224\t\t// #11: merged\n225\t\tif byNumber[11].Status != \"merged\" {\n226\t\t\tt.Errorf(\"issue 11: expected merged, got %s\", byNumber[11].Status)\n227\t\t}\n228\t\tif byNumber[11].SessionID != nil {\n229\t\t\tt.Errorf(\"issue 11: expected null session_id, got %v\", byNumber[11].SessionID)\n230\t\t}\n231\t\n232\t\t// #12: new → idle\n233\t\tif byNumber[12].Status != \"idle\" {\n234\t\t\tt.Errorf(\"issue 12