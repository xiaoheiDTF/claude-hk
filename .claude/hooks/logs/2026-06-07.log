 return 0\n174\t}\n175\t\n176\t# --- Test 6: 后端可用时完整技能流程 ---\n177\t# 直接调用 _call_backend 模拟 update_issue_status 的后端调用部分\n178\t# （update_issue_status 依赖 gh 命令获取 repo 名，测试环境无 gh）\n179\t\n180\t_update_status() {\n181\t  local url=\"$1\" num=\"$2\" session=\"$3\" status=\"$4\"\n182\t  _call_backend \"/api/issue/status\" \"{\n183\t    \\\"repo_full_name\\\":\\\"test/b6_2\\\",\n184\t    \\\"issue_number\\\":$num,\n185\t    \\\"session_id\\\":\\\"$session\\\",\n186\t    \\\"status\\\":\\\"$status\\\"\n187\t  }\" > /dev/null 2>&1\n188\t}\n189\t\n190\t_check_status() {\n191\t  local url=\"$1\" num=\"$2\"\n192\t  local check\n193\t  check=$(_call_backend \"/api/issue/check\" \"{\\\"repo_full_name\\\":\\\"test/b6_2\\\",\\\"issue_numbers\\\":[$num]}\")\n194\t  echo \"$check\" | jq -r '.issues[0].status'\n195\t}\n196\t\n197\ttest_backend_up_status_flow() {\n198\t  local url=\"${1:-}\"\n199\t  if [ -z \"$url\" ]; then\n200\t    echo \"SKIP: no backend URL\"\n201\t    return 0\n202\t  fi\n203\t\n204\t  echo \"BACKEND_URL=$url\" > \"$BACKEND_CONF\"\n205\t  BACKEND_URL=\"\"\n206\t  source \"$BACKEND_SH\"\n207\t\n208\t  local sid=\"sess_b6_2_e2e\"\n209\t\n210\t  # 1. Claim issue\n211\t  _call_backend \"/api/issue/claim\" \"{\n212\t    \\\"repo_full_name\\\":\\\"test/b6_2\\\",\n213\t    \\\"issue_number\\\":500,\n214\t    \\\"session_id\\\":\\\"$sid\\\"\n215\t  }\" > /dev/null\n216\t  if [ $? -ne 0 ]; then echo \"FAIL: claim\"; return 1; fi\n217\t\n218\t  # 2. fixing（模拟 001-5）\n219\t  _update_status \"$url\" 500 \"$sid\" \"fixing\"\n220\t  local s=$(_check_status \"$url\" 500)\n221\t  if [ \"$s\" != \"fixing\" ]; then echo \"FAIL: expected fixing, got $s\"; return 1; fi\n222\t\n223\t  # 3. ready-for-pr（模拟 001-6）\n224\t  _update_status \"$url\" 500 \"$sid\" \"ready-for-pr\"\n225\t  s=$(_check_status \"$url\" 500)\n226\t  if [ \"$s\" != \"ready-for-pr\" ]; then echo \"FAIL: expected ready-for-pr, got $s\"; return 1; fi\n227\t\n228\t  # 4. pr-created（模拟 001-7）\n229\t  _update_status \"$url\" 500 \"$sid\" \"pr-created\"\n230\t  s=$(_check_status \"$url\" 500)\n231\t  if [ \"$s\" != \"pr-created\" ]; then echo \"FAIL: expected pr-created, got $s\"; return 1; fi\n232\t\n233\t  # 5. testing（模拟 001-8）\n234\t  _update_status \"$url\" 500 \"$sid\" \"testing\"\n235\t  s=$(_check_status \"$url\" 500)\n236\t  if [ \"$s\" != \"testing\" ]; then echo \"FAIL: expected testing, got $s\"; return 1; fi\n237\t\n238\t  # 6. reviewing（模拟 001-9 开始）\n239\t  _update_status \"$url\" 500 \"$sid\" \"reviewing\"\n240\t  s=$(_check_status \"$url\" 500)\n241\t  if [ \"$s\" != \"reviewing\" ]; then echo \"FAIL: expected reviewing, got $s\"; return 1; fi\n242\t\n243\t  # 7. merged（模拟 001-9 merge）\n244\t  _update_status \"$url\" 500 \"$sid\" \"merged\"\n245\t  s=$(_check_status \"$url\" 500)\n246\t  if [ \"$s\" != \"merged\" ]; then echo \"FAIL: expected merged, got $s\"; return 1; fi\n247\t\n248\t  echo \"OK: full skill flow claim→fixing→ready-for-pr→pr-created→testing→reviewing→merged\"\n249\t  return 0\n250\t}\n251\t\n252\t# --- Test 7: 后端可用时 reject 流程 ---\n253\t\n254\ttest_backend_up_reject_flow() {\n255\t  local url=\"${1:-}\"\n256\t  if [ -z \"$url\" ]; then\n257\t    echo \"SKIP: no backend URL\"\n258\t    return 0\n259\t  fi\n260\t\n261\t  echo \"BACKEND_URL=$url\" > \"$BACKEND_CONF\"\n262\t  BACKEND_URL=\"\"\n263\t  source \"$BACKEND_SH\"\n264\t\n265\t  local sid=\"sess_b6_2_reject\"\n266\t\n267\t  # Claim + advance to reviewing\n268\t  _call_backend \"/api/issue/claim\" \"{\n269\t    \\\"repo_full_name\\\":\\\"test/b6_2\\\",\n270\t    \\\"issue_number\\\":501,\n271\t    \\\"session_id\\\":\\\"$sid\\\"\n272\t  }\" > /dev/null\n273\t  for s in \"fixing\" \"ready-for-pr\" \"pr-created\" \"testing\" \"reviewing\"; do\n274\t    _update_status \"$url\" 501 \"$sid\" \"$s\"\n275\t  done\n276\t\n277\t  # Reject\n278\t  _update_status \"$url\" 501 \"$sid\" \"rejected\"\n279\t  local s=$(_check_status \"$url\" 501)\n280\t  if [ \"$s\" != \"rejected\" ]; then\n281\t    echo \"FAIL: expected rejected, got $s\"\n282\t    return 1\n283\t  fi\n284\t\n285\t  echo \"OK: reject flow works\"\n286\t  return 0\n287\t}\n288\t\n289\t# --- Main ---\n290\t\n291\techo \"=== B6-2: 001-5 ~ 001-9 技能改造 — Shell 集成测试 ===\"\n292\techo \"Project: $PROJECT_DIR\"\n293\techo \"\"\n294\t\n295\trun_test \"backend_down_silent_skip\" test_backend_down_silent_skip\n296\trun_test \"no_conf_silent_skip\" test_no_conf_silent_skip\n297\trun_test \"session_id_passed_correctly\" test_session_id_passed_correctly\n298\trun_test \"all_skill_status_labels_mapped\" test_all_skill_status_labels_mapped\n299\trun_test \"sync_github_label_merged_calls_close\" test_sync_github_label_merged_calls_close\n300\t\n301\tBACKEND_URL_ARG=\"${1:-}\"\n302\tif [ -n \"$BACKEND_URL_ARG\" ]; then\n303\t  if command -v jq &>/dev/null; then\n304\t    run_test \"backend_up_status_flow\" test_backend_up_status_flow \"$BACKEND_URL_ARG\"\n305\t    run_test \"backend_up_reject_flow\" test_backend_up_reject_flow \"$BACKEND_URL_ARG\"\n306\t  else\n307\t    echo \"\"\n308\t    echo -e \"${YELLOW}NOTE: Skipping backend-up tests (jq not found).${NC}\"\n309\t  fi\n310\telse\n311\t  echo \"\"\n312\t  echo -e \"${YELLOW}NOTE: Skipping backend-up tests. To run:${NC}\"\n313\t  echo \"  1. Start backend: go run ./cmd/claude-tap backend --port 18080 --db /tmp/b6_2_test.db\"\n314\t  echo \"  2. Run: bash $0 http://127.0.0.1:18080\"\n315\tfi\n316\t\n317\techo \"\"\n318\techo \"================================\"\n319\techo \"Results: $PASS/$TOTAL passed, $FAIL failed\"\n320\techo \"================================\"\n321\t\n322\t[ $FAIL -eq 0 ] || exit 1\n323\t"}]}
