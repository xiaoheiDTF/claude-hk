\t\tswitch os.Args[1] {\n46\t\t\tcase \"session-push\":\n47\t\t\t\trunSessionPush(os.Args[2:])\n48\t\t\t\treturn\n49\t\t\tcase \"session-pull\":\n50\t\t\t\trunSessionPull(os.Args[2:])\n51\t\t\t\treturn\n52\t\t\tcase \"session-status\":\n53\t\t\t\trunSessionStatus(os.Args[2:])\n54\t\t\t\treturn\n55\t\t\tcase \"backend\":\n56\t\t\t\trunBackend(os.Args[2:])\n57\t\t\t\treturn\n58\t\t\tcase \"help\", \"--help\", \"-h\":\n59\t\t\t\tprintUsage()\n60\t\t\t\treturn\n61\t\t\t}\n62\t\t}\n63\t\n64\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n65\t\trunProxy(os.Args[1:])\n66\t}\n67\t\n68\t// printUsage 打印命令行使用帮助信息到标准输出。\n69\tfunc printUsage() {\n70\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n71\t\tfmt.Println()\n72\t\tfmt.Println(\"Usage:\")\n73\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n74\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n75\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n76\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n77\t\tfmt.Println()\n78\t\tfmt.Println(\"Proxy flags:\")\n79\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n80\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n81\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n82\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n83\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n84\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n85\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n86\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n87\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n88\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n89\t\tfmt.Println()\n90\t\tfmt.Println(\"Session-push flags:\")\n91\t\tfmt.Println(\"  --all                  Collect all projects\")\n92\t\tfmt.Println(\"  --force                Overwrite existing files\")\n93\t\tfmt.Println(\"  --dry-run              Preview only\")\n94\t\tfmt.Println(\"  --project NAME         Override project name\")\n95\t\tfmt.Println()\n96\t\tfmt.Println(\"Session-pull flags:\")\n97\t\tfmt.Println(\"  --all                  Restore all projects\")\n98\t\tfmt.Println(\"  --project NAME         Override project name\")\n99\t\tfmt.Println(\"  --dry-run              Preview only\")\n100\t\tfmt.Println()\n101\t\tfmt.Println(\"Session-status flags:\")\n102\t\tfmt.Println(\"  --verbose              Show file-level details\")\n103\t}\n104\t\n105\t// runProxy 是默认的代理模式主逻辑。\n106\t//\n107\t// 工作流程：\n108\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n109\t//  2. 自动探测上游 API 目标地址\n110\t//  3. 启动本地反向代理监听指定端口\n111\t//  4. 解析 Claude Code 可执行文件路径\n112\t//  5. 构建子进程环境变量（注入代理地址）\n113\t//  6. 启动 Claude Code 作为子进程\n114\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n115\t//  8. 子进程退出后打印 API 调用统计摘要\n116\tfunc runProxy(args []string) {\n117\t\t// 记录原始命令行参数，用于生成 resume 命令\n118\t\toriginalArgs := append([]string{}, args...)\n119\t\n120\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n121\t\tvar (\n122\t\t\ttapTarget    string // 上游 API 目标地址\n123\t\t\ttapPort      int    // 本地代理监听端口\n124\t\t\ttapOutputDir string // 追踪记录输出目录\n125\t\t\ttapVerbose   bool   // 是否启用详细日志\n126\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n127\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n128\t\t\ttapAPIKey    string // 直接传入 API Key\n129\t\t\ttapAuthToken string // 直接传入 OAuth Token\n130\t\t\ttapBaseURL   string // 直接传入上游地址\n131\t\t)\n132\t\n133\t\tvar claudeArgs []string\n134\t\tfor i := 0; i < len(args); i++ {\n135\t\t\targ := args[i]\n136\t\t\tswitch {\n137\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n138\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n139\t\t\t\ti++\n140\t\t\t\ttapTarget = args[i]\n141\t\t\t// 解析 --tap-target=URL 形式\n142\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n143\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n144\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n145\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n146\t\t\t\ti++\n147\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n148\t\t\t// 解析 --tap-port=PORT 形式\n149\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n150\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n151\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n152\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n153\t\t\t\ti++\n154\t\t\t\ttapOutputDir = args[i]\n155\t\t\t// 解析 --tap-output-dir=DIR 形式\n156\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n157\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n158\t\t\t// 启用详细日志\n159\t\t\tcase arg == \"--tap-verbose\":\n160\t\t\t\ttapVerbose = true\n161\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n162\t\t\tcase arg == \"--tap-console\":\n163\t\t\t\ttapConsole = true\n164\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n165\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n166\t\t\t\ti++\n167\t\t\t\ttapProfile = args[i]\n168\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n169\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n170\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n171\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n172\t\t\t\ti++\n173\t\t\t\ttapAPIKey = args[i]\n174\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n175\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n176\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n177\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n178\t\t\t\ti++\n179\t\t\t\ttapAuthToken = args[i]\n180\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n181\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n182\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n183\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n184\t\t\t\ti++\n185\t\t\t\ttapBaseURL = args[i]\n186\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n187\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n188\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n189\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n190\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n191\t\t\t\ti = len(args) // 停止解析\n192\t\t\t// 未知的 --tap-* 标志，直接忽略\n193\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n194\t\t\t// 其他参数视为 Claude Code 的参数\n195\t\t\tdefault:\n196\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n197\t\t\t}\n198\t\t}\n199\t\n200\t\t// 如果未指定输出目录，使用默认追踪目录\n201\t\tif tapOutputDir == \"\" {\n202\t\t\ttapOutputDir = trace.DefaultTraceDir()\n203\t\t}\n204\t\n205\t\t// 校验：--tap-console 必须配合 --tap-verbose\n206\t\tif tapConsole && !tapVerbose {\n207\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n208\t\t\tos.Exit(1)\n209\t\t}\n210\t\n211\t\t// 根据详细程度重新初始化日志器\n212\t\tif tapVerbose {\n213\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n214\t\t} else {\n215\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n216\t\t}\n217\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n218\t\n219\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n220\t\tresolved, err := config.ResolveTargetConfig(\n221\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n222\t\t\ttapAPIKey,\n223\t\t\ttapAuthToken,\n224\t\t\ttapProfile,\n225\t\t\t&config.ClaudeClient,\n226\t\t)\n227\t\tif err != nil {\n228\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n229\t\t}\n230\t\ttarget := resolved.BaseURL\n231\t\tif tapVerbose {\n232\t\t\tlog.Printf(\"upstream target: %s\", target)\n233\t\t}\n234\t\n235\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n236\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n237\t\n238\t\t// 设置 model 改写（契约 2：resolved.Model 优先级链）\n239\t\trp.SetModel(resolved.Model)\n240\t\n241\t\t// 检测是否为 kimi 上游，启用 reasoning_content 缓存\n242\t\tif proxy.IsKimiURL(resolved.BaseURL) {\n243\t\t\trp.SetKimiMode(true)\n244\t\t}\n245\t\n246\t\t// 加载兜底配置（契约 4：从 Claude settings 读取）\n247\t\tif fallback := loadFallbackConfig(); fallback != nil {\n248\t\t\trp.SetFallbackConfig(fallback)\n249\t\t}\n250\t\n251\t\tport := tapPort\n252\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n253\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n254\t\tif err != nil {\n255\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n256\t\t}\n257\t\t// 函数退出时停止代理\n258\t\tdefer rp.Stop()\n259\t\n260\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n261\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n262\t\n263\t\t// 自动检测并启动后端服务（如果未运行）\n264\t\tensureBackend()\n265\t\n266\t\t// 向后端注册本代理（hooks 通过后端转发 trace-init）\n267\t\tregisterProxyWithBackend(proxyURL)\n268\t\t// 代理退出时注销\n269\t\tdefer unregisterProxyFromBackend()\n270\t\n271\t\t// ---- Init 锁：串行化 trace-init，确保 PID 文件一对一消费 ----\n272\t\t// 锁机制：mkdir 原子操作（跨平台），确保同一时刻只有一个 proxy 处于 init 阶段\n273\t\tinitLockPath := filepath.Join(BaseDir(), \".init-lock\")\n274\t\tinitPIDPath := filepath.Join(BaseDir(), \".init-pid\")\n275\t\n276\t\t// 获取 init 锁（阻塞等待）\n277\t\tfor {\n278\t\t\tif err := os.Mkdir(initLockPath, 0o755); err == nil {\n279\t\t\t\tlogger.Info(\"main\", \"init lock acquired\")\n280\t\t\t\tbreak\n281\t\t\t}\n282\t\t\tlogger.Debug(\"main\", \"init lock busy, waiting...\")\n283\t\t\ttime.Sleep(100 * time.Millisecond)\n284\t\t}\n285\t\t// 确保退出时释放锁\n286\t\tdefer os.RemoveAll(initLockPath)\n287\t\n288\t\t// 写入 PID 文件（供 hook 读取）\n289\t\tif err := os.WriteFile(initPIDPath, []byte(strconv.Itoa(os.Getpid())), 0o644); err != nil {\n290\t\t\tlogger.Warn(\"main\", \"write init-pid failed: %v\", err)\n291\t\t}\n292\t\tlogger.Info(\"main\", \"init-pid written: %d\", os.Getpid())\n293\t\n294\t\t// trace-init 完成信号\n295\t\tinitDone := make(chan struct{}, 1)\n296\t\trp.OnTraceInitDone = func() {\n297\t\t\tselect {\n298\t\t\tcase initDone <- struct{}{}:\n299\t\t\tdefault:\n300\t\t\t}\n301\t\t}\n302\t\n303\t\t// 设置会话初始化回调：注册到 proxy.json\n304\t\trp.OnSessionInit = func(sessionID, projectSlug string) {\n305\t\t\tkey := ProxySessionKey(projectSlug, sessionID)\n306\t\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\n307\t\t\t\tlogger.Warn(\"main\", \"register proxy session failed: %v\", err)\n308\t\t\t}\n309\t\t}\n310\t\t// 代理退出时注销 proxy.json 中的会话\n311\t\tdefer func() {\n312\t\t\tif sid := rp.SessionID(); sid != \"\" {\n313\t\t\t\tslug := rp.ProjectSlug()\n314\t\t\t\tkey := ProxySessionKey(slug, sid)\n315\t\t\t\tif err := UnregisterProxySession(key); err != nil {\n316\t\t\t\t\tlogger.Warn(\"main\", \"unregister proxy session failed: %v\", err)\n317\t\t\t\t}\n318\t\t\t}\n319\t\t}()\n320\t\n321\t\t// 解析 Claude Code 可执行文件路径\n322\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n323\t\tif err != nil {\n324\t\t\tlog.Fatal(err)\n325\t\t}\n326\t\n327\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n328\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n329\t\n330\t\t// 注入代理 PID 到子进程环境（hook 可直接读取，解决 /clear 后 .init-pid 已消费的问题）\n331\t\tchildEnv = append(childEnv, \"CLAUDE_TAP_PROXY_PID=\"+strconv.Itoa(os.Getpid()))\n332\t\n333\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n334\t\tif resolved.APIKey != \"\" {\n335\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n336\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n337\t\t} else if resolved.AuthToken != \"\" {\n338\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n339\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n340\t\t}\n341\t\n342\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n343\t\tfinalArgs := claudeArgs\n344\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n345\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n346\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n347\t\t}\n348\t\n349\t\t// 启动 Claude Code 作为子进程\n350\t\tcmd := exec.Command(claudePath, finalArgs...)\n351\t\tcmd.Env = childEnv\n352\t\tcmd.Stdin = os.Stdin\n353\t\tcmd.Stdout = os.Stdout\n354\t\tcmd.Stderr = os.Stderr\n355\t\n356\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n357\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n358\t\n359\t\tif err := cmd.Start(); err != nil {\n360\t\t\tlog.Fatalf(\"start claude: %v\", err)\n361\t\t}\n362\t\n363\t\t// 等待 trace-init 完成后释放 init 锁，允许下一个 proxy 启动\n364\t\tselect {\n365\t\tcase <-initDone:\n366\t\t\tlogger.Info(\"main\", \"trace-init received, init lock releasing\")\n367\t\tcase <-time.After(30 * time.Second):\n368\t\t\tlogger.Warn(\"main\", \"trace-init timeout (30s), releasing init lock anyway\")\n369\t\t}\n370\t\t// 删除 PID 文件（如果 hook 未删除）\n371\t\tos.Remove(initPIDPath)\n372\t\t// 释放 init 锁（defer 也会执行，这里提前释放让下一个 proxy 不用等）\n373\t\tos.RemoveAll(initLockPath)\n374\t\n375\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n376\t\tsigChan := make(chan os.Signal, 2)\n377\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n378\t\n379\t\tgo func() {\n380\t\t\tsigCount := 0\n381\t\t\tfor sig := range sigChan {\n382\t\t\t\tsigCount++\n383\t\t\t\tif sigCount == 1 {\n384\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n385\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n386\t\t\t\t\t_ = cmd.Process.Signal(sig)\n387\t\t\t\t} else {\n388\t\t\t\t\t// 再次收到信号：强制终止子进程\n389\t\t\t\t\t_ = cmd.Process.Kill()\n390\t\t\t\t}\n391\t\t\t}\n392\t\t}()\n393\t\n394\t\t// 等待子进程结束\n395\t\twaitErr := cmd.Wait()\n396\t\n397\t\t// 停止信号处理器，释放资源\n398\t\tsignal.Stop(sigChan)\n399\t\tclose(sigChan)\n400\t\n401\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n402\t\tsummary := rp.Summary()\n403\t\ttracePath := rp.TracePath()\n404\t\n405\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n406\t\tif waitErr != nil {\n407\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n408\t\t}\n409\t\tfmt.Printf(\"\\n\")\n410\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n411\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n412\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n413\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n414\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n415\t\tif tracePath != \"\" {\n416\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n417\t\t}\n418\t\tfmt.Printf(\"\\n\")\n419\t\n420\t\t// 生成 Resume 命令（仅在有 session_id 时）\n421\t\tsessionID := rp.SessionID()\n422\t\tif sessionID != \"\" {\n423\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n424\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n425\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n426\t\t}\n427\t}\n428\t\n429\t// loadFallbackConfig 从 Claude settings 加载兜底配置（契约 4）。\n430\t// 读取 ~/.claude/settings.json 中的 base_url、model、认证信息作为 fallback。\n431\tfunc loadFallbackConfig() *proxy.FallbackConfig {\n432\t\ts, err := config.ReadClaudeSettings()\n433\t\tif err != nil || s == nil {\n434\t\t\treturn nil\n435\t\t}\n436\t\n437\t\tbaseURL := s.Env.AnthropicBaseURL\n438\t\tif baseURL == \"\" {\n439\t\t\tbaseURL = config.ClaudeClient.DefaultTarget\n440\t\t}\n441\t\n442\t\treturn &proxy.FallbackConfig{\n443\t\t\tBaseURL:   baseURL,\n444\t\t\tModel:     s.Model,\n445\t\t\tAuthToken: s.Env.AnthropicAuthToken,\n446\t\t\tAPIKey:    s.Env.AnthropicAPIKey,\n447\t\t}\n448\t}\n449\t\n450\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n451\t//\n452\t// 支持的参数：\n453\t//   --all       收集所有项目的会话\n454\t//   --force     覆盖已存在的会话文件\n455\t//   --dry-run   仅预览，不实际执行\n456\t//   --project   指定项目名称，覆盖自动检测\n457\tfunc runSessionPush(args []string) {\n458\t\tvar opts session.PushOptions\n459\t\tfor i := 0; i < len(args); i++ {\n460\t\t\targ := args[i]\n461\t\t\tswitch {\n462\t\t\tcase arg == \"--all\":\n463\t\t\t\topts.All = true\n464\t\t\tcase arg == \"--force\":\n465\t\t\t\topts.Force = true\n466\t\t\tcase arg == \"--dry-run\":\n467\t\t\t\topts.DryRun = true\n468\t\t\tcase arg == \"--project\" && i+1 < len(args):\n469\t\t\t\ti++\n470\t\t\t\topts.Project = args[i]\n471\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n472\t\t\t\topts.Project = arg[len(\"--project=\"):]\n473\t\t\t}\n474\t\t}\n475\t\n476\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n477\t\tresults, err := session.SessionPush(opts)\n478\t\tif err != nil {\n479\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n480\t\t\tos.Exit(1)\n481\t\t}\n482\t\n483\t\t// 汇总各项目的收集结果\n484\t\tfmt.Println()\n485\t\ttotalNew, totalSkipped := 0, 0\n486\t\tfor _, r := range results {\n487\t\t\ttotalNew += r.SessionsNew\n488\t\t\ttotalSkipped += r.SessionsSkipped\n489\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n490\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n491\t\t\t}\n492\t\t}\n493\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n494\t}\n495\t\n496\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n497\t//\n498\t// 支持的参数：\n499\t//   --all       恢复所有项目的会话\n500\t//   --dry-run   仅预览，不实际执行\n501\t//   --project   指定项目名称，覆盖自动检测\n502\tfunc runSessionPull(args []string) {\n503\t\tvar opts session.PullOptions\n504\t\tfor i := 0; i < len(args); i++ {\n505\t\t\targ := args[i]\n506\t\t\tswitch {\n507\t\t\tcase arg == \"--all\":\n508\t\t\t\topts.All = true\n509\t\t\tcase arg == \"--dry-run\":\n510\t\t\t\topts.DryRun = true\n511\t\t\tcase arg == \"--project\" && i+1 < len(args):\n512\t\t\t\ti++\n513\t\t\t\topts.Project = args[i]\n514\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n515\t\t\t\topts.Project = arg[len(\"--project=\"):]\n516\t\t\t}\n517\t\t}\n518\t\n519\t\tfmt.Println(\"📤 Restoring sessions...\")\n520\t\tresults, err := session.SessionPull(opts)\n521\t\tif err != nil {\n522\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n523\t\t\tos.Exit(1)\n524\t\t}\n525\t\n526\t\t// 汇总各项目的恢复结果\n527\t\tfmt.Println()\n528\t\ttotalRestored, totalSkipped := 0, 0\n529\t\tfor _, r := range results {\n530\t\t\ttotalRestored += r.SessionsRestored\n531\t\t\ttotalSkipped += r.SessionsSkipped\n532\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n533\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n534\t\t\t}\n535\t\t}\n536\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n537\t}\n538\t\n539\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n540\t//\n541\t// 支持的参数：\n542\t//   --verbose   显示文件级别的详细信息\n543\tfunc runSessionStatus(args []string) {\n544\t\tvar opts session.StatusOptions\n545\t\tfor i := 0; i < len(args); i++ {\n546\t\t\targ := args[i]\n547\t\t\tswitch {\n548\t\t\tcase arg == \"--verbose\":\n549\t\t\t\topts.Verbose = true\n550\t\t\t}\n551\t\t}\n552\t\n553\t\tif err := session.SessionStatus(opts); err != nil {\n554\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n555\t\t\tos.Exit(1)\n556\t\t}\n557\t}\n558\t\n559\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n560\t// 如果参数中包含空格或制表符，则使用引号包裹。\n561\tfunc formatArgs(args []string) string {\n562\t\tresult := \"\"\n563\t\tfor _, a := range args {\n564\t\t\tif containsSpace(a) {\n565\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n566\t\t\t} else {\n567\t\t\t\tresult += \" \" + a\n568\t\t\t}\n569\t\t}\n570\t\treturn strings.TrimSpace(result)\n571\t}\n572\t\n573\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n574\tfunc containsSpace(s string) bool {\n575\t\tfor _, c := range s {\n576\t\t\tif c == ' ' || c == '\\t' {\n577\t\t\t\treturn true\n578\t\t\t}\n579\t\t}\n580\t\treturn false\n581\t}\n582\t\n583\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n584\tfunc firstNonEmpty(ss ...string) string {\n585\t\tfor _, s := range ss {\n586\t\t\tif s != \"\" {\n587\t\t\t\treturn s\n588\t\t\t}\n589\t\t}\n590\t\treturn \"\"\n591\t}\n592\t\n593\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n594\t//\n595\t// 逻辑：\n596\t//  1. 复制原始参数\n597\t//  2. 移除已有的 --resume <old-id>（如果存在）\n598\t//  3. 追加 --resume <new-session-id>\n599\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n600\t\tfiltered := make([]string, 0, len(originalArgs))\n601\t\tskip := false\n602\t\tfor i, arg := range originalArgs {\n603\t\t\tif skip {\n604\t\t\t\tskip = false\n605\t\t\t\tcontinue\n606\t\t\t}\n607\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n608\t\t\t\tskip = true // 跳过 --resume 及其值\n609\t\t\t\tcontinue\n610\t\t\t}\n611\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n612\t\t\t\tcontinue // 跳过 --resume=id 形式\n613\t\t\t}\n614\t\t\tfiltered = append(filtered, arg)\n615\t\t}\n616\t\tfiltered = append(filtered, \"--resume\", sessionID)\n617\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n618\t}\n619\t\n620\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n621\tfunc shortenPath(path string) string {\n622\t\thome, err := os.UserHomeDir()\n623\t\tif err != nil {\n624\t\t\treturn path\n625\t\t}\n626\t\tif strings.HasPrefix(path, home) {\n627\t\t\treturn \"~\" + path[len(home):]\n628\t\t}\n629\t\treturn path\n630\t}\n631\t\n632\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n633\tfunc removeEnvVar(env []string, name string) []string {\n634\t\tprefix := name + \"=\"\n635\t\tresult := make([]string, 0, len(env))\n636\t\tfor _, e := range env {\n637\t\t\tif !strings.HasPrefix(e, prefix) {\n638\t\t\t\tresult = append(result, e)\n639\t\t\t}\n640\t\t}\n641\t\treturn result\n642\t}\n643\t"}]}
