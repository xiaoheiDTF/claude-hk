[2026-06-07 19:10:02] [INFO] [PostToolBatch] Input: {"session_id":"5a952b88-dbcf-40a5-820e-fed7478f0486","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\5a952b88-dbcf-40a5-820e-fed7478f0486.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Bash","tool_input":{"command":"cat -n D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/proxy_handler.go","description":"Read proxy_handler.go via cat"},"tool_use_id":"call_be0b66acaf4c4918a2d65b4a","tool_response":"     1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\r\n     2\tpackage api\r\n     3\t\r\n     4\timport (\r\n     5\t\t\"bytes\"\r\n     6\t\t\"encoding/json\"\r\n     7\t\t\"fmt\"\r\n     8\t\t\"io\"\r\n     9\t\t\"net/http\"\r\n    10\t\t\"sync\"\r\n    11\t\r\n    12\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\r\n    13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\r\n    14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\r\n    15\t)\r\n    16\t\r\n    17\t// ProxyHandler 处理代理注册、trace-init 转发和代理列表查询。\r\n    18\ttype ProxyHandler struct {\r\n    19\t\tmu            sync.RWMutex\r\n    20\t\tproxies       map[string]string   // pid -> proxy_url，注册的代理列表（内存）\r\n    21\t\tsessions      map[string]string   // session_id -> proxy_url，会话到代理的精确路由映射\r\n    22\t\tproxySessions map[string][]string // pid -> []session_id，代理注销时清理映射\r\n    23\t\tmachineProject map[string]string  // \"machine_id|project_slug\" -> pid，机器+项目亲和路由（/clear 兜底）\r\n    24\t\ttraceMu       sync.Mutex          // trace-init 串行锁，确保一对一消费\r\n    25\t\tsvc           *service.ProxyService // 代理列表服务（数据库）\r\n    26\t}\r\n    27\t\r\n    28\t// NewProxyHandler 创建代理处理器（无数据库依赖，仅内存功能）。\r\n    29\tfunc NewProxyHandler() *ProxyHandler {\r\n    30\t\treturn &ProxyHandler{\r\n    31\t\t\tproxies:        make(map[string]string),\r\n    32\t\t\tsessions:       make(map[string]string),\r\n    33\t\t\tproxySessions:  make(map[string][]string),\r\n    34\t\t\tmachineProject: make(map[string]string),\r\n    35\t\t}\r\n    36\t}\r\n    37\t\r\n    38\t// NewProxyHandlerWithService 创建带数据库服务的代理处理器。\r\n    39\tfunc NewProxyHandlerWithService(svc *service.ProxyService) *ProxyHandler {\r\n    40\t\treturn &ProxyHandler{\r\n    41\t\t\tproxies:        make(map[string]string),\r\n    42\t\t\tsessions:       make(map[string]string),\r\n    43\t\t\tproxySessions:  make(map[string][]string),\r\n    44\t\t\tmachineProject: make(map[string]string),\r\n    45\t\t\tsvc:            svc,\r\n    46\t\t}\r\n    47\t}\r\n    48\t\r\n    49\t// bindSession 将会话绑定到代理 URL（内部调用需持有写锁）。\r\n    50\t// machineID 和 projectSlug 用于记录机器+项目亲和路由（/clear 时精确路由）。\r\n    51\tfunc (h *ProxyHandler) bindSession(pid, sessionID, proxyURL, machineID, projectSlug string) {\r\n    52\t\t// 解绑该 session_id 之前可能绑定的代理\r\n    53\t\tif oldURL, ok := h.sessions[sessionID]; ok && oldURL != proxyURL {\r\n    54\t\t\tlogger.Debug(\"api.proxy\", \"rebind session %s: %s -> %s\", sessionID, oldURL, proxyURL)\r\n    55\t\t}\r\n    56\t\th.sessions[sessionID] = proxyURL\r\n    57\t\t// 记录到 proxy 索引，用于注销时清理\r\n    58\t\tfound := false\r\n    59\t\tfor _, sid := range h.proxySessions[pid] {\r\n    60\t\t\tif sid == sessionID {\r\n    61\t\t\t\tfound = true\r\n    62\t\t\t\tbreak\r\n    63\t\t\t}\r\n    64\t\t}\r\n    65\t\tif !found {\r\n    66\t\t\th.proxySessions[pid] = append(h.proxySessions[pid], sessionID)\r\n    67\t\t}\r\n    68\t\t// 记录机器+项目亲和路由\r\n    69\t\tif machineID != \"\" && projectSlug != \"\" {\r\n    70\t\t\taffinityKey := machineID + \"|\" + projectSlug\r\n    71\t\t\th.machineProject[affinityKey] = pid\r\n    72\t\t}\r\n    73\t}\r\n    74\t\r\n    75\t// unbindProxySessions 清理指定 pid 下的所有 session 绑定和亲和映射（内部调用需持有写锁）。\r\n    76\tfunc (h *ProxyHandler) unbindProxySessions(pid string) {\r\n    77\t\tfor _, sessionID := range h.proxySessions[pid] {\r\n    78\t\t\tif h.sessions[sessionID] == h.proxies[pid] {\r\n    79\t\t\t\tdelete(h.sessions, sessionID)\r\n    80\t\t\t\tlogger.Debug(\"api.proxy\", \"unbind session %s on proxy %s unregister\", sessionID, pid)\r\n    81\t\t\t}\r\n    82\t\t}\r\n    83\t\tdelete(h.proxySessions, pid)\r\n    84\t\t// 清理该代理的亲和映射\r\n    85\t\tfor key, mpPID := range h.machineProject {\r\n    86\t\t\tif mpPID == pid {\r\n    87\t\t\t\tdelete(h.machineProject, key)\r\n    88\t\t\t}\r\n    89\t\t}\r\n    90\t}\r\n    91\t\r\n    92\t// Register 处理代理注册请求。\r\n    93\t// POST /api/proxy/register\r\n    94\t// Body: {\"pid\": \"28364\", \"proxy_url\": \"http://127.0.0.1:64902\"}\r\n    95\tfunc (h *ProxyHandler) Register(w http.ResponseWriter, r *http.Request) {\r\n    96\t\tif r.Method != http.MethodPost {\r\n    97\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\r\n    98\t\t\treturn\r\n    99\t\t}\r\n   100\t\r\n   101\t\tvar req struct {\r\n   102\t\t\tPID      string `json:\"pid\"`\r\n   103\t\t\tProxyURL string `json:\"proxy_url\"`\r\n   104\t\t}\r\n   105\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   106\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\r\n   107\t\t\treturn\r\n   108\t\t}\r\n   109\t\r\n   110\t\tif req.PID == \"\" || req.ProxyURL == \"\" {\r\n   111\t\t\thttp.Error(w, \"pid and proxy_url required\", http.StatusBadRequest)\r\n   112\t\t\treturn\r\n   113\t\t}\r\n   114\t\r\n   115\t\th.mu.Lock()\r\n   116\t\th.proxies[req.PID] = req.ProxyURL\r\n   117\t\th.mu.Unlock()\r\n   118\t\r\n   119\t\tlogger.Info(\"api.proxy\", \"registered: pid=%s url=%s\", req.PID, req.ProxyURL)\r\n   120\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\r\n   121\t}\r\n   122\t\r\n   123\t// Unregister 处理代理注销请求。\r\n   124\t// POST /api/proxy/unregister\r\n   125\t// Body: {\"pid\": \"28364\"}\r\n   126\tfunc (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request) {\r\n   127\t\tif r.Method != http.MethodPost {\r\n   128\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\r\n   129\t\t\treturn\r\n   130\t\t}\r\n   131\t\r\n   132\t\tvar req struct {\r\n   133\t\t\tPID string `json:\"pid\"`\r\n   134\t\t}\r\n   135\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\r\n   136\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\r\n   137\t\t\treturn\r\n   138\t\t}\r\n   139\t\r\n   140\t\th.mu.Lock()\r\n   141\t\th.unbindProxySessions(req.PID)\r\n   142\t\tdelete(h.proxies, req.PID)\r\n   143\t\th.mu.Unlock()\r\n   144\t\r\n   145\t\tlogger.Info(\"api.proxy\", \"unregistered: pid=%s\", req.PID)\r\n   146\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\r\n   147\t}\r\n   148\t\r\n   149\t// TraceInit 转发 trace-init 请求到指定代理。\r\n   150\t// POST /api/proxy/trace-init\r\n   151\t// 路由优先级：\r\n   152\t//  1. proxy_pid 精确路由（init 锁保证一对一）\r\n   153\t//  2. session_id 已绑定代理的精确路由\r\n   154\t//  3. machine+project 亲和路由（/clear 新 session 路由到同一 proxy）\r\n   155\t//  4. 广播探测（兜底，proxy 侧 guard 防止误投）\r\n   156\tfunc (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request) {\r\n   157\t\tif r.Method != http.MethodPost {\r\n   158\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\r\n   159\t\t\treturn\r\n   160\t\t}\r\n   161\t\r\n   162\t\t// 读取请求体\r\n   163\t\tbody, err := io.ReadAll(r.Body)\r\n   164\t\tif err != nil {\r\n   165\t\t\thttp.Error(w, \"read body failed\", http.StatusBadRequest)\r\n   166\t\t\treturn\r\n   167\t\t}\r\n   168\t\r\n   169\t\t// 解析请求\r\n   170\t\tvar tiReq TraceInitRequest\r\n   171\t\tif err := json.Unmarshal(body, &tiReq); err != nil {\r\n   172\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\r\n   173\t\t\treturn\r\n   174\t\t}\r\n   175\t\tif tiReq.SessionID == \"\" {\r\n   176\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\r\n   177\t\t\treturn\r\n   178\t\t}\r\n   179\t\r\n   180\t\t// 串行锁：确保同一时刻只处理一个 trace-init（配合 init PID 文件一对一消费）\r\n   181\t\th.traceMu.Lock()\r\n   182\t\tdefer h.traceMu.Unlock()\r\n   183\t\r\n   184\t\t// 优先级 1：proxy_pid 精确路由（初始启动，init 锁保证一对一）\r\n   185\t\tif tiReq.ProxyPID != \"\" {\r\n   186\t\t\th.mu.RLock()\r\n   187\t\t\tproxyURL, found := h.proxies[tiReq.ProxyPID]\r\n   188\t\t\th.mu.RUnlock()\r\n   189\t\r\n   190\t\t\tif found {\r\n   191\t\t\t\tlogger.Debug(\"api.proxy\", \"trace-init: PID route session=%s to pid=%s url=%s\", tiReq.SessionID, tiReq.ProxyPID, proxyURL)\r\n   192\t\t\t\tresp, err := relayTraceInit(proxyURL, body)\r\n   193\t\t\t\tif err == nil {\r\n   194\t\t\t\t\th.mu.Lock()\r\n   195\t\t\t\t\th.bindSession(tiReq.ProxyPID, tiReq.SessionID, proxyURL, tiReq.MachineID, tiReq.ProjectSlug)\r\n   196\t\t\t\t\th.mu.Unlock()\r\n   197\t\t\t\t\tlogger.Info(\"api.proxy\", \"trace-init: session=%s bound to proxy pid=%s\", tiReq.SessionID, tiReq.ProxyPID)\r\n   198\t\t\t\t\twriteJSON(w, http.StatusOK, resp)\r\n   199\t\t\t\t\treturn\r\n   200\t\t\t\t}\r\n   201\t\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: PID route failed for pid=%s: %v, falling back\", tiReq.ProxyPID, err)\r\n   202\t\t\t} else {\r\n   203\t\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: proxy_pid=%s not registered, falling back\", tiReq.ProxyPID)\r\n   204\t\t\t}\r\n   205\t\t}\r\n   206\t\r\n   207\t\t// 优先级 2：session_id 已绑定代理（重复 trace-init）\r\n   208\t\th.mu.RLock()\r\n   209\t\tboundURL, bound := h.sessions[tiReq.SessionID]\r\n   210\t\th.mu.RUnlock()\r\n   211\t\r\n   212\t\tif bound {\r\n   213\t\t\tlogger.Debug(\"api.proxy\", \"trace-init: direct route session=%s to %s\", tiReq.SessionID, boundURL)\r\n   214\t\t\tresp, err := relayTraceInit(boundURL, body)\r\n   215\t\t\tif err == nil {\r\n   216\t\t\t\twriteJSON(w, http.StatusOK, resp)\r\n   217\t\t\t\treturn\r\n   218\t\t\t}\r\n   219\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: bound proxy %s unreachable for session=%s: %v\", boundURL, tiReq.SessionID, err)\r\n   220\t\t}\r\n   221\t\r\n   222\t\t// 优先级 3：machine+project 亲和路由（/clear 新 session → 同一 proxy）\r\n   223\t\tif tiReq.MachineID != \"\" && tiReq.ProjectSlug != \"\" {\r\n   224\t\t\taffinityKey := tiReq.MachineID + \"|\" + tiReq.ProjectSlug\r\n   225\t\r\n   226\t\t\th.mu.RLock()\r\n   227\t\t\taffinityPID, affinityFound := h.machineProject[affinityKey]\r\n   228\t\t\tvar affinityURL string\r\n   229\t\t\tvar proxyAlive bool\r\n   230\t\t\tif affinityFound {\r\n   231\t\t\t\taffinityURL, proxyAlive = h.proxies[affinityPID]\r\n   232\t\t\t}\r\n   233\t\t\th.mu.RUnlock()\r\n   234\t\r\n   235\t\t\tif affinityFound && proxyAlive {\r\n   236\t\t\t\tlogger.Debug(\"api.proxy\", \"trace-init: affinity route session=%s to pid=%s (machine=%s project=%s)\",\r\n   237\t\t\t\t\ttiReq.SessionID, affinityPID, tiReq.MachineID, tiReq.ProjectSlug)\r\n   238\t\t\t\tresp, err := relayTraceInit(affinityURL, body)\r\n   239\t\t\t\tif err == nil {\r\n   240\t\t\t\t\th.mu.Lock()\r\n   241\t\t\t\t\th.bindSession(affinityPID, tiReq.SessionID, affinityURL, tiReq.MachineID, tiReq.ProjectSlug)\r\n   242\t\t\t\t\th.mu.Unlock()\r\n   243\t\t\t\t\tlogger.Info(\"api.proxy\", \"trace-init: session=%s affinity-bound to proxy pid=%s\", tiReq.SessionID, affinityPID)\r\n   244\t\t\t\t\twriteJSON(w, http.StatusOK, resp)\r\n   245\t\t\t\t\treturn\r\n   246\t\t\t\t}\r\n   247\t\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: affinity route failed for pid=%s: %v, falling back\", affinityPID, err)\r\n   248\t\t\t}\r\n   249\t\t}\r\n   250\t\r\n   251\t\t// 准备广播兜底\r\n   252\t\th.mu.RLock()\r\n   253\t\tproxiesCopy := make(map[string]string, len(h.proxies))\r\n   254\t\tfor pid, url := range h.proxies {\r\n   255\t\t\tproxiesCopy[pid] = url\r\n   256\t\t}\r\n   257\t\th.mu.RUnlock()\r\n   258\t\r\n   259\t\tif len(proxiesCopy) == 0 {\r\n   260\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: no proxies registered\")\r\n   261\t\t\thttp.Error(w, \"no proxies registered\", http.StatusServiceUnavailable)\r\n   262\t\t\treturn\r\n   263\t\t}\r\n   264\t\r\n   265\t\t// 优先级 4：广播探测（兜底）\r\n   266\t\tfor pid, proxyURL := range proxiesCopy {\r\n   267\t\t\tresp, err := relayTraceInit(proxyURL, body)\r\n   268\t\t\tif err != nil {\r\n   269\t\t\t\tlogger.Debug(\"api.proxy\", \"trace-init relay to %s failed: %v\", proxyURL, err)\r\n   270\t\t\t\tcontinue\r\n   271\t\t\t}\r\n   272\t\t\th.mu.Lock()\r\n   273\t\t\th.bindSession(pid, tiReq.SessionID, proxyURL, tiReq.MachineID, tiReq.ProjectSlug)\r\n   274\t\t\th.mu.Unlock()\r\n   275\t\t\tlogger.Info(\"api.proxy\", \"trace-init: session=%s bound to proxy pid=%s url=%s (broadcast)\", tiReq.SessionID, pid, proxyURL)\r\n   276\t\t\twriteJSON(w, http.StatusOK, resp)\r\n   277\t\t\treturn\r\n   278\t\t}\r\n   279\t\r\n   280\t\tlogger.Warn(\"api.proxy\", \"trace-init: all proxies failed for session=%s\", tiReq.SessionID)\r\n   281\t\thttp.Error(w, \"all proxies unreachable\", http.StatusBadGateway)\r\n   282\t}\r\n   283\t\r\n   284\t// List 处理获取代理列表的请求。\r\n   285\t// GET /api/proxies\r\n   286\t// 查询参数：status（可选）、project（可选）\r\n   287\tfunc (h *ProxyHandler) List(w http.ResponseWriter, r *http.Request) {\r\n   288\t\tif r.Method != http.MethodGet {\r\n   289\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\r\n   290\t\t\treturn\r\n   291\t\t}\r\n   292\t\r\n   293\t\tvar filter store.ProxyFilter\r\n   294\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\r\n   295\t\t\tfilter.Status = &v\r\n   296\t\t}\r\n   297\t\tif v := r.URL.Query().Get(\"project\"); v != \"\" {\r\n   298\t\t\tfilter.Project = &v\r\n   299\t\t}\r\n   300\t\r\n   301\t\tlogger.Debug(\"api.proxy\", \"GET /api/proxies status=%v project=%v\", filter.Status, filter.Project)\r\n   302\t\r\n   303\t\tproxies, err := h.svc.List(r.Context(), filter)\r\n   304\t\tif err != nil {\r\n   305\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list proxies\")\r\n   306\t\t\treturn\r\n   307\t\t}\r\n   308\t\r\n   309\t\t// 确保返回空数组而非 null\r\n   310\t\tif proxies == nil {\r\n   311\t\t\tproxies = []store.Proxy{}\r\n   312\t\t}\r\n   313\t\r\n   314\t\titems := make([]ProxyItem, len(proxies))\r\n   315\t\tfor i, p := range proxies {\r\n   316\t\t\titems[i] = ProxyItem{\r\n   317\t\t\t\tProxyID:      p.ProxyID,\r\n   318\t\t\t\tProjectSlug:  p.ProjectSlug,\r\n   319\t\t\t\tStatus:       p.Status,\r\n   320\t\t\t\tRegisteredAt: p.RegisteredAt,\r\n   321\t\t\t\tLastPingAt:   p.LastPingAt,\r\n   322\t\t\t}\r\n   323\t\t}\r\n   324\t\r\n   325\t\twriteJSON(w, http.StatusOK, ProxiesResponse{\r\n   326\t\t\tProxies: items,\r\n   327\t\t\tTotal:   len(items),\r\n   328\t\t})\r\n   329\t}\r\n   330\t\r\n   331\t// relayTraceInit 将 trace-init 请求转发到指定代理。\r\n   332\tfunc relayTraceInit(proxyURL string, body []byte) (map[string]any, error) {\r\n   333\t\tclient := &http.Client{}\r\n   334\t\treq, err := http.NewRequest(\"POST\", proxyURL+\"/_internal/trace-init\", bytes.NewReader(body))\r\n   335\t\tif err != nil {\r\n   336\t\t\treturn nil, err\r\n   337\t\t}\r\n   338\t\treq.Header.Set(\"Content-Type\", \"application/json\")\r\n   339\t\r\n   340\t\tresp, err := client.Do(req)\r\n   341\t\tif err != nil {\r\n   342\t\t\treturn nil, err\r\n   343\t\t}\r\n   344\t\tdefer resp.Body.Close()\r\n   345\t\r\n   346\t\tif resp.StatusCode != http.StatusOK {\r\n   347\t\t\trespBody, _ := io.ReadAll(resp.Body)\r\n   348\t\t\treturn nil, fmt.Errorf(\"proxy returned %d: %s\", resp.StatusCode, string(respBody))\r\n   349\t\t}\r\n   350\t\r\n   351\t\tvar result map[string]any\r\n   352\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\r\n   353\t\t\treturn nil, fmt.Errorf(\"decode proxy response: %w\", err)\r\n   354\t\t}\r\n   355\t\treturn result, nil\r\n   356\t}"}]}
