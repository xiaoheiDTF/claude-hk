[2026-06-07 11:56:39] [INFO] [PostToolBatch] Input: {"session_id":"5a952b88-dbcf-40a5-820e-fed7478f0486","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\5a952b88-dbcf-40a5-820e-fed7478f0486.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"default","effort":{"level":"medium"},"hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\proxy_handler.go"},"tool_use_id":"call_08a5a1f3f1fa4818a1c2ef4a","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"encoding/json\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"net/http\"\n10\t\t\"sync\"\n11\t\n12\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n15\t)\n16\t\n17\t// ProxyHandler 处理代理注册、trace-init 转发和代理列表查询。\n18\ttype ProxyHandler struct {\n19\t\tmu            sync.RWMutex\n20\t\tproxies       map[string]string   // pid -> proxy_url，注册的代理列表（内存）\n21\t\tsessions      map[string]string   // session_id -> proxy_url，会话到代理的精确路由映射\n22\t\tproxySessions map[string][]string // pid -> []session_id，代理注销时清理映射\n23\t\tsvc           *service.ProxyService // 代理列表服务（数据库）\n24\t}\n25\t\n26\t// NewProxyHandler 创建代理处理器（无数据库依赖，仅内存功能）。\n27\tfunc NewProxyHandler() *ProxyHandler {\n28\t\treturn &ProxyHandler{\n29\t\t\tproxies:       make(map[string]string),\n30\t\t\tsessions:      make(map[string]string),\n31\t\t\tproxySessions: make(map[string][]string),\n32\t\t}\n33\t}\n34\t\n35\t// NewProxyHandlerWithService 创建带数据库服务的代理处理器。\n36\tfunc NewProxyHandlerWithService(svc *service.ProxyService) *ProxyHandler {\n37\t\treturn &ProxyHandler{\n38\t\t\tproxies:       make(map[string]string),\n39\t\t\tsessions:      make(map[string]string),\n40\t\t\tproxySessions: make(map[string][]string),\n41\t\t\tsvc:           svc,\n42\t\t}\n43\t}\n44\t\n45\t// bindSession 将会话绑定到代理 URL（内部调用需持有写锁）。\n46\tfunc (h *ProxyHandler) bindSession(pid, sessionID, proxyURL string) {\n47\t\t// 解绑该 session_id 之前可能绑定的代理\n48\t\tif oldURL, ok := h.sessions[sessionID]; ok && oldURL != proxyURL {\n49\t\t\tlogger.Debug(\"api.proxy\", \"rebind session %s: %s -> %s\", sessionID, oldURL, proxyURL)\n50\t\t}\n51\t\th.sessions[sessionID] = proxyURL\n52\t\t// 记录到 proxy 索引，用于注销时清理\n53\t\tfound := false\n54\t\tfor _, sid := range h.proxySessions[pid] {\n55\t\t\tif sid == sessionID {\n56\t\t\t\tfound = true\n57\t\t\t\tbreak\n58\t\t\t}\n59\t\t}\n60\t\tif !found {\n61\t\t\th.proxySessions[pid] = append(h.proxySessions[pid], sessionID)\n62\t\t}\n63\t}\n64\t\n65\t// unbindProxySessions 清理指定 pid 下的所有 session 绑定（内部调用需持有写锁）。\n66\tfunc (h *ProxyHandler) unbindProxySessions(pid string) {\n67\t\tfor _, sessionID := range h.proxySessions[pid] {\n68\t\t\tif h.sessions[sessionID] == h.proxies[pid] {\n69\t\t\t\tdelete(h.sessions, sessionID)\n70\t\t\t\tlogger.Debug(\"api.proxy\", \"unbind session %s on proxy %s unregister\", sessionID, pid)\n71\t\t\t}\n72\t\t}\n73\t\tdelete(h.proxySessions, pid)\n74\t}\n75\t\n76\t// Register 处理代理注册请求。\n77\t// POST /api/proxy/register\n78\t// Body: {\"pid\": \"28364\", \"proxy_url\": \"http://127.0.0.1:64902\"}\n79\tfunc (h *ProxyHandler) Register(w http.ResponseWriter, r *http.Request) {\n80\t\tif r.Method != http.MethodPost {\n81\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n82\t\t\treturn\n83\t\t}\n84\t\n85\t\tvar req struct {\n86\t\t\tPID      string `json:\"pid\"`\n87\t\t\tProxyURL string `json:\"proxy_url\"`\n88\t\t}\n89\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n90\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n91\t\t\treturn\n92\t\t}\n93\t\n94\t\tif req.PID == \"\" || req.ProxyURL == \"\" {\n95\t\t\thttp.Error(w, \"pid and proxy_url required\", http.StatusBadRequest)\n96\t\t\treturn\n97\t\t}\n98\t\n99\t\th.mu.Lock()\n100\t\th.proxies[req.PID] = req.ProxyURL\n101\t\th.mu.Unlock()\n102\t\n103\t\tlogger.Info(\"api.proxy\", \"registered: pid=%s url=%s\", req.PID, req.ProxyURL)\n104\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n105\t}\n106\t\n107\t// Unregister 处理代理注销请求。\n108\t// POST /api/proxy/unregister\n109\t// Body: {\"pid\": \"28364\"}\n110\tfunc (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request) {\n111\t\tif r.Method != http.MethodPost {\n112\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n113\t\t\treturn\n114\t\t}\n115\t\n116\t\tvar req struct {\n117\t\t\tPID string `json:\"pid\"`\n118\t\t}\n119\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n120\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n121\t\t\treturn\n122\t\t}\n123\t\n124\t\th.mu.Lock()\n125\t\th.unbindProxySessions(req.PID)\n126\t\tdelete(h.proxies, req.PID)\n127\t\th.mu.Unlock()\n128\t\n129\t\tlogger.Info(\"api.proxy\", \"unregistered: pid=%s\", req.PID)\n130\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n131\t}\n132\t\n133\t// TraceInit 转发 trace-init 请求到指定代理。\n134\t// POST /api/proxy/trace-init\n135\t// 优先根据 session_id 查询已绑定的代理进行精确转发；未绑定时广播探测并记录映射。\n136\tfunc (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request) {\n137\t\tif r.Method != http.MethodPost {\n138\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n139\t\t\treturn\n140\t\t}\n141\t\n142\t\t// 读取请求体\n143\t\tbody, err := io.ReadAll(r.Body)\n144\t\tif err != nil {\n145\t\t\thttp.Error(w, \"read body failed\", http.StatusBadRequest)\n146\t\t\treturn\n147\t\t}\n148\t\n149\t\t// 解析 session_id 用于精确路由\n150\t\tvar tiReq TraceInitRequest\n151\t\tif err := json.Unmarshal(body, &tiReq); err != nil {\n152\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n153\t\t\treturn\n154\t\t}\n155\t\tif tiReq.SessionID == \"\" {\n156\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n157\t\t\treturn\n158\t\t}\n159\t\n160\t\t// 精确路由：该 session 是否已绑定到某个代理\n161\t\th.mu.RLock()\n162\t\tboundURL, bound := h.sessions[tiReq.SessionID]\n163\t\tproxiesCopy := make(map[string]string, len(h.proxies))\n164\t\tfor pid, url := range h.proxies {\n165\t\t\tproxiesCopy[pid] = url\n166\t\t}\n167\t\th.mu.RUnlock()\n168\t\n169\t\tif bound {\n170\t\t\tlogger.Debug(\"api.proxy\", \"trace-init: direct route session=%s to %s\", tiReq.SessionID, boundURL)\n171\t\t\tresp, err := relayTraceInit(boundURL, body)\n172\t\t\tif err == nil {\n173\t\t\t\twriteJSON(w, http.StatusOK, resp)\n174\t\t\t\treturn\n175\t\t\t}\n176\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: bound proxy %s unreachable for session=%s: %v\", boundURL, tiReq.SessionID, err)\n177\t\t\t// 绑定代理失效，降级为广播探测并更新绑定\n178\t\t}\n179\t\n180\t\tif len(proxiesCopy) == 0 {\n181\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: no proxies registered\")\n182\t\t\thttp.Error(w, \"no proxies registered\", http.StatusServiceUnavailable)\n183\t\t\treturn\n184\t\t}\n185\t\n186\t\t// 广播探测：转发到每个代理，第一个成功者被选中并记录映射\n187\t\tfor pid, proxyURL := range proxiesCopy {\n188\t\t\tresp, err := relayTraceInit(proxyURL, body)\n189\t\t\tif err != nil {\n190\t\t\t\tlogger.Debug(\"api.proxy\", \"trace-init relay to %s failed: %v\", proxyURL, err)\n191\t\t\t\tcontinue\n192\t\t\t}\n193\t\t\th.mu.Lock()\n194\t\t\th.bindSession(pid, tiReq.SessionID, proxyURL)\n195\t\t\th.mu.Unlock()\n196\t\t\tlogger.Info(\"api.proxy\", \"trace-init: session=%s bound to proxy pid=%s url=%s\", tiReq.SessionID, pid, proxyURL)\n197\t\t\twriteJSON(w, http.StatusOK, resp)\n198\t\t\treturn\n199\t\t}\n200\t\n201\t\tlogger.Warn(\"api.proxy\", \"trace-init: all proxies failed for session=%s\", tiReq.SessionID)\n202\t\thttp.Error(w, \"all proxies unreachable\", http.StatusBadGateway)\n203\t}\n204\t\n205\t// List 处理获取代理列表的请求。\n206\t// GET /api/proxies\n207\t// 查询参数：status（可选）、project（可选）\n208\tfunc (h *ProxyHandler) List(w http.ResponseWriter, r *http.Request) {\n209\t\tif r.Method != http.MethodGet {\n210\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n211\t\t\treturn\n212\t\t}\n213\t\n214\t\tvar filter store.ProxyFilter\n215\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\n216\t\t\tfilter.Status = &v\n217\t\t}\n218\t\tif v := r.URL.Query().Get(\"project\"); v != \"\" {\n219\t\t\tfilter.Project = &v\n220\t\t}\n221\t\n222\t\tlogger.Debug(\"api.proxy\", \"GET /api/proxies status=%v project=%v\", filter.Status, filter.Project)\n223\t\n224\t\tproxies, err := h.svc.List(r.Context(), filter)\n225\t\tif err != nil {\n226\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list proxies\")\n227\t\t\treturn\n228\t\t}\n229\t\n230\t\t// 确保返回空数组而非 null\n231\t\tif proxies == nil {\n232\t\t\tproxies = []store.Proxy{}\n233\t\t}\n234\t\n235\t\titems := make([]ProxyItem, len(proxies))\n236\t\tfor i, p := range proxies {\n237\t\t\titems[i] = ProxyItem{\n238\t\t\t\tProxyID:      p.ProxyID,\n239\t\t\t\tProjectSlug:  p.ProjectSlug,\n240\t\t\t\tStatus:       p.Status,\n241\t\t\t\tRegisteredAt: p.RegisteredAt,\n242\t\t\t\tLastPingAt:   p.LastPingAt,\n243\t\t\t}\n244\t\t}\n245\t\n246\t\twriteJSON(w, http.StatusOK, ProxiesResponse{\n247\t\t\tProxies: items,\n248\t\t\tTotal:   len(items),\n249\t\t})\n250\t}\n251\t\n252\t// relayTraceInit 将 trace-init 请求转发到指定代理。\n253\tfunc relayTraceInit(proxyURL string, body []byte) (map[string]any, error) {\n254\t\tclient := &http.Client{}\n255\t\treq, err := http.NewRequest(\"POST\", proxyURL+\"/_internal/trace-init\", bytes.NewReader(body))\n256\t\tif err != nil {\n257\t\t\treturn nil, err\n258\t\t}\n259\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n260\t\n261\t\tresp, err := client.Do(req)\n262\t\tif err != nil {\n263\t\t\treturn nil, err\n264\t\t}\n265\t\tdefer resp.Body.Close()\n266\t\n267\t\tif resp.StatusCode != http.StatusOK {\n268\t\t\trespBody, _ := io.ReadAll(resp.Body)\n269\t\t\treturn nil, fmt.Errorf(\"proxy returned %d: %s\", resp.StatusCode, string(respBody))\n270\t\t}\n271\t\n272\t\tvar result map[string]any\n273\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n274\t\t\treturn nil, fmt.Errorf(\"decode proxy response: %w\", err)\n275\t\t}\n276\t\treturn result, nil\n277\t}\n278\t"}]}
