h\":\n46\t\t\t\trunSessionPush(os.Args[2:])\n47\t\t\t\treturn\n48\t\t\tcase \"session-pull\":\n49\t\t\t\trunSessionPull(os.Args[2:])\n50\t\t\t\treturn\n51\t\t\tcase \"session-status\":\n52\t\t\t\trunSessionStatus(os.Args[2:])\n53\t\t\t\treturn\n54\t\t\tcase \"backend\":\n55\t\t\t\trunBackend(os.Args[2:])\n56\t\t\t\treturn\n57\t\t\tcase \"help\", \"--help\", \"-h\":\n58\t\t\t\tprintUsage()\n59\t\t\t\treturn\n60\t\t\t}\n61\t\t}\n62\t\n63\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n64\t\trunProxy(os.Args[1:])\n65\t}\n66\t\n67\t// printUsage 打印命令行使用帮助信息到标准输出。\n68\tfunc printUsage() {\n69\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n70\t\tfmt.Println()\n71\t\tfmt.Println(\"Usage:\")\n72\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n73\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n74\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n75\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n76\t\tfmt.Println()\n77\t\tfmt.Println(\"Proxy flags:\")\n78\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n79\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n80\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n81\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n82\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n83\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n84\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n85\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n86\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n87\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n88\t\tfmt.Println()\n89\t\tfmt.Println(\"Session-push flags:\")\n90\t\tfmt.Println(\"  --all                  Collect all projects\")\n91\t\tfmt.Println(\"  --force                Overwrite existing files\")\n92\t\tfmt.Println(\"  --dry-run              Preview only\")\n93\t\tfmt.Println(\"  --project NAME         Override project name\")\n94\t\tfmt.Println()\n95\t\tfmt.Println(\"Session-pull flags:\")\n96\t\tfmt.Println(\"  --all                  Restore all projects\")\n97\t\tfmt.Println(\"  --project NAME         Override project name\")\n98\t\tfmt.Println(\"  --dry-run              Preview only\")\n99\t\tfmt.Println()\n100\t\tfmt.Println(\"Session-status flags:\")\n101\t\tfmt.Println(\"  --verbose              Show file-level details\")\n102\t}\n103\t\n104\t// runProxy 是默认的代理模式主逻辑。\n105\t//\n106\t// 工作流程：\n107\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n108\t//  2. 自动探测上游 API 目标地址\n109\t//  3. 启动本地反向代理监听指定端口\n110\t//  4. 解析 Claude Code 可执行文件路径\n111\t//  5. 构建子进程环境变量（注入代理地址）\n112\t//  6. 启动 Claude Code 作为子进程\n113\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n114\t//  8. 子进程退出后打印 API 调用统计摘要\n115\tfunc runProxy(args []string) {\n116\t\t// 记录原始命令行参数，用于生成 resume 命令\n117\t\toriginalArgs := append([]string{}, args...)\n118\t\n119\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n120\t\tvar (\n121\t\t\ttapTarget    string // 上游 API 目标地址\n122\t\t\ttapPort      int    // 本地代理监听端口\n123\t\t\ttapOutputDir string // 追踪记录输出目录\n124\t\t\ttapVerbose   bool   // 是否启用详细日志\n125\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n126\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n127\t\t\ttapAPIKey    string // 直接传入 API Key\n128\t\t\ttapAuthToken string // 直接传入 OAuth Token\n129\t\t\ttapBaseURL   string // 直接传入上游地址\n130\t\t)\n131\t\n132\t\tvar claudeArgs []string\n133\t\tfor i := 0; i < len(args); i++ {\n134\t\t\targ := args[i]\n135\t\t\tswitch {\n136\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n137\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n138\t\t\t\ti++\n139\t\t\t\ttapTarget = args[i]\n140\t\t\t// 解析 --tap-target=URL 形式\n141\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n142\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n143\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n144\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n145\t\t\t\ti++\n146\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n147\t\t\t// 解析 --tap-port=PORT 形式\n148\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n149\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n150\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n151\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n152\t\t\t\ti++\n153\t\t\t\ttapOutputDir = args[i]\n154\t\t\t// 解析 --tap-output-dir=DIR 形式\n155\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n156\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n157\t\t\t// 启用详细日志\n158\t\t\tcase arg == \"--tap-verbose\":\n159\t\t\t\ttapVerbose = true\n160\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n161\t\t\tcase arg == \"--tap-console\":\n162\t\t\t\ttapConsole = true\n163\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n164\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n165\t\t\t\ti++\n166\t\t\t\ttapProfile = args[i]\n167\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n168\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n169\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n170\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n171\t\t\t\ti++\n172\t\t\t\ttapAPIKey = args[i]\n173\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n174\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n175\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n176\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n177\t\t\t\ti++\n178\t\t\t\ttapAuthToken = args[i]\n179\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n180\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n181\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n182\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n183\t\t\t\ti++\n184\t\t\t\ttapBaseURL = args[i]\n185\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n186\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n187\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n188\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n189\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n190\t\t\t\ti = len(args) // 停止解析\n191\t\t\t// 未知的 --tap-* 标志，直接忽略\n192\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n193\t\t\t// 其他参数视为 Claude Code 的参数\n194\t\t\tdefault:\n195\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n196\t\t\t}\n197\t\t}\n198\t\n199\t\t// 如果未指定输出目录，使用默认追踪目录\n200\t\tif tapOutputDir == \"\" {\n201\t\t\ttapOutputDir = trace.DefaultTraceDir()\n202\t\t}\n203\t\n204\t\t// 校验：--tap-console 必须配合 --tap-verbose\n205\t\tif tapConsole && !tapVerbose {\n206\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n207\t\t\tos.Exit(1)\n208\t\t}\n209\t\n210\t\t// 根据详细程度重新初始化日志器\n211\t\tif tapVerbose {\n212\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n213\t\t} else {\n214\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n215\t\t}\n216\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n217\t\n218\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n219\t\tresolved, err := config.ResolveTargetConfig(\n220\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n221\t\t\ttapAPIKey,\n222\t\t\ttapAuthToken,\n223\t\t\ttapProfile,\n224\t\t\t&config.ClaudeClient,\n225\t\t)\n226\t\tif err != nil {\n227\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n228\t\t}\n229\t\ttarget := resolved.BaseURL\n230\t\tif tapVerbose {\n231\t\t\tlog.Printf(\"upstream target: %s\", target)\n232\t\t}\n233\t\n234\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n235\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n236\t\n237\t\t// 设置 model 改写（契约 2：resolved.Model 优先级链）\n238\t\trp.SetModel(resolved.Model)\n239\t\n240\t\t// 检测是否为 kimi 上游，启用 reasoning_content 缓存\n241\t\tif proxy.IsKimiURL(resolved.BaseURL) {\n242\t\t\trp.SetKimiMode(true)\n243\t\t}\n244\t\n245\t\t// 加载兜底配置（契约 4：从 Claude settings 读取）\n246\t\tif fallback := loadFallbackConfig(); fallback != nil {\n247\t\t\trp.SetFallbackConfig(fallback)\n248\t\t}\n249\t\n250\t\tport := tapPort\n251\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n252\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n253\t\tif err != nil {\n254\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n255\t\t}\n256\t\t// 函数退出时停止代理\n257\t\tdefer rp.Stop()\n258\t\n259\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n260\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n261\t\n262\t\t// 自动检测并启动后端服务（如果未运行）\n263\t\tensureBackend()\n264\t\n265\t\t// 向后端注册本代理（hooks 通过环境变量直连 proxy，backend 用于 session/issue 管理）\n266\t\tregisterProxyWithBackend(proxyURL)\n267\t\t// 代理退出时注销\n268\t\tdefer unregisterProxyFromBackend()\n269\t\n270\t\t// 设置会话初始化回调：注册到 proxy.json\n271\t\trp.OnSessionInit = func(sessionID, projectSlug string) {\n272\t\t\tkey := ProxySessionKey(projectSlug, sessionID)\n273\t\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\n274\t\t\t\tlogger.Warn(\"main\", \"register proxy session failed: %v\", err)\n275\t\t\t}\n276\t\t}\n277\t\t// 代理退出时注销 proxy.json 中的会话\n278\t\tdefer func() {\n279\t\t\tif sid := rp.SessionID(); sid != \"\" {\n280\t\t\t\tslug := rp.ProjectSlug()\n281\t\t\t\tkey := ProxySessionKey(slug, sid)\n282\t\t\t\tif err := UnregisterProxySession(key); err != nil {\n283\t\t\t\t\tlogger.Warn(\"main\", \"unregister proxy session failed: %v\", err)\n284\t\t\t\t}\n285\t\t\t}\n286\t\t}()\n287\t\n288\t\t// 解析 Claude Code 可执行文件路径\n289\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n290\t\tif err != nil {\n291\t\t\tlog.Fatal(err)\n292\t\t}\n293\t\n294\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n295\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n296\t\n297\t\t// 注入代理 PID 和 URL 到子进程环境（hook 直接 curl proxy，无需 backend 中转）\n298\t\tchildEnv = append(childEnv, \"CLAUDE_TAP_PROXY_PID=\"+strconv.Itoa(os.Getpid()))\n299\t\tchildEnv = append(childEnv, \"CLAUDE_TAP_PROXY_URL=\"+proxyURL)\n300\t\n301\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n302\t\tif resolved.APIKey != \"\" {\n303\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n304\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n305\t\t} else if resolved.AuthToken != \"\" {\n306\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n307\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n308\t\t}\n309\t\n310\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n311\t\tfinalArgs := claudeArgs\n312\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n313\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n314\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n315\t\t}\n316\t\n317\t\t// 启动 Claude Code 作为子进程\n318\t\tcmd := exec.Command(claudePath, finalArgs...)\n319\t\tcmd.Env = childEnv\n320\t\tcmd.Stdin = os.Stdin\n321\t\tcmd.Stdout = os.Stdout\n322\t\tcmd.Stderr = os.Stderr\n323\t\n324\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n325\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n326\t\n327\t\tif err := cmd.Start(); err != nil {\n328\t\t\tlog.Fatalf(\"start claude: %v\", err)\n329\t\t}\n330\t\n331\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n332\t\tsigChan := make(chan os.Signal, 2)\n333\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n334\t\n335\t\tgo func() {\n336\t\t\tsigCount := 0\n337\t\t\tfor sig := range sigChan {\n338\t\t\t\tsigCount++\n339\t\t\t\tif sigCount == 1 {\n340\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n341\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n342\t\t\t\t\t_ = cmd.Process.Signal(sig)\n343\t\t\t\t} else {\n344\t\t\t\t\t// 再次收到信号：强制终止子进程\n345\t\t\t\t\t_ = cmd.Process.Kill()\n346\t\t\t\t}\n347\t\t\t}\n348\t\t}()\n349\t\n350\t\t// 等待子进程结束\n351\t\twaitErr := cmd.Wait()\n352\t\n353\t\t// 停止信号处理器，释放资源\n354\t\tsignal.Stop(sigChan)\n355\t\tclose(sigChan)\n356\t\n357\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n358\t\tsummary := rp.Summary()\n359\t\ttracePath := rp.TracePath()\n360\t\n361\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n362\t\tif waitErr != nil {\n363\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n364\t\t}\n365\t\tfmt.Printf(\"\\n\")\n366\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n367\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n368\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n369\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n370\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n371\t\tif tracePath != \"\" {\n372\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n373\t\t}\n374\t\tfmt.Printf(\"\\n\")\n375\t\n376\t\t// 生成 Resume 命令（仅在有 session_id 时）\n377\t\tsessionID := rp.SessionID()\n378\t\tif sessionID != \"\" {\n379\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n380\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n381\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n382\t\t}\n383\t}\n384\t\n385\t// loadFallbackConfig 从 Claude settings 加载兜底配置（契约 4）。\n386\t// 读取 ~/.claude/settings.json 中的 base_url、model、认证信息作为 fallback。\n387\tfunc loadFallbackConfig() *proxy.FallbackConfig {\n388\t\ts, err := config.ReadClaudeSettings()\n389\t\tif err != nil || s == nil {\n390\t\t\treturn nil\n391\t\t}\n392\t\n393\t\tbaseURL := s.Env.AnthropicBaseURL\n394\t\tif baseURL == \"\" {\n395\t\t\tbaseURL = config.ClaudeClient.DefaultTarget\n396\t\t}\n397\t\n398\t\treturn &proxy.FallbackConfig{\n399\t\t\tBaseURL:   baseURL,\n400\t\t\tModel:     s.Model,\n401\t\t\tAuthToken: s.Env.AnthropicAuthToken,\n402\t\t\tAPIKey:    s.Env.AnthropicAPIKey,\n403\t\t}\n404\t}\n405\t\n406\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n407\t//\n408\t// 支持的参数：\n409\t//   --all       收集所有项目的会话\n410\t//   --force     覆盖已存在的会话文件\n411\t//   --dry-run   仅预览，不实际执行\n412\t//   --project   指定项目名称，覆盖自动检测\n413\tfunc runSessionPush(args []string) {\n414\t\tvar opts session.PushOptions\n415\t\tfor i := 0; i < len(args); i++ {\n416\t\t\targ := args[i]\n417\t\t\tswitch {\n418\t\t\tcase arg == \"--all\":\n419\t\t\t\topts.All = true\n420\t\t\tcase arg == \"--force\":\n421\t\t\t\topts.Force = true\n422\t\t\tcase arg == \"--dry-run\":\n423\t\t\t\topts.DryRun = true\n424\t\t\tcase arg == \"--project\" && i+1 < len(args):\n425\t\t\t\ti++\n426\t\t\t\topts.Project = args[i]\n427\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n428\t\t\t\topts.Project = arg[len(\"--project=\"):]\n429\t\t\t}\n430\t\t}\n431\t\n432\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n433\t\tresults, err := session.SessionPush(opts)\n434\t\tif err != nil {\n435\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n436\t\t\tos.Exit(1)\n437\t\t}\n438\t\n439\t\t// 汇总各项目的收集结果\n440\t\tfmt.Println()\n441\t\ttotalNew, totalSkipped := 0, 0\n442\t\tfor _, r := range results {\n443\t\t\ttotalNew += r.SessionsNew\n444\t\t\ttotalSkipped += r.SessionsSkipped\n445\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n446\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n447\t\t\t}\n448\t\t}\n449\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n450\t}\n451\t\n452\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n453\t//\n454\t// 支持的参数：\n455\t//   --all       恢复所有项目的会话\n456\t//   --dry-run   仅预览，不实际执行\n457\t//   --project   指定项目名称，覆盖自动检测\n458\tfunc runSessionPull(args []string) {\n459\t\tvar opts session.PullOptions\n460\t\tfor i := 0; i < len(args); i++ {\n461\t\t\targ := args[i]\n462\t\t\tswitch {\n463\t\t\tcase arg == \"--all\":\n464\t\t\t\topts.All = true\n465\t\t\tcase arg == \"--dry-run\":\n466\t\t\t\topts.DryRun = true\n467\t\t\tcase arg == \"--project\" && i+1 < len(args):\n468\t\t\t\ti++\n469\t\t\t\topts.Project = args[i]\n470\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n471\t\t\t\topts.Project = arg[len(\"--project=\"):]\n472\t\t\t}\n473\t\t}\n474\t\n475\t\tfmt.Println(\"📤 Restoring sessions...\")\n476\t\tresults, err := session.SessionPull(opts)\n477\t\tif err != nil {\n478\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n479\t\t\tos.Exit(1)\n480\t\t}\n481\t\n482\t\t// 汇总各项目的恢复结果\n483\t\tfmt.Println()\n484\t\ttotalRestored, totalSkipped := 0, 0\n485\t\tfor _, r := range results {\n486\t\t\ttotalRestored += r.SessionsRestored\n487\t\t\ttotalSkipped += r.SessionsSkipped\n488\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n489\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n490\t\t\t}\n491\t\t}\n492\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n493\t}\n494\t\n495\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n496\t//\n497\t// 支持的参数：\n498\t//   --verbose   显示文件级别的详细信息\n499\tfunc runSessionStatus(args []string) {\n500\t\tvar opts session.StatusOptions\n501\t\tfor i := 0; i < len(args); i++ {\n502\t\t\targ := args[i]\n503\t\t\tswitch {\n504\t\t\tcase arg == \"--verbose\":\n505\t\t\t\topts.Verbose = true\n506\t\t\t}\n507\t\t}\n508\t\n509\t\tif err := session.SessionStatus(opts); err != nil {\n510\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n511\t\t\tos.Exit(1)\n512\t\t}\n513\t}\n514\t\n515\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n516\t// 如果参数中包含空格或制表符，则使用引号包裹。\n517\tfunc formatArgs(args []string) string {\n518\t\tresult := \"\"\n519\t\tfor _, a := range args {\n520\t\t\tif containsSpace(a) {\n521\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n522\t\t\t} else {\n523\t\t\t\tresult += \" \" + a\n524\t\t\t}\n525\t\t}\n526\t\treturn strings.TrimSpace(result)\n527\t}\n528\t\n529\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n530\tfunc containsSpace(s string) bool {\n531\t\tfor _, c := range s {\n532\t\t\tif c == ' ' || c == '\\t' {\n533\t\t\t\treturn true\n534\t\t\t}\n535\t\t}\n536\t\treturn false\n537\t}\n538\t\n539\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n540\tfunc firstNonEmpty(ss ...string) string {\n541\t\tfor _, s := range ss {\n542\t\t\tif s != \"\" {\n543\t\t\t\treturn s\n544\t\t\t}\n545\t\t}\n546\t\treturn \"\"\n547\t}\n548\t\n549\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n550\t//\n551\t// 逻辑：\n552\t//  1. 复制原始参数\n553\t//  2. 移除已有的 --resume <old-id>（如果存在）\n554\t//  3. 追加 --resume <new-session-id>\n555\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n556\t\tfiltered := make([]string, 0, len(originalArgs))\n557\t\tskip := false\n558\t\tfor i, arg := range originalArgs {\n559\t\t\tif skip {\n560\t\t\t\tskip = false\n561\t\t\t\tcontinue\n562\t\t\t}\n563\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n564\t\t\t\tskip = true // 跳过 --resume 及其值\n565\t\t\t\tcontinue\n566\t\t\t}\n567\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n568\t\t\t\tcontinue // 跳过 --resume=id 形式\n569\t\t\t}\n570\t\t\tfiltered = append(filtered, arg)\n571\t\t}\n572\t\tfiltered = append(filtered, \"--resume\", sessionID)\n573\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n574\t}\n575\t\n576\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n577\tfunc shortenPath(path string) string {\n578\t\thome, err := os.UserHomeDir()\n579\t\tif err != nil {\n580\t\t\treturn path\n581\t\t}\n582\t\tif strings.HasPrefix(path, home) {\n583\t\t\treturn \"~\" + path[len(home):]\n584\t\t}\n585\t\treturn path\n586\t}\n587\t\n588\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n589\tfunc removeEnvVar(env []string, name string) []string {\n590\t\tprefix := name + \"=\"\n591\t\tresult := make([]string, 0, len(env))\n592\t\tfor _, e := range env {\n593\t\t\tif !strings.HasPrefix(e, prefix) {\n594\t\t\t\tresult = append(result, e)\n595\t\t\t}\n596\t\t}\n597\t\treturn result\n598\t}\n599\t"}]}
