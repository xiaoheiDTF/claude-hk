()\n46\t\n47\t\ts, err := store.NewSQLiteStore(dbPath)\n48\t\tif err != nil {\n49\t\t\tos.Remove(dbPath)\n50\t\t\tt.Fatal(err)\n51\t\t}\n52\t\n53\t\tt.Cleanup(func() {\n54\t\t\ts.Close()\n55\t\t\tos.Remove(dbPath)\n56\t\t})\n57\t\n58\t\tissueSvc := service.NewIssueService(s.Issues())\n59\t\tsessionSvc := service.NewSessionService(s.Sessions())\n60\t\tproxySvc := service.NewProxyService(s.Proxies())\n61\t\tproxyHandler := api.NewProxyHandlerWithService(proxySvc)\n62\t\n63\t\trouter := api.NewRouter(api.Handlers{\n64\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n65\t\t\tSession: api.NewSessionHandler(sessionSvc, issueSvc, service.NewTokenService(s.Sessions()), service.NewTraceService(s.Sessions())),\n66\t\t\tProxy:   proxyHandler,\n67\t\t})\n68\t\n69\t\tenv := &traceInitTestEnv{\n70\t\t\thandler: proxyHandler,\n71\t\t}\n72\t\n73\t\t// mock proxy A：记录每次收到的 session_id，返回 trace_path_a\n74\t\tenv.proxyA = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n75\t\t\tif r.URL.Path != \"/_internal/trace-init\" {\n76\t\t\t\thttp.NotFound(w, r)\n77\t\t\t\treturn\n78\t\t\t}\n79\t\t\tb, _ := io.ReadAll(r.Body)\n80\t\t\tvar body struct {\n81\t\t\t\tSessionID string `json:\"session_id\"`\n82\t\t\t}\n83\t\t\tjson.Unmarshal(b, &body)\n84\t\t\tenv.aCalls = append(env.aCalls, body.SessionID)\n85\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n86\t\t\tjson.NewEncoder(w).Encode(traceInitResponse{Status: \"ok\", TracePath: \"/traces/a_\" + body.SessionID + \".jsonl\"})\n87\t\t}))\n88\t\n89\t\t// mock proxy B：记录每次收到的 session_id，返回 trace_path_b\n90\t\tenv.proxyB = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n91\t\t\tif r.URL.Path != \"/_internal/trace-init\" {\n92\t\t\t\thttp.NotFound(w, r)\n93\t\t\t\treturn\n94\t\t\t}\n95\t\t\tb, _ := io.ReadAll(r.Body)\n96\t\t\tvar body struct {\n97\t\t\t\tSessionID string `json:\"session_id\"`\n98\t\t\t}\n99\t\t\tjson.Unmarshal(b, &body)\n100\t\t\tenv.bCalls = append(env.bCalls, body.SessionID)\n101\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n102\t\t\tjson.NewEncoder(w).Encode(traceInitResponse{Status: \"ok\", TracePath: \"/traces/b_\" + body.SessionID + \".jsonl\"})\n103\t\t}))\n104\t\n105\t\tenv.srv = httptest.NewServer(router)\n106\t\tt.Cleanup(func() {\n107\t\t\tenv.srv.Close()\n108\t\t\tenv.proxyA.Close()\n109\t\t\tenv.proxyB.Close()\n110\t\t})\n111\t\n112\t\treturn env\n113\t}\n114\t\n115\t// post 发送 POST 请求到测试环境。\n116\tfunc (e *traceInitTestEnv) post(t *testing.T, path, body string) *http.Response {\n117\t\tt.Helper()\n118\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n119\t\tif err != nil {\n120\t\t\tt.Fatal(err)\n121\t\t}\n122\t\treturn resp\n123\t}\n124\t\n125\t// registerProxy 向 backend 注册一个 mock proxy。\n126\tfunc (e *traceInitTestEnv) registerProxy(t *testing.T, pid, url string) {\n127\t\tt.Helper()\n128\t\tresp := e.post(t, \"/api/proxy/register\", fmt.Sprintf(`{\"pid\":\"%s\",\"proxy_url\":\"%s\"}`, pid, url))\n129\t\tdefer resp.Body.Close()\n130\t\tif resp.StatusCode != http.StatusOK {\n131\t\t\tt.Fatalf(\"register proxy %s: expected 200, got %d\", pid, resp.StatusCode)\n132\t\t}\n133\t}\n134\t\n135\t// unregisterProxy 向 backend 注销一个 mock proxy。\n136\tfunc (e *traceInitTestEnv) unregisterProxy(t *testing.T, pid string) {\n137\t\tt.Helper()\n138\t\tresp := e.post(t, \"/api/proxy/unregister\", fmt.Sprintf(`{\"pid\":\"%s\"}`, pid))\n139\t\tdefer resp.Body.Close()\n140\t\tif resp.StatusCode != http.StatusOK {\n141\t\t\tt.Fatalf(\"unregister proxy %s: expected 200, got %d\", pid, resp.StatusCode)\n142\t\t}\n143\t}\n144\t\n145\t// traceInit 请求 /api/proxy/trace-init 并返回响应。\n146\tfunc (e *traceInitTestEnv) traceInit(t *testing.T, sessionID string) traceInitResponse {\n147\t\tt.Helper()\n148\t\tresp := e.post(t, \"/api/proxy/trace-init\", fmt.Sprintf(`{\"session_id\":\"%s\",\"machine_id\":\"u@h\",\"project_slug\":\"proj\"}`, sessionID))\n149\t\tdefer resp.Body.Close()\n150\t\tif resp.StatusCode != http.StatusOK {\n151\t\t\tb, _ := io.ReadAll(resp.Body)\n152\t\t\tt.Fatalf(\"trace-init %s: expected 200, got %d, body=%s\", sessionID, resp.StatusCode, b)\n153\t\t}\n154\t\tvar result traceInitResponse\n155\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n156\t\t\tt.Fatal(err)\n157\t\t}\n158\t\treturn result\n159\t}\n160\t\n161\t// TestTraceInit_DirectRouteAfterFirstHit 验证：首次广播探测后，同一 session_id 直接精确路由。\n162\tfunc TestTraceInit_DirectRouteAfterFirstHit(t *testing.T) {\n163\t\tenv := setupTraceInitTest(t)\n164\t\n165\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n166\t\tenv.registerProxy(t, \"pid-B\", env.proxyB.URL)\n167\t\n168\t\t// 第一次：广播探测（map 随机，假设 A 被选中；无论选中谁都会被记录）\n169\t\tresp1 := env.traceInit(t, \"session-S\")\n170\t\texpected := \"/traces/a_session-S.jsonl\"\n171\t\tif resp1.TracePath != expected && resp1.TracePath != \"/traces/b_session-S.jsonl\" {\n172\t\t\tt.Fatalf(\"unexpected trace path: %s\", resp1.TracePath)\n173\t\t}\n174\t\n175\t\t// 清除计数\n176\t\tbeforeA, beforeB := len(env.aCalls), len(env.bCalls)\n177\t\n178\t\t// 第二次：应该直接路由到同一代理，不广播\n179\t\tresp2 := env.traceInit(t, \"session-S\")\n180\t\tif resp2.TracePath != resp1.TracePath {\n181\t\t\tt.Fatalf(\"expected same proxy on second init, got %s vs %s\", resp2.TracePath, resp1.TracePath)\n182\t\t}\n183\t\n184\t\t// 确认只有一个额外调用落在已绑定代理上\n185\t\tafterA, afterB := len(env.aCalls), len(env.bCalls)\n186\t\tif resp1.TracePath == expected {\n187\t\t\tif afterA != beforeA+1 {\n188\t\t\t\tt.Fatalf(\"expected proxy A called once on second init, A=%d->%d B=%d->%d\", beforeA, afterA, beforeB, afterB)\n189\t\t\t}\n190\t\t\tif afterB != beforeB {\n191\t\t\t\tt.Fatalf(\"expected proxy B not called on second init, A=%d->%d B=%d->%d\", beforeA, afterA, beforeB, afterB)\n192\t\t\t}\n193\t\t} else {\n194\t\t\tif afterB != beforeB+1 {\n195\t\t\t\tt.Fatalf(\"expected proxy B called once on second init, A=%d->%d B=%d->%d\", beforeA, afterA, beforeB, afterB)\n196\t\t\t}\n197\t\t\tif afterA != beforeA {\n198\t\t\t\tt.Fatalf(\"expected proxy A not called on second init, A=%d->%d B=%d->%d\", beforeA, afterA, beforeB, afterB)\n199\t\t\t}\n200\t\t}\n201\t}\n202\t\n203\t// TestTraceInit_RebindOnResume 验证：注销旧 proxy 后同一 session_id 可重新绑定到新 proxy。\n204\tfunc TestTraceInit_RebindOnResume(t *testing.T) {\n205\t\tenv := setupTraceInitTest(t)\n206\t\n207\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n208\t\tenv.registerProxy(t, \"pid-B\", env.proxyB.URL)\n209\t\n210\t\tresp1 := env.traceInit(t, \"session-S\")\n211\t\tif resp1.TracePath == \"\" {\n212\t\t\tt.Fatal(\"expected non-empty trace path\")\n213\t\t}\n214\t\n215\t\t// 模拟 resume：从 A 注销，B 仍在\n216\t\tenv.unregisterProxy(t, \"pid-A\")\n217\t\n218\t\t// 现在只有 B 可用，session-S 应该被重新绑定到 B\n219\t\tresp2 := env.traceInit(t, \"session-S\")\n220\t\texpectedB := \"/traces/b_session-S.jsonl\"\n221\t\tif resp2.TracePath != expectedB {\n222\t\t\tt.Fatalf(\"expected resume to route to proxy B (%s), got %s\", expectedB, resp2.TracePath)\n223\t\t}\n224\t}\n225\t\n226\t// TestTraceInit_UnregisterClearsBinding 验证：注销 proxy 会清理该 proxy 下的 session 绑定。\n227\tfunc TestTraceInit_UnregisterClearsBinding(t *testing.T) {\n228\t\tenv := setupTraceInitTest(t)\n229\t\n230\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n231\t\tresp := env.traceInit(t, \"session-S\")\n232\t\tif resp.TracePath != \"/traces/a_session-S.jsonl\" {\n233\t\t\tt.Fatalf(\"expected proxy A, got %s\", resp.TracePath)\n234\t\t}\n235\t\n236\t\t// 再注册 B，但 A 仍存活；注销 A 后再发一次\n237\t\tenv.registerProxy(t, \"pid-B\", env.proxyB.URL)\n238\t\tenv.unregisterProxy(t, \"pid-A\")\n239\t\n240\t\tresp2 := env.traceInit(t, \"session-S\")\n241\t\tif resp2.TracePath != \"/traces/b_session-S.jsonl\" {\n242\t\t\tt.Fatalf(\"expected fallback to proxy B after A unregister, got %s\", resp2.TracePath)\n243\t\t}\n244\t}\n245\t\n246\t// TestTraceInit_NoProxiesRegistered 验证：无 proxy 时返回 503。\n247\tfunc TestTraceInit_NoProxiesRegistered(t *testing.T) {\n248\t\tenv := setupTraceInitTest(t)\n249\t\n250\t\tresp := env.post(t, \"/api/proxy/trace-init\", `{\"session_id\":\"session-S\",\"machine_id\":\"u@h\",\"project_slug\":\"proj\"}`)\n251\t\tdefer resp.Body.Close()\n252\t\tif resp.StatusCode != http.StatusServiceUnavailable {\n253\t\t\tt.Fatalf(\"expected 503, got %d\", resp.StatusCode)\n254\t\t}\n255\t}\n256\t\n257\t// TestTraceInit_MissingSessionID 验证：缺少 session_id 返回 400。\n258\tfunc TestTraceInit_MissingSessionID(t *testing.T) {\n259\t\tenv := setupTraceInitTest(t)\n260\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n261\t\n262\t\tresp := env.post(t, \"/api/proxy/trace-init\", `{\"machine_id\":\"u@h\",\"project_slug\":\"proj\"}`)\n263\t\tdefer resp.Body.Close()\n264\t\tif resp.StatusCode != http.StatusBadRequest {\n265\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n266\t\t}\n267\t}\n268\t"}]}
