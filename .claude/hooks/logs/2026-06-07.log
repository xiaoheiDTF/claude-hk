\t    log \"WARN\" \"Python 不可用，部分功能受限\"\n46\t  fi\n47\t}\n48\t\n49\t# 3. 目录完整性\n50\tensure_dirs() {\n51\t  source \"$CLAUDE_PROJECT_DIR/.claude/scripts/ensure_dirs.sh\"\n52\t  local missing\n53\t  missing=$(check_dirs 2>&1)\n54\t  if [ \"$missing\" = \"ALL OK\" ]; then\n55\t    log \"INFO\" \"目录检查通过\"\n56\t  else\n57\t    log \"WARN\" \"目录缺失，重新创建: $missing\"\n58\t    ensure_all_dirs \"$LOG_FILE\" > /dev/null\n59\t  fi\n60\t}\n61\t\n62\tensure_utf8\n63\tensure_python_check\n64\tensure_dirs\n65\t\n66\t# 4. Skill 级巡检\n67\tensure_skill_checks() {\n68\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n69\t  [ -d \"$skills_dir\" ] || return\n70\t  for check_script in \"$skills_dir\"/*/scripts/init_check.sh; do\n71\t    [ -f \"$check_script\" ] || continue\n72\t    local skill_name\n73\t    skill_name=$(basename \"$(dirname \"$(dirname \"$check_script\")\")\")\n74\t    if bash \"$check_script\" >> \"$LOG_FILE\" 2>&1; then\n75\t      log \"INFO\" \"Skill check OK: $skill_name\"\n76\t    else\n77\t      log \"WARN\" \"Skill check failed: $skill_name (non-blocking)\"\n78\t    fi\n79\t  done\n80\t}\n81\t\n82\tensure_skill_checks\n83\t\n84\t# trace-init 返回的 trace 路径，供 register_session 回填 local_trace_path\n85\t__LAST_TRACE_PATH=\"\"\n86\t\n87\t# 5. 初始化代理 trace 路径（通过后端 8080 转发到代理）\n88\tinit_trace_path() {\n89\t  if ! _backend_available; then\n90\t    log \"DEBUG\" \"Trace init skipped (backend/proxy unreachable)\"\n91\t    return 0\n92\t  fi\n93\t\n94\t  local sid\n95\t  sid=$(json_get '.session_id')\n96\t  [ -z \"$sid\" ] && return 0\n97\t\n98\t  local transcript_path\n99\t  transcript_path=$(json_get '.transcript_path')\n100\t\n101\t  # Windows 路径反斜杠转义：\\ → \\\\（否则 Go JSON 解析器拒绝非法转义序列如 \\U）\n102\t  local safe_transcript_path=\"${transcript_path//\\\\/\\\\\\\\}\"\n103\t\n104\t  # 获取代理 PID：优先从环境变量（/clear 后仍有效），其次从 init-pid 文件（首次启动）\n105\t  local tap_pid=\"${CLAUDE_TAP_PROXY_PID:-}\"\n106\t  if [ -n \"$tap_pid\" ]; then\n107\t    log \"INFO\" \"Proxy PID from env: $tap_pid\"\n108\t  else\n109\t    local init_pid_file=\"$HOME/.claude-tap-plus/.init-pid\"\n110\t    if [ -f \"$init_pid_file\" ]; then\n111\t      tap_pid=$(cat \"$init_pid_file\" 2>/dev/null)\n112\t      rm -f \"$init_pid_file\"\n113\t      log \"INFO\" \"Init PID consumed: ${tap_pid:-empty}\"\n114\t    fi\n115\t  fi\n116\t\n117\t  # 通过后端转发 trace-init 到代理（PID 精确路由，不猜）\n118\t  if [ -z \"$tap_pid\" ]; then\n119\t    log \"WARN\" \"Trace init skipped: no proxy PID available\"\n120\t    return 0\n121\t  fi\n122\t\n123\t  local result\n124\t  result=$(_call_backend \"/api/proxy/trace-init\" \"{\n125\t    \\\"session_id\\\":\\\"$sid\\\",\n126\t    \\\"proxy_pid\\\":\\\"$tap_pid\\\",\n127\t    \\\"transcript_path\\\":\\\"$safe_transcript_path\\\"\n128\t  }\")\n129\t\n130\t  if [ -n \"$result\" ]; then\n131\t    __LAST_TRACE_PATH=$(echo \"$result\" | jq -r '.trace_path // \"\"' 2>/dev/null)\n132\t    log \"INFO\" \"Trace initialized: ${__LAST_TRACE_PATH:-unknown}\"\n133\t  else\n134\t    log \"DEBUG\" \"Trace init failed (backend call returned empty)\"\n135\t  fi\n136\t}\n137\t\n138\t# 6. 注册会话到后端（SR-2）\n139\tregister_session() {\n140\t  if ! _backend_available; then\n141\t    log \"DEBUG\" \"Backend unreachable, skipping session registration\"\n142\t    return 0\n143\t  fi\n144\t\n145\t  local session_id transcript_path cwd model source_type os_type machine_id project_slug\n146\t\n147\t  session_id=$(json_get '.session_id')\n148\t  [ -z \"$session_id\" ] && return 0\n149\t\n150\t  transcript_path=$(json_get '.transcript_path')\n151\t  cwd=$(json_get '.cwd')\n152\t  model=$(json_get '.model')\n153\t  source_type=$(json_get '.source')\n154\t\n155\t  machine_id=\"$(whoami 2>/dev/null || echo unknown)@$(hostname 2>/dev/null || echo unknown)\"\n156\t\n157\t  case \"$(uname -s)\" in\n158\t    Linux*)   os_type=\"linux\" ;;\n159\t    Darwin*)  os_type=\"macos\" ;;\n160\t    MINGW*|MSYS*|CYGWIN*) os_type=\"windows\" ;;\n161\t    *)        os_type=\"unknown\" ;;\n162\t  esac\n163\t\n164\t  project_slug=$(echo \"$transcript_path\" | sed -n 's/.*[\\.]claude[\\\\/]\\{1\\}projects[\\\\/]\\{1\\}\\([^\\\\/]*\\).*/\\1/p')\n165\t  [ -z \"$project_slug\" ] && project_slug=$(basename \"$cwd\" 2>/dev/null)\n166\t\n167\t  # Windows 路径反斜杠转义\n168\t  local safe_cwd=\"${cwd//\\\\/\\\\\\\\}\"\n169\t  local safe_transcript_path=\"${transcript_path//\\\\/\\\\\\\\}\"\n170\t  local safe_trace_path=\"${__LAST_TRACE_PATH//\\\\/\\\\\\\\}\"\n171\t\n172\t  _call_backend \"/api/session/register\" \"{\n173\t    \\\"session_id\\\":\\\"$session_id\\\",\n174\t    \\\"machine_id\\\":\\\"$machine_id\\\",\n175\t    \\\"os\\\":\\\"$os_type\\\",\n176\t    \\\"project_slug\\\":\\\"$project_slug\\\",\n177\t    \\\"project_cwd\\\":\\\"$safe_cwd\\\",\n178\t    \\\"transcript_path\\\":\\\"$safe_transcript_path\\\",\n179\t    \\\"local_trace_path\\\":\\\"$safe_trace_path\\\",\n180\t    \\\"model\\\":\\\"$model\\\",\n181\t    \\\"source\\\":\\\"$source_type\\\"\n182\t  }\" > /dev/null 2>&1\n183\t\n184\t  log \"INFO\" \"Session registered to backend: $session_id\"\n185\t}\n186\t\n187\tinit_trace_path\n188\tregister_session\n189\t\n190\thook_output 0 '{}'\n191\t"}]}
