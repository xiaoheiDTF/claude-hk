.Args[2:])\n46\t\t\t\treturn\n47\t\t\tcase \"session-pull\":\n48\t\t\t\trunSessionPull(os.Args[2:])\n49\t\t\t\treturn\n50\t\t\tcase \"session-status\":\n51\t\t\t\trunSessionStatus(os.Args[2:])\n52\t\t\t\treturn\n53\t\t\tcase \"backend\":\n54\t\t\t\trunBackend(os.Args[2:])\n55\t\t\t\treturn\n56\t\t\tcase \"help\", \"--help\", \"-h\":\n57\t\t\t\tprintUsage()\n58\t\t\t\treturn\n59\t\t\t}\n60\t\t}\n61\t\n62\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n63\t\trunProxy(os.Args[1:])\n64\t}\n65\t\n66\t// printUsage 打印命令行使用帮助信息到标准输出。\n67\tfunc printUsage() {\n68\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n69\t\tfmt.Println()\n70\t\tfmt.Println(\"Usage:\")\n71\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n72\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n73\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n74\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n75\t\tfmt.Println()\n76\t\tfmt.Println(\"Proxy flags:\")\n77\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n78\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n79\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n80\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n81\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n82\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n83\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n84\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n85\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n86\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n87\t\tfmt.Println()\n88\t\tfmt.Println(\"Session-push flags:\")\n89\t\tfmt.Println(\"  --all                  Collect all projects\")\n90\t\tfmt.Println(\"  --force                Overwrite existing files\")\n91\t\tfmt.Println(\"  --dry-run              Preview only\")\n92\t\tfmt.Println(\"  --project NAME         Override project name\")\n93\t\tfmt.Println()\n94\t\tfmt.Println(\"Session-pull flags:\")\n95\t\tfmt.Println(\"  --all                  Restore all projects\")\n96\t\tfmt.Println(\"  --project NAME         Override project name\")\n97\t\tfmt.Println(\"  --dry-run              Preview only\")\n98\t\tfmt.Println()\n99\t\tfmt.Println(\"Session-status flags:\")\n100\t\tfmt.Println(\"  --verbose              Show file-level details\")\n101\t}\n102\t\n103\t// runProxy 是默认的代理模式主逻辑。\n104\t//\n105\t// 工作流程：\n106\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n107\t//  2. 自动探测上游 API 目标地址\n108\t//  3. 启动本地反向代理监听指定端口\n109\t//  4. 解析 Claude Code 可执行文件路径\n110\t//  5. 构建子进程环境变量（注入代理地址）\n111\t//  6. 启动 Claude Code 作为子进程\n112\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n113\t//  8. 子进程退出后打印 API 调用统计摘要\n114\tfunc runProxy(args []string) {\n115\t\t// 记录原始命令行参数，用于生成 resume 命令\n116\t\toriginalArgs := append([]string{}, args...)\n117\t\n118\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n119\t\tvar (\n120\t\t\ttapTarget    string // 上游 API 目标地址\n121\t\t\ttapPort      int    // 本地代理监听端口\n122\t\t\ttapOutputDir string // 追踪记录输出目录\n123\t\t\ttapVerbose   bool   // 是否启用详细日志\n124\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n125\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n126\t\t\ttapAPIKey    string // 直接传入 API Key\n127\t\t\ttapAuthToken string // 直接传入 OAuth Token\n128\t\t\ttapBaseURL   string // 直接传入上游地址\n129\t\t)\n130\t\n131\t\tvar claudeArgs []string\n132\t\tfor i := 0; i < len(args); i++ {\n133\t\t\targ := args[i]\n134\t\t\tswitch {\n135\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n136\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n137\t\t\t\ti++\n138\t\t\t\ttapTarget = args[i]\n139\t\t\t// 解析 --tap-target=URL 形式\n140\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n141\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n142\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n143\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n144\t\t\t\ti++\n145\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n146\t\t\t// 解析 --tap-port=PORT 形式\n147\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n148\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n149\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n150\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n151\t\t\t\ti++\n152\t\t\t\ttapOutputDir = args[i]\n153\t\t\t// 解析 --tap-output-dir=DIR 形式\n154\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n155\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n156\t\t\t// 启用详细日志\n157\t\t\tcase arg == \"--tap-verbose\":\n158\t\t\t\ttapVerbose = true\n159\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n160\t\t\tcase arg == \"--tap-console\":\n161\t\t\t\ttapConsole = true\n162\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n163\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n164\t\t\t\ti++\n165\t\t\t\ttapProfile = args[i]\n166\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n167\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n168\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n169\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n170\t\t\t\ti++\n171\t\t\t\ttapAPIKey = args[i]\n172\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n173\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n174\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n175\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n176\t\t\t\ti++\n177\t\t\t\ttapAuthToken = args[i]\n178\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n179\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n180\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n181\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n182\t\t\t\ti++\n183\t\t\t\ttapBaseURL = args[i]\n184\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n185\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n186\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n187\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n188\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n189\t\t\t\ti = len(args) // 停止解析\n190\t\t\t// 未知的 --tap-* 标志，直接忽略\n191\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n192\t\t\t// 其他参数视为 Claude Code 的参数\n193\t\t\tdefault:\n194\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n195\t\t\t}\n196\t\t}\n197\t\n198\t\t// 如果未指定输出目录，使用默认追踪目录\n199\t\tif tapOutputDir == \"\" {\n200\t\t\ttapOutputDir = trace.DefaultTraceDir()\n201\t\t}\n202\t\n203\t\t// 校验：--tap-console 必须配合 --tap-verbose\n204\t\tif tapConsole && !tapVerbose {\n205\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n206\t\t\tos.Exit(1)\n207\t\t}\n208\t\n209\t\t// 根据详细程度重新初始化日志器\n210\t\tif tapVerbose {\n211\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n212\t\t} else {\n213\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n214\t\t}\n215\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n216\t\n217\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n218\t\tresolved, err := config.ResolveTargetConfig(\n219\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n220\t\t\ttapAPIKey,\n221\t\t\ttapAuthToken,\n222\t\t\ttapProfile,\n223\t\t\t&config.ClaudeClient,\n224\t\t)\n225\t\tif err != nil {\n226\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n227\t\t}\n228\t\ttarget := resolved.BaseURL\n229\t\tif tapVerbose {\n230\t\t\tlog.Printf(\"upstream target: %s\", target)\n231\t\t}\n232\t\n233\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n234\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n235\t\n236\t\t// 设置 model 改写（契约 2：resolved.Model 优先级链）\n237\t\trp.SetModel(resolved.Model)\n238\t\n239\t\t// 检测是否为 kimi 上游，启用 reasoning_content 缓存\n240\t\tif proxy.IsKimiURL(resolved.BaseURL) {\n241\t\t\trp.SetKimiMode(true)\n242\t\t}\n243\t\n244\t\t// 加载兜底配置（契约 4：从 Claude settings 读取）\n245\t\tif fallback := loadFallbackConfig(); fallback != nil {\n246\t\t\trp.SetFallbackConfig(fallback)\n247\t\t}\n248\t\n249\t\tport := tapPort\n250\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n251\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n252\t\tif err != nil {\n253\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n254\t\t}\n255\t\t// 函数退出时停止代理\n256\t\tdefer rp.Stop()\n257\t\n258\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n259\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n260\t\n261\t\t// 自动检测并启动后端服务（如果未运行）\n262\t\tensureBackend()\n263\t\n264\t\t// 向后端注册本代理（hooks 通过后端转发 trace-init）\n265\t\tregisterProxyWithBackend(proxyURL)\n266\t\t// 代理退出时注销\n267\t\tdefer unregisterProxyFromBackend()\n268\t\n269\t\t// 设置会话初始化回调：注册到 proxy.json\n270\t\trp.OnSessionInit = func(sessionID, projectSlug string) {\n271\t\t\tkey := ProxySessionKey(projectSlug, sessionID)\n272\t\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\n273\t\t\t\tlogger.Warn(\"main\", \"register proxy session failed: %v\", err)\n274\t\t\t}\n275\t\t}\n276\t\t// 代理退出时注销 proxy.json 中的会话\n277\t\tdefer func() {\n278\t\t\tif sid := rp.SessionID(); sid != \"\" {\n279\t\t\t\tslug := rp.ProjectSlug()\n280\t\t\t\tkey := ProxySessionKey(slug, sid)\n281\t\t\t\tif err := UnregisterProxySession(key); err != nil {\n282\t\t\t\t\tlogger.Warn(\"main\", \"unregister proxy session failed: %v\", err)\n283\t\t\t\t}\n284\t\t\t}\n285\t\t}()\n286\t\n287\t\t// 解析 Claude Code 可执行文件路径\n288\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n289\t\tif err != nil {\n290\t\t\tlog.Fatal(err)\n291\t\t}\n292\t\n293\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n294\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n295\t\n296\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n297\t\tif resolved.APIKey != \"\" {\n298\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n299\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n300\t\t} else if resolved.AuthToken != \"\" {\n301\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n302\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n303\t\t}\n304\t\n305\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n306\t\tfinalArgs := claudeArgs\n307\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n308\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n309\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n310\t\t}\n311\t\n312\t\t// 启动 Claude Code 作为子进程\n313\t\tcmd := exec.Command(claudePath, finalArgs...)\n314\t\tcmd.Env = childEnv\n315\t\tcmd.Stdin = os.Stdin\n316\t\tcmd.Stdout = os.Stdout\n317\t\tcmd.Stderr = os.Stderr\n318\t\n319\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n320\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n321\t\n322\t\tif err := cmd.Start(); err != nil {\n323\t\t\tlog.Fatalf(\"start claude: %v\", err)\n324\t\t}\n325\t\n326\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n327\t\tsigChan := make(chan os.Signal, 2)\n328\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n329\t\n330\t\tgo func() {\n331\t\t\tsigCount := 0\n332\t\t\tfor sig := range sigChan {\n333\t\t\t\tsigCount++\n334\t\t\t\tif sigCount == 1 {\n335\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n336\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n337\t\t\t\t\t_ = cmd.Process.Signal(sig)\n338\t\t\t\t} else {\n339\t\t\t\t\t// 再次收到信号：强制终止子进程\n340\t\t\t\t\t_ = cmd.Process.Kill()\n341\t\t\t\t}\n342\t\t\t}\n343\t\t}()\n344\t\n345\t\t// 等待子进程结束\n346\t\twaitErr := cmd.Wait()\n347\t\n348\t\t// 停止信号处理器，释放资源\n349\t\tsignal.Stop(sigChan)\n350\t\tclose(sigChan)\n351\t\n352\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n353\t\tsummary := rp.Summary()\n354\t\ttracePath := rp.TracePath()\n355\t\n356\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n357\t\tif waitErr != nil {\n358\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n359\t\t}\n360\t\tfmt.Printf(\"\\n\")\n361\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n362\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n363\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n364\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n365\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n366\t\tif tracePath != \"\" {\n367\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n368\t\t}\n369\t\tfmt.Printf(\"\\n\")\n370\t\n371\t\t// 生成 Resume 命令（仅在有 session_id 时）\n372\t\tsessionID := rp.SessionID()\n373\t\tif sessionID != \"\" {\n374\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n375\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n376\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n377\t\t}\n378\t}\n379\t\n380\t// loadFallbackConfig 从 Claude settings 加载兜底配置（契约 4）。\n381\t// 读取 ~/.claude/settings.json 中的 base_url、model、认证信息作为 fallback。\n382\tfunc loadFallbackConfig() *proxy.FallbackConfig {\n383\t\ts, err := config.ReadClaudeSettings()\n384\t\tif err != nil || s == nil {\n385\t\t\treturn nil\n386\t\t}\n387\t\n388\t\tbaseURL := s.Env.AnthropicBaseURL\n389\t\tif baseURL == \"\" {\n390\t\t\tbaseURL = config.ClaudeClient.DefaultTarget\n391\t\t}\n392\t\n393\t\treturn &proxy.FallbackConfig{\n394\t\t\tBaseURL:   baseURL,\n395\t\t\tModel:     s.Model,\n396\t\t\tAuthToken: s.Env.AnthropicAuthToken,\n397\t\t\tAPIKey:    s.Env.AnthropicAPIKey,\n398\t\t}\n399\t}\n400\t\n401\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n402\t//\n403\t// 支持的参数：\n404\t//   --all       收集所有项目的会话\n405\t//   --force     覆盖已存在的会话文件\n406\t//   --dry-run   仅预览，不实际执行\n407\t//   --project   指定项目名称，覆盖自动检测\n408\tfunc runSessionPush(args []string) {\n409\t\tvar opts session.PushOptions\n410\t\tfor i := 0; i < len(args); i++ {\n411\t\t\targ := args[i]\n412\t\t\tswitch {\n413\t\t\tcase arg == \"--all\":\n414\t\t\t\topts.All = true\n415\t\t\tcase arg == \"--force\":\n416\t\t\t\topts.Force = true\n417\t\t\tcase arg == \"--dry-run\":\n418\t\t\t\topts.DryRun = true\n419\t\t\tcase arg == \"--project\" && i+1 < len(args):\n420\t\t\t\ti++\n421\t\t\t\topts.Project = args[i]\n422\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n423\t\t\t\topts.Project = arg[len(\"--project=\"):]\n424\t\t\t}\n425\t\t}\n426\t\n427\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n428\t\tresults, err := session.SessionPush(opts)\n429\t\tif err != nil {\n430\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n431\t\t\tos.Exit(1)\n432\t\t}\n433\t\n434\t\t// 汇总各项目的收集结果\n435\t\tfmt.Println()\n436\t\ttotalNew, totalSkipped := 0, 0\n437\t\tfor _, r := range results {\n438\t\t\ttotalNew += r.SessionsNew\n439\t\t\ttotalSkipped += r.SessionsSkipped\n440\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n441\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n442\t\t\t}\n443\t\t}\n444\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n445\t}\n446\t\n447\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n448\t//\n449\t// 支持的参数：\n450\t//   --all       恢复所有项目的会话\n451\t//   --dry-run   仅预览，不实际执行\n452\t//   --project   指定项目名称，覆盖自动检测\n453\tfunc runSessionPull(args []string) {\n454\t\tvar opts session.PullOptions\n455\t\tfor i := 0; i < len(args); i++ {\n456\t\t\targ := args[i]\n457\t\t\tswitch {\n458\t\t\tcase arg == \"--all\":\n459\t\t\t\topts.All = true\n460\t\t\tcase arg == \"--dry-run\":\n461\t\t\t\topts.DryRun = true\n462\t\t\tcase arg == \"--project\" && i+1 < len(args):\n463\t\t\t\ti++\n464\t\t\t\topts.Project = args[i]\n465\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n466\t\t\t\topts.Project = arg[len(\"--project=\"):]\n467\t\t\t}\n468\t\t}\n469\t\n470\t\tfmt.Println(\"📤 Restoring sessions...\")\n471\t\tresults, err := session.SessionPull(opts)\n472\t\tif err != nil {\n473\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n474\t\t\tos.Exit(1)\n475\t\t}\n476\t\n477\t\t// 汇总各项目的恢复结果\n478\t\tfmt.Println()\n479\t\ttotalRestored, totalSkipped := 0, 0\n480\t\tfor _, r := range results {\n481\t\t\ttotalRestored += r.SessionsRestored\n482\t\t\ttotalSkipped += r.SessionsSkipped\n483\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n484\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n485\t\t\t}\n486\t\t}\n487\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n488\t}\n489\t\n490\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n491\t//\n492\t// 支持的参数：\n493\t//   --verbose   显示文件级别的详细信息\n494\tfunc runSessionStatus(args []string) {\n495\t\tvar opts session.StatusOptions\n496\t\tfor i := 0; i < len(args); i++ {\n497\t\t\targ := args[i]\n498\t\t\tswitch {\n499\t\t\tcase arg == \"--verbose\":\n500\t\t\t\topts.Verbose = true\n501\t\t\t}\n502\t\t}\n503\t\n504\t\tif err := session.SessionStatus(opts); err != nil {\n505\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n506\t\t\tos.Exit(1)\n507\t\t}\n508\t}\n509\t\n510\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n511\t// 如果参数中包含空格或制表符，则使用引号包裹。\n512\tfunc formatArgs(args []string) string {\n513\t\tresult := \"\"\n514\t\tfor _, a := range args {\n515\t\t\tif containsSpace(a) {\n516\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n517\t\t\t} else {\n518\t\t\t\tresult += \" \" + a\n519\t\t\t}\n520\t\t}\n521\t\treturn strings.TrimSpace(result)\n522\t}\n523\t\n524\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n525\tfunc containsSpace(s string) bool {\n526\t\tfor _, c := range s {\n527\t\t\tif c == ' ' || c == '\\t' {\n528\t\t\t\treturn true\n529\t\t\t}\n530\t\t}\n531\t\treturn false\n532\t}\n533\t\n534\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n535\tfunc firstNonEmpty(ss ...string) string {\n536\t\tfor _, s := range ss {\n537\t\t\tif s != \"\" {\n538\t\t\t\treturn s\n539\t\t\t}\n540\t\t}\n541\t\treturn \"\"\n542\t}\n543\t\n544\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n545\t//\n546\t// 逻辑：\n547\t//  1. 复制原始参数\n548\t//  2. 移除已有的 --resume <old-id>（如果存在）\n549\t//  3. 追加 --resume <new-session-id>\n550\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n551\t\tfiltered := make([]string, 0, len(originalArgs))\n552\t\tskip := false\n553\t\tfor i, arg := range originalArgs {\n554\t\t\tif skip {\n555\t\t\t\tskip = false\n556\t\t\t\tcontinue\n557\t\t\t}\n558\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n559\t\t\t\tskip = true // 跳过 --resume 及其值\n560\t\t\t\tcontinue\n561\t\t\t}\n562\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n563\t\t\t\tcontinue // 跳过 --resume=id 形式\n564\t\t\t}\n565\t\t\tfiltered = append(filtered, arg)\n566\t\t}\n567\t\tfiltered = append(filtered, \"--resume\", sessionID)\n568\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n569\t}\n570\t\n571\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n572\tfunc shortenPath(path string) string {\n573\t\thome, err := os.UserHomeDir()\n574\t\tif err != nil {\n575\t\t\treturn path\n576\t\t}\n577\t\tif strings.HasPrefix(path, home) {\n578\t\t\treturn \"~\" + path[len(home):]\n579\t\t}\n580\t\treturn path\n581\t}\n582\t\n583\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n584\tfunc removeEnvVar(env []string, name string) []string {\n585\t\tprefix := name + \"=\"\n586\t\tresult := make([]string, 0, len(env))\n587\t\tfor _, e := range env {\n588\t\t\tif !strings.HasPrefix(e, prefix) {\n589\t\t\t\tresult = append(result, e)\n590\t\t\t}\n591\t\t}\n592\t\treturn result\n593\t}\n594\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\sse\\reassembler.go"},"tool_use_id":"call_42f29500d6dc4813914f8b69","tool_response":"1\tpackage sse\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/usage\"\n11\t)\n12\t\n13\t// SSEReassembler 解析原始 SSE（Server-Sent Events）字节流，并将流式片段重组成完整的 API 响应。\n14\t//\n15\t// 支持的协议：\n16\t//   - Anthropic Messages API Streaming\n17\t//   - OpenAI Chat Completions Streaming\n18\t//   - OpenAI Responses API Streaming\n19\t//\n20\t// 使用方式：\n21\t//\n22\t//\tr := sse.NewSSEReassembler()\n23\t//\tr.FeedBytes(chunk)       // 多次调用，分块送入 SSE 数据\n24\t//\tsnapshot := r.Reconstruct() // 获取当前累积的完整响应快照\n25\t//\tevents := r.Events       // 获取所有解析出的原始事件列表\n26\ttype SSEReassembler struct {\n27\t\tEvents   []map[string]any // 解析出的所有原始 SSE 事件列表\n28\t\tbuf      []byte           // 未处理完的 SSE 字节缓冲区\n29\t\tcurEv    *string          // 当前正在解析的事件类型（event: xxx）\n30\t\tcurData  []string         // 当前事件的 data 行累积（支持多行 data）\n31\t\tsnap     map[string]any   // 重建后的完整响应快照\n32\t\tfedOnce  bool             // 是否已接收过首块数据（用于首次日志）\n33\t}\n34\t\n35\t// NewSSEReassembler 创建一个新的 SSE 重组器实例。\n36\tfunc NewSSEReassembler() *SSEReassembler {\n37\t\treturn &SSEReassembler{}\n38\t}\n39\t\n40\t// FeedBytes 追加原始 SSE 字节数据并处理已完整的行。\n41\t//\n42\t// 该方法按 \\n 分割输入数据，逐行解析 SSE 协议中的 event、data 字段，\n43\t// 遇到空行时触发事件生成并调用累积逻辑更新快照。\n44\t// 可以多次调用以处理分块传输的数据。\n45\tfunc (r *SSEReassembler) FeedBytes(chunk []byte) {\n46\t\tif !r.fedOnce {\n47\t\t\tlogger.Debug(\"sse\", \"FeedBytes: first chunk size=%d\", len(chunk))\n48\t\t\tr.fedOnce = true\n49\t\t}\n50\t\tr.buf = append(r.buf, chunk...)\n51\t\tfor {\n52\t\t\tidx := bytes.IndexByte(r.buf, '\\n')\n53\t\t\tif idx < 0 {\n54\t\t\t\tbreak\n55\t\t\t}\n56\t\t\tline := r.buf[:idx]\n57\t\t\tr.buf = r.buf[idx+1:]\n58\t\t\tr.feedLine(string(line))\n59\t\t}\n60\t}\n61\t\n62\t// Reconstruct 返回当前累积的消息快照。\n63\t//\n64\t// 如果尚未收到足够的事件来构建快照（如仅收到部分 SSE 帧），则返回 nil。\n65\tfunc (r *SSEReassembler) Reconstruct() map[string]any {\n66\t\treturn r.snap\n67\t}\n68\t\n69\t// feedLine 处理单条 SSE 文本行，解析 event、data 和空行分隔符。\n70\t//\n71\t// SSE 协议规则：\n72\t//   - 以 \"event:\" 开头的行设置当前事件类型\n73\t//   - 以 \"data:\" 开头的行追加到当前事件的数据 payload\n74\t//   - 空行表示当前事件结束，触发事件生成\n75\t//   - \"[DONE]\" 是 OpenAI 的流结束标记，直接忽略\n76\tfunc (r *SSEReassembler) feedLine(line string) {\n77\t\tline = strings.TrimRight(line, \"\\r\")\n78\t\n79\t\tif strings.HasPrefix(line, \"event:\") {\n80\t\t\tev := strings.TrimSpace(line[len(\"event:\"):])\n81\t\t\tr.curEv = &ev\n82\t\t\tr.curData = nil\n83\t\t} else if strings.HasPrefix(line, \"data:\") {\n84\t\t\tr.curData = append(r.curData, strings.TrimSpace(line[len(\"data:\"):]))\n85\t\t} else if line == \"\" {\n86\t\t\t// 空行触发事件：如果既没有 event 也没有 data 则跳过\n87\t\t\tif r.curEv == nil && len(r.curData) == 0 {\n88\t\t\t\treturn\n89\t\t\t}\n90\t\t\traw := strings.Join(r.curData, \"\\n\")\n91\t\n92\t\t\t// 跳过 OpenAI 的 [DONE] 哨兵标记\n93\t\t\tif raw == \"[DONE]\" && r.curEv == nil {\n94\t\t\t\tr.curEv = nil\n95\t\t\t\tr.curData = nil\n96\t\t\t\treturn\n97\t\t\t}\n98\t\n99\t\t\tvar data any\n100\t\t\tif err := json.Unmarshal([]byte(raw), &data); err != nil {\n101\t\t\t\tdata = raw\n102\t\t\t}\n103\t\n104\t\t\tevType := \"message\"\n105\t\t\tif r.curEv != nil {\n106\t\t\t\tevType = *r.curEv\n107\t\t\t}\n108\t\t\tr.addEvent(evType, data)\n109\t\t\tr.curEv = nil\n110\t\t\tr.curData = nil\n111\t\t}\n112\t}\n113\t\n114\t// addEvent 将解析出的单个 SSE 事件追加到事件列表，并触发累积更新。\n115\tfunc (r *SSEReassembler) addEvent(eventType string, data any) {\n116\t\tr.Events = append(r.Events, map[string]any{\"event\": eventType, \"data\": data})\n117\t\tr.accumulate(eventType, data)\n118\t}\n119\t\n120\t// accumulate 按事件类型将流式片段累积到响应快照中。\n121\t//\n122\t// 支持的事件类型及处理逻辑：\n123\t//   - message_start:      初始化快照为 message 对象\n124\t//   - response.created/completed/done: OpenAI Responses API，初始化或更新快照\n125\t//   - message:            OpenAI Chat Completions 流，调用 accumulateChatCompletionChunk\n126\t//   - content_block_start: 向快照 content 数组添加新的内容块\n127\t//   - content_block_delta: 更新指定索引的内容块（文本、推理、JSON 片段）\n128\t//   - content_block_stop:  将累积的 partial_json 解析为 input 字段\n129\t//   - message_delta:       更新 message 级别的 delta（如 stop_reason）和 usage\n130\tfunc (r *SSEReassembler) accumulate(eventType string, data any) {\n131\t\tm, ok := data.(map[string]any)\n132\t\tif !ok {\n133\t\t\treturn\n134\t\t}\n135\t\n136\t\tswitch eventType {\n137\t\tcase \"message_start\":\n138\t\t\tif msg, ok := m[\"message\"].(map[string]any); ok {\n139\t\t\t\tr.snap = deepCopy(msg)\n140\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_start, model=%v\", msg[\"model\"])\n141\t\t\t}\n142\t\n143\t\tcase \"response.created\", \"response.completed\", \"response.done\":\n144\t\t\tif resp, ok := m[\"response\"].(map[string]any); ok {\n145\t\t\t\tr.snap = deepCopy(resp)\n146\t\t\t} else if eventType == \"response.completed\" || eventType == \"response.done\" {\n147\t\t\t\tr.snap = deepCopy(m)\n148\t\t\t}\n149\t\n150\t\tcase \"message\":\n151\t\t\tif _, hasChoices := m[\"choices\"]; hasChoices {\n152\t\t\t\tr.accumulateChatCompletionChunk(m)\n153\t\t\t\treturn\n154\t\t\t}\n155\t\n156\t\tcase \"content_block_start\":\n157\t\t\tif r.snap == nil {\n158\t\t\t\treturn\n159\t\t\t}\n160\t\t\tblock := deepCopy(m[\"content_block\"].(map[string]any))\n161\t\t\tidx := int(float64Val(m[\"index\"]))\n162\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_start idx=%d type=%v\", idx, block[\"type\"])\n163\t\t\tif _, ok := r.snap[\"content\"]; !ok {\n164\t\t\t\tr.snap[\"content\"] = []any{}\n165\t\t\t}\n166\t\t\tcontent := r.snap[\"content\"].([]any)\n167\t\t\tfor len(content) <= idx {\n168\t\t\t\tcontent = append(content, map[string]any{})\n169\t\t\t}\n170\t\t\tcontent[idx] = block\n171\t\t\tr.snap[\"content\"] = content\n172\t\n173\t\tcase \"content_block_delta\":\n174\t\t\tif r.snap == nil {\n175\t\t\t\treturn\n176\t\t\t}\n177\t\t\tidx := int(float64Val(m[\"index\"]))\n178\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n179\t\t\tif delta == nil {\n180\t\t\t\treturn\n181\t\t\t}\n182\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n183\t\t\tif idx >= len(content) {\n184\t\t\t\treturn\n185\t\t\t}\n186\t\t\tblock, _ := content[idx].(map[string]any)\n187\t\t\tif block == nil {\n188\t\t\t\treturn\n189\t\t\t}\n190\t\t\tswitch delta[\"type\"] {\n191\t\t\tcase \"text_delta\":\n192\t\t\t\tblock[\"text\"] = strVal(block[\"text\"]) + strVal(delta[\"text\"])\n193\t\t\tcase \"thinking_delta\":\n194\t\t\t\tblock[\"thinking\"] = strVal(block[\"thinking\"]) + strVal(delta[\"thinking\"])\n195\t\t\tcase \"input_json_delta\":\n196\t\t\t\tblock[\"_partial_json\"] = strVal(block[\"_partial_json\"]) + strVal(delta[\"partial_json\"])\n197\t\t\t}\n198\t\n199\t\tcase \"content_block_stop\":\n200\t\t\tif r.snap == nil {\n201\t\t\t\treturn\n202\t\t\t}\n203\t\t\tidx := int(float64Val(m[\"index\"]))\n204\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n205\t\t\tif idx >= len(content) {\n206\t\t\t\treturn\n207\t\t\t}\n208\t\t\tblock, _ := content[idx].(map[string]any)\n209\t\t\tif block == nil {\n210\t\t\t\treturn\n211\t\t\t}\n212\t\t\t// 将累积的 JSON 字符串片段解析为结构化的 input 字段\n213\t\t\tif pj, ok := block[\"_partial_json\"]; ok {\n214\t\t\t\tvar parsed any\n215\t\t\t\tif json.Unmarshal([]byte(strVal(pj)), &parsed) == nil {\n216\t\t\t\t\tblock[\"input\"] = parsed\n217\t\t\t\t}\n218\t\t\t\tdelete(block, \"_partial_json\")\n219\t\t\t}\n220\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_stop idx=%d\", idx)\n221\t\n222\t\tcase \"message_delta\":\n223\t\t\tif r.snap == nil {\n224\t\t\t\treturn\n225\t\t\t}\n226\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n227\t\t\tif delta != nil {\n228\t\t\t\tfor k, v := range delta {\n229\t\t\t\t\tr.snap[k] = v\n230\t\t\t\t}\n231\t\t\t}\n232\t\t\tif u, ok := m[\"usage\"].(map[string]any); ok {\n233\t\t\t\tif _, exists := r.snap[\"usage\"]; !exists {\n234\t\t\t\t\tr.snap[\"usage\"] = map[string]any{}\n235\t\t\t\t}\n236\t\t\t\texisting := r.snap[\"usage\"].(map[string]any)\n237\t\t\t\tfor k, v := range u {\n238\t\t\t\t\texisting[k] = v\n239\t\t\t\t}\n240\t\t\t}\n241\t\t\tif delta != nil {\n242\t\t\t\tif sr, ok := delta[\"stop_reason\"]; ok && sr != nil {\n243\t\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_delta stop_reason=%v\", sr)\n244\t\t\t\t}\n245\t\t\t}\n246\t\t}\n247\t}\n248\t\n249\t// --- OpenAI Chat Completions 流式累积 ---\n250\t\n251\t// accumulateChatCompletionChunk 处理 OpenAI Chat Completions Streaming 的单个 chunk。\n252\t//\n253\t// 该函数将 choices[0].delta 中的内容逐块累积，同时处理：\n254\t//   - role、content、reasoning_content 的拼接\n255\t//   - tool_calls 的渐进式构建（id、name、arguments 分块到达）\n256\t//   - usage 信息的合并\n257\t//   - finish_reason 的更新\n258\t//\n259\t// 快照结构兼容 Anthropic 格式，content 数组中会同时维护文本块和工具调用块。\n260\tfunc (r *SSEReassembler) accumulateChatCompletionChunk(data map[string]any) {\n261\t\tchoices, _ := data[\"choices\"].([]any)\n262\t\trawUsage, _ := data[\"usage\"]\n263\t\n264\t\tif len(choices) == 0 {\n265\t\t\tif u, ok := rawUsage.(map[string]any); ok && r.snap != nil {\n266\t\t\t\tr.mergeChatUsage(u)\n267\t\t\t}\n268\t\t\treturn\n269\t\t}\n270\t\n271\t\tchoice, _ := choices[0].(map[string]any)\n272\t\tif choice == nil {\n273\t\t\treturn\n274\t\t}\n275\t\tdelta, _ := choice[\"delta\"].(map[string]any)\n276\t\tfinishReason := choice[\"finish_reason\"]\n277\t\tchoiceUsage, _ := choice[\"usage\"].(map[string]any)\n278\t\n279\t\t// 首个 chunk 时初始化快照\n280\t\tif r.snap == nil {\n281\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk init, model=%s\", strVal(data[\"model\"]))\n282\t\t\tr.snap = map[string]any{\n283\t\t\t\t\"id\":     strVal(data[\"id\"]),\n284\t\t\t\t\"object\": \"chat.completion\",\n285\t\t\t\t\"model\":  strVal(data[\"model\"]),\n286\t\t\t\t\"choices\": []any{\n287\t\t\t\t\tmap[string]any{\n288\t\t\t\t\t\t\"index\":         0,\n289\t\t\t\t\t\t\"message\":       map[string]any{\"role\": strVal(fieldStr(delta, \"role\")), \"content\": \"\"},\n290\t\t\t\t\t\t\"finish_reason\": nil,\n291\t\t\t\t\t},\n292\t\t\t\t},\n293\t\t\t\t\"content\": []any{map[string]any{\"type\": \"text\", \"text\": \"\"}},\n294\t\t\t}\n295\t\t\tif role := strVal(fieldStr(delta, \"role\")); role == \"\" {\n296\t\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)[\"role\"] = \"assistant\"\n297\t\t\t}\n298\t\t}\n299\t\n300\t\tmsg := r.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n301\t\ttextBlock := r.chatTextBlock()\n302\t\n303\t\tif role := strVal(fieldStr(delta, \"role\")); role != \"\" {\n304\t\t\tmsg[\"role\"] = role\n305\t\t}\n306\t\tif rc := strVal(fieldStr(delta, \"reasoning_content\")); rc != \"\" {\n307\t\t\tmsg[\"reasoning_content\"] = strVal(msg[\"reasoning_content\"]) + rc\n308\t\t\tr.mirrorReasoning(strVal(msg[\"reasoning_content\"]))\n309\t\t}\n310\t\tif c := strVal(fieldStr(delta, \"content\")); c != \"\" {\n311\t\t\tmsg[\"content\"] = strVal(msg[\"content\"]) + c\n312\t\t\ttextBlock[\"text\"] = strVal(textBlock[\"text\"]) + c\n313\t\t}\n314\t\n315\t\t// 工具调用增量处理\n316\t\tfor _, tcRaw := range sliceField(delta, \"tool_calls\") {\n317\t\t\ttcDelta, _ := tcRaw.(map[string]any)\n318\t\t\tif tcDelta == nil {\n319\t\t\t\tcontinue\n320\t\t\t}\n321\t\t\tidx := int(float64Val(tcDelta[\"index\"]))\n322\t\t\ttoolCalls, _ := msg[\"tool_calls\"].([]any)\n323\t\t\tif toolCalls == nil {\n324\t\t\t\ttoolCalls = []any{}\n325\t\t\t}\n326\t\t\tfor len(toolCalls) <= idx {\n327\t\t\t\ttoolCalls = append(toolCalls, map[string]any{\n328\t\t\t\t\t\"id\":   \"\",\n329\t\t\t\t\t\"type\": \"function\",\n330\t\t\t\t\t\"function\": map[string]any{\n331\t\t\t\t\t\t\"name\":      \"\",\n332\t\t\t\t\t\t\"arguments\": \"\",\n333\t\t\t\t\t},\n334\t\t\t\t})\n335\t\t\t}\n336\t\t\texisting := toolCalls[idx].(map[string]any)\n337\t\t\tif id := strVal(tcDelta[\"id\"]); id != \"\" {\n338\t\t\t\texisting[\"id\"] = id\n339\t\t\t}\n340\t\t\tif t := strVal(tcDelta[\"type\"]); t != \"\" {\n341\t\t\t\texisting[\"type\"] = t\n342\t\t\t}\n343\t\t\tif fnDelta, ok := tcDelta[\"function\"].(map[string]any); ok {\n344\t\t\t\tfn, _ := existing[\"function\"].(map[string]any)\n345\t\t\t\tif fn == nil {\n346\t\t\t\t\tfn = map[string]any{\"name\": \"\", \"arguments\": \"\"}\n347\t\t\t\t}\n348\t\t\t\tif n := strVal(fnDelta[\"name\"]); n != \"\" {\n349\t\t\t\t\tfn[\"name\"] = strVal(fn[\"name\"]) + n\n350\t\t\t\t}\n351\t\t\t\tif a := strVal(fnDelta[\"arguments\"]); a != \"\" {\n352\t\t\t\t\tfn[\"arguments\"] = strVal(fn[\"arguments\"]) + a\n353\t\t\t\t}\n354\t\t\t\texisting[\"function\"] = fn\n355\t\t\t}\n356\t\t\ttoolCalls[idx] = existing\n357\t\t\tmsg[\"tool_calls\"] = toolCalls\n358\t\t\tr.mirrorToolCall(idx, existing)\n359\t\t}\n360\t\n361\t\tif finishReason != nil && finishReason != \"\" {\n362\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"finish_reason\"] = finishReason\n363\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk finish_reason=%v\", finishReason)\n364\t\t}\n365\t\n366\t\tif u, ok := rawUsage.(map[string]any); ok {\n367\t\t\tr.mergeChatUsage(u)\n368\t\t}\n369\t\tif choiceUsage != nil {\n370\t\t\tr.mergeChatUsage(choiceUsage)\n371\t\t}\n372\t}\n373\t\n374\t// chatTextBlock 获取或创建快照中的文本内容块。\n375\t// 返回 content 数组中第一个 type=\"text\" 的块；如果不存在则新建一个。\n376\tfunc (r *SSEReassembler) chatTextBlock() map[string]any {\n377\t\tcontent := r.snap[\"content\"].([]any)\n378\t\tfor _, b := range content {\n379\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"text\" {\n380\t\t\t\treturn block\n381\t\t\t}\n382\t\t}\n383\t\tblock := map[string]any{\"type\": \"text\", \"text\": \"\"}\n384\t\tr.snap[\"content\"] = append(content, block)\n385\t\treturn block\n386\t}\n387\t\n388\t// mirrorReasoning 将 reasoning_content 同步到 content 数组中的 thinking 块。\n389\t// 如果 content 中不存在 thinking 块，则在开头插入一个。\n390\tfunc (r *SSEReassembler) mirrorReasoning(reasoning string) {\n391\t\tcontent := r.snap[\"content\"].([]any)\n392\t\tfor _, b := range content {\n393\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n394\t\t\t\tblock[\"thinking\"] = reasoning\n395\t\t\t\treturn\n396\t\t\t}\n397\t\t}\n398\t\tblock := map[string]any{\"type\": \"thinking\", \"thinking\": reasoning}\n399\t\tr.snap[\"content\"] = append([]any{block}, content...)\n400\t}\n401\t\n402\t// mirrorToolCall 将 Chat Completions 的 tool_call 同步到 Anthropic 格式的 content 数组中。\n403\t//\n404\t// 同步规则：\n405\t//   - 在 content 数组中查找或创建对应的 tool_use 块\n406\t//   - 将 function name 映射为 tool_use 的 name\n407\t//   - 将 arguments JSON 解析后映射为 tool_use 的 input\n408\t//   - thinking 块的存在会影响工具调用块在 content 中的索引偏移\n409\tfunc (r *SSEReassembler) mirrorToolCall(idx int, tc map[string]any) {\n410\t\tcontent := r.snap[\"content\"].([]any)\n411\t\t// 如果存在 thinking 块，工具调用的位置需要偏移 1\n412\t\toffset := 1\n413\t\tfor _, b := range content {\n414\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n415\t\t\t\toffset = 2\n416\t\t\t\tbreak\n417\t\t\t}\n418\t\t}\n419\t\ttarget := idx + offset\n420\t\tfor len(content) <= target {\n421\t\t\tcontent = append(content, map[string]any{\"type\": \"tool_use\", \"id\": \"\", \"name\": \"\", \"input\": map[string]any{}})\n422\t\t}\n423\t\tblock := content[target].(map[string]any)\n424\t\tif id := strVal(tc[\"id\"]); id != \"\" {\n425\t\t\tblock[\"id\"] = id\n426\t\t}\n427\t\tif fn, ok := tc[\"function\"].(map[string]any); ok {\n428\t\t\tif n := strVal(fn[\"name\"]); n != \"\" {\n429\t\t\t\tblock[\"name\"] = n\n430\t\t\t}\n431\t\t\tif args := strVal(fn[\"arguments\"]); args != \"\" {\n432\t\t\t\tvar parsed any\n433\t\t\t\tif json.Unmarshal([]byte(args), &parsed) == nil {\n434\t\t\t\t\tblock[\"input\"] = parsed\n435\t\t\t\t}\n436\t\t\t}\n437\t\t}\n438\t\tr.snap[\"content\"] = content\n439\t}\n440\t\n441\t// mergeChatUsage 将 OpenAI Chat Completions 的 usage 数据标准化后合并到快照。\n442\tfunc (r *SSEReassembler) mergeChatUsage(u map[string]any) {\n443\t\tr.snap[\"usage\"] = usage.NormalizeUsage(u)\n444\t}\n445\t\n446\t// --- 辅助函数 ---\n447\t\n448\t// deepCopy 通过 JSON 序列化/反序列化实现 map 的深拷贝。\n449\tfunc deepCopy(m map[string]any) map[string]any {\n450\t\tif m == nil {\n451\t\t\treturn nil\n452\t\t}\n453\t\tdata, _ := json.Marshal(m)\n454\t\tresult := make(map[string]any)\n455\t\t_ = json.Unmarshal(data, &result)\n456\t\treturn result\n457\t}\n458\t\n459\t// float64Val 将任意数值类型转换为 float64。\n460\t// 支持 float64、int、int64；不支持的类型返回 0。\n461\tfunc float64Val(v any) float64 {\n462\t\tswitch n := v.(type) {\n463\t\tcase float64:\n464\t\t\treturn n\n465\t\tcase int:\n466\t\t\treturn float64(n)\n467\t\tcase int64:\n468\t\t\treturn float64(n)\n469\t\t}\n470\t\treturn 0\n471\t}\n472\t\n473\t// strVal 将任意值转换为字符串。\n474\t// nil 返回空字符串，string 类型直接返回，其他类型使用 fmt.Sprintf 格式化。\n475\tfunc strVal(v any) string {\n476\t\tif v == nil {\n477\t\t\treturn \"\"\n478\t\t}\n479\t\tif s, ok := v.(string); ok {\n480\t\t\treturn s\n481\t\t}\n482\t\treturn fmt.Sprintf(\"%v\", v)\n483\t}\n484\t\n485\t// fieldStr 从 map 中安全获取字段值。\n486\tfunc fieldStr(m map[string]any, key string) any {\n487\t\tv, _ := m[key]\n488\t\treturn v\n489\t}\n490\t\n491\t// sliceField 从 map 中获取 []any 类型的字段，如果不存在或类型不匹配则返回 nil。\n492\tfunc sliceField(m map[string]any, key string) []any {\n493\t\tv, _ := m[key].([]any)\n494\t\tif v == nil {\n495\t\t\treturn nil\n496\t\t}\n497\t\treturn v\n498\t}\n499\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\proxy.go"},"tool_use_id":"call_9b41b9ccb9674d508ae31bad","tool_response":"File does not exist. Note: your current working directory is D:\\CodeDevelopment\\CodeProject\\claude-hk."}]}
