e(map[string]string),\n39\t\t\tsessions:      make(map[string]string),\n40\t\t\tproxySessions: make(map[string][]string),\n41\t\t\tsvc:           svc,\n42\t\t}\n43\t}\n44\t\n45\t// bindSession 将会话绑定到代理 URL（内部调用需持有写锁）。\n46\tfunc (h *ProxyHandler) bindSession(pid, sessionID, proxyURL string) {\n47\t\tif oldURL, ok := h.sessions[sessionID]; ok && oldURL != proxyURL {\n48\t\t\tlogger.Debug(\"api.proxy\", \"rebind session %s: %s -> %s\", sessionID, oldURL, proxyURL)\n49\t\t}\n50\t\th.sessions[sessionID] = proxyURL\n51\t\t// 记录到 proxy 索引，用于注销时清理\n52\t\tfound := false\n53\t\tfor _, sid := range h.proxySessions[pid] {\n54\t\t\tif sid == sessionID {\n55\t\t\t\tfound = true\n56\t\t\t\tbreak\n57\t\t\t}\n58\t\t}\n59\t\tif !found {\n60\t\t\th.proxySessions[pid] = append(h.proxySessions[pid], sessionID)\n61\t\t}\n62\t}\n63\t\n64\t// unbindProxySessions 清理指定 pid 下的所有 session 绑定（内部调用需持有写锁）。\n65\tfunc (h *ProxyHandler) unbindProxySessions(pid string) {\n66\t\tfor _, sessionID := range h.proxySessions[pid] {\n67\t\t\tif h.sessions[sessionID] == h.proxies[pid] {\n68\t\t\t\tdelete(h.sessions, sessionID)\n69\t\t\t\tlogger.Debug(\"api.proxy\", \"unbind session %s on proxy %s unregister\", sessionID, pid)\n70\t\t\t}\n71\t\t}\n72\t\tdelete(h.proxySessions, pid)\n73\t}\n74\t\n75\t// Register 处理代理注册请求。\n76\t// POST /api/proxy/register\n77\t// Body: {\"pid\": \"28364\", \"proxy_url\": \"http://127.0.0.1:64902\"}\n78\tfunc (h *ProxyHandler) Register(w http.ResponseWriter, r *http.Request) {\n79\t\tif r.Method != http.MethodPost {\n80\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n81\t\t\treturn\n82\t\t}\n83\t\n84\t\tvar req struct {\n85\t\t\tPID      string `json:\"pid\"`\n86\t\t\tProxyURL string `json:\"proxy_url\"`\n87\t\t}\n88\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n89\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n90\t\t\treturn\n91\t\t}\n92\t\n93\t\tif req.PID == \"\" || req.ProxyURL == \"\" {\n94\t\t\thttp.Error(w, \"pid and proxy_url required\", http.StatusBadRequest)\n95\t\t\treturn\n96\t\t}\n97\t\n98\t\th.mu.Lock()\n99\t\th.proxies[req.PID] = req.ProxyURL\n100\t\th.mu.Unlock()\n101\t\n102\t\tlogger.Info(\"api.proxy\", \"registered: pid=%s url=%s\", req.PID, req.ProxyURL)\n103\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n104\t}\n105\t\n106\t// Unregister 处理代理注销请求。\n107\t// POST /api/proxy/unregister\n108\t// Body: {\"pid\": \"28364\"}\n109\tfunc (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request) {\n110\t\tif r.Method != http.MethodPost {\n111\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n112\t\t\treturn\n113\t\t}\n114\t\n115\t\tvar req struct {\n116\t\t\tPID string `json:\"pid\"`\n117\t\t}\n118\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n119\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n120\t\t\treturn\n121\t\t}\n122\t\n123\t\th.mu.Lock()\n124\t\th.unbindProxySessions(req.PID)\n125\t\tdelete(h.proxies, req.PID)\n126\t\th.mu.Unlock()\n127\t\n128\t\tlogger.Info(\"api.proxy\", \"unregistered: pid=%s\", req.PID)\n129\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n130\t}\n131\t\n132\t// TraceInit 转发 trace-init 请求到指定代理。\n133\t// POST /api/proxy/trace-init\n134\t// 路由逻辑：通过 proxy_pid（环境变量注入）精确路由到目标代理。\n135\t// PID 来自 CLAUDE_TAP_PROXY_PID 环境变量，由 proxy 启动时注入子进程，/clear 后仍然有效。\n136\tfunc (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request) {\n137\t\tif r.Method != http.MethodPost {\n138\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n139\t\t\treturn\n140\t\t}\n141\t\n142\t\t// 读取请求体\n143\t\tbody, err := io.ReadAll(r.Body)\n144\t\tif err != nil {\n145\t\t\thttp.Error(w, \"read body failed\", http.StatusBadRequest)\n146\t\t\treturn\n147\t\t}\n148\t\n149\t\t// 解析请求\n150\t\tvar tiReq TraceInitRequest\n151\t\tif err := json.Unmarshal(body, &tiReq); err != nil {\n152\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n153\t\t\treturn\n154\t\t}\n155\t\ti