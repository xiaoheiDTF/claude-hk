ningContent string) {\n42\t\tif reasoningContent == \"\" {\n43\t\t\treturn\n44\t\t}\n45\t\tc.mu.Lock()\n46\t\tdefer c.mu.Unlock()\n47\t\n48\t\tc.full[fullKey] = reasoningContent\n49\t\tif tcKey != \"\" {\n50\t\t\tc.toolcall[tcKey] = reasoningContent\n51\t\t}\n52\t\tc.lastValue = reasoningContent\n53\t}\n54\t\n55\t// Lookup 三级查找 reasoning_content。\n56\t//\n57\t// 返回 (reasoning_content, found)：\n58\t//   - found=true 表示命中缓存\n59\t//   - found=false 表示未命中，调用方应使用空字符串兜底\n60\tfunc (c *ReasoningCache) Lookup(fullKey, tcKey string, hasToolCalls bool) (string, bool) {\n61\t\tc.mu.RLock()\n62\t\tdefer c.mu.RUnlock()\n63\t\n64\t\t// Level 1: full key 精确匹配\n65\t\tif v, ok := c.full[fullKey]; ok {\n66\t\t\treturn v, true\n67\t\t}\n68\t\n69\t\t// Level 2: toolcall key 匹配\n70\t\tif tcKey != \"\" {\n71\t\t\tif v, ok := c.toolcall[tcKey]; ok {\n72\t\t\t\treturn v, true\n73\t\t\t}\n74\t\t}\n75\t\n76\t\t// Level 3: 兜底 - 最近缓存值（仅对带 tool_calls 的消息）\n77\t\tif hasToolCalls && c.lastValue != \"\" {\n78\t\t\treturn c.lastValue, true\n79\t\t}\n80\t\n81\t\treturn \"\", false\n82\t}\n83\t\n84\t// Len 返回缓存条目数 (fullCount, toolcallCount)。\n85\tfunc (c *ReasoningCache) Len() (int, int) {\n86\t\tc.mu.RLock()\n87\t\tdefer c.mu.RUnlock()\n88\t\treturn len(c.full), len(c.toolcall)\n89\t}\n90\t\n91\t// ---- 密钥计算 ----\n92\t\n93\t// makeCacheKey 计算缓存密钥：MD5(format)。\n94\tfunc makeCacheKey(format string) string {\n95\t\th := md5.Sum([]byte(format))\n96\t\treturn fmt.Sprintf(\"%x\", h)\n97\t}\n98\t\n99\t// MakeFullKey 基于 content 文本和 tool_calls JSON 计算完整密钥。\n100\t// 格式与 Python 参考实现一致：MD5(\"content=<content>\\ntool_calls=<toolCallsJSON>\")\n101\tfunc MakeFullKey(content string, toolCallsJSON string) string {\n102\t\treturn makeCacheKey(fmt.Sprintf(\"content=%s\\ntool_calls=%s\", content, toolCallsJSON))\n103\t}\n104\t\n105\t// MakeToolcallKey 仅基于 tool_calls JSON 计算密钥。\n106\t// 如果 toolCallsJSON 为空，返回空字符串（表示无需缓存到 toolcall map）。\n107\tfunc MakeToolcallKey(toolCallsJSON string) string {\n108\t\tif toolCallsJSON == \"\" {\n109\t\t\treturn \"\"\n110\t\t}\n111\t\treturn makeCacheKey(fmt.Sprintf(\"tool_calls=%s\", toolCallsJSON))\n112\t}\n113\t\n114\t// MakeFullKeyFromMsg 从 Anthropic 格式的 assistant 消息中提取密钥。\n115\t//\n116\t// 遍历 content 数组，将非 thinking 块序列化为 content，\n117\t// 将 tool_use 块序列化为 tool_calls，最终调用 MakeFullKey。\n118\tfunc MakeFullKeyFromMsg(msg map[string]any) string {\n119\t\tcontent, toolCalls := extractMsgParts(msg)\n120\t\ttoolCallsJSON, _ := json.Marshal(toolCalls)\n121\t\treturn MakeFullKey(content, string(toolCallsJSON))\n122\t}\n123\t\n124\t// MakeToolcallKeyFromMsg 从 Anthropic 格式的 assistant 消息中提取 toolcall 密钥。\n125\tfunc MakeToolcallKeyFromMsg(msg map[string]any) string {\n126\t\t_, toolCalls := extractMsgParts(msg)\n127\t\tif len(toolCalls) == 0 {\n128\t\t\treturn \"\"\n129\t\t}\n130\t\ttoolCallsJSON, _ := json.Marshal(toolCalls)\n131\t\treturn MakeToolcallKey(string(toolCallsJSON))\n132\t}\n133\t\n134\t// extractMsgParts 从 Anthropic 格式消息中提取文本内容和 tool_use 块。\n135\t//\n136\t// 返回 (contentText, toolUseBlocks)：\n137\t//   - contentText: 所有 text 块拼接的文本内容\n138\t//   - toolUseBlocks: 所有 tool_use 块的数组（保持原始顺序）\n139\tfunc extractMsgParts(msg map[string]any) (string, []any) {\n140\t\tcontentArr, ok := msg[\"content\"].([]any)\n141\t\tif !ok {\n142\t\t\t// content 可能是字符串\n143\t\t\tif s, ok := msg[\"content\"].(string); ok {\n144\t\t\t\treturn s, nil\n145\t\t\t}\n146\t\t\treturn \"\", nil\n147\t\t}\n148\t\n149\t\tvar textParts []string\n150\t\tvar toolUseBlocks []any\n151\t\n152\t\tfor _, blockRaw := range contentArr {\n153\t\t\tblock, ok := blockRaw.(map[string]any)\n154\t\t\tif !ok {\n155\t\t\t\tcontinue\n156\t\t\t}\n157\t\t\tblockType, _ := block[\"type\"].(string)\n158\t\t\tswitch blockType {\n159\t\t\tcase \"text\":\n160\t\t\t\tif text, ok := block[\"text\"].(string); ok {\n161\t\t\t\t\ttextParts = append(textParts, text)\n162\t\t\t\t}\n163\t\t\tcase \"tool_use\":\n164\t\t\t\ttoolUseBlocks = append(toolUseBlocks, block)\n165\t\t\t}\n166\t\t}\n167\t\n168\t\treturn strings.Join(textParts, \"\"), toolUseBlocks\n169\t}\n170\t"}]}
