t\t\trunSessionPull(os.Args[2:])\n\t\t\treturn\n\t\tcase \"session-status\":","numLines":50,"startLine":1,"totalLines":594}},"tool_use_id":"call_b8a3c46186ea4119a170d8ab","duration_ms":0}
