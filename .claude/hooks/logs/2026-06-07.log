\t\tdefer config.SetHomeDir(origHomeDir)\n145\t\n146\t\t// 4. 创建 mock 上游（profile target）\n147\t\tvar capturedBody []byte\n148\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n149\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n150\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n151\t\t\tw.WriteHeader(http.StatusOK)\n152\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n153\t\t}))\n154\t\tdefer mockUpstream.Close()\n155\t\n156\t\t// 5. 更新 profile 的 base_url 为 mock 地址\n157\t\tprofiles[\"profiles\"] = map[string]any{\n158\t\t\t\"test-profile\": map[string]any{\n159\t\t\t\t\"base_url\": mockUpstream.URL,"}]}
