[2026-06-07 20:59:35] [INFO] [PostToolBatch] Input: {"session_id":"5a952b88-dbcf-40a5-820e-fed7478f0486","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\5a952b88-dbcf-40a5-820e-fed7478f0486.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus","permission_mode":"plan","agent_id":"ab37dc875a0392d72","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\reverse.go"},"tool_use_id":"call_79d81aa97d1b4095adb5d092","tool_response":"1\t// Package proxy 提供 HTTP 代理功能，包括请求转发、SSE 流式处理与 Trace 记录。\n2\tpackage proxy\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"compress/gzip\"\n7\t\t\"compress/zlib\"\n8\t\t\"encoding/json\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"net/http\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\t\"sync/atomic\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n19\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n20\t)\n21\t\n22\t// ReverseProxy 拦截 HTTP 请求并转发到上游 API，同时记录请求/响应到 JSONL Trace，并处理 SSE 流式响应。\n23\ttype ReverseProxy struct {\n24\t\ttarget             string              // 上游 API 目标地址\n25\t\tbaseDir            string              // Trace 文件存放的基础目录\n26\t\twriter             *trace.TraceWriter  // 当前会话的 Trace 写入器（由 _internal/trace-init 创建）\n27\t\tclient             *http.Client        // 转发请求的 HTTP 客户端\n28\t\tturn               atomic.Int64        // 请求计数器，用于标记 Turn 编号\n29\t\tserver             *http.Server        // 本地代理 HTTP 服务器\n30\t\tstartOnce          sync.Once           // 确保 Start 只执行一次\n31\t\tsessionID          string              // 当前会话 ID（由 trace-init 设置）\n32\t\tprojectSlug        string              // 当前项目标识（由 trace-init 设置）\n33\t\tOnSessionInit      func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\n34\t\tOnTraceInitDone    func()              // trace-init 处理完成回调（通知 main.go 释放 init 锁）\n35\t\tmodel              string              // 强制替换的模型名（空=不改写）\n36\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n37\t\tfallbackConfig     *FallbackConfig      // 兜底配置（上游不可用时切换）\n38\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfig 的并发安全\n39\t\tactualAddr         string              // 实际监听地址（启动后设置）\n40\t\treasoningCache     *ReasoningCache     // reasoning_content 缓存（仅 kimi 模式）\n41\t\tkimiMode           bool                // 是否为 kimi 上游\n42\t}\n43\t\n44\t// FallbackConfig 存储上游不可用时的兜底配置。\n45\ttype FallbackConfig struct {\n46\t\tBaseURL   string // 兜底上游 API 地址\n47\t\tModel     string // 兜底模型名\n48\t\tAuthToken string // 兜底认证 Token\n49\t\tAPIKey    string // 兜底 API Key\n50\t}\n51\t\n52\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n53\t// traceDir 为 Trace 文件存放的基础目录。\n54\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n55\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n56\t\treturn &ReverseProxy{\n57\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n58\t\t\tbaseDir:           traceDir,\n59\t\t\tupstreamAvailable: true,\n60\t\t\tclient: &http.Client{\n61\t\t\t\tTimeout: 0, // 流式场景不设超时\n62\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n63\t\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n64\t\t\t\t},\n65\t\t\t},\n66\t\t}\n67\t}\n68\t\n69\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n70\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n71\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n72\t\tmux := http.NewServeMux()\n73\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n74\t\tp.server = &http.Server{\n75\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n76\t\t\tHandler: mux,\n77\t\t}\n78\t\n79\t\tlistener, err := ioListener(p.server.Addr)\n80\t\tif err != nil {\n81\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n82\t\t}\n83\t\n84\t\t// 在后台 goroutine 中启动服务\n85\t\tgo func() {\n86\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n87\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n88\t\t\t}\n89\t\t}()\n90\t\n91\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n92\t\tp.actualAddr = fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n93\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n94\t\treturn actualPort, nil\n95\t}\n96\t\n97\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n98\tfunc (p *ReverseProxy) Stop() {\n99\t\tlogger.Info(\"proxy\", \"stopping\")\n100\t\tif p.writer != nil {\n101\t\t\tp.writer.Close()\n102\t\t}\n103\t\tif p.server != nil {\n104\t\t\t_ = p.server.Close()\n105\t\t}\n106\t}\n107\t\n108\t// URL 返回代理服务器的 HTTP 地址（如 http://127.0.0.1:8080）。\n109\tfunc (p *ReverseProxy) URL() string {\n110\t\treturn p.actualAddr\n111\t}\n112\t\n113\t// serveHTTP 是代理的核心 HTTP 处理函数。\n114\t// 处理流程：内部端点 → 路径白名单检查 → 读取请求体 → 构建上游请求 → 转发 → 流式/非流式处理。\n115\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n116\t\t// 处理内部端点（绕过路径白名单）\n117\t\tif strings.HasPrefix(r.URL.Path, \"/_internal/\") {\n118\t\t\tp.handleInternal(w, r)\n119\t\t\treturn\n120\t\t}\n121\t\n122\t\t// 拒绝未知路径\n123\t\tif !IsAllowedPath(r.URL.Path) {\n124\t\t\thttp.NotFound(w, r)\n125\t\t\treturn\n126\t\t}\n127\t\n128\t\t// 读取请求体\n129\t\tbodyBytes, err := io.ReadAll(r.Body)\n130\t\tif err != nil {\n131\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n132\t\t\treturn\n133\t\t}\n134\t\t_ = r.Body.Close()\n135\t\n136\t\t// 解析请求体为 JSON（用于后续提取 model、stream 等字段）\n137\t\tvar reqBody any\n138\t\tif len(bodyBytes) > 0 {\n139\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n140\t\t}\n141\t\n142\t\t// 请求体 model 改写（契约 3）\n143\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, p.model)\n144\t\n145\t\t// 重新解析改写后的请求体\n146\t\treqBody = nil\n147\t\tif len(bodyBytes) > 0 {\n148\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n149\t\t}\n150\t\n151\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n152\t\tbodyBytes = injectReasoningContentCached(bodyBytes, reqBody, p.reasoningCache, p.kimiMode)\n153\t\treqBody = nil\n154\t\tif len(bodyBytes) > 0 {\n155\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n156\t\t}\n157\t\n158\t\t// 生成请求 ID 与 Turn 编号\n159\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n160\t\tturn := int(p.turn.Add(1))\n161\t\tt0 := time.Now()\n162\t\n163\t\tlogger.Debug(\"proxy\", \"[Turn %d] request: %s %s (%d bytes)\", turn, r.Method, r.URL.Path, len(bodyBytes))\n164\t\n165\t\t// 确定上游目标：检查是否需要走兜底配置（契约 4）\n166\t\tp.availableMu.Lock()\n167\t\tuseFallback := !p.upstreamAvailable && p.fallbackConfig != nil\n168\t\tactiveTarget := p.target\n169\t\tvar fallbackModel string\n170\t\tif useFallback {\n171\t\t\tactiveTarget = p.fallbackConfig.BaseURL\n172\t\t\tfallbackModel = p.fallbackConfig.Model\n173\t\t}\n174\t\tp.availableMu.Unlock()\n175\t\n176\t\t// 兜底模式下重新改写 model\n177\t\tif useFallback && fallbackModel != \"\" {\n178\t\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, fallbackModel)\n179\t\t\treqBody = nil\n180\t\t\tif len(bodyBytes) > 0 {\n181\t\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n182\t\t\t}\n183\t\n184\t\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n185\t\t\tbodyBytes = injectReasoningContentCached(bodyBytes, reqBody, p.reasoningCache, IsKimiURL(activeTarget))\n186\t\t\treqBody = nil\n187\t\t\tif len(bodyBytes) > 0 {\n188\t\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n189\t\t\t}\n190\t\t}\n191\t\n192\t\t// 构建上游请求 URL\n193\t\tupstreamURL := activeTarget + r.URL.Path\n194\t\tif r.URL.RawQuery != \"\" {\n195\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n196\t\t}\n197\t\n198\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n199\t\tif err != nil {\n200\t\t\thttp.Error(w, \"create upstream request: \"+err.Error(), http.StatusBadGateway)\n201\t\t\treturn\n202\t\t}\n203\t\n204\t\t// 复制请求头，过滤逐跳头\n205\t\tfor k, vals := range r.Header {\n206\t\t\tlower := strings.ToLower(k)\n207\t\t\tif hopByHopHeaders[lower] {\n208\t\t\t\tcontinue\n209\t\t\t}\n210\t\t\tfor _, v := range vals {\n211\t\t\t\tupstreamReq.Header.Add(k, v)\n212\t\t\t}\n213\t\t}\n214\t\tupstreamReq.Header.Del(\"Host\")\n215\t\n216\t\t// 兜底模式下替换认证头\n217\t\tif useFallback && p.fallbackConfig != nil {\n218\t\t\tif p.fallbackConfig.APIKey != \"\" {\n219\t\t\t\tupstreamReq.Header.Set(\"x-api-key\", p.fallbackConfig.APIKey)\n220\t\t\t}\n221\t\t\tif p.fallbackConfig.AuthToken != \"\" {\n222\t\t\t\tupstreamReq.Header.Set(\"Authorization\", \"Bearer \"+p.fallbackConfig.AuthToken)\n223\t\t\t}\n224\t\t}\n225\t\n226\t\t// 向上游发送请求\n227\t\tupstreamResp, err := p.client.Do(upstreamReq)\n228\t\tif err != nil {\n229\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error: %v\", turn, err)\n230\t\t\tp.markUnavailable()\n231\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n232\t\t\treturn\n233\t\t}\n234\t\tdefer upstreamResp.Body.Close()\n235\t\n236\t\t// 响应错误（4xx/5xx）→ 标记上游不可用（契约 4）\n237\t\tif upstreamResp.StatusCode >= 400 {\n238\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error response: %d\", turn, upstreamResp.StatusCode)\n239\t\t\tp.markUnavailable()\n240\t\t}\n241\t\n242\t\tduration := time.Since(t0).Milliseconds()\n243\t\n244\t\t// 从请求体中提取 model 字段\n245\t\tmodel := \"\"\n246\t\tif m, ok := reqBody.(map[string]any); ok {\n247\t\t\tif v, ok := m[\"model\"].(string); ok {\n248\t\t\t\tmodel = v\n249\t\t\t}\n250\t\t}\n251\t\n252\t\t// 检测是否为流式请求\n253\t\tisStreaming := false\n254\t\tif m, ok := reqBody.(map[string]any); ok {\n255\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n256\t\t\t\tisStreaming = s\n257\t\t\t}\n258\t\t}\n259\t\n260\t\t// 根据是否流式分发到对应处理器\n261\t\tif isStreaming {\n262\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n263\t\t} else {\n264\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n265\t\t}\n266\t}\n267\t\n268\t// handleStreaming 处理 SSE 流式响应：\n269\t//   - 复制响应头并写入客户端\n270\t//   - 逐块读取上游响应体并实时转发给客户端\n271\t//   - 使用 SSE 重组器收集完整事件\n272\t//   - 将重组后的结果写入 Trace\n273\tfunc (p *ReverseProxy) handleStreaming(\n274\t\tw http.ResponseWriter,\n275\t\tupstreamResp *http.Response,\n276\t\treqID string, turn, durationMs int,\n277\t\tr *http.Request, reqBody any,\n278\t\tt0 time.Time, model string,\n279\t) {\n280\t\t// 复制响应头\n281\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n282\t\tfor k, vals := range respHeaders {\n283\t\t\tfor _, v := range vals {\n284\t\t\t\tw.Header().Add(k, v)\n285\t\t\t}\n286\t\t}\n287\t\tw.WriteHeader(upstreamResp.StatusCode)\n288\t\n289\t\tflusher, canFlush := w.(http.Flusher)\n290\t\treassembler := sse.NewSSEReassembler()\n291\t\n292\t\t// 逐块读取并转发流式数据\n293\t\tbuf := make([]byte, 32*1024)\n294\t\tfor {\n295\t\t\tn, err := upstreamResp.Body.Read(buf)\n296\t\t\tif n > 0 {\n297\t\t\t\t_, _ = w.Write(buf[:n])\n298\t\t\t\tif canFlush {\n299\t\t\t\t\tflusher.Flush()\n300\t\t\t\t}\n301\t\t\t\treassembler.FeedBytes(buf[:n])\n302\t\t\t}\n303\t\t\tif err != nil {\n304\t\t\t\tbreak\n305\t\t\t}\n306\t\t}\n307\t\n308\t\tdurationMs = int(time.Since(t0).Milliseconds())\n309\t\treconstructed := reassembler.Reconstruct()\n310\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n311\t\n312\t\t// kimi 模式下缓存 SSE 响应中的 reasoning_content\n313\t\tif p.kimiMode && reconstructed != nil {\n314\t\t\tp.cacheFromResponse(reconstructed)\n315\t\t}\n316\t\n317\t\t// 构建 Trace 记录\n318\t\trecord := buildRecord(\n319\t\t\treqID, turn, durationMs,\n320\t\t\tr.Method, r.URL.RequestURI(),\n321\t\t\tr.Header, reqBody,\n322\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n323\t\t\treconstructed,\n324\t\t\treassembler.Events,\n325\t\t\tp.target,\n326\t\t)\n327\t\n328\t\tif w := p.getWriter(); w != nil {\n329\t\t\tif err := w.Write(record); err != nil {\n330\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n331\t\t\t}\n332\t\t} else {\n333\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n334\t\t}\n335\t\n336\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n337\t}\n338\t\n339\t// handleNonStreaming 处理普通（非流式）响应：\n340\t//   - 读取完整响应体\n341\t//   - 按需解压（gzip / deflate）\n342\t//   - 解析 JSON 响应体\n343\t//   - 写入 Trace 并返回给客户端\n344\tfunc (p *ReverseProxy) handleNonStreaming(\n345\t\tw http.ResponseWriter,\n346\t\tupstreamResp *http.Response,\n347\t\treqID string, turn, durationMs int,\n348\t\tr *http.Request, reqBody any, model string,\n349\t) {\n350\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n351\t\tif err != nil {\n352\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n353\t\t\treturn\n354\t\t}\n355\t\n356\t\t// 按需解压响应体\n357\t\tdecodeBytes := respBytes\n358\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n359\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n360\t\t\tvar reader io.ReadCloser\n361\t\t\tif encoding == \"gzip\" {\n362\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n363\t\t\t} else {\n364\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n365\t\t\t}\n366\t\t\tif reader != nil {\n367\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n368\t\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n369\t\t\t\t\tdecodeBytes = decoded\n370\t\t\t\t}\n371\t\t\t\t_ = reader.Close()\n372\t\t\t}\n373\t\t}\n374\t\n375\t\t// 解析解压后的 JSON 响应体\n376\t\tvar respBody any\n377\t\tif len(decodeBytes) > 0 {\n378\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n379\t\t}\n380\t\n381\t\t// kimi 模式下缓存响应中的 reasoning_content\n382\t\tif p.kimiMode {\n383\t\t\tif respMap, ok := respBody.(map[string]any); ok {\n384\t\t\t\tp.cacheFromResponse(respMap)\n385\t\t\t}\n386\t\t}\n387\t\n388\t\t// 构建 Trace 记录\n389\t\trecord := buildRecord(\n390\t\t\treqID, turn, durationMs,\n391\t\t\tr.Method, r.URL.RequestURI(),\n392\t\t\tr.Header, reqBody,\n393\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n394\t\t\trespBody,\n395\t\t\tnil,\n396\t\t\tp.target,\n397\t\t)\n398\t\n399\t\tif w := p.getWriter(); w != nil {\n400\t\t\tif err := w.Write(record); err != nil {\n401\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n402\t\t\t}\n403\t\t} else {\n404\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n405\t\t}\n406\t\n407\t\t// 将响应返回给客户端\n408\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n409\t\tfor k, vals := range respHeaders {\n410\t\t\tfor _, v := range vals {\n411\t\t\t\tw.Header().Add(k, v)\n412\t\t\t}\n413\t\t}\n414\t\tw.WriteHeader(upstreamResp.StatusCode)\n415\t\t_, _ = w.Write(respBytes)\n416\t\n417\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n418\t}\n419\t\n420\t// buildRecord 构建一条 Trace 记录，包含请求/响应的完整信息。\n421\tfunc buildRecord(\n422\t\treqID string, turn, durationMs int,\n423\t\tmethod, path string,\n424\t\treqHeaders http.Header, reqBody any,\n425\t\tstatus int, respHeaders http.Header,\n426\t\trespBody any,\n427\t\tsseEvents []map[string]any,\n428\t\tupstreamBaseURL string,\n429\t) map[string]any {\n430\t\trecord := map[string]any{\n431\t\t\t\"timestamp\":   time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n432\t\t\t\"request_id\":  reqID,\n433\t\t\t\"session_id\":  extractSessionID(reqBody),\n434\t\t\t\"turn\":        turn,\n435\t\t\t\"duration_ms\": durationMs,\n436\t\t\t\"request\": map[string]any{\n437\t\t\t\t\"method\":  method,\n438\t\t\t\t\"path\":    path,\n439\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n440\t\t\t\t\"body\":    reqBody,\n441\t\t\t},\n442\t\t\t\"response\": map[string]any{\n443\t\t\t\t\"status\":  status,\n444\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n445\t\t\t\t\"body\":    respBody,\n446\t\t\t},\n447\t\t}\n448\t\tif len(sseEvents) > 0 {\n449\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n450\t\t}\n451\t\tif upstreamBaseURL != \"\" {\n452\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n453\t\t}\n454\t\treturn record\n455\t}\n456\t\n457\t// extractSessionID 从请求体的 metadata.user_id 字段中提取 session_id。\n458\t// Claude Code 发送的格式为：metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n459\tfunc extractSessionID(reqBody any) string {\n460\t\tbody, ok := reqBody.(map[string]any)\n461\t\tif !ok {\n462\t\t\treturn \"\"\n463\t\t}\n464\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n465\t\tif metadata == nil {\n466\t\t\treturn \"\"\n467\t\t}\n468\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n469\t\tif userIDRaw == \"\" {\n470\t\t\treturn \"\"\n471\t\t}\n472\t\tvar userData map[string]string\n473\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n474\t\t\treturn \"\"\n475\t\t}\n476\t\treturn userData[\"session_id\"]\n477\t}\n478\t\n479\t// handleInternal 分发内部代理端点请求。\n480\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n481\t\tswitch r.URL.Path {\n482\t\tcase \"/_internal/trace-init\":\n483\t\t\tp.handleTraceInit(w, r)\n484\t\tdefault:\n485\t\t\thttp.NotFound(w, r)\n486\t\t}\n487\t}\n488\t\n489\t// handleTraceInit 接收 SessionStart 钩子传来的会话信息，创建 Trace 写入器。\n490\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n491\t\tif r.Method != http.MethodPost {\n492\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n493\t\t\treturn\n494\t\t}\n495\t\n496\t\tvar req struct {\n497\t\t\tSessionID      string `json:\"session_id\"`\n498\t\t\tMachineID      string `json:\"machine_id\"`\n499\t\t\tProjectSlug    string `json:\"project_slug\"`\n500\t\t\tTranscriptPath string `json:\"transcript_path\"`\n501\t\t}\n502\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n503\t\t\tlogger.Warn(\"proxy\", \"trace-init: invalid JSON: %v\", err)\n504\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n505\t\t\treturn\n506\t\t}\n507\t\n508\t\tif req.SessionID == \"\" {\n509\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n510\t\t\treturn\n511\t\t}\n512\t\n513\t\t// 并发路由由 init 锁 + PID 文件保证，允许 session 重新绑定（旧 session 结束后可更新）\n514\t\tif p.sessionID != \"\" && p.sessionID != req.SessionID {\n515\t\t\tlogger.Debug(\"proxy\", \"trace-init: rebinding session %s -> %s\", p.sessionID, req.SessionID)\n516\t\t}\n517\t\n518\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n519\t\n520\t\t// 若请求中未提供，则通过 trace 包自动检测\n521\t\tmachineID := req.MachineID\n522\t\tif machineID == \"\" {\n523\t\t\tmachineID = trace.MachineID()\n524\t\t}\n525\t\n526\t\tprojectSlug := req.ProjectSlug\n527\t\tif projectSlug == \"\" {\n528\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n529\t\t\tif projectSlug == \"\" {\n530\t\t\t\tprojectSlug = trace.DetectProjectName()\n531\t\t\t}\n532\t\t}\n533\t\n534\t\t// 创建会话专属的 Trace 写入器\n535\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n536\t\twriter, err := trace.NewTraceWriter(tracePath)\n537\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n538\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n539\t\tif err != nil {\n540\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n541\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n542\t\t\treturn\n543\t\t}\n544\t\n545\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n546\t\t\tif p.writer != nil {\n547\t\t\t\tp.writer.Close()\n548\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n549\t\t\t}\n550\t\tp.writer = writer\n551\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n552\t\n553\t\t// 通知外部注册 proxy.json\n554\t\tif p.OnSessionInit != nil {\n555\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n556\t\t}\n557\t\n558\t\t// 通知 main.go：trace-init 处理完成，可以释放 init 锁\n559\t\tif p.OnTraceInitDone != nil {\n560\t\t\tp.OnTraceInitDone()\n561\t\t}\n562\t\n563\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n564\t\tjson.NewEncoder(w).Encode(map[string]string{\n565\t\t\t\"status\":     \"ok\",\n566\t\t\t\"trace_path\": tracePath,\n567\t\t})\n568\t}\n569\t\n570\t// getWriter 返回当前会话的 Trace 写入器。\n571\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n572\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n573\t\treturn p.writer\n574\t}\n575\t\n576\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n577\t// 若无有效写入器，返回零值统计。\n578\tfunc (p *ReverseProxy) Summary() map[string]any {\n579\t\tif w := p.getWriter(); w != nil {\n580\t\t\treturn w.Summary()\n581\t\t}\n582\t\treturn map[string]any{\n583\t\t\t\"api_calls\":           0,\n584\t\t\t\"input_tokens\":        int64(0),\n585\t\t\t\"output_tokens\":       int64(0),\n586\t\t\t\"cache_read_tokens\":   int64(0),\n587\t\t\t\"cache_create_tokens\": int64(0),\n588\t\t}\n589\t}\n590\t\n591\t// SessionID 返回当前会话的 session_id。\n592\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n593\tfunc (p *ReverseProxy) SessionID() string {\n594\t\tif p.sessionID != \"\" {\n595\t\t\treturn p.sessionID\n596\t\t}\n597\t\tif w := p.getWriter(); w != nil {\n598\t\t\treturn w.SessionID()\n599\t\t}\n600\t\treturn \"\"\n601\t}\n602\t\n603\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n604\tfunc (p *ReverseProxy) ProjectSlug() string {\n605\t\treturn p.projectSlug\n606\t}\n607\t\n608\t// TracePath 返回当前追踪文件的完整路径。\n609\tfunc (p *ReverseProxy) TracePath() string {\n610\t\tif w := p.getWriter(); w != nil {\n611\t\t\treturn w.Path()\n612\t\t}\n613\t\treturn \"\"\n614\t}\n615\t\n616\t// markUnavailable 标记上游不可用（契约 4）。\n617\t// 首次失败后置 upstreamAvailable = false，进程生命周期内不再恢复。\n618\tfunc (p *ReverseProxy) markUnavailable() {\n619\t\tp.availableMu.Lock()\n620\t\tdefer p.availableMu.Unlock()\n621\t\tif p.upstreamAvailable {\n622\t\t\tp.upstreamAvailable = false\n623\t\t\tlogger.Warn(\"proxy\", \"upstream marked unavailable, switching to fallback\")\n624\t\t}\n625\t}\n626\t\n627\t// SetModel 设置强制替换的模型名。\n628\tfunc (p *ReverseProxy) SetModel(model string) {\n629\t\tp.model = model\n630\t}\n631\t\n632\t// SetFallbackConfig 设置兜底配置。\n633\tfunc (p *ReverseProxy) SetFallbackConfig(cfg *FallbackConfig) {\n634\t\tp.fallbackConfig = cfg\n635\t}\n636\t\n637\t// SetKimiMode 启用或禁用 kimi 模式。\n638\t// 启用时会自动创建 reasoning_content 缓存。\n639\tfunc (p *ReverseProxy) SetKimiMode(kimi bool) {\n640\t\tp.kimiMode = kimi\n641\t\tif kimi && p.reasoningCache == nil {\n642\t\t\tp.reasoningCache = NewReasoningCache()\n643\t\t\tlogger.Info(\"proxy\", \"kimi mode enabled, reasoning_content caching active\")\n644\t\t}\n645\t}\n646\t\n647\t// IsKimiURL 判断 URL 是否为 kimi/moonshot 上游。\n648\tfunc IsKimiURL(url string) bool {\n649\t\tlower := strings.ToLower(url)\n650\t\treturn strings.Contains(lower, \"kimi\") || strings.Contains(lower, \"moonshot\")\n651\t}\n652\t\n653\t// cacheFromResponse 从 API 响应快照中提取 reasoning_content 并存入缓存。\n654\t//\n655\t// 同时处理两种响应格式：\n656\t//   - OpenAI Chat Completions: snap[\"choices\"][0][\"message\"] 包含 reasoning_content/content/tool_calls\n657\t//   - Anthropic: snap[\"content\"] 包含 thinking 块和 tool_use 块\n658\t//\n659\t// 仅在 kimi 模式下调用。\n660\tfunc (p *ReverseProxy) cacheFromResponse(snap map[string]any) {\n661\t\tif p.reasoningCache == nil || snap == nil {\n662\t\t\treturn\n663\t\t}\n664\t\n665\t\t// 提取 reasoning_content 和消息内容\n666\t\tvar reasoningContent string\n667\t\tvar msgContent string    // 文本内容（用于 full key）\n668\t\tvar toolCallsJSON string // tool_calls JSON（用于 tc key 和 full key）\n669\t\n670\t\t// 路径 1: OpenAI Chat Completions 格式\n671\t\tchoices, _ := snap[\"choices\"].([]any)\n672\t\tif len(choices) > 0 {\n673\t\t\tchoice, _ := choices[0].(map[string]any)\n674\t\t\tif choice != nil {\n675\t\t\t\tmsg, _ := choice[\"message\"].(map[string]any)\n676\t\t\t\tif msg != nil {\n677\t\t\t\t\treasoningContent, _ = msg[\"reasoning_content\"].(string)\n678\t\t\t\t\tmsgContent, _ = msg[\"content\"].(string)\n679\t\t\t\t\tif tc, ok := msg[\"tool_calls\"]; ok && tc != nil {\n680\t\t\t\t\t\tif tcBytes, err := json.Marshal(tc); err == nil {\n681\t\t\t\t\t\t\ttoolCallsJSON = string(tcBytes)\n682\t\t\t\t\t\t}\n683\t\t\t\t\t}\n684\t\t\t\t}\n685\t\t\t}\n686\t\t}\n687\t\n688\t\t// 路径 2: Anthropic 格式（从 content 数组中的 thinking 块提取）\n689\t\tif reasoningContent == \"\" {\n690\t\t\tcontentArr, _ := snap[\"content\"].([]any)\n691\t\t\tfor _, blockRaw := range contentArr {\n692\t\t\t\tblock, ok := blockRaw.(map[string]any)\n693\t\t\t\tif !ok {\n694\t\t\t\t\tcontinue\n695\t\t\t\t}\n696\t\t\t\tif blockType, _ := block[\"type\"].(string); blockType == \"thinking\" {\n697\t\t\t\t\tif thinking, ok := block[\"thinking\"].(string); ok && thinking != \"\" {\n698\t\t\t\t\t\treasoningContent = thinking\n699\t\t\t\t\t\tbreak\n700\t\t\t\t\t}\n701\t\t\t\t}\n702\t\t\t}\n703\t\t\t// 同时从 Anthropic 格式提取 tool_use 块用于 key 计算\n704\t\t\tif toolCallsJSON == \"\" {\n705\t\t\t\tvar toolUseBlocks []any\n706\t\t\t\tfor _, blockRaw := range contentArr {\n707\t\t\t\t\tblock, ok := blockRaw.(map[string]any)\n708\t\t\t\t\tif !ok {\n709\t\t\t\t\t\tcontinue\n710\t\t\t\t\t}\n711\t\t\t\t\tif blockType, _ := block[\"type\"].(string); blockType == \"tool_use\" {\n712\t\t\t\t\t\ttoolUseBlocks = append(toolUseBlocks, block)\n713\t\t\t\t\t}\n714\t\t\t\t}\n715\t\t\t\tif len(toolUseBlocks) > 0 {\n716\t\t\t\t\tif tcBytes, err := json.Marshal(toolUseBlocks); err == nil {\n717\t\t\t\t\t\ttoolCallsJSON = string(tcBytes)\n718\t\t\t\t\t}\n719\t\t\t\t}\n720\t\t\t}\n721\t\t}\n722\t\n723\t\tif reasoningContent == \"\" {\n724\t\t\treturn // 无 reasoning_content 可缓存\n725\t\t}\n726\t\n727\t\tfullKey := MakeFullKey(msgContent, toolCallsJSON)\n728\t\ttcKey := MakeToolcallKey(toolCallsJSON)\n729\t\tp.reasoningCache.Store(fullKey, tcKey, reasoningContent)\n730\t\n731\t\tf, t := p.reasoningCache.Len()\n732\t\tlogger.Debug(\"proxy\", \"cached reasoning_content: rc_len=%d full=%d tc=%d\", len(reasoningContent), f, t)\n733\t}\n734\t\n735\t// rewriteModel 改写请求体 JSON 中的 model 字段（契约 3）。\n736\t// 如果 model 为空、body 为空、body 非 JSON 或 body 为 JSON 非对象，原样返回。\n737\tfunc rewriteModel(body []byte, parsed any, model string) []byte {\n738\t\tif model == \"\" || len(body) == 0 {\n739\t\t\treturn body\n740\t\t}\n741\t\n742\t\tm, ok := parsed.(map[string]any)\n743\t\tif !ok {\n744\t\t\treturn body // 非 JSON 或非对象\n745\t\t}\n746\t\n747\t\tm[\"model\"] = model\n748\t\trewritten, err := json.Marshal(m)\n749\t\tif err != nil {\n750\t\t\treturn body // 改写失败，原样返回\n751\t\t}\n752\t\treturn rewritten\n753\t}\n754\t\n755\t// injectReasoningContentCached 为 assistant tool_call 消息注入 reasoning_content 补丁。\n756\t//\n757\t// Kimi 等兼容 Anthropic 的端点要求：assistant tool_call 消息必须携带顶层字段 reasoning_content，\n758\t// 以及 content 数组中的 thinking 块。Claude Code 发送 tool_call 消息时不包含这些字段，导致上游 400 错误：\n759\t//\n760\t//\t400 thinking is enabled but reasoning_content is missing in assistant tool call message at index N\n761\t//\n762\t// 行为随 isKimi 参数变化：\n763\t//   - isKimi=false: 不做任何修改，直接透传\n764\t//   - isKimi=true + cache!=nil: 使用缓存的三级查找回填真实 reasoning_content\n765\t//   - isKimi=true + cache==nil: 注入空字符串（兜底行为，空字符串无害但能防止报错）\n766\tfunc injectReasoningContentCached(body []byte, parsed any, cache *ReasoningCache, isKimi bool) []byte {\n767\t\tif !isKimi {\n768\t\t\treturn body // 非 kimi 上游不做任何注入\n769\t\t}\n770\t\n771\t\tif len(body) == 0 {\n772\t\t\treturn body\n773\t\t}\n774\t\n775\t\tm, ok := parsed.(map[string]any)\n776\t\tif !ok {\n777\t\t\treturn body // 非 JSON 或非对象\n778\t\t}\n779\t\n780\t\t// 获取 messages 数组（无 messages 则无需处理）\n781\t\tmessages, ok := m[\"messages\"].([]any)\n782\t\tif !ok || len(messages) == 0 {\n783\t\t\treturn body\n784\t\t}\n785\t\n786\t\tmodified := false\n787\t\tfor i, msgRaw := range messages {\n788\t\t\tmsg, ok := msgRaw.(map[string]any)\n789\t\t\tif !ok {\n790\t\t\t\tcontinue\n791\t\t\t}\n792\t\n793\t\t\t// 只处理 assistant 消息\n794\t\t\trole, _ := msg[\"role\"].(string)\n795\t\t\tif role != \"assistant\" {\n796\t\t\t\tcontinue\n797\t\t\t}\n798\t\n799\t\t\t// 检查 content 是否为数组\n800\t\t\tcontent, ok := msg[\"content\"].([]any)\n801\t\t\tif !ok || len(content) == 0 {\n802\t\t\t\tcontinue\n803\t\t\t}\n804\t\n805\t\t\t// 检查是否有 tool_use 块、thinking 块、reasoning_content 字段\n806\t\t\thasToolUse := false\n807\t\t\thasThinking := false\n808\t\t\tfor _, blockRaw := range content {\n809\t\t\t\tblock, ok := blockRaw.(map[string]any)\n810\t\t\t\tif !ok {\n811\t\t\t\t\tcontinue\n812\t\t\t\t}\n813\t\t\t\tblockType, _ := block[\"type\"].(string)\n814\t\t\t\tif blockType == \"tool_use\" {\n815\t\t\t\t\thasToolUse = true\n816\t\t\t\t}\n817\t\t\t\tif blockType == \"thinking\" {\n818\t\t\t\t\thasThinking = true\n819\t\t\t\t}\n820\t\t\t}\n821\t\n822\t\t\t// 检查已有的 reasoning_content\n823\t\t\texistingRC, hasReasoningContent := msg[\"reasoning_content\"].(string)\n824\t\n825\t\t\t// 只处理含 tool_use 的 assistant 消息\n826\t\t\tif !hasToolUse {\n827\t\t\t\tcontinue\n828\t\t\t}\n829\t\n830\t\t\tneedPatch := false\n831\t\n832\t\t\t// 如果已有非空的 reasoning_content，用它刷新缓存\n833\t\t\tif hasReasoningContent && existingRC != \"\" && cache != nil {\n834\t\t\t\tfullKey := MakeFullKeyFromMsg(msg)\n835\t\t\t\ttcKey := MakeToolcallKeyFromMsg(msg)\n836\t\t\t\tcache.Store(fullKey, tcKey, existingRC)\n837\t\t\t\t// 已有完整 reasoning_content，不需要补丁\n838\t\t\t\t// 但仍需确保 thinking 块存在\n839\t\t\t}\n840\t\n841\t\t\t// 补丁 1: content 数组缺少 thinking 块 → 在开头插入\n842\t\t\tif !hasThinking {\n843\t\t\t\tthinkingBlock := map[string]any{\n844\t\t\t\t\t\"type\":     \"thinking\",\n845\t\t\t\t\t\"thinking\": \"\",\n846\t\t\t\t}\n847\t\t\t\tnewContent := make([]any, 0, len(content)+1)\n848\t\t\t\tnewContent = append(newContent, thinkingBlock)\n849\t\t\t\tnewContent = append(newContent, content...)\n850\t\t\t\tmsg[\"content\"] = newContent\n851\t\t\t\tneedPatch = true\n852\t\t\t}\n853\t\n854\t\t\t// 补丁 2: 消息缺少顶层 reasoning_content 字段 → 尝试从缓存回填\n855\t\t\tif !hasReasoningContent {\n856\t\t\t\trcValue := \"\" // 兜底空字符串\n857\t\t\t\tif cache != nil {\n858\t\t\t\t\tfullKey := MakeFullKeyFromMsg(msg)\n859\t\t\t\t\ttcKey := MakeToolcallKeyFromMsg(msg)\n860\t\t\t\t\tif cached, found := cache.Lookup(fullKey, tcKey, true); found {\n861\t\t\t\t\t\trcValue = cached\n862\t\t\t\t\t}\n863\t\t\t\t}\n864\t\t\t\tmsg[\"reasoning_content\"] = rcValue\n865\t\t\t\tneedPatch = true\n866\t\t\t}\n867\t\n868\t\t\tif needPatch {\n869\t\t\t\tmessages[i] = msg\n870\t\t\t\tmodified = true\n871\t\t\t}\n872\t\t}\n873\t\n874\t\tif !modified {\n875\t\t\treturn body\n876\t\t}\n877\t\n878\t\tm[\"messages\"] = messages\n879\t\trewritten, err := json.Marshal(m)\n880\t\tif err != nil {\n881\t\t\treturn body\n882\t\t}\n883\t\treturn rewritten\n884\t}\n885\t"}]}
