[2026-06-07 11:56:38] [INFO] [PreToolUse] Input: {"session_id":"5a952b88-dbcf-40a5-820e-fed7478f0486","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\5a952b88-dbcf-40a5-820e-fed7478f0486.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"default","effort":{"level":"medium"},"hook_event_name":"PreToolUse","tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\proxy_handler.go"},"tool_use_id":"call_08a5a1f3f1fa4818a1c2ef4a"}
