父进程信号影响\n50\t\tif runtime.GOOS == \"windows\" {\n51\t\t\t// Windows: 创建新进程组，脱离父进程控制台\n52\t\t\tcmd.SysProcAttr = syscallSysProcAttr()\n53\t\t} else {\n54\t\t\t// Unix: 创建新进程组\n55\t\t\tcmd.SysProcAttr = unixSysProcAttr()\n56\t\t}\n57\t\n58\t\tif err := cmd.Start(); err != nil {\n59\t\t\treturn fmt.Errorf(\"start backend: %w\", err)\n60\t\t}\n61\t\n62\t\tlogger.Info(\"autostart\", \"backend process started: pid=%d\", cmd.Process.Pid)\n63\t\t// 释放子进程，让其独立运行，父进程不等待\n64\t\tcmd.Process.Release()\n65\t\treturn nil\n66\t}\n67\t\n68\t// waitForBackend 轮询 /health 端点，等待后端就绪。\n69\t// timeout 为最长等待时间，interval 为轮询间隔。\n70\t// 返回 true 表示后端已就绪，false 表示超时。\n71\tfunc waitForBackend(timeout, interval time.Duration) bool {\n72\t\tdeadline := time.Now().Add(timeout)\n73\t\tclient := &http.Client{Timeout: 500 * time.Millisecond}\n74\t\n75\t\tfor time.Now().Before(deadline) {\n76\t\t\tresp, err := client.Get(backendHealthURL())\n77\t\t\tif err == nil {\n78\t\t\t\tresp.Body.Close()\n79\t\t\t\tif resp.StatusCode == http.StatusOK {\n80\t\t\t\t\treturn true\n81\t\t\t\t}\n82\t\t\t}\n83\t\t\ttime.Sleep(interval)\n84\t\t}\n85\t\treturn false\n86\t}\n87\t\n88\t// ensureBackend 检测后端是否在运行，如果未运行则自动启动。\n89\t// 启动失败不阻塞代理，仅记录警告。\n90\tfunc ensureBackend() {\n91\t\t// 步骤 1：检查后端是否已在运行\n92\t\tif isBackendRunning() {\n93\t\t\tlogger.Info(\"autostart\", \"backend already running\")\n94\t\t\treturn\n95\t\t}\n96\t\n97\t\t// 步骤 2：后端未运行，启动新进程\n98\t\tlogger.Info(\"autostart\", \"backend not running, starting...\")\n99\t\tif err := startBackendProcess(); err != nil {\n100\t\t\tlogger.Warn(\"autostart\", \"failed to start backend: %v\", err)\n101\t\t\treturn\n102\t\t}\n103\t\n104\t\t// 步骤 3：等待后端就绪（最多 5 秒）\n105\t\tif waitForBackend(5*time.Second, 200*time.Millisecond) {\n106\t\t\tinfo := ReadBackendInfo()\n107\t\t\tif info != nil {\n108\t\t\t\tfmt.Printf(\"   Backend started at http://%s:%d\\n\", info.Host, info.Port)\n109\t\t\t}\n110\t\t\tlogger.Info(\"autostart\", \"backend ready\")\n111\t\t} else {\n112\t\t\tlogger.Warn(\"autostart\", \"backend did not become healthy within 5s\")\n113\t\t}\n114\t}\n115\t\n116\t// backendAPIBase 返回后端 API 的基础 URL（从 backend.json 读取）。\n117\tfunc backendAPIBase() string {\n118\t\tif info := ReadBackendInfo(); info != nil {\n119\t\t\treturn fmt.Sprintf(\"http://%s:%d\", info.Host, info.Port)\n120\t\t}\n121\t\treturn \"http://127.0.0.1:8080\"\n122\t}\n123\t\n124\t// registerProxyWithBackend 向后端注册本代理进程。\n125\tfunc registerProxyWithBackend(proxyURL string) {\n126\t\tpid := fmt.Sprintf(\"%d\", os.Getpid())\n127\t\tbody, _ := json.Marshal(map[string]string{\"pid\": pid, \"proxy_url\": proxyURL})\n128\t\tresp, err := http.Post(backendAPIBase()+\"/api/proxy/register\", \"application/json\", bytes.NewReader(body))\n129\t\tif err != nil {\n130\t\t\tlogger.Warn(\"autostart\", \"proxy register failed: %v\", err)\n131\t\t\treturn\n132\t\t}\n133\t\tdefer resp.Body.Close()\n134\t\tlogger.Info(\"autostart\", \"proxy registered: pid=%s url=%s\", pid, proxyURL)\n135\t}\n136\t\n137\t// unregisterProxyFromBackend 从后端注销本代理进程。\n138\tfunc unregisterProxyFromBackend() {\n139\t\tpid := fmt.Sprintf(\"%d\", os.Getpid())\n140\t\tbody, _ := json.Marshal(map[string]string{\"pid\": pid})\n141\t\tresp, err := http.Post(backendAPIBase()+\"/api/proxy/unregister\", \"application/json\", bytes.NewReader(body))\n142\t\tif err != nil {\n143\t\t\tlogger.Warn(\"autostart\", \"proxy unregister failed: %v\", err)\n144\t\t\treturn\n145\t\t}\n146\t\tdefer resp.Body.Close()\n147\t\tlogger.Info(\"autostart\", \"proxy unregistered: pid=%s\", pid)\n148\t}\n149\t"}]}
