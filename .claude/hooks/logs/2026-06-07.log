r := store.NewSQLiteStore(dbPath)\n48\t\tif err != nil {\n49\t\t\tos.Remove(dbPath)\n50\t\t\tt.Fatal(err)\n51\t\t}\n52\t\n53\t\tt.Cleanup(func() {\n54\t\t\ts.Close()\n55\t\t\tos.Remove(dbPath)\n56\t\t})\n57\t\n58\t\tissueSvc := service.NewIssueService(s.Issues())\n59\t\tsessionSvc := service.NewSessionService(s.Sessions())\n60\t\tproxySvc := service.NewProxyService(s.Proxies())\n61\t\tproxyHandler := api.NewProxyHandlerWithService(proxySvc)\n62\t\n63\t\trouter := api.NewRouter(api.Handlers{\n64\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n65\t\t\tSession: api.NewSessionHandler(sessionSvc, issueSvc, service.NewTokenService(s.Sessions()), service.NewTraceService(s.Sessions())),\n66\t\t\tProxy:   proxyHandler,\n67\t\t})\n68\t\n69\t\tenv := &traceInitTestEnv{\n70\t\t\thandler: proxyHandler,\n71\t\t}\n72\t\n73\t\t// mock proxy A：记录每次收到的 session_id，返回 trace_path_a\n74\t\tenv.proxyA = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n75\t\t\tif r.URL.Path != \"/_internal/trace-init\" {\n76\t\t\t\thttp.NotFound(w, r)\n77\t\t\t\treturn\n78\t\t\t}\n79\t\t\tb, _ := io.ReadAll(r.Body)\n80\t\t\tvar body struct {\n81\t\t\t\tSessionID string `json:\"session_id\"`\n82\t\t\t}\n83\t\t\tjson.Unmarshal(b, &body)\n84\t\t\tenv.aCalls = append(env.aCalls, body.SessionID)\n85\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n86\t\t\tjson.NewEncoder(w).Encode(traceInitResponse{Status: \"ok\", TracePath: \"/traces/a_\" + body.SessionID + \".jsonl\"})\n87\t\t}))\n88\t\n89\t\t// mock proxy B：记录每次收到的 session_id，返回 trace_path_b\n90\t\tenv.proxyB = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n91\t\t\tif r.URL.Path != \"/_internal/trace-init\" {\n92\t\t\t\thttp.NotFound(w, r)\n93\t\t\t\treturn\n94\t\t\t}\n95\t\t\tb, _ := io.ReadAll(r.Body)\n96\t\t\tvar body struct {\n97\t\t\t\tSessionID string `json:\"session_id\"`\n98\t\t\t}\n99\t\t\tjson.Unmarshal(b, &body)\n100\t\t\tenv.bCalls = append(env.bCalls, body.SessionID)\n101\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n102\t\t\tjson.NewEncoder(w).Encode(traceInitResponse{Status: \"ok\", TracePath: \"/traces/b_\" + body.SessionID + \".jsonl\"})\n103\t\t}))\n104\t\n105\t\tenv.srv = httptest.NewServer(router)\n106\t\tt.Cleanup(func() {\n107\t\t\tenv.srv.Close()\n108\t\t\tenv.proxyA.Close()\n109\t\t\tenv.proxyB.Close()\n110\t\t})\n111\t\n112\t\treturn env\n113\t}\n114\t\n115\t// post 发送 POST 请求到测试环境。\n116\tfunc (e *traceInitTestEnv) post(t *testing.T, path, body string) *http.Response {\n117\t\tt.Helper()\n118\t\tresp, err := http.Post(e.srv.URL+path, \"application/json\", strings.NewReader(body))\n119\t\tif err != nil {\n120\t\t\tt.Fatal(err)\n121\t\t}\n122\t\treturn resp\n123\t}\n124\t\n125\t// registerProxy 向 backend 注册一个 mock proxy。\n126\tfunc (e *traceInitTestEnv) registerProxy(t *testing.T, pid, url string) {\n127\t\tt.Helper()\n128\t\tresp := e.post(t, \"/api/proxy/register\", fmt.Sprintf(`{\"pid\":\"%s\",\"proxy_url\":\"%s\"}`, pid, url))\n129\t\tdefer resp.Body.Close()\n130\t\tif resp.StatusCode != http.StatusOK {\n131\t\t\tt.Fatalf(\"register proxy %s: expected 200, got %d\", pid, resp.StatusCode)\n132\t\t}\n133\t}\n134\t\n135\t// unregisterProxy 向 backend 注销一个 mock proxy。\n136\tfunc (e *traceInitTestEnv) unregisterProxy(t *testing.T, pid string) {\n137\t\tt.Helper()\n138\t\tresp := e.post(t, \"/api/proxy/unregister\", fmt.Sprintf(`{\"pid\":\"%s\"}`, pid))\n139\t\tdefer resp.Body.Close()\n140\t\tif resp.StatusCode != http.StatusOK {\n141\t\t\tt.Fatalf(\"unregister proxy %s: expected 200, got %d\", pid, resp.StatusCode)\n142\t\t}\n143\t}\n144\t\n145\t// traceInitWithPID 使用指定 proxy_pid 请求 /api/proxy/trace-init。\n146\tfunc (e *traceInitTestEnv) traceInitWithPID(t *testing.T, sessionID, proxyPID string) traceInitResponse {\n147\t\tt.Helper()\n148\t\tbody := fmt.Sprintf(`{\"session_id\":\"%s\",\"proxy_pid\":\"%s\"}`, sessionID, proxyPID)\n149\t\tresp := e.post(t, \"/api/proxy/trace-init\", body)\n150\t\tdefer resp.Body.Close()\n151\t\tif resp.StatusCode != http.StatusOK {\n152\t\t\tb, _ := io.ReadAll(resp.Body)\n153\t\t\tt.Fatalf(\"trace-init %s: expected 200, got %d, body=%s\", sessionID, resp.StatusCode, b)\n154\t\t}\n155\t\tvar result traceInitResponse\n156\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n157\t\t\tt.Fatal(err)\n158\t\t}\n159\t\treturn result\n160\t}\n161\t\n162\t// TestTraceInit_PIDRoute 验证：通过 proxy_pid 精确路由到目标代理。\n163\tfunc TestTraceInit_PIDRoute(t *testing.T) {\n164\t\tenv := setupTraceInitTest(t)\n165\t\n166\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n167\t\tenv.registerProxy(t, \"pid-B\", env.proxyB.URL)\n168\t\n169\t\t// 指定 pid-B，应该路由到 proxy B\n170\t\tresp := env.traceInitWithPID(t, \"session-S\", \"pid-B\")\n171\t\tif resp.TracePath != \"/traces/b_session-S.jsonl\" {\n172\t\t\tt.Fatalf(\"expected proxy B, got %s\", resp.TracePath)\n173\t\t}\n174\t\n175\t\t// 验证只有 B 被调用\n176\t\tif len(env.aCalls) != 0 {\n177\t\t\tt.Fatalf(\"expected proxy A not called, got %d calls\", len(env.aCalls))\n178\t\t}\n179\t\tif len(env.bCalls) != 1 {\n180\t\t\tt.Fatalf(\"expected proxy B called once, got %d calls\", len(env.bCalls))\n181\t\t}\n182\t}\n183\t\n184\t// TestTraceInit_PIDRouteToA 验证：两个 proxy 注册，指定 pid-A 路由到 A。\n185\tfunc TestTraceInit_PIDRouteToA(t *testing.T) {\n186\t\tenv := setupTraceInitTest(t)\n187\t\n188\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n189\t\tenv.registerProxy(t, \"pid-B\", env.proxyB.URL)\n190\t\n191\t\tresp := env.traceInitWithPID(t, \"session-X\", \"pid-A\")\n192\t\tif resp.TracePath != \"/traces/a_session-X.jsonl\" {\n193\t\t\tt.Fatalf(\"expected proxy A, got %s\", resp.TracePath)\n194\t\t}\n195\t}\n196\t\n197\t// TestTraceInit_UnregisterThenRoute 验证：注销 proxy 后，再路由到该 PID 返回 404。\n198\tfunc TestTraceInit_UnregisterThenRoute(t *testing.T) {\n199\t\tenv := setupTraceInitTest(t)\n200\t\n201\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n202\t\tenv.traceInitWithPID(t, \"session-S\", \"pid-A\")\n203\t\n204\t\tenv.unregisterProxy(t, \"pid-A\")\n205\t\n206\t\t// pid-A 已注销，路由应返回 404\n207\t\tbody := `{\"session_id\":\"session-S\",\"proxy_pid\":\"pid-A\"}`\n208\t\tresp := env.post(t, \"/api/proxy/trace-init\", body)\n209\t\tdefer resp.Body.Close()\n210\t\tif resp.StatusCode != http.StatusNotFound {\n211\t\t\tt.Fatalf(\"expected 404 after unregister, got %d\", resp.StatusCode)\n212\t\t}\n213\t}\n214\t\n215\t// TestTraceInit_MissingProxyPID 验证：缺少 proxy_pid 返回 400。\n216\tfunc TestTraceInit_MissingProxyPID(t *testing.T) {\n217\t\tenv := setupTraceInitTest(t)\n218\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n219\t\n220\t\tresp := env.post(t, \"/api/proxy/trace-init\", `{\"session_id\":\"session-S\"}`)\n221\t\tdefer resp.Body.Close()\n222\t\tif resp.StatusCode != http.StatusBadRequest {\n223\t\t\tt.Fatalf(\"expected 400 for missing proxy_pid, got %d\", resp.StatusCode)\n224\t\t}\n225\t}\n226\t\n227\t// TestTraceInit_MissingSessionID 验证：缺少 session_id 返回 400。\n228\tfunc TestTraceInit_MissingSessionID(t *testing.T) {\n229\t\tenv := setupTraceInitTest(t)\n230\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n231\t\n232\t\tresp := env.post(t, \"/api/proxy/trace-init\", `{\"proxy_pid\":\"pid-A\"}`)\n233\t\tdefer resp.Body.Close()\n234\t\tif resp.StatusCode != http.StatusBadRequest {\n235\t\t\tt.Fatalf(\"expected 400 for missing session_id, got %d\", resp.StatusCode)\n236\t\t}\n237\t}\n238\t\n239\t// TestTraceInit_PIDNotFound 验证：proxy_pid 未注册返回 404。\n240\tfunc TestTraceInit_PIDNotFound(t *testing.T) {\n241\t\tenv := setupTraceInitTest(t)\n242\t\tenv.registerProxy(t, \"pid-A\", env.proxyA.URL)\n243\t\n244\t\t// 请求路由到未注册的 pid-C\n245\t\tresp := env.post(t, \"/api/proxy/trace-init\", `{\"session_id\":\"session-S\",\"proxy_pid\":\"pid-C\"}`)\n246\t\tdefer resp.Body.Close()\n247\t\tif resp.StatusCode != http.StatusNotFound {\n248\t\t\tt.Fatalf(\"expected 404 for unknown PID, got %d\", resp.StatusCode)\n249\t\t}\n250\t}\n251\t"}]}
