 = trace.MachineID()\n518\t\t}\n519\t\n520\t\tprojectSlug := req.ProjectSlug\n521\t\tif projectSlug == \"\" {\n522\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n523\t\t\tif projectSlug == \"\" {\n524\t\t\t\tprojectSlug = trace.DetectProjectName()\n525\t\t\t}\n526\t\t}\n527\t\n528\t\t// 创建会话专属的 Trace 写入器\n529\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n530\t\twriter, err := trace.NewTraceWriter(tracePath)\n531\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n532\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n533\t\tif err != nil {\n534\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n535\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n536\t\t\treturn\n537\t\t}\n538\t\n539\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n540\t\t\tif p.writer != nil {\n541\t\t\t\tp.writer.Close()\n542\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n543\t\t\t}\n544\t\tp.writer = writer\n545\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n546\t\n547\t\t// 通知外部注册 proxy.json\n548\t\tif p.OnSessionInit != nil {\n549\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n550\t\t}\n551\t\n552\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n553\t\tjson.NewEncoder(w).Encode(map[string]string{\n554\t\t\t\"status\":     \"ok\",\n555\t\t\t\"trace_path\": tracePath,\n556\t\t})\n557\t}\n558\t\n559\t// getWriter 返回当前会话的 Trace 写入器。\n560\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n561\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n562\t\treturn p.writer\n563\t}\n564\t\n565\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n566\t// 若无有效写入器，返回零值统计。\n567\tfunc (p *ReverseProxy) Summary() map[string]any {\n568\t\tif w := p.getWriter(); w != nil {\n569\t\t\treturn w.Summary()\n570\t\t}\n571\t\treturn map[string]any{\n572\t\t\t\"api_calls\":           0,\n573\t\t\t\"input_tokens\":        int64(0),\n574\t\t\t\"output_tokens\":       int64(0),\n575\t\t\t\"cache_read_tokens\":   int64(0),\n576\t\t\t\"cache_create_tokens\": int64(0),\n577\t\t}\n578\t}\n579\t\n580\t// SessionID 返回当前会话的 session_id。\n581\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n582\tfunc (p *ReverseProxy) SessionID() string {\n583\t\tif p.sessionID != \"\" {\n584\t\t\treturn p.sessionID\n585\t\t}\n586\t\tif w := p.getWriter(); w != nil {\n587\t\t\treturn w.SessionID()\n588\t\t}\n589\t\treturn \"\"\n590\t}\n591\t\n592\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n593\tfunc (p *ReverseProxy) ProjectSlug() string {\n594\t\treturn p.projectSlug\n595\t}\n596\t\n597\t// TracePath 返回当前追踪文件的完整路径。\n598\tfunc (p *ReverseProxy) TracePath() string {\n599\t\tif w := p.getWriter(); w != nil {"}]}
