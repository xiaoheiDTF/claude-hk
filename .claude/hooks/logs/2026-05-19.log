e] 前缀\n# 5. 输出结果 JSON\n\nHOOKS_DIR=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"\nLOG_DIR=\"$HOOKS_DIR/logs\"\nmkdir -p \"$LOG_DIR\"\n\nsource \"$HOOKS_DIR/platform.sh\"\n\nHOOK_INPUT=$(cat)\nLOG_FILE=\"$LOG_DIR/$(date +%Y-%m-%d).log\"\n\n_log_raw() {\n  echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [$1] $2\" >> \"$LOG_FILE\"\n}\n\njson_get() {\n  local key=\"$1\"\n  if [ -z \"$HOOK_INPUT\" ]; then echo \"\"; return; fi\n  if command -v jq &>/dev/null; then\n    printf '%s' \"$HOOK_INPUT\" | jq -r \"$key\" 2>/dev/null\n    return\n  fi\n  if [ -n \"$PYTHON_CMD\" ]; then\n    printf '%s' \"$HOOK_INPUT\" | \"$PYTHON_CMD\" \"$HOOKS_DIR/json_get.py\" \"$key\" 2>>\"$LOG_FILE\"\n  else\n    echo \"\"\n  fi\n}\n\nHOOK_EVENT=$(json_get '.hook_event_name')\n[ -z \"$HOOK_EVENT\" ] && HOOK_EVENT=\"UNKNOWN\"\n\nlog() {\n  echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [$1] [$HOOK_EVENT] $2\" >> \"$LOG_FILE\"\n}\n\nlog \"DEBUG\" \"os=$OS_TYPE python=$PYTHON_CMD\"\nlog \"INFO\" \"Input: $HOOK_INPUT\"\n\nhook_output() {\n  local exit_code=\"${1:-0}\"\n  local json=\"${2:-{}}\"\n  log \"INFO\" \"Output (exit=$exit_code): $json\"\n  echo \"$json\"\n  exit \"$exit_code\"\n}\n","structuredPatch":[{"oldStart":1,"oldLines":51,"newStart":1,"newLines":24,"lines":[" #!/bin/bash"," # Hooks Base Script","-# 所有钩子脚本的公共基础，负责：","-# 1. 从 stdin 读取钩子事件 JSON","-# 2. 解析关键字段 (jq 优先，json_get.py 回退)","-# 3. 按日期写入日志，每行带官方事件名前缀","-# 4. 输出结果 JSON 到 stdout","+# 1. 平台感知 (platform.sh)","+# 2. 从 stdin 读取 JSON","+# 3. 解析字段","+# 4. 按日期写入日志，带 [EventName] 前缀","+# 5. 输出结果 JSON"," ","-# 使用 CLAUDE_PROJECT_DIR 定位 hooks 目录（比 BASH_SOURCE 更可靠）"," HOOKS_DIR=\"$CLAUDE_PROJECT_DIR/.claude/hooks\""," LOG_DIR=\"$HOOKS_DIR/logs\"","-EMBED_PYTHON=\"$CLAUDE_PROJECT_DIR/.claude/python/python.exe\""," mkdir -p \"$LOG_DIR\""," ","-# 读取 stdin 的 JSON 输入","-HOOK_INPUT=$(cat)","+source \"$HOOKS_DIR/platform.sh\""," ","-# 按日期生成日志文件名","+HOOK_INPUT=$(cat)"," LOG_FILE=\"$LOG_DIR/$(date +%Y-%m-%d).log\""," ","-# ---- 原始日志函数（事件名提取前使用）----"," _log_raw() {","-  local 