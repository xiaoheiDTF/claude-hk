\t  if command -v jq &>/dev/null; then\n53\t    printf '%s' \"$HOOK_INPUT\" | jq -r \"$key\" 2>/dev/null\n54\t    return\n55\t  fi\n56\t  if [ -z \"$_PY_CMD\" ]; then\n57\t    _PY_CMD=$(_find_python)\n58\t  fi\n59\t  if [ -n \"$_PY_CMD\" ]; then\n60\t    printf '%s' \"$HOOK_INPUT\" | \"$_PY_CMD\" \"$HOOKS_DIR/json_get.py\" \"$key\" 2>>\"$LOG_FILE\"\n61\t  else\n62\t    _log_raw \"WARN\" \"json_get: no jq or python found\"\n63\t    echo \"\"\n64\t  fi\n65\t}\n66\t\n67\t# ---- 提取官方事件名 ----\n68\tHOOK_EVENT=$(json_get '.hook_event_name')\n69\t# 如果提取失败，标记为 UNKNOWN\n70\tif [ -z \"$HOOK_EVENT\" ]; then\n71\t  HOOK_EVENT=\"UNKNOWN\"\n72\tfi\n73\t\n74\t# ---- 日志函数 (自动带 [EventName] 前缀) ----\n75\tlog() {\n76\t  local level=\"$1\"\n77\t  shift\n78\t  local msg=\"$*\"\n79\t  echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [$level] [$HOOK_EVENT] $msg\" >> \"$LOG_FILE\"\n80\t}\n81\t\n82\t# 调试: 记录环境信息\n83\tlog \"DEBUG\" \"HOOKS_DIR=$HOOKS_DIR python=$_PY_CMD\"\n84\t\n85\tlog \"INFO\" \"Input: $HOOK_INPUT\"\n86\t\n87\t# ---- 输出钩子结果 JSON 到 stdout ----\n88\t# 用法: hook_output [exit_code] [json_string]\n89\thook_output() {\n90\t  local exit_code=\"${1:-0}\"\n91\t  local json=\"${2:-{}}\"\n92\t  log \"INFO\" \"Output (exit=$exit_code): $json\"\n93\t  echo \"$json\"\n94\t  exit \"$exit_code\"\n95\t}\n96\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\.claude\\hooks\\json_get.py"},"tool_use_id":"call_42f4e9b753024332bd2c6f85","tool_response":"1\t\"\"\"JSON field extractor for hook scripts.\n2\t\n3\tUsage: printf '<json>' | python json_get.py <key>\n4\t  e.g.: printf '<json>' | python json_get.py .hook_event_name\n5\t        printf '<json>' | python json_get.py .tool_name\n6\t\"\"\"\n7\timport sys\n8\timport json\n9\t\n10\tdata = json.load(sys.stdin)\n11\tkeys = sys.argv[1].lstrip(\".\").split(\".\")\n12\tv = data\n13\tfor k in keys:\n14\t    if isinstance(v, dict) and k in v:\n15\t        v = v[k]\n16\t    else:\n17\t        v = \"\"\n18\t        break\n19\tprint