Y_CMD\"","-","+log \"DEBUG\" \"os=$OS_TYPE python=$PYTHON_CMD\""," log \"INFO\" \"Input: $HOOK_INPUT\""," ","-# ---- 输出钩子结果 JSON 到 stdout ----","-# 用法: hook_output [exit_code] [json_string]"," hook_output() {","   local exit_code=\"${1:-0}\"","   local json=\"${2:-{}}\""]}],"originalFile":"#!/bin/bash\n# Hooks Base Script\n# 所有钩子脚本的公共基础，负责：\n# 1. 从 stdin 读取钩子事件 JSON\n# 2. 解析关键字段 (jq 优先，json_get.py 回退)\n# 3. 按日期写入日志，每行带官方事件名前缀\n# 4. 输出结果 JSON 到 stdout\n\n# 使用 CLAUDE_PROJECT_DIR 定位 hooks 目录（比 BASH_SOURCE 更可靠）\nHOOKS_DIR=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"\nLOG_DIR=\"$HOOKS_DIR/logs\"\nEMBED_PYTHON=\"$CLAUDE_PROJECT_DIR/.claude/python/python.exe\"\nmkdir -p \"$LOG_DIR\"\n\n# 读取 stdin 的 JSON 输入\nHOOK_INPUT=$(cat)\n\n# 按日期生成日志文件名\nLOG_FILE=\"$LOG_DIR/$(date +%Y-%m-%d).log\"\n\n# ---- 原始日志函数（事件名提取前使用）----\n_log_raw() {\n  local level=\"$1\"\n  shift\n  local msg=\"$*\"\n  echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $msg\" >> \"$LOG_FILE\"\n}\n\n# ---- JSON 解析 ----\n# 查找可用的 Python（优先嵌入版，跳过 Windows Store 占位符）\n_find_python() {\n  # 1. 优先使用 .claude/python/python.exe 自带环境\n  if [ -x \"$EMBED_PYTHON\" ]; then\n    echo \"$EMBED_PYTHON\"\n    return\n  fi\n  # 2. 回退到系统 Python（验证能真正运行）\n  for cmd in python python3 python.exe python3.exe; do\n    if command -v \"$cmd\" &>/dev/null; then\n      if \"$cmd\" -c \"pass\" 2>/dev/null; then\n        echo \"$cmd\"\n        return\n      fi\n    fi\n  done\n}\n\n_PY_CMD=\"\"\njson_get() {\n  local key=\"$1\"\n  if [ -z \"$HOOK_INPUT\" ]; then echo \"\"; return; fi\n  if command -v jq &>/dev/null; then\n    printf '%s' \"$HOOK_INPUT\" | jq -r \"$key\" 2>/dev/null\n    return\n  fi\n  if [ -z \"$_PY_CMD\" ]; then\n    _PY_CMD=$(_find_python)\n  fi\n  if [ -n \"$_PY_CMD\" ]; then\n    printf '%s' \"$HOOK_INPUT\" | \"$_PY_CMD\" \"$HOOKS_DIR/json_get.py\" \"$key\" 2>>\"$LOG_FILE\"\n  else\n    _log_raw \"WARN\" \"json_get: no jq or python found\"\n    echo \"\"\n  fi\n}\n\n# ---- 提取官方事件名 ----\nHOOK_EVENT=$(json_get '.hook_event_name')\n# 如果提取失败，标记为 UNKNOWN\nif [ -z \"$HOOK_EVENT\" ]; then\n  HOOK_EVENT=\"UNKNOWN\"\nfi\n\n# ---- 日志函数 (自动带 [EventName] 前缀) ----\nlog() {\n  local level=\"$1\"\n  shift\n  local msg=\"$*\"\n  echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [$level] [$HOOK_EVENT] $msg\" >> \"$LOG_FILE\"\n}\n\n# 调试: 记录环境信息\nlog \"DEBUG\" \"HOOKS_DIR=$HOOKS_DIR python=$_PY_CMD\"\n\nlog \"INFO\" \"Input: $HOOK_INPUT\"\n\n# ---- 输出钩子结果 JSON 到 stdout ----\n# 用法: hook_output [exit_code] [json_string]\nhook_output() {\n  local exit_code=\"${1:-0}\"\n  local json=\"${2:-{}}\"\n  log \"INFO\" \"Output (exit=$exit_code): $json\"\n  echo \"$json\"\n  exit \"$exit_code\"\n}\n","userModified":false},"tool_use_id":"call_2efad98340d34caabbf7c5eb","duration_ms":21}
