outer := api.NewRouter(api.Handlers{\n52\t\t\tIssue:  api.NewIssueHandler(issueSvc),\n53\t\t\tSession: api.NewSessionHandler(sessionSvc, issueSvc, service.NewTokenService(s.Sessions()), service.NewTraceService(s.Sessions())),\n54\t\t\tConfig: api.NewConfigHandler(configSvc),\n55\t\t})\n56\t\n57\t\tsrv := httptest.NewServer(router)\n58\t\tt.Cleanup(srv.Close)\n59\t\n60\t\treturn &configTestEnv{srv: srv}\n61\t}\n62\t\n63\t// getConfig 发送 GET /api/config 请求。\n64\tfunc (e *configTestEnv) getConfig(t *testing.T) *http.Response {\n65\t\tt.Helper()\n66\t\tresp, err := http.Get(e.srv.URL + \"/api/config\")\n67\t\tif err != nil {\n68\t\t\tt.Fatal(err)\n69\t\t}\n70\t\treturn resp\n71\t}\n72\t\n73\t// putConfig 发送 PUT /api/config 请求。\n74\tfunc (e *configTestEnv) putConfig(t *testing.T, body string) *http.Response {\n75\t\tt.Helper()\n76\t\tresp, err := http.NewRequest(http.MethodPut, e.srv.URL+\"/api/config\", strings.NewReader(body))\n77\t\tif err != nil {\n78\t\t\tt.Fatal(err)\n79\t\t}\n80\t\tresp.Header.Set(\"Content-Type\", \"application/json\")\n81\t\n82\t\t// 用 http.Client 发送\n83\t\tclient := &http.Client{}\n84\t\tr, err := client.Do(resp)\n85\t\tif err != nil {\n86\t\t\tt.Fatal(err)\n87\t\t}\n88\t\treturn r\n89\t}\n90\t\n91\t// readConfigJSON 读取 HTTP 响应并解析为 JSON。\n92\tfunc readConfigJSON(t *testing.T, resp *http.Response, v any) {\n93\t\tt.Helper()\n94\t\tdefer resp.Body.Close()\n95\t\tb, err := io.ReadAll(resp.Body)\n96\t\tif err != nil {\n97\t\t\tt.Fatal(err)\n98\t\t}\n99\t\tif err := json.Unmarshal(b, v); err != nil {\n100\t\t\tt.Fatalf(\"parse JSON: %v, body: %s\", err, b)\n101\t\t}\n102\t}\n103\t\n104\t// --- tests ---\n105\t\n106\t// TestConfig_GetDefaults 验证：GET 返回 5 个默认配置项。\n107\tfunc TestConfig_GetDefaults(t *testing.T) {\n108\t\tenv := setupConfigTest(t)\n109\t\n110\t\tresp := env.getConfig(t)\n111\t\n112\t\tvar result struct {\n113\t\t\tConfig map[string]interface{} `json:\"config\"`\n114\t\t}\n115\t\treadConfigJSON(t, resp, &result)\n116\t\n117\t\tif resp.StatusCode != http.StatusOK {\n118\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n119\t\t}\n120\t\n121\t\t// 验证 5 个默认配置项都存在\n122\t\texpectedKeys := []string{\"log_level\", \"session_timeout\", \"max_concurrent\", \"auto_claim\", \"default_model\"}\n123\t\tfor _, key := range expectedKeys {\n124\t\t\tif _, ok := result.Config[key]; !ok {\n125\t\t\t\tt.Errorf(\"expected config key %s to exist\", key)\n126\t\t\t}\n127\t\t}\n128\t\n129\t\t// 验证默认值\n130\t\tif result.Config[\"log_level\"] != \"info\" {\n131\t\t\tt.Errorf(\"expected log_level=info, got %v\", result.Config[\"log_level\"])\n132\t\t}\n133\t\tif result.Config[\"session_timeout\"].(float64) != 3600 {\n134\t\t\tt.Errorf(\"expected session_timeout=3600, got %v\", result.Config[\"session_timeout\"])\n135\t\t}\n136\t\tif result.Config[\"max_concurrent\"].(float64) != 10 {\n137\t\t\tt.Errorf(\"expected max_concurrent=10, got %v\", result.Config[\"max_concurrent\"])\n138\t\t}\n139\t\tif result.Config[\"auto_claim\"] != true {\n140\t\t\tt.Errorf(\"expected auto_claim=true, got %v\", result.Config[\"auto_claim\"])\n141\t\t}\n142\t\tif result.Config[\"default_model\"] != \"claude-3-opus\" {\n143\t\t\tt.Errorf(\"expected default_model=claude-3-opus, got %v\", result.Config[\"default_model\"])\n144\t\t}\n145\t}\n146\t\n147\t// TestConfig_UpdateSingleField 验证：PUT 更新单个配置项。\n148\tfunc TestConfig_UpdateSingleField(t *testing.T) {\n149\t\tenv := setupConfigTest(t)\n150\t\n151\t\tresp := env.putConfig(t, `{\"log_level\":\"debug\"}`)\n152\t\n153\t\tvar result struct {\n154\t\t\tConfig map[string]interface{} `json:\"config\"`\n155\t\t}\n156\t\treadConfigJSON(t, resp, &result)\n157\t\n158\t\tif resp.StatusCode != http.StatusOK {\n159\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n160\t\t}\n161\t\n162\t\tif result.Config[\"log_level\"] != \"debug\" {\n163\t\t\tt.Errorf(\"expected log_level=debug, got %v\", result.Config[\"log_level\"])\n164\t\t}\n165\t\n166\t\t// 其他配置项保持不变\n167\t\tif result.Config[\"session_time