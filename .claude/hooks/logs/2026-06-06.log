_DIR/task-complete-notify.sh\"\nfi\n\nhook_output 0 '{}'\n","numLines":44,"startLine":1,"totalLines":44}},"tool_use_id":"call_33ae2bdc04944bb98c7f0df3","duration_ms":1}
