[2026-06-06 13:14:17] [INFO] [PostToolBatch] Input: {"session_id":"ddd6a79e-7998-46d8-ad44-674e2fb35f8e","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\ddd6a79e-7998-46d8-ad44-674e2fb35f8e.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"default","agent_id":"a664c7f874a5d48b0","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/reverse.go"},"tool_use_id":"call_5f59437d744c4bc8b7502866","tool_response":"1\t// Package proxy 提供 HTTP 代理功能，包括请求转发、SSE 流式处理与 Trace 记录。\n2\tpackage proxy\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"compress/gzip\"\n7\t\t\"compress/zlib\"\n8\t\t\"encoding/json\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"net/http\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\t\"sync/atomic\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n19\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n20\t)\n21\t\n22\t// ReverseProxy 拦截 HTTP 请求并转发到上游 API，同时记录请求/响应到 JSONL Trace，并处理 SSE 流式响应。\n23\ttype ReverseProxy struct {\n24\t\ttarget             string              // 上游 API 目标地址\n25\t\tbaseDir            string              // Trace 文件存放的基础目录\n26\t\twriter             *trace.TraceWriter  // 当前会话的 Trace 写入器（由 _internal/trace-init 创建）\n27\t\tclient             *http.Client        // 转发请求的 HTTP 客户端\n28\t\tturn               atomic.Int64        // 请求计数器，用于标记 Turn 编号\n29\t\tserver             *http.Server        // 本地代理 HTTP 服务器\n30\t\tstartOnce          sync.Once           // 确保 Start 只执行一次\n31\t\tsessionID          string              // 当前会话 ID（由 trace-init 设置）\n32\t\tprojectSlug        string              // 当前项目标识（由 trace-init 设置）\n33\t\tOnSessionInit      func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\n34\t\tmodel              string              // 强制替换的模型名（空=不改写）\n35\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n36\t\tfallbackConfig     *FallbackConfig      // 兜底配置（上游不可用时切换）\n37\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfig 的并发安全\n38\t\tactualAddr         string              // 实际监听地址（启动后设置）\n39\t}\n40\t\n41\t// FallbackConfig 存储上游不可用时的兜底配置。\n42\ttype FallbackConfig struct {\n43\t\tBaseURL   string // 兜底上游 API 地址\n44\t\tModel     string // 兜底模型名\n45\t\tAuthToken string // 兜底认证 Token\n46\t\tAPIKey    string // 兜底 API Key\n47\t}\n48\t\n49\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n50\t// traceDir 为 Trace 文件存放的基础目录。\n51\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n52\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n53\t\treturn &ReverseProxy{\n54\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n55\t\t\tbaseDir:           traceDir,\n56\t\t\tupstreamAvailable: true,\n57\t\t\tclient: &http.Client{\n58\t\t\t\tTimeout: 0, // 流式场景不设超时\n59\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n60\t\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n61\t\t\t\t},\n62\t\t\t},\n63\t\t}\n64\t}\n65\t\n66\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n67\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n68\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n69\t\tmux := http.NewServeMux()\n70\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n71\t\tp.server = &http.Server{\n72\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n73\t\t\tHandler: mux,\n74\t\t}\n75\t\n76\t\tlistener, err := ioListener(p.server.Addr)\n77\t\tif err != nil {\n78\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n79\t\t}\n80\t\n81\t\t// 在后台 goroutine 中启动服务\n82\t\tgo func() {\n83\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n84\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n85\t\t\t}\n86\t\t}()\n87\t\n88\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n89\t\tp.actualAddr = fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n90\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n91\t\treturn actualPort, nil\n92\t}\n93\t\n94\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n95\tfunc (p *ReverseProxy) Stop() {\n96\t\tlogger.Info(\"proxy\", \"stopping\")\n97\t\tif p.writer != nil {\n98\t\t\tp.writer.Close()\n99\t\t}\n100\t\tif p.server != nil {\n101\t\t\t_ = p.server.Close()\n102\t\t}\n103\t}\n104\t\n105\t// URL 返回代理服务器的 HTTP 地址（如 http://127.0.0.1:8080）。\n106\tfunc (p *ReverseProxy) URL() string {\n107\t\treturn p.actualAddr\n108\t}\n109\t\n110\t// serveHTTP 是代理的核心 HTTP 处理函数。\n111\t// 处理流程：内部端点 → 路径白名单检查 → 读取请求体 → 构建上游请求 → 转发 → 流式/非流式处理。\n112\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n113\t\t// 处理内部端点（绕过路径白名单）\n114\t\tif strings.HasPrefix(r.URL.Path, \"/_internal/\") {\n115\t\t\tp.handleInternal(w, r)\n116\t\t\treturn\n117\t\t}\n118\t\n119\t\t// 拒绝未知路径\n120\t\tif !IsAllowedPath(r.URL.Path) {\n121\t\t\thttp.NotFound(w, r)\n122\t\t\treturn\n123\t\t}\n124\t\n125\t\t// 读取请求体\n126\t\tbodyBytes, err := io.ReadAll(r.Body)\n127\t\tif err != nil {\n128\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n129\t\t\treturn\n130\t\t}\n131\t\t_ = r.Body.Close()\n132\t\n133\t\t// 解析请求体为 JSON（用于后续提取 model、stream 等字段）\n134\t\tvar reqBody any\n135\t\tif len(bodyBytes) > 0 {\n136\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n137\t\t}\n138\t\n139\t\t// 请求体 model 改写（契约 3）\n140\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, p.model)\n141\t\n142\t\t// 重新解析改写后的请求体\n143\t\treqBody = nil\n144\t\tif len(bodyBytes) > 0 {\n145\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n146\t\t}\n147\t\n148\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n149\t\tbodyBytes = injectThinkingContent(bodyBytes, reqBody)\n150\t\treqBody = nil\n151\t\tif len(bodyBytes) > 0 {\n152\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n153\t\t}\n154\t\n155\t\t// 生成请求 ID 与 Turn 编号\n156\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n157\t\tturn := int(p.turn.Add(1))\n158\t\tt0 := time.Now()\n159\t\n160\t\tlogger.Debug(\"proxy\", \"[Turn %d] request: %s %s (%d bytes)\", turn, r.Method, r.URL.Path, len(bodyBytes))\n161\t\n162\t\t// 确定上游目标：检查是否需要走兜底配置（契约 4）\n163\t\tp.availableMu.Lock()\n164\t\tuseFallback := !p.upstreamAvailable && p.fallbackConfig != nil\n165\t\tactiveTarget := p.target\n166\t\tvar fallbackModel string\n167\t\tif useFallback {\n168\t\t\tactiveTarget = p.fallbackConfig.BaseURL\n169\t\t\tfallbackModel = p.fallbackConfig.Model\n170\t\t}\n171\t\tp.availableMu.Unlock()\n172\t\n173\t\t// 兜底模式下重新改写 model\n174\t\tif useFallback && fallbackModel != \"\" {\n175\t\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, fallbackModel)\n176\t\t\treqBody = nil\n177\t\t\tif len(bodyBytes) > 0 {\n178\t\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n179\t\t\t}\n180\t\n181\t\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n182\t\t\tbodyBytes = injectThinkingContent(bodyBytes, reqBody)\n183\t\t\treqBody = nil\n184\t\t\tif len(bodyBytes) > 0 {\n185\t\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n186\t\t\t}\n187\t\t}\n188\t\n189\t\t// 构建上游请求 URL\n190\t\tupstreamURL := activeTarget + r.URL.Path\n191\t\tif r.URL.RawQuery != \"\" {\n192\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n193\t\t}\n194\t\n195\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n196\t\tif err != nil {\n197\t\t\thttp.Error(w, \"create upstream request: \"+err.Error(), http.StatusBadGateway)\n198\t\t\treturn\n199\t\t}\n200\t\n201\t\t// 复制请求头，过滤逐跳头\n202\t\tfor k, vals := range r.Header {\n203\t\t\tlower := strings.ToLower(k)\n204\t\t\tif hopByHopHeaders[lower] {\n205\t\t\t\tcontinue\n206\t\t\t}\n207\t\t\tfor _, v := range vals {\n208\t\t\t\tupstreamReq.Header.Add(k, v)\n209\t\t\t}\n210\t\t}\n211\t\tupstreamReq.Header.Del(\"Host\")\n212\t\n213\t\t// 兜底模式下替换认证头\n214\t\tif useFallback && p.fallbackConfig != nil {\n215\t\t\tif p.fallbackConfig.APIKey != \"\" {\n216\t\t\t\tupstreamReq.Header.Set(\"x-api-key\", p.fallbackConfig.APIKey)\n217\t\t\t}\n218\t\t\tif p.fallbackConfig.AuthToken != \"\" {\n219\t\t\t\tupstreamReq.Header.Set(\"Authorization\", \"Bearer \"+p.fallbackConfig.AuthToken)\n220\t\t\t}\n221\t\t}\n222\t\n223\t\t// 向上游发送请求\n224\t\tupstreamResp, err := p.client.Do(upstreamReq)\n225\t\tif err != nil {\n226\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error: %v\", turn, err)\n227\t\t\tp.markUnavailable()\n228\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n229\t\t\treturn\n230\t\t}\n231\t\tdefer upstreamResp.Body.Close()\n232\t\n233\t\t// 响应错误（4xx/5xx）→ 标记上游不可用（契约 4）\n234\t\tif upstreamResp.StatusCode >= 400 {\n235\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error response: %d\", turn, upstreamResp.StatusCode)\n236\t\t\tp.markUnavailable()\n237\t\t}\n238\t\n239\t\tduration := time.Since(t0).Milliseconds()\n240\t\n241\t\t// 从请求体中提取 model 字段\n242\t\tmodel := \"\"\n243\t\tif m, ok := reqBody.(map[string]any); ok {\n244\t\t\tif v, ok := m[\"model\"].(string); ok {\n245\t\t\t\tmodel = v\n246\t\t\t}\n247\t\t}\n248\t\n249\t\t// 检测是否为流式请求\n250\t\tisStreaming := false\n251\t\tif m, ok := reqBody.(map[string]any); ok {\n252\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n253\t\t\t\tisStreaming = s\n254\t\t\t}\n255\t\t}\n256\t\n257\t\t// 根据是否流式分发到对应处理器\n258\t\tif isStreaming {\n259\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n260\t\t} else {\n261\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n262\t\t}\n263\t}\n264\t\n265\t// handleStreaming 处理 SSE 流式响应：\n266\t//   - 复制响应头并写入客户端\n267\t//   - 逐块读取上游响应体并实时转发给客户端\n268\t//   - 使用 SSE 重组器收集完整事件\n269\t//   - 将重组后的结果写入 Trace\n270\tfunc (p *ReverseProxy) handleStreaming(\n271\t\tw http.ResponseWriter,\n272\t\tupstreamResp *http.Response,\n273\t\treqID string, turn, durationMs int,\n274\t\tr *http.Request, reqBody any,\n275\t\tt0 time.Time, model string,\n276\t) {\n277\t\t// 复制响应头\n278\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n279\t\tfor k, vals := range respHeaders {\n280\t\t\tfor _, v := range vals {\n281\t\t\t\tw.Header().Add(k, v)\n282\t\t\t}\n283\t\t}\n284\t\tw.WriteHeader(upstreamResp.StatusCode)\n285\t\n286\t\tflusher, canFlush := w.(http.Flusher)\n287\t\treassembler := sse.NewSSEReassembler()\n288\t\n289\t\t// 逐块读取并转发流式数据\n290\t\tbuf := make([]byte, 32*1024)\n291\t\tfor {\n292\t\t\tn, err := upstreamResp.Body.Read(buf)\n293\t\t\tif n > 0 {\n294\t\t\t\t_, _ = w.Write(buf[:n])\n295\t\t\t\tif canFlush {\n296\t\t\t\t\tflusher.Flush()\n297\t\t\t\t}\n298\t\t\t\treassembler.FeedBytes(buf[:n])\n299\t\t\t}\n300\t\t\tif err != nil {\n301\t\t\t\tbreak\n302\t\t\t}\n303\t\t}\n304\t\n305\t\tdurationMs = int(time.Since(t0).Milliseconds())\n306\t\treconstructed := reassembler.Reconstruct()\n307\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n308\t\n309\t\t// 构建 Trace 记录\n310\t\trecord := buildRecord(\n311\t\t\treqID, turn, durationMs,\n312\t\t\tr.Method, r.URL.RequestURI(),\n313\t\t\tr.Header, reqBody,\n314\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n315\t\t\treconstructed,\n316\t\t\treassembler.Events,\n317\t\t\tp.target,\n318\t\t)\n319\t\n320\t\tif w := p.getWriter(); w != nil {\n321\t\t\tif err := w.Write(record); err != nil {\n322\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n323\t\t\t}\n324\t\t} else {\n325\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n326\t\t}\n327\t\n328\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n329\t}\n330\t\n331\t// handleNonStreaming 处理普通（非流式）响应：\n332\t//   - 读取完整响应体\n333\t//   - 按需解压（gzip / deflate）\n334\t//   - 解析 JSON 响应体\n335\t//   - 写入 Trace 并返回给客户端\n336\tfunc (p *ReverseProxy) handleNonStreaming(\n337\t\tw http.ResponseWriter,\n338\t\tupstreamResp *http.Response,\n339\t\treqID string, turn, durationMs int,\n340\t\tr *http.Request, reqBody any, model string,\n341\t) {\n342\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n343\t\tif err != nil {\n344\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n345\t\t\treturn\n346\t\t}\n347\t\n348\t\t// 按需解压响应体\n349\t\tdecodeBytes := respBytes\n350\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n351\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n352\t\t\tvar reader io.ReadCloser\n353\t\t\tif encoding == \"gzip\" {\n354\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n355\t\t\t} else {\n356\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n357\t\t\t}\n358\t\t\tif reader != nil {\n359\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n360\t\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n361\t\t\t\t\tdecodeBytes = decoded\n362\t\t\t\t}\n363\t\t\t\t_ = reader.Close()\n364\t\t\t}\n365\t\t}\n366\t\n367\t\t// 解析解压后的 JSON 响应体\n368\t\tvar respBody any\n369\t\tif len(decodeBytes) > 0 {\n370\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n371\t\t}\n372\t\n373\t\t// 构建 Trace 记录\n374\t\trecord := buildRecord(\n375\t\t\treqID, turn, durationMs,\n376\t\t\tr.Method, r.URL.RequestURI(),\n377\t\t\tr.Header, reqBody,\n378\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n379\t\t\trespBody,\n380\t\t\tnil,\n381\t\t\tp.target,\n382\t\t)\n383\t\n384\t\tif w := p.getWriter(); w != nil {\n385\t\t\tif err := w.Write(record); err != nil {\n386\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n387\t\t\t}\n388\t\t} else {\n389\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n390\t\t}\n391\t\n392\t\t// 将响应返回给客户端\n393\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n394\t\tfor k, vals := range respHeaders {\n395\t\t\tfor _, v := range vals {\n396\t\t\t\tw.Header().Add(k, v)\n397\t\t\t}\n398\t\t}\n399\t\tw.WriteHeader(upstreamResp.StatusCode)\n400\t\t_, _ = w.Write(respBytes)\n401\t\n402\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n403\t}\n404\t\n405\t// buildRecord 构建一条 Trace 记录，包含请求/响应的完整信息。\n406\tfunc buildRecord(\n407\t\treqID string, turn, durationMs int,\n408\t\tmethod, path string,\n409\t\treqHeaders http.Header, reqBody any,\n410\t\tstatus int, respHeaders http.Header,\n411\t\trespBody any,\n412\t\tsseEvents []map[string]any,\n413\t\tupstreamBaseURL string,\n414\t) map[string]any {\n415\t\trecord := map[string]any{\n416\t\t\t\"timestamp\":   time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n417\t\t\t\"request_id\":  reqID,\n418\t\t\t\"session_id\":  extractSessionID(reqBody),\n419\t\t\t\"turn\":        turn,\n420\t\t\t\"duration_ms\": durationMs,\n421\t\t\t\"request\": map[string]any{\n422\t\t\t\t\"method\":  method,\n423\t\t\t\t\"path\":    path,\n424\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n425\t\t\t\t\"body\":    reqBody,\n426\t\t\t},\n427\t\t\t\"response\": map[string]any{\n428\t\t\t\t\"status\":  status,\n429\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n430\t\t\t\t\"body\":    respBody,\n431\t\t\t},\n432\t\t}\n433\t\tif len(sseEvents) > 0 {\n434\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n435\t\t}\n436\t\tif upstreamBaseURL != \"\" {\n437\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n438\t\t}\n439\t\treturn record\n440\t}\n441\t\n442\t// extractSessionID 从请求体的 metadata.user_id 字段中提取 session_id。\n443\t// Claude Code 发送的格式为：metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n444\tfunc extractSessionID(reqBody any) string {\n445\t\tbody, ok := reqBody.(map[string]any)\n446\t\tif !ok {\n447\t\t\treturn \"\"\n448\t\t}\n449\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n450\t\tif metadata == nil {\n451\t\t\treturn \"\"\n452\t\t}\n453\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n454\t\tif userIDRaw == \"\" {\n455\t\t\treturn \"\"\n456\t\t}\n457\t\tvar userData map[string]string\n458\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n459\t\t\treturn \"\"\n460\t\t}\n461\t\treturn userData[\"session_id\"]\n462\t}\n463\t\n464\t// handleInternal 分发内部代理端点请求。\n465\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n466\t\tswitch r.URL.Path {\n467\t\tcase \"/_internal/trace-init\":\n468\t\t\tp.handleTraceInit(w, r)\n469\t\tdefault:\n470\t\t\thttp.NotFound(w, r)\n471\t\t}\n472\t}\n473\t\n474\t// handleTraceInit 接收 SessionStart 钩子传来的会话信息，创建 Trace 写入器。\n475\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n476\t\tif r.Method != http.MethodPost {\n477\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n478\t\t\treturn\n479\t\t}\n480\t\n481\t\tvar req struct {\n482\t\t\tSessionID      string `json:\"session_id\"`\n483\t\t\tMachineID      string `json:\"machine_id\"`\n484\t\t\tProjectSlug    string `json:\"project_slug\"`\n485\t\t\tTranscriptPath string `json:\"transcript_path\"`\n486\t\t}\n487\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n488\t\t\tlogger.Warn(\"proxy\", \"trace-init: invalid JSON: %v\", err)\n489\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n490\t\t\treturn\n491\t\t}\n492\t\n493\t\tif req.SessionID == \"\" {\n494\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n495\t\t\treturn\n496\t\t}\n497\t\n498\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n499\t\n500\t\t// 若请求中未提供，则通过 trace 包自动检测\n501\t\tmachineID := req.MachineID\n502\t\tif machineID == \"\" {\n503\t\t\tmachineID = trace.MachineID()\n504\t\t}\n505\t\n506\t\tprojectSlug := req.ProjectSlug\n507\t\tif projectSlug == \"\" {\n508\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n509\t\t\tif projectSlug == \"\" {\n510\t\t\t\tprojectSlug = trace.DetectProjectName()\n511\t\t\t}\n512\t\t}\n513\t\n514\t\t// 创建会话专属的 Trace 写入器\n515\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n516\t\twriter, err := trace.NewTraceWriter(tracePath)\n517\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n518\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n519\t\tif err != nil {\n520\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n521\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n522\t\t\treturn\n523\t\t}\n524\t\n525\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n526\t\t\tif p.writer != nil {\n527\t\t\t\tp.writer.Close()\n528\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n529\t\t\t}\n530\t\tp.writer = writer\n531\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n532\t\n533\t\t// 通知外部注册 proxy.json\n534\t\tif p.OnSessionInit != nil {\n535\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n536\t\t}\n537\t\n538\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n539\t\tjson.NewEncoder(w).Encode(map[string]string{\n540\t\t\t\"status\":     \"ok\",\n541\t\t\t\"trace_path\": tracePath,\n542\t\t})\n543\t}\n544\t\n545\t// getWriter 返回当前会话的 Trace 写入器。\n546\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n547\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n548\t\treturn p.writer\n549\t}\n550\t\n551\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n552\t// 若无有效写入器，返回零值统计。\n553\tfunc (p *ReverseProxy) Summary() map[string]any {\n554\t\tif w := p.getWriter(); w != nil {\n555\t\t\treturn w.Summary()\n556\t\t}\n557\t\treturn map[string]any{\n558\t\t\t\"api_calls\":           0,\n559\t\t\t\"input_tokens\":        int64(0),\n560\t\t\t\"output_tokens\":       int64(0),\n561\t\t\t\"cache_read_tokens\":   int64(0),\n562\t\t\t\"cache_create_tokens\": int64(0),\n563\t\t}\n564\t}\n565\t\n566\t// SessionID 返回当前会话的 session_id。\n567\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n568\tfunc (p *ReverseProxy) SessionID() string {\n569\t\tif p.sessionID != \"\" {\n570\t\t\treturn p.sessionID\n571\t\t}\n572\t\tif w := p.getWriter(); w != nil {\n573\t\t\treturn w.SessionID()\n574\t\t}\n575\t\treturn \"\"\n576\t}\n577\t\n578\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n579\tfunc (p *ReverseProxy) ProjectSlug() string {\n580\t\treturn p.projectSlug\n581\t}\n582\t\n583\t// TracePath 返回当前追踪文件的完整路径。\n584\tfunc (p *ReverseProxy) TracePath() string {\n585\t\tif w := p.getWriter(); w != nil {\n586\t\t\treturn w.Path()\n587\t\t}\n588\t\treturn \"\"\n589\t}\n590\t\n591\t// markUnavailable 标记上游不可用（契约 4）。\n592\t// 首次失败后置 upstreamAvailable = false，进程生命周期内不再恢复。\n593\tfunc (p *ReverseProxy) markUnavailable() {\n594\t\tp.availableMu.Lock()\n595\t\tdefer p.availableMu.Unlock()\n596\t\tif p.upstreamAvailable {\n597\t\t\tp.upstreamAvailable = false\n598\t\t\tlogger.Warn(\"proxy\", \"upstream marked unavailable, switching to fallback\")\n599\t\t}\n600\t}\n601\t\n602\t// SetModel 设置强制替换的模型名。\n603\tfunc (p *ReverseProxy) SetModel(model string) {\n604\t\tp.model = model\n605\t}\n606\t\n607\t// SetFallbackConfig 设置兜底配置。\n608\tfunc (p *ReverseProxy) SetFallbackConfig(cfg *FallbackConfig) {\n609\t\tp.fallbackConfig = cfg\n610\t}\n611\t\n612\t// rewriteModel 改写请求体 JSON 中的 model 字段（契约 3）。\n613\t// 如果 model 为空、body 为空、body 非 JSON 或 body 为 JSON 非对象，原样返回。\n614\tfunc rewriteModel(body []byte, parsed any, model string) []byte {\n615\t\tif model == \"\" || len(body) == 0 {\n616\t\t\treturn body\n617\t\t}\n618\t\n619\t\tm, ok := parsed.(map[string]any)\n620\t\tif !ok {\n621\t\t\treturn body // 非 JSON 或非对象\n622\t\t}\n623\t\n624\t\tm[\"model\"] = model\n625\t\trewritten, err := json.Marshal(m)\n626\t\tif err != nil {\n627\t\t\treturn body // 改写失败，原样返回\n628\t\t}\n629\t\treturn rewritten\n630\t}\n631\t\n632\t// injectThinkingContent 为 assistant tool_call 消息注入 reasoning_content 补丁。\n633\t//\n634\t// Kimi 等兼容 Anthropic 的端点要求：assistant tool_call 消息必须携带顶层字段 reasoning_content，\n635\t// 以及 content 数组中的 thinking 块。Claude Code 发送 tool_call 消息时不包含这些字段，导致上游 400 错误：\n636\t//\n637\t//\t400 thinking is enabled but reasoning_content is missing in assistant tool call message at index N\n638\t//\n639\t// 此函数对所有含 tool_use 的 assistant 消息无条件注入（空字符串无害，但能防止 Kimi 报错）。\n640\tfunc injectThinkingContent(body []byte, parsed any) []byte {\n641\t\tif len(body) == 0 {\n642\t\t\treturn body\n643\t\t}\n644\t\n645\t\tm, ok := parsed.(map[string]any)\n646\t\tif !ok {\n647\t\t\treturn body // 非 JSON 或非对象\n648\t\t}\n649\t\n650\t\t// 获取 messages 数组（无 messages 则无需处理）\n651\t\tmessages, ok := m[\"messages\"].([]any)\n652\t\tif !ok || len(messages) == 0 {\n653\t\t\treturn body\n654\t\t}\n655\t\n656\t\tmodified := false\n657\t\tfor i, msgRaw := range messages {\n658\t\t\tmsg, ok := msgRaw.(map[string]any)\n659\t\t\tif !ok {\n660\t\t\t\tcontinue\n661\t\t\t}\n662\t\n663\t\t\t// 只处理 assistant 消息\n664\t\t\trole, _ := msg[\"role\"].(string)\n665\t\t\tif role != \"assistant\" {\n666\t\t\t\tcontinue\n667\t\t\t}\n668\t\n669\t\t\t// 检查 content 是否为数组\n670\t\t\tcontent, ok := msg[\"content\"].([]any)\n671\t\t\tif !ok || len(content) == 0 {\n672\t\t\t\tcontinue\n673\t\t\t}\n674\t\n675\t\t\t// 检查是否有 tool_use 块、thinking 块、reasoning_content 字段\n676\t\t\thasToolUse := false\n677\t\t\thasThinking := false\n678\t\t\tfor _, blockRaw := range content {\n679\t\t\t\tblock, ok := blockRaw.(map[string]any)\n680\t\t\t\tif !ok {\n681\t\t\t\t\tcontinue\n682\t\t\t\t}\n683\t\t\t\tblockType, _ := block[\"type\"].(string)\n684\t\t\t\tif blockType == \"tool_use\" {\n685\t\t\t\t\thasToolUse = true\n686\t\t\t\t}\n687\t\t\t\tif blockType == \"thinking\" {\n688\t\t\t\t\thasThinking = true\n689\t\t\t\t}\n690\t\t\t}\n691\t\t\thasReasoningContent := false\n692\t\t\tif _, exists := msg[\"reasoning_content\"]; exists {\n693\t\t\t\thasReasoningContent = true\n694\t\t\t}\n695\t\n696\t\t\t// 只处理含 tool_use 且缺少必要字段的 assistant 消息\n697\t\t\tif !hasToolUse {\n698\t\t\t\tcontinue\n699\t\t\t}\n700\t\n701\t\t\tneedPatch := false\n702\t\n703\t\t\t// 补丁 1: content 数组缺少 thinking 块 → 在开头插入\n704\t\t\tif !hasThinking {\n705\t\t\t\tthinkingBlock := map[string]any{\n706\t\t\t\t\t\"type\":     \"thinking\",\n707\t\t\t\t\t\"thinking\": \"\",\n708\t\t\t\t}\n709\t\t\t\tnewContent := make([]any, 0, len(content)+1)\n710\t\t\t\tnewContent = append(newContent, thinkingBlock)\n711\t\t\t\tnewContent = append(newContent, content...)\n712\t\t\t\tmsg[\"content\"] = newContent\n713\t\t\t\tneedPatch = true\n714\t\t\t}\n715\t\n716\t\t\t// 补丁 2: 消息缺少顶层 reasoning_content 字段 → 注入空值\n717\t\t\tif !hasReasoningContent {\n718\t\t\t\tmsg[\"reasoning_content\"] = \"\"\n719\t\t\t\tneedPatch = true\n720\t\t\t}\n721\t\n722\t\t\tif needPatch {\n723\t\t\t\tmessages[i] = msg\n724\t\t\t\tmodified = true\n725\t\t\t}\n726\t\t}\n727\t\n728\t\tif !modified {\n729\t\t\treturn body\n730\t\t}\n731\t\n732\t\tm[\"messages\"] = messages\n733\t\trewritten, err := json.Marshal(m)\n734\t\tif err != nil {\n735\t\t\treturn body\n736\t\t}\n737\t\treturn rewritten\n738\t}\n739\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/config/resolve.go"},"tool_use_id":"call_8aae2d7a593a4fe4b0b7da41","tool_response":"1\tpackage config\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\n6\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n7\t)\n8\t\n9\t// ResolvedConfig 包含按优先级链解析后的最终配置。\n10\ttype ResolvedConfig struct {\n11\t\tBaseURL   string // 最终的上游 API 地址\n12\t\tAPIKey    string // 最终的 API Key（可能为空）\n13\t\tAuthToken string // 最终的 OAuth Token（可能为空）\n14\t\tModel     string // 最终的模型名（可能为空，空表示不做替换）\n15\t}\n16\t\n17\t// ResolveTargetConfig 按优先级解析最终的上游 API 配置。\n18\t//\n19\t// 优先级（从高到低）：\n20\t//\n21\t//\t1. cliBaseURL / cliAPIKey / cliAuthToken（命令行直接指定）\n22\t//\t2. profileName（读取 profiles.json）\n23\t//\t3. 环境变量（ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL）\n24\t//\t4. ~/.claude.json（Claude Code 配置文件）\n25\t//\t5. 默认值\n26\tfunc ResolveTargetConfig(cliBaseURL, cliAPIKey, cliAuthToken, profileName string, cfg *ClientConfig) (*ResolvedConfig, error) {\n27\t\tresult := &ResolvedConfig{}\n28\t\n29\t\t// Level 2: 从 profiles.json 读取配置\n30\t\tif profileName != \"\" {\n31\t\t\tp, err := ResolveProfileConfig(profileName)\n32\t\t\tif err != nil {\n33\t\t\t\tlogger.Warn(\"config\", \"profile resolution failed: %v\", err)\n34\t\t\t} else {\n35\t\t\t\tresult.BaseURL = p.BaseURL\n36\t\t\t\tresult.APIKey = p.APIKey\n37\t\t\t\tresult.AuthToken = p.AuthToken\n38\t\t\t\tresult.Model = p.Model\n39\t\t\t}\n40\t\t}\n41\t\n42\t\t// Level 1: 命令行直接指定，覆盖 profile 值\n43\t\tif cliBaseURL != \"\" {\n44\t\t\tresult.BaseURL = cliBaseURL\n45\t\t}\n46\t\tif cliAPIKey != \"\" {\n47\t\t\tresult.APIKey = cliAPIKey\n48\t\t}\n49\t\tif cliAuthToken != \"\" {\n50\t\t\tresult.AuthToken = cliAuthToken\n51\t\t}\n52\t\n53\t\t// Level 3: 环境变量（仅在仍为空时）\n54\t\tif result.BaseURL == \"\" {\n55\t\t\tif env := os.Getenv(cfg.BaseURLEnv); env != \"\" {\n56\t\t\t\tresult.BaseURL = env\n57\t\t\t\tlogger.Debug(\"config\", \"base_url from env %s\", cfg.BaseURLEnv)\n58\t\t\t}\n59\t\t}\n60\t\tif result.APIKey == \"\" && result.AuthToken == \"\" {\n61\t\t\tif env := os.Getenv(\"ANTHROPIC_API_KEY\"); env != \"\" {\n62\t\t\t\tresult.APIKey = env\n63\t\t\t\tlogger.Debug(\"config\", \"api_key from env ANTHROPIC_API_KEY\")\n64\t\t\t}\n65\t\t\tif env := os.Getenv(\"ANTHROPIC_AUTH_TOKEN\"); env != \"\" {\n66\t\t\t\tresult.AuthToken = env\n67\t\t\t\tlogger.Debug(\"config\", \"auth_token from env ANTHROPIC_AUTH_TOKEN\")\n68\t\t\t}\n69\t\t}\n70\t\n71\t\t// Level 4: ~/.claude.json（仅在 base_url 或 model 仍为空时）\n72\t\tif cfg == &ClaudeClient {\n73\t\t\tcc, err := ReadClaudeConfig()\n74\t\t\tif err == nil && cc != nil {\n75\t\t\t\tif result.BaseURL == \"\" {\n76\t\t\t\t\tif url := ClaudeBaseURLFromConfig(cc); url != \"\" {\n77\t\t\t\t\t\tresult.BaseURL = url\n78\t\t\t\t\t\tlogger.Debug(\"config\", \"base_url from ~/.claude.json\")\n79\t\t\t\t\t}\n80\t\t\t\t}\n81\t\t\t\t// model 优先级：profile model > ~/.claude.json model > 空\n82\t\t\t\tif result.Model == \"\" && cc.Model != \"\" {\n83\t\t\t\t\tresult.Model = cc.Model\n84\t\t\t\t\tlogger.Debug(\"config\", \"model from ~/.claude.json\")\n85\t\t\t\t}\n86\t\t\t}\n87\t\t}\n88\t\n89\t\t// Level 5: 默认值\n90\t\tif result.BaseURL == \"\" {\n91\t\t\tresult.BaseURL = cfg.DefaultTarget\n92\t\t}\n93\t\n94\t\tauthType := \"none\"\n95\t\tif result.APIKey != \"\" {\n96\t\t\tauthType = \"api_key\"\n97\t\t} else if result.AuthToken != \"\" {\n98\t\t\tauthType = \"auth_token\"\n99\t\t}\n100\t\tlogger.Info(\"config\", \"resolved: base_url=%s auth=%s model=%s\", result.BaseURL, authType, result.Model)\n101\t\treturn result, nil\n102\t}\n103\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/config/profiles.go"},"tool_use_id":"call_0dfda3e5fc81453e9d954de3","tool_response":"1\tpackage config\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"fmt\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t)\n11\t\n12\t// ProfileConfig 表示 profiles.json 中单个配置的定义。\n13\ttype ProfileConfig struct {\n14\t\tBaseURL   string `json:\"base_url\"`              // 上游 API 地址\n15\t\tAPIKey    string `json:\"api_key\"`               // API 密钥\n16\t\tAuthToken string `json:\"auth_token,omitempty\"`  // OAuth Token\n17\t\tProvider  string `json:\"provider,omitempty\"`    // 供应商标识（anthropic/openai/gemini）\n18\t\tModel     string `json:\"model,omitempty\"`       // 强制替换的模型名\n19\t}\n20\t\n21\t// ProfilesFile 表示 profiles.json 的完整结构。\n22\ttype ProfilesFile struct {\n23\t\tDefault  string                   `json:\"default\"`  // 默认配置名\n24\t\tProfiles map[string]ProfileConfig `json:\"profiles\"` // 配置集合\n25\t}\n26\t\n27\t// ConfigDir 返回 claude-tap-plus 的配置根目录（~/.claude-tap-plus/）。\n28\tfunc ConfigDir() string {\n29\t\treturn filepath.Join(HomeDir(), \".claude-tap-plus\")\n30\t}\n31\t\n32\t// profilesPath 返回 profiles.json 的完整路径。\n33\tfunc profilesPath() string {\n34\t\treturn filepath.Join(ConfigDir(), \"profiles.json\")\n35\t}\n36\t\n37\t// ReadProfiles 读取并解析 ~/.claude-tap-plus/profiles.json。\n38\t// 如果文件不存在，返回 nil 且不报错（非致命）。\n39\tfunc ReadProfiles() (*ProfilesFile, error) {\n40\t\tpath := profilesPath()\n41\t\tlogger.Debug(\"config\", \"reading profiles: %s\", path)\n42\t\n43\t\tdata, err := os.ReadFile(path)\n44\t\tif err != nil {\n45\t\t\tif os.IsNotExist(err) {\n46\t\t\t\tlogger.Debug(\"config\", \"profiles.json not found\")\n47\t\t\t\treturn nil, nil\n48\t\t\t}\n49\t\t\treturn nil, fmt.Errorf(\"read profiles: %w\", err)\n50\t\t}\n51\t\n52\t\tvar pf ProfilesFile\n53\t\tif err := json.Unmarshal(data, &pf); err != nil {\n54\t\t\treturn nil, fmt.Errorf(\"parse profiles: %w\", err)\n55\t\t}\n56\t\n57\t\tlogger.Debug(\"config\", \"profiles loaded: default=%s count=%d\", pf.Default, len(pf.Profiles))\n58\t\treturn &pf, nil\n59\t}\n60\t\n61\t// ResolveProfileConfig 解析指定名称的配置。\n62\t// 如果 name 为空，使用 profiles.json 中的 default 字段。\n63\t// 如果 name 非空但未找到对应配置，返回错误。\n64\tfunc ResolveProfileConfig(name string) (*ProfileConfig, error) {\n65\t\tpf, err := ReadProfiles()\n66\t\tif err != nil {\n67\t\t\treturn nil, err\n68\t\t}\n69\t\tif pf == nil {\n70\t\t\treturn nil, fmt.Errorf(\"profiles.json not found\")\n71\t\t}\n72\t\n73\t\t// 使用默认配置名\n74\t\tif name == \"\" {\n75\t\t\tname = pf.Default\n76\t\t}\n77\t\tif name == \"\" {\n78\t\t\treturn nil, fmt.Errorf(\"no profile name specified and no default configured\")\n79\t\t}\n80\t\n81\t\tp, ok := pf.Profiles[name]\n82\t\tif !ok {\n83\t\t\treturn nil, fmt.Errorf(\"profile %q not found in profiles.json\", name)\n84\t\t}\n85\t\n86\t\tlogger.Info(\"config\", \"resolved profile: %s (base_url=%s)\", name, p.BaseURL)\n87\t\treturn &p, nil\n88\t}\n89\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/model_rewrite_test.go"},"tool_use_id":"call_ba117667ea6a4bbda2f7db0d","tool_response":"1\tpackage proxy\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"net/http/httptest\"\n9\t\t\"testing\"\n10\t)\n11\t\n12\t// TestRequestBodyRewrite_Model 测试请求体 model 字段改写规则\n13\t// 来源：契约 3 — 请求体改写规则\n14\tfunc TestRequestBodyRewrite_Model(t *testing.T) {\n15\t\ttests := []struct {\n16\t\t\tname        string\n17\t\t\tmodel       string // proxy 配置的 model（空=不改写）\n18\t\t\treqBody     string // 原始请求体\n19\t\t\twantModel   string // 期望上游收到的 model 值（空=不改写，用原始值）\n20\t\t\treqMethod   string\n21\t\t\treqPath     string\n22\t\t}{\n23\t\t\t// 1.1-P1: 强制覆盖请求中的模型\n24\t\t\t{\n25\t\t\t\tname:      \"1.1-P1 force override existing model\",\n26\t\t\t\tmodel:     \"glm-5.1\",\n27\t\t\t\treqBody:   `{\"model\":\"claude-sonnet-4-6\",\"stream\":true}`,\n28\t\t\t\twantModel: \"glm-5.1\",\n29\t\t\t\treqMethod: \"POST\",\n30\t\t\t\treqPath:   \"/v1/messages\",\n31\t\t\t},\n32\t\t\t// 1.2-P1: 注入不存在的 model 字段\n33\t\t\t{\n34\t\t\t\tname:      \"1.2-P1 inject model when missing\",\n35\t\t\t\tmodel:     \"glm-5.1\",\n36\t\t\t\treqBody:   `{\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}`,\n37\t\t\t\twantModel: \"glm-5.1\",\n38\t\t\t\treqMethod: \"POST\",\n39\t\t\t\treqPath:   \"/v1/messages\",\n40\t\t\t},\n41\t\t\t// 1.3-E1: model 相同，幂等替换\n42\t\t\t{\n43\t\t\t\tname:      \"1.3-E1 idempotent when model same\",\n44\t\t\t\tmodel:     \"glm-5.1\",\n45\t\t\t\treqBody:   `{\"model\":\"glm-5.1\",\"stream\":false}`,\n46\t\t\t\twantModel: \"glm-5.1\",\n47\t\t\t\treqMethod: \"POST\",\n48\t\t\t\treqPath:   \"/v1/messages\",\n49\t\t\t},\n50\t\t\t// 3.1-P1: model 为空，原样透传\n51\t\t\t{\n52\t\t\t\tname:      \"3.1-P1 no model config - pass through\",\n53\t\t\t\tmodel:     \"\",\n54\t\t\t\treqBody:   `{\"model\":\"claude-opus-4-8\",\"stream\":true}`,\n55\t\t\t\twantModel: \"claude-opus-4-8\",\n56\t\t\t\treqMethod: \"POST\",\n57\t\t\t\treqPath:   \"/v1/messages\",\n58\t\t\t},\n59\t\t\t// 4.1-E1: 空请求体\n60\t\t\t{\n61\t\t\t\tname:      \"4.1-E1 empty body - skip rewrite\",\n62\t\t\t\tmodel:     \"glm-5.1\",\n63\t\t\t\treqBody:   \"\",\n64\t\t\t\twantModel: \"\",\n65\t\t\t\treqMethod: \"GET\",\n66\t\t\t\treqPath:   \"/v1/models\",\n67\t\t\t},\n68\t\t\t// 4.2-E1: 非 JSON 请求体\n69\t\t\t{\n70\t\t\t\tname:      \"4.2-E1 non-JSON body - skip rewrite\",\n71\t\t\t\tmodel:     \"glm-5.1\",\n72\t\t\t\treqBody:   \"this is not json\",\n73\t\t\t\twantModel: \"\",\n74\t\t\t\treqMethod: \"POST\",\n75\t\t\t\treqPath:   \"/v1/messages\",\n76\t\t\t},\n77\t\t\t// X2: JSON 数组请求体\n78\t\t\t{\n79\t\t\t\tname:      \"X2 JSON array body - skip rewrite\",\n80\t\t\t\tmodel:     \"glm-5.1\",\n81\t\t\t\treqBody:   `[1,2,3]`,\n82\t\t\t\twantModel: \"\",\n83\t\t\t\treqMethod: \"POST\",\n84\t\t\t\treqPath:   \"/v1/messages\",\n85\t\t\t},\n86\t\t\t// X3: model 字段非字符串\n87\t\t\t{\n88\t\t\t\tname:      \"X3 model is number - force override to string\",\n89\t\t\t\tmodel:     \"glm-5.1\",\n90\t\t\t\treqBody:   `{\"model\":123,\"stream\":true}`,\n91\t\t\t\twantModel: \"glm-5.1\",\n92\t\t\t\treqMethod: \"POST\",\n93\t\t\t\treqPath:   \"/v1/messages\",\n94\t\t\t},\n95\t\t}\n96\t\n97\t\tfor _, tt := range tests {\n98\t\t\tt.Run(tt.name, func(t *testing.T) {\n99\t\t\t\t// 创建 mock 上游服务器，捕获收到的请求体\n100\t\t\t\tvar capturedBody []byte\n101\t\t\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n102\t\t\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n103\t\t\t\t\t// 返回简单响应\n104\t\t\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n105\t\t\t\t\tw.WriteHeader(http.StatusOK)\n106\t\t\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n107\t\t\t\t}))\n108\t\t\t\tdefer mockUpstream.Close()\n109\t\n110\t\t\t\t// 创建代理，传入 model 配置\n111\t\t\t\ttraceDir := t.TempDir()\n112\t\t\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n113\t\t\t\trp.model = tt.model\n114\t\n115\t\t\t\t// 启动代理\n116\t\t\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n117\t\t\t\tif err != nil {\n118\t\t\t\t\tt.Fatalf(\"start proxy: %v\", err)\n119\t\t\t\t}\n120\t\t\t\tdefer rp.Stop()\n121\t\n122\t\t\t\t// 通过代理发送请求\n123\t\t\t\tproxyURL := rp.URL()\n124\t\t\t\tvar body io.Reader\n125\t\t\t\tif tt.reqBody != \"\" {\n126\t\t\t\t\tbody = bytes.NewReader([]byte(tt.reqBody))\n127\t\t\t\t}\n128\t\t\t\treq, err := http.NewRequest(tt.reqMethod, proxyURL+tt.reqPath, body)\n129\t\t\t\tif err != nil {\n130\t\t\t\t\tt.Fatalf(\"create request: %v\", err)\n131\t\t\t\t}\n132\t\t\t\tif tt.reqBody != \"\" {\n133\t\t\t\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n134\t\t\t\t}\n135\t\n136\t\t\t\tresp, err := http.DefaultClient.Do(req)\n137\t\t\t\tif err != nil {\n138\t\t\t\t\tt.Fatalf(\"send request: %v\", err)\n139\t\t\t\t}\n140\t\t\t\tresp.Body.Close()\n141\t\n142\t\t\t\t// 验证上游收到的 model\n143\t\t\t\tif tt.wantModel == \"\" && len(capturedBody) == 0 {\n144\t\t\t\t\treturn // 空 body 场景，无需验证 model\n145\t\t\t\t}\n146\t\t\t\tif len(capturedBody) == 0 {\n147\t\t\t\t\tt.Fatal(\"upstream received empty body\")\n148\t\t\t\t}\n149\t\n150\t\t\t\tvar upstreamBody map[string]any\n151\t\t\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n152\t\t\t\t\t// 非 JSON body（如 4.2-E1），验证原样透传\n153\t\t\t\t\tif string(capturedBody) != tt.reqBody {\n154\t\t\t\t\t\tt.Errorf(\"non-JSON body changed: got %q, want %q\", string(capturedBody), tt.reqBody)\n155\t\t\t\t\t}\n156\t\t\t\t\treturn\n157\t\t\t\t}\n158\t\n159\t\t\t\tif tt.wantModel != \"\" {\n160\t\t\t\t\tgotModel, _ := upstreamBody[\"model\"].(string)\n161\t\t\t\t\tif gotModel != tt.wantModel {\n162\t\t\t\t\t\tt.Errorf(\"upstream model = %q, want %q\", gotModel, tt.wantModel)\n163\t\t\t\t\t}\n164\t\t\t\t}\n165\t\t\t})\n166\t\t}\n167\t}\n168\t\n169\t// TestRequestBodyRewrite_OtherFieldsUnchanged 测试改写 model 时其他字段不变\n170\t// 来源：契约 3 — 只改 model，不动其他字段\n171\tfunc TestRequestBodyRewrite_OtherFieldsUnchanged(t *testing.T) {\n172\t\tvar capturedBody []byte\n173\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n174\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n175\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n176\t\t\tw.WriteHeader(http.StatusOK)\n177\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n178\t\t}))\n179\t\tdefer mockUpstream.Close()\n180\t\n181\t\ttraceDir := t.TempDir()\n182\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n183\t\trp.model = \"glm-5.1\"\n184\t\n185\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n186\t\tif err != nil {\n187\t\t\tt.Fatalf(\"start proxy: %v\", err)\n188\t\t}\n189\t\tdefer rp.Stop()\n190\t\n191\t\t// 发送包含多个字段的请求\n192\t\torigBody := map[string]any{\n193\t\t\t\"model\":      \"claude-sonnet-4-6\",\n194\t\t\t\"stream\":     true,\n195\t\t\t\"max_tokens\": 4096,\n196\t\t\t\"messages\":   []map[string]string{{\"role\": \"user\", \"content\": \"hello\"}},\n197\t\t}\n198\t\tbodyBytes, _ := json.Marshal(origBody)\n199\t\n200\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n201\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n202\t\n203\t\tresp, err := http.DefaultClient.Do(req)\n204\t\tif err != nil {\n205\t\t\tt.Fatalf(\"send request: %v\", err)\n206\t\t}\n207\t\tresp.Body.Close()\n208\t\n209\t\t// 验证上游收到的完整请求体\n210\t\tvar upstreamBody map[string]any\n211\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n212\t\t\tt.Fatalf(\"parse upstream body: %v\", err)\n213\t\t}\n214\t\n215\t\t// model 被替换\n216\t\tif m, _ := upstreamBody[\"model\"].(string); m != \"glm-5.1\" {\n217\t\t\tt.Errorf(\"model = %q, want %q\", m, \"glm-5.1\")\n218\t\t}\n219\t\t// stream 不变\n220\t\tif s, _ := upstreamBody[\"stream\"].(bool); s != true {\n221\t\t\tt.Errorf(\"stream = %v, want true\", s)\n222\t\t}\n223\t\t// max_tokens 不变\n224\t\tif mt, ok := upstreamBody[\"max_tokens\"].(float64); !ok || mt != 4096 {\n225\t\t\tt.Errorf(\"max_tokens = %v, want 4096\", upstreamBody[\"max_tokens\"])\n226\t\t}\n227\t\t// messages 不变\n228\t\tmsgs, ok := upstreamBody[\"messages\"].([]any)\n229\t\tif !ok || len(msgs) != 1 {\n230\t\t\tt.Errorf(\"messages length = %v, want 1\", len(msgs))\n231\t\t}\n232\t}\n233\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/cmd/claude-tap/main.go"},"tool_use_id":"call_73c09c6003854205bfd03467","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"log\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"os/signal\"\n9\t\t\"strings\"\n10\t\t\"syscall\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/config\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/proxy\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/session\"\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n18\t)\n19\t\n20\t// main 是 claude-tap-plus 的入口函数，负责解析子命令并分发到对应处理函数。\n21\t//\n22\t// 支持的子命令：\n23\t//   session-push    收集本地 Claude 会话到存储\n24\t//   session-pull    从存储恢复会话到 ~/.claude/\n25\t//   session-status  显示会话存储状态\n26\t//   backend         启动后端服务器模式\n27\t//   help            显示使用帮助\n28\t//\n29\t// 无子命令时默认进入代理模式（拦截 Claude Code API 流量）。\n30\tfunc main() {\n31\t\t// 设置日志格式：仅显示时间（含微秒）\n32\t\tlog.SetFlags(log.Ltime | log.Lmicroseconds)\n33\t\n34\t\t// 初始化文件日志器（使用默认 trace 目录）\n35\t\tlogDir := trace.DefaultTraceDir()\n36\t\tif err := logger.Init(logDir, false, logger.INFO); err != nil {\n37\t\t\tlog.Printf(\"warning: logger init failed: %v\", err)\n38\t\t}\n39\t\tdefer logger.Close()\n40\t\n41\t\t// 检测子命令，如果第一个参数是已知子命令则分发执行\n42\t\tif len(os.Args) > 1 {\n43\t\t\tswitch os.Args[1] {\n44\t\t\tcase \"session-push\":\n45\t\t\t\trunSessionPush(os.Args[2:])\n46\t\t\t\treturn\n47\t\t\tcase \"session-pull\":\n48\t\t\t\trunSessionPull(os.Args[2:])\n49\t\t\t\treturn\n50\t\t\tcase \"session-status\":\n51\t\t\t\trunSessionStatus(os.Args[2:])\n52\t\t\t\treturn\n53\t\t\tcase \"backend\":\n54\t\t\t\trunBackend(os.Args[2:])\n55\t\t\t\treturn\n56\t\t\tcase \"help\", \"--help\", \"-h\":\n57\t\t\t\tprintUsage()\n58\t\t\t\treturn\n59\t\t\t}\n60\t\t}\n61\t\n62\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n63\t\trunProxy(os.Args[1:])\n64\t}\n65\t\n66\t// printUsage 打印命令行使用帮助信息到标准输出。\n67\tfunc printUsage() {\n68\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n69\t\tfmt.Println()\n70\t\tfmt.Println(\"Usage:\")\n71\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n72\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n73\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n74\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n75\t\tfmt.Println()\n76\t\tfmt.Println(\"Proxy flags:\")\n77\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n78\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n79\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n80\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n81\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n82\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n83\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n84\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n85\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n86\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n87\t\tfmt.Println()\n88\t\tfmt.Println(\"Session-push flags:\")\n89\t\tfmt.Println(\"  --all                  Collect all projects\")\n90\t\tfmt.Println(\"  --force                Overwrite existing files\")\n91\t\tfmt.Println(\"  --dry-run              Preview only\")\n92\t\tfmt.Println(\"  --project NAME         Override project name\")\n93\t\tfmt.Println()\n94\t\tfmt.Println(\"Session-pull flags:\")\n95\t\tfmt.Println(\"  --all                  Restore all projects\")\n96\t\tfmt.Println(\"  --project NAME         Override project name\")\n97\t\tfmt.Println(\"  --dry-run              Preview only\")\n98\t\tfmt.Println()\n99\t\tfmt.Println(\"Session-status flags:\")\n100\t\tfmt.Println(\"  --verbose              Show file-level details\")\n101\t}\n102\t\n103\t// runProxy 是默认的代理模式主逻辑。\n104\t//\n105\t// 工作流程：\n106\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n107\t//  2. 自动探测上游 API 目标地址\n108\t//  3. 启动本地反向代理监听指定端口\n109\t//  4. 解析 Claude Code 可执行文件路径\n110\t//  5. 构建子进程环境变量（注入代理地址）\n111\t//  6. 启动 Claude Code 作为子进程\n112\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n113\t//  8. 子进程退出后打印 API 调用统计摘要\n114\tfunc runProxy(args []string) {\n115\t\t// 记录原始命令行参数，用于生成 resume 命令\n116\t\toriginalArgs := append([]string{}, args...)\n117\t\n118\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n119\t\tvar (\n120\t\t\ttapTarget    string // 上游 API 目标地址\n121\t\t\ttapPort      int    // 本地代理监听端口\n122\t\t\ttapOutputDir string // 追踪记录输出目录\n123\t\t\ttapVerbose   bool   // 是否启用详细日志\n124\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n125\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n126\t\t\ttapAPIKey    string // 直接传入 API Key\n127\t\t\ttapAuthToken string // 直接传入 OAuth Token\n128\t\t\ttapBaseURL   string // 直接传入上游地址\n129\t\t)\n130\t\n131\t\tvar claudeArgs []string\n132\t\tfor i := 0; i < len(args); i++ {\n133\t\t\targ := args[i]\n134\t\t\tswitch {\n135\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n136\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n137\t\t\t\ti++\n138\t\t\t\ttapTarget = args[i]\n139\t\t\t// 解析 --tap-target=URL 形式\n140\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n141\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n142\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n143\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n144\t\t\t\ti++\n145\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n146\t\t\t// 解析 --tap-port=PORT 形式\n147\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n148\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n149\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n150\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n151\t\t\t\ti++\n152\t\t\t\ttapOutputDir = args[i]\n153\t\t\t// 解析 --tap-output-dir=DIR 形式\n154\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n155\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n156\t\t\t// 启用详细日志\n157\t\t\tcase arg == \"--tap-verbose\":\n158\t\t\t\ttapVerbose = true\n159\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n160\t\t\tcase arg == \"--tap-console\":\n161\t\t\t\ttapConsole = true\n162\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n163\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n164\t\t\t\ti++\n165\t\t\t\ttapProfile = args[i]\n166\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n167\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n168\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n169\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n170\t\t\t\ti++\n171\t\t\t\ttapAPIKey = args[i]\n172\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n173\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n174\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n175\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n176\t\t\t\ti++\n177\t\t\t\ttapAuthToken = args[i]\n178\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n179\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n180\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n181\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n182\t\t\t\ti++\n183\t\t\t\ttapBaseURL = args[i]\n184\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n185\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n186\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n187\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n188\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n189\t\t\t\ti = len(args) // 停止解析\n190\t\t\t// 未知的 --tap-* 标志，直接忽略\n191\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n192\t\t\t// 其他参数视为 Claude Code 的参数\n193\t\t\tdefault:\n194\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n195\t\t\t}\n196\t\t}\n197\t\n198\t\t// 如果未指定输出目录，使用默认追踪目录\n199\t\tif tapOutputDir == \"\" {\n200\t\t\ttapOutputDir = trace.DefaultTraceDir()\n201\t\t}\n202\t\n203\t\t// 校验：--tap-console 必须配合 --tap-verbose\n204\t\tif tapConsole && !tapVerbose {\n205\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n206\t\t\tos.Exit(1)\n207\t\t}\n208\t\n209\t\t// 根据详细程度重新初始化日志器\n210\t\tif tapVerbose {\n211\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n212\t\t} else {\n213\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n214\t\t}\n215\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n216\t\n217\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n218\t\tresolved, err := config.ResolveTargetConfig(\n219\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n220\t\t\ttapAPIKey,\n221\t\t\ttapAuthToken,\n222\t\t\ttapProfile,\n223\t\t\t&config.ClaudeClient,\n224\t\t)\n225\t\tif err != nil {\n226\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n227\t\t}\n228\t\ttarget := resolved.BaseURL\n229\t\tif tapVerbose {\n230\t\t\tlog.Printf(\"upstream target: %s\", target)\n231\t\t}\n232\t\n233\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n234\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n235\t\n236\t\t// 设置 model 改写（契约 2：resolved.Model 优先级链）\n237\t\trp.SetModel(resolved.Model)\n238\t\n239\t\t// 加载兜底配置（契约 4：从 Claude settings 读取）\n240\t\tif fallback := loadFallbackConfig(); fallback != nil {\n241\t\t\trp.SetFallbackConfig(fallback)\n242\t\t}\n243\t\n244\t\tport := tapPort\n245\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n246\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n247\t\tif err != nil {\n248\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n249\t\t}\n250\t\t// 函数退出时停止代理\n251\t\tdefer rp.Stop()\n252\t\n253\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n254\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n255\t\n256\t\t// 自动检测并启动后端服务（如果未运行）\n257\t\tensureBackend()\n258\t\n259\t\t// 向后端注册本代理（hooks 通过后端转发 trace-init）\n260\t\tregisterProxyWithBackend(proxyURL)\n261\t\t// 代理退出时注销\n262\t\tdefer unregisterProxyFromBackend()\n263\t\n264\t\t// 设置会话初始化回调：注册到 proxy.json\n265\t\trp.OnSessionInit = func(sessionID, projectSlug string) {\n266\t\t\tkey := ProxySessionKey(projectSlug, sessionID)\n267\t\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\n268\t\t\t\tlogger.Warn(\"main\", \"register proxy session failed: %v\", err)\n269\t\t\t}\n270\t\t}\n271\t\t// 代理退出时注销 proxy.json 中的会话\n272\t\tdefer func() {\n273\t\t\tif sid := rp.SessionID(); sid != \"\" {\n274\t\t\t\tslug := rp.ProjectSlug()\n275\t\t\t\tkey := ProxySessionKey(slug, sid)\n276\t\t\t\tif err := UnregisterProxySession(key); err != nil {\n277\t\t\t\t\tlogger.Warn(\"main\", \"unregister proxy session failed: %v\", err)\n278\t\t\t\t}\n279\t\t\t}\n280\t\t}()\n281\t\n282\t\t// 解析 Claude Code 可执行文件路径\n283\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n284\t\tif err != nil {\n285\t\t\tlog.Fatal(err)\n286\t\t}\n287\t\n288\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n289\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n290\t\n291\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n292\t\tif resolved.APIKey != \"\" {\n293\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n294\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n295\t\t} else if resolved.AuthToken != \"\" {\n296\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n297\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n298\t\t}\n299\t\n300\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n301\t\tfinalArgs := claudeArgs\n302\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n303\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n304\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n305\t\t}\n306\t\n307\t\t// 启动 Claude Code 作为子进程\n308\t\tcmd := exec.Command(claudePath, finalArgs...)\n309\t\tcmd.Env = childEnv\n310\t\tcmd.Stdin = os.Stdin\n311\t\tcmd.Stdout = os.Stdout\n312\t\tcmd.Stderr = os.Stderr\n313\t\n314\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n315\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n316\t\n317\t\tif err := cmd.Start(); err != nil {\n318\t\t\tlog.Fatalf(\"start claude: %v\", err)\n319\t\t}\n320\t\n321\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n322\t\tsigChan := make(chan os.Signal, 2)\n323\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n324\t\n325\t\tgo func() {\n326\t\t\tsigCount := 0\n327\t\t\tfor sig := range sigChan {\n328\t\t\t\tsigCount++\n329\t\t\t\tif sigCount == 1 {\n330\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n331\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n332\t\t\t\t\t_ = cmd.Process.Signal(sig)\n333\t\t\t\t} else {\n334\t\t\t\t\t// 再次收到信号：强制终止子进程\n335\t\t\t\t\t_ = cmd.Process.Kill()\n336\t\t\t\t}\n337\t\t\t}\n338\t\t}()\n339\t\n340\t\t// 等待子进程结束\n341\t\twaitErr := cmd.Wait()\n342\t\n343\t\t// 停止信号处理器，释放资源\n344\t\tsignal.Stop(sigChan)\n345\t\tclose(sigChan)\n346\t\n347\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n348\t\tsummary := rp.Summary()\n349\t\ttracePath := rp.TracePath()\n350\t\n351\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n352\t\tif waitErr != nil {\n353\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n354\t\t}\n355\t\tfmt.Printf(\"\\n\")\n356\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n357\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n358\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n359\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n360\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n361\t\tif tracePath != \"\" {\n362\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n363\t\t}\n364\t\tfmt.Printf(\"\\n\")\n365\t\n366\t\t// 生成 Resume 命令（仅在有 session_id 时）\n367\t\tsessionID := rp.SessionID()\n368\t\tif sessionID != \"\" {\n369\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n370\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n371\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n372\t\t}\n373\t}\n374\t\n375\t// loadFallbackConfig 从 Claude settings 加载兜底配置（契约 4）。\n376\t// 读取 ~/.claude/settings.json 中的 base_url、model、认证信息作为 fallback。\n377\tfunc loadFallbackConfig() *proxy.FallbackConfig {\n378\t\ts, err := config.ReadClaudeSettings()\n379\t\tif err != nil || s == nil {\n380\t\t\treturn nil\n381\t\t}\n382\t\n383\t\tbaseURL := s.Env.AnthropicBaseURL\n384\t\tif baseURL == \"\" {\n385\t\t\tbaseURL = config.ClaudeClient.DefaultTarget\n386\t\t}\n387\t\n388\t\treturn &proxy.FallbackConfig{\n389\t\t\tBaseURL:   baseURL,\n390\t\t\tModel:     s.Model,\n391\t\t\tAuthToken: s.Env.AnthropicAuthToken,\n392\t\t\tAPIKey:    s.Env.AnthropicAPIKey,\n393\t\t}\n394\t}\n395\t\n396\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n397\t//\n398\t// 支持的参数：\n399\t//   --all       收集所有项目的会话\n400\t//   --force     覆盖已存在的会话文件\n401\t//   --dry-run   仅预览，不实际执行\n402\t//   --project   指定项目名称，覆盖自动检测\n403\tfunc runSessionPush(args []string) {\n404\t\tvar opts session.PushOptions\n405\t\tfor i := 0; i < len(args); i++ {\n406\t\t\targ := args[i]\n407\t\t\tswitch {\n408\t\t\tcase arg == \"--all\":\n409\t\t\t\topts.All = true\n410\t\t\tcase arg == \"--force\":\n411\t\t\t\topts.Force = true\n412\t\t\tcase arg == \"--dry-run\":\n413\t\t\t\topts.DryRun = true\n414\t\t\tcase arg == \"--project\" && i+1 < len(args):\n415\t\t\t\ti++\n416\t\t\t\topts.Project = args[i]\n417\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n418\t\t\t\topts.Project = arg[len(\"--project=\"):]\n419\t\t\t}\n420\t\t}\n421\t\n422\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n423\t\tresults, err := session.SessionPush(opts)\n424\t\tif err != nil {\n425\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n426\t\t\tos.Exit(1)\n427\t\t}\n428\t\n429\t\t// 汇总各项目的收集结果\n430\t\tfmt.Println()\n431\t\ttotalNew, totalSkipped := 0, 0\n432\t\tfor _, r := range results {\n433\t\t\ttotalNew += r.SessionsNew\n434\t\t\ttotalSkipped += r.SessionsSkipped\n435\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n436\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n437\t\t\t}\n438\t\t}\n439\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n440\t}\n441\t\n442\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n443\t//\n444\t// 支持的参数：\n445\t//   --all       恢复所有项目的会话\n446\t//   --dry-run   仅预览，不实际执行\n447\t//   --project   指定项目名称，覆盖自动检测\n448\tfunc runSessionPull(args []string) {\n449\t\tvar opts session.PullOptions\n450\t\tfor i := 0; i < len(args); i++ {\n451\t\t\targ := args[i]\n452\t\t\tswitch {\n453\t\t\tcase arg == \"--all\":\n454\t\t\t\topts.All = true\n455\t\t\tcase arg == \"--dry-run\":\n456\t\t\t\topts.DryRun = true\n457\t\t\tcase arg == \"--project\" && i+1 < len(args):\n458\t\t\t\ti++\n459\t\t\t\topts.Project = args[i]\n460\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n461\t\t\t\topts.Project = arg[len(\"--project=\"):]\n462\t\t\t}\n463\t\t}\n464\t\n465\t\tfmt.Println(\"📤 Restoring sessions...\")\n466\t\tresults, err := session.SessionPull(opts)\n467\t\tif err != nil {\n468\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n469\t\t\tos.Exit(1)\n470\t\t}\n471\t\n472\t\t// 汇总各项目的恢复结果\n473\t\tfmt.Println()\n474\t\ttotalRestored, totalSkipped := 0, 0\n475\t\tfor _, r := range results {\n476\t\t\ttotalRestored += r.SessionsRestored\n477\t\t\ttotalSkipped += r.SessionsSkipped\n478\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n479\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n480\t\t\t}\n481\t\t}\n482\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n483\t}\n484\t\n485\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n486\t//\n487\t// 支持的参数：\n488\t//   --verbose   显示文件级别的详细信息\n489\tfunc runSessionStatus(args []string) {\n490\t\tvar opts session.StatusOptions\n491\t\tfor i := 0; i < len(args); i++ {\n492\t\t\targ := args[i]\n493\t\t\tswitch {\n494\t\t\tcase arg == \"--verbose\":\n495\t\t\t\topts.Verbose = true\n496\t\t\t}\n497\t\t}\n498\t\n499\t\tif err := session.SessionStatus(opts); err != nil {\n500\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n501\t\t\tos.Exit(1)\n502\t\t}\n503\t}\n504\t\n505\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n506\t// 如果参数中包含空格或制表符，则使用引号包裹。\n507\tfunc formatArgs(args []string) string {\n508\t\tresult := \"\"\n509\t\tfor _, a := range args {\n510\t\t\tif containsSpace(a) {\n511\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n512\t\t\t} else {\n513\t\t\t\tresult += \" \" + a\n514\t\t\t}\n515\t\t}\n516\t\treturn strings.TrimSpace(result)\n517\t}\n518\t\n519\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n520\tfunc containsSpace(s string) bool {\n521\t\tfor _, c := range s {\n522\t\t\tif c == ' ' || c == '\\t' {\n523\t\t\t\treturn true\n524\t\t\t}\n525\t\t}\n526\t\treturn false\n527\t}\n528\t\n529\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n530\tfunc firstNonEmpty(ss ...string) string {\n531\t\tfor _, s := range ss {\n532\t\t\tif s != \"\" {\n533\t\t\t\treturn s\n534\t\t\t}\n535\t\t}\n536\t\treturn \"\"\n537\t}\n538\t\n539\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n540\t//\n541\t// 逻辑：\n542\t//  1. 复制原始参数\n543\t//  2. 移除已有的 --resume <old-id>（如果存在）\n544\t//  3. 追加 --resume <new-session-id>\n545\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n546\t\tfiltered := make([]string, 0, len(originalArgs))\n547\t\tskip := false\n548\t\tfor i, arg := range originalArgs {\n549\t\t\tif skip {\n550\t\t\t\tskip = false\n551\t\t\t\tcontinue\n552\t\t\t}\n553\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n554\t\t\t\tskip = true // 跳过 --resume 及其值\n555\t\t\t\tcontinue\n556\t\t\t}\n557\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n558\t\t\t\tcontinue // 跳过 --resume=id 形式\n559\t\t\t}\n560\t\t\tfiltered = append(filtered, arg)\n561\t\t}\n562\t\tfiltered = append(filtered, \"--resume\", sessionID)\n563\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n564\t}\n565\t\n566\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n567\tfunc shortenPath(path string) string {\n568\t\thome, err := os.UserHomeDir()\n569\t\tif err != nil {\n570\t\t\treturn path\n571\t\t}\n572\t\tif strings.HasPrefix(path, home) {\n573\t\t\treturn \"~\" + path[len(home):]\n574\t\t}\n575\t\treturn path\n576\t}\n577\t\n578\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n579\tfunc removeEnvVar(env []string, name string) []string {\n580\t\tprefix := name + \"=\"\n581\t\tresult := make([]string, 0, len(env))\n582\t\tfor _, e := range env {\n583\t\t\tif !strings.HasPrefix(e, prefix) {\n584\t\t\t\tresult = append(result, e)\n585\t\t\t}\n586\t\t}\n587\t\treturn result\n588\t}\n589\t"}]}
