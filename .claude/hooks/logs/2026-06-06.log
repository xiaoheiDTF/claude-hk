[2026-06-06 20:05:08] [INFO] [PostToolBatch] Input: {"session_id":"eeb8e205-3667-4e86-8031-0905d852add4","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\eeb8e205-3667-4e86-8031-0905d852add4.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"acceptEdits","agent_id":"a88b323eab37a50d0","agent_type":"Explore","hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\base.sh"},"tool_use_id":"call_07aa9729ff0742e7ab7d71bd","tool_response":"1\t#!/bin/bash\n2\t# Hooks Base Script\n3\t# 1. 平台感知 (platform.sh)\n4\t# 2. 从 stdin 读取 JSON\n5\t# 3. 解析字段\n6\t# 4. 按日期写入日志，带 [EventName] 前缀\n7\t# 5. 输出结果 JSON\n8\t\n9\tHOOKS_DIR=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"\n10\tLOG_DIR=\"$HOOKS_DIR/logs\"\n11\tmkdir -p \"$LOG_DIR\"\n12\t\n13\tsource \"$HOOKS_DIR/platform.sh\"\n14\t\n15\tHOOK_INPUT=$(cat)\n16\tLOG_FILE=\"$LOG_DIR/$(date +%Y-%m-%d).log\"\n17\t\n18\t_log_raw() {\n19\t  echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [$1] $2\" >> \"$LOG_FILE\"\n20\t}\n21\t\n22\tjson_get() {\n23\t  local key=\"$1\"\n24\t  if [ -z \"$HOOK_INPUT\" ]; then echo \"\"; return; fi\n25\t  if command -v jq &>/dev/null; then\n26\t    printf '%s' \"$HOOK_INPUT\" | jq -r \"$key\" 2>/dev/null\n27\t    return\n28\t  fi\n29\t  if [ -n \"$PYTHON_CMD\" ]; then\n30\t    printf '%s' \"$HOOK_INPUT\" | \"$PYTHON_CMD\" \"$HOOKS_DIR/json_get.py\" \"$key\" 2>>\"$LOG_FILE\"\n31\t    return\n32\t  fi\n33\t  # 纯 sed fallback：提取 .key 或 .\"key\" 格式的顶层字段\n34\t  local bare_key=\"${key#.}\"\n35\t  printf '%s' \"$HOOK_INPUT\" | sed -n \"s/.*\\\"${bare_key}\\\"[[:space:]]*:[[:space:]]*\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" | head -1\n36\t}\n37\t\n38\tHOOK_EVENT=$(json_get '.hook_event_name')\n39\t[ -z \"$HOOK_EVENT\" ] && HOOK_EVENT=\"UNKNOWN\"\n40\t\n41\tlog() {\n42\t  echo \"[$(date '+%Y-%m-%d %H:%M:%S')] [$1] [$HOOK_EVENT] $2\" >> \"$LOG_FILE\"\n43\t}\n44\t\n45\tlog \"DEBUG\" \"os=$OS_TYPE python=$PYTHON_CMD\"\n46\tlog \"INFO\" \"Input: $HOOK_INPUT\"\n47\t\n48\thook_output() {\n49\t  local exit_code=\"${1:-0}\"\n50\t  local json=\"${2:-{}}\"\n51\t  log \"INFO\" \"Output (exit=$exit_code): $json\"\n52\t  echo \"$json\"\n53\t  exit \"$exit_code\"\n54\t}\n55\t\n56\t# Skill 感知分发：根据 .active 中的 session_id 匹配活跃 skill，\n57\t# 调用对应 skill 目录下的生命周期脚本。\n58\t# 用法: dispatch_to_skill \"05\" [额外参数...]\n59\t# 返回: 0=成功或无活跃 skill，非 0=skill 脚本执行失败\n60\t# stdout: skill 脚本的输出（如有）\n61\tdispatch_to_skill() {\n62\t  local event_num=\"$1\"\n63\t  shift\n64\t\n65\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n66\t  local active_file=\"$skills_dir/.active\"\n67\t\n68\t  # 无 .active 或为空 → 跳过\n69\t  [ -s \"$active_file\" ] || return 0\n70\t\n71\t  # 获取当前 session_id\n72\t  local sid\n73\t  sid=$(json_get '.session_id')\n74\t  [ -z \"$sid\" ] && return 0\n75\t\n76\t  # 查找当前 session 激活的 skill\n77\t  source \"$skills_dir/active.sh\"\n78\t  local skill_name\n79\t  skill_name=$(active_get \"$sid\")\n80\t  [ -z \"$skill_name\" ] && return 0\n81\t\n82\t  # 按事件编号映射脚本名\n83\t  local script_name\n84\t  case \"$event_num\" in\n85\t    02) script_name=\"02Setup\" ;;\n86\t    04) script_name=\"04UserPromptExpansion\" ;;\n87\t    05) script_name=\"05PreToolUse\" ;;\n88\t    06) script_name=\"06PermissionRequest\" ;;\n89\t    07) script_name=\"07PermissionDenied\" ;;\n90\t    08) script_name=\"08PostToolUse\" ;;\n91\t    09) script_name=\"09PostToolUseFailure\" ;;\n92\t    10) script_name=\"10PostToolBatch\" ;;\n93\t    11) script_name=\"11Notification\" ;;\n94\t    12) script_name=\"12SubagentStart\" ;;\n95\t    13) script_name=\"13SubagentStop\" ;;\n96\t    14) script_name=\"14TaskCreated\" ;;\n97\t    15) script_name=\"15TaskCompleted\" ;;\n98\t    17) script_name=\"17StopFailure\" ;;\n99\t    18) script_name=\"18TeammateIdle\" ;;\n100\t    19) script_name=\"19InstructionsLoaded\" ;;\n101\t    20) script_name=\"20ConfigChange\" ;;\n102\t    21) script_name=\"21CwdChanged\" ;;\n103\t    22) script_name=\"22FileChanged\" ;;\n104\t    23) script_name=\"23WorktreeCreate\" ;;\n105\t    24) script_name=\"24WorktreeRemove\" ;;\n106\t    25) script_name=\"25PreCompact\" ;;\n107\t    26) script_name=\"26PostCompact\" ;;\n108\t    27) script_name=\"27Elicitation\" ;;\n109\t    28) script_name=\"28ElicitationResult\" ;;\n110\t    29) script_name=\"29SessionEnd\" ;;\n111\t    *) return 0 ;;\n112\t  esac\n113\t\n114\t  local script_path=\"$skills_dir/$skill_name/scripts/$script_name.sh\"\n115\t  [ -f \"$script_path\" ] || return 0\n116\t\n117\t  log \"INFO\" \"Dispatching to skill=$skill_name script=$script_name.sh\"\n118\t  bash \"$script_path\" \"$@\" 2>>\"$LOG_FILE\"\n119\t}\n120\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\platform.sh"},"tool_use_id":"call_97c3506ad5ed4f1280ea1bf0","tool_response":"1\t#!/bin/bash\n2\t# 平台检测与 Python 路径解析\n3\t\n4\tdetect_os() {\n5\t  case \"$(uname -s)\" in\n6\t    Linux*)   echo \"linux\" ;;\n7\t    Darwin*)  echo \"macos\" ;;\n8\t    MINGW*|MSYS*|CYGWIN*) echo \"windows\" ;;\n9\t    *)        echo \"unknown\" ;;\n10\t  esac\n11\t}\n12\t\n13\tOS_TYPE=$(detect_os)\n14\t\n15\tresolve_python() {\n16\t  local embed\n17\t  case \"$OS_TYPE\" in\n18\t    windows) embed=\"$CLAUDE_PROJECT_DIR/.claude/localLanguage/python/python.exe\" ;;\n19\t    *)       embed=\"$CLAUDE_PROJECT_DIR/.claude/localLanguage/python/bin/python3\" ;;\n20\t  esac\n21\t  if [ -x \"$embed\" ]; then echo \"$embed\"; return; fi\n22\t  for cmd in python3 python; do\n23\t    if command -v \"$cmd\" &>/dev/null && \"$cmd\" -c \"pass\" 2>/dev/null; then\n24\t      echo \"$cmd\"; return\n25\t    fi\n26\t  done\n27\t  echo \"\"\n28\t}\n29\t\n30\tPYTHON_CMD=$(resolve_python)\n31\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\json_get.py"},"tool_use_id":"call_2d10d5055ab743858d71bf7c","tool_response":"1\t\"\"\"JSON field extractor for hook scripts.\n2\t\n3\tUsage: printf '<json>' | python json_get.py <key>\n4\t  e.g.: printf '<json>' | python json_get.py .hook_event_name\n5\t        printf '<json>' | python json_get.py .tool_name\n6\t\"\"\"\n7\timport sys\n8\timport json\n9\t\n10\tdata = json.load(sys.stdin)\n11\tkeys = sys.argv[1].lstrip(\".\").split(\".\")\n12\tv = data\n13\tfor k in keys:\n14\t    if isinstance(v, dict) and k in v:\n15\t        v = v[k]\n16\t    else:\n17\t        v = \"\"\n18\t        break\n19\tprint(v if not isinstance(v, (list, dict)) else json.dumps(v, ensure_ascii=False))\n20\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\01-session-start\\base.sh"},"tool_use_id":"call_079bb1e76a7b4651b2ff88da","tool_response":"1\t#!/bin/bash\n2\t# 01-session-start: 会话开始或恢复时触发 (每个会话一次)\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\tsource \"$HOOKS_DIR/lib/backend.sh\"\n7\t\n8\tsource_type=$(json_get '.source')\n9\tlog \"INFO\" \"source=$source_type\"\n10\t\n11\t# 首次运行 → 触发统一初始化\n12\t[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/.initialized\" ] && bash \"$CLAUDE_PROJECT_DIR/.claude/init.sh\"\n13\t\n14\t# ---- 每次会话确保基础环境 ----\n15\t\n16\t# 1. UTF-8 编码\n17\tensure_utf8() {\n18\t  local os_type\n19\t  case \"$(uname -s)\" in\n20\t    Linux*)   os_type=\"linux\" ;;\n21\t    Darwin*)  os_type=\"macos\" ;;\n22\t    MINGW*|MSYS*|CYGWIN*) os_type=\"windows\" ;;\n23\t    *)        os_type=\"unknown\" ;;\n24\t  esac\n25\t\n26\t  export LANG=\"${LANG:-en_US.UTF-8}\"\n27\t  export LC_ALL=\"${LC_ALL:-en_US.UTF-8}\"\n28\t\n29\t  if [ \"$os_type\" = \"windows\" ]; then\n30\t    chcp.com 65001 > /dev/null 2>&1\n31\t    log \"INFO\" \"Windows code page set to 65001\"\n32\t  fi\n33\t\n34\t  log \"INFO\" \"UTF-8 ensured (OS=$os_type, LANG=$LANG)\"\n35\t}\n36\t\n37\t# 2. Python 可用性（巡检 + 自动修复）\n38\tensure_python_check() {\n39\t  source \"$CLAUDE_PROJECT_DIR/.claude/scripts/ensure_python.sh\"\n40\t  local result\n41\t  result=$(ensure_python)\n42\t  if [ -n \"$result\" ]; then\n43\t    log \"INFO\" \"Python 已就绪: $result\"\n44\t  else\n45\t    log \"WARN\" \"Python 不可用，部分功能受限\"\n46\t  fi\n47\t}\n48\t\n49\t# 3. 目录完整性\n50\tensure_dirs() {\n51\t  source \"$CLAUDE_PROJECT_DIR/.claude/scripts/ensure_dirs.sh\"\n52\t  local missing\n53\t  missing=$(check_dirs 2>&1)\n54\t  if [ \"$missing\" = \"ALL OK\" ]; then\n55\t    log \"INFO\" \"目录检查通过\"\n56\t  else\n57\t    log \"WARN\" \"目录缺失，重新创建: $missing\"\n58\t    ensure_all_dirs \"$LOG_FILE\" > /dev/null\n59\t  fi\n60\t}\n61\t\n62\tensure_utf8\n63\tensure_python_check\n64\tensure_dirs\n65\t\n66\t# 4. Skill 级巡检\n67\tensure_skill_checks() {\n68\t  local skills_dir=\"$CLAUDE_PROJECT_DIR/.claude/skills\"\n69\t  [ -d \"$skills_dir\" ] || return\n70\t  for check_script in \"$skills_dir\"/*/scripts/init_check.sh; do\n71\t    [ -f \"$check_script\" ] || continue\n72\t    local skill_name\n73\t    skill_name=$(basename \"$(dirname \"$(dirname \"$check_script\")\")\")\n74\t    if bash \"$check_script\" >> \"$LOG_FILE\" 2>&1; then\n75\t      log \"INFO\" \"Skill check OK: $skill_name\"\n76\t    else\n77\t      log \"WARN\" \"Skill check failed: $skill_name (non-blocking)\"\n78\t    fi\n79\t  done\n80\t}\n81\t\n82\tensure_skill_checks\n83\t\n84\t# trace-init 返回的 trace 路径，供 register_session 回填 local_trace_path\n85\t__LAST_TRACE_PATH=\"\"\n86\t\n87\t# 5. 初始化代理 trace 路径（通过后端 8080 转发到代理）\n88\tinit_trace_path() {\n89\t  if ! _backend_available; then\n90\t    log \"DEBUG\" \"Trace init skipped (backend/proxy unreachable)\"\n91\t    return 0\n92\t  fi\n93\t\n94\t  local sid\n95\t  sid=$(json_get '.session_id')\n96\t  [ -z \"$sid\" ] && return 0\n97\t\n98\t  local machine_id\n99\t  machine_id=\"$(whoami 2>/dev/null || echo unknown)@$(hostname 2>/dev/null || echo unknown)\"\n100\t\n101\t  local transcript_path\n102\t  transcript_path=$(json_get '.transcript_path')\n103\t\n104\t  local project_slug\n105\t  project_slug=$(echo \"$transcript_path\" | sed -n 's/.*[\\.]claude[\\\\/]\\{1\\}projects[\\\\/]\\{1\\}\\([^\\\\/]*\\).*/\\1/p')\n106\t  [ -z \"$project_slug\" ] && project_slug=$(basename \"$(json_get '.cwd')\" 2>/dev/null)\n107\t\n108\t  # Windows 路径反斜杠转义：\\ → \\\\（否则 Go JSON 解析器拒绝非法转义序列如 \\U）\n109\t  local safe_transcript_path=\"${transcript_path//\\\\/\\\\\\\\}\"\n110\t\n111\t  # 通过后端转发 trace-init 到代理\n112\t  local result\n113\t  result=$(_call_backend \"/api/proxy/trace-init\" \"{\n114\t    \\\"session_id\\\":\\\"$sid\\\",\n115\t    \\\"machine_id\\\":\\\"$machine_id\\\",\n116\t    \\\"project_slug\\\":\\\"$project_slug\\\",\n117\t    \\\"transcript_path\\\":\\\"$safe_transcript_path\\\"\n118\t  }\")\n119\t\n120\t  if [ -n \"$result\" ]; then\n121\t    __LAST_TRACE_PATH=$(echo \"$result\" | jq -r '.trace_path // \"\"' 2>/dev/null)\n122\t    log \"INFO\" \"Trace initialized: ${__LAST_TRACE_PATH:-unknown}\"\n123\t  else\n124\t    log \"DEBUG\" \"Trace init failed (backend call returned empty)\"\n125\t  fi\n126\t}\n127\t\n128\t# 6. 注册会话到后端（SR-2）\n129\tregister_session() {\n130\t  if ! _backend_available; then\n131\t    log \"DEBUG\" \"Backend unreachable, skipping session registration\"\n132\t    return 0\n133\t  fi\n134\t\n135\t  local session_id transcript_path cwd model source_type os_type machine_id project_slug\n136\t\n137\t  session_id=$(json_get '.session_id')\n138\t  [ -z \"$session_id\" ] && return 0\n139\t\n140\t  transcript_path=$(json_get '.transcript_path')\n141\t  cwd=$(json_get '.cwd')\n142\t  model=$(json_get '.model')\n143\t  source_type=$(json_get '.source')\n144\t\n145\t  machine_id=\"$(whoami 2>/dev/null || echo unknown)@$(hostname 2>/dev/null || echo unknown)\"\n146\t\n147\t  case \"$(uname -s)\" in\n148\t    Linux*)   os_type=\"linux\" ;;\n149\t    Darwin*)  os_type=\"macos\" ;;\n150\t    MINGW*|MSYS*|CYGWIN*) os_type=\"windows\" ;;\n151\t    *)        os_type=\"unknown\" ;;\n152\t  esac\n153\t\n154\t  project_slug=$(echo \"$transcript_path\" | sed -n 's/.*[\\.]claude[\\\\/]\\{1\\}projects[\\\\/]\\{1\\}\\([^\\\\/]*\\).*/\\1/p')\n155\t  [ -z \"$project_slug\" ] && project_slug=$(basename \"$cwd\" 2>/dev/null)\n156\t\n157\t  # Windows 路径反斜杠转义\n158\t  local safe_cwd=\"${cwd//\\\\/\\\\\\\\}\"\n159\t  local safe_transcript_path=\"${transcript_path//\\\\/\\\\\\\\}\"\n160\t  local safe_trace_path=\"${__LAST_TRACE_PATH//\\\\/\\\\\\\\}\"\n161\t\n162\t  _call_backend \"/api/session/register\" \"{\n163\t    \\\"session_id\\\":\\\"$session_id\\\",\n164\t    \\\"machine_id\\\":\\\"$machine_id\\\",\n165\t    \\\"os\\\":\\\"$os_type\\\",\n166\t    \\\"project_slug\\\":\\\"$project_slug\\\",\n167\t    \\\"project_cwd\\\":\\\"$safe_cwd\\\",\n168\t    \\\"transcript_path\\\":\\\"$safe_transcript_path\\\",\n169\t    \\\"local_trace_path\\\":\\\"$safe_trace_path\\\",\n170\t    \\\"model\\\":\\\"$model\\\",\n171\t    \\\"source\\\":\\\"$source_type\\\"\n172\t  }\" > /dev/null 2>&1\n173\t\n174\t  log \"INFO\" \"Session registered to backend: $session_id\"\n175\t}\n176\t\n177\tinit_trace_path\n178\tregister_session\n179\t\n180\thook_output 0 '{}'\n181\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\02-setup\\base.sh"},"tool_use_id":"call_d417ec3eaf314e398007cb38","tool_response":"1\t#!/bin/bash\n2\t# 02-setup: 使用 --init-only 启动，或在 -p 模式中使用 --init 或 --maintenance 时触发\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\tlog \"INFO\" \"Setup triggered\"\n8\t\n9\tdispatch_to_skill \"02\" || true\n10\t\n11\thook_output 0 '{}'\n12\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\03-user-prompt-submit\\base.sh"},"tool_use_id":"call_3a436354c5704ae081aa6408","tool_response":"1\t#!/bin/bash\n2\t# 03-user-prompt-submit: 用户提交提示后、Claude 处理之前触发 (每轮一次)\n3\t# 退出 2 可阻止提示处理并从上下文中删除提示\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tprompt=$(json_get '.prompt')\n9\tsession_id=$(json_get '.session_id')\n10\t\n11\tlog \"INFO\" \"prompt=$prompt session=$session_id\"\n12\t\n13\t# skill 注入：检测 /xxx 格式调用（首字符必须是 /）\n14\tOUTPUT=$(bash \"$SCRIPT_DIR/skill-inject.sh\" \"$prompt\" \"$session_id\" 2>/dev/null)\n15\tif [ -n \"$OUTPUT\" ]; then\n16\t  # 第一行：skill_name|args\n17\t  META=$(echo \"$OUTPUT\" | head -1)\n18\t  # 第二行起：CONTEXT（完整 hook JSON）\n19\t  CONTEXT=$(echo \"$OUTPUT\" | tail -n +2)\n20\t\n21\t  SKILL_NAME=$(echo \"$META\" | cut -d'|' -f1)\n22\t  SKILL_ARGS=$(echo \"$META\" | cut -d'|' -f2)\n23\t\n24\t  log \"INFO\" \"Skill matched: $SKILL_NAME | session: $session_id | args: $SKILL_ARGS\"\n25\t  hook_output 0 \"$CONTEXT\"\n26\tfi\n27\t\n28\thook_output 0 '{}'\n29\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\03-user-prompt-submit\\skill-inject.sh"},"tool_use_id":"call_004d25c797c44328a1d88fe6","tool_response":"1\t#!/bin/bash\n2\t# skill-inject: 从用户 prompt 提取 skill 名，匹配注册表后注入上下文\n3\t# 被 03-user-prompt-submit/base.sh 调用\n4\t# 参数: $1 = 用户 prompt, $2 = session_id（来自 hook 输入 JSON）\n5\t#\n6\t# 匹配规则:\n7\t#   - 首字符必须是 /\n8\t#   - skill 名到第一个空格结束\n9\t#   - /xxx 后面的内容作为参数传递\n10\t\n11\tPROMPT=\"$1\"\n12\tSESSION_ID=\"$2\"\n13\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n14\tSKILLS_DIR=\"$PROJECT_DIR/.claude/skills\"\n15\tREGISTRY=\"$SKILLS_DIR/registry.conf\"\n16\t\n17\t# 首字符不是 / → 不是 skill 调用\n18\t[[ \"$PROMPT\" != /* ]] && exit 0\n19\t\n20\t# 提取 skill 名：去掉开头的 /，取到第一个空格\n21\tPROMPT_TRIMMED=\"${PROMPT#/}\"\n22\tSKILL_NAME=\"${PROMPT_TRIMMED%% *}\"\n23\t\n24\t# 提取参数：skill 名之后的内容\n25\tSKILL_ARGS=\"\"\n26\tif [[ \"$PROMPT_TRIMMED\" == *\" \"* ]]; then\n27\t  SKILL_ARGS=\"${PROMPT_TRIMMED#* }\"\n28\tfi\n29\t\n30\t[ -z \"$SKILL_NAME\" ] && exit 0\n31\t\n32\t# 注册表匹配（纯 ASCII）\n33\tMATCH=$(awk -v name=\"$SKILL_NAME\" '$1 == name {print $1}' \"$REGISTRY\" 2>/dev/null)\n34\t[ -z \"$MATCH\" ] && exit 0\n35\t\n36\t# 查找并运行 03UserPromptSubmit.sh\n37\tON_LOAD=\"$SKILLS_DIR/$MATCH/scripts/03UserPromptSubmit.sh\"\n38\t[ ! -f \"$ON_LOAD\" ] && exit 0\n39\t\n40\t# 执行获取上下文\n41\tCONTEXT=$(bash \"$ON_LOAD\" 2>/dev/null)\n42\t[ -z \"$CONTEXT\" ] && exit 0\n43\t\n44\t# 写入 .active（使用真实 session_id）\n45\tsource \"$SKILLS_DIR/active.sh\"\n46\tactive_add \"$SESSION_ID\" \"$MATCH\" 2>/dev/null\n47\t\n48\t# 输出：第一行元数据，第二行起 CONTEXT\n49\techo \"$MATCH|$SKILL_ARGS\"\n50\techo \"$CONTEXT\"\n51\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\04-user-prompt-expansion\\base.sh"},"tool_use_id":"call_e2e0d89b28384e52902d30fc","tool_response":"1\t#!/bin/bash\n2\t# 04-user-prompt-expansion: 用户输入的命令展开为提示之前触发 (每轮一次)\n3\t# 退出 2 可阻止展开\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tcommand_val=$(json_get '.command')\n9\texpanded_prompt=$(json_get '.expanded_prompt')\n10\t\n11\tlog \"INFO\" \"command=$command_val\"\n12\t\n13\t# 示例: 阻止特定命令展开\n14\t# if [ \"$command_val\" = \"/dangerous\" ]; then\n15\t#   log \"WARN\" \"Blocked command expansion: $command_val\"\n16\t#   hook_output 2 '{\"decision\":\"block\",\"reason\":\"Command expansion blocked\"}'\n17\t# fi\n18\t\n19\tdispatch_to_skill \"04\" || true\n20\thook_output 0 '{}'\n21\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\05-pre-tool-use\\base.sh"},"tool_use_id":"call_82fc0379ae6e4d7eb331feea","tool_response":"1\t#!/bin/bash\n2\t# 05-pre-tool-use: 工具调用执行之前触发 (每个工具调用)\n3\t# 最丰富的决定控制: allow/deny/ask/defer\n4\t# 决定优先级: deny > defer > ask > allow\n5\t\n6\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n7\tsource \"$SCRIPT_DIR/../base.sh\"\n8\t\n9\ttool_name=$(json_get '.tool_name')\n10\ttool_input=$(json_get '.tool_input')\n11\t\n12\tlog \"INFO\" \"tool=$tool_name\"\n13\t\n14\t# 示例: 阻止危险 Bash 命令\n15\t# if [ \"$tool_name\" = \"Bash\" ]; then\n16\t#   if echo \"$tool_input\" | grep -qi \"rm -rf\"; then\n17\t#     log \"WARN\" \"Blocked dangerous command\"\n18\t#     hook_output 2 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Dangerous command blocked\"}}'\n19\t#   fi\n20\t# fi\n21\t\n22\t# 示例: 自动允许只读操作\n23\t# if [ \"$tool_name\" = \"Read\" ] || [ \"$tool_name\" = \"Grep\" ] || [ \"$tool_name\" = \"Glob\" ]; then\n24\t#   hook_output 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"Read-only tool\"}}'\n25\t# fi\n26\t\n27\t# 示例: 修改工具输入\n28\t# hook_output 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"updatedInput\":{\"file_path\":\"/safe/path\"}}}'\n29\t\n30\t# 示例: 添加上下文提示\n31\t# hook_output 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"当前为生产环境，请谨慎操作\"}}'\n32\t\n33\t# A 层：工具级白名单拦截（在 dispatch 之前执行）\n34\tsource \"$CLAUDE_PROJECT_DIR/.claude/skills/enforce_boundary.sh\"\n35\t\n36\t# B 层：skill 按需路径级拦截\n37\tdispatch_to_skill \"05\" || true\n38\t\n39\thook_output 0 '{}'\n40\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\06-permission-request\\base.sh"},"tool_use_id":"call_bb6ddb74ab0f465e989cd5d3","tool_response":"1\t#!/bin/bash\n2\t# 06-permission-request: 权限对话框出现时触发 (每个工具调用)\n3\t# 输出: decision.behavior (allow/deny)\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\ttool_name=$(json_get '.tool_name')\n9\t\n10\tlog \"INFO\" \"tool=$tool_name\"\n11\t\n12\t# 示例: 自动允许特定工具\n13\t# if [ \"$tool_name\" = \"Read\" ]; then\n14\t#   hook_output 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'\n15\t# fi\n16\t\n17\t# 示例: 自动拒绝\n18\t# hook_output 2 '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"deny\"}}}'\n19\t\n20\t# Windows: bring terminal to foreground when permission dialog appears\n21\tif [ \"$OS_TYPE\" = \"windows\" ] && [ -f \"$SCRIPT_DIR/win32-foreground.sh\" ]; then\n22\t  source \"$SCRIPT_DIR/win32-foreground.sh\"\n23\tfi\n24\t\n25\tdispatch_to_skill \"06\" || true\n26\thook_output 0 '{}'\n27\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\06-permission-request\\win32-foreground.sh"},"tool_use_id":"call_93947e3843ed420a86e1a4a3","tool_response":"1\t#!/bin/bash\n2\t# win32-foreground.sh — Bring terminal to foreground when permission dialog appears\n3\t# Trigger: PermissionRequest (hook 06)\n4\t# Called from 06-permission-request/base.sh after sourcing hooks/base.sh\n5\t\n6\t# Already have: HOOKS_DIR, HOOK_INPUT, log(), json_get(), OS_TYPE, PYTHON_CMD\n7\tFOREGROUND_PS1=\"$HOOKS_DIR/lib/win32-foreground.ps1\"\n8\t\n9\t# Only run on Windows\n10\tif [ \"$OS_TYPE\" != \"windows\" ]; then\n11\t  return 0 2>/dev/null || true\n12\tfi\n13\t\n14\t# Log tool info from hook input\n15\ttool_name=$(json_get '.tool_name')\n16\ttool_input_cmd=\"\"\n17\tif [ -n \"$PYTHON_CMD\" ]; then\n18\t  tool_input_cmd=$(printf '%s' \"$HOOK_INPUT\" | \"$PYTHON_CMD\" -c \"\n19\timport json, sys\n20\ttry:\n21\t    d = json.load(sys.stdin)\n22\t    ti = d.get('tool_input', {})\n23\t    print(ti.get('command', '')[:80] if isinstance(ti, dict) else '')\n24\texcept: print('')\n25\t\" 2>/dev/null || echo \"\")\n26\tfi\n27\tlog \"INFO\" \"[win32-fg] PermissionRequest: tool=$tool_name cmd=${tool_input_cmd:0:80}\"\n28\t\n29\t# Bring window to foreground (pass project dir name as hint for multi-window matching)\n30\tPROJECT_HINT=$(basename \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || echo \"\")\n31\tif [ -f \"$FOREGROUND_PS1\" ]; then\n32\t  FOREGROUND_WIN_PATH=$(cygpath -w \"$FOREGROUND_PS1\" 2>/dev/null || echo \"$FOREGROUND_PS1\")\n33\t  powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$FOREGROUND_WIN_PATH\" -Hint \"$PROJECT_HINT\" 2>>\"$LOG_FILE\"\n34\t  log \"INFO\" \"[win32-fg] foreground script executed (hint=$PROJECT_HINT)\"\n35\telse\n36\t  log \"WARNING\" \"[win32-fg] win32-foreground.ps1 not found at $FOREGROUND_PS1\"\n37\tfi\n38\t\n39\treturn 0 2>/dev/null || true\n40\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\07-permission-denied\\base.sh"},"tool_use_id":"call_e07ab28f9972438cb3d8ac62","tool_response":"1\t#!/bin/bash\n2\t# 07-permission-denied: 自动模式分类器拒绝工具调用时触发 (每个拒绝)\n3\t# 输出: retry: true 告诉模型它可以重试\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\ttool_name=$(json_get '.tool_name')\n9\t\n10\tlog \"INFO\" \"tool=$tool_name\"\n11\t\n12\t# 示例: 允许重试\n13\t# hook_output 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionDenied\",\"retry\":true}}'\n14\t\n15\tdispatch_to_skill \"07\" || true\n16\thook_output 0 '{}'\n17\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\08-post-tool-use\\base.sh"},"tool_use_id":"call_66cd5c99b05045e6a07474c1","tool_response":"1\t#!/bin/bash\n2\t# 08-post-tool-use: 工具调用成功后触发 (每个工具调用)\n3\t# 输出: decision (block), reason, additionalContext\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\ttool_name=$(json_get '.tool_name')\n9\ttool_response=$(json_get '.tool_response')\n10\t\n11\tlog \"INFO\" \"tool=$tool_name\"\n12\t\n13\t# 示例: 在编辑文件后提醒\n14\t# if [ \"$tool_name\" = \"Edit\" ] || [ \"$tool_name\" = \"Write\" ]; then\n15\t#   hook_output 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"文件已修改\"}}'\n16\t# fi\n17\t\n18\t# 示例: 阻止后续操作\n19\t# hook_output 2 '{\"decision\":\"block\",\"reason\":\"不允许在此目录操作\"}'\n20\t\n21\tdispatch_to_skill \"08\" || true\n22\t\n23\thook_output 0 '{}'\n24\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\09-post-tool-use-failure\\base.sh"},"tool_use_id":"call_5ecd687a3d6342b4b8bfd5a3","tool_response":"1\t#!/bin/bash\n2\t# 09-post-tool-use-failure: 工具调用失败后触发 (每次失败)\n3\t# 输出: decision (block), reason, additionalContext\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\ttool_name=$(json_get '.tool_name')\n9\terror=$(json_get '.error')\n10\t\n11\tlog \"WARN\" \"tool=$tool_name error=$error\"\n12\t\n13\t# 示例: 记录失败并提供建议\n14\t# hook_output 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUseFailure\",\"additionalContext\":\"工具调用失败，请检查参数\"}}'\n15\t\n16\tdispatch_to_skill \"09\" || true\n17\thook_output 0 '{}'\n18\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\10-post-tool-batch\\base.sh"},"tool_use_id":"call_dd3a2db8be2e4a5ebf7375f6","tool_response":"1\t#!/bin/bash\n2\t# 10-post-tool-batch: 完整批次并行工具调用解决后触发 (每批次一次)\n3\t# 退出 2 可在下一个模型调用之前停止代理循环\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tlog \"INFO\" \"batch completed\"\n9\t\n10\t# 示例: 批次完成后阻止后续操作\n11\t# hook_output 2 '{\"decision\":\"block\",\"reason\":\"批次执行超出限制\"}'\n12\t\n13\tdispatch_to_skill \"10\" || true\n14\thook_output 0 '{}'\n15\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\11-notification\\base.sh"},"tool_use_id":"call_508e8e1075e2424687720e0b","tool_response":"1\t#!/bin/bash\n2\t# 11-notification: Claude Code 发送通知时触发 (每次通知)\n3\t# 字段: message, notification_type\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tmessage=$(json_get '.message')\n9\tnotification_type=$(json_get '.notification_type')\n10\t\n11\tlog \"INFO\" \"type=$notification_type message=$message\"\n12\t\n13\tdispatch_to_skill \"11\" || true\n14\thook_output 0 '{}'\n15\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\12-subagent-start\\base.sh"},"tool_use_id":"call_272a33f3d2c74c579ff37c99","tool_response":"1\t#!/bin/bash\n2\t# 12-subagent-start: Subagent 生成时触发 (每次生成)\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\tagent_type=$(json_get '.agent_type')\n8\t\n9\tlog \"INFO\" \"agent_type=$agent_type\"\n10\t\n11\tdispatch_to_skill \"12\" || true\n12\thook_output 0 '{}'\n13\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\13-subagent-stop\\base.sh"},"tool_use_id":"call_b79b6dfc59bd49599909550d","tool_response":"1\t#!/bin/bash\n2\t# 13-subagent-stop: Subagent 完成时触发 (每次完成)\n3\t# 退出 2 可防止 subagent 停止\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tagent_type=$(json_get '.agent_type')\n9\tresult=$(json_get '.result')\n10\t\n11\tlog \"INFO\" \"agent_type=$agent_type\"\n12\t\n13\t# 示例: 阻止 subagent 停止，继续工作\n14\t# hook_output 2 '{\"decision\":\"block\",\"reason\":\"Subagent 尚未完成所有任务\"}'\n15\t\n16\tdispatch_to_skill \"13\" || true\n17\thook_output 0 '{}'\n18\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\14-task-created\\base.sh"},"tool_use_id":"call_889ab85bbe4a4dcabb1d23bd","tool_response":"1\t#!/bin/bash\n2\t# 14-task-created: 通过 TaskCreate 创建任务时触发 (每次创建)\n3\t# 退出 2 可回滚任务创建\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\ttask_id=$(json_get '.task_id')\n9\tsubject=$(json_get '.subject')\n10\t\n11\tlog \"INFO\" \"id=$task_id subject=$subject\"\n12\t\n13\t# 示例: 阻止特定任务创建\n14\t# hook_output 2 '{\"continue\":false,\"stopReason\":\"不允许创建此类任务\"}'\n15\t\n16\tdispatch_to_skill \"14\" || true\n17\thook_output 0 '{}'\n18\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\15-task-completed\\base.sh"},"tool_use_id":"call_f9a3b03b9b1b429388a1b035","tool_response":"1\t#!/bin/bash\n2\t# 15-task-completed: 任务被标记为已完成时触发 (每次完成)\n3\t# 退出 2 可防止任务被标记为已完成\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\ttask_id=$(json_get '.task_id')\n9\tsubject=$(json_get '.subject')\n10\t\n11\tlog \"INFO\" \"id=$task_id subject=$subject\"\n12\t\n13\t# 示例: 阻止过早标记完成\n14\t# hook_output 2 '{\"continue\":false,\"stopReason\":\"任务验证未通过\"}'\n15\t\n16\tdispatch_to_skill \"15\" || true\n17\thook_output 0 '{}'\n18\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\16-stop\\base.sh"},"tool_use_id":"call_33ae2bdc04944bb98c7f0df3","tool_response":"1\t#!/bin/bash\n2\t# 16-stop: Claude 完成响应时触发 (每轮一次)\n3\t# 退出 2 可防止 Claude 停止，继续对话\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tlog \"INFO\" \"Claude finished response\"\n9\t\n10\t# 从 hook 输入获取 session_id\n11\tSESSION_ID=$(json_get '.session_id')\n12\tlog \"INFO\" \"session_id=$SESSION_ID\"\n13\t\n14\t# 自动注册新增 skills\n15\tREGISTER_RESULT=$(bash \"$SCRIPT_DIR/skill-register.sh\")\n16\tif [ \"$REGISTER_RESULT\" = \"UPDATED\" ]; then\n17\t  log \"INFO\" \"registry.conf updated with new skills\"\n18\tfi\n19\t\n20\t# 只运行当前 session 激活的 skill 的 16Stop.sh\n21\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n22\tACTIVE_FILE=\"$PROJECT_DIR/.claude/skills/.active\"\n23\t\n24\tif [ -s \"$ACTIVE_FILE\" ] && [ -n \"$SESSION_ID\" ]; then\n25\t  source \"$PROJECT_DIR/.claude/skills/active.sh\"\n26\t\n27\t  # 精确获取当前 session 的 skill（不再遍历所有）\n28\t  SKILL_NAME=$(active_get \"$SESSION_ID\")\n29\t  if [ -n \"$SKILL_NAME\" ]; then\n30\t    STOP_SCRIPT=\"$PROJECT_DIR/.claude/skills/$SKILL_NAME/scripts/16Stop.sh\"\n31\t    if [ -f \"$STOP_SCRIPT\" ]; then\n32\t      log \"INFO\" \"Running 16Stop.sh for $SKILL_NAME (session=$SESSION_ID)\"\n33\t      bash \"$STOP_SCRIPT\" \"$SESSION_ID\" 2>/dev/null\n34\t    fi\n35\t  fi\n36\tfi\n37\t\n38\t# Windows: bring terminal to foreground when Claude finishes\n39\tif [ \"$OS_TYPE\" = \"windows\" ] && [ -f \"$SCRIPT_DIR/task-complete-notify.sh\" ]; then\n40\t  source \"$SCRIPT_DIR/task-complete-notify.sh\"\n41\tfi\n42\t\n43\thook_output 0 '{}'\n44\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\16-stop\\task-complete-notify.sh"},"tool_use_id":"call_75fbe9cc673c40aaae6aa512","tool_response":"1\t#!/bin/bash\n2\t# task-complete-notify.sh — Bring terminal to foreground when Claude finishes\n3\t# Trigger: Stop event (hook 16)\n4\t# Called from 16-stop/base.sh after sourcing hooks/base.sh\n5\t# Behavior: Bring window to foreground only (no Toast notification)\n6\t# Always exit 0, never block Claude\n7\t\n8\t# Already have: HOOKS_DIR, HOOK_INPUT, log(), json_get(), OS_TYPE, PYTHON_CMD, LOG_FILE\n9\tFOREGROUND_PS1=\"$HOOKS_DIR/lib/win32-foreground.ps1\"\n10\t\n11\t# Only run on Windows\n12\tif [ \"$OS_TYPE\" != \"windows\" ]; then\n13\t  return 0 2>/dev/null || true\n14\tfi\n15\t\n16\tlog \"INFO\" \"[task-notify] Claude task completed, bringing terminal to foreground\"\n17\t\n18\t# Bring window to foreground (pass project dir name as hint for multi-window matching)\n19\tPROJECT_HINT=$(basename \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || echo \"\")\n20\tif [ -f \"$FOREGROUND_PS1\" ]; then\n21\t  FOREGROUND_WIN_PATH=$(cygpath -w \"$FOREGROUND_PS1\" 2>/dev/null || echo \"$FOREGROUND_PS1\")\n22\t  log \"INFO\" \"[task-notify] Calling foreground script (hint=$PROJECT_HINT)\"\n23\t  powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$FOREGROUND_WIN_PATH\" -Hint \"$PROJECT_HINT\" 2>>\"$LOG_FILE\"\n24\t  log \"INFO\" \"[task-notify] foreground script done\"\n25\telse\n26\t  log \"WARNING\" \"[task-notify] win32-foreground.ps1 not found at $FOREGROUND_PS1\"\n27\tfi\n28\t\n29\treturn 0 2>/dev/null || true\n30\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\16-stop\\skill-register.sh"},"tool_use_id":"call_952f4be92ea24c618fb4bfb8","tool_response":"1\t#!/bin/bash\n2\t# skill-register: 扫描 skills 目录，将新增的 skill 自动注册到 registry.conf\n3\t# 被 29-session-end/base.sh 调用\n4\t\n5\tPROJECT_DIR=\"$CLAUDE_PROJECT_DIR\"\n6\tSKILLS_DIR=\"$PROJECT_DIR/.claude/skills\"\n7\tREGISTRY=\"$SKILLS_DIR/registry.conf\"\n8\t\n9\t[ -d \"$SKILLS_DIR\" ] || exit 0\n10\t\n11\t# 确保 registry.conf 存在\n12\ttouch \"$REGISTRY\"\n13\t\n14\t# 扫描所有包含 SKILL.md 的目录\n15\tCHANGED=0\n16\tfor skill_dir in \"$SKILLS_DIR\"/*/; do\n17\t  [ -d \"$skill_dir\" ] || continue\n18\t  SKILL_NAME=$(basename \"$skill_dir\")\n19\t  [ -f \"$skill_dir/SKILL.md\" ] || continue\n20\t\n21\t  # 检查是否已在 registry 中\n22\t  if ! grep -qx \"$SKILL_NAME\" \"$REGISTRY\" 2>/dev/null; then\n23\t    echo \"$SKILL_NAME\" >> \"$REGISTRY\"\n24\t    CHANGED=1\n25\t  fi\n26\tdone\n27\t\n28\t# 输出变更信息供 base.sh 日志使用\n29\t[ \"$CHANGED\" -eq 1 ] && echo \"UPDATED\"\n30\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\17-stop-failure\\base.sh"},"tool_use_id":"call_eecc4d8b98be466daffdf4a4","tool_response":"1\t#!/bin/bash\n2\t# 17-stop-failure: 回合因 API 错误结束时触发 (每次失败)\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\terror=$(json_get '.error')\n8\t\n9\tlog \"ERROR\" \"API error=$error\"\n10\t\n11\tdispatch_to_skill \"17\" || true\n12\thook_output 0 '{}'\n13\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\18-teammate-idle\\base.sh"},"tool_use_id":"call_7b9ef99c23ea4583ada8cabf","tool_response":"1\t#!/bin/bash\n2\t# 18-teammate-idle: Agent team 队友即将空闲时触发\n3\t# 退出 2 可防止队友空闲 (队友继续工作)\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tteammate=$(json_get '.teammate')\n9\t\n10\tlog \"INFO\" \"teammate=$teammate\"\n11\t\n12\t# 示例: 让队友继续工作\n13\t# hook_output 2 '{\"continue\":false,\"stopReason\":\"还有分配给该队友的任务\"}'\n14\t\n15\tdispatch_to_skill \"18\" || true\n16\thook_output 0 '{}'\n17\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\19-instructions-loaded\\base.sh"},"tool_use_id":"call_409009bd3d764caabe4d0e85","tool_response":"1\t#!/bin/bash\n2\t# 19-instructions-loaded: CLAUDE.md 或 .claude/rules/*.md 加载到上下文时触发\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\tfile_path=$(json_get '.file_path')\n8\t\n9\tlog \"INFO\" \"file=$file_path\"\n10\t\n11\tdispatch_to_skill \"19\" || true\n12\thook_output 0 '{}'\n13\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\20-config-change\\base.sh"},"tool_use_id":"call_05ea674f043e485bbea28fe2","tool_response":"1\t#!/bin/bash\n2\t# 20-config-change: 配置文件在会话期间更改时触发\n3\t# 退出 2 可阻止配置更改生效 (除了 policy_settings)\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tconfig_file=$(json_get '.config_file')\n9\tchange_type=$(json_get '.change_type')\n10\t\n11\tlog \"INFO\" \"file=$config_file type=$change_type\"\n12\t\n13\t# 示例: 阻止配置更改\n14\t# hook_output 2 '{\"decision\":\"block\",\"reason\":\"不允许在运行时更改此配置\"}'\n15\t\n16\tdispatch_to_skill \"20\" || true\n17\thook_output 0 '{}'\n18\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\21-cwd-changed\\base.sh"},"tool_use_id":"call_ebddc5d779444490a1c18ab5","tool_response":"1\t#!/bin/bash\n2\t# 21-cwd-changed: 工作目录更改时触发 (如 Claude 执行 cd 命令)\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\told_cwd=$(json_get '.old_cwd')\n8\tnew_cwd=$(json_get '.new_cwd')\n9\t\n10\tlog \"INFO\" \"old=$old_cwd new=$new_cwd\"\n11\t\n12\tdispatch_to_skill \"21\" || true\n13\thook_output 0 '{}'\n14\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\22-file-changed\\base.sh"},"tool_use_id":"call_d7073d124c46422f854e6c7b","tool_response":"1\t#!/bin/bash\n2\t# 22-file-changed: 监视的文件在磁盘上更改时触发\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\tfile_path=$(json_get '.file_path')\n8\tchange_type=$(json_get '.change_type')\n9\t\n10\tlog \"INFO\" \"file=$file_path type=$change_type\"\n11\t\n12\tdispatch_to_skill \"22\" || true\n13\thook_output 0 '{}'\n14\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\23-worktree-create\\base.sh"},"tool_use_id":"call_bb1ea4a03ef8485d8de04fab","tool_response":"1\t#!/bin/bash\n2\t# 23-worktree-create: 通过 --worktree 或 isolation: \"worktree\" 创建 worktree 时触发\n3\t# 任何非零退出代码都会导致 worktree 创建失败\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tlog \"INFO\" \"WorktreeCreate triggered\"\n9\t\n10\t# 示例: 指定 worktree 路径\n11\t# hook_output 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"WorktreeCreate\",\"worktreePath\":\"/custom/path\"}}'\n12\t\n13\tdispatch_to_skill \"23\" || true\n14\thook_output 0 '{}'\n15\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\24-worktree-remove\\base.sh"},"tool_use_id":"call_9d2a276767df48e7a5e46c71","tool_response":"1\t#!/bin/bash\n2\t# 24-worktree-remove: Worktree 被移除时触发 (会话退出或 subagent 完成)\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\tworktree_path=$(json_get '.worktree_path')\n8\t\n9\tlog \"INFO\" \"path=$worktree_path\"\n10\t\n11\tdispatch_to_skill \"24\" || true\n12\thook_output 0 '{}'\n13\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\25-pre-compact\\base.sh"},"tool_use_id":"call_c3c2ce896ee84669bf319c9c","tool_response":"1\t#!/bin/bash\n2\t# 25-pre-compact: 上下文压缩之前触发\n3\t# 退出 2 可阻止压缩\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tlog \"INFO\" \"About to compress context\"\n9\t\n10\t# 示例: 阻止压缩\n11\t# hook_output 2 '{\"decision\":\"block\",\"reason\":\"当前上下文不应被压缩\"}'\n12\t\n13\tdispatch_to_skill \"25\" || true\n14\thook_output 0 '{}'\n15\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\26-post-compact\\base.sh"},"tool_use_id":"call_11350dd6b598431193d15300","tool_response":"1\t#!/bin/bash\n2\t# 26-post-compact: 上下文压缩完成后触发\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\t\n7\tlog \"INFO\" \"Context compressed\"\n8\t\n9\tdispatch_to_skill \"26\" || true\n10\thook_output 0 '{}'\n11\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\27-elicitation\\base.sh"},"tool_use_id":"call_2c18b705f2aa4dc1af956c60","tool_response":"1\t#!/bin/bash\n2\t# 27-elicitation: MCP 服务器在工具调用期间请求用户输入时触发\n3\t# 输出: action (accept/decline/cancel), content\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\tserver=$(json_get '.server')\n9\ttool=$(json_get '.tool')\n10\t\n11\tlog \"INFO\" \"server=$server tool=$tool\"\n12\t\n13\t# 示例: 自动接受\n14\t# hook_output 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"Elicitation\",\"action\":\"accept\",\"content\":\"自动确认\"}}'\n15\t\n16\t# 示例: 拒绝\n17\t# hook_output 2 '{\"hookSpecificOutput\":{\"hookEventName\":\"Elicitation\",\"action\":\"decline\"}}'\n18\t\n19\tdispatch_to_skill \"27\" || true\n20\thook_output 0 '{}'\n21\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\28-elicitation-result\\base.sh"},"tool_use_id":"call_bfda116a824545b68ed2c851","tool_response":"1\t#!/bin/bash\n2\t# 28-elicitation-result: 用户响应 MCP elicitation 后、响应发送回服务器之前触发\n3\t# 退出 2 可阻止响应 (操作变为 decline)\n4\t\n5\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n6\tsource \"$SCRIPT_DIR/../base.sh\"\n7\t\n8\taction=$(json_get '.action')\n9\tcontent=$(json_get '.content')\n10\t\n11\tlog \"INFO\" \"action=$action\"\n12\t\n13\t# 示例: 阻止响应\n14\t# hook_output 2 '{\"hookSpecificOutput\":{\"hookEventName\":\"ElicitationResult\",\"action\":\"decline\"}}'\n15\t\n16\tdispatch_to_skill \"28\" || true\n17\thook_output 0 '{}'\n18\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\29-session-end\\base.sh"},"tool_use_id":"call_6d6dd3e3053b4f6bac45228e","tool_response":"1\t#!/bin/bash\n2\t# 29-session-end: 会话终止时触发 (每个会话一次)\n3\t\n4\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n5\tsource \"$SCRIPT_DIR/../base.sh\"\n6\tsource \"$HOOKS_DIR/lib/backend.sh\"\n7\t\n8\tsession_id=$(json_get '.session_id')\n9\treason=$(json_get '.reason')\n10\t\n11\tlog \"INFO\" \"session=$session_id reason=$reason\"\n12\t\n13\tdispatch_to_skill \"29\" || true\n14\t\n15\trelease_session_issues() {\n16\t  local sid\n17\t  sid=$(json_get '.session_id')\n18\t  [ -z \"$sid\" ] && return 0\n19\t\n20\t  if ! _backend_available; then\n21\t    log \"INFO\" \"Backend unreachable, skipping session release for $sid\"\n22\t    return 0\n23\t  fi\n24\t\n25\t  local result\n26\t  result=$(_call_backend \"/api/issue/release-session\" \"{\\\"session_id\\\":\\\"$sid\\\"}\") || return 0\n27\t\n28\t  local count\n29\t  count=$(echo \"$result\" | jq -r '.count // 0' 2>/dev/null)\n30\t  [ \"$count\" -gt 0 ] && log \"INFO\" \"Released $count issues for session $sid\"\n31\t}\n32\t\n33\trelease_session_issues\n34\t\n35\t# SR-3: 注销会话\n36\tunregister_session() {\n37\t  local sid reason\n38\t  sid=$(json_get '.session_id')\n39\t  reason=$(json_get '.reason')\n40\t  [ -z \"$sid\" ] && return 0\n41\t\n42\t  if ! _backend_available; then\n43\t    log \"DEBUG\" \"Backend unreachable, skipping session close for $sid\"\n44\t    return 0\n45\t  fi\n46\t\n47\t  _call_backend \"/api/session/close\" \"{\\\"session_id\\\":\\\"$sid\\\",\\\"reason\\\":\\\"$reason\\\"}\" > /dev/null 2>&1\n48\t  log \"INFO\" \"Session unregistered from backend: $sid\"\n49\t}\n50\t\n51\tunregister_session\n52\t\n53\thook_output 0 '{}'\n54\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\lib\\backend.sh"},"tool_use_id":"call_b3bc88842c1b45efa7d6f071","tool_response":"1\t# .claude/hooks/lib/backend.sh\n2\t# Hooks 统一后端调用模块\n3\t# 供 hooks 脚本 source 引入，提供后端 API 调用封装\n4\t# 与 skills/backend.sh 功能相同但独立维护，避免 hooks 依赖 skills 目录\n5\t\n6\tBACKEND_URL=\"\"\n7\t\n8\t# 引入统一配置读取（~/.claude-tap-plus/backend.json）\n9\tsource \"$CLAUDE_PROJECT_DIR/.claude/lib/config.sh\"\n10\t\n11\t# 加载后端 URL（委托给 config.sh 的 load_backend_config）\n12\t_load_backend_url() {\n13\t  load_backend_config\n14\t}\n15\t\n16\t# 检查后端是否可用\n17\t_backend_available() {\n18\t  _load_backend_url\n19\t  [ -n \"$BACKEND_URL\" ] && curl -s --max-time 2 \"$BACKEND_URL/health\" > /dev/null 2>&1\n20\t}\n21\t\n22\t# 检查后端是否必须可用（用于 claim 等安全敏感操作）\n23\t# 返回码: 0=可用, 1=已配置但不可达, 2=未配置\n24\t_require_backend() {\n25\t  _load_backend_url\n26\t  if [ -z \"$BACKEND_URL\" ]; then\n27\t    return 2\n28\t  fi\n29\t  if curl -s --max-time 2 \"$BACKEND_URL/health\" > /dev/null 2>&1; then\n30\t    return 0\n31\t  fi\n32\t  return 1\n33\t}\n34\t\n35\t# 调用后端 API，失败时静默返回空\n36\t# $1 = endpoint (如 /api/session/register)\n37\t# $2 = JSON data\n38\t_call_backend() {\n39\t  local endpoint=\"$1\"\n40\t  local data=\"$2\"\n41\t  _load_backend_url\n42\t  [ -z \"$BACKEND_URL\" ] && return 1\n43\t\n44\t  local resp\n45\t  resp=$(curl -s --max-time 5 -X POST \"$BACKEND_URL$endpoint\" \\\n46\t    -H \"Content-Type: application/json\" \\\n47\t    -d \"$data\" 2>/dev/null)\n48\t  local rc=$?\n49\t  if [ $rc -ne 0 ] || [ -z \"$resp\" ]; then\n50\t    return 1\n51\t  fi\n52\t  echo \"$resp\"\n53\t}\n54\t\n55\t# 获取当前 session_id\n56\t_get_session_id() {\n57\t  if [ -n \"${CLAUDE_SESSION_ID:-}\" ]; then\n58\t    echo \"$CLAUDE_SESSION_ID\"\n59\t    return\n60\t  fi\n61\t  if command -v json_get >/dev/null 2>&1; then\n62\t    json_get '.session_id' 2>/dev/null\n63\t  fi\n64\t}\n65\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\.claude\\hooks\\lib\\win32-foreground.ps1"},"tool_use_id":"call_e140b5d3450d49fea0794ccf","tool_response":"1\t# win32-foreground.ps1 — Force terminal to foreground (nuclear mode)\n2\t# Disable Windows foreground lock, steal focus, play sound, flash taskbar\n3\t# Supports multiple terminal windows: enumerates all windows and matches by title hint\n4\t\n5\tparam([string]$Hint = \"\")\n6\t\n7\t$LogFile = Join-Path $PSScriptRoot \"win32-foreground.log\"\n8\t\n9\tfunction Log-Msg {\n10\t    param([string]$Message)\n11\t    $ts = Get-Date -Format \"yyyy-MM-dd HH:mm:ss\"\n12\t    Add-Content -Path $LogFile -Value \"[$ts] $Message\"\n13\t}\n14\t\n15\tLog-Msg \"=== win32-foreground started (hint='$Hint') ===\"\n16\t\n17\tAdd-Type @\"\n18\tusing System;\n19\tusing System.Runtime.InteropServices;\n20\tusing System.Text;\n21\tpublic class WinAPI {\n22\t    [DllImport(\"user32.dll\")]\n23\t    public static extern IntPtr GetForegroundWindow();\n24\t    [DllImport(\"user32.dll\")]\n25\t    public static extern bool SetForegroundWindow(IntPtr hWnd);\n26\t    [DllImport(\"user32.dll\")]\n27\t    public static extern bool BringWindowToTop(IntPtr hWnd);\n28\t    [DllImport(\"user32.dll\")]\n29\t    public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);\n30\t    [DllImport(\"user32.dll\")]\n31\t    public static extern bool IsIconic(IntPtr hWnd);\n32\t    [DllImport(\"user32.dll\")]\n33\t    public static extern void keybd_event(byte bVk, byte bScan, uint dwFlags, UIntPtr dwExtraInfo);\n34\t    [DllImport(\"user32.dll\")]\n35\t    public static extern bool SetWindowPos(IntPtr hWnd, IntPtr hWndInsertAfter, int X, int Y, int cx, int cy, uint uFlags);\n36\t    [DllImport(\"user32.dll\")]\n37\t    public static extern bool FlashWindow(IntPtr hWnd, bool bInvert);\n38\t    [DllImport(\"user32.dll\")]\n39\t    public static extern bool SystemParametersInfo(uint uiAction, uint uiParam, IntPtr pvParam, uint fWinIni);\n40\t    public static readonly IntPtr HWND_TOPMOST = new IntPtr(-1);\n41\t    public static readonly IntPtr HWND_NOTOPMOST = new IntPtr(-2);\n42\t    public const uint SWP_NOSIZE = 0x0001;\n43\t    public const uint SWP_NOMOVE = 0x0002;\n44\t    public const int SW_RESTORE = 9;\n45\t    public const int SW_SHOW = 5;\n46\t    public const uint SPI_GETFOREGROUNDLOCKTIMEOUT = 0x2000;\n47\t    public const uint SPI_SETFOREGROUNDLOCKTIMEOUT = 0x2001;\n48\t    public const uint SPIF_SENDCHANGE = 0x0002;\n49\t    public delegate bool EnumWindowsProc(IntPtr hWnd, IntPtr lParam);\n50\t    [DllImport(\"user32.dll\")]\n51\t    public static extern bool EnumWindows(EnumWindowsProc lpEnumFunc, IntPtr lParam);\n52\t    [DllImport(\"user32.dll\")]\n53\t    public static extern uint GetWindowThreadProcessId(IntPtr hWnd, out uint lpdwProcessId);\n54\t    [DllImport(\"user32.dll\", CharSet = CharSet.Unicode)]\n55\t    public static extern int GetWindowText(IntPtr hWnd, StringBuilder lpString, int nMaxCount);\n56\t    [DllImport(\"user32.dll\")]\n57\t    public static extern bool IsWindowVisible(IntPtr hWnd);\n58\t}\n59\t\"@\n60\t\n61\t# --- Enumerate visible windows for a specific PID ---\n62\tfunction Get-WindowsForPid {\n63\t    param([int]$TargetPid)\n64\t    $script:enumResults = @()\n65\t    $callback = [WinAPI+EnumWindowsProc]{\n66\t        param([IntPtr]$hWnd, [IntPtr]$lParam)\n67\t        $procId = [uint32]0\n68\t        [WinAPI]::GetWindowThreadProcessId($hWnd, [ref]$procId) | Out-Null\n69\t        if ($procId -eq $TargetPid -and [WinAPI]::IsWindowVisible($hWnd)) {\n70\t            $sb = New-Object System.Text.StringBuilder 256\n71\t            [WinAPI]::GetWindowText($hWnd, $sb, 256) | Out-Null\n72\t            $title = $sb.ToString()\n73\t            if ($title) {\n74\t                $script:enumResults += @{ Hwnd = $hWnd; Title = $title }\n75\t            }\n76\t        }\n77\t        return $true\n78\t    }\n79\t    [WinAPI]::EnumWindows($callback, [IntPtr]::Zero) | Out-Null\n80\t    return $script:enumResults\n81\t}\n82\t\n83\t# --- Find terminal window ---\n84\tfunction Find-TerminalWindow {\n85\t    param([string]$TitleHint = \"\")\n86\t    $terminalNames = @(\n87\t        'WindowsTerminal', 'WindowsTerminal.exe', 'wt', 'wt.exe',\n88\t        'ConEmu64', 'ConEmu64.exe', 'cmder', 'cmder.exe'\n89\t    )\n90\t\n91\t    # Walk parent chain to find terminal PID\n92\t    $currentPid = $PID\n93\t    $seen = @{}\n94\t    $ancestors = @()\n95\t    for ($i = 0; $i -lt 20; $i++) {\n96\t        try {\n97\t            $proc = Get-CimInstance Win32_Process -Filter \"ProcessId = $currentPid\" -ErrorAction SilentlyContinue\n98\t            if (-not $proc) { break }\n99\t            $parentPid = $proc.ParentProcessId\n100\t            if ($seen.ContainsKey($parentPid) -or $parentPid -eq $currentPid) { break }\n101\t            $seen[$parentPid] = $true\n102\t            $parentProc = Get-CimInstance Win32_Process -Filter \"ProcessId = $parentPid\" -ErrorAction SilentlyContinue\n103\t            if ($parentProc) { $ancestors += @{ Pid = $parentPid; Name = $parentProc.Name } }\n104\t            $currentPid = $parentPid\n105\t        } catch { break }\n106\t    }\n107\t\n108\t    # Strategy 1: Find terminal in ancestors, enumerate its windows\n109\t    foreach ($anc in $ancestors) {\n110\t        if ($terminalNames -contains $anc.Name) {\n111\t            $windows = Get-WindowsForPid -TargetPid $anc.Pid\n112\t            if ($windows.Count -gt 0) {\n113\t                $picked = Pick-Window -Windows $windows -Hint $TitleHint\n114\t                return @{ Pid = $anc.Pid; Name = $anc.Name; Hwnd = $picked.Hwnd; Title = $picked.Title }\n115\t            }\n116\t            # No visible windows via EnumWindows, try MainWindowHandle\n117\t            try {\n118\t                $p = [System.Diagnostics.Process]::GetProcessById($anc.Pid)\n119\t                if ($p.MainWindowHandle -ne [IntPtr]::Zero) {\n120\t                    return @{ Pid = $anc.Pid; Name = $anc.Name; Hwnd = $p.MainWindowHandle; Title = $p.MainWindowTitle }\n121\t                }\n122\t            } catch {}\n123\t        }\n124\t    }\n125\t\n126\t    # Strategy 2: Any ancestor with a window\n127\t    foreach ($anc in $ancestors) {\n128\t        try {\n129\t            $p = [System.Diagnostics.Process]::GetProcessById($anc.Pid)\n130\t            if ($p.MainWindowHandle -ne [IntPtr]::Zero) {\n131\t                return @{ Pid = $anc.Pid; Name = $anc.Name; Hwnd = $p.MainWindowHandle; Title = $p.MainWindowTitle }\n132\t            }\n133\t        } catch {}\n134\t    }\n135\t\n136\t    # Strategy 3: Search by process name (last resort)\n137\t    foreach ($name in @('WindowsTerminal', 'ConEmu64', 'cmder')) {\n138\t        try {\n139\t            $procs = [System.Diagnostics.Process]::GetProcessesByName($name)\n140\t            foreach ($p in $procs) {\n141\t                if ($p.MainWindowHandle -ne [IntPtr]::Zero) {\n142\t                    return @{ Pid = $p.Id; Name = $name; Hwnd = $p.MainWindowHandle; Title = $p.MainWindowTitle }\n143\t                }\n144\t            }\n145\t        } catch {}\n146\t    }\n147\t    return $null\n148\t}\n149\t\n150\t# --- Pick best window from candidates ---\n151\tfunction Pick-Window {\n152\t    param([array]$Windows, [string]$Hint = \"\")\n153\t    if ($Windows.Count -eq 1) { return $Windows[0] }\n154\t\n155\t    Log-Msg \"Multiple windows found ($($Windows.Count)), selecting best match...\"\n156\t\n157\t    # Priority 1: exact hint match\n158\t    if ($Hint) {\n159\t        foreach ($w in $Windows) {\n160\t            if ($w.Title -like \"*$Hint*\") {\n161\t                Log-Msg \"Hint '$Hint' matched: $($w.Title)\"\n162\t                return $w\n163\t            }\n164\t        }\n165\t    }\n166\t\n167\t    # Priority 2: Claude Code indicators\n168\t    # ● (U+25CF) appears as non-ASCII, so check first char codepoint > 127\n169\t    # Also match \"claude\" keyword case-insensitively\n170\t    foreach ($w in $Windows) {\n171\t        $firstCharCode = if ($w.Title.Length -gt 0) { [int]$w.Title[0] } else { 0 }\n172\t        if ($firstCharCode -gt 127 -or $w.Title.ToLower().Contains('claude')) {\n173\t            Log-Msg \"Claude indicator matched (char=$firstCharCode): $($w.Title)\"\n174\t            return $w\n175\t        }\n176\t    }\n177\t\n178\t    # Priority 3: fall back to first window\n179\t    Log-Msg \"No hint or Claude match, using first window: $($Windows[0].Title)\"\n180\t    return $Windows[0]\n181\t}\n182\t\n183\t# --- Main ---\n184\t$info = Find-TerminalWindow -TitleHint $Hint\n185\tif (-not $info) {\n186\t    Log-Msg \"ERROR: No terminal found\"\n187\t    exit 1\n188\t}\n189\t$hwnd = $info.Hwnd\n190\tLog-Msg \"Target: $($info.Name) PID=$($info.Pid) hwnd=$hwnd title='$($info.Title)'\"\n191\t\n192\t# Step 1: Save and disable foreground lock timeout\n193\t$oldTimeout = [IntPtr]::Zero\n194\t[WinAPI]::SystemParametersInfo([WinAPI]::SPI_GETFOREGROUNDLOCKTIMEOUT, 0, $oldTimeout, 0) | Out-Null\n195\tLog-Msg \"Current foreground lock timeout: $oldTimeout\"\n196\t\n197\t$setResult = [WinAPI]::SystemParametersInfo(\n198\t    [WinAPI]::SPI_SETFOREGROUNDLOCKTIMEOUT, 0,\n199\t    [IntPtr]::Zero, [WinAPI]::SPIF_SENDCHANGE)\n200\tLog-Msg \"Disable foreground lock: $setResult\"\n201\t\n202\t# Step 2: Restore if minimized\n203\tif ([WinAPI]::IsIconic($hwnd)) {\n204\t    [WinAPI]::ShowWindow($hwnd, [WinAPI]::SW_RESTORE)\n205\t    Start-Sleep -Milliseconds 100\n206\t}\n207\t[WinAPI]::ShowWindow($hwnd, [WinAPI]::SW_SHOW)\n208\t\n209\t# Step 3: Alt key trick\n210\t[WinAPI]::keybd_event(0x12, 0, 0, [UIntPtr]::Zero)\n211\t[WinAPI]::keybd_event(0x12, 0, 0x2, [UIntPtr]::Zero)\n212\t\n213\t# Step 4: COM AppActivate\n214\ttry {\n215\t    $wsh = New-Object -ComObject WScript.Shell\n216\t    if ($info.Title) {\n217\t        $r = $wsh.AppActivate($info.Title)\n218\t        Log-Msg \"COM AppActivate(title)=$r\"\n219\t    }\n220\t    if (-not $r) {\n221\t        $r = $wsh.AppActivate($info.Name)\n222\t        Log-Msg \"COM AppActivate(name)=$r\"\n223\t    }\n224\t} catch {\n225\t    Log-Msg \"COM failed\"\n226\t}\n227\t\n228\t# Step 5: SetForegroundWindow (should work now with lock disabled)\n229\t$r1 = [WinAPI]::SetForegroundWindow($hwnd)\n230\t$r2 = [WinAPI]::BringWindowToTop($hwnd)\n231\tLog-Msg \"SetForeground=$r1 BringToTop=$r2\"\n232\t\n233\t# Step 6: Verify\n234\tStart-Sleep -Milliseconds 100\n235\t$nowFg = [WinAPI]::GetForegroundWindow()\n236\tif ($nowFg -eq $hwnd) {\n237\t    Log-Msg \"SUCCESS: Window is now foreground!\"\n238\t} else {\n239\t    Log-Msg \"WARNING: Foreground is still $nowFg (target $hwnd)\"\n240\t}\n241\t\n242\t# Step 7: TOPMOST for 1 second to ensure visibility\n243\t[WinAPI]::SetWindowPos($hwnd, [WinAPI]::HWND_TOPMOST, 0, 0, 0, 0,\n244\t    [WinAPI]::SWP_NOSIZE -bor [WinAPI]::SWP_NOMOVE)\n245\tStart-Sleep -Milliseconds 1000\n246\t[WinAPI]::SetWindowPos($hwnd, [WinAPI]::HWND_NOTOPMOST, 0, 0, 0, 0,\n247\t    [WinAPI]::SWP_NOSIZE -bor [WinAPI]::SWP_NOMOVE)\n248\t\n249\t# Step 8: Flash taskbar\n250\tfor ($i = 0; $i -lt 6; $i++) {\n251\t    [WinAPI]::FlashWindow($hwnd, $true)\n252\t    Start-Sleep -Milliseconds 200\n253\t}\n254\t\n255\t# Step 9: Play sound\n256\ttry { [System.Media.SystemSounds]::Asterisk.Play() } catch {}\n257\t\n258\t# Step 10: Restore original foreground lock timeout\n259\t[WinAPI]::SystemParametersInfo(\n260\t    [WinAPI]::SPI_SETFOREGROUNDLOCKTIMEOUT, 0,\n261\t    $oldTimeout, [WinAPI]::SPIF_SENDCHANGE) | Out-Null\n262\tLog-Msg \"Foreground lock timeout restored to $oldTimeout\"\n263\t\n264\tLog-Msg \"=== done ===\"\n265\t"}]}
