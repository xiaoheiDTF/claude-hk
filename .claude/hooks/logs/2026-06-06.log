en(\"--db=\"):]\n42\t\t\t// 解析 --host 参数（空格分隔形式）\n43\t\t\tcase arg == \"--host\" && i+1 < len(args):\n44\t\t\t\ti++\n45\t\t\t\tcfg.Host = args[i]\n46\t\t\t// 解析 --host=HOST 形式\n47\t\t\tcase strings.HasPrefix(arg, \"--host=\"):\n48\t\t\t\tcfg.Host = arg[len(\"--host=\"):]\n49\t\t\t}\n50\t\t}\n51\t\n52\t\t// 初始化文件日志器\n53\t\tlogDir := trace.DefaultTraceDir()\n54\t\tif cfg.DBPath != \"\" && cfg.DBPath != \"backend.db\" {\n55\t\t\tlogDir = filepath.Dir(cfg.DBPath)\n56\t\t}\n57\t\tif err := logger.Init(logDir, true, logger.DEBUG); err != nil {\n58\t\t\tlog.Printf(\"warning: logger init failed: %v\", err)\n59\t\t}\n60\t\tdefer logger.Close()\n61\t\tcfg.LogDir = logDir\n62\t\tlogger.Info(\"backend.cmd\", \"backend starting: host=%s port=%d db=%s\", cfg.Host, cfg.Port, cfg.DBPath)\n63\t\n64\t\t// 写入 backend.json，让代理进程知道后端在哪里\n65\t\tif err := WriteBackendInfo(BackendInfo{Host: cfg.Host, Port: cfg.Port}); err != nil {\n66\t\t\tlogger.Warn(\"backend.cmd\", \"write backend.json failed: %v\", err)\n67\t\t}\n68\t\t// 后端退出时删除 backend.json\n69\t\tdefer func() {\n70\t\t\tif err := RemoveBackendInfo(); err != nil {\n71\t\t\t\tlogger.Warn(\"backend.cmd\", \"remove backend.json failed: %v\", err)\n72\t\t\t}\n73\t\t}()\n74\t\n75\t\t// 根据配置创建后端服务器实例\n76\t\tsrv, err := backend.NewServer(cfg)\n77\t\tif err != nil {\n78\t\t\tlog.Fatalf(\"create server: %v\", err)\n79\t\t}\n80\t\t// 函数退出时确保关闭服务器资源\n81\t\tdefer srv.Close()\n82\t\n83\t\t// 启动服务器并开始监听请求\n84\t\tif err := srv.Start(); err != nil {\n85\t\t\tlog.Fatalf(\"server error: %v\", err)\n86\t\t}\n87\t}\n88\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\cmd\\claude-tap\\backend_autostart.go"},"tool_use_id":"call_e37feefb8f164ad08e8fb3f5","tool_response":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"net/http\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"runtime\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n14\t)\n15\t\n16\t// backendHealthURL 根据 backend.json 中的信息构建 /health 检测 URL。\n17\t// 如果 backend.json 不存在或内容无效，使用默认地址 127.0.0.1:8080。\n18\tfunc backendHealthURL() string {\n19\t\tif info := ReadBackendInfo(); info != nil {\n20\t\t\treturn fmt.Sprintf(\"http://%s:%d/health\", info.Host, info.Port)\n21\t\t}\n22\t\treturn \"http://127.0.0.1:8080/health\"\n23\t}\n24\t\n25\t// isBackendRunning 检测后端服务是否在运行（GET /health）。\n26\tfunc isBackendRunning() bool {\n27\t\tclient := &http.Client{Timeout: 2 * time.Second}\n28\t\tresp, err := client.Get(backendHealthURL())\n29\t\tif err != nil {\n30\t\t\treturn false\n31\t\t}\n32\t\tdefer resp.Body.Close()\n33\t\treturn resp.StatusCode == http.StatusOK\n34\t}\n35\t\n36\t// startBackendProcess 启动后端作为独立子进程。\n37\t// 使用当前可执行文件路径 + \"backend\" 子命令，进程完全脱离父进程。\n38\tfunc startBackendProcess() error {\n39\t\texePath, err := os.Executable()\n40\t\tif err != nil {\n41\t\t\treturn fmt.Errorf(\"get executable path: %w\", err)\n42\t\t}\n43\t\n44\t\tcmd := exec.Command(exePath, \"backend\")\n45\t\tcmd.Stdin = nil\n46\t\tcmd.Stdout = nil\n47\t\tcmd.Stderr = nil\n48\t\n49\t\t// 使后端进程独立于代理进程，不受父进程信号影响\n50\t\tif runtime.GOOS == \"windows\" {\n51\t\t\t// Windows: 创建新进程组，脱离父进程控制台\n52\t\t\tcmd.SysProcAttr = syscallSysProcAttr()\n53\t\t} else {\n54\t\t\t// Unix: 创建新进程组\n55\t\t\tcmd.SysProcAttr = unixSysProcAttr()\n56\t\t}\n57\t\n58\t\tif err := cmd.Start(); err != nil {\n59\t\t\treturn fmt.Errorf(\"start backend: %w\", err)\n60\t\t}\n61\t\n62\t\tlogger.Info(\"autostart\", \"backend process started: pid=%d\", cmd.Process.Pid)\n63\t\t// 释放子进程，让其独立运行，父进程不等待\n64\t\tcmd.Process.Release()\n65\t\treturn nil\n66\t}\n67\t\n68\t// waitForBackend 轮询 /health 端点，等待后端就绪。\n69\t// timeout 为最长等待时间，interval 为轮询间隔。\n70\t// 返回 true 表示后端已就绪，false 表示超时。\n71\tfunc waitForBackend(timeout, interval time.Duration) bool {\n72\t\tdeadline := time.Now().Add(timeout)\n73\t\tclient := &http.Client{Timeout: 500 * time.Millisecond}\n74\t\n75\t\tfor time.Now().Before(deadline) {\n76\t\t\tresp, err := client.Get(backendHealthURL())\n77\t\t\tif err == nil {\n78\t\t\t\tresp.Body.Close()\n79\t\t\t\tif resp.StatusCode == http.StatusOK {\n80\t\t\t\t\treturn true\n81\t\t\t\t}\n82\t\t\t}\n83\t\t\ttime.Sleep(interval)\n84\t\t}\n85\t\treturn false\n86\t}\n87\t\n88\t// ensureBackend 检测后端是否在运行，如果未运行则自动启动。\n89\t// 启动失败不阻塞代理，仅记录警告。\n90\tfunc ensureBackend() {\n91\t\t// 步骤 1：检查后端是否已在运行\n92\t\tif isBackendRunning() {\n93\t\t\tlogger.Info(\"autostart\", \"backend already running\")\n94\t\t\treturn\n95\t\t}\n96\t\n97\t\t// 步骤 2：后端未运行，启动新进程\n98\t\tlogger.Info(\"autostart\", \"backend not running, starting...\")\n99\t\tif err := startBackendProcess(); err != nil {\n100\t\t\tlogger.Warn(\"autostart\", \"failed to start backend: %v\", err)\n101\t\t\treturn\n102\t\t}\n103\t\n104\t\t// 步骤 3：等待后端就绪（最多 5 秒）\n105\t\tif waitForBackend(5*time.Second, 200*time.Millisecond) {\n106\t\t\tinfo := ReadBackendInfo()\n107\t\t\tif info != nil {\n108\t\t\t\tfmt.Printf(\"   Backend started at http://%s:%d\\n\", info.Host, info.Port)\n109\t\t\t}\n110\t\t\tlogger.Info(\"autostart\", \"backend ready\")\n111\t\t} else {\n112\t\t\tlogger.Warn(\"autostart\", \"backend did not become healthy within 5s\")\n113\t\t}\n114\t}\n115\t\n116\t// backendAPIBase 返回后端 API 的基础 URL（从 backend.json 读取）。\n117\tfunc backendAPIBase() string {\n118\t\tif info := ReadBackendInfo(); info != nil {\n119\t\t\treturn fmt.Sprintf(\"http://%s:%d\", info.Host, info.Port)\n120\t\t}\n121\t\treturn \"http://127.0.0.1:8080\"\n122\t}\n123\t\n124\t// registerProxyWithBackend 向后端注册本代理进程。\n125\tfunc registerProxyWithBackend(proxyURL string) {\n126\t\tpid := fmt.Sprintf(\"%d\", os.Getpid())\n127\t\tbody, _ := json.Marshal(map[string]string{\"pid\": pid, \"proxy_url\": proxyURL})\n128\t\tresp, err := http.Post(backendAPIBase()+\"/api/proxy/register\", \"application/json\", bytes.NewReader(body))\n129\t\tif err != nil {\n130\t\t\tlogger.Warn(\"autostart\", \"proxy register failed: %v\", err)\n131\t\t\treturn\n132\t\t}\n133\t\tdefer resp.Body.Close()\n134\t\tlogger.Info(\"autostart\", \"proxy registered: pid=%s url=%s\", pid, proxyURL)\n135\t}\n136\t\n137\t// unregisterProxyFromBackend 从后端注销本代理进程。\n138\tfunc unregisterProxyFromBackend() {\n139\t\tpid := fmt.Sprintf(\"%d\", os.Getpid())\n140\t\tbody, _ := json.Marshal(map[string]string{\"pid\": pid})\n141\t\tresp, err := http.Post(backendAPIBase()+\"/api/proxy/unregister\", \"application/json\", bytes.NewReader(body))\n142\t\tif err != nil {\n143\t\t\tlogger.Warn(\"autostart\", \"proxy unregister failed: %v\", err)\n144\t\t\treturn\n145\t\t}\n146\t\tdefer resp.Body.Close()\n147\t\tlogger.Info(\"autostart\", \"proxy unregistered: pid=%s\", pid)\n148\t}\n149\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\domain\\session.go"},"tool_use_id":"call_280c099b123b493ebdf2e15e","tool_response":"1\t// Package domain 定义核心业务实体和枚举类型。\n2\tpackage domain\n3\t\n4\timport \"time\"\n5\t\n6\t// SessionStatus 表示会话的状态。\n7\ttype SessionStatus string\n8\t\n9\tconst (\n10\t\tSessionActive SessionStatus = \"active\" // 活跃会话\n11\t\tSessionClosed SessionStatus = \"closed\" // 已关闭\n12\t)\n13\t\n14\t// Session 对应 sessions 表，记录每次 Claude Code 会话的元数据。\n15\t// 后端只存元数据，消息内容存储在本地 JSONL 文件中。\n16\ttype Session struct {\n17\t\tID             int64         `json:\"id\"`\n18\t\tSessionID      string        `json:\"session_id\"`      // UUID，SessionStart hook 传入，UNIQUE\n19\t\tMachineID      string        `json:\"machine_id\"`       // whoami@hostname\n20\t\tOS             string        `json:\"os\"`               // windows/linux/macos\n21\t\tProjectSlug    string        `json:\"project_slug\"`     // 从 transcript_path 解析\n22\t\tProjectCwd     string        `json:\"project_cwd\"`      // SessionStart hook 的 cwd 字段\n23\t\tTranscriptPath string        `json:\"transcript_path\"`  // Claude Code hook 提供的 transcript_path，便于溯源\n24\t\tLocalTracePath string        `json:\"local_trace_path\"` // proxy 本地 trace 文件路径，由代理首次拦截该 session 的 API 调用时构造写入\n25\t\tModel          string        `json:\"model\"`            // SessionStart hook 的 model 字段\n26\t\tSource         string        `json:\"source\"`           // startup/resume\n27\t\tStatus         SessionStatus `json:\"status\"`           // active / closed，默认 active\n28\t\tRegisteredAt   time.Time     `json:\"registered_at\"`    // SessionStart 注册时间\n29\t\tClosedAt       *time.Time    `json:\"closed_at\"`        // SessionEnd 注销时间\n30\t\tCloseReason    string        `json:\"close_reason\"`     // SessionEnd 的 reason 字段（如 prompt_input_exit）\n31\t}\n32\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\domain\\machine.go"},"tool_use_id":"call_53e988f457084b19859c483e","tool_response":"1\t// Package domain 定义核心业务实体和枚举类型。\n2\tpackage domain\n3\t\n4\timport \"time\"\n5\t\n6\t// Machine 对应 machines 表，记录使用 claude-tap-plus 的机器信息。\n7\t// machine_id 格式为 whoami@hostname，从请求中的 machine_id 按 @ 分割解析 username 和 hostname。\n8\ttype Machine struct {\n9\t\tID          int64     `json:\"id\"`\n10\t\tMachineID   string    `json:\"machine_id\"`   // whoami@hostname，UNIQUE\n11\t\tOS          string    `json:\"os\"`            // windows/linux/macos，来自 platform.sh\n12\t\tHostname    string    `json:\"hostname\"`      // 从 machine_id 按 @ 分割取后半部分\n13\t\tUsername    string    `json:\"username\"`      // 从 machine_id 按 @ 分割取前半部分\n14\t\tFirstSeenAt time.Time `json:\"first_seen_at\"` // 首次注册时间\n15\t\tLastSeenAt  time.Time `json:\"last_seen_at\"`  // 每次 SessionStart 更新\n16\t}\n17\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\domain\\project.go"},"tool_use_id":"call_9656cca5fffc4cfba66febe3","tool_response":"1\t// Package domain 定义核心业务实体和枚举类型。\n2\tpackage domain\n3\t\n4\timport \"time\"\n5\t\n6\t// Project 对应 projects 表，记录 Claude Code 工作过的项目。\n7\t// project_slug 从 transcript_path 中解析得到（Claude Code 内置的项目标识，由 cwd 路径分隔符替换为 - 得到）。\n8\ttype Project struct {\n9\t\tID          int64     `json:\"id\"`\n10\t\tProjectSlug string    `json:\"project_slug\"` // 从 transcript_path 解析，UNIQUE\n11\t\tProjectCwd  string    `json:\"project_cwd\"`  // SessionStart hook 的 cwd 字段\n12\t\tFirstSeenAt time.Time `json:\"first_seen_at\"` // 项目首次出现时间\n13\t\tLastSeenAt  time.Time `json:\"last_seen_at\"`  // 每次该项目有新会话时更新\n14\t}\n15\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\domain\\issue.go"},"tool_use_id":"call_852c725c3be640579c8b6f10","tool_response":"1\t// Package domain 定义核心业务实体和枚举类型。\n2\tpackage domain\n3\t\n4\timport \"time\"\n5\t\n6\t// IssueStatus 表示 Issue 的流转状态。\n7\ttype IssueStatus string\n8\t\n9\tconst (\n10\t\tIssueIdle       IssueStatus = \"idle\"        // 空闲，无人领取\n11\t\tIssueClaimed    IssueStatus = \"claimed\"     // 已被某 session 领取\n12\t\tIssueFixing     IssueStatus = \"fixing\"      // 正在开发中\n13\t\tIssueReadyForPR IssueStatus = \"ready-for-pr\" // 开发完成，等待提 PR\n14\t\tIssuePRCreated  IssueStatus = \"pr-created\"  // PR 已创建\n15\t\tIssueTesting    IssueStatus = \"testing\"     // 测试中\n16\t\tIssueReviewing  IssueStatus = \"reviewing\"   // 审核中\n17\t\tIssueMerged     IssueStatus = \"merged\"      // 已合并（终态）\n18\t\tIssueRejected   IssueStatus = \"rejected\"    // 被打回\n19\t)\n20\t\n21\t// IssueClaim 对应 issue_claims 表，存储 Issue 领取关系和状态流转。\n22\t// 只存\"哪个 session 领取了哪个 issue\"及其状态，不存 issue 完整内容（内容在 GitHub 上）。\n23\t// UNIQUE(repo_full_name, issue_number)\n24\ttype IssueClaim struct {\n25\t\tID           int64       `json:\"id\"`\n26\t\tRepoFullName string      `json:\"repo_full_name\"` // 如 xiaoheiDTF/claude-hk，来自 gh repo view\n27\t\tIssueNumber  int         `json:\"issue_number\"`   // GitHub issue 编号\n28\t\tIssueTitle   string      `json:\"issue_title\"`    // issue 标题（缓存，方便展示）\n29\t\tStatus       IssueStatus `json:\"status\"`         // 见 IssueStatus 枚举，默认 idle\n30\t\tSessionID    string      `json:\"session_id\"`     // 领取者的 session_id，idle 时为空\n31\t\tClaimedAt    *time.Time  `json:\"claimed_at\"`     // 领取时间，idle 时为 null\n32\t\tUpdatedAt    time.Time   `json:\"updated_at\"`     // 最后更新时间\n33\t}\n34\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\domain\\token.go"},"tool_use_id":"call_5fae214a10e84160888a4aa5","tool_response":"1\t// Package domain 定义核心业务实体和枚举类型。\n2\tpackage domain\n3\t\n4\t// TokenStats 表示 Token 使用统计。\n5\ttype TokenStats struct {\n6\t\tAPICalls     int // API 调用次数\n7\t\tInputTokens  int // 输入 Token 数\n8\t\tOutputTokens int // 输出 Token 数\n9\t\tCacheRead    int // 缓存读取 Token 数\n10\t\tCacheCreate  int // 缓存创建 Token 数\n11\t}\n12\t\n13\t// Total 计算总 Token 数（input + output）。\n14\tfunc (t TokenStats) Total() int {\n15\t\treturn t.InputTokens + t.OutputTokens\n16\t}\n17\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\service\\idle_watchdog.go"},"tool_use_id":"call_2d1c4436ff274184b11aa4e2","tool_response":"1\t// Package service 提供后端业务逻辑层。\n2\tpackage service\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"time\"\n10\t\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n12\t)\n13\t\n14\t// proxySession 用于反序列化 proxy.json 中的会话条目。\n15\ttype proxySession struct {\n16\t\tStartedAt string `json:\"started_at\"`\n17\t}\n18\t\n19\t// IdleWatchdog 监控 proxy.json，当所有会话注销且持续空闲超过指定时间后，\n20\t// 调用 shutdown 回调触发后端优雅关闭。\n21\ttype IdleWatchdog struct {\n22\t\tinterval    time.Duration // 检查间隔\n23\t\tidleTimeout time.Duration // 空闲超时（超过此时间无会话则关闭）\n24\t\tshutdown    func()        // 触发服务器关闭的回调\n25\t}\n26\t\n27\t// NewIdleWatchdog 创建空闲监控器。\n28\t//   - interval: 检查间隔（建议 30s）\n29\t//   - idleTimeout: 空闲超时（建议 10min）\n30\t//   - shutdown: 触发关闭的回调函数\n31\tfunc NewIdleWatchdog(interval, idleTimeout time.Duration, shutdown func()) *IdleWatchdog {\n32\t\treturn &IdleWatchdog{\n33\t\t\tinterval:    interval,\n34\t\t\tidleTimeout: idleTimeout,\n35\t\t\tshutdown:    shutdown,\n36\t\t}\n37\t}\n38\t\n39\t// Run 启动监控循环，直到 context 被取消或触发关闭。\n40\tfunc (w *IdleWatchdog) Run(ctx context.Context) {\n41\t\tlogger.Info(\"watchdog\", \"started: interval=%v idle_timeout=%v\", w.interval, w.idleTimeout)\n42\t\n43\t\tidleStart := time.Time{} // 记录首次检测到空闲的时间\n44\t\n45\t\tticker := time.NewTicker(w.interval)\n46\t\tdefer ticker.Stop()\n47\t\n48\t\tfor {\n49\t\t\tselect {\n50\t\t\tcase <-ctx.Done():\n51\t\t\t\tlogger.Info(\"watchdog\", \"stopped\")\n52\t\t\t\treturn\n53\t\t\tcase <-ticker.C:\n54\t\t\t\tsessionCount := countProxySessions()\n55\t\t\t\tif sessionCount > 0 {\n56\t\t\t\t\t// 有活跃会话，重置空闲计时\n57\t\t\t\t\tif !idleStart.IsZero() {\n58\t\t\t\t\t\tlogger.Info(\"watchdog\", \"sessions active (%d), resetting idle timer\", sessionCount)\n59\t\t\t\t\t}\n60\t\t\t\t\tidleStart = time.Time{}\n61\t\t\t\t} else {\n62\t\t\t\t\t// 无活跃会话\n63\t\t\t\t\tif idleStart.IsZero() {\n64\t\t\t\t\t\t// 首次检测到空闲\n65\t\t\t\t\t\tidleStart = time.Now()\n66\t\t\t\t\t\tlogger.Info(\"watchdog\", \"no sessions, idle timer started\")\n67\t\t\t\t\t} else if time.Since(idleStart) >= w.idleTimeout {\n68\t\t\t\t\t\t// 空闲超时，触发关闭\n69\t\t\t\t\t\tlogger.Info(\"watchdog\", \"idle timeout (%v) reached, shutting down\", w.idleTimeout)\n70\t\t\t\t\t\tw.shutdown()\n71\t\t\t\t\t\treturn\n72\t\t\t\t\t} else {\n73\t\t\t\t\t\tlogger.Debug(\"watchdog\", \"idle for %v, shutdown in %v\",\n74\t\t\t\t\t\t\ttime.Since(idleStart).Round(time.Second),\n75\t\t\t\t\t\t\tw.idleTimeout-time.Since(idleStart))\n76\t\t\t\t\t}\n77\t\t\t\t}\n78\t\t\t}\n79\t\t}\n80\t}\n81\t\n82\t// proxyJSONPath 返回 proxy.json 的路径（~/.claude-tap-plus/proxy.json）。\n83\tfunc proxyJSONPath() string {\n84\t\thome, err := os.UserHomeDir()\n85\t\tif err != nil {\n86\t\t\treturn \".claude-tap-plus/proxy.json\"\n87\t\t}\n88\t\treturn filepath.Join(home, \".claude-tap-plus\", \"proxy.json\")\n89\t}\n90\t\n91\t// countProxySessions 读取 proxy.json 并返回活跃会话数量。\n92\tfunc countProxySessions() int {\n93\t\tdata, err := os.ReadFile(proxyJSONPath())\n94\t\tif err != nil {\n95\t\t\treturn 0 // 文件不存在或读不出 → 视为无会话\n96\t\t}\n97\t\tvar sessions map[string]proxySession\n98\t\tif json.Unmarshal(data, &sessions) != nil {\n99\t\t\treturn 0\n100\t\t}\n101\t\treturn len(sessions)\n102\t}\n103\t"}]}
