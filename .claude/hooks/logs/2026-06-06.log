sp.Code)\n220\t\t}\n221\t}\n222\t\n223\t// TestConfig_InvalidLogLevel 验证：无效的 log_level 值返回 400。\n224\tfunc TestConfig_InvalidLogLevel(t *testing.T) {\n225\t\tenv := setupConfigTest(t)\n226\t\n227\t\tresp := env.putConfig(t, `{\"log_level\":\"verbose\"}`)\n228\t\n229\t\tvar errResp struct {\n230\t\t\tCode    string `json:\"error\"`\n231\t\t\tMessage string `json:\"message\"`\n232\t\t}\n233\t\treadConfigJSON(t, resp, &errResp)\n234\t\n235\t\tif resp.StatusCode != http.StatusBadRequest {\n236\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n237\t\t}\n238\t\tif errResp.Code != \"invalid_config\" {\n239\t\t\tt.Errorf(\"expected error=invalid_config, got %s\", errResp.Code)\n240\t\t}\n241\t}\n242\t\n243\t// TestConfig_UnknownKey 验证：不存在的配置键返回 400。\n244\tfunc TestConfig_UnknownKey(t *testing.T) {\n245\t\tenv := setupConfigTest(t)\n246\t\n247\t\tresp := env.putConfig(t, `{\"unknown_key\":\"value\"}`)\n248\t\n249\t\tvar errResp struct {\n250\t\t\tCode    string `json:\"error\"`\n251\t\t\tMessage string `json:\"message\"`\n252\t\t}\n253\t\treadConfigJSON(t, resp, &errResp)\n254\t\n255\t\tif resp.StatusCode != http.StatusBadRequest {\n256\t\t\tt.Fatalf(\"expected 400, got %d\", resp.StatusCode)\n257\t\t}\n258\t\tif errResp.Code != \"unknown_config_key\" {\n259\t\t\tt.Errorf(\"expected error=unknown_config_key, got %s\", errResp.Code)\n260\t\t}\n261\t}\n262\t\n263\t// TestConfig_MethodNotAllowed 验证：POST 返回 405。\n264\tfunc TestConfig_MethodNotAllowed(t *testing.T) {\n265\t\tenv := setupConfigTest(t)\n266\t\n267\t\tresp, err := http.Post(env.srv.URL+\"/api/config\", \"application/json\", strings.NewReader(\"{}\"))\n268\t\tif err != nil {\n269\t\t\tt.Fatal(err)\n270\t\t}\n271\t\n272\t\tvar errResp struct {\n273\t\t\tCode    string `json:\"error\"`\n274\t\t\tMessage string `json:\"message\"`\n275\t\t}\n276\t\treadConfigJSON(t, resp, &errResp)\n277\t\n278\t\tif resp.StatusCode != http.StatusMethodNotAllowed {\n279\t\t\tt.Fatalf(\"expected 405, got %d\", resp.StatusCode)\n280\t\t}\n281\t\tif errResp.Code != \"method_not_allowed\" {\n282\t\t\tt.Errorf(\"expected error=method_not_allowed, got %s\", errResp.Code)\n283\t\t}\n284\t}\n285\t\n286\t// TestConfig_UpdatePreservesOthers 验证：更新不影响其他配置项。\n287\tfunc TestConfig_UpdatePreservesOthers(t *testing.T) {\n288\t\tenv := setupConfigTest(t)\n289\t\n290\t\t// 先获取默认配置\n291\t\tresp := env.getConfig(t)\n292\t\tvar before struct {\n293\t\t\tConfig map[string]interface{} `json:\"config\"`\n294\t\t}\n295\t\treadConfigJSON(t, resp, &before)\n296\t\n297\t\t// 更新 default_model\n298\t\tresp = env.putConfig(t, `{\"default_model\":\"claude-sonnet\"}`)\n299\t\n300\t\tvar after struct {\n301\t\t\tConfig map[string]interface{} `json:\"config\"`\n302\t\t}\n303\t\treadConfigJSON(t, resp, &after)\n304\t\n305\t\tif after.Config[\"default_model\"] != \"claude-sonnet\" {\n306\t\t\tt.Errorf(\"expected default_model=claude-sonnet, got %v\", after.Config[\"default_model\"])\n307\t\t}\n308\t\n309\t\t// log_level 应保持不变\n310\t\tif after.Config[\"log_level\"] != before.Config[\"log_level\"] {\n311\t\t\tt.Errorf(\"log_level changed unexpectedly: before=%v after=%v\", before.Config[\"log_level\"], after.Config[\"log_level\"])\n312\t\t}\n313\t\n314\t\t// auto_claim 应保持不变\n315\t\tif after.Config[\"auto_claim\"] != before.Config[\"auto_claim\"] {\n316\t\t\tt.Errorf(\"auto_claim changed unexpectedly: before=%v after=%v\", before.Config[\"auto_claim\"], after.Config[\"auto_claim\"])\n317\t\t}\n318\t}\n319\t"}]}
