[2026-06-06 11:58:49] [INFO] [PostToolBatch] Input: {"session_id":"d20ab83c-226b-4225-be31-28c59aa725e9","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\d20ab83c-226b-4225-be31-28c59aa725e9.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"plan","agent_id":"a6d36c1dccf4e38ad","agent_type":"Plan","effort":{"level":"medium"},"hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/reverse.go"},"tool_use_id":"call_fb47338c9410424187ccf301","tool_response":"1\t// Package proxy 提供 HTTP 代理功能，包括请求转发、SSE 流式处理与 Trace 记录。\n2\tpackage proxy\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"compress/gzip\"\n7\t\t\"compress/zlib\"\n8\t\t\"encoding/json\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"net/http\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\t\"sync/atomic\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n19\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n20\t)\n21\t\n22\t// ReverseProxy 拦截 HTTP 请求并转发到上游 API，同时记录请求/响应到 JSONL Trace，并处理 SSE 流式响应。\n23\ttype ReverseProxy struct {\n24\t\ttarget             string              // 上游 API 目标地址\n25\t\tbaseDir            string              // Trace 文件存放的基础目录\n26\t\twriter             *trace.TraceWriter  // 当前会话的 Trace 写入器（由 _internal/trace-init 创建）\n27\t\tclient             *http.Client        // 转发请求的 HTTP 客户端\n28\t\tturn               atomic.Int64        // 请求计数器，用于标记 Turn 编号\n29\t\tserver             *http.Server        // 本地代理 HTTP 服务器\n30\t\tstartOnce          sync.Once           // 确保 Start 只执行一次\n31\t\tsessionID          string              // 当前会话 ID（由 trace-init 设置）\n32\t\tprojectSlug        string              // 当前项目标识（由 trace-init 设置）\n33\t\tOnSessionInit      func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\n34\t\tmodel              string              // 强制替换的模型名（空=不改写）\n35\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n36\t\tfallbackConfig     *FallbackConfig      // 兜底配置（上游不可用时切换）\n37\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfig 的并发安全\n38\t\tactualAddr         string              // 实际监听地址（启动后设置）\n39\t}\n40\t\n41\t// FallbackConfig 存储上游不可用时的兜底配置。\n42\ttype FallbackConfig struct {\n43\t\tBaseURL   string // 兜底上游 API 地址\n44\t\tModel     string // 兜底模型名\n45\t\tAuthToken string // 兜底认证 Token\n46\t\tAPIKey    string // 兜底 API Key\n47\t}\n48\t\n49\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n50\t// traceDir 为 Trace 文件存放的基础目录。\n51\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n52\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n53\t\treturn &ReverseProxy{\n54\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n55\t\t\tbaseDir:           traceDir,\n56\t\t\tupstreamAvailable: true,\n57\t\t\tclient: &http.Client{\n58\t\t\t\tTimeout: 0, // 流式场景不设超时\n59\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n60\t\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n61\t\t\t\t},\n62\t\t\t},\n63\t\t}\n64\t}\n65\t\n66\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n67\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n68\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n69\t\tmux := http.NewServeMux()\n70\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n71\t\tp.server = &http.Server{\n72\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n73\t\t\tHandler: mux,\n74\t\t}\n75\t\n76\t\tlistener, err := ioListener(p.server.Addr)\n77\t\tif err != nil {\n78\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n79\t\t}\n80\t\n81\t\t// 在后台 goroutine 中启动服务\n82\t\tgo func() {\n83\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n84\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n85\t\t\t}\n86\t\t}()\n87\t\n88\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n89\t\tp.actualAddr = fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n90\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n91\t\treturn actualPort, nil\n92\t}\n93\t\n94\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n95\tfunc (p *ReverseProxy) Stop() {\n96\t\tlogger.Info(\"proxy\", \"stopping\")\n97\t\tif p.writer != nil {\n98\t\t\tp.writer.Close()\n99\t\t}\n100\t\tif p.server != nil {\n101\t\t\t_ = p.server.Close()\n102\t\t}\n103\t}\n104\t\n105\t// URL 返回代理服务器的 HTTP 地址（如 http://127.0.0.1:8080）。\n106\tfunc (p *ReverseProxy) URL() string {\n107\t\treturn p.actualAddr\n108\t}\n109\t\n110\t// serveHTTP 是代理的核心 HTTP 处理函数。\n111\t// 处理流程：内部端点 → 路径白名单检查 → 读取请求体 → 构建上游请求 → 转发 → 流式/非流式处理。\n112\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n113\t\t// 处理内部端点（绕过路径白名单）\n114\t\tif strings.HasPrefix(r.URL.Path, \"/_internal/\") {\n115\t\t\tp.handleInternal(w, r)\n116\t\t\treturn\n117\t\t}\n118\t\n119\t\t// 拒绝未知路径\n120\t\tif !IsAllowedPath(r.URL.Path) {\n121\t\t\thttp.NotFound(w, r)\n122\t\t\treturn\n123\t\t}\n124\t\n125\t\t// 读取请求体\n126\t\tbodyBytes, err := io.ReadAll(r.Body)\n127\t\tif err != nil {\n128\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n129\t\t\treturn\n130\t\t}\n131\t\t_ = r.Body.Close()\n132\t\n133\t\t// 解析请求体为 JSON（用于后续提取 model、stream 等字段）\n134\t\tvar reqBody any\n135\t\tif len(bodyBytes) > 0 {\n136\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n137\t\t}\n138\t\n139\t\t// 请求体 model 改写（契约 3）\n140\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, p.model)\n141\t\n142\t\t// 重新解析改写后的请求体\n143\t\treqBody = nil\n144\t\tif len(bodyBytes) > 0 {\n145\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n146\t\t}\n147\t\n148\t\t// 生成请求 ID 与 Turn 编号\n149\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n150\t\tturn := int(p.turn.Add(1))\n151\t\tt0 := time.Now()\n152\t\n153\t\tlogger.Debug(\"proxy\", \"[Turn %d] request: %s %s (%d bytes)\", turn, r.Method, r.URL.Path, len(bodyBytes))\n154\t\n155\t\t// 确定上游目标：检查是否需要走兜底配置（契约 4）\n156\t\tp.availableMu.Lock()\n157\t\tuseFallback := !p.upstreamAvailable && p.fallbackConfig != nil\n158\t\tactiveTarget := p.target\n159\t\tvar fallbackModel string\n160\t\tif useFallback {\n161\t\t\tactiveTarget = p.fallbackConfig.BaseURL\n162\t\t\tfallbackModel = p.fallbackConfig.Model\n163\t\t}\n164\t\tp.availableMu.Unlock()\n165\t\n166\t\t// 兜底模式下重新改写 model\n167\t\tif useFallback && fallbackModel != \"\" {\n168\t\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, fallbackModel)\n169\t\t\treqBody = nil\n170\t\t\tif len(bodyBytes) > 0 {\n171\t\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n172\t\t\t}\n173\t\t}\n174\t\n175\t\t// 构建上游请求 URL\n176\t\tupstreamURL := activeTarget + r.URL.Path\n177\t\tif r.URL.RawQuery != \"\" {\n178\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n179\t\t}\n180\t\n181\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n182\t\tif err != nil {\n183\t\t\thttp.Error(w, \"create upstream request: \"+err.Error(), http.StatusBadGateway)\n184\t\t\treturn\n185\t\t}\n186\t\n187\t\t// 复制请求头，过滤逐跳头\n188\t\tfor k, vals := range r.Header {\n189\t\t\tlower := strings.ToLower(k)\n190\t\t\tif hopByHopHeaders[lower] {\n191\t\t\t\tcontinue\n192\t\t\t}\n193\t\t\tfor _, v := range vals {\n194\t\t\t\tupstreamReq.Header.Add(k, v)\n195\t\t\t}\n196\t\t}\n197\t\tupstreamReq.Header.Del(\"Host\")\n198\t\n199\t\t// 兜底模式下替换认证头\n200\t\tif useFallback && p.fallbackConfig != nil {\n201\t\t\tif p.fallbackConfig.APIKey != \"\" {\n202\t\t\t\tupstreamReq.Header.Set(\"x-api-key\", p.fallbackConfig.APIKey)\n203\t\t\t}\n204\t\t\tif p.fallbackConfig.AuthToken != \"\" {\n205\t\t\t\tupstreamReq.Header.Set(\"Authorization\", \"Bearer \"+p.fallbackConfig.AuthToken)\n206\t\t\t}\n207\t\t}\n208\t\n209\t\t// 向上游发送请求\n210\t\tupstreamResp, err := p.client.Do(upstreamReq)\n211\t\tif err != nil {\n212\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error: %v\", turn, err)\n213\t\t\tp.markUnavailable()\n214\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n215\t\t\treturn\n216\t\t}\n217\t\tdefer upstreamResp.Body.Close()\n218\t\n219\t\t// 响应错误（4xx/5xx）→ 标记上游不可用（契约 4）\n220\t\tif upstreamResp.StatusCode >= 400 {\n221\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error response: %d\", turn, upstreamResp.StatusCode)\n222\t\t\tp.markUnavailable()\n223\t\t}\n224\t\n225\t\tduration := time.Since(t0).Milliseconds()\n226\t\n227\t\t// 从请求体中提取 model 字段\n228\t\tmodel := \"\"\n229\t\tif m, ok := reqBody.(map[string]any); ok {\n230\t\t\tif v, ok := m[\"model\"].(string); ok {\n231\t\t\t\tmodel = v\n232\t\t\t}\n233\t\t}\n234\t\n235\t\t// 检测是否为流式请求\n236\t\tisStreaming := false\n237\t\tif m, ok := reqBody.(map[string]any); ok {\n238\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n239\t\t\t\tisStreaming = s\n240\t\t\t}\n241\t\t}\n242\t\n243\t\t// 根据是否流式分发到对应处理器\n244\t\tif isStreaming {\n245\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n246\t\t} else {\n247\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n248\t\t}\n249\t}\n250\t\n251\t// handleStreaming 处理 SSE 流式响应：\n252\t//   - 复制响应头并写入客户端\n253\t//   - 逐块读取上游响应体并实时转发给客户端\n254\t//   - 使用 SSE 重组器收集完整事件\n255\t//   - 将重组后的结果写入 Trace\n256\tfunc (p *ReverseProxy) handleStreaming(\n257\t\tw http.ResponseWriter,\n258\t\tupstreamResp *http.Response,\n259\t\treqID string, turn, durationMs int,\n260\t\tr *http.Request, reqBody any,\n261\t\tt0 time.Time, model string,\n262\t) {\n263\t\t// 复制响应头\n264\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n265\t\tfor k, vals := range respHeaders {\n266\t\t\tfor _, v := range vals {\n267\t\t\t\tw.Header().Add(k, v)\n268\t\t\t}\n269\t\t}\n270\t\tw.WriteHeader(upstreamResp.StatusCode)\n271\t\n272\t\tflusher, canFlush := w.(http.Flusher)\n273\t\treassembler := sse.NewSSEReassembler()\n274\t\n275\t\t// 逐块读取并转发流式数据\n276\t\tbuf := make([]byte, 32*1024)\n277\t\tfor {\n278\t\t\tn, err := upstreamResp.Body.Read(buf)\n279\t\t\tif n > 0 {\n280\t\t\t\t_, _ = w.Write(buf[:n])\n281\t\t\t\tif canFlush {\n282\t\t\t\t\tflusher.Flush()\n283\t\t\t\t}\n284\t\t\t\treassembler.FeedBytes(buf[:n])\n285\t\t\t}\n286\t\t\tif err != nil {\n287\t\t\t\tbreak\n288\t\t\t}\n289\t\t}\n290\t\n291\t\tdurationMs = int(time.Since(t0).Milliseconds())\n292\t\treconstructed := reassembler.Reconstruct()\n293\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n294\t\n295\t\t// 构建 Trace 记录\n296\t\trecord := buildRecord(\n297\t\t\treqID, turn, durationMs,\n298\t\t\tr.Method, r.URL.RequestURI(),\n299\t\t\tr.Header, reqBody,\n300\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n301\t\t\treconstructed,\n302\t\t\treassembler.Events,\n303\t\t\tp.target,\n304\t\t)\n305\t\n306\t\tif w := p.getWriter(); w != nil {\n307\t\t\tif err := w.Write(record); err != nil {\n308\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n309\t\t\t}\n310\t\t} else {\n311\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n312\t\t}\n313\t\n314\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n315\t}\n316\t\n317\t// handleNonStreaming 处理普通（非流式）响应：\n318\t//   - 读取完整响应体\n319\t//   - 按需解压（gzip / deflate）\n320\t//   - 解析 JSON 响应体\n321\t//   - 写入 Trace 并返回给客户端\n322\tfunc (p *ReverseProxy) handleNonStreaming(\n323\t\tw http.ResponseWriter,\n324\t\tupstreamResp *http.Response,\n325\t\treqID string, turn, durationMs int,\n326\t\tr *http.Request, reqBody any, model string,\n327\t) {\n328\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n329\t\tif err != nil {\n330\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n331\t\t\treturn\n332\t\t}\n333\t\n334\t\t// 按需解压响应体\n335\t\tdecodeBytes := respBytes\n336\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n337\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n338\t\t\tvar reader io.ReadCloser\n339\t\t\tif encoding == \"gzip\" {\n340\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n341\t\t\t} else {\n342\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n343\t\t\t}\n344\t\t\tif reader != nil {\n345\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n346\t\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n347\t\t\t\t\tdecodeBytes = decoded\n348\t\t\t\t}\n349\t\t\t\t_ = reader.Close()\n350\t\t\t}\n351\t\t}\n352\t\n353\t\t// 解析解压后的 JSON 响应体\n354\t\tvar respBody any\n355\t\tif len(decodeBytes) > 0 {\n356\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n357\t\t}\n358\t\n359\t\t// 构建 Trace 记录\n360\t\trecord := buildRecord(\n361\t\t\treqID, turn, durationMs,\n362\t\t\tr.Method, r.URL.RequestURI(),\n363\t\t\tr.Header, reqBody,\n364\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n365\t\t\trespBody,\n366\t\t\tnil,\n367\t\t\tp.target,\n368\t\t)\n369\t\n370\t\tif w := p.getWriter(); w != nil {\n371\t\t\tif err := w.Write(record); err != nil {\n372\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n373\t\t\t}\n374\t\t} else {\n375\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n376\t\t}\n377\t\n378\t\t// 将响应返回给客户端\n379\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n380\t\tfor k, vals := range respHeaders {\n381\t\t\tfor _, v := range vals {\n382\t\t\t\tw.Header().Add(k, v)\n383\t\t\t}\n384\t\t}\n385\t\tw.WriteHeader(upstreamResp.StatusCode)\n386\t\t_, _ = w.Write(respBytes)\n387\t\n388\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n389\t}\n390\t\n391\t// buildRecord 构建一条 Trace 记录，包含请求/响应的完整信息。\n392\tfunc buildRecord(\n393\t\treqID string, turn, durationMs int,\n394\t\tmethod, path string,\n395\t\treqHeaders http.Header, reqBody any,\n396\t\tstatus int, respHeaders http.Header,\n397\t\trespBody any,\n398\t\tsseEvents []map[string]any,\n399\t\tupstreamBaseURL string,\n400\t) map[string]any {\n401\t\trecord := map[string]any{\n402\t\t\t\"timestamp\":   time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n403\t\t\t\"request_id\":  reqID,\n404\t\t\t\"session_id\":  extractSessionID(reqBody),\n405\t\t\t\"turn\":        turn,\n406\t\t\t\"duration_ms\": durationMs,\n407\t\t\t\"request\": map[string]any{\n408\t\t\t\t\"method\":  method,\n409\t\t\t\t\"path\":    path,\n410\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n411\t\t\t\t\"body\":    reqBody,\n412\t\t\t},\n413\t\t\t\"response\": map[string]any{\n414\t\t\t\t\"status\":  status,\n415\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n416\t\t\t\t\"body\":    respBody,\n417\t\t\t},\n418\t\t}\n419\t\tif len(sseEvents) > 0 {\n420\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n421\t\t}\n422\t\tif upstreamBaseURL != \"\" {\n423\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n424\t\t}\n425\t\treturn record\n426\t}\n427\t\n428\t// extractSessionID 从请求体的 metadata.user_id 字段中提取 session_id。\n429\t// Claude Code 发送的格式为：metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n430\tfunc extractSessionID(reqBody any) string {\n431\t\tbody, ok := reqBody.(map[string]any)\n432\t\tif !ok {\n433\t\t\treturn \"\"\n434\t\t}\n435\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n436\t\tif metadata == nil {\n437\t\t\treturn \"\"\n438\t\t}\n439\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n440\t\tif userIDRaw == \"\" {\n441\t\t\treturn \"\"\n442\t\t}\n443\t\tvar userData map[string]string\n444\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n445\t\t\treturn \"\"\n446\t\t}\n447\t\treturn userData[\"session_id\"]\n448\t}\n449\t\n450\t// handleInternal 分发内部代理端点请求。\n451\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n452\t\tswitch r.URL.Path {\n453\t\tcase \"/_internal/trace-init\":\n454\t\t\tp.handleTraceInit(w, r)\n455\t\tdefault:\n456\t\t\thttp.NotFound(w, r)\n457\t\t}\n458\t}\n459\t\n460\t// handleTraceInit 接收 SessionStart 钩子传来的会话信息，创建 Trace 写入器。\n461\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n462\t\tif r.Method != http.MethodPost {\n463\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n464\t\t\treturn\n465\t\t}\n466\t\n467\t\tvar req struct {\n468\t\t\tSessionID      string `json:\"session_id\"`\n469\t\t\tMachineID      string `json:\"machine_id\"`\n470\t\t\tProjectSlug    string `json:\"project_slug\"`\n471\t\t\tTranscriptPath string `json:\"transcript_path\"`\n472\t\t}\n473\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n474\t\t\tlogger.Warn(\"proxy\", \"trace-init: invalid JSON: %v\", err)\n475\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n476\t\t\treturn\n477\t\t}\n478\t\n479\t\tif req.SessionID == \"\" {\n480\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n481\t\t\treturn\n482\t\t}\n483\t\n484\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n485\t\n486\t\t// 若请求中未提供，则通过 trace 包自动检测\n487\t\tmachineID := req.MachineID\n488\t\tif machineID == \"\" {\n489\t\t\tmachineID = trace.MachineID()\n490\t\t}\n491\t\n492\t\tprojectSlug := req.ProjectSlug\n493\t\tif projectSlug == \"\" {\n494\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n495\t\t\tif projectSlug == \"\" {\n496\t\t\t\tprojectSlug = trace.DetectProjectName()\n497\t\t\t}\n498\t\t}\n499\t\n500\t\t// 创建会话专属的 Trace 写入器\n501\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n502\t\twriter, err := trace.NewTraceWriter(tracePath)\n503\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n504\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n505\t\tif err != nil {\n506\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n507\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n508\t\t\treturn\n509\t\t}\n510\t\n511\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n512\t\t\tif p.writer != nil {\n513\t\t\t\tp.writer.Close()\n514\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n515\t\t\t}\n516\t\tp.writer = writer\n517\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n518\t\n519\t\t// 通知外部注册 proxy.json\n520\t\tif p.OnSessionInit != nil {\n521\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n522\t\t}\n523\t\n524\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n525\t\tjson.NewEncoder(w).Encode(map[string]string{\n526\t\t\t\"status\":     \"ok\",\n527\t\t\t\"trace_path\": tracePath,\n528\t\t})\n529\t}\n530\t\n531\t// getWriter 返回当前会话的 Trace 写入器。\n532\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n533\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n534\t\treturn p.writer\n535\t}\n536\t\n537\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n538\t// 若无有效写入器，返回零值统计。\n539\tfunc (p *ReverseProxy) Summary() map[string]any {\n540\t\tif w := p.getWriter(); w != nil {\n541\t\t\treturn w.Summary()\n542\t\t}\n543\t\treturn map[string]any{\n544\t\t\t\"api_calls\":           0,\n545\t\t\t\"input_tokens\":        int64(0),\n546\t\t\t\"output_tokens\":       int64(0),\n547\t\t\t\"cache_read_tokens\":   int64(0),\n548\t\t\t\"cache_create_tokens\": int64(0),\n549\t\t}\n550\t}\n551\t\n552\t// SessionID 返回当前会话的 session_id。\n553\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n554\tfunc (p *ReverseProxy) SessionID() string {\n555\t\tif p.sessionID != \"\" {\n556\t\t\treturn p.sessionID\n557\t\t}\n558\t\tif w := p.getWriter(); w != nil {\n559\t\t\treturn w.SessionID()\n560\t\t}\n561\t\treturn \"\"\n562\t}\n563\t\n564\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n565\tfunc (p *ReverseProxy) ProjectSlug() string {\n566\t\treturn p.projectSlug\n567\t}\n568\t\n569\t// TracePath 返回当前追踪文件的完整路径。\n570\tfunc (p *ReverseProxy) TracePath() string {\n571\t\tif w := p.getWriter(); w != nil {\n572\t\t\treturn w.Path()\n573\t\t}\n574\t\treturn \"\"\n575\t}\n576\t\n577\t// markUnavailable 标记上游不可用（契约 4）。\n578\t// 首次失败后置 upstreamAvailable = false，进程生命周期内不再恢复。\n579\tfunc (p *ReverseProxy) markUnavailable() {\n580\t\tp.availableMu.Lock()\n581\t\tdefer p.availableMu.Unlock()\n582\t\tif p.upstreamAvailable {\n583\t\t\tp.upstreamAvailable = false\n584\t\t\tlogger.Warn(\"proxy\", \"upstream marked unavailable, switching to fallback\")\n585\t\t}\n586\t}\n587\t\n588\t// SetModel 设置强制替换的模型名。\n589\tfunc (p *ReverseProxy) SetModel(model string) {\n590\t\tp.model = model\n591\t}\n592\t\n593\t// SetFallbackConfig 设置兜底配置。\n594\tfunc (p *ReverseProxy) SetFallbackConfig(cfg *FallbackConfig) {\n595\t\tp.fallbackConfig = cfg\n596\t}\n597\t\n598\t// rewriteModel 改写请求体 JSON 中的 model 字段（契约 3）。\n599\t// 如果 model 为空、body 为空、body 非 JSON 或 body 为 JSON 非对象，原样返回。\n600\tfunc rewriteModel(body []byte, parsed any, model string) []byte {\n601\t\tif model == \"\" || len(body) == 0 {\n602\t\t\treturn body\n603\t\t}\n604\t\n605\t\tm, ok := parsed.(map[string]any)\n606\t\tif !ok {\n607\t\t\treturn body // 非 JSON 或非对象\n608\t\t}\n609\t\n610\t\tm[\"model\"] = model\n611\t\trewritten, err := json.Marshal(m)\n612\t\tif err != nil {\n613\t\t\treturn body // 改写失败，原样返回\n614\t\t}\n615\t\treturn rewritten\n616\t}\n617\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/model_rewrite_test.go"},"tool_use_id":"call_ea5735e720be44e5907195cf","tool_response":"1\tpackage proxy\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"net/http/httptest\"\n9\t\t\"testing\"\n10\t)\n11\t\n12\t// TestRequestBodyRewrite_Model 测试请求体 model 字段改写规则\n13\t// 来源：契约 3 — 请求体改写规则\n14\tfunc TestRequestBodyRewrite_Model(t *testing.T) {\n15\t\ttests := []struct {\n16\t\t\tname        string\n17\t\t\tmodel       string // proxy 配置的 model（空=不改写）\n18\t\t\treqBody     string // 原始请求体\n19\t\t\twantModel   string // 期望上游收到的 model 值（空=不改写，用原始值）\n20\t\t\treqMethod   string\n21\t\t\treqPath     string\n22\t\t}{\n23\t\t\t// 1.1-P1: 强制覆盖请求中的模型\n24\t\t\t{\n25\t\t\t\tname:      \"1.1-P1 force override existing model\",\n26\t\t\t\tmodel:     \"glm-5.1\",\n27\t\t\t\treqBody:   `{\"model\":\"claude-sonnet-4-6\",\"stream\":true}`,\n28\t\t\t\twantModel: \"glm-5.1\",\n29\t\t\t\treqMethod: \"POST\",\n30\t\t\t\treqPath:   \"/v1/messages\",\n31\t\t\t},\n32\t\t\t// 1.2-P1: 注入不存在的 model 字段\n33\t\t\t{\n34\t\t\t\tname:      \"1.2-P1 inject model when missing\",\n35\t\t\t\tmodel:     \"glm-5.1\",\n36\t\t\t\treqBody:   `{\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}`,\n37\t\t\t\twantModel: \"glm-5.1\",\n38\t\t\t\treqMethod: \"POST\",\n39\t\t\t\treqPath:   \"/v1/messages\",\n40\t\t\t},\n41\t\t\t// 1.3-E1: model 相同，幂等替换\n42\t\t\t{\n43\t\t\t\tname:      \"1.3-E1 idempotent when model same\",\n44\t\t\t\tmodel:     \"glm-5.1\",\n45\t\t\t\treqBody:   `{\"model\":\"glm-5.1\",\"stream\":false}`,\n46\t\t\t\twantModel: \"glm-5.1\",\n47\t\t\t\treqMethod: \"POST\",\n48\t\t\t\treqPath:   \"/v1/messages\",\n49\t\t\t},\n50\t\t\t// 3.1-P1: model 为空，原样透传\n51\t\t\t{\n52\t\t\t\tname:      \"3.1-P1 no model config - pass through\",\n53\t\t\t\tmodel:     \"\",\n54\t\t\t\treqBody:   `{\"model\":\"claude-opus-4-8\",\"stream\":true}`,\n55\t\t\t\twantModel: \"claude-opus-4-8\",\n56\t\t\t\treqMethod: \"POST\",\n57\t\t\t\treqPath:   \"/v1/messages\",\n58\t\t\t},\n59\t\t\t// 4.1-E1: 空请求体\n60\t\t\t{\n61\t\t\t\tname:      \"4.1-E1 empty body - skip rewrite\",\n62\t\t\t\tmodel:     \"glm-5.1\",\n63\t\t\t\treqBody:   \"\",\n64\t\t\t\twantModel: \"\",\n65\t\t\t\treqMethod: \"GET\",\n66\t\t\t\treqPath:   \"/v1/models\",\n67\t\t\t},\n68\t\t\t// 4.2-E1: 非 JSON 请求体\n69\t\t\t{\n70\t\t\t\tname:      \"4.2-E1 non-JSON body - skip rewrite\",\n71\t\t\t\tmodel:     \"glm-5.1\",\n72\t\t\t\treqBody:   \"this is not json\",\n73\t\t\t\twantModel: \"\",\n74\t\t\t\treqMethod: \"POST\",\n75\t\t\t\treqPath:   \"/v1/messages\",\n76\t\t\t},\n77\t\t\t// X2: JSON 数组请求体\n78\t\t\t{\n79\t\t\t\tname:      \"X2 JSON array body - skip rewrite\",\n80\t\t\t\tmodel:     \"glm-5.1\",\n81\t\t\t\treqBody:   `[1,2,3]`,\n82\t\t\t\twantModel: \"\",\n83\t\t\t\treqMethod: \"POST\",\n84\t\t\t\treqPath:   \"/v1/messages\",\n85\t\t\t},\n86\t\t\t// X3: model 字段非字符串\n87\t\t\t{\n88\t\t\t\tname:      \"X3 model is number - force override to string\",\n89\t\t\t\tmodel:     \"glm-5.1\",\n90\t\t\t\treqBody:   `{\"model\":123,\"stream\":true}`,\n91\t\t\t\twantModel: \"glm-5.1\",\n92\t\t\t\treqMethod: \"POST\",\n93\t\t\t\treqPath:   \"/v1/messages\",\n94\t\t\t},\n95\t\t}\n96\t\n97\t\tfor _, tt := range tests {\n98\t\t\tt.Run(tt.name, func(t *testing.T) {\n99\t\t\t\t// 创建 mock 上游服务器，捕获收到的请求体\n100\t\t\t\tvar capturedBody []byte\n101\t\t\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n102\t\t\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n103\t\t\t\t\t// 返回简单响应\n104\t\t\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n105\t\t\t\t\tw.WriteHeader(http.StatusOK)\n106\t\t\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n107\t\t\t\t}))\n108\t\t\t\tdefer mockUpstream.Close()\n109\t\n110\t\t\t\t// 创建代理，传入 model 配置\n111\t\t\t\ttraceDir := t.TempDir()\n112\t\t\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n113\t\t\t\trp.model = tt.model\n114\t\n115\t\t\t\t// 启动代理\n116\t\t\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n117\t\t\t\tif err != nil {\n118\t\t\t\t\tt.Fatalf(\"start proxy: %v\", err)\n119\t\t\t\t}\n120\t\t\t\tdefer rp.Stop()\n121\t\n122\t\t\t\t// 通过代理发送请求\n123\t\t\t\tproxyURL := rp.URL()\n124\t\t\t\tvar body io.Reader\n125\t\t\t\tif tt.reqBody != \"\" {\n126\t\t\t\t\tbody = bytes.NewReader([]byte(tt.reqBody))\n127\t\t\t\t}\n128\t\t\t\treq, err := http.NewRequest(tt.reqMethod, proxyURL+tt.reqPath, body)\n129\t\t\t\tif err != nil {\n130\t\t\t\t\tt.Fatalf(\"create request: %v\", err)\n131\t\t\t\t}\n132\t\t\t\tif tt.reqBody != \"\" {\n133\t\t\t\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n134\t\t\t\t}\n135\t\n136\t\t\t\tresp, err := http.DefaultClient.Do(req)\n137\t\t\t\tif err != nil {\n138\t\t\t\t\tt.Fatalf(\"send request: %v\", err)\n139\t\t\t\t}\n140\t\t\t\tresp.Body.Close()\n141\t\n142\t\t\t\t// 验证上游收到的 model\n143\t\t\t\tif tt.wantModel == \"\" && len(capturedBody) == 0 {\n144\t\t\t\t\treturn // 空 body 场景，无需验证 model\n145\t\t\t\t}\n146\t\t\t\tif len(capturedBody) == 0 {\n147\t\t\t\t\tt.Fatal(\"upstream received empty body\")\n148\t\t\t\t}\n149\t\n150\t\t\t\tvar upstreamBody map[string]any\n151\t\t\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n152\t\t\t\t\t// 非 JSON body（如 4.2-E1），验证原样透传\n153\t\t\t\t\tif string(capturedBody) != tt.reqBody {\n154\t\t\t\t\t\tt.Errorf(\"non-JSON body changed: got %q, want %q\", string(capturedBody), tt.reqBody)\n155\t\t\t\t\t}\n156\t\t\t\t\treturn\n157\t\t\t\t}\n158\t\n159\t\t\t\tif tt.wantModel != \"\" {\n160\t\t\t\t\tgotModel, _ := upstreamBody[\"model\"].(string)\n161\t\t\t\t\tif gotModel != tt.wantModel {\n162\t\t\t\t\t\tt.Errorf(\"upstream model = %q, want %q\", gotModel, tt.wantModel)\n163\t\t\t\t\t}\n164\t\t\t\t}\n165\t\t\t})\n166\t\t}\n167\t}\n168\t\n169\t// TestRequestBodyRewrite_OtherFieldsUnchanged 测试改写 model 时其他字段不变\n170\t// 来源：契约 3 — 只改 model，不动其他字段\n171\tfunc TestRequestBodyRewrite_OtherFieldsUnchanged(t *testing.T) {\n172\t\tvar capturedBody []byte\n173\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n174\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n175\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n176\t\t\tw.WriteHeader(http.StatusOK)\n177\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n178\t\t}))\n179\t\tdefer mockUpstream.Close()\n180\t\n181\t\ttraceDir := t.TempDir()\n182\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n183\t\trp.model = \"glm-5.1\"\n184\t\n185\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n186\t\tif err != nil {\n187\t\t\tt.Fatalf(\"start proxy: %v\", err)\n188\t\t}\n189\t\tdefer rp.Stop()\n190\t\n191\t\t// 发送包含多个字段的请求\n192\t\torigBody := map[string]any{\n193\t\t\t\"model\":      \"claude-sonnet-4-6\",\n194\t\t\t\"stream\":     true,\n195\t\t\t\"max_tokens\": 4096,\n196\t\t\t\"messages\":   []map[string]string{{\"role\": \"user\", \"content\": \"hello\"}},\n197\t\t}\n198\t\tbodyBytes, _ := json.Marshal(origBody)\n199\t\n200\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n201\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n202\t\n203\t\tresp, err := http.DefaultClient.Do(req)\n204\t\tif err != nil {\n205\t\t\tt.Fatalf(\"send request: %v\", err)\n206\t\t}\n207\t\tresp.Body.Close()\n208\t\n209\t\t// 验证上游收到的完整请求体\n210\t\tvar upstreamBody map[string]any\n211\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n212\t\t\tt.Fatalf(\"parse upstream body: %v\", err)\n213\t\t}\n214\t\n215\t\t// model 被替换\n216\t\tif m, _ := upstreamBody[\"model\"].(string); m != \"glm-5.1\" {\n217\t\t\tt.Errorf(\"model = %q, want %q\", m, \"glm-5.1\")\n218\t\t}\n219\t\t// stream 不变\n220\t\tif s, _ := upstreamBody[\"stream\"].(bool); s != true {\n221\t\t\tt.Errorf(\"stream = %v, want true\", s)\n222\t\t}\n223\t\t// max_tokens 不变\n224\t\tif mt, ok := upstreamBody[\"max_tokens\"].(float64); !ok || mt != 4096 {\n225\t\t\tt.Errorf(\"max_tokens = %v, want 4096\", upstreamBody[\"max_tokens\"])\n226\t\t}\n227\t\t// messages 不变\n228\t\tmsgs, ok := upstreamBody[\"messages\"].([]any)\n229\t\tif !ok || len(msgs) != 1 {\n230\t\t\tt.Errorf(\"messages length = %v, want 1\", len(msgs))\n231\t\t}\n232\t}\n233\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/sse/reassembler.go"},"tool_use_id":"call_bb9fb13b2ff54f78880ef947","tool_response":"1\tpackage sse\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/usage\"\n11\t)\n12\t\n13\t// SSEReassembler 解析原始 SSE（Server-Sent Events）字节流，并将流式片段重组成完整的 API 响应。\n14\t//\n15\t// 支持的协议：\n16\t//   - Anthropic Messages API Streaming\n17\t//   - OpenAI Chat Completions Streaming\n18\t//   - OpenAI Responses API Streaming\n19\t//\n20\t// 使用方式：\n21\t//\n22\t//\tr := sse.NewSSEReassembler()\n23\t//\tr.FeedBytes(chunk)       // 多次调用，分块送入 SSE 数据\n24\t//\tsnapshot := r.Reconstruct() // 获取当前累积的完整响应快照\n25\t//\tevents := r.Events       // 获取所有解析出的原始事件列表\n26\ttype SSEReassembler struct {\n27\t\tEvents   []map[string]any // 解析出的所有原始 SSE 事件列表\n28\t\tbuf      []byte           // 未处理完的 SSE 字节缓冲区\n29\t\tcurEv    *string          // 当前正在解析的事件类型（event: xxx）\n30\t\tcurData  []string         // 当前事件的 data 行累积（支持多行 data）\n31\t\tsnap     map[string]any   // 重建后的完整响应快照\n32\t\tfedOnce  bool             // 是否已接收过首块数据（用于首次日志）\n33\t}\n34\t\n35\t// NewSSEReassembler 创建一个新的 SSE 重组器实例。\n36\tfunc NewSSEReassembler() *SSEReassembler {\n37\t\treturn &SSEReassembler{}\n38\t}\n39\t\n40\t// FeedBytes 追加原始 SSE 字节数据并处理已完整的行。\n41\t//\n42\t// 该方法按 \\n 分割输入数据，逐行解析 SSE 协议中的 event、data 字段，\n43\t// 遇到空行时触发事件生成并调用累积逻辑更新快照。\n44\t// 可以多次调用以处理分块传输的数据。\n45\tfunc (r *SSEReassembler) FeedBytes(chunk []byte) {\n46\t\tif !r.fedOnce {\n47\t\t\tlogger.Debug(\"sse\", \"FeedBytes: first chunk size=%d\", len(chunk))\n48\t\t\tr.fedOnce = true\n49\t\t}\n50\t\tr.buf = append(r.buf, chunk...)\n51\t\tfor {\n52\t\t\tidx := bytes.IndexByte(r.buf, '\\n')\n53\t\t\tif idx < 0 {\n54\t\t\t\tbreak\n55\t\t\t}\n56\t\t\tline := r.buf[:idx]\n57\t\t\tr.buf = r.buf[idx+1:]\n58\t\t\tr.feedLine(string(line))\n59\t\t}\n60\t}\n61\t\n62\t// Reconstruct 返回当前累积的消息快照。\n63\t//\n64\t// 如果尚未收到足够的事件来构建快照（如仅收到部分 SSE 帧），则返回 nil。\n65\tfunc (r *SSEReassembler) Reconstruct() map[string]any {\n66\t\treturn r.snap\n67\t}\n68\t\n69\t// feedLine 处理单条 SSE 文本行，解析 event、data 和空行分隔符。\n70\t//\n71\t// SSE 协议规则：\n72\t//   - 以 \"event:\" 开头的行设置当前事件类型\n73\t//   - 以 \"data:\" 开头的行追加到当前事件的数据 payload\n74\t//   - 空行表示当前事件结束，触发事件生成\n75\t//   - \"[DONE]\" 是 OpenAI 的流结束标记，直接忽略\n76\tfunc (r *SSEReassembler) feedLine(line string) {\n77\t\tline = strings.TrimRight(line, \"\\r\")\n78\t\n79\t\tif strings.HasPrefix(line, \"event:\") {\n80\t\t\tev := strings.TrimSpace(line[len(\"event:\"):])\n81\t\t\tr.curEv = &ev\n82\t\t\tr.curData = nil\n83\t\t} else if strings.HasPrefix(line, \"data:\") {\n84\t\t\tr.curData = append(r.curData, strings.TrimSpace(line[len(\"data:\"):]))\n85\t\t} else if line == \"\" {\n86\t\t\t// 空行触发事件：如果既没有 event 也没有 data 则跳过\n87\t\t\tif r.curEv == nil && len(r.curData) == 0 {\n88\t\t\t\treturn\n89\t\t\t}\n90\t\t\traw := strings.Join(r.curData, \"\\n\")\n91\t\n92\t\t\t// 跳过 OpenAI 的 [DONE] 哨兵标记\n93\t\t\tif raw == \"[DONE]\" && r.curEv == nil {\n94\t\t\t\tr.curEv = nil\n95\t\t\t\tr.curData = nil\n96\t\t\t\treturn\n97\t\t\t}\n98\t\n99\t\t\tvar data any\n100\t\t\tif err := json.Unmarshal([]byte(raw), &data); err != nil {\n101\t\t\t\tdata = raw\n102\t\t\t}\n103\t\n104\t\t\tevType := \"message\"\n105\t\t\tif r.curEv != nil {\n106\t\t\t\tevType = *r.curEv\n107\t\t\t}\n108\t\t\tr.addEvent(evType, data)\n109\t\t\tr.curEv = nil\n110\t\t\tr.curData = nil\n111\t\t}\n112\t}\n113\t\n114\t// addEvent 将解析出的单个 SSE 事件追加到事件列表，并触发累积更新。\n115\tfunc (r *SSEReassembler) addEvent(eventType string, data any) {\n116\t\tr.Events = append(r.Events, map[string]any{\"event\": eventType, \"data\": data})\n117\t\tr.accumulate(eventType, data)\n118\t}\n119\t\n120\t// accumulate 按事件类型将流式片段累积到响应快照中。\n121\t//\n122\t// 支持的事件类型及处理逻辑：\n123\t//   - message_start:      初始化快照为 message 对象\n124\t//   - response.created/completed/done: OpenAI Responses API，初始化或更新快照\n125\t//   - message:            OpenAI Chat Completions 流，调用 accumulateChatCompletionChunk\n126\t//   - content_block_start: 向快照 content 数组添加新的内容块\n127\t//   - content_block_delta: 更新指定索引的内容块（文本、推理、JSON 片段）\n128\t//   - content_block_stop:  将累积的 partial_json 解析为 input 字段\n129\t//   - message_delta:       更新 message 级别的 delta（如 stop_reason）和 usage\n130\tfunc (r *SSEReassembler) accumulate(eventType string, data any) {\n131\t\tm, ok := data.(map[string]any)\n132\t\tif !ok {\n133\t\t\treturn\n134\t\t}\n135\t\n136\t\tswitch eventType {\n137\t\tcase \"message_start\":\n138\t\t\tif msg, ok := m[\"message\"].(map[string]any); ok {\n139\t\t\t\tr.snap = deepCopy(msg)\n140\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_start, model=%v\", msg[\"model\"])\n141\t\t\t}\n142\t\n143\t\tcase \"response.created\", \"response.completed\", \"response.done\":\n144\t\t\tif resp, ok := m[\"response\"].(map[string]any); ok {\n145\t\t\t\tr.snap = deepCopy(resp)\n146\t\t\t} else if eventType == \"response.completed\" || eventType == \"response.done\" {\n147\t\t\t\tr.snap = deepCopy(m)\n148\t\t\t}\n149\t\n150\t\tcase \"message\":\n151\t\t\tif _, hasChoices := m[\"choices\"]; hasChoices {\n152\t\t\t\tr.accumulateChatCompletionChunk(m)\n153\t\t\t\treturn\n154\t\t\t}\n155\t\n156\t\tcase \"content_block_start\":\n157\t\t\tif r.snap == nil {\n158\t\t\t\treturn\n159\t\t\t}\n160\t\t\tblock := deepCopy(m[\"content_block\"].(map[string]any))\n161\t\t\tidx := int(float64Val(m[\"index\"]))\n162\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_start idx=%d type=%v\", idx, block[\"type\"])\n163\t\t\tif _, ok := r.snap[\"content\"]; !ok {\n164\t\t\t\tr.snap[\"content\"] = []any{}\n165\t\t\t}\n166\t\t\tcontent := r.snap[\"content\"].([]any)\n167\t\t\tfor len(content) <= idx {\n168\t\t\t\tcontent = append(content, map[string]any{})\n169\t\t\t}\n170\t\t\tcontent[idx] = block\n171\t\t\tr.snap[\"content\"] = content\n172\t\n173\t\tcase \"content_block_delta\":\n174\t\t\tif r.snap == nil {\n175\t\t\t\treturn\n176\t\t\t}\n177\t\t\tidx := int(float64Val(m[\"index\"]))\n178\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n179\t\t\tif delta == nil {\n180\t\t\t\treturn\n181\t\t\t}\n182\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n183\t\t\tif idx >= len(content) {\n184\t\t\t\treturn\n185\t\t\t}\n186\t\t\tblock, _ := content[idx].(map[string]any)\n187\t\t\tif block == nil {\n188\t\t\t\treturn\n189\t\t\t}\n190\t\t\tswitch delta[\"type\"] {\n191\t\t\tcase \"text_delta\":\n192\t\t\t\tblock[\"text\"] = strVal(block[\"text\"]) + strVal(delta[\"text\"])\n193\t\t\tcase \"thinking_delta\":\n194\t\t\t\tblock[\"thinking\"] = strVal(block[\"thinking\"]) + strVal(delta[\"thinking\"])\n195\t\t\tcase \"input_json_delta\":\n196\t\t\t\tblock[\"_partial_json\"] = strVal(block[\"_partial_json\"]) + strVal(delta[\"partial_json\"])\n197\t\t\t}\n198\t\n199\t\tcase \"content_block_stop\":\n200\t\t\tif r.snap == nil {\n201\t\t\t\treturn\n202\t\t\t}\n203\t\t\tidx := int(float64Val(m[\"index\"]))\n204\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n205\t\t\tif idx >= len(content) {\n206\t\t\t\treturn\n207\t\t\t}\n208\t\t\tblock, _ := content[idx].(map[string]any)\n209\t\t\tif block == nil {\n210\t\t\t\treturn\n211\t\t\t}\n212\t\t\t// 将累积的 JSON 字符串片段解析为结构化的 input 字段\n213\t\t\tif pj, ok := block[\"_partial_json\"]; ok {\n214\t\t\t\tvar parsed any\n215\t\t\t\tif json.Unmarshal([]byte(strVal(pj)), &parsed) == nil {\n216\t\t\t\t\tblock[\"input\"] = parsed\n217\t\t\t\t}\n218\t\t\t\tdelete(block, \"_partial_json\")\n219\t\t\t}\n220\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_stop idx=%d\", idx)\n221\t\n222\t\tcase \"message_delta\":\n223\t\t\tif r.snap == nil {\n224\t\t\t\treturn\n225\t\t\t}\n226\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n227\t\t\tif delta != nil {\n228\t\t\t\tfor k, v := range delta {\n229\t\t\t\t\tr.snap[k] = v\n230\t\t\t\t}\n231\t\t\t}\n232\t\t\tif u, ok := m[\"usage\"].(map[string]any); ok {\n233\t\t\t\tif _, exists := r.snap[\"usage\"]; !exists {\n234\t\t\t\t\tr.snap[\"usage\"] = map[string]any{}\n235\t\t\t\t}\n236\t\t\t\texisting := r.snap[\"usage\"].(map[string]any)\n237\t\t\t\tfor k, v := range u {\n238\t\t\t\t\texisting[k] = v\n239\t\t\t\t}\n240\t\t\t}\n241\t\t\tif delta != nil {\n242\t\t\t\tif sr, ok := delta[\"stop_reason\"]; ok && sr != nil {\n243\t\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_delta stop_reason=%v\", sr)\n244\t\t\t\t}\n245\t\t\t}\n246\t\t}\n247\t}\n248\t\n249\t// --- OpenAI Chat Completions 流式累积 ---\n250\t\n251\t// accumulateChatCompletionChunk 处理 OpenAI Chat Completions Streaming 的单个 chunk。\n252\t//\n253\t// 该函数将 choices[0].delta 中的内容逐块累积，同时处理：\n254\t//   - role、content、reasoning_content 的拼接\n255\t//   - tool_calls 的渐进式构建（id、name、arguments 分块到达）\n256\t//   - usage 信息的合并\n257\t//   - finish_reason 的更新\n258\t//\n259\t// 快照结构兼容 Anthropic 格式，content 数组中会同时维护文本块和工具调用块。\n260\tfunc (r *SSEReassembler) accumulateChatCompletionChunk(data map[string]any) {\n261\t\tchoices, _ := data[\"choices\"].([]any)\n262\t\trawUsage, _ := data[\"usage\"]\n263\t\n264\t\tif len(choices) == 0 {\n265\t\t\tif u, ok := rawUsage.(map[string]any); ok && r.snap != nil {\n266\t\t\t\tr.mergeChatUsage(u)\n267\t\t\t}\n268\t\t\treturn\n269\t\t}\n270\t\n271\t\tchoice, _ := choices[0].(map[string]any)\n272\t\tif choice == nil {\n273\t\t\treturn\n274\t\t}\n275\t\tdelta, _ := choice[\"delta\"].(map[string]any)\n276\t\tfinishReason := choice[\"finish_reason\"]\n277\t\tchoiceUsage, _ := choice[\"usage\"].(map[string]any)\n278\t\n279\t\t// 首个 chunk 时初始化快照\n280\t\tif r.snap == nil {\n281\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk init, model=%s\", strVal(data[\"model\"]))\n282\t\t\tr.snap = map[string]any{\n283\t\t\t\t\"id\":     strVal(data[\"id\"]),\n284\t\t\t\t\"object\": \"chat.completion\",\n285\t\t\t\t\"model\":  strVal(data[\"model\"]),\n286\t\t\t\t\"choices\": []any{\n287\t\t\t\t\tmap[string]any{\n288\t\t\t\t\t\t\"index\":         0,\n289\t\t\t\t\t\t\"message\":       map[string]any{\"role\": strVal(fieldStr(delta, \"role\")), \"content\": \"\"},\n290\t\t\t\t\t\t\"finish_reason\": nil,\n291\t\t\t\t\t},\n292\t\t\t\t},\n293\t\t\t\t\"content\": []any{map[string]any{\"type\": \"text\", \"text\": \"\"}},\n294\t\t\t}\n295\t\t\tif role := strVal(fieldStr(delta, \"role\")); role == \"\" {\n296\t\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)[\"role\"] = \"assistant\"\n297\t\t\t}\n298\t\t}\n299\t\n300\t\tmsg := r.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n301\t\ttextBlock := r.chatTextBlock()\n302\t\n303\t\tif role := strVal(fieldStr(delta, \"role\")); role != \"\" {\n304\t\t\tmsg[\"role\"] = role\n305\t\t}\n306\t\tif rc := strVal(fieldStr(delta, \"reasoning_content\")); rc != \"\" {\n307\t\t\tmsg[\"reasoning_content\"] = strVal(msg[\"reasoning_content\"]) + rc\n308\t\t\tr.mirrorReasoning(strVal(msg[\"reasoning_content\"]))\n309\t\t}\n310\t\tif c := strVal(fieldStr(delta, \"content\")); c != \"\" {\n311\t\t\tmsg[\"content\"] = strVal(msg[\"content\"]) + c\n312\t\t\ttextBlock[\"text\"] = strVal(textBlock[\"text\"]) + c\n313\t\t}\n314\t\n315\t\t// 工具调用增量处理\n316\t\tfor _, tcRaw := range sliceField(delta, \"tool_calls\") {\n317\t\t\ttcDelta, _ := tcRaw.(map[string]any)\n318\t\t\tif tcDelta == nil {\n319\t\t\t\tcontinue\n320\t\t\t}\n321\t\t\tidx := int(float64Val(tcDelta[\"index\"]))\n322\t\t\ttoolCalls, _ := msg[\"tool_calls\"].([]any)\n323\t\t\tif toolCalls == nil {\n324\t\t\t\ttoolCalls = []any{}\n325\t\t\t}\n326\t\t\tfor len(toolCalls) <= idx {\n327\t\t\t\ttoolCalls = append(toolCalls, map[string]any{\n328\t\t\t\t\t\"id\":   \"\",\n329\t\t\t\t\t\"type\": \"function\",\n330\t\t\t\t\t\"function\": map[string]any{\n331\t\t\t\t\t\t\"name\":      \"\",\n332\t\t\t\t\t\t\"arguments\": \"\",\n333\t\t\t\t\t},\n334\t\t\t\t})\n335\t\t\t}\n336\t\t\texisting := toolCalls[idx].(map[string]any)\n337\t\t\tif id := strVal(tcDelta[\"id\"]); id != \"\" {\n338\t\t\t\texisting[\"id\"] = id\n339\t\t\t}\n340\t\t\tif t := strVal(tcDelta[\"type\"]); t != \"\" {\n341\t\t\t\texisting[\"type\"] = t\n342\t\t\t}\n343\t\t\tif fnDelta, ok := tcDelta[\"function\"].(map[string]any); ok {\n344\t\t\t\tfn, _ := existing[\"function\"].(map[string]any)\n345\t\t\t\tif fn == nil {\n346\t\t\t\t\tfn = map[string]any{\"name\": \"\", \"arguments\": \"\"}\n347\t\t\t\t}\n348\t\t\t\tif n := strVal(fnDelta[\"name\"]); n != \"\" {\n349\t\t\t\t\tfn[\"name\"] = strVal(fn[\"name\"]) + n\n350\t\t\t\t}\n351\t\t\t\tif a := strVal(fnDelta[\"arguments\"]); a != \"\" {\n352\t\t\t\t\tfn[\"arguments\"] = strVal(fn[\"arguments\"]) + a\n353\t\t\t\t}\n354\t\t\t\texisting[\"function\"] = fn\n355\t\t\t}\n356\t\t\ttoolCalls[idx] = existing\n357\t\t\tmsg[\"tool_calls\"] = toolCalls\n358\t\t\tr.mirrorToolCall(idx, existing)\n359\t\t}\n360\t\n361\t\tif finishReason != nil && finishReason != \"\" {\n362\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"finish_reason\"] = finishReason\n363\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk finish_reason=%v\", finishReason)\n364\t\t}\n365\t\n366\t\tif u, ok := rawUsage.(map[string]any); ok {\n367\t\t\tr.mergeChatUsage(u)\n368\t\t}\n369\t\tif choiceUsage != nil {\n370\t\t\tr.mergeChatUsage(choiceUsage)\n371\t\t}\n372\t}\n373\t\n374\t// chatTextBlock 获取或创建快照中的文本内容块。\n375\t// 返回 content 数组中第一个 type=\"text\" 的块；如果不存在则新建一个。\n376\tfunc (r *SSEReassembler) chatTextBlock() map[string]any {\n377\t\tcontent := r.snap[\"content\"].([]any)\n378\t\tfor _, b := range content {\n379\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"text\" {\n380\t\t\t\treturn block\n381\t\t\t}\n382\t\t}\n383\t\tblock := map[string]any{\"type\": \"text\", \"text\": \"\"}\n384\t\tr.snap[\"content\"] = append(content, block)\n385\t\treturn block\n386\t}\n387\t\n388\t// mirrorReasoning 将 reasoning_content 同步到 content 数组中的 thinking 块。\n389\t// 如果 content 中不存在 thinking 块，则在开头插入一个。\n390\tfunc (r *SSEReassembler) mirrorReasoning(reasoning string) {\n391\t\tcontent := r.snap[\"content\"].([]any)\n392\t\tfor _, b := range content {\n393\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n394\t\t\t\tblock[\"thinking\"] = reasoning\n395\t\t\t\treturn\n396\t\t\t}\n397\t\t}\n398\t\tblock := map[string]any{\"type\": \"thinking\", \"thinking\": reasoning}\n399\t\tr.snap[\"content\"] = append([]any{block}, content...)\n400\t}\n401\t\n402\t// mirrorToolCall 将 Chat Completions 的 tool_call 同步到 Anthropic 格式的 content 数组中。\n403\t//\n404\t// 同步规则：\n405\t//   - 在 content 数组中查找或创建对应的 tool_use 块\n406\t//   - 将 function name 映射为 tool_use 的 name\n407\t//   - 将 arguments JSON 解析后映射为 tool_use 的 input\n408\t//   - thinking 块的存在会影响工具调用块在 content 中的索引偏移\n409\tfunc (r *SSEReassembler) mirrorToolCall(idx int, tc map[string]any) {\n410\t\tcontent := r.snap[\"content\"].([]any)\n411\t\t// 如果存在 thinking 块，工具调用的位置需要偏移 1\n412\t\toffset := 1\n413\t\tfor _, b := range content {\n414\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n415\t\t\t\toffset = 2\n416\t\t\t\tbreak\n417\t\t\t}\n418\t\t}\n419\t\ttarget := idx + offset\n420\t\tfor len(content) <= target {\n421\t\t\tcontent = append(content, map[string]any{\"type\": \"tool_use\", \"id\": \"\", \"name\": \"\", \"input\": map[string]any{}})\n422\t\t}\n423\t\tblock := content[target].(map[string]any)\n424\t\tif id := strVal(tc[\"id\"]); id != \"\" {\n425\t\t\tblock[\"id\"] = id\n426\t\t}\n427\t\tif fn, ok := tc[\"function\"].(map[string]any); ok {\n428\t\t\tif n := strVal(fn[\"name\"]); n != \"\" {\n429\t\t\t\tblock[\"name\"] = n\n430\t\t\t}\n431\t\t\tif args := strVal(fn[\"arguments\"]); args != \"\" {\n432\t\t\t\tvar parsed any\n433\t\t\t\tif json.Unmarshal([]byte(args), &parsed) == nil {\n434\t\t\t\t\tblock[\"input\"] = parsed\n435\t\t\t\t}\n436\t\t\t}\n437\t\t}\n438\t\tr.snap[\"content\"] = content\n439\t}\n440\t\n441\t// mergeChatUsage 将 OpenAI Chat Completions 的 usage 数据标准化后合并到快照。\n442\tfunc (r *SSEReassembler) mergeChatUsage(u map[string]any) {\n443\t\tr.snap[\"usage\"] = usage.NormalizeUsage(u)\n444\t}\n445\t\n446\t// --- 辅助函数 ---\n447\t\n448\t// deepCopy 通过 JSON 序列化/反序列化实现 map 的深拷贝。\n449\tfunc deepCopy(m map[string]any) map[string]any {\n450\t\tif m == nil {\n451\t\t\treturn nil\n452\t\t}\n453\t\tdata, _ := json.Marshal(m)\n454\t\tresult := make(map[string]any)\n455\t\t_ = json.Unmarshal(data, &result)\n456\t\treturn result\n457\t}\n458\t\n459\t// float64Val 将任意数值类型转换为 float64。\n460\t// 支持 float64、int、int64；不支持的类型返回 0。\n461\tfunc float64Val(v any) float64 {\n462\t\tswitch n := v.(type) {\n463\t\tcase float64:\n464\t\t\treturn n\n465\t\tcase int:\n466\t\t\treturn float64(n)\n467\t\tcase int64:\n468\t\t\treturn float64(n)\n469\t\t}\n470\t\treturn 0\n471\t}\n472\t\n473\t// strVal 将任意值转换为字符串。\n474\t// nil 返回空字符串，string 类型直接返回，其他类型使用 fmt.Sprintf 格式化。\n475\tfunc strVal(v any) string {\n476\t\tif v == nil {\n477\t\t\treturn \"\"\n478\t\t}\n479\t\tif s, ok := v.(string); ok {\n480\t\t\treturn s\n481\t\t}\n482\t\treturn fmt.Sprintf(\"%v\", v)\n483\t}\n484\t\n485\t// fieldStr 从 map 中安全获取字段值。\n486\tfunc fieldStr(m map[string]any, key string) any {\n487\t\tv, _ := m[key]\n488\t\treturn v\n489\t}\n490\t\n491\t// sliceField 从 map 中获取 []any 类型的字段，如果不存在或类型不匹配则返回 nil。\n492\tfunc sliceField(m map[string]any, key string) []any {\n493\t\tv, _ := m[key].([]any)\n494\t\tif v == nil {\n495\t\t\treturn nil\n496\t\t}\n497\t\treturn v\n498\t}\n499\t"}]}
