ool_use 的 assistant 消息无条件注入（空字符串无害，但能防止 Kimi 报错）。\nfunc injectThinkingContent(body []byte, parsed any) []byte {\n\tif len(body) == 0 {\n\t\treturn body\n\t}\n\n\tm, ok := parsed.(map[string]any)\n\tif !ok {\n\t\treturn body // 非 JSON 或非对象\n\t}\n\n\t// 获取 messages 数组（无 messages 则无需处理）\n\tmessages, ok := m[\"messages\"].([]any)\n\tif !ok || len(messages) == 0 {\n\t\treturn body\n\t}"},"tool_use_id":"call_cace99b563b54233a975e901","tool_response":"The file D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/reverse.go has been updated successfully. (file state is current in your context — no need to Read it back)"}]}
