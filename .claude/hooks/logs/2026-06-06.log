h)\n41\t\n42\t\tdata, err := os.ReadFile(path)\n43\t\tif err != nil {\n44\t\t\tif os.IsNotExist(err) {\n45\t\t\t\tlogger.Debug(\"config\", \"profiles.json not found\")\n46\t\t\t\treturn nil, nil\n47\t\t\t}\n48\t\t\treturn nil, fmt.Errorf(\"read profiles: %w\", err)\n49\t\t}\n50\t\n51\t\tvar pf ProfilesFile\n52\t\tif err := json.Unmarshal(data, &pf); err != nil {\n53\t\t\treturn nil, fmt.Errorf(\"parse profiles: %w\", err)\n54\t\t}\n55\t\n56\t\tlogger.Debug(\"config\", \"profiles loaded: default=%s count=%d\", pf.Default, len(pf.Profiles))\n57\t\treturn &pf, nil\n58\t}\n59\t\n60\t// ResolveProfileConfig 解析指定名称的配置。\n61\t// 如果 name 为空，使用 profiles.json 中的 default 字段。\n62\t// 如果 name 非空但未找到对应配置，返回错误。\n63\tfunc ResolveProfileConfig(name string) (*ProfileConfig, error) {\n64\t\tpf, err := ReadProfiles()\n65\t\tif err != nil {\n66\t\t\treturn nil, err\n67\t\t}\n68\t\tif pf == nil {\n69\t\t\treturn nil, fmt.Errorf(\"profiles.json not found\")\n70\t\t}\n71\t\n72\t\t// 使用默认配置名\n73\t\tif name == \"\" {\n74\t\t\tname = pf.Default\n75\t\t}\n76\t\tif name == \"\" {\n77\t\t\treturn nil, fmt.Errorf(\"no profile name specified and no default configured\")\n78\t\t}\n79\t\n80\t\tp, ok := pf.Profiles[name]\n81\t\tif !ok {\n82\t\t\treturn nil, fmt.Errorf(\"profile %q not found in profiles.json\", name)\n83\t\t}\n84\t\n85\t\tlogger.Info(\"config\", \"resolved profile: %s (base_url=%s)\", name, p.BaseURL)\n86\t\treturn &p, nil\n87\t}\n88\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\config\\resolve.go"},"tool_use_id":"call_d0ab1558c2404c3cb5ba2858","tool_response":"1\tpackage config\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\n6\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n7\t)\n8\t\n9\t// ResolvedConfig 包含按优先级链解析后的最终配置。\n10\ttype ResolvedConfig struct {\n11\t\tBaseURL   string // 最终的上游 API 地址\n12\t\tAPIKey    string // 最终的 API Key（可能为空）\n13\t\tAuthToken string // 最终的 OAuth Token（可能为空）\n14\t}\n15\t\n16\t// ResolveTargetConfig 按优先级解析最终的上游 API 配置。\n17\t//\n18\t// 优先级（从高到低）：\n19\t//\n20\t//\t1. cliBaseURL / cliAPIKey / cliAuthToken（命令行直接指定）\n21\t//\t2. profileName（读取 profiles.json）\n22\t//\t3. 环境变量（ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL）\n23\t//\t4. ~/.claude.json（Claude Code 配置文件）\n24\t//\t5. 默认值\n25\tfunc ResolveTargetConfig(cliBaseURL, cliAPIKey, cliAuthToken, profileName string, cfg *ClientConfig) (*ResolvedConfig, error) {\n26\t\tresult := &ResolvedConfig{}\n27\t\n28\t\t// Level 2: 从 profiles.json 读取配置\n29\t\tif profileName != \"\" {\n30\t\t\tp, err := ResolveProfileConfig(profileName)\n31\t\t\tif err != nil {\n32\t\t\t\tlogger.Warn(\"config\", \"profile resolution failed: %v\", err)\n33\t\t\t} else {\n34\t\t\t\tresult.BaseURL = p.BaseURL\n35\t\t\t\tresult.APIKey = p.APIKey\n36\t\t\t\tresult.AuthToken = p.AuthToken\n37\t\t\t}\n38\t\t}\n39\t\n40\t\t// Level 1: 命令行直接指定，覆盖 profile 值\n41\t\tif cliBaseURL != \"\" {\n42\t\t\tresult.BaseURL = cliBaseURL\n43\t\t}\n44\t\tif cliAPIKey != \"\" {\n45\t\t\tresult.APIKey = cliAPIKey\n46\t\t}\n47\t\tif cliAuthToken != \"\" {\n48\t\t\tresult.AuthToken = cliAuthToken\n49\t\t}\n50\t\n51\t\t// Level 3: 环境变量（仅在仍为空时）\n52\t\tif result.BaseURL == \"\" {\n53\t\t\tif env := os.Getenv(cfg.BaseURLEnv); env != \"\" {\n54\t\t\t\tresult.BaseURL = env\n55\t\t\t\tlogger.Debug(\"config\", \"base_url from env %s\", cfg.BaseURLEnv)\n56\t\t\t}\n57\t\t}\n58\t\tif result.APIKey == \"\" && result.AuthToken == \"\" {\n59\t\t\tif env := os.Getenv(\"ANTHROPIC_API_KEY\"); env != \"\" {\n60\t\t\t\tresult.APIKey = env\n61\t\t\t\tlogger.Debug(\"config\", \"api_key from env ANTHROPIC_API_KEY\")\n62\t\t\t}\n63\t\t\tif env := os.Getenv(\"ANTHROPIC_AUTH_TOKEN\"); env != \"\" {\n64\t\t\t\tresult.AuthToken = env\n65\t\t\t\tlogger.Debug(\"config\", \"auth_token from env ANTHROPIC_AUTH_TOKEN\")\n66\t\t\t}\n67\t\t}\n68\t\n69\t\t// Level 4: ~/.claude.json（仅在 base_url 仍为空时）\n70\t\tif result.BaseURL == \"\" && cfg == &ClaudeClient {\n71\t\t\tcc, err := ReadClaudeConfig()\n72\t\t\tif err == nil && cc != nil {\n73\t\t\t\tif url := ClaudeBaseURLFromConfig(cc); url != \"\" {\n74\t\t\t\t\tresult.BaseURL = url\n75\t\t\t\t\tlogger.Debug(\"config\", \"base_url from ~/.claude.json\")\n76\t\t\t\t}\n77\t\t\t}\n78\t\t}\n79\t\n80\t\t// Level 5: 默认值\n81\t\tif result.BaseURL == \"\" {\n82\t\t\tresult.BaseURL = cfg.DefaultTarget\n83\t\t}\n84\t\n85\t\tauthType := \"none\"\n86\t\tif result.APIKey != \"\" {\n87\t\t\tauthType = \"api_key\"\n88\t\t} else if result.AuthToken != \"\" {\n89\t\t\tauthType = \"auth_token\"\n90\t\t}\n91\t\tlogger.Info(\"config\", \"resolved: base_url=%s auth=%s\", result.BaseURL, authType)\n92\t\treturn result, nil\n93\t}\n94\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\config\\client.go"},"tool_use_id":"call_84172ee0958a43d8ab5294db","tool_response":"1\t// Package config 提供代理所需的配置读取与解析功能。\n2\tpackage config\n3\t\n4\timport (\n5\t\t\"fmt\"\n6\t\t\"os\"\n7\t\t\"os/exec\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n11\t)\n12\t\n13\t// ClientConfig 定义通过代理启动 AI CLI 时的单客户端配置。\n14\ttype ClientConfig struct {\n15\t\tCmd               string   // 要定位的二进制文件名\n16\t\tBaseURLEnv         string   // 用于覆盖 base URL 的环境变量名\n17\t\tDefaultTarget      string   // 无覆盖时的默认上游 API 地址\n18\t\tNestingEnvKeys     []string // 启动前需清空的环境变量（防止嵌套代理）\n19\t\tInjectSettingsEnv  bool     // 是否通过 --settings 参数注入 base URL（Claude Code 专用）\n20\t}\n21\t\n22\t// ClaudeClient 是 Claude Code 的默认配置。\n23\tvar ClaudeClient = ClientConfig{\n24\t\tCmd:              \"claude\",\n25\t\tBaseURLEnv:       \"ANTHROPIC_BASE_URL\",\n26\t\tDefaultTarget:    \"https://api.anthropic.com\",\n27\t\tNestingEnvKeys:   []string{\"CLAUDECODE\", \"CLAUDE_CODE_SSE_PORT\"},\n28\t\tInjectSettingsEnv: true,\n29\t}\n30\t\n31\t// DetectTarget 按优先级确定上游 API URL：\n32\t//  1. 显式环境变量（如 ANTHROPIC_BASE_URL）\n33\t//  2. ~/.claude.json 配置文件\n34\t//  3. 默认目标地址\n35\tfunc DetectTarget(cfg *ClientConfig) string {\n36\t\t// 优先检查环境变量\n37\t\tif envURL := os.Getenv(cfg.BaseURLEnv); envURL != \"\" {\n38\t\t\tlogger.Debug(\"config\", \"detected target from env %s=%s\", cfg.BaseURLEnv, envURL)\n39\t\t\treturn envURL\n40\t\t}\n41\t\tlogger.Debug(\"config\", \"env %s not set\", cfg.BaseURLEnv)\n42\t\n43\t\t// 若为 ClaudeClient，则尝试读取 ~/.claude.json\n44\t\tif cfg == &ClaudeClient {\n45\t\t\tcc, err := ReadClaudeConfig()\n46\t\t\tif err == nil && cc != nil {\n47\t\t\t\tif url := ClaudeBaseURLFromConfig(cc); url != \"\" {\n48\t\t\t\t\tlogger.Debug(\"config\", \"detected target from claude config: %s\", url)\n49\t\t\t\t\treturn url\n50\t\t\t\t}\n51\t\t\t}\n52\t\t}\n53\t\n54\t\tlogger.Info(\"config\", \"upstream target: %s\", cfg.DefaultTarget)\n55\t\treturn cfg.DefaultTarget\n56\t}\n57\t\n58\t// ResolveCmd 在 PATH 中查找客户端二进制文件的完整路径。\n59\tfunc ResolveCmd(cfg *ClientConfig) (string, error) {\n60\t\tpath, err := exec.LookPath(cfg.Cmd)\n61\t\tif err != nil {\n62\t\t\treturn \"\", fmt.Errorf(\"'%s' command not found in PATH.\\nPlease install it first\", cfg.Cmd)\n63\t\t}\n64\t\tlogger.Debug(\"config\", \"resolved command: %s -> %s\", cfg.Cmd, path)\n65\t\treturn path, nil\n66\t}\n67\t\n68\t// BuildChildEnv 创建子进程所需的环境变量：\n69\t//   - 继承当前环境\n70\t//   - 将 base URL 环境变量指向本地代理\n71\t//   - 清空嵌套代理相关环境变量\n72\tfunc BuildChildEnv(cfg *ClientConfig, proxyURL string) []string {\n73\t\tenv := os.Environ()\n74\t\n75\t\tresult := make([]string, 0, len(env)+1)\n76\t\tcleared := make(map[string]bool)\n77\t\tfor _, k := range cfg.NestingEnvKeys {\n78\t\t\tcleared[k] = true\n79\t\t}\n80\t\n81\t\tfor _, e := range env {\n82\t\t\t// 跳过嵌套键与 base URL 环境变量（我们自己设置）\n83\t\t\tskip := false\n84\t\t\tfor _, prefix := range append(clearedKeys(cleared), cfg.BaseURLEnv) {\n85\t\t\t\tif len(e) > len(prefix) && e[:len(prefix)+1] == prefix+\"=\" {\n86\t\t\t\t\tskip = true\n87\t\t\t\t\tbreak\n88\t\t\t\t}\n89\t\t\t}\n90\t\t\tif !skip {\n91\t\t\t\tresult = append(result, e)\n92\t\t\t}\n93\t\t}\n94\t\n95\t\tresult = append(result, cfg.BaseURLEnv+\"=\"+proxyURL)\n96\t\tlogger.Debug(\"config\", \"built child env: %s=%s, cleared %v\", cfg.BaseURLEnv, proxyURL, cfg.NestingEnvKeys)\n97\t\treturn result\n98\t}\n99\t\n100\t// clearedKeys 将 map 的键提取为字符串切片。\n101\tfunc clearedKeys(m map[string]bool) []string {\n102\t\tkeys := make([]string, 0, len(m))\n103\t\tfor k := range m {\n104\t\t\tkeys = append(keys, k)\n105\t\t}\n106\t\treturn keys\n107\t}\n108\t\n109\t// HasSettingsArg 判断参数列表中是否已包含 --settings。\n110\tfunc HasSettingsArg(args []string) bool {\n111\t\tfor _, arg := range args {\n112\t\t\tif arg == \"--settings\" || strings.HasPrefix(arg, \"--settings=\") {\n113\t\t\t\treturn true\n114\t\t\t}\n115\t\t}\n116\t\treturn false\n117\t}\n118\t\n119\t// BuildSettingsArgs 返回 [\"--settings\", JSON] 用于通过 Claude 的 settings 注入代理 URL。\n120\tfunc BuildSettingsArgs(cfg *ClientConfig, proxyURL string) []string {\n121\t\tenvJSON := fmt.Sprintf(`{\"env\":{\"%s\":\"%s\"}}`, cfg.BaseURLEnv, proxyURL)\n122\t\treturn []string{\"--settings\", envJSON}\n123\t}\n124\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\config\\claudeconfig.go"},"tool_use_id":"call_137ce84a0456461ca7dac540","tool_response":"1\t// Package config 提供代理所需的配置读取与解析功能。\n2\tpackage config\n3\t\n4\timport (\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"runtime\"\n10\t\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n12\t)\n13\t\n14\t// ClaudeConfig 表示 ~/.claude.json 配置文件中我们关心的子集。\n15\ttype ClaudeConfig struct {\n16\t\tBaseURL string `json:\"base_url,omitempty\"` // 顶层 base_url 字段\n17\t\tEnv     struct {\n18\t\t\tAnthropicBaseURL string `json:\"ANTHROPIC_BASE_URL,omitempty\"` // env 下的 ANTHROPIC_BASE_URL\n19\t\t} `json:\"env,omitempty\"`\n20\t}\n21\t\n22\t// ReadClaudeConfig 读取并解析 ~/.claude.json 配置文件。\n23\t// 如果文件不存在，返回 nil 且不报错。\n24\tfunc ReadClaudeConfig() (*ClaudeConfig, error) {\n25\t\thome, err := os.UserHomeDir()\n26\t\tif err != nil {\n27\t\t\treturn nil, nil\n28\t\t}\n29\t\n30\t\tpath := filepath.Join(home, \".claude.json\")\n31\t\tlogger.Debug(\"config\", \"reading claude config: %s\", path)\n32\t\n33\t\tdata, err := os.ReadFile(path)\n34\t\tif err != nil {\n35\t\t\tif os.IsNotExist(err) {\n36\t\t\t\tlogger.Debug(\"config\", \"claude config not found\")\n37\t\t\t\treturn nil, nil\n38\t\t\t}\n39\t\t\treturn nil, fmt.Errorf(\"read claude config: %w\", err)\n40\t\t}\n41\t\n42\t\tvar cfg ClaudeConfig\n43\t\tif err := json.Unmarshal(data, &cfg); err != nil {\n44\t\t\treturn nil, nil // 格式错误不致命，忽略即可\n45\t\t}\n46\t\tlogger.Debug(\"config\", \"claude config loaded: base_url=%s\", cfg.BaseURL)\n47\t\treturn &cfg, nil\n48\t}\n49\t\n50\t// ClaudeBaseURLFromConfig 从 ClaudeConfig 中提取 base URL，\n51\t// 优先检查 env 下的 AnthropicBaseURL，其次使用顶层的 BaseURL。\n52\tfunc ClaudeBaseURLFromConfig(cfg *ClaudeConfig) string {\n53\t\tif cfg == nil {\n54\t\t\treturn \"\"\n55\t\t}\n56\t\tif cfg.Env.AnthropicBaseURL != \"\" {\n57\t\t\treturn cfg.Env.AnthropicBaseURL\n58\t\t}\n59\t\treturn cfg.BaseURL\n60\t}\n61\t\n62\t// HomeDir 返回跨平台的用户主目录。\n63\t// Windows 下优先使用 USERPROFILE 环境变量。\n64\tfunc HomeDir() string {\n65\t\tif runtime.GOOS == \"windows\" {\n66\t\t\tif home := os.Getenv(\"USERPROFILE\"); home != \"\" {\n67\t\t\t\treturn home\n68\t\t\t}\n69\t\t}\n70\t\thome, _ := os.UserHomeDir()\n71\t\treturn home\n72\t}\n73\t"}]}
