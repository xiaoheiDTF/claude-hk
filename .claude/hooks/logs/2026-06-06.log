son:\"session_id\"`     // 当前持有者的会话 ID\n35\t\tStatus       string `json:\"status\"`         // 新状态\n36\t}\n37\t\n38\t// --- Session request types ---\n39\t\n40\t// RegisterSessionRequest 是注册新会话的请求体。\n41\ttype RegisterSessionRequest struct {\n42\t\tSessionID      string `json:\"session_id\"`      // 会话唯一 ID（UUID）\n43\t\tMachineID      string `json:\"machine_id\"`      // 机器标识，格式为 whoami@hostname\n44\t\tOS             string `json:\"os\"`              // 操作系统类型\n45\t\tProjectSlug    string `json:\"project_slug\"`    // 项目标识\n46\t\tProjectCwd     string `json:\"project_cwd\"`     // 项目工作目录\n47\t\tTranscriptPath string `json:\"transcript_path\"` // 对话记录文件路径\n48\t\tLocalTracePath string `json:\"local_trace_path\"` // 本地跟踪文件路径\n49\t\tModel          string `json:\"model\"`           // 使用的模型\n50\t\tSource         string `json:\"source\"`          // 会话来源（如 startup/resume）\n51\t}\n52\t\n53\t// CloseSessionRequest 是关闭会话的请求体。\n54\ttype CloseSessionRequest struct {\n55\t\tSessionID string `json:\"session_id\"` // 要关闭的会话 ID\n56\t\tReason    string `json:\"reason\"`     // 关闭原因\n57\t}\n58\t\n59\t// TraceInitRequest 是代理 trace-init 转发请求体。\n60\ttype TraceInitRequest struct {\n61\t\tSessionID      string `json:\"session_id\"`      // 会话唯一 ID\n62\t\tMachineID      string `json:\"machine_id\"`      // 机器标识\n63\t\tProjectSlug    string `json:\"project_slug\"`    // 项目标识\n64\t\tTranscriptPath string `json:\"transcript_path\"` // 对话记录路径\n65\t}\n66\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/response.go"},"tool_use_id":"call_51c4b3cbd1ce4deda24d655f","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"encoding/json\"\n6\t\t\"net/http\"\n7\t\t\"time\"\n8\t)\n9\t\n10\t// --- Issue response types ---\n11\t\n12\t// CheckIssuesResponse 是检查 Issue 状态的响应体。\n13\ttype CheckIssuesResponse struct {\n14\t\tIssues []IssueStatusItem `json:\"issues\"` // Issue 状态列表\n15\t}\n16\t\n17\t// IssueStatusItem 表示单个 Issue 的状态信息。\n18\ttype IssueStatusItem struct {\n19\t\tNumber    int     `json:\"number\"`     // Issue 编号\n20\t\tStatus    string  `json:\"status\"`     // 当前状态\n21\t\tSessionID *string `json:\"session_id\"` // 领取该 Issue 的会话 ID（空闲时为 null）\n22\t\tClaimedAt *string `json:\"claimed_at\"` // 领取时间（空闲时为 null）\n23\t}\n24\t\n25\t// ReleaseIssueResponse 是释放 Issue 的响应体。\n26\ttype ReleaseIssueResponse struct {\n27\t\tSuccess  bool   `json:\"success\"`           // 是否成功\n28\t\tReleased *bool  `json:\"released,omitempty\"` // 是否已释放\n29\t\tError    string `json:\"error,omitempty\"`    // 错误信息（如果有）\n30\t}\n31\t\n32\t// ClaimIssueResponse 是领取 Issue 的响应体。\n33\ttype ClaimIssueResponse struct {\n34\t\tSuccess   bool    `json:\"success\"`             // 是否成功\n35\t\tStatus    string  `json:\"status,omitempty\"`    // 领取后的状态\n36\t\tClaimedAt *string `json:\"claimed_at,omitempty\"` // 领取时间\n37\t\tError     string  `json:\"error,omitempty\"`      // 错误信息\n38\t\tClaimedBy *string `json:\"claimed_by,omitempty\"` // 已被谁领取\n39\t\tMessage   string  `json:\"message,omitempty\"`    // 提示信息\n40\t}\n41\t\n42\t// ReleaseSessionResponse 是释放会话下所有 Issue 的响应体。\n43\ttype ReleaseSessionResponse struct {\n44\t\tReleased []int `json:\"released\"` // 被释放的 Issue 编号列表\n45\t\tCount    int   `json:\"count\"`    // 释放数量\n46\t}\n47\t\n48\t// UpdateStatusResponse 是更新 Issue 状态的响应体。\n49\ttype UpdateStatusResponse struct {\n50\t\tSuccess        bool   `json:\"success\"`                  // 是否成功\n51\t\tPreviousStatus string `json:\"previous_status,omitempty\"` // 更新前的状态\n52\t\tNewStatus      string `json:\"new_status,omitempty\"`      // 更新后的状态\n53\t\tError          string `json:\"error,omitempty\"`           // 错误信息\n54\t}\n55\t\n56\t// IssuesListResponse 是 Issue 列表的响应体。\n57\ttype IssuesListResponse struct {\n58\t\tIssues     []IssueListItem `json:\"issues\"`      // Issue 列表\n59\t\tTotal      int             `json:\"total\"`       // 总数量\n60\t\tPage       int             `json:\"page\"`        // 当前页码\n61\t\tPageSize   int             `json:\"page_size\"`   // 每页大小\n62\t\tTotalPages int             `json:\"total_pages\"` // 总页数\n63\t}\n64\t\n65\t// IssueListItem 是 Issue 列表中的单个条目。\n66\ttype IssueListItem struct {\n67\t\tID           int64      `json:\"id\"`\n68\t\tRepoFullName string     `json:\"repo_full_name\"`\n69\t\tIssueNumber  int        `json:\"issue_number\"`\n70\t\tIssueTitle   *string    `json:\"issue_title\"`\n71\t\tStatus       string     `json:\"status\"`\n72\t\tSessionID    *string    `json:\"session_id\"`\n73\t\tClaimedAt    *time.Time `json:\"claimed_at\"`\n74\t\tUpdatedAt    time.Time  `json:\"updated_at\"`\n75\t}\n76\t\n77\t// --- Session response types ---\n78\t\n79\t// SessionListResponse 是会话列表的响应体。\n80\ttype SessionListResponse struct {\n81\t\tSessions []SessionListItem `json:\"sessions\"` // 会话列表\n82\t}\n83\t\n84\t// SessionIssuesResponse 是会话关联 Issue 的响应体。\n85\ttype SessionIssuesResponse struct {\n86\t\tIssues []IssueListItem `json:\"issues\"` // 会话关联的 Issue 列表\n87\t}\n88\t\n89\t// SessionTokensResponse 是会话 Token 统计的响应体。\n90\ttype SessionTokensResponse struct {\n91\t\tSessionID    string `json:\"session_id\"`\n92\t\tAPICalls     int    `json:\"api_calls\"`\n93\t\tInputTokens  int    `json:\"input_tokens\"`\n94\t\tOutputTokens int    `json:\"output_tokens\"`\n95\t\tCacheRead    int    `json:\"cache_read\"`\n96\t\tCacheCreate  int    `json:\"cache_create\"`\n97\t\tTotalTokens  int    `json:\"total_tokens\"`\n98\t}\n99\t\n100\t// SessionTracesResponse 是会话 Trace 文件列表的响应体。\n101\ttype SessionTracesResponse struct {\n102\t\tSessionID string      `json:\"session_id\"`\n103\t\tTraces    []TraceItem `json:\"traces\"`\n104\t}\n105\t\n106\t// TraceItem 是单个 Trace 文件的信息。\n107\ttype TraceItem struct {\n108\t\tPath      string `json:\"path\"`\n109\t\tSizeBytes int64  `json:\"size_bytes\"`\n110\t\tLineCount int    `json:\"line_count\"`\n111\t\tDate      string `json:\"date\"`\n112\t\tFilename  string `json:\"filename\"`\n113\t}\n114\t\n115\t// SessionListItem 是会话列表中的单个条目。\n116\ttype SessionListItem struct {\n117\t\tSessionID    string     `json:\"session_id\"`    // 会话 ID\n118\t\tMachineID    string     `json:\"machine_id\"`    // 机器 ID\n119\t\tProjectSlug  string     `json:\"project_slug\"`  // 项目标识\n120\t\tStatus       string     `json:\"status\"`        // 会话状态\n121\t\tRegisteredAt time.Time  `json:\"registered_at\"` // 注册时间\n122\t\tClosedAt     *time.Time `json:\"closed_at,omitempty\"` // 关闭时间（未关闭时为 null）\n123\t}\n124\t\n125\t// SessionDetail 是会话详情的响应体。\n126\ttype SessionDetail struct {\n127\t\tSessionID      string     `json:\"session_id\"`      // 会话 ID\n128\t\tMachineID      string     `json:\"machine_id\"`      // 机器 ID\n129\t\tOS             string     `json:\"os\"`              // 操作系统\n130\t\tProjectSlug    string     `json:\"project_slug\"`    // 项目标识\n131\t\tProjectCwd     string     `json:\"project_cwd\"`     // 项目工作目录\n132\t\tTranscriptPath string     `json:\"transcript_path\"` // 对话记录路径\n133\t\tLocalTracePath string     `json:\"local_trace_path\"` // 本地跟踪路径\n134\t\tModel          string     `json:\"model\"`           // 使用的模型\n135\t\tSource         string     `json:\"source\"`          // 来源\n136\t\tStatus         string     `json:\"status\"`          // 状态\n137\t\tRegisteredAt   time.Time  `json:\"registered_at\"`   // 注册时间\n138\t\tClosedAt       *time.Time `json:\"closed_at,omitempty\"` // 关闭时间\n139\t\tCloseReason    string     `json:\"close_reason,omitempty\"` // 关闭原因\n140\t}\n141\t\n142\t// --- Machine response types ---\n143\t\n144\t// MachinesListResponse 是机器列表的响应体。\n145\ttype MachinesListResponse struct {\n146\t\tMachines []MachineListItem `json:\"machines\"` // 机器列表\n147\t}\n148\t\n149\t// MachineListItem 是机器列表中的单个条目。\n150\ttype MachineListItem struct {\n151\t\tID          int64      `json:\"id\"`\n152\t\tMachineID   string     `json:\"machine_id\"`\n153\t\tOS          string     `json:\"os\"`\n154\t\tHostname    string     `json:\"hostname\"`\n155\t\tUsername    string     `json:\"username\"`\n156\t\tFirstSeenAt time.Time  `json:\"first_seen_at\"`\n157\t\tLastSeenAt  *time.Time `json:\"last_seen_at\"`\n158\t}\n159\t\n160\t// --- Project response types ---\n161\t\n162\t// ProjectsListResponse 是项目列表的响应体。\n163\ttype ProjectsListResponse struct {\n164\t\tProjects []ProjectListItem `json:\"projects\"` // 项目列表\n165\t}\n166\t\n167\t// ProjectListItem 是项目列表中的单个条目。\n168\ttype ProjectListItem struct {\n169\t\tID          int64     `json:\"id\"`\n170\t\tProjectSlug string    `json:\"project_slug\"`\n171\t\tProjectCwd  string    `json:\"project_cwd\"`\n172\t\tFirstSeenAt time.Time `json:\"first_seen_at\"`\n173\t\tLastSeenAt  time.Time `json:\"last_seen_at\"`\n174\t}\n175\t\n176\t// --- Config response types ---\n177\t\n178\t// ConfigResponse 是配置查询/更新的响应体。\n179\ttype ConfigResponse struct {\n180\t\tConfig map[string]interface{} `json:\"config\"` // 配置项键值对\n181\t}\n182\t\n183\t// --- Log response types ---\n184\t\n185\t// LogsResponse 是日志查询的响应体。\n186\ttype LogsResponse struct {\n187\t\tLogs []LogItem `json:\"logs\"` // 日志条目列表\n188\t}\n189\t\n190\t// LogItem 是单条日志记录。\n191\ttype LogItem struct {\n192\t\tTimestamp string `json:\"timestamp\"` // 时间戳，如 \"2026-06-01 20:56:28.000\"\n193\t\tLevel     string `json:\"level\"`     // 日志级别：DEBUG/INFO/WARN/ERROR\n194\t\tSource    string `json:\"source\"`    // 来源模块\n195\t\tMessage   string `json:\"message\"`   // 日志内容\n196\t}\n197\t\n198\t// --- Proxy response types ---\n199\t\n200\t// ProxiesResponse 是代理列表的响应体。\n201\ttype ProxiesResponse struct {\n202\t\tProxies []ProxyItem `json:\"proxies\"` // 代理列表\n203\t\tTotal   int         `json:\"total\"`   // 总数量\n204\t}\n205\t\n206\t// ProxyItem 是代理列表中的单个条目。\n207\ttype ProxyItem struct {\n208\t\tProxyID      string     `json:\"proxy_id\"`                // 代理唯一 ID\n209\t\tProjectSlug  string     `json:\"project_slug\"`            // 项目标识\n210\t\tStatus       string     `json:\"status\"`                  // 状态：active/offline\n211\t\tRegisteredAt time.Time  `json:\"registered_at\"`           // 注册时间\n212\t\tLastPingAt   *time.Time `json:\"last_ping_at,omitempty\"`  // 最后心跳时间\n213\t}\n214\t\n215\t// --- Status response types ---\n216\t\n217\t// StatusResponse 是系统状态的响应体。\n218\ttype StatusResponse struct {\n219\t\tStatus        string     `json:\"status\"`         // 系统状态：healthy\n220\t\tVersion       string     `json:\"version\"`        // 版本号\n221\t\tUptimeSeconds int64      `json:\"uptime_seconds\"` // 运行时间（秒）\n222\t\tStats         SystemStats `json:\"stats\"`          // 统计信息\n223\t\tTimestamp     time.Time  `json:\"timestamp\"`      // 时间戳\n224\t}\n225\t\n226\t// SystemStats 是系统统计信息的响应结构。\n227\ttype SystemStats struct {\n228\t\tActiveSessions int64 `json:\"active_sessions\"` // 活跃会话数\n229\t\tActiveProxies  int64 `json:\"active_proxies\"`  // 活跃代理数\n230\t\tPendingIssues  int64 `json:\"pending_issues\"`  // 待处理 Issue 数\n231\t\tTotalMachines  int64 `json:\"total_machines\"`  // 机器总数\n232\t\tTotalProjects  int64 `json:\"total_projects\"`  // 项目总数\n233\t}\n234\t\n235\t// --- Shared helpers ---\n236\t\n237\t// APIError 是统一的 API 错误结构体。\n238\ttype APIError struct {\n239\t\tCode    string `json:\"error\"`   // 错误码\n240\t\tMessage string `json:\"message\"` // 错误描述\n241\t}\n242\t\n243\t// writeJSON 向响应中写入 JSON 数据，设置 Content-Type 为 application/json。\n244\tfunc writeJSON(w http.ResponseWriter, status int, v any) {\n245\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n246\t\tw.WriteHeader(status)\n247\t\tjson.NewEncoder(w).Encode(v)\n248\t}\n249\t\n250\t// writeError 向响应中写入统一的 API 错误信息。\n251\tfunc writeError(w http.ResponseWriter, status int, code, message string) {\n252\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n253\t\tw.WriteHeader(status)\n254\t\tjson.NewEncoder(w).Encode(APIError{Code: code, Message: message})\n255\t}\n256\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/router.go"},"tool_use_id":"call_19e4377b1cc34267ae93f3ff","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"net/http\"\n6\t\t\"strings\"\n7\t\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n9\t)\n10\t\n11\t// Handlers 聚合所有 HTTP 处理器的结构体。\n12\ttype Handlers struct {\n13\t\tIssue   *IssueHandler   // Issue 相关接口处理器\n14\t\tSession *SessionHandler // Session 相关接口处理器\n15\t\tProxy   *ProxyHandler   // 代理注册和 trace-init 转发处理器\n16\t\tMachine *MachineHandler // Machine 相关接口处理器\n17\t\tProject *ProjectHandler // Project 相关接口处理器\n18\t\tLog     *LogHandler     // Log 相关接口处理器\n19\t\tConfig  *ConfigHandler  // Config 相关接口处理器\n20\t\tStatus  *StatusHandler  // 系统状态处理器\n21\t}\n22\t\n23\t// NewRouter 创建并返回 HTTP 路由器，注册所有 API 端点。\n24\tfunc NewRouter(h Handlers) http.Handler {\n25\t\tmux := http.NewServeMux()\n26\t\t// 健康检查端点\n27\t\tmux.HandleFunc(\"/health\", Health)\n28\t\n29\t\t// Issue 相关路由。\n30\t\tmux.HandleFunc(\"/api/issue/check\", h.Issue.CheckIssues)         // 检查 Issue 状态\n31\t\tmux.HandleFunc(\"/api/issue/claim\", h.Issue.ClaimIssue)          // 领取 Issue\n32\t\tmux.HandleFunc(\"/api/issue/release\", h.Issue.ReleaseIssue)      // 释放 Issue\n33\t\tmux.HandleFunc(\"/api/issue/release-session\", h.Issue.ReleaseSession) // 释放会话下所有 Issue\n34\t\tmux.HandleFunc(\"/api/issue/status\", h.Issue.UpdateStatus)       // 更新 Issue 状态\n35\t\tmux.HandleFunc(\"/api/issues\", h.Issue.ListIssues)               // 列出所有 Issue\n36\t\n37\t\t// Session 相关路由。\n38\t\tmux.HandleFunc(\"/api/session/register\", h.Session.Register) // 注册会话\n39\t\tmux.HandleFunc(\"/api/session/close\", h.Session.Close)       // 关闭会话\n40\t\tmux.HandleFunc(\"/api/sessions\", h.Session.List)             // 获取会话列表\n41\t\tmux.HandleFunc(\"/api/session/\", func(w http.ResponseWriter, r *http.Request) {\n42\t\t\tpath := r.URL.Path\n43\t\t\tswitch {\n44\t\t\tcase strings.HasSuffix(path, \"/issues\"):\n45\t\t\t\th.Session.GetIssues(w, r)\n46\t\t\tcase strings.HasSuffix(path, \"/tokens\"):\n47\t\t\t\th.Session.GetTokens(w, r)\n48\t\t\tcase strings.HasSuffix(path, \"/traces\"):\n49\t\t\t\th.Session.GetTraces(w, r)\n50\t\t\tdefault:\n51\t\t\t\th.Session.Get(w, r)\n52\t\t\t}\n53\t\t})\n54\t\n55\t\t// Proxy 相关路由（代理注册 + trace-init 转发 + 代理列表）。\n56\t\tif h.Proxy != nil {\n57\t\t\tmux.HandleFunc(\"/api/proxy/register\", h.Proxy.Register)     // 代理注册\n58\t\t\tmux.HandleFunc(\"/api/proxy/unregister\", h.Proxy.Unregister) // 代理注销\n59\t\t\tmux.HandleFunc(\"/api/proxy/trace-init\", h.Proxy.TraceInit)  // 转发 trace-init\n60\t\t\tmux.HandleFunc(\"/api/proxies\", h.Proxy.List)                // 代理列表\n61\t\t}\n62\t\n63\t\t// Machine 相关路由。\n64\t\tif h.Machine != nil {\n65\t\t\tmux.HandleFunc(\"/api/machines\", h.Machine.List) // 列出所有机器\n66\t\t}\n67\t\n68\t\t// Project 相关路由。\n69\t\tif h.Project != nil {\n70\t\t\tmux.HandleFunc(\"/api/projects\", h.Project.List) // 列出所有项目\n71\t\t}\n72\t\n73\t\t// Log 相关路由。\n74\t\tif h.Log != nil {\n75\t\t\tmux.HandleFunc(\"/api/logs\", h.Log.Query) // 查询日志\n76\t\t}\n77\t\n78\t\t// Config 相关路由（GET + PUT 分发）。\n79\t\tif h.Config != nil {\n80\t\t\tmux.HandleFunc(\"/api/config\", h.Config.ServeHTTP) // 获取/更新配置\n81\t\t}\n82\t\n83\t\t// Status 相关路由。\n84\t\tif h.Status != nil {\n85\t\t\tmux.HandleFunc(\"/api/status\", h.Status.Get) // 系统状态\n86\t\t}\n87\t\n88\t\tlogger.Debug(\"api\", \"routes registered: %d endpoints\", 15)\n89\t\treturn mux\n90\t}\n91\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/health_handler.go"},"tool_use_id":"call_835cb26ac4ec4dffb140c8e7","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"net/http\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n8\t)\n9\t\n10\t// Health 处理健康检查请求，返回服务状态。\n11\tfunc Health(w http.ResponseWriter, r *http.Request) {\n12\t\tlogger.Debug(\"api.health\", \"health check\")\n13\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n14\t}\n15\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/issue_handler.go"},"tool_use_id":"call_c6bee0313f964e6c9c07a48f","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"encoding/json\"\n6\t\t\"math\"\n7\t\t\"net/http\"\n8\t\t\"strconv\"\n9\t\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n12\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n13\t)\n14\t\n15\t// IssueHandler 处理 Issue 相关的 HTTP 请求。\n16\ttype IssueHandler struct {\n17\t\tsvc *service.IssueService // Issue 业务逻辑服务\n18\t}\n19\t\n20\t// NewIssueHandler 创建新的 IssueHandler 实例。\n21\tfunc NewIssueHandler(svc *service.IssueService) *IssueHandler {\n22\t\treturn &IssueHandler{svc: svc}\n23\t}\n24\t\n25\t// CheckIssues 处理检查 Issue 状态的请求。\n26\t// 接收 POST 请求，返回指定仓库中 Issue 的当前状态列表。\n27\tfunc (h *IssueHandler) CheckIssues(w http.ResponseWriter, r *http.Request) {\n28\t\t// 只允许 POST 方法\n29\t\tif r.Method != http.MethodPost {\n30\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n31\t\t\treturn\n32\t\t}\n33\t\n34\t\t// 解析请求体\n35\t\tvar req CheckIssuesRequest\n36\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n37\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n38\t\t\treturn\n39\t\t}\n40\t\n41\t\t// 校验必填字段\n42\t\tif req.RepoFullName == \"\" {\n43\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name is required\")\n44\t\t\treturn\n45\t\t}\n46\t\tif req.IssueNumbers == nil {\n47\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"issue_numbers is required\")\n48\t\t\treturn\n49\t\t}\n50\t\n51\t\tlogger.Debug(\"api.issue\", \"POST /api/issue/check repo=%s\", req.RepoFullName)\n52\t\n53\t\t// 调用服务层查询 Issue 状态\n54\t\tresults, err := h.svc.Check(r.Context(), req.RepoFullName, req.IssueNumbers)\n55\t\tif err != nil {\n56\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to check issues\")\n57\t\t\treturn\n58\t\t}\n59\t\n60\t\t// 转换为响应格式\n61\t\titems := make([]IssueStatusItem, len(results))\n62\t\tfor i, r := range results {\n63\t\t\titems[i] = IssueStatusItem{\n64\t\t\t\tNumber:    r.Number,\n65\t\t\t\tStatus:    r.Status,\n66\t\t\t\tSessionID: r.SessionID,\n67\t\t\t\tClaimedAt: r.ClaimedAt,\n68\t\t\t}\n69\t\t}\n70\t\n71\t\t// 确保返回空数组而非 null\n72\t\tif items == nil {\n73\t\t\titems = []IssueStatusItem{}\n74\t\t}\n75\t\n76\t\twriteJSON(w, http.StatusOK, CheckIssuesResponse{Issues: items})\n77\t}\n78\t\n79\t// ClaimIssue 处理领取 Issue 的请求。\n80\t// 接收 POST 请求，将指定 Issue 标记为已领取状态。\n81\tfunc (h *IssueHandler) ClaimIssue(w http.ResponseWriter, r *http.Request) {\n82\t\tif r.Method != http.MethodPost {\n83\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n84\t\t\treturn\n85\t\t}\n86\t\n87\t\tvar req ClaimIssueRequest\n88\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n89\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n90\t\t\treturn\n91\t\t}\n92\t\n93\t\tif req.RepoFullName == \"\" || req.IssueNumber == 0 || req.SessionID == \"\" {\n94\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name, issue_number and session_id are required\")\n95\t\t\treturn\n96\t\t}\n97\t\n98\t\tlogger.Debug(\"api.issue\", \"POST /api/issue/claim repo=%s #%d\", req.RepoFullName, req.IssueNumber)\n99\t\n100\t\t// 调用服务层领取 Issue\n101\t\tresult, err := h.svc.Claim(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID, req.IssueTitle)\n102\t\tif err != nil {\n103\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to claim issue\")\n104\t\t\treturn\n105\t\t}\n106\t\n107\t\t// 领取成功\n108\t\tif result.Success {\n109\t\t\twriteJSON(w, http.StatusOK, ClaimIssueResponse{\n110\t\t\t\tSuccess:   true,\n111\t\t\t\tStatus:    result.Status,\n112\t\t\t\tClaimedAt: result.ClaimedAt,\n113\t\t\t})\n114\t\t\treturn\n115\t\t}\n116\t\n117\t\t// 已被其他会话领取，返回冲突信息\n118\t\twriteJSON(w, http.StatusConflict, ClaimIssueResponse{\n119\t\t\tSuccess:   false,\n120\t\t\tError:     \"already_claimed\",\n121\t\t\tClaimedBy: result.ClaimedBy,\n122\t\t\tClaimedAt: result.ClaimedAt,\n123\t\t})\n124\t}\n125\t\n126\t// ReleaseIssue 处理释放单个 Issue 的请求。\n127\t// 接收 POST 请求，将指定 Issue 恢复为空闲状态（仅限当前持有者）。\n128\tfunc (h *IssueHandler) ReleaseIssue(w http.ResponseWriter, r *http.Request) {\n129\t\tif r.Method != http.MethodPost {\n130\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n131\t\t\treturn\n132\t\t}\n133\t\n134\t\tvar req ReleaseIssueRequest\n135\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n136\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n137\t\t\treturn\n138\t\t}\n139\t\n140\t\tif req.RepoFullName == \"\" || req.IssueNumber == 0 || req.SessionID == \"\" {\n141\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name, issue_number and session_id are required\")\n142\t\t\treturn\n143\t\t}\n144\t\n145\t\tlogger.Debug(\"api.issue\", \"POST /api/issue/release repo=%s #%d\", req.RepoFullName, req.IssueNumber)\n146\t\n147\t\t// 调用服务层释放 Issue\n148\t\treleased, err := h.svc.Release(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID)\n149\t\tif err != nil {\n150\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to release issue\")\n151\t\t\treturn\n152\t\t}\n153\t\n154\t\t// 不是该会话持有的 Issue\n155\t\tif !released {\n156\t\t\twriteJSON(w, http.StatusOK, ReleaseIssueResponse{Success: false, Error: \"not_owner\"})\n157\t\t\treturn\n158\t\t}\n159\t\n160\t\twriteJSON(w, http.StatusOK, ReleaseIssueResponse{Success: true, Released: boolPtr(true)})\n161\t}\n162\t\n163\t// ReleaseSession 处理释放某会话下所有 Issue 的请求。\n164\t// 接收 POST 请求，将该 session 持有的所有非终态 Issue 恢复为空闲。\n165\tfunc (h *IssueHandler) ReleaseSession(w http.ResponseWriter, r *http.Request) {\n166\t\tif r.Method != http.MethodPost {\n167\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n168\t\t\treturn\n169\t\t}\n170\t\n171\t\tvar req ReleaseSessionRequest\n172\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n173\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n174\t\t\treturn\n175\t\t}\n176\t\n177\t\tif req.SessionID == \"\" {\n178\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"session_id is required\")\n179\t\t\treturn\n180\t\t}\n181\t\n182\t\tlogger.Debug(\"api.issue\", \"POST /api/issue/release-session session=%s\", req.SessionID)\n183\t\n184\t\t// 调用服务层释放该会话下的所有 Issue\n185\t\tnumbers, err := h.svc.ReleaseSession(r.Context(), req.SessionID)\n186\t\tif err != nil {\n187\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to release session issues\")\n188\t\t\treturn\n189\t\t}\n190\t\n191\t\t// 确保返回空数组而非 null\n192\t\tif numbers == nil {\n193\t\t\tnumbers = []int{}\n194\t\t}\n195\t\n196\t\twriteJSON(w, http.StatusOK, ReleaseSessionResponse{Released: numbers, Count: len(numbers)})\n197\t}\n198\t\n199\t// UpdateStatus 处理更新 Issue 状态的请求。\n200\t// 接收 POST 请求，仅允许当前持有者更新 Issue 状态。\n201\tfunc (h *IssueHandler) UpdateStatus(w http.ResponseWriter, r *http.Request) {\n202\t\tif r.Method != http.MethodPost {\n203\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n204\t\t\treturn\n205\t\t}\n206\t\n207\t\tvar req UpdateStatusRequest\n208\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n209\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n210\t\t\treturn\n211\t\t}\n212\t\n213\t\tif req.RepoFullName == \"\" || req.IssueNumber == 0 || req.SessionID == \"\" || req.Status == \"\" {\n214\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"repo_full_name, issue_number, session_id and status are required\")\n215\t\t\treturn\n216\t\t}\n217\t\n218\t\tlogger.Debug(\"api.issue\", \"POST /api/issue/status repo=%s #%d -> %s\", req.RepoFullName, req.IssueNumber, req.Status)\n219\t\n220\t\t// 调用服务层更新状态\n221\t\tresult, err := h.svc.UpdateStatus(r.Context(), req.RepoFullName, req.IssueNumber, req.SessionID, req.Status)\n222\t\tif err != nil {\n223\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to update status\")\n224\t\t\treturn\n225\t\t}\n226\t\n227\t\t// 更新失败（非持有者或不存在）\n228\t\tif !result.Updated {\n229\t\t\tstatus := http.StatusOK\n230\t\t\terrMsg := \"\"\n231\t\t\tif result.PreviousStatus == \"\" {\n232\t\t\t\terrMsg = \"not_found\"\n233\t\t\t} else {\n234\t\t\t\terrMsg = \"not_owner\"\n235\t\t\t}\n236\t\t\twriteJSON(w, status, UpdateStatusResponse{\n237\t\t\t\tSuccess:        false,\n238\t\t\t\tPreviousStatus: result.PreviousStatus,\n239\t\t\t\tError:          errMsg,\n240\t\t\t})\n241\t\t\treturn\n242\t\t}\n243\t\n244\t\t// 更新成功\n245\t\twriteJSON(w, http.StatusOK, UpdateStatusResponse{\n246\t\t\tSuccess:        true,\n247\t\t\tPreviousStatus: result.PreviousStatus,\n248\t\t\tNewStatus:      result.NewStatus,\n249\t\t})\n250\t}\n251\t\n252\t// boolPtr 返回 bool 的指针，用于 JSON 响应中区分零值和未设置。\n253\tfunc boolPtr(b bool) *bool { return &b }\n254\t\n255\t// ListIssues 处理获取 Issue 列表的请求。\n256\t// 接收 GET 请求，支持按仓库、状态、session_id 过滤和分页。\n257\tfunc (h *IssueHandler) ListIssues(w http.ResponseWriter, r *http.Request) {\n258\t\tif r.Method != http.MethodGet {\n259\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n260\t\t\treturn\n261\t\t}\n262\t\n263\t\t// 解析查询参数\n264\t\tvar filter store.IssueFilter\n265\t\tif v := r.URL.Query().Get(\"repo\"); v != \"\" {\n266\t\t\tfilter.RepoFullName = &v\n267\t\t}\n268\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\n269\t\t\tfilter.Status = &v\n270\t\t}\n271\t\tif v := r.URL.Query().Get(\"session_id\"); v != \"\" {\n272\t\t\tfilter.SessionID = &v\n273\t\t}\n274\t\tif v := r.URL.Query().Get(\"page\"); v != \"\" {\n275\t\t\tif n, err := strconv.Atoi(v); err == nil && n > 0 {\n276\t\t\t\tfilter.Page = n\n277\t\t\t}\n278\t\t}\n279\t\tif v := r.URL.Query().Get(\"page_size\"); v != \"\" {\n280\t\t\tif n, err := strconv.Atoi(v); err == nil && n > 0 {\n281\t\t\t\tfilter.PageSize = n\n282\t\t\t}\n283\t\t}\n284\t\n285\t\tlogger.Debug(\"api.issue\", \"GET /api/issues filter=%+v\", filter)\n286\t\n287\t\titems, total, err := h.svc.List(r.Context(), filter)\n288\t\tif err != nil {\n289\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list issues\")\n290\t\t\treturn\n291\t\t}\n292\t\n293\t\t// 确保返回空数组而非 null\n294\t\tif items == nil {\n295\t\t\titems = []store.IssueListItem{}\n296\t\t}\n297\t\n298\t\t// 分页参数\n299\t\tpage := filter.Page\n300\t\tif page < 1 {\n301\t\t\tpage = 1\n302\t\t}\n303\t\tpageSize := filter.PageSize\n304\t\tif pageSize < 1 {\n305\t\t\tpageSize = 20\n306\t\t}\n307\t\ttotalPages := int(math.Ceil(float64(total) / float64(pageSize)))\n308\t\n309\t\t// 转换为响应格式\n310\t\trespItems := make([]IssueListItem, len(items))\n311\t\tfor i, item := range items {\n312\t\t\trespItems[i] = IssueListItem{\n313\t\t\t\tID:           item.ID,\n314\t\t\t\tRepoFullName: item.RepoFullName,\n315\t\t\t\tIssueNumber:  item.IssueNumber,\n316\t\t\t\tIssueTitle:   item.IssueTitle,\n317\t\t\t\tStatus:       item.Status,\n318\t\t\t\tSessionID:    item.SessionID,\n319\t\t\t\tClaimedAt:    item.ClaimedAt,\n320\t\t\t\tUpdatedAt:    item.UpdatedAt,\n321\t\t\t}\n322\t\t}\n323\t\n324\t\twriteJSON(w, http.StatusOK, IssuesListResponse{\n325\t\t\tIssues:     respItems,\n326\t\t\tTotal:      total,\n327\t\t\tPage:       page,\n328\t\t\tPageSize:   pageSize,\n329\t\t\tTotalPages: totalPages,\n330\t\t})\n331\t}\n332\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/machine_handler.go"},"tool_use_id":"call_f0692f76b5ce49979a106296","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"net/http\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t)\n11\t\n12\t// MachineHandler 处理 Machine 相关的 HTTP 请求。\n13\ttype MachineHandler struct {\n14\t\tsvc *service.MachineService\n15\t}\n16\t\n17\t// NewMachineHandler 创建新的 MachineHandler 实例。\n18\tfunc NewMachineHandler(svc *service.MachineService) *MachineHandler {\n19\t\treturn &MachineHandler{svc: svc}\n20\t}\n21\t\n22\t// List 处理获取机器列表的请求。\n23\t// 接收 GET 请求，支持按操作系统和主机名过滤。\n24\tfunc (h *MachineHandler) List(w http.ResponseWriter, r *http.Request) {\n25\t\tif r.Method != http.MethodGet {\n26\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n27\t\t\treturn\n28\t\t}\n29\t\n30\t\tvar filter store.MachineFilter\n31\t\tif v := r.URL.Query().Get(\"os\"); v != \"\" {\n32\t\t\tfilter.OS = &v\n33\t\t}\n34\t\tif v := r.URL.Query().Get(\"hostname\"); v != \"\" {\n35\t\t\tfilter.Hostname = &v\n36\t\t}\n37\t\n38\t\tlogger.Debug(\"api.machine\", \"GET /api/machines\")\n39\t\n40\t\tmachines, err := h.svc.List(r.Context(), filter)\n41\t\tif err != nil {\n42\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list machines\")\n43\t\t\treturn\n44\t\t}\n45\t\n46\t\t// 确保返回空数组而非 null\n47\t\tif machines == nil {\n48\t\t\tmachines = []store.Machine{}\n49\t\t}\n50\t\n51\t\titems := make([]MachineListItem, len(machines))\n52\t\tfor i, m := range machines {\n53\t\t\titems[i] = MachineListItem{\n54\t\t\t\tID:          m.ID,\n55\t\t\t\tMachineID:   m.MachineID,\n56\t\t\t\tOS:          m.OS,\n57\t\t\t\tHostname:    m.Hostname,\n58\t\t\t\tUsername:    m.Username,\n59\t\t\t\tFirstSeenAt: m.FirstSeenAt,\n60\t\t\t\tLastSeenAt:  m.LastSeenAt,\n61\t\t\t}\n62\t\t}\n63\t\n64\t\twriteJSON(w, http.StatusOK, MachinesListResponse{Machines: items})\n65\t}\n66\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/project_handler.go"},"tool_use_id":"call_1cdb655b8a864f85bf9bd569","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"net/http\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t)\n11\t\n12\t// ProjectHandler 处理 Project 相关的 HTTP 请求。\n13\ttype ProjectHandler struct {\n14\t\tsvc *service.ProjectService\n15\t}\n16\t\n17\t// NewProjectHandler 创建新的 ProjectHandler 实例。\n18\tfunc NewProjectHandler(svc *service.ProjectService) *ProjectHandler {\n19\t\treturn &ProjectHandler{svc: svc}\n20\t}\n21\t\n22\t// List 处理获取项目列表的请求。\n23\t// 接收 GET 请求，返回所有项目信息。\n24\tfunc (h *ProjectHandler) List(w http.ResponseWriter, r *http.Request) {\n25\t\tif r.Method != http.MethodGet {\n26\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n27\t\t\treturn\n28\t\t}\n29\t\n30\t\tlogger.Debug(\"api.project\", \"GET /api/projects\")\n31\t\n32\t\tprojects, err := h.svc.List(r.Context())\n33\t\tif err != nil {\n34\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list projects\")\n35\t\t\treturn\n36\t\t}\n37\t\n38\t\t// 确保返回空数组而非 null\n39\t\tif projects == nil {\n40\t\t\tprojects = []store.Project{}\n41\t\t}\n42\t\n43\t\titems := make([]ProjectListItem, len(projects))\n44\t\tfor i, p := range projects {\n45\t\t\titems[i] = ProjectListItem{\n46\t\t\t\tID:          p.ID,\n47\t\t\t\tProjectSlug: p.ProjectSlug,\n48\t\t\t\tProjectCwd:  p.ProjectCwd,\n49\t\t\t\tFirstSeenAt: p.FirstSeenAt,\n50\t\t\t\tLastSeenAt:  p.LastSeenAt,\n51\t\t\t}\n52\t\t}\n53\t\n54\t\twriteJSON(w, http.StatusOK, ProjectsListResponse{Projects: items})\n55\t}\n56\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/session_handler.go"},"tool_use_id":"call_9fa9aa4a107b4cd1b145d512","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"encoding/json\"\n6\t\t\"net/http\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n11\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n12\t)\n13\t\n14\t// SessionHandler 处理 Session 相关的 HTTP 请求。\n15\ttype SessionHandler struct {\n16\t\tsvc      *service.SessionService // Session 业务逻辑服务\n17\t\tissueSvc *service.IssueService   // Issue 业务逻辑服务（用于获取会话关联 Issue）\n18\t\ttokenSvc *service.TokenService   // Token 统计服务\n19\t\ttraceSvc *service.TraceService   // Trace 文件服务\n20\t}\n21\t\n22\t// NewSessionHandler 创建新的 SessionHandler 实例。\n23\tfunc NewSessionHandler(svc *service.SessionService, issueSvc *service.IssueService, tokenSvc *service.TokenService, traceSvc *service.TraceService) *SessionHandler {\n24\t\treturn &SessionHandler{svc: svc, issueSvc: issueSvc, tokenSvc: tokenSvc, traceSvc: traceSvc}\n25\t}\n26\t\n27\t// Register 处理注册新会话的请求。\n28\t// 接收 POST 请求，将新的会话信息保存到数据库。\n29\tfunc (h *SessionHandler) Register(w http.ResponseWriter, r *http.Request) {\n30\t\tif r.Method != http.MethodPost {\n31\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n32\t\t\treturn\n33\t\t}\n34\t\n35\t\tvar req RegisterSessionRequest\n36\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n37\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n38\t\t\treturn\n39\t\t}\n40\t\n41\t\t// 校验必填字段\n42\t\tif req.SessionID == \"\" || req.MachineID == \"\" || req.ProjectSlug == \"\" || req.TranscriptPath == \"\" {\n43\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\",\n44\t\t\t\t\"session_id, machine_id, project_slug and transcript_path are required\")\n45\t\t\treturn\n46\t\t}\n47\t\n48\t\tlogger.Debug(\"api.session\", \"POST /api/session/register id=%s\", req.SessionID)\n49\t\n50\t\t// 构造 Session 存储对象\n51\t\tsess := store.Session{\n52\t\t\tSessionID:      req.SessionID,\n53\t\t\tMachineID:      req.MachineID,\n54\t\t\tOS:             req.OS,\n55\t\t\tProjectSlug:    req.ProjectSlug,\n56\t\t\tProjectCwd:     req.ProjectCwd,\n57\t\t\tTranscriptPath: req.TranscriptPath,\n58\t\t\tLocalTracePath: req.LocalTracePath,\n59\t\t\tModel:          req.Model,\n60\t\t\tSource:         req.Source,\n61\t\t}\n62\t\n63\t\t// 调用服务层注册会话\n64\t\tif err := h.svc.Register(r.Context(), sess); err != nil {\n65\t\t\tif err == store.ErrSessionExists {\n66\t\t\t\tlogger.Warn(\"api.session\", \"session already exists: %s\", req.SessionID)\n67\t\t\t\twriteError(w, http.StatusConflict, \"session_exists\", \"session already registered\")\n68\t\t\t\treturn\n69\t\t\t}\n70\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to register session\")\n71\t\t\treturn\n72\t\t}\n73\t\n74\t\tlogger.Info(\"api.session\", \"session registered: %s slug=%s\", req.SessionID, req.ProjectSlug)\n75\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"registered\"})\n76\t}\n77\t\n78\t// Close 处理关闭会话的请求。\n79\t// 接收 POST 请求，将会话状态标记为已关闭。\n80\tfunc (h *SessionHandler) Close(w http.ResponseWriter, r *http.Request) {\n81\t\tif r.Method != http.MethodPost {\n82\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use POST\")\n83\t\t\treturn\n84\t\t}\n85\t\n86\t\tvar req CloseSessionRequest\n87\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n88\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid JSON body\")\n89\t\t\treturn\n90\t\t}\n91\t\n92\t\tif req.SessionID == \"\" {\n93\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"session_id is required\")\n94\t\t\treturn\n95\t\t}\n96\t\n97\t\tlogger.Debug(\"api.session\", \"POST /api/session/close id=%s\", req.SessionID)\n98\t\n99\t\t// 调用服务层关闭会话\n100\t\tif err := h.svc.Close(r.Context(), req.SessionID, req.Reason); err != nil {\n101\t\t\tif err == store.ErrSessionNotFound {\n102\t\t\t\twriteError(w, http.StatusNotFound, \"not_found\", \"session not found or already closed\")\n103\t\t\t\treturn\n104\t\t\t}\n105\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to close session\")\n106\t\t\treturn\n107\t\t}\n108\t\n109\t\tlogger.Info(\"api.session\", \"session closed: %s reason=%s\", req.SessionID, req.Reason)\n110\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"closed\"})\n111\t}\n112\t\n113\t// List 处理获取会话列表的请求。\n114\t// 接收 GET 请求，支持按 machine_id、project_slug、status 过滤。\n115\tfunc (h *SessionHandler) List(w http.ResponseWriter, r *http.Request) {\n116\t\tif r.Method != http.MethodGet {\n117\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n118\t\t\treturn\n119\t\t}\n120\t\n121\t\tlogger.Debug(\"api.session\", \"GET /api/sessions\")\n122\t\n123\t\t// 解析查询参数构建过滤条件\n124\t\tvar filter store.SessionFilter\n125\t\tif v := r.URL.Query().Get(\"machine_id\"); v != \"\" {\n126\t\t\tfilter.MachineID = &v\n127\t\t}\n128\t\tif v := r.URL.Query().Get(\"project_slug\"); v != \"\" {\n129\t\t\tfilter.ProjectSlug = &v\n130\t\t}\n131\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\n132\t\t\tfilter.Status = &v\n133\t\t}\n134\t\n135\t\t// 调用服务层查询会话列表\n136\t\tsessions, err := h.svc.List(r.Context(), filter)\n137\t\tif err != nil {\n138\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list sessions\")\n139\t\t\treturn\n140\t\t}\n141\t\n142\t\t// 确保返回空数组而非 null\n143\t\tif sessions == nil {\n144\t\t\tsessions = []store.Session{}\n145\t\t}\n146\t\n147\t\t// 转换为响应格式\n148\t\titems := make([]SessionListItem, len(sessions))\n149\t\tfor i, s := range sessions {\n150\t\t\titems[i] = toSessionListItem(s)\n151\t\t}\n152\t\n153\t\twriteJSON(w, http.StatusOK, SessionListResponse{Sessions: items})\n154\t}\n155\t\n156\t// Get 处理获取单个会话详情的请求。\n157\t// 接收 GET 请求，从 URL 路径中解析 session_id。\n158\tfunc (h *SessionHandler) Get(w http.ResponseWriter, r *http.Request) {\n159\t\tif r.Method != http.MethodGet {\n160\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n161\t\t\treturn\n162\t\t}\n163\t\n164\t\t// 从 URL 路径中提取 session_id\n165\t\tsessionID := r.URL.Path[len(\"/api/session/\"):]\n166\t\tif sessionID == \"\" {\n167\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"session_id is required\")\n168\t\t\treturn\n169\t\t}\n170\t\n171\t\tlogger.Debug(\"api.session\", \"GET /api/session/%s\", sessionID)\n172\t\n173\t\t// 调用服务层查询会话详情\n174\t\tsess, err := h.svc.Get(r.Context(), sessionID)\n175\t\tif err != nil {\n176\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get session\")\n177\t\t\treturn\n178\t\t}\n179\t\tif sess == nil {\n180\t\t\twriteError(w, http.StatusNotFound, \"not_found\", \"session not found\")\n181\t\t\treturn\n182\t\t}\n183\t\n184\t\twriteJSON(w, http.StatusOK, toSessionDetail(*sess))\n185\t}\n186\t\n187\t// toSessionListItem 将 store.Session 转换为会话列表展示用的 SessionListItem。\n188\tfunc toSessionListItem(s store.Session) SessionListItem {\n189\t\titem := SessionListItem{\n190\t\t\tSessionID:    s.SessionID,\n191\t\t\tMachineID:    s.MachineID,\n192\t\t\tProjectSlug:  s.ProjectSlug,\n193\t\t\tStatus:       s.Status,\n194\t\t\tRegisteredAt: s.RegisteredAt,\n195\t\t}\n196\t\tif s.ClosedAt != nil {\n197\t\t\titem.ClosedAt = s.ClosedAt\n198\t\t}\n199\t\treturn item\n200\t}\n201\t\n202\t// toSessionDetail 将 store.Session 转换为会话详情展示用的 SessionDetail。\n203\tfunc toSessionDetail(s store.Session) SessionDetail {\n204\t\td := SessionDetail{\n205\t\t\tSessionID:      s.SessionID,\n206\t\t\tMachineID:      s.MachineID,\n207\t\t\tOS:             s.OS,\n208\t\t\tProjectSlug:    s.ProjectSlug,\n209\t\t\tProjectCwd:     s.ProjectCwd,\n210\t\t\tTranscriptPath: s.TranscriptPath,\n211\t\t\tLocalTracePath: s.LocalTracePath,\n212\t\t\tModel:          s.Model,\n213\t\t\tSource:         s.Source,\n214\t\t\tStatus:         s.Status,\n215\t\t\tRegisteredAt:   s.RegisteredAt,\n216\t\t}\n217\t\tif s.ClosedAt != nil {\n218\t\t\td.ClosedAt = s.ClosedAt\n219\t\t}\n220\t\tif s.CloseReason != \"\" {\n221\t\t\td.CloseReason = s.CloseReason\n222\t\t}\n223\t\treturn d\n224\t}\n225\t\n226\t// GetIssues 处理获取会话关联 Issue 的请求。\n227\t// 接收 GET 请求，路径格式: /api/session/{id}/issues\n228\tfunc (h *SessionHandler) GetIssues(w http.ResponseWriter, r *http.Request) {\n229\t\tif r.Method != http.MethodGet {\n230\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n231\t\t\treturn\n232\t\t}\n233\t\n234\t\t// 从 URL 路径中提取 session_id\n235\t\t// 路径格式: /api/session/{id}/issues\n236\t\tpath := r.URL.Path\n237\t\tprefix := \"/api/session/\"\n238\t\tsuffix := \"/issues\"\n239\t\tif !strings.HasPrefix(path, prefix) || !strings.HasSuffix(path, suffix) {\n240\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid path\")\n241\t\t\treturn\n242\t\t}\n243\t\tsessionID := path[len(prefix) : len(path)-len(suffix)]\n244\t\tif sessionID == \"\" {\n245\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"session_id is required\")\n246\t\t\treturn\n247\t\t}\n248\t\n249\t\tlogger.Debug(\"api.session\", \"GET /api/session/%s/issues\", sessionID)\n250\t\n251\t\t// 先检查会话是否存在\n252\t\tsess, err := h.svc.Get(r.Context(), sessionID)\n253\t\tif err != nil {\n254\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get session\")\n255\t\t\treturn\n256\t\t}\n257\t\tif sess == nil {\n258\t\t\twriteError(w, http.StatusNotFound, \"not_found\", \"session not found\")\n259\t\t\treturn\n260\t\t}\n261\t\n262\t\t// 获取该会话的 Issue 列表\n263\t\titems, err := h.issueSvc.ListBySession(r.Context(), sessionID)\n264\t\tif err != nil {\n265\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list issues\")\n266\t\t\treturn\n267\t\t}\n268\t\n269\t\t// 确保返回空数组而非 null\n270\t\tif items == nil {\n271\t\t\titems = []store.IssueListItem{}\n272\t\t}\n273\t\n274\t\t// 转换为响应格式\n275\t\trespItems := make([]IssueListItem, len(items))\n276\t\tfor i, item := range items {\n277\t\t\trespItems[i] = IssueListItem{\n278\t\t\t\tID:           item.ID,\n279\t\t\t\tRepoFullName: item.RepoFullName,\n280\t\t\t\tIssueNumber:  item.IssueNumber,\n281\t\t\t\tIssueTitle:   item.IssueTitle,\n282\t\t\t\tStatus:       item.Status,\n283\t\t\t\tSessionID:    item.SessionID,\n284\t\t\t\tClaimedAt:    item.ClaimedAt,\n285\t\t\t\tUpdatedAt:    item.UpdatedAt,\n286\t\t\t}\n287\t\t}\n288\t\n289\t\twriteJSON(w, http.StatusOK, SessionIssuesResponse{Issues: respItems})\n290\t}\n291\t\n292\t// GetTokens 处理获取会话 Token 统计的请求。\n293\t// 接收 GET 请求，路径格式: /api/session/{id}/tokens\n294\tfunc (h *SessionHandler) GetTokens(w http.ResponseWriter, r *http.Request) {\n295\t\tif r.Method != http.MethodGet {\n296\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n297\t\t\treturn\n298\t\t}\n299\t\n300\t\t// 从 URL 路径中提取 session_id\n301\t\tpath := r.URL.Path\n302\t\tprefix := \"/api/session/\"\n303\t\tsuffix := \"/tokens\"\n304\t\tif !strings.HasPrefix(path, prefix) || !strings.HasSuffix(path, suffix) {\n305\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid path\")\n306\t\t\treturn\n307\t\t}\n308\t\tsessionID := path[len(prefix) : len(path)-len(suffix)]\n309\t\tif sessionID == \"\" {\n310\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"session_id is required\")\n311\t\t\treturn\n312\t\t}\n313\t\n314\t\tlogger.Debug(\"api.session\", \"GET /api/session/%s/tokens\", sessionID)\n315\t\n316\t\t// 检查会话是否存在\n317\t\tsess, err := h.svc.Get(r.Context(), sessionID)\n318\t\tif err != nil {\n319\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get session\")\n320\t\t\treturn\n321\t\t}\n322\t\tif sess == nil {\n323\t\t\twriteError(w, http.StatusNotFound, \"not_found\", \"session not found\")\n324\t\t\treturn\n325\t\t}\n326\t\n327\t\t// 获取 Token 统计\n328\t\tstats, err := h.tokenSvc.GetSessionTokens(r.Context(), sessionID)\n329\t\tif err != nil {\n330\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get tokens\")\n331\t\t\treturn\n332\t\t}\n333\t\n334\t\twriteJSON(w, http.StatusOK, SessionTokensResponse{\n335\t\t\tSessionID:    sessionID,\n336\t\t\tAPICalls:     stats.APICalls,\n337\t\t\tInputTokens:  stats.InputTokens,\n338\t\t\tOutputTokens: stats.OutputTokens,\n339\t\t\tCacheRead:    stats.CacheRead,\n340\t\t\tCacheCreate:  stats.CacheCreate,\n341\t\t\tTotalTokens:  stats.Total(),\n342\t\t})\n343\t}\n344\t\n345\t// GetTraces 处理获取会话 Trace 文件列表的请求。\n346\t// 接收 GET 请求，路径格式: /api/session/{id}/traces\n347\tfunc (h *SessionHandler) GetTraces(w http.ResponseWriter, r *http.Request) {\n348\t\tif r.Method != http.MethodGet {\n349\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n350\t\t\treturn\n351\t\t}\n352\t\n353\t\t// 从 URL 路径中提取 session_id\n354\t\tpath := r.URL.Path\n355\t\tprefix := \"/api/session/\"\n356\t\tsuffix := \"/traces\"\n357\t\tif !strings.HasPrefix(path, prefix) || !strings.HasSuffix(path, suffix) {\n358\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"invalid path\")\n359\t\t\treturn\n360\t\t}\n361\t\tsessionID := path[len(prefix) : len(path)-len(suffix)]\n362\t\tif sessionID == \"\" {\n363\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"session_id is required\")\n364\t\t\treturn\n365\t\t}\n366\t\n367\t\tlogger.Debug(\"api.session\", \"GET /api/session/%s/traces\", sessionID)\n368\t\n369\t\t// 检查会话是否存在\n370\t\tsess, err := h.svc.Get(r.Context(), sessionID)\n371\t\tif err != nil {\n372\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get session\")\n373\t\t\treturn\n374\t\t}\n375\t\tif sess == nil {\n376\t\t\twriteError(w, http.StatusNotFound, \"not_found\", \"session not found\")\n377\t\t\treturn\n378\t\t}\n379\t\n380\t\t// 获取 Trace 文件列表\n381\t\ttraces, err := h.traceSvc.GetSessionTraces(r.Context(), sessionID)\n382\t\tif err != nil {\n383\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get traces\")\n384\t\t\treturn\n385\t\t}\n386\t\n387\t\titems := make([]TraceItem, len(traces))\n388\t\tfor i, t := range traces {\n389\t\t\titems[i] = TraceItem{\n390\t\t\t\tPath:      t.Path,\n391\t\t\t\tSizeBytes: t.SizeBytes,\n392\t\t\t\tLineCount: t.LineCount,\n393\t\t\t\tDate:      t.Date,\n394\t\t\t\tFilename:  t.Filename,\n395\t\t\t}\n396\t\t}\n397\t\n398\t\twriteJSON(w, http.StatusOK, SessionTracesResponse{\n399\t\t\tSessionID: sessionID,\n400\t\t\tTraces:    items,\n401\t\t})\n402\t}\n403\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/log_handler.go"},"tool_use_id":"call_54cd70634e0742c3a8eadf13","tool_response":"1\tpackage api\n2\t\n3\timport (\n4\t\t\"net/http\"\n5\t\t\"strconv\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n9\t)\n10\t\n11\t// LogHandler 处理日志查询的 HTTP 请求。\n12\ttype LogHandler struct {\n13\t\tsvc *service.LogService // 日志查询服务\n14\t}\n15\t\n16\t// NewLogHandler 创建新的 LogHandler 实例。\n17\tfunc NewLogHandler(svc *service.LogService) *LogHandler {\n18\t\treturn &LogHandler{svc: svc}\n19\t}\n20\t\n21\t// Query 处理 GET /api/logs 请求，查询后端服务日志。\n22\t// 支持查询参数：level（级别过滤）、date（日期选择）、limit（限制条数）。\n23\tfunc (h *LogHandler) Query(w http.ResponseWriter, r *http.Request) {\n24\t\tif r.Method != http.MethodGet {\n25\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n26\t\t\treturn\n27\t\t}\n28\t\n29\t\tlevel := r.URL.Query().Get(\"level\")\n30\t\tdate := r.URL.Query().Get(\"date\")\n31\t\tlimitStr := r.URL.Query().Get(\"limit\")\n32\t\n33\t\tlimit := 100\n34\t\tif limitStr != \"\" {\n35\t\t\tif v, err := strconv.Atoi(limitStr); err == nil && v > 0 {\n36\t\t\t\tlimit = v\n37\t\t\t}\n38\t\t}\n39\t\n40\t\tlogger.Debug(\"api.log\", \"GET /api/logs level=%s date=%s limit=%d\", level, date, limit)\n41\t\n42\t\tentries, err := h.svc.QueryLogs(r.Context(), level, date, limit)\n43\t\tif err != nil {\n44\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to query logs\")\n45\t\t\treturn\n46\t\t}\n47\t\n48\t\titems := make([]LogItem, len(entries))\n49\t\tfor i, e := range entries {\n50\t\t\titems[i] = LogItem{\n51\t\t\t\tTimestamp: e.Timestamp,\n52\t\t\t\tLevel:     e.Level,\n53\t\t\t\tSource:    e.Source,\n54\t\t\t\tMessage:   e.Message,\n55\t\t\t}\n56\t\t}\n57\t\n58\t\t// 确保返回空数组而非 null\n59\t\tif items == nil {\n60\t\t\titems = []LogItem{}\n61\t\t}\n62\t\n63\t\twriteJSON(w, http.StatusOK, LogsResponse{Logs: items})\n64\t}\n65\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/config_handler.go"},"tool_use_id":"call_16f2ef0de364497eb97ec18d","tool_response":"1\tpackage api\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"net/http\"\n6\t\t\"strings\"\n7\t\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t)\n11\t\n12\t// ConfigHandler 处理系统配置管理的 HTTP 请求。\n13\ttype ConfigHandler struct {\n14\t\tsvc *service.ConfigService\n15\t}\n16\t\n17\t// NewConfigHandler 创建新的 ConfigHandler 实例。\n18\tfunc NewConfigHandler(svc *service.ConfigService) *ConfigHandler {\n19\t\treturn &ConfigHandler{svc: svc}\n20\t}\n21\t\n22\t// ServeHTTP 处理 /api/config 的 GET 和 PUT 请求。\n23\tfunc (h *ConfigHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n24\t\tswitch r.Method {\n25\t\tcase http.MethodGet:\n26\t\t\th.get(w, r)\n27\t\tcase http.MethodPut:\n28\t\t\th.update(w, r)\n29\t\tdefault:\n30\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET or PUT\")\n31\t\t}\n32\t}\n33\t\n34\t// get 处理 GET /api/config，返回当前所有配置项。\n35\tfunc (h *ConfigHandler) get(w http.ResponseWriter, r *http.Request) {\n36\t\tlogger.Debug(\"api.config\", \"GET /api/config\")\n37\t\n38\t\tconfig, err := h.svc.Get(r.Context())\n39\t\tif err != nil {\n40\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get config\")\n41\t\t\treturn\n42\t\t}\n43\t\n44\t\twriteJSON(w, http.StatusOK, ConfigResponse{Config: config})\n45\t}\n46\t\n47\t// update 处理 PUT /api/config，更新指定的配置项。\n48\tfunc (h *ConfigHandler) update(w http.ResponseWriter, r *http.Request) {\n49\t\t// 解析为通用 map 以支持部分更新\n50\t\tvar raw map[string]interface{}\n51\t\tif err := json.NewDecoder(r.Body).Decode(&raw); err != nil {\n52\t\t\twriteError(w, http.StatusBadRequest, \"invalid_json\", err.Error())\n53\t\t\treturn\n54\t\t}\n55\t\n56\t\tlogger.Debug(\"api.config\", \"PUT /api/config: %v\", raw)\n57\t\n58\t\tif len(raw) == 0 {\n59\t\t\twriteError(w, http.StatusBadRequest, \"no_updates\", \"no valid fields to update\")\n60\t\t\treturn\n61\t\t}\n62\t\n63\t\tif err := h.svc.Update(r.Context(), raw); err != nil {\n64\t\t\t// 根据错误类型返回不同错误码\n65\t\t\terrMsg := err.Error()\n66\t\t\tcode := \"internal_error\"\n67\t\t\tstatus := http.StatusInternalServerError\n68\t\t\tif strings.Contains(errMsg, \"unknown config key\") {\n69\t\t\t\tcode = \"unknown_config_key\"\n70\t\t\t\tstatus = http.StatusBadRequest\n71\t\t\t} else if strings.Contains(errMsg, \"invalid\") {\n72\t\t\t\tcode = \"invalid_config\"\n73\t\t\t\tstatus = http.StatusBadRequest\n74\t\t\t}\n75\t\t\twriteError(w, status, code, errMsg)\n76\t\t\treturn\n77\t\t}\n78\t\n79\t\t// 返回更新后的完整配置\n80\t\tconfig, err := h.svc.Get(r.Context())\n81\t\tif err != nil {\n82\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get updated config\")\n83\t\t\treturn\n84\t\t}\n85\t\n86\t\twriteJSON(w, http.StatusOK, ConfigResponse{Config: config})\n87\t}\n88\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/status_handler.go"},"tool_use_id":"call_4177fa299e4d42c3a966a599","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"net/http\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n9\t)\n10\t\n11\t// StatusHandler 处理系统状态查询。\n12\ttype StatusHandler struct {\n13\t\tsvc *service.StatusService\n14\t}\n15\t\n16\t// NewStatusHandler 创建 StatusHandler 实例。\n17\tfunc NewStatusHandler(svc *service.StatusService) *StatusHandler {\n18\t\treturn &StatusHandler{svc: svc}\n19\t}\n20\t\n21\t// Get 处理获取系统状态的请求。\n22\t// GET /api/status\n23\tfunc (h *StatusHandler) Get(w http.ResponseWriter, r *http.Request) {\n24\t\tif r.Method != http.MethodGet {\n25\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n26\t\t\treturn\n27\t\t}\n28\t\n29\t\tlogger.Debug(\"api.status\", \"GET /api/status\")\n30\t\n31\t\tstatus, err := h.svc.Get(r.Context())\n32\t\tif err != nil {\n33\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to get status\")\n34\t\t\treturn\n35\t\t}\n36\t\n37\t\twriteJSON(w, http.StatusOK, StatusResponse{\n38\t\t\tStatus:        status.Status,\n39\t\t\tVersion:       status.Version,\n40\t\t\tUptimeSeconds: status.UptimeSeconds,\n41\t\t\tStats: SystemStats{\n42\t\t\t\tActiveSessions: status.Stats.ActiveSessions,\n43\t\t\t\tActiveProxies:  status.Stats.ActiveProxies,\n44\t\t\t\tPendingIssues:  status.Stats.PendingIssues,\n45\t\t\t\tTotalMachines:  status.Stats.TotalMachines,\n46\t\t\t\tTotalProjects:  status.Stats.TotalProjects,\n47\t\t\t},\n48\t\t\tTimestamp: status.Timestamp,\n49\t\t})\n50\t}\n51\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/proxy_handler.go"},"tool_use_id":"call_5c281e573d8a421ba65d61d2","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"encoding/json\"\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"net/http\"\n10\t\t\"sync\"\n11\t\n12\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n15\t)\n16\t\n17\t// ProxyHandler 处理代理注册、trace-init 转发和代理列表查询。\n18\ttype ProxyHandler struct {\n19\t\tmu            sync.RWMutex\n20\t\tproxies       map[string]string   // pid -> proxy_url，注册的代理列表（内存）\n21\t\tsessions      map[string]string   // session_id -> proxy_url，会话到代理的精确路由映射\n22\t\tproxySessions map[string][]string // pid -> []session_id，代理注销时清理映射\n23\t\tsvc           *service.ProxyService // 代理列表服务（数据库）\n24\t}\n25\t\n26\t// NewProxyHandler 创建代理处理器（无数据库依赖，仅内存功能）。\n27\tfunc NewProxyHandler() *ProxyHandler {\n28\t\treturn &ProxyHandler{\n29\t\t\tproxies:       make(map[string]string),\n30\t\t\tsessions:      make(map[string]string),\n31\t\t\tproxySessions: make(map[string][]string),\n32\t\t}\n33\t}\n34\t\n35\t// NewProxyHandlerWithService 创建带数据库服务的代理处理器。\n36\tfunc NewProxyHandlerWithService(svc *service.ProxyService) *ProxyHandler {\n37\t\treturn &ProxyHandler{\n38\t\t\tproxies:       make(map[string]string),\n39\t\t\tsessions:      make(map[string]string),\n40\t\t\tproxySessions: make(map[string][]string),\n41\t\t\tsvc:           svc,\n42\t\t}\n43\t}\n44\t\n45\t// bindSession 将会话绑定到代理 URL（内部调用需持有写锁）。\n46\tfunc (h *ProxyHandler) bindSession(pid, sessionID, proxyURL string) {\n47\t\t// 解绑该 session_id 之前可能绑定的代理\n48\t\tif oldURL, ok := h.sessions[sessionID]; ok && oldURL != proxyURL {\n49\t\t\tlogger.Debug(\"api.proxy\", \"rebind session %s: %s -> %s\", sessionID, oldURL, proxyURL)\n50\t\t}\n51\t\th.sessions[sessionID] = proxyURL\n52\t\t// 记录到 proxy 索引，用于注销时清理\n53\t\tfound := false\n54\t\tfor _, sid := range h.proxySessions[pid] {\n55\t\t\tif sid == sessionID {\n56\t\t\t\tfound = true\n57\t\t\t\tbreak\n58\t\t\t}\n59\t\t}\n60\t\tif !found {\n61\t\t\th.proxySessions[pid] = append(h.proxySessions[pid], sessionID)\n62\t\t}\n63\t}\n64\t\n65\t// unbindProxySessions 清理指定 pid 下的所有 session 绑定（内部调用需持有写锁）。\n66\tfunc (h *ProxyHandler) unbindProxySessions(pid string) {\n67\t\tfor _, sessionID := range h.proxySessions[pid] {\n68\t\t\tif h.sessions[sessionID] == h.proxies[pid] {\n69\t\t\t\tdelete(h.sessions, sessionID)\n70\t\t\t\tlogger.Debug(\"api.proxy\", \"unbind session %s on proxy %s unregister\", sessionID, pid)\n71\t\t\t}\n72\t\t}\n73\t\tdelete(h.proxySessions, pid)\n74\t}\n75\t\n76\t// Register 处理代理注册请求。\n77\t// POST /api/proxy/register\n78\t// Body: {\"pid\": \"28364\", \"proxy_url\": \"http://127.0.0.1:64902\"}\n79\tfunc (h *ProxyHandler) Register(w http.ResponseWriter, r *http.Request) {\n80\t\tif r.Method != http.MethodPost {\n81\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n82\t\t\treturn\n83\t\t}\n84\t\n85\t\tvar req struct {\n86\t\t\tPID      string `json:\"pid\"`\n87\t\t\tProxyURL string `json:\"proxy_url\"`\n88\t\t}\n89\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n90\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n91\t\t\treturn\n92\t\t}\n93\t\n94\t\tif req.PID == \"\" || req.ProxyURL == \"\" {\n95\t\t\thttp.Error(w, \"pid and proxy_url required\", http.StatusBadRequest)\n96\t\t\treturn\n97\t\t}\n98\t\n99\t\th.mu.Lock()\n100\t\th.proxies[req.PID] = req.ProxyURL\n101\t\th.mu.Unlock()\n102\t\n103\t\tlogger.Info(\"api.proxy\", \"registered: pid=%s url=%s\", req.PID, req.ProxyURL)\n104\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n105\t}\n106\t\n107\t// Unregister 处理代理注销请求。\n108\t// POST /api/proxy/unregister\n109\t// Body: {\"pid\": \"28364\"}\n110\tfunc (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request) {\n111\t\tif r.Method != http.MethodPost {\n112\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n113\t\t\treturn\n114\t\t}\n115\t\n116\t\tvar req struct {\n117\t\t\tPID string `json:\"pid\"`\n118\t\t}\n119\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n120\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n121\t\t\treturn\n122\t\t}\n123\t\n124\t\th.mu.Lock()\n125\t\th.unbindProxySessions(req.PID)\n126\t\tdelete(h.proxies, req.PID)\n127\t\th.mu.Unlock()\n128\t\n129\t\tlogger.Info(\"api.proxy\", \"unregistered: pid=%s\", req.PID)\n130\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n131\t}\n132\t\n133\t// TraceInit 转发 trace-init 请求到指定代理。\n134\t// POST /api/proxy/trace-init\n135\t// 优先根据 session_id 查询已绑定的代理进行精确转发；未绑定时广播探测并记录映射。\n136\tfunc (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request) {\n137\t\tif r.Method != http.MethodPost {\n138\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n139\t\t\treturn\n140\t\t}\n141\t\n142\t\t// 读取请求体\n143\t\tbody, err := io.ReadAll(r.Body)\n144\t\tif err != nil {\n145\t\t\thttp.Error(w, \"read body failed\", http.StatusBadRequest)\n146\t\t\treturn\n147\t\t}\n148\t\n149\t\t// 解析 session_id 用于精确路由\n150\t\tvar tiReq TraceInitRequest\n151\t\tif err := json.Unmarshal(body, &tiReq); err != nil {\n152\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n153\t\t\treturn\n154\t\t}\n155\t\tif tiReq.SessionID == \"\" {\n156\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n157\t\t\treturn\n158\t\t}\n159\t\n160\t\t// 精确路由：该 session 是否已绑定到某个代理\n161\t\th.mu.RLock()\n162\t\tboundURL, bound := h.sessions[tiReq.SessionID]\n163\t\tproxiesCopy := make(map[string]string, len(h.proxies))\n164\t\tfor pid, url := range h.proxies {\n165\t\t\tproxiesCopy[pid] = url\n166\t\t}\n167\t\th.mu.RUnlock()\n168\t\n169\t\tif bound {\n170\t\t\tlogger.Debug(\"api.proxy\", \"trace-init: direct route session=%s to %s\", tiReq.SessionID, boundURL)\n171\t\t\tresp, err := relayTraceInit(boundURL, body)\n172\t\t\tif err == nil {\n173\t\t\t\twriteJSON(w, http.StatusOK, resp)\n174\t\t\t\treturn\n175\t\t\t}\n176\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: bound proxy %s unreachable for session=%s: %v\", boundURL, tiReq.SessionID, err)\n177\t\t\t// 绑定代理失效，降级为广播探测并更新绑定\n178\t\t}\n179\t\n180\t\tif len(proxiesCopy) == 0 {\n181\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: no proxies registered\")\n182\t\t\thttp.Error(w, \"no proxies registered\", http.StatusServiceUnavailable)\n183\t\t\treturn\n184\t\t}\n185\t\n186\t\t// 广播探测：转发到每个代理，第一个成功者被选中并记录映射\n187\t\tfor pid, proxyURL := range proxiesCopy {\n188\t\t\tresp, err := relayTraceInit(proxyURL, body)\n189\t\t\tif err != nil {\n190\t\t\t\tlogger.Debug(\"api.proxy\", \"trace-init relay to %s failed: %v\", proxyURL, err)\n191\t\t\t\tcontinue\n192\t\t\t}\n193\t\t\th.mu.Lock()\n194\t\t\th.bindSession(pid, tiReq.SessionID, proxyURL)\n195\t\t\th.mu.Unlock()\n196\t\t\tlogger.Info(\"api.proxy\", \"trace-init: session=%s bound to proxy pid=%s url=%s\", tiReq.SessionID, pid, proxyURL)\n197\t\t\twriteJSON(w, http.StatusOK, resp)\n198\t\t\treturn\n199\t\t}\n200\t\n201\t\tlogger.Warn(\"api.proxy\", \"trace-init: all proxies failed for session=%s\", tiReq.SessionID)\n202\t\thttp.Error(w, \"all proxies unreachable\", http.StatusBadGateway)\n203\t}\n204\t\n205\t// List 处理获取代理列表的请求。\n206\t// GET /api/proxies\n207\t// 查询参数：status（可选）、project（可选）\n208\tfunc (h *ProxyHandler) List(w http.ResponseWriter, r *http.Request) {\n209\t\tif r.Method != http.MethodGet {\n210\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n211\t\t\treturn\n212\t\t}\n213\t\n214\t\tvar filter store.ProxyFilter\n215\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\n216\t\t\tfilter.Status = &v\n217\t\t}\n218\t\tif v := r.URL.Query().Get(\"project\"); v != \"\" {\n219\t\t\tfilter.Project = &v\n220\t\t}\n221\t\n222\t\tlogger.Debug(\"api.proxy\", \"GET /api/proxies status=%v project=%v\", filter.Status, filter.Project)\n223\t\n224\t\tproxies, err := h.svc.List(r.Context(), filter)\n225\t\tif err != nil {\n226\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list proxies\")\n227\t\t\treturn\n228\t\t}\n229\t\n230\t\t// 确保返回空数组而非 null\n231\t\tif proxies == nil {\n232\t\t\tproxies = []store.Proxy{}\n233\t\t}\n234\t\n235\t\titems := make([]ProxyItem, len(proxies))\n236\t\tfor i, p := range proxies {\n237\t\t\titems[i] = ProxyItem{\n238\t\t\t\tProxyID:      p.ProxyID,\n239\t\t\t\tProjectSlug:  p.ProjectSlug,\n240\t\t\t\tStatus:       p.Status,\n241\t\t\t\tRegisteredAt: p.RegisteredAt,\n242\t\t\t\tLastPingAt:   p.LastPingAt,\n243\t\t\t}\n244\t\t}\n245\t\n246\t\twriteJSON(w, http.StatusOK, ProxiesResponse{\n247\t\t\tProxies: items,\n248\t\t\tTotal:   len(items),\n249\t\t})\n250\t}\n251\t\n252\t// relayTraceInit 将 trace-init 请求转发到指定代理。\n253\tfunc relayTraceInit(proxyURL string, body []byte) (map[string]any, error) {\n254\t\tclient := &http.Client{}\n255\t\treq, err := http.NewRequest(\"POST\", proxyURL+\"/_internal/trace-init\", bytes.NewReader(body))\n256\t\tif err != nil {\n257\t\t\treturn nil, err\n258\t\t}\n259\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n260\t\n261\t\tresp, err := client.Do(req)\n262\t\tif err != nil {\n263\t\t\treturn nil, err\n264\t\t}\n265\t\tdefer resp.Body.Close()\n266\t\n267\t\tif resp.StatusCode != http.StatusOK {\n268\t\t\trespBody, _ := io.ReadAll(resp.Body)\n269\t\t\treturn nil, fmt.Errorf(\"proxy returned %d: %s\", resp.StatusCode, string(respBody))\n270\t\t}\n271\t\n272\t\tvar result map[string]any\n273\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n274\t\t\treturn nil, fmt.Errorf(\"decode proxy response: %w\", err)\n275\t\t}\n276\t\treturn result, nil\n277\t}\n278\t"}]}
