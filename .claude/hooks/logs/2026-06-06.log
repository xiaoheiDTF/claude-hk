session_id\"`     // 领取者的 session_id，idle 时为空\n\tClaimedAt    *time.Time  `json:\"claimed_at\"`     // 领取时间，idle 时为 null\n\tUpdatedAt    time.Time   `json:\"updated_at\"`     // 最后更新时间\n}\n","numLines":34,"startLine":1,"totalLines":34}},"tool_use_id":"call_852c725c3be640579c8b6f10","duration_ms":4}
