fb == nil {\n42\t\t\tt.Fatal(\"loadFallbackConfig returned nil\")\n43\t\t}\n44\t\tif fb.BaseURL != \"https://api.anthropic.com\" {\n45\t\t\tt.Errorf(\"BaseURL = %q, want %q\", fb.BaseURL, \"https://api.anthropic.com\")\n46\t\t}\n47\t\tif fb.Model != \"GLM-5.1\" {\n48\t\t\tt.Errorf(\"Model = %q, want %q\", fb.Model, \"GLM-5.1\")\n49\t\t}\n50\t\tif fb.AuthToken != \"tok-test-token\" {\n51\t\t\tt.Errorf(\"AuthToken = %q, want %q\", fb.AuthToken, \"tok-test-token\")\n52\t\t}\n53\t\tif fb.APIKey != \"sk-test-key\" {\n54\t\t\tt.Errorf(\"APIKey = %q, want %q\", fb.APIKey, \"sk-test-key\")\n55\t\t}\n56\t}\n57\t\n58\t// TestLoadFallbackConfig_NoSettings 测试无 settings 文件\n59\tfunc TestLoadFallbackConfig_NoSettings(t *testing.T) {\n60\t\ttmpDir := t.TempDir()\n61\t\t// 不创建 .claude 目录\n62\t\n63\t\torigHomeDir := config.HomeDir\n64\t\tconfig.SetHomeDir(func() string { return tmpDir })\n65\t\tdefer config.SetHomeDir(origHomeDir)\n66\t\n67\t\tfb := loadFallbackConfig()\n68\t\tif fb != nil {\n69\t\t\tt.Error(\"expected nil when no settings file\")\n70\t\t}\n71\t}\n72\t\n73\t// TestLoadFallbackConfig_OnlyModel 测试只有 model 无 auth\n74\tfunc TestLoadFallbackConfig_OnlyModel(t *testing.T) {\n75\t\ttmpDir := t.TempDir()\n76\t\tclaudeDir := filepath.Join(tmpDir, \".claude\")\n77\t\tos.MkdirAll(claudeDir, 0o755)\n78\t\n79\t\tsettings := map[string]any{\n80\t\t\t\"model\": \"claude-sonnet-4-6\",\n81\t\t}\n82\t\tdata, _ := json.Marshal(settings)\n83\t\tos.WriteFile(filepath.Join(claudeDir, \"settings.json\"), data, 0o644)\n84\t\n85\t\torigHomeDir := config.HomeDir\n86\t\tconfig.SetHomeDir(func() string { return tmpDir })\n87\t\tdefer config.SetHomeDir(origHomeDir)\n88\t\n89\t\tfb := loadFallbackConfig()\n90\t\tif fb == nil {\n91\t\t\tt.Fatal(\"loadFallbackConfig returned nil\")\n92\t\t}\n93\t\tif fb.Model != \"claude-sonnet-4-6\" {\n94\t\t\tt.Errorf(\"Model = %q, want %q\", fb.Model, \"claude-sonnet-4-6\")\n95\t\t}\n96\t\tif fb.AuthToken != \"\" {\n97\t\t\tt.Errorf(\"AuthToken = %q, want empty\", fb.AuthToken)\n98\t\t}\n99\t\tif fb.APIKey != \"\" {\n100\t\t\tt.Errorf(\"APIKey = %q, want empty\", fb.APIKey)\n101\t\t}\n102\t\t// 无 base_url 应使用默认值\n103\t\tif fb.BaseURL != config.ClaudeClient.DefaultTarget {\n104\t\t\tt.Errorf(\"BaseURL = %q, want default %q\", fb.BaseURL, config.ClaudeClient.DefaultTarget)\n105\t\t}\n106\t}\n107\t\n108\t// TestIntegration_FullStartupFlow 测试完整启动链路\n109\t// profile → resolved config → proxy model → fallback → 请求转发\n110\tfunc TestIntegration_FullStartupFlow(t *testing.T) {\n111\t\ttmpDir := t.TempDir()\n112\t\n113\t\t// 1. 创建 profiles.json\n114\t\tconfigDir := filepath.Join(tmpDir, \".claude-tap-plus\")\n115\t\tos.MkdirAll(configDir, 0o755)\n116\t\tprofiles := map[string]any{\n117\t\t\t\"default\": \"test-profile\",\n118\t\t\t\"profiles\": map[string]any{\n119\t\t\t\t\"test-profile\": map[string]any{\n120\t\t\t\t\t\"base_url\": \"PLACEHOLDER\", // 会被 mock 替换\n121\t\t\t\t\t\"model\":    \"glm-5.1\",\n122\t\t\t\t},\n123\t\t\t},\n124\t\t}\n125\t\tpData, _ := json.Marshal(profiles)\n126\t\tos.WriteFile(filepath.Join(configDir, \"profiles.json\"), pData, 0o644)\n127\t\n128\t\t// 2. 创建 ~/.claude/settings.json（fallback 用）\n129\t\tclaudeDir := filepath.Join(tmpDir, \".claude\")\n130\t\tos.MkdirAll(claudeDir, 0o755)\n131\t\tsettings := map[string]any{\n132\t\t\t\"model\": \"claude-sonnet-4-6\",\n133\t\t\t\"env\": map[string]string{\n134\t\t\t\t\"ANTHROPIC_BASE_URL\":   \"https://api.anthropic.com\",\n135\t\t\t\t\"ANTHROPIC_AUTH_TOKEN\": \"tok-fallback-token\",\n136\t\t\t},\n137\t\t}\n138\t\tsData, _ := json.Marshal(settings)\n139\t\tos.WriteFile(filepath.Join(claudeDir, \"settings.json\"), sData, 0o644)\n140\t\n141\t\t// 3. 设置 home 目录\n142\t\torigHomeDir := config.HomeDir\n143\t\tconfig.SetHomeDir(func() string { return tmpDir })\n144\t\tdefer config.SetHomeDir(origHomeDir)\n145\t\n146\t\t// 4. 创建 mock 上游（profile target）\n147\t\tvar capturedBody []byte\n148\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n149\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n150\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n151\t\t\tw.WriteHeader(http.StatusOK)\n152\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n153\t\t}))\n154\t\tdefer mockUpstream.Close()\n155\t\n156\t\t// 5. 更新 profile 的 base_url 为 mock 地址\n157\t\tprofiles[\"profiles\"] = map[string]any{\n158\t\t\t\"test-profile\": map[string]any{\n159\t\t\t\t\"base_url\": mockUpstream.URL,\n160\t\t\t\t\"model\":    \"glm-5.1\",\n161\t\t\t},\n162\t\t}\n163\t\tpData, _ = json.Marshal(profiles)\n164\t\tos.WriteFile(filepath.Join(configDir, \"profiles.json\"), pData, 0o644)\n165\t\n166\t\t// 6. 解析配置（模拟 runProxy 的配置解析）\n167\t\tresolved, err := config.ResolveTargetConfig(\n168\t\t\t\"\",   // cliBaseURL\n169\t\t\t\"\",   // cliAPIKey\n170\t\t\t\"\",   // cliAuthToken\n171\t\t\t\"test-profile\",\n172\t\t\t&config.ClaudeClient,\n173\t\t)\n174\t\tif err != nil {\n175\t\t\tt.Fatalf(\"ResolveTargetConfig error: %v\", err)\n176\t\t}\n177\t\n178\t\t// 验证 resolved model\n179\t\tif resolved.Model != \"glm-5.1\" {\n180\t\t\tt.Fatalf(\"resolved.Model = %q, want %q\", resolved.Model, \"glm-5.1\")\n181\t\t}\n182\t\n183\t\t// 7. 创建代理并设置 model + fallback\n184\t\ttraceDir := t.TempDir()\n185\t\trp := proxy.NewReverseProxy(resolved.BaseURL, traceDir)\n186\t\trp.SetModel(resolved.Model)\n187\t\n188\t\tfb := loadFallbackConfig()\n189\t\tif fb == nil {\n190\t\t\tt.Fatal(\"loadFallbackConfig returned nil\")\n191\t\t}\n192\t\trp.SetFallbackConfig(fb)\n193\t\n194\t\t// 8. 启动代理\n195\t\t_, err = rp.Start(\"127.0.0.1\", 0)\n196\t\tif err != nil {\n197\t\t\tt.Fatalf(\"start proxy: %v\", err)\n198\t\t}\n199\t\tdefer rp.Stop()\n200\t\n201\t\t// 9. 通过代理发送请求\n202\t\treqBody := `{\"model\":\"claude-sonnet-4-6\",\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}`\n203\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader([]byte(reqBody)))\n204\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n205\t\n206\t\tresp, err := http.DefaultClient.Do(req)\n207\t\tif err != nil {\n208\t\t\tt.Fatalf(\"send request: %v\", err)\n209\t\t}\n210\t\tresp.Body.Close()\n211\t\n212\t\t// 10. 验证上游收到改写后的 model\n213\t\tvar upstreamBody map[string]any\n214\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n215\t\t\tt.Fatalf(\"parse upstream body: %v\", err)\n216\t\t}\n217\t\tgotModel, _ := upstreamBody[\"model\"].(string)\n218\t\tif gotModel != \"glm-5.1\" {\n219\t\t\tt.Errorf(\"upstream model = %q, want %q (should be overridden by profile model)\", gotModel, \"glm-5.1\")\n220\t\t}\n221\t\n222\t\t// 11. 验证 fallback 配置正确\n223\t\tif fb.Model != \"claude-sonnet-4-6\" {\n224\t\t\tt.Errorf(\"fallback model = %q, want %q\", fb.Model, \"claude-sonnet-4-6\")\n225\t\t}\n226\t\tif fb.AuthToken != \"tok-fallback-token\" {\n227\t\t\tt.Errorf(\"fallback token = %q, want %q\", fb.AuthToken, \"tok-fallback-token\")\n228\t\t}\n229\t}\n230\t"}]}
