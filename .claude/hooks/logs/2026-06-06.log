\n93\t//\n94\t// 最多向上搜索 10 层父目录，如果未找到则调用 t.Fatal 终止测试。\n95\tfunc findUpward(t *testing.T, relPath string) string {\n96\t\tt.Helper()\n97\t\tdir, _ := os.Getwd()\n98\t\tfor i := 0; i < 10; i++ {\n99\t\t\tcandidate := filepath.Join(dir, relPath)\n100\t\t\tif _, err := os.Stat(candidate); err == nil {\n101\t\t\t\treturn candidate\n102\t\t\t}\n103\t\t\tparent := filepath.Dir(dir)\n104\t\t\tif parent == dir {\n105\t\t\t\tbreak\n106\t\t\t}\n107\t\t\tdir = parent\n108\t\t}\n109\t\tt.Fatalf(\"file not found: %s\", relPath)\n110\t\treturn \"\"\n111\t}\n112\t\n113\t// CreateMockServer 创建一个 httptest.Server，按夹具配置返回模拟响应。\n114\t//\n115\t// 响应生成逻辑：\n116\t//   - 如果 RawSSE 非空，按 SSE 格式返回（支持流式刷新）\n117\t//   - 如果 Gzip 为 true，对响应体进行 gzip 压缩\n118\t//   - 否则返回 JSON 序列化后的 Body\n119\tfunc CreateMockServer(t *testing.T, fx *Fixture) *httptest.Server {\n120\t\tt.Helper()\n121\t\treturn httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n122\t\t\tfor k, v := range fx.Response.Headers {\n123\t\t\t\tw.Header().Set(k, v)\n124\t\t\t}\n125\t\t\tw.WriteHeader(fx.Response.Status)\n126\t\n127\t\t\tif fx.Response.RawSSE != \"\" {\n128\t\t\t\tflusher, _ := w.(http.Flusher)\n129\t\t\t\t_, _ = io.WriteString(w, fx.Response.RawSSE)\n130\t\t\t\tif flusher != nil {\n131\t\t\t\t\tflusher.Flush()\n132\t\t\t\t}\n133\t\t\t\treturn\n134\t\t\t}\n135\t\n136\t\t\tbodyBytes, err := json.Marshal(fx.Response.Body)\n137\t\t\tif err != nil {\n138\t\t\t\tt.Fatalf(\"marshal response body: %v\", err)\n139\t\t\t}\n140\t\n141\t\t\tif fx.Response.Gzip {\n142\t\t\t\tw.Header().Set(\"Content-Encoding\", \"gzip\")\n143\t\t\t\tvar buf bytes.Buffer\n144\t\t\t\tgw := gzip.NewWriter(&buf)\n145\t\t\t\t_, _ = gw.Write(bodyBytes)\n146\t\t\t\tgw.Close()\n147\t\t\t\t_, _ = w.Write(buf.Bytes())\n148\t\t\t\treturn\n149\t\t\t}\n150\t\n151\t\t\t_, _ = w.Write(bodyBytes)\n152\t\t}))\n153\t}\n154\t\n155\t// SendRequestThroughProxy 将夹具中定义的请求发送到代理服务器。\n156\t//\n157\t// 请求体会被 JSON 序列化，目标地址为 proxyURL + fx.Request.Path。\n158\t// 如果请求构建或发送失败，调用 t.Fatalf 终止测试。\n159\tfunc SendRequestThroughProxy(t *testing.T, fx *Fixture, proxyURL string) *http.Response {\n160\t\tt.Helper()\n161\t\tbodyBytes, err := json.Marshal(fx.Request.Body)\n162\t\tif err != nil {\n163\t\t\tt.Fatalf(\"marshal request body: %v\", err)\n164\t\t}\n165\t\treq, err := http.NewRequest(fx.Request.Method, proxyURL+fx.Request.Path, bytes.NewReader(bodyBytes))\n166\t\tif err != nil {\n167\t\t\tt.Fatalf(\"create request: %v\", err)\n168\t\t}\n169\t\tfor k, v := range fx.Request.Headers {\n170\t\t\treq.Header.Set(k, v)\n171\t\t}\n172\t\tresp, err := http.DefaultClient.Do(req)\n173\t\tif err != nil {\n174\t\t\tt.Fatalf(\"send request: %v\", err)\n175\t\t}\n176\t\treturn resp\n177\t}\n178\t\n179\t// ReadTraceRecords 读取 JSONL 格式的追踪文件，返回所有解析后的记录。\n180\t//\n181\t// 逐行解析，跳过空行，忽略无法解析的行。\n182\tfunc ReadTraceRecords(t *testing.T, path string) []map[string]any {\n183\t\tt.Helper()\n184\t\tdata, err := os.ReadFile(path)\n185\t\tif err != nil {\n186\t\t\tt.Fatalf(\"read trace file: %v\", err)\n187\t\t}\n188\t\tvar records []map[string]any\n189\t\tfor _, line := range strings.Split(string(data), \"\\n\") {\n190\t\t\tline = strings.TrimSpace(line)\n191\t\t\tif line == \"\" {\n192\t\t\t\tcontinue\n193\t\t\t}\n194\t\t\tvar r map[string]any\n195\t\t\tif err := json.Unmarshal([]byte(line), &r); err != nil {\n196\t\t\t\tcontinue\n197\t\t\t}\n198\t\t\trecords = append(records, r)\n199\t\t}\n200\t\treturn records\n201\t}\n202\t\n203\t// AssertTrace 验证单条追踪记录是否符合预期。\n204\t//\n205\t// 检查项：\n206\t//   - session_id 是否匹配\n207\t//   - response.body.usage 中的 input_tokens、output_tokens、\n208\t//     cache_read_input_tokens、cache_creation_input_tokens 是否匹配\n209\t//\n210\t// 预期值为 0 的字段会被跳过验证（表示不检查该项）。\n211\tfunc AssertTrace(t *testing.T, record map[string]any, expected ExpectedTrace) {\n212\t\tt.Helper()\n213\t\tif expected.SessionID != \"\" {\n214\t\t\tgot, _ := record[\"session_id\"].(string)\n215\t\t\tif got != expected.SessionID {\n216\t\t\t\tt.Errorf(\"session_id: got %q, want %q\", got, expected.SessionID)\n217\t\t\t}\n218\t\t}\n219\t\tresp, _ := record[\"response\"].(map[string]any)\n220\t\tif resp == nil {\n221\t\t\tt.Fatal(\"trace record has no response field\")\n222\t\t}\n223\t\tbody, _ := resp[\"body\"].(map[string]any)\n224\t\tif body == nil {\n225\t\t\treturn\n226\t\t}\n227\t\tusage, _ := body[\"usage\"].(map[string]any)\n228\t\tif usage == nil {\n229\t\t\tusage = body\n230\t\t}\n231\t\tassertToken := func(key string, expected int64) {\n232\t\t\tif expected == 0 {\n233\t\t\t\treturn\n234\t\t\t}\n235\t\t\tgot, ok := toInt64(usage[key])\n236\t\t\tif !ok {\n237\t\t\t\treturn\n238\t\t\t}\n239\t\t\tif got != expected {\n240\t\t\t\tt.Errorf(\"%s: got %d, want %d\", key, got, expected)\n241\t\t\t}\n242\t\t}\n243\t\tassertToken(\"input_tokens\", expected.InputTokens)\n244\t\tassertToken(\"output_tokens\", expected.OutputTokens)\n245\t\tassertToken(\"cache_read_input_tokens\", expected.CacheReadTokens)\n246\t\tassertToken(\"cache_creation_input_tokens\", expected.CacheCreateTokens)\n247\t}\n248\t\n249\t// AssertResponseStatus 检查 HTTP 响应状态码是否与预期一致。\n250\tfunc AssertResponseStatus(t *testing.T, resp *http.Response, expected int) {\n251\t\tt.Helper()\n252\t\tif resp.StatusCode != expected {\n253\t\t\tt.Errorf(\"status: got %d, want %d\", resp.StatusCode, expected)\n254\t\t}\n255\t}\n256\t\n257\t// DrainAndClose 读取响应体的全部内容并关闭响应体。\n258\t// 如果读取失败，调用 t.Fatalf 终止测试。\n259\tfunc DrainAndClose(t *testing.T, resp *http.Response) []byte {\n260\t\tt.Helper()\n261\t\tdefer resp.Body.Close()\n262\t\tdata, err := io.ReadAll(resp.Body)\n263\t\tif err != nil {\n264\t\t\tt.Fatalf(\"read response body: %v\", err)\n265\t\t}\n266\t\treturn data\n267\t}\n268\t\n269\t// TempTraceFile 在临时目录中创建一个追踪文件并返回其路径。\n270\tfunc TempTraceFile(t *testing.T) string {\n271\t\tt.Helper()\n272\t\treturn filepath.Join(t.TempDir(), \"trace.jsonl\")\n273\t}\n274\t\n275\t// toInt64 将任意数值类型转换为 int64。\n276\t// 支持 float64、int、int64；不支持的类型返回 (0, false)。\n277\tfunc toInt64(v any) (int64, bool) {\n278\t\tswitch n := v.(type) {\n279\t\tcase float64:\n280\t\t\treturn int64(n), true\n281\t\tcase int:\n282\t\t\treturn int64(n), true\n283\t\tcase int64:\n284\t\t\treturn n, true\n285\t\tdefault:\n286\t\t\treturn 0, false\n287\t\t}\n288\t}\n289\t\n290\t// FixtureName 返回夹具的名称和描述，用于测试错误信息。\n291\tfunc FixtureName(fx *Fixture) string {\n292\t\treturn fmt.Sprintf(\"%s (%s)\", fx.Name, fx.Description)\n293\t}\n294\t"}]}
