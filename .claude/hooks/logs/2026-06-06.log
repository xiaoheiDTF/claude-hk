     \"messages\": [","       {\"role\": \"user\", \"content\": \"read the file\"},","       {\"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"sure\"}]},"]},{"oldStart":171,"oldLines":7,"newStart":165,"newLines":7,"lines":[" ","   traceDir := t.TempDir()","   rp := NewReverseProxy(mockUpstream.URL, traceDir)","-  rp.model = \"test-model\"","+  rp.model = \"kimi-for-coding\""," ","   _, err := rp.Start(\"127.0.0.1\", 0)","   if err != nil {"]},{"oldStart":179,"oldLines":14,"newStart":173,"newLines":10,"lines":["   }","   defer rp.Stop()"," ","-  // 构造 thinking 启用 + tool_call 消息的请求","+  // 模拟 Kimi 场景：无 thinking 字段，但有 tool_call 消息","   reqBody := map[string]any{","-    \"model\":  \"test-model\",","-    \"stream\": false,","-    \"thinking\": map[string]any{","-      \"type\":          \"enabled\",","-      \"budget_tokens\": 10000,","-    },","+    \"model\":  \"kimi-for-coding\",","+    \"stream\": true,","     \"messages\": []any{","       map[string]any{\"role\": \"user\", \"content\": \"read the file\"},","       map[string]any{"]},{"oldStart":229,"oldLines":9,"newStart":219,"newLines":9,"lines":["     t.Fatalf(\"parse upstream body: %v\", err)","   }"," ","-  // model 被改写","-  if m, _ := upstreamBody[\"model\"].(string); m != \"test-model\" {","-    t.Errorf(\"model = %q, want %q\", m, \"test-model\")","+  // model 被改写为 kimi-for-coding","+  if m, _ := upstreamBody[\"model\"].(string); m != \"kimi-for-coding\" {","+    t.Errorf(\"model = %q, want %q\", m, \"kimi-for-coding\")","   }"," ","   // assistant 消息被注入 thinking 块 + reasoning_content"]},{"oldStart":243,"oldLines":12,"newStart":233,"newLines":13,"lines":["     t.Fatalf(\"assistant content blocks = %d, want 2\", len(content))","   }"," ","+  // thinking 块在第一位","   firstBlock := content[0].(map[string]any)","   if firstBlock[\"type\"] != \"thinking\" {","     t.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")","   }"," ","-  // 验证顶层 reasoning_content 字段被注入",