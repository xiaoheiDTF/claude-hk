)\n204\t\tif err != nil {\n205\t\t\tt.Fatalf(\"send request: %v\", err)\n206\t\t}\n207\t\tresp.Body.Close()\n208\t\n209\t\t// 验证上游收到的完整请求体\n210\t\tvar upstreamBody map[string]any\n211\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n212\t\t\tt.Fatalf(\"parse upstream body: %v\", err)\n213\t\t}\n214\t\n215\t\t// model 被替换\n216\t\tif m, _ := upstreamBody[\"model\"].(string); m != \"glm-5.1\" {\n217\t\t\tt.Errorf(\"model = %q, want %q\", m, \"glm-5.1\")\n218\t\t}\n219\t\t// stream 不变\n220\t\tif s, _ := upstreamBody[\"stream\"].(bool); s != true {\n221\t\t\tt.Errorf(\"stream = %v, want true\", s)\n222\t\t}\n223\t\t// max_tokens 不变\n224\t\tif mt, ok := upstreamBody[\"max_tokens\"].(float64); !ok || mt != 4096 {\n225\t\t\tt.Errorf(\"max_tokens = %v, want 4096\", upstreamBody[\"max_tokens\"])\n226\t\t}\n227\t\t// messages 不变\n228\t\tmsgs, ok := upstreamBody[\"messages\"].([]any)\n229\t\tif !ok || len(msgs) != 1 {\n230\t\t\tt.Errorf(\"messages length = %v, want 1\", len(msgs))\n231\t\t}\n232\t}\n233\t"}]}
