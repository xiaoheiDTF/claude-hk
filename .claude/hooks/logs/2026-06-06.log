ckConfig = &FallbackConfig{\n122\t\t\tBaseURL:   fallbackServer.URL,\n123\t\t\tModel:     \"claude-sonnet-4-6\",\n124\t\t\tAuthToken: \"tok-fallback\",\n125\t\t}\n126\t\n127\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n128\t\tif err != nil {\n129\t\t\tt.Fatalf(\"start proxy: %v\", err)\n130\t\t}\n131\t\tdefer rp.Stop()\n132\t\n133\t\t// 请求 1：上游 500\n134\t\treq1, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader([]byte(`{\"model\":\"glm-5.1\",\"stream\":false}`)))\n135\t\treq1.Header.Set(\"Content-Type\", \"application/json\")\n136\t\tresp1, _ := http.DefaultClient.Do(req1)\n137\t\tresp1.Body.Close()\n138\t\n139\t\t// 请求 2：应走 fallback\n140\t\treq2, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader([]byte(`{\"model\":\"glm-5.1\",\"stream\":false}`)))\n141\t\treq2.Header.Set(\"Content-Type\", \"application/json\")\n142\t\tresp2, _ := http.DefaultClient.Do(req2)\n143\t\tresp2.Body.Close()\n144\t\n145\t\t// 上游应该只收到 1 个请求（第一次失败后就不再请求了）\n146\t\tprimaryMu.Lock()\n147\t\tdefer primaryMu.Unlock()\n148\t\tif primaryRequestCount != 1 {\n149\t\t\tt.Errorf(\"primary received %d requests, want 1\", primaryRequestCount)\n150\t\t}\n151\t\n152\t}\n153\t\n154\t// TestUpstreamFallback_NoRecovery 测试切换后不恢复\n155\t// 来源：契约 4 — 进程生命周期内保持不可用\n156\tfunc TestUpstreamFallback_NoRecovery(t *testing.T) {\n157\t\t// 上游：第一次失败，后续都成功（模拟恢复）\n158\t\trequestCount := 0\n159\t\tprimaryServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n160\t\t\trequestCount++\n161\t\t\tif requestCount == 1 {\n162\t\t\t\tw.WriteHeader(http.StatusInternalServerError)\n163\t\t\t\treturn\n164\t\t\t}\n165\t\t\t// 后续请求返回成功（但 fallback 不应该再来这里了）\n166\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n167\t\t\tw.WriteHeader(http.StatusOK)\n168\t\t\tw.Write([]byte(`{\"id\":\"msg_ok\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"primary\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n169\t\t}))\n170\t\tdefer primaryServer.Close()\n171\t\n172\t\t// fallback\n173\t\tfallbackRequestCount := 0\n174\t\tfallbackServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n175\t\t\tfallbackRequestCount++\n176\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n177\t\t\tw.WriteHeader(http.StatusOK)\n178\t\t\tw.Write([]byte(`{\"id\":\"msg_fallback\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"fallback\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n179\t\t}))\n180\t\tdefer fallbackServer.Close()\n181\t\n182\t\ttraceDir := t.TempDir()\n183\t\trp := NewReverseProxy(primaryServer.URL, traceDir)\n184\t\trp.model = \"glm-5.1\"\n185\t\trp.fallbackConfig = &FallbackConfig{\n186\t\t\tBaseURL:   fallbackServer.URL,\n187\t\t\tModel:     \"claude-sonnet-4-6\",\n188\t\t\tAuthToken: \"tok-fallback\",\n189\t\t}\n190\t\n191\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n192\t\tif err != nil {\n193\t\t\tt.Fatalf(\"start proxy: %v\", err)\n194\t\t}\n195\t\tdefer rp.Stop()\n196\t\n197\t\t// 发送 3 个请求\n198\t\tfor i := 0; i < 3; i++ {\n199\t\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader([]byte(`{\"model\":\"glm-5.1\",\"stream\":false}`)))\n200\t\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n201\t\t\tresp, _ := http.DefaultClient.Do(req)\n202\t\t\tresp.Body.Close()\n203\t\t}\n204\t\n205\t\t// 上游只收到 1 个请求（第一次失败），后续不会重试\n206\t\tif requestCount != 1 {\n207\t\t\tt.Errorf(\"primary received %d requests, want 1 (no recovery)\", requestCount)\n208\t\t}\n209\t\t// fallback 收到 2 个请求（第 2、3 个请求）\n210\t\tif fallbackRequestCount != 2 {\n211\t\t\tt.Errorf(\"fallback received %d requests, want 2\", fallbackRequestCount)\n212\t\t}\n213\t}\n214\t\n215\t// TestUpstreamFallback_NoFallbackConfig 测试没有 fallback 配置时不崩溃\n216\t// 来源：契约 4 — fallback 为空时的行为\n217\tfunc TestUpstreamFallback_NoFallbackConfig(t *testing.T) {\n218\t\tprimaryServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n219\t\t\tw.WriteHeader(http.StatusInternalServerError)\n220\t\t\tw.Write([]byte(`{\"error\":\"internal error\"}`))\n221\t\t}))\n222\t\tdefer primaryServer.Close()\n223\t\n224\t\ttraceDir := t.TempDir()\n225\t\trp := NewReverseProxy(primaryServer.URL, traceDir)\n226\t\trp.model = \"glm-5.1\"\n227\t\t// 不设置 fallbackConfig\n228\t\n229\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n230\t\tif err != nil {\n231\t\t\tt.Fatalf(\"start proxy: %v\", err)\n232\t\t}\n233\t\tdefer rp.Stop()\n234\t\n235\t\t// 发送请求，不应 panic\n236\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader([]byte(`{\"model\":\"glm-5.1\",\"stream\":false}`)))\n237\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n238\t\tresp, err := http.DefaultClient.Do(req)\n239\t\tif err != nil {\n240\t\t\tt.Fatalf(\"request error: %v\", err)\n241\t\t}\n242\t\tresp.Body.Close()\n243\t\n244\t\t// 即使上游失败且无 fallback，代理透传上游的 500 响应\n245\t\tif resp.StatusCode != http.StatusInternalServerError {\n246\t\t\tt.Errorf(\"status = %d, want %d (upstream error forwarded)\", resp.StatusCode, http.StatusInternalServerError)\n247\t\t}\n248\t}\n249\t"}]}
