[2026-06-06 15:16:49] [INFO] [PreToolUse] Input: {"session_id":"87e1f21a-e01b-4177-afa6-058b989c00fb","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\87e1f21a-e01b-4177-afa6-058b989c00fb.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk","permission_mode":"default","effort":{"level":"medium"},"hook_event_name":"PreToolUse","tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\store\\session_store.go"},"tool_use_id":"tool_nF12tyrlwEt9QotQlOb7hJ8z"}
