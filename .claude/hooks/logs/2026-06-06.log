           │\n│      │  ┌────────────────────────────────────────────────────────────────┐ │\n│      │  │  📁 项目列表（来自 GET /api/projects）                          │ │\n│      │  │  ────────────────────────────────────────────────────────────  │ │\n│      │  │  项目标识     │ 工作目录              │ 首次注册   │ 最后活跃    │ │\n│      │  │──────────────┼───────────────────────┼────────────┼────────────│ │\n│      │  │  project-x   │ D:\\code\\project-x     │ 06-01 10:00│ 14:32      │ │\n│      │  │  project-y   │ /home/user/project-y  │ 06-01 09:00│ 14:28      │ │\n│      │  │  project-z   │ /Users/user/project-z │ 06-01 08:00│ 14:10      │ │\n│      │  └────────────────────────────────────────────────────────────────┘ │\n│      │                                                                      │\n│      │  数据来源：GET /api/machines + GET /api/projects（直接查询）         │\n│      │                                                                      │\n└──────┴──────────────────────────────────────────────────────────────────────┘\n```\n"},"tool_use_id":"call_486b72d2f50545a0aaadd1b9"}
