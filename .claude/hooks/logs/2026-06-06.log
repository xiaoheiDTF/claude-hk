ns\"`                         // 输出 Token 数量\n26\t\tCacheReadInputTokens     int64 `json:\"cache_read_input_tokens,omitempty\"`     // 缓存读取的输入 Token（可选）\n27\t\tCacheCreationInputTokens int64 `json:\"cache_creation_input_tokens,omitempty\"` // 缓存创建的输入 Token（可选）\n28\t}\n29\t\n30\t// AnthropicMessage 是重建后的 Anthropic Messages API 完整响应结构。\n31\t//\n32\t// 该结构体由 SSEReassembler 将流式 SSE 事件逐块累积后组装而成，\n33\t// 其数据形状与非流式的 Messages API 响应保持一致。\n34\ttype AnthropicMessage struct {\n35\t\tID           string                  `json:\"id\"`            // 消息唯一标识\n36\t\tType         string                  `json:\"type\"`          // 对象类型（通常为 \"message\"）\n37\t\tRole         string                  `json:\"role\"`          // 角色（通常为 \"assistant\"）\n38\t\tModel        string                  `json:\"model\"`         // 使用的模型名称\n39\t\tContent      []AnthropicContentBlock `json:\"content\"`       // 内容块列表\n40\t\tStopReason   string                  `json:\"stop_reason,omitempty\"` // 停止原因（如 \"end_turn\"）\n41\t\tStopSequence *string                 `json:\"stop_sequence\"` // 触发的停止序列（如有）\n42\t\tUsage        AnthropicUsage          `json:\"usage\"`         // Token 用量统计\n43\t}\n44\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/fallback_test.go"},"tool_use_id":"call_7cf079fab7f847a7abeb1b5d","tool_response":"1\tpackage proxy\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"net/http/httptest\"\n9\t\t\"sync\"\n10\t\t\"testing\"\n11\t)\n12\t\n13\t// TestUpstreamFallback_ConnectionFailure 测试连接失败时触发兜底\n14\t// 来源：契约 4 — 上游可用性检测与全量兜底\n15\tfunc TestUpstreamFallback_ConnectionFailure(t *testing.T) {\n16\t\t// 创建 fallback 上游服务器\n17\t\tvar fallbackMu sync.Mutex\n18\t\tvar fallbackRequests []map[string]any\n19\t\tfallbackServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n20\t\t\tbody, _ := io.ReadAll(r.Body)\n21\t\t\tvar parsed map[string]