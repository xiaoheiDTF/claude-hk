.ToLower(k)\n141\t\t\tif hopByHopHeaders[lower] {\n142\t\t\t\tcontinue\n143\t\t\t}\n144\t\t\tfor _, v := range vals {\n145\t\t\t\tupstreamReq.Header.Add(k, v)\n146\t\t\t}\n147\t\t}\n148\t\tupstreamReq.Header.Del(\"Host\")\n149\t\n150\t\t// 向上游发送请求\n151\t\tupstreamResp, err := p.client.Do(upstreamReq)\n152\t\tif err != nil {\n153\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error: %v\", turn, err)\n154\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n155\t\t\treturn\n156\t\t}\n157\t\tdefer upstreamResp.Body.Close()\n158\t\n159\t\tduration := time.Since(t0).Milliseconds()\n160\t\n161\t\t// 从请求体中提取 model 字段\n162\t\tmodel := \"\"\n163\t\tif m, ok := reqBody.(map[string]any); ok {\n164\t\t\tif v, ok := m[\"model\"].(string); ok {\n165\t\t\t\tmodel = v\n166\t\t\t}\n167\t\t}\n168\t\n169\t\t// 检测是否为流式请求\n170\t\tisStreaming := false\n171\t\tif m, ok := reqBody.(map[string]any); ok {\n172\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n173\t\t\t\tisStreaming = s\n174\t\t\t}\n175\t\t}\n176\t\n177\t\t// 根据是否流式分发到对应处理器\n178\t\tif isStreaming {\n179\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n180\t\t} else {\n181\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n182\t\t}\n183\t}\n184\t\n185\t// handleStreaming 处理 SSE 流式响应：\n186\t//   - 复制响应头并写入客户端\n187\t//   - 逐块读取上游响应体并实时转发给客户端\n188\t//   - 使用 SSE 重组器收集完整事件\n189\t//   - 将重组后的结果写入 Trace\n190\tfunc (p *ReverseProxy) handleStreaming(\n191\t\tw http.ResponseWriter,\n192\t\tupstreamResp *http.Response,\n193\t\treqID string, turn, durationMs int,\n194\t\tr *http.Request, reqBody any,"}]}
