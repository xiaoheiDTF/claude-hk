.proxy\", \"trace-init: all proxies failed\")","+  logger.Warn(\"api.proxy\", \"trace-init: all proxies failed for session=%s\", tiReq.SessionID)","   http.Error(w, \"all proxies unreachable\", http.StatusBadGateway)"," }"," "]}],"userModified":false,"replaceAll":false},"tool_use_id":"tool_rEIaqJYaIxbzzbCuXJnPvKKI","duration_ms":13}
