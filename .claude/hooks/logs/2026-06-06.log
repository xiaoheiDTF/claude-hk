42\t}\n43\t\n44\t// FilterHeaders 返回过滤掉逐跳头后的 Header 副本。\n45\t// 若 redact 为 true，敏感头将被部分遮蔽。\n46\tfunc FilterHeaders(headers http.Header, redact bool) http.Header {\n47\t\tout := make(http.Header)\n48\t\tfor k, vals := range headers {\n49\t\t\tlower := strings.ToLower(k)\n50\t\t\t// 跳过逐跳头\n51\t\t\tif hopByHopHeaders[lower] {\n52\t\t\t\tcontinue\n53\t\t\t}\n54\t\t\t// 敏感头脱敏处理\n55\t\t\tif redact && sensitiveHeaderKeys[lower] {\n56\t\t\t\tfor _, v := range vals {\n57\t\t\t\t\tif prefixRedactedKeys[lower] && len(v) > 12 {\n58\t\t\t\t\t\tout.Set(k, v[:12]+\"...\")\n59\t\t\t\t\t} else {\n60\t\t\t\t\t\tout.Set(k, \"***\")\n61\t\t\t\t\t}\n62\t\t\t\t}\n63\t\t\t\tcontinue\n64\t\t\t}\n65\t\t\tfor _, v := range vals {\n66\t\t\t\tout.Add(k, v)\n67\t\t\t}\n68\t\t}\n69\t\treturn out\n70\t}\n71\t\n72\t// HeadersToMap 将 http.Header 转换为 map[string]string，用于 Trace 记录。\n73\t// 每个键只保留第一个值。\n74\tfunc HeadersToMap(h http.Header) map[string]string {\n75\t\tm := make(map[string]string, len(h))\n76\t\tfor k, vals := range h {\n77\t\t\tif len(vals) > 0 {\n78\t\t\t\tm[k] = vals[0]\n79\t\t\t}\n80\t\t}\n81\t\treturn m\n82\t}\n83\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/paths.go"},"tool_use_id":"call_16f1f871fe3640a9b4afa229","tool_response":"1\t// Package proxy 提供 HTTP 代理功能，包括请求转发、SSE 流式处理与 Trace 记录。\n2\tpackage proxy\n3\t\n4\timport \"strings\"\n5\t\n6\t// AllowedPathPrefixes 定义代理将转发的 API 路径前缀白名单。\n7\t// 未知路径（如扫描器、爬虫请求）将被拒绝并返回 404。\n8\tvar AllowedPathPrefixes = []string{\n9\t\t// Claude Code IDE 连接（VS Code / JetBrains 扩展）\n10\t\t\"/ide\",\n11\t\t// Anthropic API\n12\t\t\"/v1/messages\",\n13\t\t\"/v1/complete\",\n14\t\t// OpenAI API\n15\t\t\"/v1/responses\",\n16\t\t\"/v1/chat/completions\",\n17\t\t\"/v1/completions\",\n18\t\t\"/v1/models\",\n19\t\t\"/v1/embeddings\",\n20\t\t\"/v1/files\",\n21\t\t// OpenAI Responses API（strip_path_prefix 移除 /v1 后的路径）\n22\t\t\"/responses\",\n23\t\t\"/chat/completions\",\n24\t\t\"/compl