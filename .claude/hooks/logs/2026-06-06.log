\tif got != tt.expected {\n\t\t\tt.Errorf(\"IsAllowedPath(%q) = %v, want %v\", tt.path, got, tt.expected)\n\t\t}\n\t}\n}\n","numLines":56,"startLine":1,"totalLines":56}},"tool_use_id":"call_cb0aae1480934a35b698f5e4","duration_ms":1}
