tent blocks = %d, want 2\", len(content))\n231\t\t}\n232\t\n233\t\tfirstBlock := content[0].(map[string]any)\n234\t\tif firstBlock[\"type\"] != \"thinking\" {\n235\t\t\tt.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")\n236\t\t}\n237\t\n238\t\t// 原 tool_use 块保持不变\n239\t\tsecondBlock := content[1].(map[string]any)\n240\t\tif secondBlock[\"type\"] != \"tool_use\" {\n241\t\t\tt.Errorf(\"second block type = %q, want %q\", secondBlock[\"type\"], \"tool_use\")\n242\t\t}\n243\t\tif secondBlock[\"name\"] != \"Read\" {\n244\t\t\tt.Errorf(\"tool_use name = %q, want %q\", secondBlock[\"name\"], \"Read\")\n245\t\t}\n246\t}\n247\t\n248\t// TestInjectThinkingContent_NoThinkingUnchanged 验证非 thinking 模式请求完全不受影响。\n249\tfunc TestInjectThinkingContent_NoThinkingUnchanged(t *testing.T) {\n250\t\tvar capturedBody []byte\n251\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n252\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n253\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n254\t\t\tw.WriteHeader(http.StatusOK)\n255\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n256\t\t}))\n257\t\tdefer mockUpstream.Close()\n258\t\n259\t\ttraceDir := t.TempDir()\n260\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n261\t\trp.model = \"test-model\"\n262\t\n263\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n264\t\tif err != nil {\n265\t\t\tt.Fatalf(\"start proxy: %v\", err)\n266\t\t}\n267\t\tdefer rp.Stop()\n268\t\n269\t\t// 不含 thinking 字段的普通请求\n270\t\torigBody := map[string]any{\n271\t\t\t\"model\":      \"test-model\",\n272\t\t\t\"stream\":     false,\n273\t\t\t\"max_tokens\": 4096,\n274\t\t\t\"messages\": []any{\n275\t\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"hello\"},\n276\t\t\t\tmap[string]any{\n277\t\t\t\t\t\"role\": \"assistant\",\n278\t\t\t\t\t\"content\": []any{\n279\t\t\t\t\t\tmap[string]any{\n280\t\t\t\t\t\t\t\"type\":  \"tool_use\",\n281\t\t\t\t\t\t\t\"id\":    \"toolu_456\",\n282\t\t\t\t\t\t\t\"name\":  \"Bash\",\n283\t\t\t\t\t\t\t\"input\": map[string]any{\"command\": \"ls\"},\n284\t\t\t\t\t\t},\n285\t\t\t\t\t},\n286\t\t\t\t},\n287\t\t\t},\n288\t\t}\n289\t\tbodyBytes, _ := json.Marshal(origBody)\n290\t\n291\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n292\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n293\t\n294\t\tresp, err := http.DefaultClient.Do(req)\n295\t\tif err != nil {\n296\t\t\tt.Fatalf(\"send request: %v\", err)\n297\t\t}\n298\t\tresp.Body.Close()\n299\t\n300\t\t// 验证 tool_use 消息未被修改\n301\t\tvar upstreamBody map[string]any\n302\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n303\t\t\tt.Fatalf(\"parse upstream body: %v\", err)\n304\t\t}\n305\t\n306\t\tmsgs := upstreamBody[\"messages\"].([]any)\n307\t\tassistantContent := msgs[1].(map[string]any)[\"content\"].([]any)\n308\t\tif len(assistantContent) != 1 {\n309\t\t\tt.Errorf(\"non-thinking request content length = %d, want 1 (unchanged)\", len(assistantContent))\n310\t\t}\n311\t\tif assistantContent[0].(map[string]any)[\"type\"] != \"tool_use\" {\n312\t\t\tt.Error(\"non-thinking request should not have thinking block injected\")\n313\t\t}\n314\t}\n315\t"}]}
