map[string]any{\n\t\t\t\"type\":          \"enabled\",\n\t\t\t\"budget_tokens\": 10000,\n\t\t},\n\t\t\"messages\": []any{\n\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"read the file\"},\n\t\t\tmap[string]any{\n\t\t\t\t\"role\": \"assistant\",\n\t\t\t\t\"content\": []any{\n\t\t\t\t\tmap[string]any{\n\t\t\t\t\t\t\"type\":  \"tool_use\",\n\t\t\t\t\t\t\"id\":    \"toolu_123\",\n\t\t\t\t\t\t\"name\":  \"Read\",\n\t\t\t\t\t\t\"input\": map[string]any{\"file_path\": \"/tmp/test.txt\"},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t\tmap[string]any{\n\t\t\t\t\"role\": \"user\",\n\t\t\t\t\"content\": []any{\n\t\t\t\t\tmap[string]any{\n\t\t\t\t\t\t\"type\":        \"tool_result\",\n\t\t\t\t\t\t\"tool_use_id\": \"toolu_123\",\n\t\t\t\t\t\t\"content\":     \"file contents\",\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t},\n\t}\n\tbodyBytes, _ := json.Marshal(reqBody)\n\n\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n\treq.Header.Set(\"Content-Type\", \"application/json\")\n\n\tresp, err := http.DefaultClient.Do(req)\n\tif err != nil {\n\t\tt.Fatalf(\"send request: %v\", err)\n\t}\n\tresp.Body.Close()\n\n\t// 验证上游收到的请求体\n\tvar upstreamBody map[string]any\n\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n\t\tt.Fatalf(\"parse upstream body: %v\", err)\n\t}\n\n\t// model 被改写\n\tif m, _ := upstreamBody[\"model\"].(string); m != \"test-model\" {\n\t\tt.Errorf(\"model = %q, want %q\", m, \"test-model\")\n\t}\n\n\t// assistant 消息被注入 thinking 块 + reasoning_content\n\tmessages := upstreamBody[\"messages\"].([]any)\n\tassistantMsg := messages[1].(map[string]any)\n\tcontent := assistantMsg[\"content\"].([]any)\n\n\tif len(content) != 2 {\n\t\tt.Fatalf(\"assistant content blocks = %d, want 2\", len(content))\n\t}\n\n\tfirstBlock := content[0].(map[string]any)\n\tif firstBlock[\"type\"] != \"thinking\" {\n\t\tt.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")\n\t}\n\n\t// 验证顶层 reasoning_content 字段被注入\n\tif rc, ok := assistantMsg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n\t\tt.Errorf(\"reasoning_content = %v, want empty string\", assistantMsg[\"reasoning_content\"])\n\t}\n\n\t// 原 tool_use 块保持不变\n\tsecondBlock := content[1].(map[string]any)\n\tif secondBlock[\"type\"] != \"tool_use\" {\n\t\tt.Errorf(\"second block type = %q, want %q\", secondBlock[\"type\"], \"tool_use\")\n\t}\n\tif secondBlock[\"name\"] != \"Read\" {\n\t\tt.Errorf(\"tool_use name = %q, want %q\", secondBlock[\"name\"], \"Read\")\n\t}\n}\n\n// TestInjectThinkingContent_NoThinkingUnchanged 验证非 thinking 模式请求完全不受影响。\nfunc TestInjectThinkingContent_NoThinkingUnchanged(t *testing.T) {\n\tvar capturedBody []byte\n\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tcapturedBody, _ = io.ReadAll(r.Body)\n\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n\t\tw.WriteHeader(http.StatusOK)\n\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n\t}))\n\tdefer mockUpstream.Close()\n\n\ttraceDir := t.TempDir()\n\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n\trp.model = \"test-model\"\n\n\t_, err := rp.Start(\"127.0.0.1\", 0)\n\tif err != nil {\n\t\tt.Fatalf(\"start proxy: %v\", err)\n\t}\n\tdefer rp.Stop()\n\n\t// 不含 thinking 字段的普通请求\n\torigBody := map[string]any{\n\t\t\"model\":      \"test-model\",\n\t\t\"stream\":     false,\n\t\t\"max_tokens\": 4096,\n\t\t\"messages\": []any{\n\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"hello\"},\n\t\t\tmap[string]any{\n\t\t\t\t\"role\": \"assistant\",\n\t\t\t\t\"content\": []any{\n\t\t\t\t\tmap[string]any{\n\t\t\t\t\t\t\"type\":  \"tool_use\",\n\t\t\t\t\t\t\"id\":    \"toolu_456\",\n\t\t\t\t\t\t\"name\":  \"Bash\",\n\t\t\t\t\t\t\"input\": map[string]any{\"command\": \"ls\"},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t},\n\t}\n\tbodyBytes, _ := json.Marshal(origBody)\n\n\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n\treq.Header.Set(\"Content-Type\", \"application/json\")\n\n\tresp, err := http.DefaultClient.Do(req)\n\tif err != nil {\n\t\tt.Fatalf(\"send request: %v\", err)\n\t}\n\tresp.Body.Close()\n\n\t// 验证 tool_use 消息未被修改（无 thinking 块、无 reasoning_content）\n\tvar upstreamBody map[string]any\n\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n\t\tt.Fatalf(\"parse upstream body: %v\", err)\n\t}\n\n\tmsgs := upstreamBody[\"messages\"].([]any)\n\tassistantMsg := msgs[1].(map[string]any)\n\tassistantContent := assistantMsg[\"content\"].([]any)\n\tif len(assistantContent) != 1 {\n\t\tt.Errorf(\"non-thinking request content length = %d, want 1 (unchanged)\", len(assistantContent))\n\t}\n\tif assistantContent[0].(map[string]any)[\"type\"] != \"tool_use\" {\n\t\tt.Error(\"non-thinking request should not have thinking block injected\")\n\t}\n\tif _, has := assistantMsg[\"reasoning_content\"]; has {\n\t\tt.Error(\"non-thinking request should not have reasoning_content injected\")\n\t}\n}\n"},"tool_response":{"type":"update","filePath":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/thinking_inject_test.go","content":"package proxy\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"testing\"\n)\n\n// TestInjectThinkingContent_Unit 直接测试 injectThinkingContent 函数的各种场景。\nfunc TestInjectThinkingContent_Unit(t *testing.T) {\n\ttests := []struct {\n\t\tname     string\n\t\treqBody  string\n\t\twantSame bool // true = 输出应与输入完全一致\n\t\twantLen  int  // 目标 assistant 消息的 content 数组期望长度\n\t}{\n\t\t{\n\t\t\tname:     \"无 thinking 字段 - 原样透传\",\n\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"thinking disabled - 原样透传\",\n\t\t\treqBody:  `{\"thinking\":{\"type\":\"disabled\"},\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"thinking enabled + tool_use 无 thinking - 注入\",\n\t\t\treqBody:  `{\"thinking\":{\"type\":\"enabled\",\"budget_tokens\":10000},\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n\t\t\twantSame: false,\n\t\t\twantLen:  2,\n\t\t},\n\t\t{\n\t\t\tname:     \"thinking enabled 已有 thinking 块和 reasoning_content - 原样透传\",\n\t\t\treqBody:  `{\"thinking\":{\"type\":\"enabled\"},\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"reasoning\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}],\"reasoning_content\":\"reasoning\"}]}`,\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"空 body - 原样透传\",\n\t\t\treqBody:  \"\",\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"非 JSON body - 原样透传\",\n\t\t\treqBody:  \"this is not json\",\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"JSON 数组 body - 原样透传\",\n\t\t\treqBody:  `[1,2,3]`,\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"thinking enabled 但无 tool_use (纯文本 assistant) - 原样透传\",\n\t\t\treqBody:  `{\"thinking\":{\"type\":\"enabled\"},\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hello\"}]}]}`,\n\t\t\twantSame: true,\n\t\t},\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tvar parsed any\n\t\t\tif tt.reqBody != \"\" {\n\t\t\t\t_ = json.Unmarshal([]byte(tt.reqBody), &parsed)\n\t\t\t}\n\t\t\tresult := injectThinkingContent([]byte(tt.reqBody), parsed)\n\t\t\tif tt.wantSame {\n\t\t\t\tif string(result) != tt.reqBody {\n\t\t\t\t\tt.Errorf(\"expected passthrough, got: %s\", string(result))\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tvar m map[string]any\n\t\t\t\tif err := json.Unmarshal(result, &m); err != nil {\n\t\t\t\t\tt.Fatalf(\"result is not valid JSON: %v\", err)\n\t\t\t\t}\n\t\t\t\tmsgs := m[\"messages\"].([]any)\n\t\t\t\tmsg := msgs[0].(map[string]any)\n\t\t\t\tcontent := msg[\"content\"].([]any)\n\t\t\t\tif len(content) != tt.wantLen {\n\t\t\t\t\tt.Errorf(\"content length = %d, want %d\", len(content), tt.wantLen)\n\t\t\t\t}\n\t\t\t\t// 验证注入的 thinking 块在第一位\n\t\t\t\tfirst := content[0].(map[string]any)\n\t\t\t\tif first[\"type\"] != \"thinking\" {\n\t\t\t\t\tt.Errorf(\"first block type = %q, want %q\", first[\"type\"], \"thinking\")\n\t\t\t\t}\n\t\t\t\t// 验证顶层 reasoning_content 字段被注入\n\t\t\t\tif rc, ok := msg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n\t\t\t\t\tt.Errorf(\"reasoning_content = %v, want empty string\", msg[\"reasoning_content\"])\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n\n// TestInjectThinkingContent_MixedMessages 测试混合消息场景：只有 tool_call 消息被注入。\nfunc TestInjectThinkingContent_MixedMessages(t *testing.T) {\n\treqBody := `{\n\t\t\"thinking\": {\"type\": \"enabled\", \"budget_tokens\": 10000},\n\t\t\"messages\": [\n\t\t\t{\"role\": \"user\", \"content\": \"read the file\"},\n\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"sure\"}]},\n\t\t\t{\"role\": \"user\", \"content\": \"do it\"},\n\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"Read\", \"input\": {\"file\": \"/tmp/x\"}}]},\n\t\t\t{\"role\": \"user\", \"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"t1\", \"content\": \"file data\"}]},\n\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"thinking\", \"thinking\":\"let me think\"},{\"type\": \"tool_use\", \"id\": \"t2\", \"name\": \"Bash\", \"input\": {\"cmd\": \"ls\"}}]}\n\t\t]\n\t}`\n\n\tvar parsed any\n\t_ = json.Unmarshal([]byte(reqBody), &parsed)\n\tresult := injectThinkingContent([]byte(reqBody), parsed)\n\n\tvar m map[string]any\n\tif err := json.Unmarshal(result, &m); err != nil {\n\t\tt.Fatalf(\"parse result: %v\", err)\n\t}\n\tmsgs := m[\"messages\"].([]any)\n\n\t// user 消息不变\n\tif msgs[0].(map[string]any)[\"role\"] != \"user\" {\n\t\tt.Error(\"msg[0] should be user\")\n\t}\n\n\t// 纯文本 assistant (msg[1]) 不变\n\tassistantText := msgs[1].(map[string]any)[\"content\"].([]any)\n\tif len(assistantText) != 1 {\n\t\tt.Errorf(\"assistant text content length = %d, want 1\", len(assistantText))\n\t}\n\n\t// tool_call 无 thinking (msg[3]) → 注入 thinking 块 + reasoning_content\n\tassistantTool := msgs[3].(map[string]any)\n\tcontent := assistantTool[\"content\"].([]any)\n\tif len(content) != 2 {\n\t\tt.Errorf(\"assistant tool content length = %d, want 2 (thinking + tool_use)\", len(content))\n\t}\n\tif content[0].(map[string]any)[\"type\"] != \"thinking\" {\n\t\tt.Error(\"first block should be thinking\")\n\t}\n\tif content[1].(map[string]any)[\"type\"] != \"tool_use\" {\n\t\tt.Error(\"second block should be tool_use\")\n\t}\n\tif rc, ok := assistantTool[\"reasoning_content\"].(string); !ok || rc != \"\" {\n\t\tt.Errorf(\"msg[3] reasoning_content = %v, want empty string\", assistantTool[\"reasoning_content\"])\n\t}\n\n\t// 已有 thinking 的 tool_call (msg[5]) → 不重复注入 thinking 块，但仍注入 reasoning_content（如果缺失）\n\tassistantWithThinking := msgs[5].(map[string]any)\n\tthinkingContent := assistantWithThinking[\"content\"].([]any)\n\tif len(thinkingContent) != 2 {\n\t\tt.Errorf(\"assistant with thinking content length = %d, want 2 (no duplicate)\", len(thinkingContent))\n\t}\n\tif rc, ok := assistantWithThinking[\"reasoning_content\"].(string); !ok || rc != \"\" {\n\t\tt.Errorf(\"msg[5] reasoning_content = %v, want empty string\", assistantWithThinking[\"reasoning_content\"])\n\t}\n}\n\n// TestInjectThinkingContent_Integration 通过完整代理链路测试，验证上游收到注入后的请求体。\nfunc TestInjectThinkingContent_Integration(t *testing.T) {\n\tvar capturedBody []byte\n\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tcapturedBody, _ = io.ReadAll(r.Body)\n\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n\t\tw.WriteHeader(http.StatusOK)\n\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n\t}))\n\tdefer mockUpstream.Close()\n\n\ttraceDir := t.TempDir()\n\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n\trp.model = \"test-model\"\n\n\t_, err := rp.Start(\"127.0.0.1\", 0)\n\tif err != nil {\n\t\tt.Fatalf(\"start proxy: %v\", err)\n\t}\n\tdefer rp.Stop()\n\n\t// 构造 thinking 启用 + tool_call 消息的请求\n\treqBody := map[string]any{\n\t\t\"model\":  \"test-model\",\n\t\t\"stream\": false,\n\t\t\"thinking\": map[string]any{\n\t\t\t\"type\":          \"enabled\",\n\t\t\t\"budget_tokens\": 10000,\n\t\t},\n\t\t\"messages\": []any{\n\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"read the file\"},\n\t\t\tmap[string]any{\n\t\t\t\t\"role\": \"assistant\",\n\t\t\t\t\"content\": []any{\n\t\t\t\t\tmap[string]any{\n\t\t\t\t\t\t\"type\":  \"tool_use\",\n\t\t\t\t\t\t\"id\":    \"toolu_123\",\n\t\t\t\t\t\t\"name\":  \"Read\",\n\t\t\t\t\t\t\"input\": map[string]any{\"file_path\": \"/tmp/test.txt\"},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t\tmap[string]any{\n\t\t\t\t\"role\": \"user\",\n\t\t\t\t\"content\": []any{\n\t\t\t\t\tmap[string]any{\n\t\t\t\t\t\t\"type\":        \"tool_result\",\n\t\t\t\t\t\t\"tool_use_id\": \"toolu_123\",\n\t\t\t\t\t\t\"content\":     \"file contents\",\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t},\n\t}\n\tbodyBytes, _ := json.Marshal(reqBody)\n\n\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n\treq.Header.Set(\"Content-Type\", \"application/json\")\n\n\tresp, err := http.DefaultClient.Do(req)\n\tif err != nil {\n\t\tt.Fatalf(\"send request: %v\", err)\n\t}\n\tresp.Body.Close()\n\n\t// 验证上游收到的请求体\n\tvar upstreamBody map[string]any\n\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n\t\tt.Fatalf(\"parse upstream body: %v\", err)\n\t}\n\n\t// model 被改写\n\tif m, _ := upstreamBody[\"model\"].(string); m != \"test-model\" {\n\t\tt.Errorf(\"model = %q, want %q\", m, \"test-model\")\n\t}\n\n\t// assistant 消息被注入 thinking 块 + reasoning_content\n\tmessages := upstreamBody[\"messages\"].([]any)\n\tassistantMsg := messages[1].(map[string]any)\n\tcontent := assistantMsg[\"content\"].([]any)\n\n\tif len(content) != 2 {\n\t\tt.Fatalf(\"assistant content blocks = %d, want 2\", len(content))\n\t}\n\n\tfirstBlock := content[0].(map[string]any)\n\tif firstBlock[\"type\"] != \"thinking\" {\n\t\tt.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")\n\t}\n\n\t// 验证顶层 reasoning_content 字段被注入\n\tif rc, ok := assistantMsg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n\t\tt.Errorf(\"reasoning_content = %v, want empty string\", assistantMsg[\"reasoning_content\"])\n\t}\n\n\t// 原 tool_use 块保持不变\n\tsecondBlock := content[1].(map[string]any)\n\tif secondBlock[\"type\"] != \"tool_use\" {\n\t\tt.Errorf(\"second block type = %q, want %q\", secondBlock[\"type\"], \"tool_use\")\n\t}\n\tif secondBlock[\"name\"] != \"Read\" {\n\t\tt.Errorf(\"tool_use name = %q, want %q\", secondBlock[\"name\"], \"Read\")\n\t}\n}\n\n// TestInjectThinkingContent_NoThinkingUnchanged 验证非 thinking 模式请求完全不受影响。\nfunc TestInjectThinkingContent_NoThinkingUnchanged(t *testing.T) {\n\tvar capturedBody []byte\n\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tcapturedBody, _ = io.ReadAll(r.Body)\n\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n\t\tw.WriteHeader(http.StatusOK)\n\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n\t}))\n\tdefer mockUpstream.Close()\n\n\ttraceDir := t.TempDir()\n\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n\trp.model = \"test-model\"\n\n\t_, err := rp.Start(\"127.0.0.1\", 0)\n\tif err != nil {\n\t\tt.Fatalf(\"start proxy: %v\", err)\n\t}\n\tdefer rp.Stop()\n\n\t// 不含 thinking 字段的普通请求\n\torigBody := map[string]any{\n\t\t\"model\":      \"test-model\",\n\t\t\"stream\":     false,\n\t\t\"max_tokens\": 4096,\n\t\t\"messages\": []any{\n\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"hello\"},\n\t\t\tmap[string]any{\n\t\t\t\t\"role\": \"assistant\",\n\t\t\t\t\"content\": []any{\n\t\t\t\t\tmap[string]any{\n\t\t\t\t\t\t\"type\":  \"tool_use\",\n\t\t\t\t\t\t\"id\":    \"toolu_456\",\n\t\t\t\t\t\t\"name\":  \"Bash\",\n\t\t\t\t\t\t\"input\": map[string]any{\"command\": \"ls\"},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t},\n\t}\n\tbodyBytes, _ := json.Marshal(origBody)\n\n\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n\treq.Header.Set(\"Content-Type\", \"application/json\")\n\n\tresp, err := http.DefaultClient.Do(req)\n\tif err != nil {\n\t\tt.Fatalf(\"send request: %v\", err)\n\t}\n\tresp.Body.Close()\n\n\t// 验证 tool_use 消息未被修改（无 thinking 块、无 reasoning_content）\n\tvar upstreamBody map[string]any\n\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n\t\tt.Fatalf(\"parse upstream body: %v\", err)\n\t}\n\n\tmsgs := upstreamBody[\"messages\"].([]any)\n\tassistantMsg := msgs[1].(map[string]any)\n\tassistantContent := assistantMsg[\"content\"].([]any)\n\tif len(assistantContent) != 1 {\n\t\tt.Errorf(\"non-thinking request content length = %d, want 1 (unchanged)\", len(assistantContent))\n\t}\n\tif assistantContent[0].(map[string]any)[\"type\"] != \"tool_use\" {\n\t\tt.Error(\"non-thinking request should not have thinking block injected\")\n\t}\n\tif _, has := assistantMsg[\"reasoning_content\"]; has {\n\t\tt.Error(\"non-thinking request should not have reasoning_content injected\")\n\t}\n}\n","structuredPatch":[{"oldStart":34,"oldLines":7,"newStart":34,"newLines":7,"lines":["       wantLen:  2,","     },","     {","-      name:     \"thinking enabled 但已有 thinking 块和 reasoning_content - 原样透传\",","+      name:     \"thinking enabled 已有 thinking 块和 reasoning_content - 原样透传\",","       reqBody:  `{\"thinking\":{\"type\":\"enabled\"},\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"reasoning\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}],\"reasoning_content\":\"reasoning\"}]}`,","       wantSame: true,","     },"]},{"oldStart":77,"oldLines":7,"newStart":77,"newLines":8,"lines":["           t.Fatalf(\"result is not valid JSON: %v\", err)","         }","         msgs := m[\"messages\"].([]any)","-        content := msgs[0].(map[string]any)[\"content\"].([]any)","+        msg := msgs[0].(map[string]any)","+        content := msg[\"content\"].([]any)","         if len(content) != tt.wantLen {","           t.Errorf(\"content length = %d, want %d\", len(content), tt.wantLen)","         }"]},{"oldStart":86,"oldLines":8,"newStart":87,"newLines":7,"lines":["         if first[\"type\"] != \"thinking\" {","           t.Errorf(\"first block type = %q, want %q\", first[\"type\"], \"thinking\")","         }","-t\t\t\t// 验证顶层 reasoning_content 字段被注入","-        msg := msgs[0].(map[string]any)","+        // 验证顶层 reasoning_content 字段被注入","         if rc, ok := msg[\"reasoning_content\"].(string); !ok || rc != \"\" {","           t.Errorf(\"reasoning_content = %v, want empty string\", msg[\"reasoning_content\"])","         }"]},{"oldStart":131,"oldLines":31,"newStart":131,"newLines":30,"lines":["     t.Errorf(\"assistant text content length = %d, want 1\", len(assistantText))","   }"," ","-  // tool_call 无 thinking (msg[3]) → 注入","-  assistantTool := msgs[3].(map[string]any)[\"content\"].([]any)","-  if len(assistantTool) != 2 {","-    t.Errorf(\"assistant tool content length = %d, want 2 (thinking + tool_use)\", len(assistantTool))","+  // tool_call 无 thinking (msg[3]) → 注入 thinking 块 + reasoning_content","+  assistantTool := msgs[3].(map[string]any)","+  conte