]any)\n\t\t\tif !ok {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tblockType, _ := block[\"type\"].(string)\n\t\t\tif blockType == \"tool_use\" {\n\t\t\t\thasToolUse = true\n\t\t\t}\n\t\t\tif blockType == \"thinking\" {\n\t\t\t\thasThinking = true\n\t\t\t}\n\t\t}\n\n\t\t// 有 tool_use 但无 thinking 块 → 在 content 开头插入空 thinking 块\n\t\tif hasToolUse && !hasThinking {\n\t\t\tthinkingBlock := map[string]any{\n\t\t\t\t\"type\":     \"thinking\",\n\t\t\t\t\"thinking\": \"\",\n\t\t\t}\n\t\t\tnewContent := make([]any, 0, len(content)+1)\n\t\t\tnewContent = append(newContent, thinkingBlock)\n\t\t\tnewContent = append(newContent, content...)\n\t\t\tmsg[\"content\"] = newContent\n\t\t\tmessages[i] = msg\n\t\t\tmodified = true\n\t\t}\n\t}\n\n\tif !modified {\n\t\treturn body\n\t}\n\n\tm[\"messages\"] = messages","new_string":"// injectThinkingContent 在启用 thinking 模式时，为缺少 reasoning_content 的 assistant tool_call 消息注入补丁。\n//\n// Kimi 等兼容 Anthropic 的端点要求：当 thinking 启用时，assistant tool_call 消息必须携带\n// 顶层字段 reasoning_content，以及 content 数组中的 thinking 块。\n// Claude Code 的 tool_call 消息在对话历史中不含这些字段，导致上游 400 错误：\n//\n//\t400 thinking is enabled but reasoning_content is missing in assistant tool call message at index N\n//\n// 此函数仅在 thinking.type == \"enabled\" 时执行注入，不影响非 thinking 模式的请求。\nfunc injectThinkingContent(body []byte, parsed any) []byte {\n\tif len(body) == 0 {\n\t\treturn body\n\t}\n\n\tm, ok := parsed.(map[string]any)\n\tif !ok {\n\t\treturn body // 非 JSON 或非对象\n\t}\n\n\t// 检测 thinking 是否启用\n\tthinking, ok := m[\"thinking\"].(map[string]any)\n\tif !ok {\n\t\treturn body // 无 thinking 字段\n\t}\n\tthinkingType, _ := thinking[\"type\"].(string)\n\tif thinkingType != \"enabled\" {\n\t\treturn body // thinking 未启用\n\t}\n\n\t// 获取 messages 数组\n\tmessages, ok := m[\"messages\"].([]any)\n\tif !ok || len(messages) == 0 {\n\t\treturn body\n\t}\n\n\tmodified := false\n\tfor i, msgRaw := range messages {\n\t\tmsg, ok := msgRaw.(map[string]any)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\n\t\t// 只处理 assistant 消息\n\t\trole, _ := msg[\"role\"].(string)\n\t\tif role != \"assistant\" {\n\t\t\tcontinue\n\t\t}\n\n\t\t// 检查 content 是否为数组\n\t\tcontent, ok := msg[\"content\"].([]any)\n\t\tif !ok || len(content) == 0 {\n\t\t\tcontinue\n\t\t}\n\n\t\t// 检查是否有 tool_use 块、thinking 块、reasoning_content 字段\n\t\thasToolUse := false\n\t\thasThinking := false\n\t\tfor _, blockRaw := range content {\n\t\t\tblock, ok := blockRaw.(map[string]any)\n\t\t\tif !ok {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tblockType, _ := block[\"type\"].(string)\n\t\t\tif blockType == \"tool_use\" {\n\t\t\t\thasToolUse = true\n\t\t\t}\n\t\t\tif blockType == \"thinking\" {\n\t\t\t\thasThinking = true\n\t\t\t}\n\t\t}\n\t\thasReasoningContent := false\n\t\tif _, exists := msg[\"reasoning_content\"]; exists {\n\t\t\thasReasoningContent = true\n\t\t}\n\n\t\t// 只处理含 tool_use 且缺少必要字段的 assistant 消息\n\t\tif !hasToolUse {\n\t\t\tcontinue\n\t\t}\n\n\t\tneedPatch := false\n\n\t\t// 补丁 1: content 数组缺少 thinking 块 → 在开头插入\n\t\tif !hasThinking {\n\t\t\tthinkingBlock := map[string]any{\n\t\t\t\t\"type\":     \"thinking\",\n\t\t\t\t\"thinking\": \"\",\n\t\t\t}\n\t\t\tnewContent := make([]any, 0, len(content)+1)\n\t\t\tnewContent = append(newContent, thinkingBlock)\n\t\t\tnewContent = append(newContent, content...)\n\t\t\tmsg[\"content\"] = newContent\n\t\t\tneedPatch = true\n\t\t}\n\n\t\t// 补丁 2: 消息缺少顶层 reasoning_content 字段 → 注入空值\n\t\tif !hasReasoningContent {\n\t\t\tmsg[\"reasoning_content\"] = \"\"\n\t\t\tneedPatch = true\n\t\t}\n\n\t\tif needPatch {\n\t\t\tmessages[i] = msg\n\t\t\tmodified = true\n\t\t}\n\t}\n\n\tif !modified {\n\t\treturn body\n\t}\n\n\tm[\"messages\"] = messages","replace_all":false},"tool_use_id":"call_7386f6ecc4364f8caac3fc93"}
