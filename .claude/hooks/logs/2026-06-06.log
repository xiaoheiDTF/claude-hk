\tmodel              string              // 强制替换的模型名（空=不改写）\n35\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n36\t\tfallbackConfig     *FallbackConfig      // 兜底配置（上游不可用时切换）\n37\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfig 的并发安全\n38\t\tactualAddr         string              // 实际监听地址（启动后设置）\n39\t}\n40\t\n41\t// FallbackConfig 存储上游不可用时的兜底配置。\n42\ttype FallbackConfig struct {\n43\t\tBaseURL   string // 兜底上游 API 地址\n44\t\tModel     string // 兜底模型名\n45\t\tAuthToken string // 兜底认证 Token\n46\t\tAPIKey    string // 兜底 API Key\n47\t}\n48\t\n49\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n50\t// traceDir 为 Trace 文件存放的基础目录。\n51\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n52\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n53\t\treturn &ReverseProxy{\n54\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n55\t\t\tbaseDir:           traceDir,\n56\t\t\tupstreamAvailable: true,\n57\t\t\tclient: &http.Client{\n58\t\t\t\tTimeout: 0, // 流式场景不设超时\n59\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n60\t\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n61\t\t\t\t},\n62\t\t\t},\n63\t\t}\n64\t}\n65\t\n66\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n67\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n68\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n69\t\tmux := http.NewServeMux()\n70\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n71\t\tp.server = &http.Server{\n72\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n73\t\t\tHandler: mux,\n74\t\t}\n75\t\n76\t\tlistener, err := ioListener(p.server.Addr)\n77\t\tif err != nil {\n78\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n79\t\t}\n80\t\n81\t\t// 在后台 goroutine 中启动服务\n82\t\tgo func() {\n83\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n84\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n85\t\t\t}\n86\t\t}()\n87\t\n88\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n89\t\tp.actualAddr = fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n90\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n91\t\treturn actualPort, nil\n92\t}\n93\t\n94\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n95\tfunc (p *ReverseProxy) Stop() {\n96\t\tlogger.Info(\"proxy\", \"stopping\")\n97\t\tif p.writer != nil {\n98\t\t\tp.writer.Close()\n99\t\t}\n100\t\tif p.server != nil {\n101\t\t\t_ = p.server.Close()\n102\t\t}\n103\t}\n104\t\n105\t// URL 返回代理服务器的 HTTP 地址（如 http://127.0.0.1:8080）。\n106\tfunc (p *ReverseProxy) URL() string {\n107\t\treturn p.actualAddr\n108\t}\n109\t\n110\t// serveHTTP 是代理的核心 HTTP 处理函数。\n111\t// 处理流程：内部端点 → 路径白名单检查 → 读取请求体 → 构建上游请求 → 转发 → 流式/非流式处理。\n112\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n113\t\t// 处理内部端点（绕过路径白名单）\n114\t\tif strings.HasPrefix(r.URL.Path, \"/_internal/\") {\n115\t\t\tp.handleInternal(w, r)\n116\t\t\treturn\n117\t\t}\n118\t\n119\t\t// 拒绝未知路径\n120\t\tif !IsAllowedPath(r.URL.Path) {\n121\t\t\thttp.NotFound(w, r)\n122\t\t\treturn\n123\t\t}\n124\t\n125\t\t// 读取请求体\n126\t\tbodyBytes, err := io.ReadAll(r.Body)\n127\t\tif err != nil {\n128\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n129\t\t\treturn\n130\t\t}\n131\t\t_ = r.Body.Close()\n132\t\n133\t\t// 解析请求体为 JSON（用于后续提取 model、stream 等字段）\n134\t\tvar reqBody any\n135\t\tif len(bodyBytes) > 0 {\n136\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n137\t\t}\n138\t\n139\t\t// 请求体 model 改写（契约 3）\n140\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, p.model)\n141\t\n142\t\t// 重新解析改写后的请求体\n143\t\treqBody = nil\n144\t\tif len(bodyBytes) > 0 {\n145\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n146\t\t}\n147\t\n148\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n149\t\tbodyBytes = injectThinkingContent(bodyBytes, reqBody)\n150\t\treqBody = nil\n151\t\tif len(bodyBytes) > 0 {\n152\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n153\t\t}\n154\t\n155\t\t// 生成请求 ID 与 Turn 编号\n156\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n157\t\tturn := int(p.turn.Add(1))\n158\t\tt0 := time.Now()\n159\t\n160\t\tlogger.Debug(\"proxy\", \"[Turn %d] request: %s %s (%d bytes)\", turn, r.Method, r.URL.Path, len(bodyBytes))\n161\t\n162\t\t// 确定上游目标：检查是否需要走兜底配置（契约 4）\n163\t\tp.availableMu.Lock()\n164\t\tuseFallback := !p.upstreamAvailable && p.fallbackConfig != nil\n165\t\tactiveTarget := p.target\n166\t\tvar fallbackModel string\n167\t\tif useFallback {\n168\t\t\tactiveTarget = p.fallbackConfig.BaseURL\n169\t\t\tfallbackModel = p.fallbackConfig.Model\n170\t\t}\n171\t\tp.availableMu.Unlock()\n172\t\n173\t\t// 兜底模式下重新改写 model\n174\t\tif useFallback && fallbackModel != \"\" {\n175\t\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, fallbackModel)\n176\t\t\treqBody = nil\n177\t\t\tif len(bodyBytes) > 0 {\n178\t\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n179\t\t\t}\n180\t\n181\t\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n182\t\t\tbodyBytes = injectThinkingContent(bodyBytes, reqBody)\n183\t\t\treqBody = nil\n184\t\t\tif len(bodyBytes) > 0 {\n185\t\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n186\t\t\t}\n187\t\t}\n188\t\n189\t\t// 构建上游请求 URL\n190\t\tupstreamURL := activeTarget + r.URL.Path\n191\t\tif r.URL.RawQuery != \"\" {\n192\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n193\t\t}\n194\t\n195\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n196\t\tif err != nil {\n197\t\t\thttp.Error(w, \"create upstream request: \"+err.Error(), http.StatusBadGateway)\n198\t\t\treturn\n199\t\t}\n200\t\n201\t\t// 复制请求头，过滤逐跳头\n202\t\tfor k, vals := range r.Header {\n203\t\t\tlower := strings.ToLower(k)\n204\t\t\tif hopByHopHeaders[lower] {\n205\t\t\t\tcontinue\n206\t\t\t}\n207\t\t\tfor _, v := range vals {\n208\t\t\t\tupstreamReq.Header.Add(k, v)\n209\t\t\t}\n210\t\t}\n211\t\tupstreamReq.Header.Del(\"Host\")\n212\t\n213\t\t// 兜底模式下替换认证头\n214\t\tif useFallback && p.fallbackConfig != nil {\n215\t\t\tif p.fallbackConfig.APIKey != \"\" {\n216\t\t\t\tupstreamReq.Header.Set(\"x-api-key\", p.fallbackConfig.APIKey)\n217\t\t\t}\n218\t\t\tif p.fallbackConfig.AuthToken != \"\" {\n219\t\t\t\tupstreamReq.Header.Set(\"Authorization\", \"Bearer \"+p.fallbackConfig.AuthToken)\n220\t\t\t}\n221\t\t}\n222\t\n223\t\t// 向上游发送请求\n224\t\tupstreamResp, err := p.client.Do(upstreamReq)\n225\t\tif err != nil {\n226\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error: %v\", turn, err)\n227\t\t\tp.markUnavailable()\n228\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n229\t\t\treturn\n230\t\t}\n231\t\tdefer upstreamResp.Body.Close()\n232\t\n233\t\t// 响应错误（4xx/5xx）→ 标记上游不可用（契约 4）\n234\t\tif upstreamResp.StatusCode >= 400 {\n235\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error response: %d\", turn, upstreamResp.StatusCode)\n236\t\t\tp.markUnavailable()\n237\t\t}\n238\t\n239\t\tduration := time.Since(t0).Milliseconds()\n240\t\n241\t\t// 从请求体中提取 model 字段\n242\t\tmodel := \"\"\n243\t\tif m, ok := reqBody.(map[string]any); ok {\n244\t\t\tif v, ok := m[\"model\"].(string); ok {\n245\t\t\t\tmodel = v\n246\t\t\t}\n247\t\t}\n248\t\n249\t\t// 检测是否为流式请求\n250\t\tisStreaming := false\n251\t\tif m, ok := reqBody.(map[string]any); ok {\n252\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n253\t\t\t\tisStreaming = s\n254\t\t\t}\n255\t\t}\n256\t\n257\t\t// 根据是否流式分发到对应处理器\n258\t\tif isStreaming {\n259\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n260\t\t} else {\n261\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n262\t\t}\n263\t}\n264\t\n265\t// handleStreaming 处理 SSE 流式响应：\n266\t//   - 复制响应头并写入客户端\n267\t//   - 逐块读取上游响应体并实时转发给客户端\n268\t//   - 使用 SSE 重组器收集完整事件\n269\t//   - 将重组后的结果写入 Trace\n270\tfunc (p *ReverseProxy) handleStreaming(\n271\t\tw http.ResponseWriter,\n272\t\tupstreamResp *http.Response,\n273\t\treqID string, turn, durationMs int,\n274\t\tr *http.Request, reqBody any,\n275\t\tt0 time.Time, model string,\n276\t) {\n277\t\t// 复制响应头\n278\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n279\t\tfor k, vals := range respHeaders {\n280\t\t\tfor _, v := range vals {\n281\t\t\t\tw.Header().Add(k, v)\n282\t\t\t}\n283\t\t}\n284\t\tw.WriteHeader(upstreamResp.StatusCode)\n285\t\n286\t\tflusher, canFlush := w.(http.Flusher)\n287\t\treassembler := sse.NewSSEReassembler()\n288\t\n289\t\t// 逐块读取并转发流式数据\n290\t\tbuf := make([]byte, 32*1024)\n291\t\tfor {\n292\t\t\tn, err := upstreamResp.Body.Read(buf)\n293\t\t\tif n > 0 {\n294\t\t\t\t_, _ = w.Write(buf[:n])\n295\t\t\t\tif canFlush {\n296\t\t\t\t\tflusher.Flush()\n297\t\t\t\t}\n298\t\t\t\treassembler.FeedBytes(buf[:n])\n299\t\t\t}\n300\t\t\tif err != nil {\n301\t\t\t\tbreak\n302\t\t\t}\n303\t\t}\n304\t\n305\t\tdurationMs = int(time.Since(t0).Milliseconds())\n306\t\treconstructed := reassembler.Reconstruct()\n307\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n308\t\n309\t\t// 构建 Trace 记录\n310\t\trecord := buildRecord(\n311\t\t\treqID, turn, durationMs,\n312\t\t\tr.Method, r.URL.RequestURI(),\n313\t\t\tr.Header, reqBody,\n314\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n315\t\t\treconstructed,\n316\t\t\treassembler.Events,\n317\t\t\tp.target,\n318\t\t)\n319\t\n320\t\tif w := p.getWriter(); w != nil {\n321\t\t\tif err := w.Write(record); err != nil {\n322\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n323\t\t\t}\n324\t\t} else {\n325\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n326\t\t}\n327\t\n328\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n329\t}\n330\t\n331\t// handleNonStreaming 处理普通（非流式）响应：\n332\t//   - 读取完整响应体\n333\t//   - 按需解压（gzip / deflate）\n334\t//   - 解析 JSON 响应体\n335\t//   - 写入 Trace 并返回给客户端\n336\tfunc (p *ReverseProxy) handleNonStreaming(\n337\t\tw http.ResponseWriter,\n338\t\tupstreamResp *http.Response,\n339\t\treqID string, turn, durationMs int,\n340\t\tr *http.Request, reqBody any, model string,\n341\t) {\n342\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n343\t\tif err != nil {\n344\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n345\t\t\treturn\n346\t\t}\n347\t\n348\t\t// 按需解压响应体\n349\t\tdecodeBytes := respBytes\n350\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n351\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n352\t\t\tvar reader io.ReadCloser\n353\t\t\tif encoding == \"gzip\" {\n354\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n355\t\t\t} else {\n356\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n357\t\t\t}\n358\t\t\tif reader != nil {\n359\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n360\t\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n361\t\t\t\t\tdecodeBytes = decoded\n362\t\t\t\t}\n363\t\t\t\t_ = reader.Close()\n364\t\t\t}\n365\t\t}\n366\t\n367\t\t// 解析解压后的 JSON 响应体\n368\t\tvar respBody any\n369\t\tif len(decodeBytes) > 0 {\n370\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n371\t\t}\n372\t\n373\t\t// 构建 Trace 记录\n374\t\trecord := buildRecord(\n375\t\t\treqID, turn, durationMs,\n376\t\t\tr.Method, r.URL.RequestURI(),\n377\t\t\tr.Header, reqBody,\n378\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n379\t\t\trespBody,\n380\t\t\tnil,\n381\t\t\tp.target,\n382\t\t)\n383\t\n384\t\tif w := p.getWriter(); w != nil {\n385\t\t\tif err := w.Write(record); err != nil {\n386\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n387\t\t\t}\n388\t\t} else {\n389\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n390\t\t}\n391\t\n392\t\t// 将响应返回给客户端\n393\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n394\t\tfor k, vals := range respHeaders {\n395\t\t\tfor _, v := range vals {\n396\t\t\t\tw.Header().Add(k, v)\n397\t\t\t}\n398\t\t}\n399\t\tw.WriteHeader(upstreamResp.StatusCode)\n400\t\t_, _ = w.Write(respBytes)\n401\t\n402\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n403\t}\n404\t\n405\t// buildRecord 构建一条 Trace 记录，包含请求/响应的完整信息。\n406\tfunc buildRecord(\n407\t\treqID string, turn, durationMs int,\n408\t\tmethod, path string,\n409\t\treqHeaders http.Header, reqBody any,\n410\t\tstatus int, respHeaders http.Header,\n411\t\trespBody any,\n412\t\tsseEvents []map[string]any,\n413\t\tupstreamBaseURL string,\n414\t) map[string]any {\n415\t\trecord := map[string]any{\n416\t\t\t\"timestamp\":   time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n417\t\t\t\"request_id\":  reqID,\n418\t\t\t\"session_id\":  extractSessionID(reqBody),\n419\t\t\t\"turn\":        turn,\n420\t\t\t\"duration_ms\": durationMs,\n421\t\t\t\"request\": map[string]any{\n422\t\t\t\t\"method\":  method,\n423\t\t\t\t\"path\":    path,\n424\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n425\t\t\t\t\"body\":    reqBody,\n426\t\t\t},\n427\t\t\t\"response\": map[string]any{\n428\t\t\t\t\"status\":  status,\n429\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n430\t\t\t\t\"body\":    respBody,\n431\t\t\t},\n432\t\t}\n433\t\tif len(sseEvents) > 0 {\n434\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n435\t\t}\n436\t\tif upstreamBaseURL != \"\" {\n437\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n438\t\t}\n439\t\treturn record\n440\t}\n441\t\n442\t// extractSessionID 从请求体的 metadata.user_id 字段中提取 session_id。\n443\t// Claude Code 发送的格式为：metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n444\tfunc extractSessionID(reqBody any) string {\n445\t\tbody, ok := reqBody.(map[string]any)\n446\t\tif !ok {\n447\t\t\treturn \"\"\n448\t\t}\n449\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n450\t\tif metadata == nil {\n451\t\t\treturn \"\"\n452\t\t}\n453\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n454\t\tif userIDRaw == \"\" {\n455\t\t\treturn \"\"\n456\t\t}\n457\t\tvar userData map[string]string\n458\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n459\t\t\treturn \"\"\n460\t\t}\n461\t\treturn userData[\"session_id\"]\n462\t}\n463\t\n464\t// handleInternal 分发内部代理端点请求。\n465\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n466\t\tswitch r.URL.Path {\n467\t\tcase \"/_internal/trace-init\":\n468\t\t\tp.handleTraceInit(w, r)\n469\t\tdefault:\n470\t\t\thttp.NotFound(w, r)\n471\t\t}\n472\t}\n473\t\n474\t// handleTraceInit 接收 SessionStart 钩子传来的会话信息，创建 Trace 写入器。\n475\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n476\t\tif r.Method != http.MethodPost {\n477\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n478\t\t\treturn\n479\t\t}\n480\t\n481\t\tvar req struct {\n482\t\t\tSessionID      string `json:\"session_id\"`\n483\t\t\tMachineID      string `json:\"machine_id\"`\n484\t\t\tProjectSlug    string `json:\"project_slug\"`\n485\t\t\tTranscriptPath string `json:\"transcript_path\"`\n486\t\t}\n487\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n488\t\t\tlogger.Warn(\"proxy\", \"trace-init: invalid JSON: %v\", err)\n489\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n490\t\t\treturn\n491\t\t}\n492\t\n493\t\tif req.SessionID == \"\" {\n494\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n495\t\t\treturn\n496\t\t}\n497\t\n498\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n499\t\n500\t\t// 若请求中未提供，则通过 trace 包自动检测\n501\t\tmachineID := req.MachineID\n502\t\tif machineID == \"\" {\n503\t\t\tmachineID = trace.MachineID()\n504\t\t}\n505\t\n506\t\tprojectSlug := req.ProjectSlug\n507\t\tif projectSlug == \"\" {\n508\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n509\t\t\tif projectSlug == \"\" {\n510\t\t\t\tprojectSlug = trace.DetectProjectName()\n511\t\t\t}\n512\t\t}\n513\t\n514\t\t// 创建会话专属的 Trace 写入器\n515\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n516\t\twriter, err := trace.NewTraceWriter(tracePath)\n517\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n518\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n519\t\tif err != nil {\n520\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n521\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n522\t\t\treturn\n523\t\t}\n524\t\n525\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n526\t\t\tif p.writer != nil {\n527\t\t\t\tp.writer.Close()\n528\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n529\t\t\t}\n530\t\tp.writer = writer\n531\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n532\t\n533\t\t// 通知外部注册 proxy.json\n534\t\tif p.OnSessionInit != nil {\n535\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n536\t\t}\n537\t\n538\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n539\t\tjson.NewEncoder(w).Encode(map[string]string{\n540\t\t\t\"status\":     \"ok\",\n541\t\t\t\"trace_path\": tracePath,\n542\t\t})\n543\t}\n544\t\n545\t// getWriter 返回当前会话的 Trace 写入器。\n546\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n547\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n548\t\treturn p.writer\n549\t}\n550\t\n551\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n552\t// 若无有效写入器，返回零值统计。\n553\tfunc (p *ReverseProxy) Summary() map[string]any {\n554\t\tif w := p.getWriter(); w != nil {\n555\t\t\treturn w.Summary()\n556\t\t}\n557\t\treturn map[string]any{\n558\t\t\t\"api_calls\":           0,\n559\t\t\t\"input_tokens\":        int64(0),\n560\t\t\t\"output_tokens\":       int64(0),\n561\t\t\t\"cache_read_tokens\":   int64(0),\n562\t\t\t\"cache_create_tokens\": int64(0),\n563\t\t}\n564\t}\n565\t\n566\t// SessionID 返回当前会话的 session_id。\n567\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n568\tfunc (p *ReverseProxy) SessionID() string {\n569\t\tif p.sessionID != \"\" {\n570\t\t\treturn p.sessionID\n571\t\t}\n572\t\tif w := p.getWriter(); w != nil {\n573\t\t\treturn w.SessionID()\n574\t\t}\n575\t\treturn \"\"\n576\t}\n577\t\n578\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n579\tfunc (p *ReverseProxy) ProjectSlug() string {\n580\t\treturn p.projectSlug\n581\t}\n582\t\n583\t// TracePath 返回当前追踪文件的完整路径。\n584\tfunc (p *ReverseProxy) TracePath() string {\n585\t\tif w := p.getWriter(); w != nil {\n586\t\t\treturn w.Path()\n587\t\t}\n588\t\treturn \"\"\n589\t}\n590\t\n591\t// markUnavailable 标记上游不可用（契约 4）。\n592\t// 首次失败后置 upstreamAvailable = false，进程生命周期内不再恢复。\n593\tfunc (p *ReverseProxy) markUnavailable() {\n594\t\tp.availableMu.Lock()\n595\t\tdefer p.availableMu.Unlock()\n596\t\tif p.upstreamAvailable {\n597\t\t\tp.upstreamAvailable = false\n598\t\t\tlogger.Warn(\"proxy\", \"upstream marked unavailable, switching to fallback\")\n599\t\t}\n600\t}\n601\t\n602\t// SetModel 设置强制替换的模型名。\n603\tfunc (p *ReverseProxy) SetModel(model string) {\n604\t\tp.model = model\n605\t}\n606\t\n607\t// SetFallbackConfig 设置兜底配置。\n608\tfunc (p *ReverseProxy) SetFallbackConfig(cfg *FallbackConfig) {\n609\t\tp.fallbackConfig = cfg\n610\t}\n611\t\n612\t// rewriteModel 改写请求体 JSON 中的 model 字段（契约 3）。\n613\t// 如果 model 为空、body 为空、body 非 JSON 或 body 为 JSON 非对象，原样返回。\n614\tfunc rewriteModel(body []byte, parsed any, model string) []byte {\n615\t\tif model == \"\" || len(body) == 0 {\n616\t\t\treturn body\n617\t\t}\n618\t\n619\t\tm, ok := parsed.(map[string]any)\n620\t\tif !ok {\n621\t\t\treturn body // 非 JSON 或非对象\n622\t\t}\n623\t\n624\t\tm[\"model\"] = model\n625\t\trewritten, err := json.Marshal(m)\n626\t\tif err != nil {\n627\t\t\treturn body // 改写失败，原样返回\n628\t\t}\n629\t\treturn rewritten\n630\t}\n631\t\n632\t// injectThinkingContent 为 assistant tool_call 消息注入 reasoning_content 补丁。\n633\t//\n634\t// Kimi 等兼容 Anthropic 的端点要求：assistant tool_call 消息必须携带顶层字段 reasoning_content，\n635\t// 以及 content 数组中的 thinking 块。Claude Code 发送 tool_call 消息时不包含这些字段，导致上游 400 错误：\n636\t//\n637\t//\t400 thinking is enabled but reasoning_content is missing in assistant tool call message at index N\n638\t//\n639\t// 此函数对所有含 tool_use 的 assistant 消息无条件注入（空字符串无害，但能防止 Kimi 报错）。\n640\tfunc injectThinkingContent(body []byte, parsed any) []byte {\n641\t\tif len(body) == 0 {\n642\t\t\treturn body\n643\t\t}\n644\t\n645\t\tm, ok := parsed.(map[string]any)\n646\t\tif !ok {\n647\t\t\treturn body // 非 JSON 或非对象\n648\t\t}\n649\t\n650\t\t// 获取 messages 数组（无 messages 则无需处理）\n651\t\tmessages, ok := m[\"messages\"].([]any)\n652\t\tif !ok || len(messages) == 0 {\n653\t\t\treturn body\n654\t\t}\n655\t\n656\t\tmodified := false\n657\t\tfor i, msgRaw := range messages {\n658\t\t\tmsg, ok := msgRaw.(map[string]any)\n659\t\t\tif !ok {\n660\t\t\t\tcontinue\n661\t\t\t}\n662\t\n663\t\t\t// 只处理 assistant 消息\n664\t\t\trole, _ := msg[\"role\"].(string)\n665\t\t\tif role != \"assistant\" {\n666\t\t\t\tcontinue\n667\t\t\t}\n668\t\n669\t\t\t// 检查 content 是否为数组\n670\t\t\tcontent, ok := msg[\"content\"].([]any)\n671\t\t\tif !ok || len(content) == 0 {\n672\t\t\t\tcontinue\n673\t\t\t}\n674\t\n675\t\t\t// 检查是否有 tool_use 块、thinking 块、reasoning_content 字段\n676\t\t\thasToolUse := false\n677\t\t\thasThinking := false\n678\t\t\tfor _, blockRaw := range content {\n679\t\t\t\tblock, ok := blockRaw.(map[string]any)\n680\t\t\t\tif !ok {\n681\t\t\t\t\tcontinue\n682\t\t\t\t}\n683\t\t\t\tblockType, _ := block[\"type\"].(string)\n684\t\t\t\tif blockType == \"tool_use\" {\n685\t\t\t\t\thasToolUse = true\n686\t\t\t\t}\n687\t\t\t\tif blockType == \"thinking\" {\n688\t\t\t\t\thasThinking = true\n689\t\t\t\t}\n690\t\t\t}\n691\t\t\thasReasoningContent := false\n692\t\t\tif _, exists := msg[\"reasoning_content\"]; exists {\n693\t\t\t\thasReasoningContent = true\n694\t\t\t}\n695\t\n696\t\t\t// 只处理含 tool_use 且缺少必要字段的 assistant 消息\n697\t\t\tif !hasToolUse {\n698\t\t\t\tcontinue\n699\t\t\t}\n700\t\n701\t\t\tneedPatch := false\n702\t\n703\t\t\t// 补丁 1: content 数组缺少 thinking 块 → 在开头插入\n704\t\t\tif !hasThinking {\n705\t\t\t\tthinkingBlock := map[string]any{\n706\t\t\t\t\t\"type\":     \"thinking\",\n707\t\t\t\t\t\"thinking\": \"\",\n708\t\t\t\t}\n709\t\t\t\tnewContent := make([]any, 0, len(content)+1)\n710\t\t\t\tnewContent = append(newContent, thinkingBlock)\n711\t\t\t\tnewContent = append(newContent, content...)\n712\t\t\t\tmsg[\"content\"] = newContent\n713\t\t\t\tneedPatch = true\n714\t\t\t}\n715\t\n716\t\t\t// 补丁 2: 消息缺少顶层 reasoning_content 字段 → 注入空值\n717\t\t\tif !hasReasoningContent {\n718\t\t\t\tmsg[\"reasoning_content\"] = \"\"\n719\t\t\t\tneedPatch = true\n720\t\t\t}\n721\t\n722\t\t\tif needPatch {\n723\t\t\t\tmessages[i] = msg\n724\t\t\t\tmodified = true\n725\t\t\t}\n726\t\t}\n727\t\n728\t\tif !modified {\n729\t\t\treturn body\n730\t\t}\n731\t\n732\t\tm[\"messages\"] = messages\n733\t\trewritten, err := json.Marshal(m)\n734\t\tif err != nil {\n735\t\t\treturn body\n736\t\t}\n737\t\treturn rewritten\n738\t}\n739\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/proxy/thinking_inject_test.go"},"tool_use_id":"call_0e103eff960044c7910a0363","tool_response":"1\tpackage proxy\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"net/http/httptest\"\n9\t\t\"testing\"\n10\t)\n11\t\n12\t// TestInjectThinkingContent_Unit 直接测试 injectThinkingContent 函数的各种场景。\n13\tfunc TestInjectThinkingContent_Unit(t *testing.T) {\n14\t\ttests := []struct {\n15\t\t\tname     string\n16\t\t\treqBody  string\n17\t\t\twantSame bool // true = 输出应与输入完全一致\n18\t\t\twantLen  int  // 目标 assistant 消息的 content 数组期望长度\n19\t\t}{\n20\t\t\t{\n21\t\t\t\tname:     \"无 tool_use 的 assistant - 原样透传\",\n22\t\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}]}`,\n23\t\t\t\twantSame: true,\n24\t\t\t},\n25\t\t\t{\n26\t\t\t\tname:     \"tool_use 无 thinking - 注入\",\n27\t\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n28\t\t\t\twantSame: false,\n29\t\t\t\twantLen:  2,\n30\t\t\t},\n31\t\t\t{\n32\t\t\t\tname:     \"已有 thinking 块和 reasoning_content - 原样透传\",\n33\t\t\t\treqBody:  `{\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"reasoning\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}],\"reasoning_content\":\"reasoning\"}]}`,\n34\t\t\t\twantSame: true,\n35\t\t\t},\n36\t\t\t{\n37\t\t\t\tname:     \"空 body - 原样透传\",\n38\t\t\t\treqBody:  \"\",\n39\t\t\t\twantSame: true,\n40\t\t\t},\n41\t\t\t{\n42\t\t\t\tname:     \"非 JSON body - 原样透传\",\n43\t\t\t\treqBody:  \"this is not json\",\n44\t\t\t\twantSame: true,\n45\t\t\t},\n46\t\t\t{\n47\t\t\t\tname:     \"JSON 数组 body - 原样透传\",\n48\t\t\t\treqBody:  `[1,2,3]`,\n49\t\t\t\twantSame: true,\n50\t\t\t},\n51\t\t\t{\n52\t\t\t\tname:     \"纯 user 消息 - 原样透传\",\n53\t\t\t\treqBody:  `{\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}`,\n54\t\t\t\twantSame: true,\n55\t\t\t},\n56\t\t}\n57\t\n58\t\tfor _, tt := range tests {\n59\t\t\tt.Run(tt.name, func(t *testing.T) {\n60\t\t\t\tvar parsed any\n61\t\t\t\tif tt.reqBody != \"\" {\n62\t\t\t\t\t_ = json.Unmarshal([]byte(tt.reqBody), &parsed)\n63\t\t\t\t}\n64\t\t\t\tresult := injectThinkingContent([]byte(tt.reqBody), parsed)\n65\t\t\t\tif tt.wantSame {\n66\t\t\t\t\tif string(result) != tt.reqBody {\n67\t\t\t\t\t\tt.Errorf(\"expected passthrough, got: %s\", string(result))\n68\t\t\t\t\t}\n69\t\t\t\t} else {\n70\t\t\t\t\tvar m map[string]any\n71\t\t\t\t\tif err := json.Unmarshal(result, &m); err != nil {\n72\t\t\t\t\t\tt.Fatalf(\"result is not valid JSON: %v\", err)\n73\t\t\t\t\t}\n74\t\t\t\t\tmsgs := m[\"messages\"].([]any)\n75\t\t\t\t\tmsg := msgs[0].(map[string]any)\n76\t\t\t\t\tcontent := msg[\"content\"].([]any)\n77\t\t\t\t\tif len(content) != tt.wantLen {\n78\t\t\t\t\t\tt.Errorf(\"content length = %d, want %d\", len(content), tt.wantLen)\n79\t\t\t\t\t}\n80\t\t\t\t\t// 验证注入的 thinking 块在第一位\n81\t\t\t\t\tfirst := content[0].(map[string]any)\n82\t\t\t\t\tif first[\"type\"] != \"thinking\" {\n83\t\t\t\t\t\tt.Errorf(\"first block type = %q, want %q\", first[\"type\"], \"thinking\")\n84\t\t\t\t\t}\n85\t\t\t\t\t// 验证顶层 reasoning_content 字段被注入\n86\t\t\t\t\tif rc, ok := msg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n87\t\t\t\t\t\tt.Errorf(\"reasoning_content = %v, want empty string\", msg[\"reasoning_content\"])\n88\t\t\t\t\t}\n89\t\t\t\t}\n90\t\t\t})\n91\t\t}\n92\t}\n93\t\n94\t// TestInjectThinkingContent_MixedMessages 测试混合消息场景：只有 tool_call 消息被注入。\n95\tfunc TestInjectThinkingContent_MixedMessages(t *testing.T) {\n96\t\treqBody := `{\n97\t\t\t\"messages\": [\n98\t\t\t\t{\"role\": \"user\", \"content\": \"read the file\"},\n99\t\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"sure\"}]},\n100\t\t\t\t{\"role\": \"user\", \"content\": \"do it\"},\n101\t\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"tool_use\", \"id\": \"t1\", \"name\": \"Read\", \"input\": {\"file\": \"/tmp/x\"}}]},\n102\t\t\t\t{\"role\": \"user\", \"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"t1\", \"content\": \"file data\"}]},\n103\t\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"thinking\", \"thinking\":\"let me think\"},{\"type\": \"tool_use\", \"id\": \"t2\", \"name\": \"Bash\", \"input\": {\"cmd\": \"ls\"}}]}\n104\t\t\t]\n105\t\t}`\n106\t\n107\t\tvar parsed any\n108\t\t_ = json.Unmarshal([]byte(reqBody), &parsed)\n109\t\tresult := injectThinkingContent([]byte(reqBody), parsed)\n110\t\n111\t\tvar m map[string]any\n112\t\tif err := json.Unmarshal(result, &m); err != nil {\n113\t\t\tt.Fatalf(\"parse result: %v\", err)\n114\t\t}\n115\t\tmsgs := m[\"messages\"].([]any)\n116\t\n117\t\t// user 消息不变\n118\t\tif msgs[0].(map[string]any)[\"role\"] != \"user\" {\n119\t\t\tt.Error(\"msg[0] should be user\")\n120\t\t}\n121\t\n122\t\t// 纯文本 assistant (msg[1]) 不变\n123\t\tassistantText := msgs[1].(map[string]any)[\"content\"].([]any)\n124\t\tif len(assistantText) != 1 {\n125\t\t\tt.Errorf(\"assistant text content length = %d, want 1\", len(assistantText))\n126\t\t}\n127\t\n128\t\t// tool_call 无 thinking (msg[3]) → 注入 thinking 块 + reasoning_content\n129\t\tassistantTool := msgs[3].(map[string]any)\n130\t\tcontent := assistantTool[\"content\"].([]any)\n131\t\tif len(content) != 2 {\n132\t\t\tt.Errorf(\"assistant tool content length = %d, want 2 (thinking + tool_use)\", len(content))\n133\t\t}\n134\t\tif content[0].(map[string]any)[\"type\"] != \"thinking\" {\n135\t\t\tt.Error(\"first block should be thinking\")\n136\t\t}\n137\t\tif content[1].(map[string]any)[\"type\"] != \"tool_use\" {\n138\t\t\tt.Error(\"second block should be tool_use\")\n139\t\t}\n140\t\tif rc, ok := assistantTool[\"reasoning_content\"].(string); !ok || rc != \"\" {\n141\t\t\tt.Errorf(\"msg[3] reasoning_content = %v, want empty string\", assistantTool[\"reasoning_content\"])\n142\t\t}\n143\t\n144\t\t// 已有 thinking 的 tool_call (msg[5]) → 不重复注入 thinking 块，但仍注入 reasoning_content（如果缺失）\n145\t\tassistantWithThinking := msgs[5].(map[string]any)\n146\t\tthinkingContent := assistantWithThinking[\"content\"].([]any)\n147\t\tif len(thinkingContent) != 2 {\n148\t\t\tt.Errorf(\"assistant with thinking content length = %d, want 2 (no duplicate)\", len(thinkingContent))\n149\t\t}\n150\t\tif rc, ok := assistantWithThinking[\"reasoning_content\"].(string); !ok || rc != \"\" {\n151\t\t\tt.Errorf(\"msg[5] reasoning_content = %v, want empty string\", assistantWithThinking[\"reasoning_content\"])\n152\t\t}\n153\t}\n154\t\n155\t// TestInjectThinkingContent_Integration 通过完整代理链路测试，验证上游收到注入后的请求体。\n156\tfunc TestInjectThinkingContent_Integration(t *testing.T) {\n157\t\tvar capturedBody []byte\n158\t\tmockUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n159\t\t\tcapturedBody, _ = io.ReadAll(r.Body)\n160\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n161\t\t\tw.WriteHeader(http.StatusOK)\n162\t\t\tw.Write([]byte(`{\"id\":\"msg_test\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"model\":\"test\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}`))\n163\t\t}))\n164\t\tdefer mockUpstream.Close()\n165\t\n166\t\ttraceDir := t.TempDir()\n167\t\trp := NewReverseProxy(mockUpstream.URL, traceDir)\n168\t\trp.model = \"kimi-for-coding\"\n169\t\n170\t\t_, err := rp.Start(\"127.0.0.1\", 0)\n171\t\tif err != nil {\n172\t\t\tt.Fatalf(\"start proxy: %v\", err)\n173\t\t}\n174\t\tdefer rp.Stop()\n175\t\n176\t\t// 模拟 Kimi 场景：无 thinking 字段，但有 tool_call 消息\n177\t\treqBody := map[string]any{\n178\t\t\t\"model\":  \"kimi-for-coding\",\n179\t\t\t\"stream\": true,\n180\t\t\t\"messages\": []any{\n181\t\t\t\tmap[string]any{\"role\": \"user\", \"content\": \"read the file\"},\n182\t\t\t\tmap[string]any{\n183\t\t\t\t\t\"role\": \"assistant\",\n184\t\t\t\t\t\"content\": []any{\n185\t\t\t\t\t\tmap[string]any{\n186\t\t\t\t\t\t\t\"type\":  \"tool_use\",\n187\t\t\t\t\t\t\t\"id\":    \"toolu_123\",\n188\t\t\t\t\t\t\t\"name\":  \"Read\",\n189\t\t\t\t\t\t\t\"input\": map[string]any{\"file_path\": \"/tmp/test.txt\"},\n190\t\t\t\t\t\t},\n191\t\t\t\t\t},\n192\t\t\t\t},\n193\t\t\t\tmap[string]any{\n194\t\t\t\t\t\"role\": \"user\",\n195\t\t\t\t\t\"content\": []any{\n196\t\t\t\t\t\tmap[string]any{\n197\t\t\t\t\t\t\t\"type\":        \"tool_result\",\n198\t\t\t\t\t\t\t\"tool_use_id\": \"toolu_123\",\n199\t\t\t\t\t\t\t\"content\":     \"file contents\",\n200\t\t\t\t\t\t},\n201\t\t\t\t\t},\n202\t\t\t\t},\n203\t\t\t},\n204\t\t}\n205\t\tbodyBytes, _ := json.Marshal(reqBody)\n206\t\n207\t\treq, _ := http.NewRequest(\"POST\", rp.URL()+\"/v1/messages\", bytes.NewReader(bodyBytes))\n208\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n209\t\n210\t\tresp, err := http.DefaultClient.Do(req)\n211\t\tif err != nil {\n212\t\t\tt.Fatalf(\"send request: %v\", err)\n213\t\t}\n214\t\tresp.Body.Close()\n215\t\n216\t\t// 验证上游收到的请求体\n217\t\tvar upstreamBody map[string]any\n218\t\tif err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {\n219\t\t\tt.Fatalf(\"parse upstream body: %v\", err)\n220\t\t}\n221\t\n222\t\t// model 被改写为 kimi-for-coding\n223\t\tif m, _ := upstreamBody[\"model\"].(string); m != \"kimi-for-coding\" {\n224\t\t\tt.Errorf(\"model = %q, want %q\", m, \"kimi-for-coding\")\n225\t\t}\n226\t\n227\t\t// assistant 消息被注入 thinking 块 + reasoning_content\n228\t\tmessages := upstreamBody[\"messages\"].([]any)\n229\t\tassistantMsg := messages[1].(map[string]any)\n230\t\tcontent := assistantMsg[\"content\"].([]any)\n231\t\n232\t\tif len(content) != 2 {\n233\t\t\tt.Fatalf(\"assistant content blocks = %d, want 2\", len(content))\n234\t\t}\n235\t\n236\t\t// thinking 块在第一位\n237\t\tfirstBlock := content[0].(map[string]any)\n238\t\tif firstBlock[\"type\"] != \"thinking\" {\n239\t\t\tt.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")\n240\t\t}\n241\t\n242\t\t// 顶层 reasoning_content 被注入\n243\t\tif rc, ok := assistantMsg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n244\t\t\tt.Errorf(\"reasoning_content = %v, want empty string\", assistantMsg[\"reasoning_content\"])\n245\t\t}\n246\t\n247\t\t// 原 tool_use 块保持不变\n248\t\tsecondBlock := content[1].(map[string]any)\n249\t\tif secondBlock[\"type\"] != \"tool_use\" {\n250\t\t\tt.Errorf(\"second block type = %q, want %q\", secondBlock[\"type\"], \"tool_use\")\n251\t\t}\n252\t}\n253\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/sse/reassembler.go"},"tool_use_id":"call_66dc277a2abe4e269f373024","tool_response":"1\tpackage sse\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/usage\"\n11\t)\n12\t\n13\t// SSEReassembler 解析原始 SSE（Server-Sent Events）字节流，并将流式片段重组成完整的 API 响应。\n14\t//\n15\t// 支持的协议：\n16\t//   - Anthropic Messages API Streaming\n17\t//   - OpenAI Chat Completions Streaming\n18\t//   - OpenAI Responses API Streaming\n19\t//\n20\t// 使用方式：\n21\t//\n22\t//\tr := sse.NewSSEReassembler()\n23\t//\tr.FeedBytes(chunk)       // 多次调用，分块送入 SSE 数据\n24\t//\tsnapshot := r.Reconstruct() // 获取当前累积的完整响应快照\n25\t//\tevents := r.Events       // 获取所有解析出的原始事件列表\n26\ttype SSEReassembler struct {\n27\t\tEvents   []map[string]any // 解析出的所有原始 SSE 事件列表\n28\t\tbuf      []byte           // 未处理完的 SSE 字节缓冲区\n29\t\tcurEv    *string          // 当前正在解析的事件类型（event: xxx）\n30\t\tcurData  []string         // 当前事件的 data 行累积（支持多行 data）\n31\t\tsnap     map[string]any   // 重建后的完整响应快照\n32\t\tfedOnce  bool             // 是否已接收过首块数据（用于首次日志）\n33\t}\n34\t\n35\t// NewSSEReassembler 创建一个新的 SSE 重组器实例。\n36\tfunc NewSSEReassembler() *SSEReassembler {\n37\t\treturn &SSEReassembler{}\n38\t}\n39\t\n40\t// FeedBytes 追加原始 SSE 字节数据并处理已完整的行。\n41\t//\n42\t// 该方法按 \\n 分割输入数据，逐行解析 SSE 协议中的 event、data 字段，\n43\t// 遇到空行时触发事件生成并调用累积逻辑更新快照。\n44\t// 可以多次调用以处理分块传输的数据。\n45\tfunc (r *SSEReassembler) FeedBytes(chunk []byte) {\n46\t\tif !r.fedOnce {\n47\t\t\tlogger.Debug(\"sse\", \"FeedBytes: first chunk size=%d\", len(chunk))\n48\t\t\tr.fedOnce = true\n49\t\t}\n50\t\tr.buf = append(r.buf, chunk...)\n51\t\tfor {\n52\t\t\tidx := bytes.IndexByte(r.buf, '\\n')\n53\t\t\tif idx < 0 {\n54\t\t\t\tbreak\n55\t\t\t}\n56\t\t\tline := r.buf[:idx]\n57\t\t\tr.buf = r.buf[idx+1:]\n58\t\t\tr.feedLine(string(line))\n59\t\t}\n60\t}\n61\t\n62\t// Reconstruct 返回当前累积的消息快照。\n63\t//\n64\t// 如果尚未收到足够的事件来构建快照（如仅收到部分 SSE 帧），则返回 nil。\n65\tfunc (r *SSEReassembler) Reconstruct() map[string]any {\n66\t\treturn r.snap\n67\t}\n68\t\n69\t// feedLine 处理单条 SSE 文本行，解析 event、data 和空行分隔符。\n70\t//\n71\t// SSE 协议规则：\n72\t//   - 以 \"event:\" 开头的行设置当前事件类型\n73\t//   - 以 \"data:\" 开头的行追加到当前事件的数据 payload\n74\t//   - 空行表示当前事件结束，触发事件生成\n75\t//   - \"[DONE]\" 是 OpenAI 的流结束标记，直接忽略\n76\tfunc (r *SSEReassembler) feedLine(line string) {\n77\t\tline = strings.TrimRight(line, \"\\r\")\n78\t\n79\t\tif strings.HasPrefix(line, \"event:\") {\n80\t\t\tev := strings.TrimSpace(line[len(\"event:\"):])\n81\t\t\tr.curEv = &ev\n82\t\t\tr.curData = nil\n83\t\t} else if strings.HasPrefix(line, \"data:\") {\n84\t\t\tr.curData = append(r.curData, strings.TrimSpace(line[len(\"data:\"):]))\n85\t\t} else if line == \"\" {\n86\t\t\t// 空行触发事件：如果既没有 event 也没有 data 则跳过\n87\t\t\tif r.curEv == nil && len(r.curData) == 0 {\n88\t\t\t\treturn\n89\t\t\t}\n90\t\t\traw := strings.Join(r.curData, \"\\n\")\n91\t\n92\t\t\t// 跳过 OpenAI 的 [DONE] 哨兵标记\n93\t\t\tif raw == \"[DONE]\" && r.curEv == nil {\n94\t\t\t\tr.curEv = nil\n95\t\t\t\tr.curData = nil\n96\t\t\t\treturn\n97\t\t\t}\n98\t\n99\t\t\tvar data any\n100\t\t\tif err := json.Unmarshal([]byte(raw), &data); err != nil {\n101\t\t\t\tdata = raw\n102\t\t\t}\n103\t\n104\t\t\tevType := \"message\"\n105\t\t\tif r.curEv != nil {\n106\t\t\t\tevType = *r.curEv\n107\t\t\t}\n108\t\t\tr.addEvent(evType, data)\n109\t\t\tr.curEv = nil\n110\t\t\tr.curData = nil\n111\t\t}\n112\t}\n113\t\n114\t// addEvent 将解析出的单个 SSE 事件追加到事件列表，并触发累积更新。\n115\tfunc (r *SSEReassembler) addEvent(eventType string, data any) {\n116\t\tr.Events = append(r.Events, map[string]any{\"event\": eventType, \"data\": data})\n117\t\tr.accumulate(eventType, data)\n118\t}\n119\t\n120\t// accumulate 按事件类型将流式片段累积到响应快照中。\n121\t//\n122\t// 支持的事件类型及处理逻辑：\n123\t//   - message_start:      初始化快照为 message 对象\n124\t//   - response.created/completed/done: OpenAI Responses API，初始化或更新快照\n125\t//   - message:            OpenAI Chat Completions 流，调用 accumulateChatCompletionChunk\n126\t//   - content_block_start: 向快照 content 数组添加新的内容块\n127\t//   - content_block_delta: 更新指定索引的内容块（文本、推理、JSON 片段）\n128\t//   - content_block_stop:  将累积的 partial_json 解析为 input 字段\n129\t//   - message_delta:       更新 message 级别的 delta（如 stop_reason）和 usage\n130\tfunc (r *SSEReassembler) accumulate(eventType string, data any) {\n131\t\tm, ok := data.(map[string]any)\n132\t\tif !ok {\n133\t\t\treturn\n134\t\t}\n135\t\n136\t\tswitch eventType {\n137\t\tcase \"message_start\":\n138\t\t\tif msg, ok := m[\"message\"].(map[string]any); ok {\n139\t\t\t\tr.snap = deepCopy(msg)\n140\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_start, model=%v\", msg[\"model\"])\n141\t\t\t}\n142\t\n143\t\tcase \"response.created\", \"response.completed\", \"response.done\":\n144\t\t\tif resp, ok := m[\"response\"].(map[string]any); ok {\n145\t\t\t\tr.snap = deepCopy(resp)\n146\t\t\t} else if eventType == \"response.completed\" || eventType == \"response.done\" {\n147\t\t\t\tr.snap = deepCopy(m)\n148\t\t\t}\n149\t\n150\t\tcase \"message\":\n151\t\t\tif _, hasChoices := m[\"choices\"]; hasChoices {\n152\t\t\t\tr.accumulateChatCompletionChunk(m)\n153\t\t\t\treturn\n154\t\t\t}\n155\t\n156\t\tcase \"content_block_start\":\n157\t\t\tif r.snap == nil {\n158\t\t\t\treturn\n159\t\t\t}\n160\t\t\tblock := deepCopy(m[\"content_block\"].(map[string]any))\n161\t\t\tidx := int(float64Val(m[\"index\"]))\n162\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_start idx=%d type=%v\", idx, block[\"type\"])\n163\t\t\tif _, ok := r.snap[\"content\"]; !ok {\n164\t\t\t\tr.snap[\"content\"] = []any{}\n165\t\t\t}\n166\t\t\tcontent := r.snap[\"content\"].([]any)\n167\t\t\tfor len(content) <= idx {\n168\t\t\t\tcontent = append(content, map[string]any{})\n169\t\t\t}\n170\t\t\tcontent[idx] = block\n171\t\t\tr.snap[\"content\"] = content\n172\t\n173\t\tcase \"content_block_delta\":\n174\t\t\tif r.snap == nil {\n175\t\t\t\treturn\n176\t\t\t}\n177\t\t\tidx := int(float64Val(m[\"index\"]))\n178\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n179\t\t\tif delta == nil {\n180\t\t\t\treturn\n181\t\t\t}\n182\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n183\t\t\tif idx >= len(content) {\n184\t\t\t\treturn\n185\t\t\t}\n186\t\t\tblock, _ := content[idx].(map[string]any)\n187\t\t\tif block == nil {\n188\t\t\t\treturn\n189\t\t\t}\n190\t\t\tswitch delta[\"type\"] {\n191\t\t\tcase \"text_delta\":\n192\t\t\t\tblock[\"text\"] = strVal(block[\"text\"]) + strVal(delta[\"text\"])\n193\t\t\tcase \"thinking_delta\":\n194\t\t\t\tblock[\"thinking\"] = strVal(block[\"thinking\"]) + strVal(delta[\"thinking\"])\n195\t\t\tcase \"input_json_delta\":\n196\t\t\t\tblock[\"_partial_json\"] = strVal(block[\"_partial_json\"]) + strVal(delta[\"partial_json\"])\n197\t\t\t}\n198\t\n199\t\tcase \"content_block_stop\":\n200\t\t\tif r.snap == nil {\n201\t\t\t\treturn\n202\t\t\t}\n203\t\t\tidx := int(float64Val(m[\"index\"]))\n204\t\t\tcontent, _ := r.snap[\"content\"].([]any)\n205\t\t\tif idx >= len(content) {\n206\t\t\t\treturn\n207\t\t\t}\n208\t\t\tblock, _ := content[idx].(map[string]any)\n209\t\t\tif block == nil {\n210\t\t\t\treturn\n211\t\t\t}\n212\t\t\t// 将累积的 JSON 字符串片段解析为结构化的 input 字段\n213\t\t\tif pj, ok := block[\"_partial_json\"]; ok {\n214\t\t\t\tvar parsed any\n215\t\t\t\tif json.Unmarshal([]byte(strVal(pj)), &parsed) == nil {\n216\t\t\t\t\tblock[\"input\"] = parsed\n217\t\t\t\t}\n218\t\t\t\tdelete(block, \"_partial_json\")\n219\t\t\t}\n220\t\t\tlogger.Debug(\"sse\", \"accumulate: content_block_stop idx=%d\", idx)\n221\t\n222\t\tcase \"message_delta\":\n223\t\t\tif r.snap == nil {\n224\t\t\t\treturn\n225\t\t\t}\n226\t\t\tdelta, _ := m[\"delta\"].(map[string]any)\n227\t\t\tif delta != nil {\n228\t\t\t\tfor k, v := range delta {\n229\t\t\t\t\tr.snap[k] = v\n230\t\t\t\t}\n231\t\t\t}\n232\t\t\tif u, ok := m[\"usage\"].(map[string]any); ok {\n233\t\t\t\tif _, exists := r.snap[\"usage\"]; !exists {\n234\t\t\t\t\tr.snap[\"usage\"] = map[string]any{}\n235\t\t\t\t}\n236\t\t\t\texisting := r.snap[\"usage\"].(map[string]any)\n237\t\t\t\tfor k, v := range u {\n238\t\t\t\t\texisting[k] = v\n239\t\t\t\t}\n240\t\t\t}\n241\t\t\tif delta != nil {\n242\t\t\t\tif sr, ok := delta[\"stop_reason\"]; ok && sr != nil {\n243\t\t\t\t\tlogger.Debug(\"sse\", \"accumulate: message_delta stop_reason=%v\", sr)\n244\t\t\t\t}\n245\t\t\t}\n246\t\t}\n247\t}\n248\t\n249\t// --- OpenAI Chat Completions 流式累积 ---\n250\t\n251\t// accumulateChatCompletionChunk 处理 OpenAI Chat Completions Streaming 的单个 chunk。\n252\t//\n253\t// 该函数将 choices[0].delta 中的内容逐块累积，同时处理：\n254\t//   - role、content、reasoning_content 的拼接\n255\t//   - tool_calls 的渐进式构建（id、name、arguments 分块到达）\n256\t//   - usage 信息的合并\n257\t//   - finish_reason 的更新\n258\t//\n259\t// 快照结构兼容 Anthropic 格式，content 数组中会同时维护文本块和工具调用块。\n260\tfunc (r *SSEReassembler) accumulateChatCompletionChunk(data map[string]any) {\n261\t\tchoices, _ := data[\"choices\"].([]any)\n262\t\trawUsage, _ := data[\"usage\"]\n263\t\n264\t\tif len(choices) == 0 {\n265\t\t\tif u, ok := rawUsage.(map[string]any); ok && r.snap != nil {\n266\t\t\t\tr.mergeChatUsage(u)\n267\t\t\t}\n268\t\t\treturn\n269\t\t}\n270\t\n271\t\tchoice, _ := choices[0].(map[string]any)\n272\t\tif choice == nil {\n273\t\t\treturn\n274\t\t}\n275\t\tdelta, _ := choice[\"delta\"].(map[string]any)\n276\t\tfinishReason := choice[\"finish_reason\"]\n277\t\tchoiceUsage, _ := choice[\"usage\"].(map[string]any)\n278\t\n279\t\t// 首个 chunk 时初始化快照\n280\t\tif r.snap == nil {\n281\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk init, model=%s\", strVal(data[\"model\"]))\n282\t\t\tr.snap = map[string]any{\n283\t\t\t\t\"id\":     strVal(data[\"id\"]),\n284\t\t\t\t\"object\": \"chat.completion\",\n285\t\t\t\t\"model\":  strVal(data[\"model\"]),\n286\t\t\t\t\"choices\": []any{\n287\t\t\t\t\tmap[string]any{\n288\t\t\t\t\t\t\"index\":         0,\n289\t\t\t\t\t\t\"message\":       map[string]any{\"role\": strVal(fieldStr(delta, \"role\")), \"content\": \"\"},\n290\t\t\t\t\t\t\"finish_reason\": nil,\n291\t\t\t\t\t},\n292\t\t\t\t},\n293\t\t\t\t\"content\": []any{map[string]any{\"type\": \"text\", \"text\": \"\"}},\n294\t\t\t}\n295\t\t\tif role := strVal(fieldStr(delta, \"role\")); role == \"\" {\n296\t\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)[\"role\"] = \"assistant\"\n297\t\t\t}\n298\t\t}\n299\t\n300\t\tmsg := r.snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n301\t\ttextBlock := r.chatTextBlock()\n302\t\n303\t\tif role := strVal(fieldStr(delta, \"role\")); role != \"\" {\n304\t\t\tmsg[\"role\"] = role\n305\t\t}\n306\t\tif rc := strVal(fieldStr(delta, \"reasoning_content\")); rc != \"\" {\n307\t\t\tmsg[\"reasoning_content\"] = strVal(msg[\"reasoning_content\"]) + rc\n308\t\t\tr.mirrorReasoning(strVal(msg[\"reasoning_content\"]))\n309\t\t}\n310\t\tif c := strVal(fieldStr(delta, \"content\")); c != \"\" {\n311\t\t\tmsg[\"content\"] = strVal(msg[\"content\"]) + c\n312\t\t\ttextBlock[\"text\"] = strVal(textBlock[\"text\"]) + c\n313\t\t}\n314\t\n315\t\t// 工具调用增量处理\n316\t\tfor _, tcRaw := range sliceField(delta, \"tool_calls\") {\n317\t\t\ttcDelta, _ := tcRaw.(map[string]any)\n318\t\t\tif tcDelta == nil {\n319\t\t\t\tcontinue\n320\t\t\t}\n321\t\t\tidx := int(float64Val(tcDelta[\"index\"]))\n322\t\t\ttoolCalls, _ := msg[\"tool_calls\"].([]any)\n323\t\t\tif toolCalls == nil {\n324\t\t\t\ttoolCalls = []any{}\n325\t\t\t}\n326\t\t\tfor len(toolCalls) <= idx {\n327\t\t\t\ttoolCalls = append(toolCalls, map[string]any{\n328\t\t\t\t\t\"id\":   \"\",\n329\t\t\t\t\t\"type\": \"function\",\n330\t\t\t\t\t\"function\": map[string]any{\n331\t\t\t\t\t\t\"name\":      \"\",\n332\t\t\t\t\t\t\"arguments\": \"\",\n333\t\t\t\t\t},\n334\t\t\t\t})\n335\t\t\t}\n336\t\t\texisting := toolCalls[idx].(map[string]any)\n337\t\t\tif id := strVal(tcDelta[\"id\"]); id != \"\" {\n338\t\t\t\texisting[\"id\"] = id\n339\t\t\t}\n340\t\t\tif t := strVal(tcDelta[\"type\"]); t != \"\" {\n341\t\t\t\texisting[\"type\"] = t\n342\t\t\t}\n343\t\t\tif fnDelta, ok := tcDelta[\"function\"].(map[string]any); ok {\n344\t\t\t\tfn, _ := existing[\"function\"].(map[string]any)\n345\t\t\t\tif fn == nil {\n346\t\t\t\t\tfn = map[string]any{\"name\": \"\", \"arguments\": \"\"}\n347\t\t\t\t}\n348\t\t\t\tif n := strVal(fnDelta[\"name\"]); n != \"\" {\n349\t\t\t\t\tfn[\"name\"] = strVal(fn[\"name\"]) + n\n350\t\t\t\t}\n351\t\t\t\tif a := strVal(fnDelta[\"arguments\"]); a != \"\" {\n352\t\t\t\t\tfn[\"arguments\"] = strVal(fn[\"arguments\"]) + a\n353\t\t\t\t}\n354\t\t\t\texisting[\"function\"] = fn\n355\t\t\t}\n356\t\t\ttoolCalls[idx] = existing\n357\t\t\tmsg[\"tool_calls\"] = toolCalls\n358\t\t\tr.mirrorToolCall(idx, existing)\n359\t\t}\n360\t\n361\t\tif finishReason != nil && finishReason != \"\" {\n362\t\t\tr.snap[\"choices\"].([]any)[0].(map[string]any)[\"finish_reason\"] = finishReason\n363\t\t\tlogger.Debug(\"sse\", \"accumulate: chat chunk finish_reason=%v\", finishReason)\n364\t\t}\n365\t\n366\t\tif u, ok := rawUsage.(map[string]any); ok {\n367\t\t\tr.mergeChatUsage(u)\n368\t\t}\n369\t\tif choiceUsage != nil {\n370\t\t\tr.mergeChatUsage(choiceUsage)\n371\t\t}\n372\t}\n373\t\n374\t// chatTextBlock 获取或创建快照中的文本内容块。\n375\t// 返回 content 数组中第一个 type=\"text\" 的块；如果不存在则新建一个。\n376\tfunc (r *SSEReassembler) chatTextBlock() map[string]any {\n377\t\tcontent := r.snap[\"content\"].([]any)\n378\t\tfor _, b := range content {\n379\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"text\" {\n380\t\t\t\treturn block\n381\t\t\t}\n382\t\t}\n383\t\tblock := map[string]any{\"type\": \"text\", \"text\": \"\"}\n384\t\tr.snap[\"content\"] = append(content, block)\n385\t\treturn block\n386\t}\n387\t\n388\t// mirrorReasoning 将 reasoning_content 同步到 content 数组中的 thinking 块。\n389\t// 如果 content 中不存在 thinking 块，则在开头插入一个。\n390\tfunc (r *SSEReassembler) mirrorReasoning(reasoning string) {\n391\t\tcontent := r.snap[\"content\"].([]any)\n392\t\tfor _, b := range content {\n393\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n394\t\t\t\tblock[\"thinking\"] = reasoning\n395\t\t\t\treturn\n396\t\t\t}\n397\t\t}\n398\t\tblock := map[string]any{\"type\": \"thinking\", \"thinking\": reasoning}\n399\t\tr.snap[\"content\"] = append([]any{block}, content...)\n400\t}\n401\t\n402\t// mirrorToolCall 将 Chat Completions 的 tool_call 同步到 Anthropic 格式的 content 数组中。\n403\t//\n404\t// 同步规则：\n405\t//   - 在 content 数组中查找或创建对应的 tool_use 块\n406\t//   - 将 function name 映射为 tool_use 的 name\n407\t//   - 将 arguments JSON 解析后映射为 tool_use 的 input\n408\t//   - thinking 块的存在会影响工具调用块在 content 中的索引偏移\n409\tfunc (r *SSEReassembler) mirrorToolCall(idx int, tc map[string]any) {\n410\t\tcontent := r.snap[\"content\"].([]any)\n411\t\t// 如果存在 thinking 块，工具调用的位置需要偏移 1\n412\t\toffset := 1\n413\t\tfor _, b := range content {\n414\t\t\tif block, ok := b.(map[string]any); ok && block[\"type\"] == \"thinking\" {\n415\t\t\t\toffset = 2\n416\t\t\t\tbreak\n417\t\t\t}\n418\t\t}\n419\t\ttarget := idx + offset\n420\t\tfor len(content) <= target {\n421\t\t\tcontent = append(content, map[string]any{\"type\": \"tool_use\", \"id\": \"\", \"name\": \"\", \"input\": map[string]any{}})\n422\t\t}\n423\t\tblock := content[target].(map[string]any)\n424\t\tif id := strVal(tc[\"id\"]); id != \"\" {\n425\t\t\tblock[\"id\"] = id\n426\t\t}\n427\t\tif fn, ok := tc[\"function\"].(map[string]any); ok {\n428\t\t\tif n := strVal(fn[\"name\"]); n != \"\" {\n429\t\t\t\tblock[\"name\"] = n\n430\t\t\t}\n431\t\t\tif args := strVal(fn[\"arguments\"]); args != \"\" {\n432\t\t\t\tvar parsed any\n433\t\t\t\tif json.Unmarshal([]byte(args), &parsed) == nil {\n434\t\t\t\t\tblock[\"input\"] = parsed\n435\t\t\t\t}\n436\t\t\t}\n437\t\t}\n438\t\tr.snap[\"content\"] = content\n439\t}\n440\t\n441\t// mergeChatUsage 将 OpenAI Chat Completions 的 usage 数据标准化后合并到快照。\n442\tfunc (r *SSEReassembler) mergeChatUsage(u map[string]any) {\n443\t\tr.snap[\"usage\"] = usage.NormalizeUsage(u)\n444\t}\n445\t\n446\t// --- 辅助函数 ---\n447\t\n448\t// deepCopy 通过 JSON 序列化/反序列化实现 map 的深拷贝。\n449\tfunc deepCopy(m map[string]any) map[string]any {\n450\t\tif m == nil {\n451\t\t\treturn nil\n452\t\t}\n453\t\tdata, _ := json.Marshal(m)\n454\t\tresult := make(map[string]any)\n455\t\t_ = json.Unmarshal(data, &result)\n456\t\treturn result\n457\t}\n458\t\n459\t// float64Val 将任意数值类型转换为 float64。\n460\t// 支持 float64、int、int64；不支持的类型返回 0。\n461\tfunc float64Val(v any) float64 {\n462\t\tswitch n := v.(type) {\n463\t\tcase float64:\n464\t\t\treturn n\n465\t\tcase int:\n466\t\t\treturn float64(n)\n467\t\tcase int64:\n468\t\t\treturn float64(n)\n469\t\t}\n470\t\treturn 0\n471\t}\n472\t\n473\t// strVal 将任意值转换为字符串。\n474\t// nil 返回空字符串，string 类型直接返回，其他类型使用 fmt.Sprintf 格式化。\n475\tfunc strVal(v any) string {\n476\t\tif v == nil {\n477\t\t\treturn \"\"\n478\t\t}\n479\t\tif s, ok := v.(string); ok {\n480\t\t\treturn s\n481\t\t}\n482\t\treturn fmt.Sprintf(\"%v\", v)\n483\t}\n484\t\n485\t// fieldStr 从 map 中安全获取字段值。\n486\tfunc fieldStr(m map[string]any, key string) any {\n487\t\tv, _ := m[key]\n488\t\treturn v\n489\t}\n490\t\n491\t// sliceField 从 map 中获取 []any 类型的字段，如果不存在或类型不匹配则返回 nil。\n492\tfunc sliceField(m map[string]any, key string) []any {\n493\t\tv, _ := m[key].([]any)\n494\t\tif v == nil {\n495\t\t\treturn nil\n496\t\t}\n497\t\treturn v\n498\t}\n499\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/sse/types.go"},"tool_use_id":"call_cd2a926e81f84248be838a2a","tool_response":"1\tpackage sse\n2\t\n3\t// AnthropicContentBlock 表示 Anthropic API 响应中的内容块。\n4\t//\n5\t// 支持的类型（Type 字段）：\n6\t//   - \"text\":        普通文本内容\n7\t//   - \"thinking\":    模型推理/思考内容\n8\t//   - \"tool_use\":    工具调用请求\n9\t//   - \"tool_result\": 工具调用结果\n10\ttype AnthropicContentBlock struct {\n11\t\tType      string `json:\"type\"`                  // 内容块类型\n12\t\tText      string `json:\"text,omitempty\"`        // 文本内容（type=\"text\" 时使用）\n13\t\tThinking  string `json:\"thinking,omitempty\"`    // 推理内容（type=\"thinking\" 时使用）\n14\t\tID        string `json:\"id,omitempty\"`          // 工具调用标识（type=\"tool_use\" / \"tool_result\" 时使用）\n15\t\tName      string `json:\"name,omitempty\"`        // 工具名称（type=\"tool_use\" 时使用）\n16\t\tInput     any    `json:\"input,omitempty\"`       // 工具输入参数（type=\"tool_use\" 时使用）\n17\t\tContent   any    `json:\"content,omitempty\"`     // 工具结果内容（type=\"tool_result\" 时使用）\n18\t\tToolUseID string `json:\"tool_use_id,omitempty\"` // 关联的工具调用 ID（type=\"tool_result\" 时使用）\n19\t\tSignature string `json:\"signature,omitempty\"`   // 推理块的签名（用于 thinking 块验证）\n20\t}\n21\t\n22\t// AnthropicUsage 表示 Anthropic API 响应中的 Token 用量统计。\n23\ttype AnthropicUsage struct {\n24\t\tInputTokens              int64 `json:\"input_tokens\"`                          // 输入 Token 数量\n25\t\tOutputTokens             int64 `json:\"output_tokens\"`                         // 输出 Token 数量\n26\t\tCacheReadInputTokens     int64 `json:\"cache_read_input_tokens,omitempty\"`     // 缓存读取的输入 Token（可选）\n27\t\tCacheCreationInputTokens int64 `json:\"cache_creation_input_tokens,omitempty\"` // 缓存创建的输入 Token（可选）\n28\t}\n29\t\n30\t// AnthropicMessage 是重建后的 Anthropic Messages API 完整响应结构。\n31\t//\n32\t// 该结构体由 SSEReassembler 将流式 SSE 事件逐块累积后组装而成，\n33\t// 其数据形状与非流式的 Messages API 响应保持一致。\n34\ttype AnthropicMessage struct {\n35\t\tID           string                  `json:\"id\"`            // 消息唯一标识\n36\t\tType         string                  `json:\"type\"`          // 对象类型（通常为 \"message\"）\n37\t\tRole         string                  `json:\"role\"`          // 角色（通常为 \"assistant\"）\n38\t\tModel        string                  `json:\"model\"`         // 使用的模型名称\n39\t\tContent      []AnthropicContentBlock `json:\"content\"`       // 内容块列表\n40\t\tStopReason   string                  `json:\"stop_reason,omitempty\"` // 停止原因（如 \"end_turn\"）\n41\t\tStopSequence *string                 `json:\"stop_sequence\"` // 触发的停止序列（如有）\n42\t\tUsage        AnthropicUsage          `json:\"usage\"`         // Token 用量统计\n43\t}\n44\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/cmd/kimi-proxy/main.go"},"tool_use_id":"call_a88f8d1329bf4f33815eb13c","tool_response":"1\t// Package main 提供 Kimi API 轻量代理，解决 Claude Code 使用 Kimi 时\n2\t// thinking 模式下 tool_call 消息缺少 reasoning_content 导致的 400 错误。\n3\t//\n4\t// 用法：\n5\t//\n6\t//\tkimi-proxy [--listen :9090] --target https://api.kimi.com/coding\n7\tpackage main\n8\t\n9\timport (\n10\t\t\"bytes\"\n11\t\t\"encoding/json\"\n12\t\t\"flag\"\n13\t\t\"fmt\"\n14\t\t\"io\"\n15\t\t\"log\"\n16\t\t\"net/http\"\n17\t\t\"os\"\n18\t\t\"strings\"\n19\t)\n20\t\n21\tvar (\n22\t\tlistenAddr = flag.String(\"listen\", \":9090\", \"本地监听地址\")\n23\t\ttargetURL  = flag.String(\"target\", \"https://api.kimi.com/coding\", \"Kimi API 上游地址\")\n24\t)\n25\t\n26\tfunc main() {\n27\t\tflag.Parse()\n28\t\ttarget := strings.TrimRight(*targetURL, \"/\")\n29\t\n30\t\tlog.Printf(\"kimi-proxy: listening on %s, forwarding to %s\", *listenAddr, target)\n31\t\n32\t\tproxy := &kimiProxy{target: target}\n33\t\tif err := http.ListenAndServe(*listenAddr, proxy); err != nil {\n34\t\t\tlog.Fatalf(\"listen: %v\", err)\n35\t\t}\n36\t}\n37\t\n38\t// kimiProxy 是一个反向代理，在转发前为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content。\n39\ttype kimiProxy struct {\n40\t\ttarget string\n41\t}\n42\t\n43\tfunc (p *kimiProxy) ServeHTTP(w http.ResponseWriter, r *http.Request) {\n44\t\t// 读取请求体\n45\t\tbodyBytes, err := io.ReadAll(r.Body)\n46\t\tif err != nil {\n47\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n48\t\t\treturn\n49\t\t}\n50\t\tr.Body.Close()\n51\t\n52\t\t// 注入 reasoning_content\n53\t\tbodyBytes = injectReasoningContent(bodyBytes)\n54\t\n55\t\t// 构建上游请求\n56\t\tupstreamURL := p.target + r.URL.Path\n57\t\tif r.URL.RawQuery != \"\" {\n58\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n59\t\t}\n60\t\n61\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n62\t\tif err != nil {\n63\t\t\thttp.Error(w, \"create request: \"+err.Error(), http.StatusBadGateway)\n64\t\t\treturn\n65\t\t}\n66\t\n67\t\t// 复制请求头\n68\t\tfor k, vals := range r.Header {\n69\t\t\tlower := strings.ToLower(k)\n70\t\t\tif lower == \"host\" {\n71\t\t\t\tcontinue\n72\t\t\t}\n73\t\t\tfor _, v := range vals {\n74\t\t\t\tupstreamReq.Header.Add(k, v)\n75\t\t\t}\n76\t\t}\n77\t\n78\t\t// 转发\n79\t\tclient := &http.Client{}\n80\t\tresp, err := client.Do(upstreamReq)\n81\t\tif err != nil {\n82\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n83\t\t\treturn\n84\t\t}\n85\t\tdefer resp.Body.Close()\n86\t\n87\t\t// 复制响应头\n88\t\tfor k, vals := range resp.Header {\n89\t\t\tfor _, v := range vals {\n90\t\t\t\tw.Header().Add(k, v)\n91\t\t\t}\n92\t\t}\n93\t\tw.WriteHeader(resp.StatusCode)\n94\t\n95\t\t// 流式转发响应体\n96\t\tflusher, canFlush := w.(http.Flusher)\n97\t\tbuf := make([]byte, 32*1024)\n98\t\tfor {\n99\t\t\tn, err := resp.Body.Read(buf)\n100\t\t\tif n > 0 {\n101\t\t\t\tw.Write(buf[:n])\n102\t\t\t\tif canFlush {\n103\t\t\t\t\tflusher.Flush()\n104\t\t\t\t}\n105\t\t\t}\n106\t\t\tif err != nil {\n107\t\t\t\tbreak\n108\t\t\t}\n109\t\t}\n110\t\n111\t\t_ = fmt.Sprintf(\"\") // avoid unused import\n112\t}\n113\t\n114\t// injectReasoningContent 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content 字段。\n115\t//\n116\t// Kimi Code 要求：当 thinking 启用时，所有 assistant tool_call 消息必须携带顶层 reasoning_content 字段。\n117\t// Claude Code 发送 tool_call 消息时不包含此字段，导致 400 错误：\n118\t//\n119\t//\tthinking is enabled but reasoning_content is missing in assistant tool call message at index N\n120\tfunc injectReasoningContent(body []byte) []byte {\n121\t\tif len(body) == 0 {\n122\t\t\treturn body\n123\t\t}\n124\t\n125\t\tvar m map[string]any\n126\t\tif err := json.Unmarshal(body, &m); err != nil {\n127\t\t\treturn body // 非 JSON，原样返回\n128\t\t}\n129\t\n130\t\t// 检测 thinking 是否启用\n131\t\tthinking, ok := m[\"thinking\"].(map[string]any)\n132\t\tif !ok {\n133\t\t\treturn body\n134\t\t}\n135\t\tthinkingType, _ := thinking[\"type\"].(string)\n136\t\tif thinkingType != \"enabled\" {\n137\t\t\treturn body\n138\t\t}\n139\t\n140\t\t// 获取 messages 数组\n141\t\tmessages, ok := m[\"messages\"].([]any)\n142\t\tif !ok || len(messages) == 0 {\n143\t\t\treturn body\n144\t\t}\n145\t\n146\t\tmodified := false\n147\t\tfor i, msgRaw := range messages {\n148\t\t\tmsg, ok := msgRaw.(map[string]any)\n149\t\t\tif !ok {\n150\t\t\t\tcontinue\n151\t\t\t}\n152\t\n153\t\t\t// 只处理 assistant 消息\n154\t\t\trole, _ := msg[\"role\"].(string)\n155\t\t\tif role != \"assistant\" {\n156\t\t\t\tcontinue\n157\t\t\t}\n158\t\n159\t\t\t// 检查 content 是否为数组\n160\t\t\tcontent, ok := msg[\"content\"].([]any)\n161\t\t\tif !ok || len(content) == 0 {\n162\t\t\t\tcontinue\n163\t\t\t}\n164\t\n165\t\t\t// 检查是否有 tool_use 块\n166\t\t\thasToolUse := false\n167\t\t\thasThinking := false\n168\t\t\tfor _, blockRaw := range content {\n169\t\t\t\tblock, ok := blockRaw.(map[string]any)\n170\t\t\t\tif !ok {\n171\t\t\t\t\tcontinue\n172\t\t\t\t}\n173\t\t\t\tblockType, _ := block[\"type\"].(string)\n174\t\t\t\tif blockType == \"tool_use\" {\n175\t\t\t\t\thasToolUse = true\n176\t\t\t\t}\n177\t\t\t\tif blockType == \"thinking\" {\n178\t\t\t\t\thasThinking = true\n179\t\t\t\t}\n180\t\t\t}\n181\t\n182\t\t\tif !hasToolUse {\n183\t\t\t\tcontinue\n184\t\t\t}\n185\t\n186\t\t\tneedPatch := false\n187\t\n188\t\t\t// 补丁 1: content 数组缺少 thinking 块 → 在开头插入\n189\t\t\tif !hasThinking {\n190\t\t\t\tthinkingBlock := map[string]any{\n191\t\t\t\t\t\"type\":     \"thinking\",\n192\t\t\t\t\t\"thinking\": \"\",\n193\t\t\t\t}\n194\t\t\t\tnewContent := make([]any, 0, len(content)+1)\n195\t\t\t\tnewContent = append(newContent, thinkingBlock)\n196\t\t\t\tnewContent = append(newContent, content...)\n197\t\t\t\tmsg[\"content\"] = newContent\n198\t\t\t\tneedPatch = true\n199\t\t\t}\n200\t\n201\t\t\t// 补丁 2: 消息缺少顶层 reasoning_content 字段 → 注入\n202\t\t\tif _, exists := msg[\"reasoning_content\"]; !exists {\n203\t\t\t\tmsg[\"reasoning_content\"] = \"\"\n204\t\t\t\tneedPatch = true\n205\t\t\t}\n206\t\n207\t\t\tif needPatch {\n208\t\t\t\tmessages[i] = msg\n209\t\t\t\tmodified = true\n210\t\t\t}\n211\t\t}\n212\t\n213\t\tif !modified {\n214\t\t\treturn body\n215\t\t}\n216\t\n217\t\tm[\"messages\"] = messages\n218\t\trewritten, err := json.Marshal(m)\n219\t\tif err != nil {\n220\t\t\treturn body\n221\t\t}\n222\t\treturn rewritten\n223\t}\n224\t\n225\tfunc init() {\n226\t\tlog.SetOutput(os.Stderr)\n227\t\tlog.SetFlags(log.Ltime | log.Lshortfile)\n228\t}\n229\t"},{"tool_name":"Read","tool_input":{"file_path":"D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/tests/sse/reassembler_test.go"},"tool_use_id":"call_cd959489db0841c0a8f56519","tool_response":"1\t// Package sse_test 包含 SSE（Server-Sent Events）流重组器的单元测试。\n2\t// 测试覆盖 Anthropic、OpenAI 等流式响应格式的解析与重组。\n3\tpackage sse_test\n4\t\n5\timport (\n6\t\t\"testing\"\n7\t\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n9\t)\n10\t\n11\t// TestAnthropicStreamReconstruction 验证：Anthropic 流式响应能正确重组为完整消息快照。\n12\t// 模拟 message_start → content_block_start → content_block_delta → content_block_stop → message_delta → message_stop 事件流。\n13\tfunc TestAnthropicStreamReconstruction(t *testing.T) {\n14\t\tr := sse.NewSSEReassembler()\n15\t\tr.FeedBytes([]byte(\n16\t\t\t\"event: message_start\\n\" +\n17\t\t\t\t\"data: {\\\"type\\\":\\\"message_start\\\",\\\"message\\\":{\\\"id\\\":\\\"m1\\\",\\\"role\\\":\\\"assistant\\\",\" +\n18\t\t\t\t\"\\\"content\\\":[],\\\"model\\\":\\\"claude-x\\\",\\\"usage\\\":{\\\"input_tokens\\\":3,\\\"output_tokens\\\":0}}}\\n\\n\" +\n19\t\t\t\t\"event: content_block_start\\n\" +\n20\t\t\t\t\"data: {\\\"type\\\":\\\"content_block_start\\\",\\\"index\\\":0,\\\"content_block\\\":{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"\\\"}}\\n\\n\" +\n21\t\t\t\t\"event: content_block_delta\\n\" +\n22\t\t\t\t\"data: {\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":0,\\\"delta\\\":{\\\"type\\\":\\\"text_delta\\\",\\\"text\\\":\\\"hi\\\"}}\\n\\n\" +\n23\t\t\t\t\"event: content_block_stop\\n\" +\n24\t\t\t\t\"data: {\\\"type\\\":\\\"content_block_stop\\\",\\\"index\\\":0}\\n\\n\" +\n25\t\t\t\t\"event: message_delta\\n\" +\n26\t\t\t\t\"data: {\\\"type\\\":\\\"message_delta\\\",\\\"delta\\\":{\\\"stop_reason\\\":\\\"end_turn\\\"},\\\"usage\\\":{\\\"output_tokens\\\":1}}\\n\\n\" +\n27\t\t\t\t\"event: message_stop\\n\" +\n28\t\t\t\t\"data: {\\\"type\\\":\\\"message_stop\\\"}\\n\\n\",\n29\t\t))\n30\t\n31\t\tsnap := r.Reconstruct()\n32\t\tif snap == nil {\n33\t\t\tt.Fatal(\"expected non-nil snapshot\")\n34\t\t}\n35\t\tcontent := snap[\"content\"].([]any)\n36\t\tblock := content[0].(map[string]any)\n37\t\tif block[\"text\"] != \"hi\" {\n38\t\t\tt.Errorf(\"expected text 'hi', got %v\", block[\"text\"])\n39\t\t}\n40\t\tusage := snap[\"usage\"].(map[string]any)\n41\t\tgot := usage[\"output_tokens\"]\n42\t\tif got != float64(1) {\n43\t\t\tt.Errorf(\"expected output_tokens=1, got %v\", got)\n44\t\t}\n45\t}\n46\t\n47\t// TestChatCompletionsStream 验证：OpenAI chat.completions 流式响应能正确解析。\n48\t// 模拟包含角色、内容和结束标记的 SSE 事件流。\n49\tfunc TestChatCompletionsStream(t *testing.T) {\n50\t\tr := sse.NewSSEReassembler()\n51\t\tr.FeedBytes([]byte(\n52\t\t\t\"data: {\\\"id\\\":\\\"c1\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"role\\\":\\\"assistant\\\"}}]}\\n\\n\" +\n53\t\t\t\t\"data: {\\\"id\\\":\\\"c1\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"content\\\":\\\"OK\\\"}}]}\\n\\n\" +\n54\t\t\t\t\"data: {\\\"id\\\":\\\"c1\\\",\\\"choices\\\":[{\\\"finish_reason\\\":\\\"stop\\\",\\\"delta\\\":{}}]}\\n\\n\" +\n55\t\t\t\t\"data: [DONE]\\n\\n\",\n56\t\t))\n57\t\n58\t\tif len(r.Events) != 3 {\n59\t\t\tt.Fatalf(\"expected 3 events, got %d\", len(r.Events))\n60\t\t}\n61\t\tfor _, ev := range r.Events {\n62\t\t\tif ev[\"event\"] != \"message\" {\n63\t\t\t\tt.Errorf(\"expected event type 'message', got %v\", ev[\"event\"])\n64\t\t\t}\n65\t\t}\n66\t\n67\t\tsnap := r.Reconstruct()\n68\t\tif snap == nil {\n69\t\t\tt.Fatal(\"expected non-nil snapshot\")\n70\t\t}\n71\t\tchoices := snap[\"choices\"].([]any)\n72\t\tmsg := choices[0].(map[string]any)[\"message\"].(map[string]any)\n73\t\tif msg[\"role\"] != \"assistant\" {\n74\t\t\tt.Errorf(\"expected role 'assistant', got %v\", msg[\"role\"])\n75\t\t}\n76\t\tif msg[\"content\"] != \"OK\" {\n77\t\t\tt.Errorf(\"expected content 'OK', got %v\", msg[\"content\"])\n78\t\t}\n79\t\n80\t\tcontent := snap[\"content\"].([]any)\n81\t\ttextBlock := content[0].(map[string]any)\n82\t\tif textBlock[\"type\"] != \"text\" || textBlock[\"text\"] != \"OK\" {\n83\t\t\tt.Errorf(\"expected text mirror block, got %v\", textBlock)\n84\t\t}\n85\t}\n86\t\n87\t// TestChatCompletionsUsageNormalization 验证：OpenAI 流式响应中的 usage 被正确标准化为统一格式。\n88\t// 将 prompt_tokens/completion_tokens 映射为 input_tokens/output_tokens。\n89\tfunc TestChatCompletionsUsageNormalization(t *testing.T) {\n90\t\tr := sse.NewSSEReassembler()\n91\t\tr.FeedBytes([]byte(\n92\t\t\t\"data: {\\\"id\\\":\\\"c1\\\",\\\"model\\\":\\\"hy3\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"role\\\":\\\"assistant\\\",\\\"content\\\":\\\"hi\\\"}}]}\\n\\n\" +\n93\t\t\t\t\"data: {\\\"id\\\":\\\"c1\\\",\\\"choices\\\":[{\\\"delta\\\":{},\\\"finish_reason\\\":\\\"stop\\\"},\" +\n94\t\t\t\t\"\\\"usage\\\":{\\\"prompt_tokens\\\":12,\\\"completion_tokens\\\":3,\\\"total_tokens\\\":15}}\\n\\n\" +\n95\t\t\t\t\"data: [DONE]\\n\\n\",\n96\t\t))\n97\t\n98\t\tsnap := r.Reconstruct()\n99\t\tif snap == nil {\n100\t\t\tt.Fatal(\"expected non-nil snapshot\")\n101\t\t}\n102\t\tusageRaw := snap[\"usage\"]\n103\t\tusage, ok := usageRaw.(map[string]int64)\n104\t\tif !ok {\n105\t\t\tt.Fatalf(\"expected usage to be map[string]int64, got %T\", usageRaw)\n106\t\t}\n107\t\tif usage[\"input_tokens\"] != 12 {\n108\t\t\tt.Errorf(\"expected input_tokens=12, got %d\", usage[\"input_tokens\"])\n109\t\t}\n110\t\tif usage[\"output_tokens\"] != 3 {\n111\t\t\tt.Errorf(\"expected output_tokens=3, got %d\", usage[\"output_tokens\"])\n112\t\t}\n113\t\tif snap[\"model\"] != \"hy3\" {\n114\t\t\tt.Errorf(\"expected model 'hy3', got %v\", snap[\"model\"])\n115\t\t}\n116\t}\n117\t\n118\t// TestChatCompletionsCachedTokens 验证：缓存 token（cached_tokens）被正确提取为 cache_read_input_tokens。\n119\tfunc TestChatCompletionsCachedTokens(t *testing.T) {\n120\t\tr := sse.NewSSEReassembler()\n121\t\tr.FeedBytes([]byte(\n122\t\t\t\"data: {\\\"id\\\":\\\"c_kimi\\\",\\\"model\\\":\\\"kimi-k2\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"role\\\":\\\"assistant\\\",\\\"content\\\":\\\"hi\\\"}}]}\\n\\n\" +\n123\t\t\t\t\"data: {\\\"id\\\":\\\"c_kimi\\\",\\\"choices\\\":[{\\\"delta\\\":{},\\\"finish_reason\\\":\\\"stop\\\",\" +\n124\t\t\t\t\"\\\"usage\\\":{\\\"prompt_tokens\\\":8,\\\"completion_tokens\\\":5,\\\"total_tokens\\\":13,\\\"cached_tokens\\\":3}}]}\\n\\n\" +\n125\t\t\t\t\"data: [DONE]\\n\\n\",\n126\t\t))\n127\t\n128\t\tsnap := r.Reconstruct()\n129\t\tif snap == nil {\n130\t\t\tt.Fatal(\"expected non-nil snapshot\")\n131\t\t}\n132\t\tusageRaw := snap[\"usage\"]\n133\t\tusage, ok := usageRaw.(map[string]int64)\n134\t\tif !ok {\n135\t\t\tt.Fatalf(\"expected usage to be map[string]int64, got %T\", usageRaw)\n136\t\t}\n137\t\tif usage[\"input_tokens\"] != 8 {\n138\t\t\tt.Errorf(\"expected input_tokens=8, got %d\", usage[\"input_tokens\"])\n139\t\t}\n140\t\tif usage[\"output_tokens\"] != 5 {\n141\t\t\tt.Errorf(\"expected output_tokens=5, got %d\", usage[\"output_tokens\"])\n142\t\t}\n143\t\tif usage[\"cache_read_input_tokens\"] != 3 {\n144\t\t\tt.Errorf(\"expected cache_read_input_tokens=3, got %d\", usage[\"cache_read_input_tokens\"])\n145\t\t}\n146\t}\n147\t\n148\t// TestChatCompletionsReasoningContent 验证：推理内容（reasoning_content）被正确累加。\n149\tfunc TestChatCompletionsReasoningContent(t *testing.T) {\n150\t\tr := sse.NewSSEReassembler()\n151\t\tr.FeedBytes([]byte(\n152\t\t\t\"data: {\\\"id\\\":\\\"c_kimi\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"role\\\":\\\"assistant\\\",\\\"reasoning_content\\\":\\\"Think \\\"}}]}\\n\\n\" +\n153\t\t\t\t\"data: {\\\"id\\\":\\\"c_kimi\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"reasoning_content\\\":\\\"carefully.\\\"}}]}\\n\\n\" +\n154\t\t\t\t\"data: {\\\"id\\\":\\\"c_kimi\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"content\\\":\\\"Done.\\\"}}]}\\n\\n\" +\n155\t\t\t\t\"data: [DONE]\\n\\n\",\n156\t\t))\n157\t\n158\t\tsnap := r.Reconstruct()\n159\t\tif snap == nil {\n160\t\t\tt.Fatal(\"expected non-nil snapshot\")\n161\t\t}\n162\t\tmsg := snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n163\t\tif msg[\"reasoning_content\"] != \"Think carefully.\" {\n164\t\t\tt.Errorf(\"expected reasoning 'Think carefully.', got %v\", msg[\"reasoning_content\"])\n165\t\t}\n166\t\tif msg[\"content\"] != \"Done.\" {\n167\t\t\tt.Errorf(\"expected content 'Done.', got %v\", msg[\"content\"])\n168\t\t}\n169\t\n170\t\tcontent := snap[\"content\"].([]any)\n171\t\tthinking := content[0].(map[string]any)\n172\t\tif thinking[\"type\"] != \"thinking\" || thinking[\"thinking\"] != \"Think carefully.\" {\n173\t\t\tt.Errorf(\"expected thinking mirror block, got %v\", thinking)\n174\t\t}\n175\t\ttext := content[1].(map[string]any)\n176\t\tif text[\"type\"] != \"text\" || text[\"text\"] != \"Done.\" {\n177\t\t\tt.Errorf(\"expected text mirror block, got %v\", text)\n178\t\t}\n179\t}\n180\t\n181\t// TestChatCompletionsToolCallAccumulation 验证：流式工具调用参数被正确拼接。\n182\t// 模拟工具调用的 arguments 分多段发送的场景。\n183\tfunc TestChatCompletionsToolCallAccumulation(t *testing.T) {\n184\t\tr := sse.NewSSEReassembler()\n185\t\tr.FeedBytes([]byte(\n186\t\t\t\"data: {\\\"id\\\":\\\"c1\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"role\\\":\\\"assistant\\\",\\\"tool_calls\\\":\" +\n187\t\t\t\t\"[{\\\"index\\\":0,\\\"id\\\":\\\"call_1\\\",\\\"type\\\":\\\"function\\\",\\\"function\\\":{\\\"name\\\":\\\"get_weather\\\",\\\"arguments\\\":\\\"\\\"}}]}}]}\\n\\n\" +\n188\t\t\t\t\"data: {\\\"id\\\":\\\"c1\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"tool_calls\\\":\" +\n189\t\t\t\t\"[{\\\"index\\\":0,\\\"function\\\":{\\\"arguments\\\":\\\"{\\\\\\\"city\\\\\\\":\\\"}}]}}]}\\n\\n\" +\n190\t\t\t\t\"data: {\\\"id\\\":\\\"c1\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"tool_calls\\\":\" +\n191\t\t\t\t\"[{\\\"index\\\":0,\\\"function\\\":{\\\"arguments\\\":\\\"\\\\\\\"SF\\\\\\\"}\\\"}}]}}]}\\n\\n\" +\n192\t\t\t\t\"data: {\\\"id\\\":\\\"c1\\\",\\\"choices\\\":[{\\\"delta\\\":{},\\\"finish_reason\\\":\\\"tool_calls\\\"}]}\\n\\n\" +\n193\t\t\t\t\"data: [DONE]\\n\\n\",\n194\t\t))\n195\t\n196\t\tsnap := r.Reconstruct()\n197\t\tif snap == nil {\n198\t\t\tt.Fatal(\"expected non-nil snapshot\")\n199\t\t}\n200\t\tmsg := snap[\"choices\"].([]any)[0].(map[string]any)[\"message\"].(map[string]any)\n201\t\ttc := msg[\"tool_calls\"].([]any)[0].(map[string]any)\n202\t\tfn := tc[\"function\"].(map[string]any)\n203\t\tif tc[\"id\"] != \"call_1\" {\n204\t\t\tt.Errorf(\"expected id 'call_1', got %v\", tc[\"id\"])\n205\t\t}\n206\t\tif fn[\"name\"] != \"get_weather\" {\n207\t\t\tt.Errorf(\"expected name 'get_weather', got %v\", fn[\"name\"])\n208\t\t}\n209\t\tif fn[\"arguments\"] != `{\"city\":\"SF\"}` {\n210\t\t\tt.Errorf(\"expected arguments '{\\\"city\\\":\\\"SF\\\"}', got %v\", fn[\"arguments\"])\n211\t\t}\n212\t\n213\t\ttoolUseBlocks := []map[string]any{}\n214\t\tfor _, b := range snap[\"content\"].([]any) {\n215\t\t\tblock := b.(map[string]any)\n216\t\t\tif block[\"type\"] == \"tool_use\" {\n217\t\t\t\ttoolUseBlocks = append(toolUseBlocks, block)\n218\t\t\t}\n219\t\t}\n220\t\tif len(toolUseBlocks) != 1 {\n221\t\t\tt.Fatalf(\"expected 1 tool_use block, got %d\", len(toolUseBlocks))\n222\t\t}\n223\t\tif toolUseBlocks[0][\"id\"] != \"call_1\" {\n224\t\t\tt.Errorf(\"expected mirrored id 'call_1', got %v\", toolUseBlocks[0][\"id\"])\n225\t\t}\n226\t\tif toolUseBlocks[0][\"name\"] != \"get_weather\" {\n227\t\t\tt.Errorf(\"expected mirrored name 'get_weather', got %v\", toolUseBlocks[0][\"name\"])\n228\t\t}\n229\t}\n230\t\n231\t// TestChatCompletionsParallelToolCalls 验证：并行工具调用被正确解析。\n232\tfunc TestChatCompletionsParallelToolCalls(t *testing.T) {\n233\t\tr := sse.NewSSEReassembler()\n234\t\tr.FeedBytes([]byte(\n235\t\t\t\"data: {\\\"id\\\":\\\"c3\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"role\\\":\\\"assistant\\\",\\\"tool_calls\\\":[\" +\n236\t\t\t\t\"{\\\"index\\\":0,\\\"id\\\":\\\"a\\\",\\\"type\\\":\\\"function\\\",\\\"function\\\":{\\\"name\\\":\\\"f1\\\",\\\"arguments\\\":\\\"{}\\\"}},\" +\n237\t\t\t\t\"{\\\"index\\\":1,\\\"id\\\":\\\"b\\\",\\\"type\\\":\\\"function\\\",\\\"function\\\":{\\\"name\\\":\\\"f2\\\",\\\"arguments\\\":\\\"{}\\\"}}\" +\n238\t\t\t\t\"]}}]}\\n\\n\" +\n239\t\t\t\t\"data: {\\\"id\\\":\\\"c3\\\",\\\"choices\\\":[{\\\"delta\\\":{},\\\"finish_reason\\\":\\\"tool_calls\\\"}]}\\n\\n\" +\n240\t\t\t\t\"data: [DONE]\\n\\n\",\n241\t\t))\n242\t\n243\t\tsnap := r.Reconstruct()\n244\t\tif snap == nil {\n245\t\t\tt.Fatal(\"expected non-nil snapshot\")\n246\t\t}\n247\t\ttoolUseBlocks := []map[string]any{}\n248\t\tfor _, b := range snap[\"content\"].([]any) {\n249\t\t\tblock := b.(map[string]any)\n250\t\t\tif block[\"type\"] == \"tool_use\" {\n251\t\t\t\ttoolUseBlocks = append(toolUseBlocks, block)\n252\t\t\t}\n253\t\t}\n254\t\tnames := []string{}\n255\t\tfor _, b := range toolUseBlocks {\n256\t\t\tnames = append(names, b[\"name\"].(string))\n257\t\t}\n258\t\tif len(names) != 2 || names[0] != \"f1\" || names[1] != \"f2\" {\n259\t\t\tt.Errorf(\"expected tool names [f1, f2], got %v\", names)\n260\t\t}\n261\t}\n262\t\n263\t// TestDoneSentinelFiltered 验证：[DONE] 哨兵事件被正确过滤，不计入有效事件。\n264\tfunc TestDoneSentinelFiltered(t *testing.T) {\n265\t\tr := sse.NewSSEReassembler()\n266\t\tr.FeedBytes([]byte(\"data: [DONE]\\n\\n\"))\n267\t\tif len(r.Events) != 0 {\n268\t\t\tt.Errorf(\"expected 0 events for [DONE], got %d\", len(r.Events))\n269\t\t}\n270\t}\n271\t\n272\t// TestChunkedAcrossFeeds 验证：SSE 数据跨多次 FeedBytes 调用能正确拼接。\n273\tfunc TestChunkedAcrossFeeds(t *testing.T) {\n274\t\tr := sse.NewSSEReassembler()\n275\t\tr.FeedBytes([]byte(\"data: {\\\"id\\\":\\\"c1\\\",\\\"choices\\\":[{\\\"de\"))\n276\t\tr.FeedBytes([]byte(\"lta\\\":{\\\"content\\\":\\\"hel\"))\n277\t\tr.FeedBytes([]byte(\"lo\\\"}}]}\\n\\n\"))\n278\t\tif len(r.Events) != 1 {\n279\t\t\tt.Fatalf(\"expected 1 event, got %d\", len(r.Events))\n280\t\t}\n281\t\tdelta := r.Events[0][\"data\"].(map[string]any)[\"choices\"].([]any)[0].(map[string]any)[\"delta\"].(map[string]any)\n282\t\tif delta[\"content\"] != \"hello\" {\n283\t\t\tt.Errorf(\"expected content 'hello', got %v\", delta[\"content\"])\n284\t\t}\n285\t}\n286\t\n287\t// TestUsageOnlyFinalChunk 验证：仅最后一个 chunk 包含 usage 时，仍能正确提取 token 统计。\n288\tfunc TestUsageOnlyFinalChunk(t *testing.T) {\n289\t\tr := sse.NewSSEReassembler()\n290\t\tr.FeedBytes([]byte(\n291\t\t\t\"data: {\\\"id\\\":\\\"c4\\\",\\\"model\\\":\\\"hy3\\\",\\\"choices\\\":[{\\\"delta\\\":{\\\"role\\\":\\\"assistant\\\",\\\"content\\\":\\\"hi\\\"}}]}\\n\\n\" +\n292\t\t\t\t\"data: {\\\"id\\\":\\\"c4\\\",\\\"choices\\\":[{\\\"delta\\\":{},\\\"finish_reason\\\":\\\"stop\\\"}]}\\n\\n\" +\n293\t\t\t\t\"data: {\\\"id\\\":\\\"c4\\\",\\\"choices\\\":[],\\\"usage\\\":{\\\"prompt_tokens\\\":10,\\\"completion_tokens\\\":2,\\\"total_tokens\\\":12}}\\n\\n\" +\n294\t\t\t\t\"data: [DONE]\\n\\n\",\n295\t\t))\n296\t\n297\t\tsnap := r.Reconstruct()\n298\t\tif snap == nil {\n299\t\t\tt.Fatal(\"expected non-nil snapshot\")\n300\t\t}\n301\t\tusageRaw := snap[\"usage\"]\n302\t\tusage, ok := usageRaw.(map[string]int64)\n303\t\tif !ok {\n304\t\t\tt.Fatalf(\"expected usage to be map[string]int64, got %T\", usageRaw)\n305\t\t}\n306\t\tif usage[\"input_tokens\"] != 10 {\n307\t\t\tt.Errorf(\"expected input_tokens=10, got %d\", usage[\"input_tokens\"])\n308\t\t}\n309\t\tif usage[\"output_tokens\"] != 2 {\n310\t\t\tt.Errorf(\"expected output_tokens=2, got %d\", usage[\"output_tokens\"])\n311\t\t}\n312\t}\n313\t\n314\t// TestUsageOnlyChunkWithoutPriorSnapshotIsSkipped 验证：只有 usage 但没有先前 snapshot 的 chunk 被跳过。\n315\tfunc TestUsageOnlyChunkWithoutPriorSnapshotIsSkipped(t *testing.T) {\n316\t\tr := sse.NewSSEReassembler()\n317\t\tr.FeedBytes([]byte(\"data: {\\\"choices\\\":[],\\\"usage\\\":{\\\"prompt_tokens\\\":1}}\\n\\n\"))\n318\t\tif r.Reconstruct() != nil {\n319\t\t\tt.Error(\"expected nil snapshot when no prior choices set up\")\n320\t\t}\n321\t}\n322\t\n323\t// TestMixedEventAndBareData 验证：混合命名事件和裸 data 事件都能正确解析。\n324\tfunc TestMixedEventAndBareData(t *testing.T) {\n325\t\tr := sse.NewSSEReassembler()\n326\t\tr.FeedBytes([]byte(\"data: {\\\"bare\\\":1}\\n\\nevent: ping\\ndata: {\\\"named\\\":2}\\n\\ndata: {\\\"bare\\\":3}\\n\\n\"))\n327\t\n328\t\texpectedTypes := []string{\"message\", \"ping\", \"message\"}\n329\t\tif len(r.Events) != 3 {\n330\t\t\tt.Fatalf(\"expected 3 events, got %d\", len(r.Events))\n331\t\t}\n332\t\tfor i, ev := range r.Events {\n333\t\t\tif ev[\"event\"] != expectedTypes[i] {\n334\t\t\t\tt.Errorf(\"event %d: expected type %q, got %v\", i, expectedTypes[i], ev[\"event\"])\n335\t\t\t}\n336\t\t}\n337\t}\n338\t\n339\t// TestAnthropicThinkingBlock 验证：Anthropic thinking 内容块被正确解析和重组。\n340\tfunc TestAnthropicThinkingBlock(t *testing.T) {\n341\t\tr := sse.NewSSEReassembler()\n342\t\tr.FeedBytes([]byte(\n343\t\t\t\"event: message_start\\n\" +\n344\t\t\t\t\"data: {\\\"type\\\":\\\"message_start\\\",\\\"message\\\":{\\\"id\\\":\\\"m2\\\",\\\"role\\\":\\\"assistant\\\",\" +\n345\t\t\t\t\"\\\"content\\\":[],\\\"model\\\":\\\"claude-x\\\",\\\"usage\\\":{\\\"input_tokens\\\":5,\\\"output_tokens\\\":0}}}\\n\\n\" +\n346\t\t\t\t\"event: content_block_start\\n\" +\n347\t\t\t\t\"data: {\\\"type\\\":\\\"content_block_start\\\",\\\"index\\\":0,\\\"content_block\\\":{\\\"type\\\":\\\"thinking\\\",\\\"thinking\\\":\\\"\\\"}}\\n\\n\" +\n348\t\t\t\t\"event: content_block_delta\\n\" +\n349\t\t\t\t\"data: {\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":0,\\\"delta\\\":{\\\"type\\\":\\\"thinking_delta\\\",\\\"thinking\\\":\\\"Let me think\\\"}}\\n\\n\" +\n350\t\t\t\t\"event: content_block_stop\\n\" +\n351\t\t\t\t\"data: {\\\"type\\\":\\\"content_block_stop\\\",\\\"index\\\":0}\\n\\n\" +\n352\t\t\t\t\"event: content_block_start\\n\" +\n353\t\t\t\t\"data: {\\\"type\\\":\\\"content_block_start\\\",\\\"index\\\":1,\\\"content_block\\\":{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"\\\"}}\\n\\n\" +\n354\t\t\t\t\"event: content_block_delta\\n\" +\n355\t\t\t\t\"data: {\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":1,\\\"delta\\\":{\\\"type\\\":\\\"text_delta\\\",\\\"text\\\":\\\"Answer\\\"}}\\n\\n\" +\n356\t\t\t\t\"event: content_block_stop\\n\" +\n357\t\t\t\t\"data: {\\\"type\\\":\\\"content_block_stop\\\",\\\"index\\\":1}\\n\\n\" +\n358\t\t\t\t\"event: message_delta\\n\" +\n359\t\t\t\t\"data: {\\\"type\\\":\\\"message_delta\\\",\\\"delta\\\":{\\\"stop_reason\\\":\\\"end_turn\\\"},\\\"usage\\\":{\\\"output_tokens\\\":10}}\\n\\n\" +\n360\t\t\t\t\"event: message_stop\\n\" +\n361\t\t\t\t\"data: {\\\"type\\\":\\\"message_stop\\\"}\\n\\n\",\n362\t\t))\n363\t\n364\t\tsnap := r.Reconstruct()\n365\t\tif snap == nil {\n366\t\t\tt.Fatal(\"expected non-nil snapshot\")\n367\t\t}\n368\t\tcontent := snap[\"content\"].([]any)\n369\t\tif len(content) != 2 {\n370\t\t\tt.Fatalf(\"expected 2 content blocks, got %d\", len(content))\n371\t\t}\n372\t\tthinking := content[0].(map[string]any)\n373\t\tif thinking[\"type\"] != \"thinking\" || thinking[\"thinking\"] != \"Let me think\" {\n374\t\t\tt.Errorf(\"expected thinking block, got %v\", thinking)\n375\t\t}\n376\t\ttext := content[1].(map[string]any)\n377\t\tif text[\"type\"] != \"text\" || text[\"text\"] != \"Answer\" {\n378\t\t\tt.Errorf(\"expected text block 'Answer', got %v\", text)\n379\t\t}\n380\t}\n381\t"}]}
