\tif got != tt.expected {\n\t\t\tt.Errorf(\"IsAllowedPath(%q) = %v, want %v\", tt.path, got, tt.expected)\n\t\t}\n\t}\n}\n","numLines":56,"startLine":1,"totalLines":56}},"tool_use_id":"call_7b3210dcfa834b1282e86a44","duration_ms":1}
