allowed\", \"use GET\")\n26\t\t\treturn\n27\t\t}\n28\t\n29\t\tlevel := r.URL.Query().Get(\"level\")\n30\t\tdate := r.URL.Query().Get(\"date\")\n31\t\tlimitStr := r.URL.Query().Get(\"limit\")\n32\t\n33\t\tlimit := 100\n34\t\tif limitStr != \"\" {\n35\t\t\tif v, err := strconv.Atoi(limitStr); err == nil && v > 0 {\n36\t\t\t\tlimit = v\n37\t\t\t}\n38\t\t}\n39\t\n40\t\tlogger.Debug(\"api.log\", \"GET /api/logs level=%s date=%s limit=%d\", level, date, limit)\n41\t\n42\t\tentries, err := h.svc.QueryLogs(r.Context(), level, date, limit)\n43\t\tif err != nil {\n44\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to query logs\")\n45\t\t\treturn\n46\t\t}\n47\t\n48\t\titems := make([]LogItem, len(entries))\n49\t\tfor i, e := range entries {\n50\t\t\titems[i] = LogItem{\n51\t\t\t\tTimestamp: e.Timestamp,\n52\t\t\t\tLevel:     e.Level,\n53\t\t\t\tSource:    e.Source,\n54\t\t\t\tMessage:   e.Message,\n55\t\t\t}\n56\t\t}\n57\t\n58\t\t// 确保返回空数组而非 null\n59\t\tif items == nil {\n60\t\t\titems = []LogItem{}\n61\t\t}\n62\t\n63\t\twriteJSON(w, http.StatusOK, LogsResponse{Logs: items})\n64\t}\n65\t"}]}
