essages\"].([]any)\n229\t\tassistantMsg := messages[1].(map[string]any)\n230\t\tcontent := assistantMsg[\"content\"].([]any)\n231\t\n232\t\tif len(content) != 2 {\n233\t\t\tt.Fatalf(\"assistant content blocks = %d, want 2\", len(content))\n234\t\t}\n235\t\n236\t\t// thinking 块在第一位\n237\t\tfirstBlock := content[0].(map[string]any)\n238\t\tif firstBlock[\"type\"] != \"thinking\" {\n239\t\t\tt.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")\n240\t\t}\n241\t\n242\t\t// 顶层 reasoning_content 被注入\n243\t\tif rc, ok := assistantMsg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n244\t\t\tt.Errorf(\"reasoning_content = %v, want empty string\", assistantMsg[\"reasoning_content\"])\n245\t\t}\n246\t\n247\t\t// 原 tool_use 块保持不变\n248\t\tsecondBlock := content[1].(map[string]any)\n249\t\tif secondBlock[\"type\"] != \"tool_use\" {\n250\t\t\tt.Errorf(\"second block type = %q, want %q\", secondBlock[\"type\"], \"tool_use\")\n251\t\t}\n252\t}\n253\t"}]}
