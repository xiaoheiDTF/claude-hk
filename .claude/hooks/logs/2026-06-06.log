v/null 2>&1\n  log \"INFO\" \"Session unregistered from backend: $sid\"\n}\n\nunregister_session\n\nhook_output 0 '{}'\n","numLines":54,"startLine":1,"totalLines":54}},"tool_use_id":"call_6d6dd3e3053b4f6bac45228e","duration_ms":1}
