\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n45\t\t\treturn\n46\t\t}\n47\t\n48\t\tvar req struct {\n49\t\t\tPID      string `json:\"pid\"`\n50\t\t\tProxyURL string `json:\"proxy_url\"`\n51\t\t}\n52\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n53\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n54\t\t\treturn\n55\t\t}\n56\t\n57\t\tif req.PID == \"\" || req.ProxyURL == \"\" {\n58\t\t\thttp.Error(w, \"pid and proxy_url required\", http.StatusBadRequest)\n59\t\t\treturn\n60\t\t}\n61\t\n62\t\th.mu.Lock()\n63\t\th.proxies[req.PID] = req.ProxyURL\n64\t\th.mu.Unlock()\n65\t\n66\t\tlogger.Info(\"api.proxy\", \"registered: pid=%s url=%s\", req.PID, req.ProxyURL)\n67\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n68\t}\n69\t\n70\t// Unregister 处理代理注销请求。\n71\t// POST /api/proxy/unregister\n72\t// Body: {\"pid\": \"28364\"}\n73\tfunc (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request) {\n74\t\tif r.Method != http.MethodPost {\n75\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n76\t\t\treturn\n77\t\t}\n78\t\n79\t\tvar req struct {\n80\t\t\tPID string `json:\"pid\"`\n81\t\t}\n82\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n83\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n84\t\t\treturn\n85\t\t}\n86\t\n87\t\th.mu.Lock()\n88\t\tdelete(h.proxies, req.PID)\n89\t\th.mu.Unlock()\n90\t\n91\t\tlogger.Info(\"api.proxy\", \"unregistered: pid=%s\", req.PID)\n92\t\twriteJSON(w, http.StatusOK, map[string]string{\"status\": \"ok\"})\n93\t}\n94\t\n95\t// TraceInit 转发 trace-init 请求到所有注册的代理。\n96\t// POST /api/proxy/trace-init\n97\t// 将请求体原样转发给每个代理的 /_internal/trace-init，返回第一个成功的响应。\n98\tfunc (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request) {\n99\t\tif r.Method != http.MethodPost {\n100\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n101\t\t\treturn\n102\t\t}\n103\t\n104\t\t// 读取请求体\n105\t\tbody, err := io.ReadAll(r.Body)\n106\t\tif err != nil {\n107\t\t\thttp.Error(w, \"read body failed\", http.StatusBadRequest)\n108\t\t\treturn\n109\t\t}\n110\t\n111\t\t// 获取所有注册的代理\n112\t\th.mu.RLock()\n113\t\turls := make([]string, 0, len(h.proxies))\n114\t\tfor _, url := range h.proxies {\n115\t\t\turls = append(urls, url)\n116\t\t}\n117\t\th.mu.RUnlock()\n118\t\n119\t\tif len(urls) == 0 {\n120\t\t\tlogger.Warn(\"api.proxy\", \"trace-init: no proxies registered\")\n121\t\t\thttp.Error(w, \"no proxies registered\", http.StatusServiceUnavailable)\n122\t\t\treturn\n123\t\t}\n124\t\n125\t\t// 转发到每个代理，返回第一个成功的响应\n126\t\tfor _, proxyURL := range urls {\n127\t\t\tresp, err := relayTraceInit(proxyURL, body)\n128\t\t\tif err != nil {\n129\t\t\t\tlogger.Debug(\"api.proxy\", \"trace-init relay to %s failed: %v\", proxyURL, err)\n130\t\t\t\tcontinue\n131\t\t\t}\n132\t\t\twriteJSON(w, http.StatusOK, resp)\n133\t\t\treturn\n134\t\t}\n135\t\n136\t\tlogger.Warn(\"api.proxy\", \"trace-init: all proxies failed\")\n137\t\thttp.Error(w, \"all proxies unreachable\", http.StatusBadGateway)\n138\t}\n139\t\n140\t// List 处理获取代理列表的请求。\n141\t// GET /api/proxies\n142\t// 查询参数：status（可选）、project（可选）\n143\tfunc (h *ProxyHandler) List(w http.ResponseWriter, r *http.Request) {\n144\t\tif r.Method != http.MethodGet {\n145\t\t\twriteError(w, http.StatusMethodNotAllowed, \"method_not_allowed\", \"use GET\")\n146\t\t\treturn\n147\t\t}\n148\t\n149\t\tvar filter store.ProxyFilter\n150\t\tif v := r.URL.Query().Get(\"status\"); v != \"\" {\n151\t\t\tfilter.Status = &v\n152\t\t}\n153\t\tif v := r.URL.Query().Get(\"project\"); v != \"\" {\n154\t\t\tfilter.Project = &v\n155\t\t}\n156\t\n157\t\tlogger.Debug(\"api.proxy\", \"GET /api/proxies status=%v project=%v\", filter.Status, filter.Project)\n158\t\n159\t\tproxies, err := h.svc.List(r.Context(), filter)\n160\t\tif err != nil {\n161\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to list proxies\")\n162\t\t\treturn\n163\t\t}\n164\t\n165\t\t// 确保返回空数组而非 null\n166\t\tif proxies == nil {\n167\t\t\tproxies = []store.Proxy{}\n168\t\t}\n169\t\n170\t\titems := make([]ProxyItem, len(proxies))\n171\t\tfor i, p := range proxies {\n172\t\t\titems[i] = ProxyItem{\n173\t\t\t\tProxyID:      p.ProxyID,\n174\t\t\t\tProjectSlug:  p.ProjectSlug,\n175\t\t\t\tStatus:       p.Status,\n176\t\t\t\tRegisteredAt: p.RegisteredAt,\n177\t\t\t\tLastPingAt:   p.LastPingAt,\n178\t\t\t}\n179\t\t}\n180\t\n181\t\twriteJSON(w, http.StatusOK, ProxiesResponse{\n182\t\t\tProxies: items,\n183\t\t\tTotal:   len(items),\n184\t\t})\n185\t}\n186\t\n187\t// relayTraceInit 将 trace-init 请求转发到指定代理。\n188\tfunc relayTraceInit(proxyURL string, body []byte) (map[string]any, error) {\n189\t\tclient := &http.Client{}\n190\t\treq, err := http.NewRequest(\"POST\", proxyURL+\"/_internal/trace-init\", bytes.NewReader(body))\n191\t\tif err != nil {\n192\t\t\treturn nil, err\n193\t\t}\n194\t\treq.Header.Set(\"Content-Type\", \"application/json\")\n195\t\n196\t\tresp, err := client.Do(req)\n197\t\tif err != nil {\n198\t\t\treturn nil, err\n199\t\t}\n200\t\tdefer resp.Body.Close()\n201\t\n202\t\tif resp.StatusCode != http.StatusOK {\n203\t\t\trespBody, _ := io.ReadAll(resp.Body)\n204\t\t\treturn nil, fmt.Errorf(\"proxy returned %d: %s\", resp.StatusCode, string(respBody))\n205\t\t}\n206\t\n207\t\tvar result map[string]any\n208\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n209\t\t\treturn nil, fmt.Errorf(\"decode proxy response: %w\", err)\n210\t\t}\n211\t\treturn result, nil\n212\t}\n213\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\router.go"},"tool_use_id":"tool_4a3WWwTMMt9Xdisd0YfSz7xW","tool_response":"1\t// Package api 提供后端 HTTP API 的处理函数和路由定义。\n2\tpackage api\n3\t\n4\timport (\n5\t\t\"net/http\"\n6\t\t\"strings\"\n7\t\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n9\t)\n10\t\n11\t// Handlers 聚合所有 HTTP 处理器的结构体。\n12\ttype Handlers struct {\n13\t\tIssue   *IssueHandler   // Issue 相关接口处理器\n14\t\tSession *SessionHandler // Session 相关接口处理器\n15\t\tProxy   *ProxyHandler   // 代理注册和 trace-init 转发处理器\n16\t\tMachine *MachineHandler // Machine 相关接口处理器\n17\t\tProject *ProjectHandler // Project 相关接口处理器\n18\t\tLog     *LogHandler     // Log 相关接口处理器\n19\t\tConfig  *ConfigHandler  // Config 相关接口处理器\n20\t\tStatus  *StatusHandler  // 系统状态处理器\n21\t}\n22\t\n23\t// NewRouter 创建并返回 HTTP 路由器，注册所有 API 端点。\n24\tfunc NewRouter(h Handlers) http.Handler {\n25\t\tmux := http.NewServeMux()\n26\t\t// 健康检查端点\n27\t\tmux.HandleFunc(\"/health\", Health)\n28\t\n29\t\t// Issue 相关路由。\n30\t\tmux.HandleFunc(\"/api/issue/check\", h.Issue.CheckIssues)         // 检查 Issue 状态\n31\t\tmux.HandleFunc(\"/api/issue/claim\", h.Issue.ClaimIssue)          // 领取 Issue\n32\t\tmux.HandleFunc(\"/api/issue/release\", h.Issue.ReleaseIssue)      // 释放 Issue\n33\t\tmux.HandleFunc(\"/api/issue/release-session\", h.Issue.ReleaseSession) // 释放会话下所有 Issue\n34\t\tmux.HandleFunc(\"/api/issue/status\", h.Issue.UpdateStatus)       // 更新 Issue 状态\n35\t\tmux.HandleFunc(\"/api/issues\", h.Issue.ListIssues)               // 列出所有 Issue\n36\t\n37\t\t// Session 相关路由。\n38\t\tmux.HandleFunc(\"/api/session/register\", h.Session.Register) // 注册会话\n39\t\tmux.HandleFunc(\"/api/session/close\", h.Session.Close)       // 关闭会话\n40\t\tmux.HandleFunc(\"/api/sessions\", h.Session.List)             // 获取会话列表\n41\t\tmux.HandleFunc(\"/api/session/\", func(w http.ResponseWriter, r *http.Request) {\n42\t\t\tpath := r.URL.Path\n43\t\t\tswitch {\n44\t\t\tcase strings.HasSuffix(path, \"/issues\"):\n45\t\t\t\th.Session.GetIssues(w, r)\n46\t\t\tcase strings.HasSuffix(path, \"/tokens\"):\n47\t\t\t\th.Session.GetTokens(w, r)\n48\t\t\tcase strings.HasSuffix(path, \"/traces\"):\n49\t\t\t\th.Session.GetTraces(w, r)\n50\t\t\tdefault:\n51\t\t\t\th.Session.Get(w, r)\n52\t\t\t}\n53\t\t})\n54\t\n55\t\t// Proxy 相关路由（代理注册 + trace-init 转发 + 代理列表）。\n56\t\tif h.Proxy != nil {\n57\t\t\tmux.HandleFunc(\"/api/proxy/register\", h.Proxy.Register)     // 代理注册\n58\t\t\tmux.HandleFunc(\"/api/proxy/unregister\", h.Proxy.Unregister) // 代理注销\n59\t\t\tmux.HandleFunc(\"/api/proxy/trace-init\", h.Proxy.TraceInit)  // 转发 trace-init\n60\t\t\tmux.HandleFunc(\"/api/proxies\", h.Proxy.List)                // 代理列表\n61\t\t}\n62\t\n63\t\t// Machine 相关路由。\n64\t\tif h.Machine != nil {\n65\t\t\tmux.HandleFunc(\"/api/machines\", h.Machine.List) // 列出所有机器\n66\t\t}\n67\t\n68\t\t// Project 相关路由。\n69\t\tif h.Project != nil {\n70\t\t\tmux.HandleFunc(\"/api/projects\", h.Project.List) // 列出所有项目\n71\t\t}\n72\t\n73\t\t// Log 相关路由。\n74\t\tif h.Log != nil {\n75\t\t\tmux.HandleFunc(\"/api/logs\", h.Log.Query) // 查询日志\n76\t\t}\n77\t\n78\t\t// Config 相关路由（GET + PUT 分发）。\n79\t\tif h.Config != nil {\n80\t\t\tmux.HandleFunc(\"/api/config\", h.Config.ServeHTTP) // 获取/更新配置\n81\t\t}\n82\t\n83\t\t// Status 相关路由。\n84\t\tif h.Status != nil {\n85\t\t\tmux.HandleFunc(\"/api/status\", h.Status.Get) // 系统状态\n86\t\t}\n87\t\n88\t\tlogger.Debug(\"api\", \"routes registered: %d endpoints\", 15)\n89\t\treturn mux\n90\t}\n91\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\api\\types.go"},"tool_use_id":"tool_Fl1QDLsPFfXKj7RAHNb2Dd2f","tool_response":"File does not exist. Note: your current working directory is D:\\CodeDevelopment\\CodeProject\\claude-hk."}]}
