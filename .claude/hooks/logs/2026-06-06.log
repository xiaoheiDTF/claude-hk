Claude Code 会话的元数据\n37\t\t\t`CREATE TABLE IF NOT EXISTS sessions (\n38\t\t\t\tid               INTEGER PRIMARY KEY AUTOINCREMENT,\n39\t\t\t\tsession_id       TEXT NOT NULL UNIQUE,\n40\t\t\t\tmachine_id       TEXT NOT NULL,\n41\t\t\t\tos               TEXT NOT NULL,\n42\t\t\t\tproject_slug     TEXT NOT NULL,\n43\t\t\t\tproject_cwd      TEXT NOT NULL,\n44\t\t\t\ttranscript_path  TEXT NOT NULL,\n45\t\t\t\tlocal_trace_path TEXT,\n46\t\t\t\tmodel            TEXT,\n47\t\t\t\tsource           TEXT,\n48\t\t\t\tstatus           TEXT NOT NULL DEFAULT 'active',\n49\t\t\t\tregistered_at    DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n50\t\t\t\tclosed_at        DATETIME,\n51\t\t\t\tclose_reason     TEXT\n52\t\t\t)`,\n53\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_machine ON sessions(machine_id)`,\n54\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_project ON sessions(project_slug)`,\n55\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_status ON sessions(status)`,\n56\t\t\t`CREATE INDEX IF NOT EXISTS idx_sessions_registered ON sessions(registered_at)`,\n57\t\n58\t\t\t// issue_claims 表：存储 Issue 领取关系和状态流转\n59\t\t\t`CREATE TABLE IF NOT EXISTS issue_claims (\n60\t\t\t\tid              INTEGER PRIMARY KEY AUTOINCREMENT,\n61\t\t\t\trepo_full_name  TEXT NOT NULL,\n62\t\t\t\tissue_number    INTEGER NOT NULL,\n63\t\t\t\tissue_title     TEXT,\n64\t\t\t\tstatus          TEXT NOT NULL DEFAULT 'idle',\n65\t\t\t\tsession_id      TEXT,\n66\t\t\t\tclaimed_at      DATETIME,\n67\t\t\t\tupdated_at      DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n68\t\t\t\tUNIQUE(repo_full_name, issue_number)\n69\t\t\t)`,\n70\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_repo ON issue_claims(repo_full_name)`,\n71\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_session ON issue_claims(session_id)`,\n72\t\t\t`CREATE INDEX IF NOT EXISTS idx_issue_claims_status ON issue_claims(status)`,\n73\t\n74\t\t\t// config 表：存储系统运行时配置\n75\t\t\t`CREATE TABLE IF NOT EXISTS config (\n76\t\t\t\tkey        TEXT PRIMARY KEY,\n77\t\t\t\tvalue      TEXT NOT NULL,\n78\t\t\t\tupdated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP\n79\t\t\t)`,\n80\t\n81\t\t\t// proxies 表：记录已注册的代理信息\n82\t\t\t`CREATE TABLE IF NOT EXISTS proxies (\n83\t\t\t\tproxy_id      TEXT PRIMARY KEY,\n84\t\t\t\tproject_slug  TEXT NOT NULL,\n85\t\t\t\tstatus        TEXT NOT NULL DEFAULT 'active',\n86\t\t\t\tregistered_at DATETIME NOT NULL,\n87\t\t\t\tlast_ping_at  DATETIME\n88\t\t\t)`,\n89\t\t\t`CREATE INDEX IF NOT EXISTS idx_proxies_status ON proxies(status)`,\n90\t\t\t`CREATE INDEX IF NOT EXISTS idx_proxies_project ON proxies(project_slug)`,\n91\t\t}\n92\t\n93\t\tlogger.Debug(\"store\", \"running %d migration statements\", len(stmts))\n94\t\tfor _, stmt := range stmts {\n95\t\t\tif _, err := db.Exec(stmt); err != nil {\n96\t\t\t\tlogger.Error(\"store\", \"migration failed: %s: %v\", stmt[:60], err)\n97\t\t\t\treturn err\n98\t\t\t}\n99\t\t\tlogger.Debug(\"store\", \"migration OK: %.60s\", stmt)\n100\t\t}\n101\t\treturn nil\n102\t}\n103\t"}]}
