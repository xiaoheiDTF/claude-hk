imIssueRequest` | `ClaimIssueResponse` (200 成功, 409 冲突) |\n| `/api/issue/release` | POST | `func (h *IssueHandler) ReleaseIssue(w http.ResponseWriter, r *http.Request)` | `ReleaseIssueRequest` | `ReleaseIssueResponse` (200) |\n| `/api/issue/release-session` | POST | `func (h *IssueHandler) ReleaseSession(w http.ResponseWriter, r *http.Request)` | `ReleaseSessionRequest` | `ReleaseSessionResponse` (200) |\n| `/api/issue/status` | POST | `func (h *IssueHandler) UpdateStatus(w http.ResponseWriter, r *http.Request)` | `UpdateStatusRequest` | `UpdateStatusResponse` (200) |\n| `/api/issues` | GET | `func (h *IssueHandler) ListIssues(w http.ResponseWriter, r *http.Request)` | Query: `repo`, `status`, `session_id`, `page`, `page_size` | `IssuesListResponse` (200) |\n\n---\n\n### 3. Session 端点 (SessionHandler)\n\n文件: `session_handler.go`\n\nHandler struct:\n```go\ntype SessionHandler struct {\n    svc      *service.SessionService\n    issueSvc *service.IssueService\n    tokenSvc *service.TokenService\n    traceSvc *service.TraceService\n}\n```\n\n| 路由 | 方法 | Handler 签名 | 请求体/参数 | 成功响应 |\n|---|---|---|---|---|\n| `/api/session/register` | POST | `func (h *SessionHandler) Register(w http.ResponseWriter, r *http.Request)` | `RegisterSessionRequest` | `{\"status\": \"registered\"}` (200) |\n| `/api/session/close` | POST | `func (h *SessionHandler) Close(w http.ResponseWriter, r *http.Request)` | `CloseSessionRequest` | `{\"status\": \"closed\"}` (200) |\n| `/api/sessions` | GET | `func (h *SessionHandler) List(w http.ResponseWriter, r *http.Request)` | Query: `machine_id`, `project_slug`, `status` | `SessionListResponse` (200) |\n| `/api/session/{id}` | GET | `func (h *SessionHandler) Get(w http.ResponseWriter, r *http.Request)` | URL path: session_id | `SessionDetail` (200) |\n| `/api/session/{id}/issues` | GET | `func (h *SessionHandler) GetIssues(w http.ResponseWriter, r *http.Request)` | URL path: session_id | `SessionIssuesResponse` (200) |\n| `/api/session/{id}/tokens` | GET | `func (h *SessionHandler) GetTokens(w http.ResponseWriter, r *http.Request)` | URL path: session_id | `SessionTokensResponse` (200) |\n| `/api/session/{id}/traces` | GET | `func (h *SessionHandler) GetTraces(w http.ResponseWriter, r *http.Request)` | URL path: session_id | `SessionTracesResponse` (200) |\n\n---\n\n### 4. Proxy 端点 (ProxyHandler)\n\n文件: `proxy_handler.go`\n\nHandler struct:\n```go\ntype ProxyHandler struct {\n    mu            sync.RWMutex\n    proxies       map[string]string\n    sessions      map[string]string\n    proxySessions map[string][]string\n    svc           *service.ProxyService\n}\n```\n\n| 路由 | 方法 | Handler 签名 | 请求体/参数 | 成功响应 |\n|---|---|---|---|---|\n| `/api/proxy/register` | POST | `func (h *ProxyHandler) Register(w http.ResponseWriter, r *http.Request)` | `{pid string, proxy_url string}` (匿名) | `{\"status\": \"ok\"}` (200) |\n| `/api/proxy/unregister` | POST | `func (h *ProxyHandler) Unregister(w http.ResponseWriter, r *http.Request)` | `{pid string}` (匿名) | `{\"status\": \"ok\"}` (200) |\n| `/api/proxy/trace-init` | POST | `func (h *ProxyHandler) TraceInit(w http.ResponseWriter, r *http.Request)` | `TraceInitRequest` | 代理转发的 JSON 响应 (200) |\n| `/api/proxies` | GET | `func (h *ProxyHandler) List(w http.ResponseWriter, r *http.Request)` | Query: `status`, `project` | `ProxiesResponse` (200) |\n\n---\n\n### 5. Machine 端点 (MachineHandler)\n\n文件: `machine_handler.go`\n\nHandler struct: `type MachineHandler struct { svc *service.MachineService }`\n\n| 路由 | 方法 | Handler 签名 | 请求参数 | 成功响应 |\n|---|---|---|---|---|\n| `/api/machines` | GET | `func (h *MachineHandler) List(w http.ResponseWriter, r *http.Request)` | Query: `os`, `hostname` | `MachinesListResponse` (200) |\n\n---\n\n### 6. Project 端点 (ProjectHandler)\n\n文件: `project_handler.go`\n\nHandler struct: `type ProjectHandler struct { svc *service.ProjectService }`\n\n| 路由 | 方法 | Handler 签名 | 请求参数 | 成功响应 |\n|---|---|---|---|---|\n| `/api/projects` | GET | `func (h *ProjectHandler) List(w http.ResponseWriter, r *http.Request)` | 无 | `ProjectsListResponse` (200) |\n\n---\n\n### 7. Log 端点 (LogHandler)\n\n文件: `log_handler.go`\n\nHandler struct: `type LogHandler struct { svc *service.LogService }`\n\n| 路由 | 方法 | Handler 签名 | 请求参数 | 成功响应 |\n|---|---|---|---|---|\n| `/api/logs` | GET | `func (h *LogHandler) Query(w http.ResponseWriter, r *http.Request)` | Query: `level`, `date`, `limit` (默认 100) | `LogsResponse` (200) |\n\n---\n\n### 8. Config 端点 (ConfigHandler)\n\n文件: `config_handler.go`\n\nHandler struct: `type ConfigHandler struct { svc *service.ConfigService }`\n\n| 路由 | 方法 | Handler 签名 | 请求体 | 成功响应 |\n|---|---|---|---|---|\n| `/api/config` | GET | `func (h *ConfigHandler) ServeHTTP(w http.ResponseWriter, r *http.Request)` -> `get()` | 无 | `ConfigResponse` (200) |\n| `/api/config` | PUT | `func (h *ConfigHandler) ServeHTTP(w http.ResponseWriter, r *http.Request)` -> `update()` | `map[string]interface{}` (任意 key-value) | `ConfigResponse` (200) |\n\n---\n\n### 9. Status 端点 (StatusHandler)\n\n文件: `status_handler.go`\n\nHandler struct: `type StatusHandler struct { svc *service.StatusService }`\n\n| 路由 | 方法 | Handler 签名 | 请求参数 | 成功响应 |\n|---|---|---|---|---|\n| `/api/status` | GET | `func (h *StatusHandler) Get(w http.ResponseWriter, r *http.Request)` | 无 | `StatusResponse` (200) |\n\n---\n\n### 四、路由注册入口\n\n文件: `D:/CodeDevelopment/CodeProject/claude-hk/claude_tap_plus/internal/backend/api/router.go`\n\n`func NewRouter(h Handlers) http.Handler` -- 注册全部 15 个端点到 `http.ServeMux`，其中 `/api/session/` 路径使用子路径分发 (issues/tokens/traces/detail)。\n\n---\n\n### 五、公共工具函数\n\n文件: `response.go` 末尾：\n\n- `func writeJSON(w http.ResponseWriter, status int, v any)` -- 写入 JSON 成功响应\n- `func writeError(w http.ResponseWriter, status int, code, message string)` -- 写入统一的 `APIError` 结构\n- `func boolPtr(b bool) *bool` -- 辅助函数，返回 bool 指针 (`issue_handler.go`)\n\n共计: **8 个 Request struct** + **1 个匿名 request struct** (proxy register) + **1 个匿名 request struct** (proxy unregister)，**23 个