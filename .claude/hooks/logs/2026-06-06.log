[2026-06-06 10:55:53] [INFO] [PostToolBatch] Input: {"session_id":"f19f2dcd-5cb7-4e25-89c6-4a90c9705548","transcript_path":"C:\\Users\\Administrator\\.claude\\projects\\D--CodeDevelopment-CodeProject-claude-hk\\f19f2dcd-5cb7-4e25-89c6-4a90c9705548.jsonl","cwd":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus","permission_mode":"auto","effort":{"level":"medium"},"hook_event_name":"PostToolBatch","tool_calls":[{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\reverse.go"},"tool_use_id":"call_7064c3a1f58546019b85ac6b","tool_response":"1\t// Package proxy 提供 HTTP 代理功能，包括请求转发、SSE 流式处理与 Trace 记录。\n2\tpackage proxy\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"compress/gzip\"\n7\t\t\"compress/zlib\"\n8\t\t\"encoding/json\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"net/http\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\t\"sync/atomic\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n19\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n20\t)\n21\t\n22\t// ReverseProxy 拦截 HTTP 请求并转发到上游 API，同时记录请求/响应到 JSONL Trace，并处理 SSE 流式响应。\n23\ttype ReverseProxy struct {\n24\t\ttarget             string              // 上游 API 目标地址\n25\t\tbaseDir            string              // Trace 文件存放的基础目录\n26\t\twriter             *trace.TraceWriter  // 当前会话的 Trace 写入器（由 _internal/trace-init 创建）\n27\t\tclient             *http.Client        // 转发请求的 HTTP 客户端\n28\t\tturn               atomic.Int64        // 请求计数器，用于标记 Turn 编号\n29\t\tserver             *http.Server        // 本地代理 HTTP 服务器\n30\t\tstartOnce          sync.Once           // 确保 Start 只执行一次\n31\t\tsessionID          string              // 当前会话 ID（由 trace-init 设置）\n32\t\tprojectSlug        string              // 当前项目标识（由 trace-init 设置）\n33\t\tOnSessionInit      func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\n34\t\tmodel              string              // 强制替换的模型名（空=不改写）\n35\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n36\t\tfallbackConfig     *FallbackConfig      // 兜底配置（上游不可用时切换）\n37\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfig 的并发安全\n38\t}\n39\t\n40\t// FallbackConfig 存储上游不可用时的兜底配置。\n41\ttype FallbackConfig struct {\n42\t\tBaseURL   string // 兜底上游 API 地址\n43\t\tModel     string // 兜底模型名\n44\t\tAuthToken string // 兜底认证 Token\n45\t\tAPIKey    string // 兜底 API Key\n46\t}\n47\t\n48\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n49\t// traceDir 为 Trace 文件存放的基础目录。\n50\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n51\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n52\t\treturn &ReverseProxy{\n53\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n54\t\t\tbaseDir:           traceDir,\n55\t\t\tupstreamAvailable: true,\n56\t\t\tclient: &http.Client{\n57\t\t\t\tTimeout: 0, // 流式场景不设超时\n58\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n59\t\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n60\t\t\t\t},\n61\t\t\t},\n62\t\t}\n63\t}\n64\t\n65\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n66\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n67\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n68\t\tmux := http.NewServeMux()\n69\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n70\t\tp.server = &http.Server{\n71\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n72\t\t\tHandler: mux,\n73\t\t}\n74\t\n75\t\tlistener, err := ioListener(p.server.Addr)\n76\t\tif err != nil {\n77\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n78\t\t}\n79\t\n80\t\t// 在后台 goroutine 中启动服务\n81\t\tgo func() {\n82\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n83\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n84\t\t\t}\n85\t\t}()\n86\t\n87\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n88\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n89\t\treturn actualPort, nil\n90\t}\n91\t\n92\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n93\tfunc (p *ReverseProxy) Stop() {\n94\t\tlogger.Info(\"proxy\", \"stopping\")\n95\t\tif p.writer != nil {\n96\t\t\tp.writer.Close()\n97\t\t}\n98\t\tif p.server != nil {\n99\t\t\t_ = p.server.Close()\n100\t\t}\n101\t}\n102\t\n103\t// URL 返回代理服务器的 HTTP 地址（如 http://127.0.0.1:8080）。\n104\tfunc (p *ReverseProxy) URL() string {\n105\t\tif p.server == nil {\n106\t\t\treturn \"\"\n107\t\t}\n108\t\treturn \"http://\" + p.server.Addr\n109\t}\n110\t\n111\t// serveHTTP 是代理的核心 HTTP 处理函数。\n112\t// 处理流程：内部端点 → 路径白名单检查 → 读取请求体 → 构建上游请求 → 转发 → 流式/非流式处理。\n113\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n114\t\t// 处理内部端点（绕过路径白名单）\n115\t\tif strings.HasPrefix(r.URL.Path, \"/_internal/\") {\n116\t\t\tp.handleInternal(w, r)\n117\t\t\treturn\n118\t\t}\n119\t\n120\t\t// 拒绝未知路径\n121\t\tif !IsAllowedPath(r.URL.Path) {\n122\t\t\thttp.NotFound(w, r)\n123\t\t\treturn\n124\t\t}\n125\t\n126\t\t// 读取请求体\n127\t\tbodyBytes, err := io.ReadAll(r.Body)\n128\t\tif err != nil {\n129\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n130\t\t\treturn\n131\t\t}\n132\t\t_ = r.Body.Close()\n133\t\n134\t\t// 解析请求体为 JSON（用于后续提取 model、stream 等字段）\n135\t\tvar reqBody any\n136\t\tif len(bodyBytes) > 0 {\n137\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n138\t\t}\n139\t\n140\t\t// 生成请求 ID 与 Turn 编号\n141\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n142\t\tturn := int(p.turn.Add(1))\n143\t\tt0 := time.Now()\n144\t\n145\t\tlogger.Debug(\"proxy\", \"[Turn %d] request: %s %s (%d bytes)\", turn, r.Method, r.URL.Path, len(bodyBytes))\n146\t\n147\t\t// 构建上游请求 URL\n148\t\tupstreamURL := p.target + r.URL.Path\n149\t\tif r.URL.RawQuery != \"\" {\n150\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n151\t\t}\n152\t\n153\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n154\t\tif err != nil {\n155\t\t\thttp.Error(w, \"create upstream request: \"+err.Error(), http.StatusBadGateway)\n156\t\t\treturn\n157\t\t}\n158\t\n159\t\t// 复制请求头，过滤逐跳头\n160\t\tfor k, vals := range r.Header {\n161\t\t\tlower := strings.ToLower(k)\n162\t\t\tif hopByHopHeaders[lower] {\n163\t\t\t\tcontinue\n164\t\t\t}\n165\t\t\tfor _, v := range vals {\n166\t\t\t\tupstreamReq.Header.Add(k, v)\n167\t\t\t}\n168\t\t}\n169\t\tupstreamReq.Header.Del(\"Host\")\n170\t\n171\t\t// 向上游发送请求\n172\t\tupstreamResp, err := p.client.Do(upstreamReq)\n173\t\tif err != nil {\n174\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] upstream error: %v\", turn, err)\n175\t\t\thttp.Error(w, \"upstream error: \"+err.Error(), http.StatusBadGateway)\n176\t\t\treturn\n177\t\t}\n178\t\tdefer upstreamResp.Body.Close()\n179\t\n180\t\tduration := time.Since(t0).Milliseconds()\n181\t\n182\t\t// 从请求体中提取 model 字段\n183\t\tmodel := \"\"\n184\t\tif m, ok := reqBody.(map[string]any); ok {\n185\t\t\tif v, ok := m[\"model\"].(string); ok {\n186\t\t\t\tmodel = v\n187\t\t\t}\n188\t\t}\n189\t\n190\t\t// 检测是否为流式请求\n191\t\tisStreaming := false\n192\t\tif m, ok := reqBody.(map[string]any); ok {\n193\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n194\t\t\t\tisStreaming = s\n195\t\t\t}\n196\t\t}\n197\t\n198\t\t// 根据是否流式分发到对应处理器\n199\t\tif isStreaming {\n200\t\t\tp.handleStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, t0, model)\n201\t\t} else {\n202\t\t\tp.handleNonStreaming(w, upstreamResp, reqID, turn, int(duration), r, reqBody, model)\n203\t\t}\n204\t}\n205\t\n206\t// handleStreaming 处理 SSE 流式响应：\n207\t//   - 复制响应头并写入客户端\n208\t//   - 逐块读取上游响应体并实时转发给客户端\n209\t//   - 使用 SSE 重组器收集完整事件\n210\t//   - 将重组后的结果写入 Trace\n211\tfunc (p *ReverseProxy) handleStreaming(\n212\t\tw http.ResponseWriter,\n213\t\tupstreamResp *http.Response,\n214\t\treqID string, turn, durationMs int,\n215\t\tr *http.Request, reqBody any,\n216\t\tt0 time.Time, model string,\n217\t) {\n218\t\t// 复制响应头\n219\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n220\t\tfor k, vals := range respHeaders {\n221\t\t\tfor _, v := range vals {\n222\t\t\t\tw.Header().Add(k, v)\n223\t\t\t}\n224\t\t}\n225\t\tw.WriteHeader(upstreamResp.StatusCode)\n226\t\n227\t\tflusher, canFlush := w.(http.Flusher)\n228\t\treassembler := sse.NewSSEReassembler()\n229\t\n230\t\t// 逐块读取并转发流式数据\n231\t\tbuf := make([]byte, 32*1024)\n232\t\tfor {\n233\t\t\tn, err := upstreamResp.Body.Read(buf)\n234\t\t\tif n > 0 {\n235\t\t\t\t_, _ = w.Write(buf[:n])\n236\t\t\t\tif canFlush {\n237\t\t\t\t\tflusher.Flush()\n238\t\t\t\t}\n239\t\t\t\treassembler.FeedBytes(buf[:n])\n240\t\t\t}\n241\t\t\tif err != nil {\n242\t\t\t\tbreak\n243\t\t\t}\n244\t\t}\n245\t\n246\t\tdurationMs = int(time.Since(t0).Milliseconds())\n247\t\treconstructed := reassembler.Reconstruct()\n248\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n249\t\n250\t\t// 构建 Trace 记录\n251\t\trecord := buildRecord(\n252\t\t\treqID, turn, durationMs,\n253\t\t\tr.Method, r.URL.RequestURI(),\n254\t\t\tr.Header, reqBody,\n255\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n256\t\t\treconstructed,\n257\t\t\treassembler.Events,\n258\t\t\tp.target,\n259\t\t)\n260\t\n261\t\tif w := p.getWriter(); w != nil {\n262\t\t\tif err := w.Write(record); err != nil {\n263\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n264\t\t\t}\n265\t\t} else {\n266\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n267\t\t}\n268\t\n269\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n270\t}\n271\t\n272\t// handleNonStreaming 处理普通（非流式）响应：\n273\t//   - 读取完整响应体\n274\t//   - 按需解压（gzip / deflate）\n275\t//   - 解析 JSON 响应体\n276\t//   - 写入 Trace 并返回给客户端\n277\tfunc (p *ReverseProxy) handleNonStreaming(\n278\t\tw http.ResponseWriter,\n279\t\tupstreamResp *http.Response,\n280\t\treqID string, turn, durationMs int,\n281\t\tr *http.Request, reqBody any, model string,\n282\t) {\n283\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n284\t\tif err != nil {\n285\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n286\t\t\treturn\n287\t\t}\n288\t\n289\t\t// 按需解压响应体\n290\t\tdecodeBytes := respBytes\n291\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n292\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n293\t\t\tvar reader io.ReadCloser\n294\t\t\tif encoding == \"gzip\" {\n295\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n296\t\t\t} else {\n297\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n298\t\t\t}\n299\t\t\tif reader != nil {\n300\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n301\t\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n302\t\t\t\t\tdecodeBytes = decoded\n303\t\t\t\t}\n304\t\t\t\t_ = reader.Close()\n305\t\t\t}\n306\t\t}\n307\t\n308\t\t// 解析解压后的 JSON 响应体\n309\t\tvar respBody any\n310\t\tif len(decodeBytes) > 0 {\n311\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n312\t\t}\n313\t\n314\t\t// 构建 Trace 记录\n315\t\trecord := buildRecord(\n316\t\t\treqID, turn, durationMs,\n317\t\t\tr.Method, r.URL.RequestURI(),\n318\t\t\tr.Header, reqBody,\n319\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n320\t\t\trespBody,\n321\t\t\tnil,\n322\t\t\tp.target,\n323\t\t)\n324\t\n325\t\tif w := p.getWriter(); w != nil {\n326\t\t\tif err := w.Write(record); err != nil {\n327\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n328\t\t\t}\n329\t\t} else {\n330\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n331\t\t}\n332\t\n333\t\t// 将响应返回给客户端\n334\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n335\t\tfor k, vals := range respHeaders {\n336\t\t\tfor _, v := range vals {\n337\t\t\t\tw.Header().Add(k, v)\n338\t\t\t}\n339\t\t}\n340\t\tw.WriteHeader(upstreamResp.StatusCode)\n341\t\t_, _ = w.Write(respBytes)\n342\t\n343\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n344\t}\n345\t\n346\t// buildRecord 构建一条 Trace 记录，包含请求/响应的完整信息。\n347\tfunc buildRecord(\n348\t\treqID string, turn, durationMs int,\n349\t\tmethod, path string,\n350\t\treqHeaders http.Header, reqBody any,\n351\t\tstatus int, respHeaders http.Header,\n352\t\trespBody any,\n353\t\tsseEvents []map[string]any,\n354\t\tupstreamBaseURL string,\n355\t) map[string]any {\n356\t\trecord := map[string]any{\n357\t\t\t\"timestamp\":   time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n358\t\t\t\"request_id\":  reqID,\n359\t\t\t\"session_id\":  extractSessionID(reqBody),\n360\t\t\t\"turn\":        turn,\n361\t\t\t\"duration_ms\": durationMs,\n362\t\t\t\"request\": map[string]any{\n363\t\t\t\t\"method\":  method,\n364\t\t\t\t\"path\":    path,\n365\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n366\t\t\t\t\"body\":    reqBody,\n367\t\t\t},\n368\t\t\t\"response\": map[string]any{\n369\t\t\t\t\"status\":  status,\n370\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n371\t\t\t\t\"body\":    respBody,\n372\t\t\t},\n373\t\t}\n374\t\tif len(sseEvents) > 0 {\n375\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n376\t\t}\n377\t\tif upstreamBaseURL != \"\" {\n378\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n379\t\t}\n380\t\treturn record\n381\t}\n382\t\n383\t// extractSessionID 从请求体的 metadata.user_id 字段中提取 session_id。\n384\t// Claude Code 发送的格式为：metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n385\tfunc extractSessionID(reqBody any) string {\n386\t\tbody, ok := reqBody.(map[string]any)\n387\t\tif !ok {\n388\t\t\treturn \"\"\n389\t\t}\n390\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n391\t\tif metadata == nil {\n392\t\t\treturn \"\"\n393\t\t}\n394\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n395\t\tif userIDRaw == \"\" {\n396\t\t\treturn \"\"\n397\t\t}\n398\t\tvar userData map[string]string\n399\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n400\t\t\treturn \"\"\n401\t\t}\n402\t\treturn userData[\"session_id\"]\n403\t}\n404\t\n405\t// handleInternal 分发内部代理端点请求。\n406\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n407\t\tswitch r.URL.Path {\n408\t\tcase \"/_internal/trace-init\":\n409\t\t\tp.handleTraceInit(w, r)\n410\t\tdefault:\n411\t\t\thttp.NotFound(w, r)\n412\t\t}\n413\t}\n414\t\n415\t// handleTraceInit 接收 SessionStart 钩子传来的会话信息，创建 Trace 写入器。\n416\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n417\t\tif r.Method != http.MethodPost {\n418\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n419\t\t\treturn\n420\t\t}\n421\t\n422\t\tvar req struct {\n423\t\t\tSessionID      string `json:\"session_id\"`\n424\t\t\tMachineID      string `json:\"machine_id\"`\n425\t\t\tProjectSlug    string `json:\"project_slug\"`\n426\t\t\tTranscriptPath string `json:\"transcript_path\"`\n427\t\t}\n428\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n429\t\t\tlogger.Warn(\"proxy\", \"trace-init: invalid JSON: %v\", err)\n430\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n431\t\t\treturn\n432\t\t}\n433\t\n434\t\tif req.SessionID == \"\" {\n435\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n436\t\t\treturn\n437\t\t}\n438\t\n439\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n440\t\n441\t\t// 若请求中未提供，则通过 trace 包自动检测\n442\t\tmachineID := req.MachineID\n443\t\tif machineID == \"\" {\n444\t\t\tmachineID = trace.MachineID()\n445\t\t}\n446\t\n447\t\tprojectSlug := req.ProjectSlug\n448\t\tif projectSlug == \"\" {\n449\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n450\t\t\tif projectSlug == \"\" {\n451\t\t\t\tprojectSlug = trace.DetectProjectName()\n452\t\t\t}\n453\t\t}\n454\t\n455\t\t// 创建会话专属的 Trace 写入器\n456\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n457\t\twriter, err := trace.NewTraceWriter(tracePath)\n458\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n459\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n460\t\tif err != nil {\n461\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n462\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n463\t\t\treturn\n464\t\t}\n465\t\n466\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n467\t\t\tif p.writer != nil {\n468\t\t\t\tp.writer.Close()\n469\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n470\t\t\t}\n471\t\tp.writer = writer\n472\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n473\t\n474\t\t// 通知外部注册 proxy.json\n475\t\tif p.OnSessionInit != nil {\n476\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n477\t\t}\n478\t\n479\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n480\t\tjson.NewEncoder(w).Encode(map[string]string{\n481\t\t\t\"status\":     \"ok\",\n482\t\t\t\"trace_path\": tracePath,\n483\t\t})\n484\t}\n485\t\n486\t// getWriter 返回当前会话的 Trace 写入器。\n487\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n488\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n489\t\treturn p.writer\n490\t}\n491\t\n492\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n493\t// 若无有效写入器，返回零值统计。\n494\tfunc (p *ReverseProxy) Summary() map[string]any {\n495\t\tif w := p.getWriter(); w != nil {\n496\t\t\treturn w.Summary()\n497\t\t}\n498\t\treturn map[string]any{\n499\t\t\t\"api_calls\":           0,\n500\t\t\t\"input_tokens\":        int64(0),\n501\t\t\t\"output_tokens\":       int64(0),\n502\t\t\t\"cache_read_tokens\":   int64(0),\n503\t\t\t\"cache_create_tokens\": int64(0),\n504\t\t}\n505\t}\n506\t\n507\t// SessionID 返回当前会话的 session_id。\n508\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n509\tfunc (p *ReverseProxy) SessionID() string {\n510\t\tif p.sessionID != \"\" {\n511\t\t\treturn p.sessionID\n512\t\t}\n513\t\tif w := p.getWriter(); w != nil {\n514\t\t\treturn w.SessionID()\n515\t\t}\n516\t\treturn \"\"\n517\t}\n518\t\n519\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n520\tfunc (p *ReverseProxy) ProjectSlug() string {\n521\t\treturn p.projectSlug\n522\t}\n523\t\n524\t// TracePath 返回当前追踪文件的完整路径。\n525\tfunc (p *ReverseProxy) TracePath() string {\n526\t\tif w := p.getWriter(); w != nil {\n527\t\t\treturn w.Path()\n528\t\t}\n529\t\treturn \"\"\n530\t}\n531\t"}]}
