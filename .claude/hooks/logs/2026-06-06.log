\"])","   }"," }"," "]},{"oldStart":235,"oldLines":7,"newStart":234,"newLines":7,"lines":["     t.Errorf(\"model = %q, want %q\", m, \"test-model\")","   }"," ","-  // assistant 消息被注入 thinking 块","+  // assistant 消息被注入 thinking 块 + reasoning_content","   messages := upstreamBody[\"messages\"].([]any)","   assistantMsg := messages[1].(map[string]any)","   content := assistantMsg[\"content\"].([]any)"]},{"oldStart":248,"oldLines":7,"newStart":247,"newLines":8,"lines":["   if firstBlock[\"type\"] != \"thinking\" {","     t.Errorf(\"first block type = %q, want %q\", firstBlock[\"type\"], \"thinking\")","   }","-n\t// 验证顶层 reasoning_content 字段被注入","+","+  // 验证顶层 reasoning_content 字段被注入","   if rc, ok := assistantMsg[\"reasoning_content\"].(string); !ok || rc != \"\" {","     t.Errorf(\"reasoning_content = %v, want empty string\", assistantMsg[\"reasoning_content\"])","   }"]},{"oldStart":315,"oldLines":18,"newStart":315,"newLines":22,"lines":["   }","   resp.Body.Close()"," ","-  // 验证 tool_use 消息未被修改","+  // 验证 tool_use 消息未被修改（无 thinking 块、无 reasoning_content）","   var upstreamBody map[string]any","   if err := json.Unmarshal(capturedBody, &upstreamBody); err != nil {","     t.Fatalf(\"parse upstream body: %v\", err)","   }"," ","   msgs := upstreamBody[\"messages\"].([]any)","-  assistantContent := msgs[1].(map[string]any)[\"content\"].([]any)","+  assistantMsg := msgs[1].(map[string]any)","+  assistantContent := assistantMsg[\"content\"].([]any)","   if len(assistantContent) != 1 {","     t.Errorf(\"non-thinking request content length = %d, want 1 (unchanged)\", len(assistantContent))","   }","   if assistantContent[0].(map[string]any)[\"type\"] != \"tool_use\" {","     t.Error(\"non-thinking request should not have thinking block injected\")","   }","+  if _, has := assistantMsg[\"reasoning_content\"]; has {","+    t.Error(\"non-thinking request should not have reasoning_content injected\")","+  }"," }"]}],"originalFile":"package proxy\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"testing\"\n)\n\n// TestInjectThinkingContent_Unit 直接测试 injectThinkingContent 函数的各种场景。\nfunc TestInjectThinkingContent_Unit(t *testing.T) {\n\ttests := []struct {\n\t\tname     string\n\t\treqBody  string\n\t\twantSame bool // true = 输出应与输入完全一致\n\t\twantLen  int  // 目标 assistant 消息的 content 数组期望长度\n\t}{\n\t\t{\n\t\t\tname:     \"无 thinking 字段 - 原样透传\",\n\t\t\treqBody:  `{\"model\":\"x\",\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"thinking disabled - 原样透传\",\n\t\t\treqBody:  `{\"thinking\":{\"type\":\"disabled\"},\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"thinking enabled + tool_use 无 thinking - 注入\",\n\t\t\treqBody:  `{\"thinking\":{\"type\":\"enabled\",\"budget_tokens\":10000},\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}]}]}`,\n\t\t\twantSame: false,\n\t\t\twantLen:  2,\n\t\t},\n\t\t{\n\t\t\tname:     \"thinking enabled 但已有 thinking 块和 reasoning_content - 原样透传\",\n\t\t\treqBody:  `{\"thinking\":{\"type\":\"enabled\"},\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"reasoning\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"n\",\"input\":{}}],\"reasoning_content\":\"reasoning\"}]}`,\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"空 body - 原样透传\",\n\t\t\treqBody:  \"\",\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"非 JSON body - 原样透传\",\n\t\t\treqBody:  \"this is not json\",\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"JSON 数组 body - 原样透传\",\n\t\t\treqBody:  `[1,2,3]`,\n\t\t\twantSame: true,\n\t\t},\n\t\t{\n\t\t\tname:     \"thinking enabled 但无 tool_use (纯文本 assistant) - 原样透传\",\n\t\t\treqBody:  `{\"thinking\":{\"type\":\"enabled\"},\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hello\"}]}]}`,\n\t\t\twantSame: true,\n\t\t},\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tvar parsed any\n\t\t\tif tt.reqBody != \"\" {\n\t\t\t\t_ = json.Unmarshal([]byte(tt.reqBody), &parsed)\n\t\t\t}\n\t\t\tresult := injectThinkingContent([]byte(tt.reqBody), parsed)\n\t\t\tif tt.wantSame {\n\t\t\t\tif string(result) != tt.reqBody {\n\t\t\t\t\tt.Errorf(\"expected passthrough, got: %s\", string(result))\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tvar m map[string]any\n\t\t\t\tif err := json.Unmarshal(result, &m); err != nil {\n\t\t\t\t\tt.Fatalf(\"result is not valid JSON: %v\", err)\n\t\t\t\t}\n\t\t\t\tmsgs := m[\"messages\"].([]any)\n\t\t\t\tcontent := msgs[0].(map[string]any)[\"content\"].([]any)\n\t\t\t\tif len(content) != tt.wantLen {\n\t\t\t\t\tt.Errorf(\"content length = %d, want %d\", len(content), tt.wantLen)\n\t\t\t\t}\n\t\t\t\t// 验证注入的 thinking 块在第一位\n\t\t\t\tfirst := content[0].(map[string]any)\n\t\t\t\tif first[\"type\"] != \"thinking\" {\n\t\t\t\t\tt.Errorf(\"first block type = %q, want %q\", first[\"type\"], \"thinking\")\n\t\t\t\t}\nt\t\t\t// 验证顶层 reasoning_content 字段被注入\n\t\t\t\tmsg := msgs[0].(map[string]any)\n\t\t\t\tif rc, ok := msg[\"reasoning_content\"].(string); !ok || rc != \"\" {\n\t\t\t\t\tt.Errorf(\"reasoning_content = %v, want empty string\", msg[\"reasoning_content\"])\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n\n// TestInjectThinkingContent_MixedMessages 测试混合消息场景：只有 tool_call 消息被注入。\nfunc TestInjectThinkingContent_MixedMessages(t *testing.T) {\n\treqBody := `{\n\t\t\"thinking\": {\"type\": \"enabled\", \"budget_tokens\": 10000},\n\t\t\"messages\": [\n\t\t\t{\"role\": \"user\", \"content\": \"read the file\"},\n\t\t\t{\"role\": \"assistant\", \"content\": [{\"type\": \"text\", \"text\": \"sure\"}]},\n\t\t\t{\"role\": \"user\", \"content\": \"do it\"},\n\t\t\t{\"role\": \"assistant\", 