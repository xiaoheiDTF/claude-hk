t empty string\", official.Model)\n50\t\t}\n51\t}\n52\t\n53\t// TestReadProfiles_WithModel 测试从文件读取含 model 的 profiles.json\n54\t// 来源：契约 1 — profiles.json ProfileConfig 结构\n55\tfunc TestReadProfiles_WithModel(t *testing.T) {\n56\t\t// 创建临时 profiles.json\n57\t\ttmpDir := t.TempDir()\n58\t\tconfigDir := filepath.Join(tmpDir, \".claude-tap-plus\")\n59\t\tif err := os.MkdirAll(configDir, 0o755); err != nil {\n60\t\t\tt.Fatal(err)\n61\t\t}\n62\t\n63\t\tprofilesContent := `{\n64\t\t\t\"default\": \"my-glm\",\n65\t\t\t\"profiles\": {\n66\t\t\t\t\"my-glm\": {\n67\t\t\t\t\t\"base_url\": \"https://api.example.com\",\n68\t\t\t\t\t\"api_key\": \"sk-test\",\n69\t\t\t\t\t\"model\": \"glm-5.1\"\n70\t\t\t\t}\n71\t\t\t}\n72\t\t}`\n73\t\tprofilesFile := filepath.Join(configDir, \"profiles.json\")\n74\t\tif err := os.WriteFile(profilesFile, []byte(profilesContent), 0o644); err != nil {\n75\t\t\tt.Fatal(err)\n76\t\t}\n77\t\n78\t\t// 覆盖 homeDir 使其指向临时目录\n79\t\torigHomeDir := homeDir\n80\t\tSetHomeDir(func() string { return tmpDir })\n81\t\tdefer func() { SetHomeDir(origHomeDir) }()\n82\t\n83\t\tpf, err := ReadProfiles()\n84\t\tif err != nil {\n85\t\t\tt.Fatalf(\"ReadProfiles: %v\", err)\n86\t\t}\n87\t\tif pf == nil {\n88\t\t\tt.Fatal(\"ReadProfiles returned nil\")\n89\t\t}\n90\t\n91\t\tglm, ok := pf.Profiles[\"my-glm\"]\n92\t\tif !ok {\n93\t\t\tt.Fatal(\"profile my-glm not found\")\n94\t\t}\n95\t\tif glm.Model != \"glm-5.1\" {\n96\t\t\tt.Errorf(\"model = %q, want %q\", glm.Model, \"glm-5.1\")\n97\t\t}\n98\t}\n99\t\n100\t// TestResolveProfileConfig_WithModel 测试解析指定 profile 并返回 model\n101\t// 来源：契约 1\n102\tfunc TestResolveProfileConfig_WithModel(t *testing.T) {\n103\t\ttmpDir := t.TempDir()\n104\t\tconfigDir := filepath.Join(tmpDir, \".claude-tap-plus\")\n105\t\tif err := os.MkdirAll(configDir, 0o755); err != nil {\n106\t\t\tt.Fatal(err)\n107\t\t}\n108\t\n109\t\tprofilesContent := `{\n110\t\t\t\"default\": \"with-model\",\n111\t\t\t\"profiles\": {\n112\t\t\t\t\"with-model\": {\n113\t\t\t\t