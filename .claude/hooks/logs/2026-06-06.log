e_tap_plus\\cmd\\claude-tap\\main.go:269:\t// 设置会话初始化回调：注册到 proxy.json\nclaude_tap_plus\\cmd\\claude-tap\\main.go:271:\t\tkey := ProxySessionKey(projectSlug, sessionID)\nclaude_tap_plus\\cmd\\claude-tap\\main.go:272:\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\nclaude_tap_plus\\cmd\\claude-tap\\main.go:276:\t// 代理退出时注销 proxy.json 中的会话\nclaude_tap_plus\\cmd\\claude-tap\\main.go:280:\t\t\tkey := ProxySessionKey(slug, sid)\nclaude_tap_plus\\cmd\\claude-tap\\main.go:281:\t\t\tif err := UnregisterProxySession(key); err != nil {\nclaude_tap_plus\\internal\\proxy\\reverse.go:33:\tOnSessionInit      func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\nclaude_tap_plus\\internal\\proxy\\reverse.go:547:\t// 通知外部注册 proxy.json\nclaude_tap_plus\\internal\\backend\\server.go:85:\t// 启动空闲 watchdog：每 30s 检查 proxy.json，持续空闲 10 分钟则关闭\nclaude_tap_plus\\internal\\backend\\service\\idle_watchdog.go:14:// proxySession 用于反序列化 proxy.json 中的会话条目。\nclaude_tap_plus\\internal\\backend\\service\\idle_watchdog.go:19:// IdleWatchdog 监控 proxy.json，当所有会话注销且持续空闲超过指定时间后，\nclaude_tap_plus\\internal\\backend\\service\\idle_watchdog.go:82:// proxyJSONPath 返回 proxy.json 的路径（~/.claude-tap-plus/proxy.json）。\nclaude_tap_plus\\internal\\backend\\service\\idle_watchdog.go:86:\t\treturn \".claude-tap-plus/proxy.json\"\nclaude_tap_plus\\internal\\backend\\service\\idle_watchdog.go:88:\treturn filepath.Join(home, \".claude-tap-plus\", \"proxy.json\")\nclaude_tap_plus\\internal\\backend\\service\\idle_watchdog.go:91:// countProxySessions 读取 proxy.json 并返回活跃会话数量。"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\proxy\\reverse.go","limit":50,"offset":590},"tool_use_id":"tool_U7ut3FMTx3u4g0O2Grnp3qTl","tool_response":"590\t}\n591\t\n592\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n593\tfunc (p *ReverseProxy) ProjectSlug() string {\n594\t\treturn p.projectSlug\n595\t}\n596\t\n597\t// TracePath 返回当前追踪文件的完整路径。\n598\tfunc (p *ReverseProxy) TracePath() string {\n599\t\tif w := p.getWriter(); w != nil {\n600\t\t\treturn w.Path()\n601\t\t}\n602\t\treturn \"\"\n603\t}\n604\t\n605\t// markUnavailable 标记上游不可用（契约 4）。\n606\t// 首次失败后置 upstreamAvailable = false，进程生命周期内不再恢复。\n607\tfunc (p *ReverseProxy) markUnavailable() {\n608\t\tp.availableMu.Lock()\n609\t\tdefer p.availableMu.Unlock()\n610\t\tif p.upstreamAvailable {\n611\t\t\tp.upstreamAvailable = false\n612\t\t\tlogger.Warn(\"proxy\", \"upstream marked unavailable, switching to fallback\")\n613\t\t}\n614\t}\n615\t\n616\t// SetModel 设置强制替换的模型名。\n617\tfunc (p *ReverseProxy) SetModel(model string) {\n618\t\tp.model = model\n619\t}\n620\t\n621\t// SetFallbackConfig 设置兜底配置。\n622\tfunc (p *ReverseProxy) SetFallbackConfig(cfg *FallbackConfig) {\n623\t\tp.fallbackConfig = cfg\n624\t}\n625\t\n626\t// SetKimiMode 启用或禁用 kimi 模式。\n627\t// 启用时会自动创建 reasoning_content 缓存。\n628\tfunc (p *ReverseProxy) SetKimiMode(kimi bool) {\n629\t\tp.kimiMode = kimi\n630\t\tif kimi && p.reasoningCache == nil {\n631\t\t\tp.reasoningCache = NewReasoningCache()\n632\t\t\tlogger.Info(\"proxy\", \"kimi mode enabled, reasoning_content caching active\")\n633\t\t}\n634\t}\n635\t\n636\t// IsKimiURL 判断 URL 是否为 kimi/moonshot 上游。\n637\tfunc IsKimiURL(url string) bool {\n638\t\tlower := strings.ToLower(url)\n639\t\treturn strings.Contains(lower, \"kimi\") || strings.Contains(lower, \"moonshot\")"}]}
