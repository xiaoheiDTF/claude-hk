on）\n34\t\tmodel              string              // 强制替换的模型名（空=不改写）\n35\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n36\t\tfallbackConfig     *FallbackConfig      // 兜底配置（上游不可用时切换）\n37\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfig 的并发安全\n38\t\tactualAddr         string              // 实际监听地址（启动后设置）\n39\t\treasoningCache     *ReasoningCache     // reasoning_content 缓存（仅 kimi 模式）\n40\t\tkimiMode           bool                // 是否为 kimi 上游\n41\t}\n42\t\n43\t// FallbackConfig 存储上游不可用时的兜底配置。\n44\ttype FallbackConfig struct {\n45\t\tBaseURL   string // 兜底上游 API 地址\n46\t\tModel     string // 兜底模型名\n47\t\tAuthToken string // 兜底认证 Token\n48\t\tAPIKey    string // 兜底 API Key\n49\t}\n50\t\n51\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n52\t// traceDir 为 Trace 文件存放的基础目录。\n53\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n54\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n55\t\treturn &ReverseProxy{\n56\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n57\t\t\tbaseDir:           traceDir,\n58\t\t\tupstreamAvailable: true,\n59\t\t\tclient: &http.Client{\n60\t\t\t\tTimeout: 0, // 流式场景不设超时\n61\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n62\t\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n63\t\t\t\t},\n64\t\t\t},\n65\t\t}\n66\t}\n67\t\n68\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n69\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n70\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n71\t\tmux := http.NewServeMux()\n72\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n73\t\tp.server = &http.Server{\n74\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n75\t\t\tHandler: mux,\n76\t\t}\n77\t\n78\t\tlistener, err := ioListener(p.server.Addr)\n79\t\tif err != nil {\n80\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\domain\\session.go"},"tool_use_id":"call_1b6fb6ced58d4a8fbf864d7c","tool_response":"1\t// Package domain 定义核心业务实体和枚举类型。\n2\tpackage domain\n3\t\n4\timport \"time\"\n5\t\n6\t// SessionStatus 表示会话的状态。\n7\ttype SessionStatus string\n8\t\n9\tconst (\n10\t\tSessionActive SessionStatus = \"active\" // 活跃会话\n11\t\tSessionClosed SessionStatus = \"closed\" // 已关闭\n12\t)\n13\t\n14\t// Session 对应 sessions 表，记录每次 Claude Code 会话的元数据。\n15\t// 后端只存元数据，消息内容存储在本地 JSONL 文件中。\n16\ttype Session struct {\n17\t\tID             int64         `json:\"id\"`\n18\t\tSessionID      string        `json:\"session_id\"`      // UUID，SessionStart hook 传入，UNIQUE\n19\t\tMachineID      string        `json:\"machine_id\"`       // whoami@hostname\n20\t\tOS             string        `json:\"os\"`               // windows/linux/macos\n21\t\tProjectSlug    string        `json:\"project_slug\"`     // 从 transcript_path 解析\n22\t\tProjectCwd     string        `json:\"project_cwd\"`      // SessionStart hook 的 cwd 字段\n23\t\tTranscriptPath string        `json:\"transcript_path\"`  // Claude Code hook 提供的 transcript_path，便于溯源\n24\t\tLocalTracePath string        `json:\"local_trace_path\"` // proxy 本地 trace 文件路径，由代理首次拦截该 session 的 API 调用时构造写入\n25\t\tModel          string        `json:\"model\"`            // SessionStart hook 的 model 字段\n26\t\tSource         string        `json:\"source\"`           // startup/resume\n27\t\tStatus         SessionStatus `json:\"status\"`           // active / closed，默认 active\n28\t\tRegisteredAt   time.Time     `json:\"registered_at\"`    // SessionStart 注册时间\n29\t\tClosedAt       *time.Time    `json:\"closed_at\"`        // SessionEnd 注销时间\n30\t\tCloseReason    string        `json:\"close_reason\"`     // SessionEnd 的 reason 字段（如 prompt_input_exit）\n31\t}\n32\t"}]}
