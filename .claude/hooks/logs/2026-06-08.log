adRequest, \"invalid_request\", \"repo_full_name is required\")\n44\t\t\treturn\n45\t\t}\n46\t\tif req.IssueNumbers == nil {\n47\t\t\twriteError(w, http.StatusBadRequest, \"invalid_request\", \"issue_numbers is required\")\n48\t\t\treturn\n49\t\t}\n50\t\n51\t\tlogger.Debug(\"api.issue\", \"POST /api/issue/check repo=%s\", req.RepoFullName)\n52\t\n53\t\t// 调用服务层查询 Issue 状态\n54\t\tresults, err := h.svc.Check(r.Context(), req.RepoFullName, req.IssueNumbers)\n55\t\tif err != nil {\n56\t\t\twriteError(w, http.StatusInternalServerError, \"internal_error\", \"failed to check issues\")\n57\t\t\treturn\n58\t\t}\n59\t\n60\t\t// 转换为响应格式\n61\t\titems := make([]IssueStatusItem, len(results))\n62\t\tfor i, r := range results {\n63\t\t\titems[i] = IssueStatusItem{\n64\t\t\t\tNumber:    r.Number,\n65\t\t\t\tStatus:    r.Status,\n66\t\t\t\tSessionID: r.SessionID,\n67\t\t\t\tClaimedAt: r.ClaimedAt,\n68\t\t\t}\n69\t\t}\n70\t\n71\t\t// 确保返回空数组而非 null\n72\t\tif items == nil {\n73\t\t\titems = []IssueStatusItem{}\n74\t\t}\n75\t\n76\t\twriteJSON(w, http.StatusOK, CheckIssuesResponse{Issues: items})\n77\t}\n78\t\n79\t// ClaimIssue 处理领取 Issue 的请求。\n80\t// 接收 POST 请求，将指定 Issue 标记为已领取状态。"}]}
