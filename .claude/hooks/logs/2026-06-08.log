tap_plus/internal/logger\"\n9\t)\n10\t\n11\t// Handlers 聚合所有 HTTP 处理器的结构体。\n12\ttype Handlers struct {\n13\t\tIssue   *IssueHandler   // Issue 相关接口处理器\n14\t\tSession *SessionHandler // Session 相关接口处理器\n15\t\tProxy   *ProxyHandler   // 代理注册和 trace-init 转发处理器\n16\t\tMachine *MachineHandler // Machine 相关接口处理器\n17\t\tProject *ProjectHandler // Project 相关接口处理器\n18\t\tLog     *LogHandler     // Log 相关接口处理器\n19\t\tConfig  *ConfigHandler  // Config 相关接口处理器\n20\t\tStatus  *StatusHandler  // 系统状态处理器\n21\t}\n22\t\n23\t// NewRouter 创建并返回 HTTP 路由器，注册所有 API 端点。\n24\tfunc NewRouter(h Handlers) http.Handler {\n25\t\tmux := http.NewServeMux()\n26\t\t// 健康检查端点\n27\t\tmux.HandleFunc(\"/health\", Health)\n28\t\n29\t\t// Issue 相关路由。\n30\t\tmux.HandleFunc(\"/api/issue/check\", h.Issue.CheckIssues)         // 检查 Issue 状态\n31\t\tmux.HandleFunc(\"/api/issue/claim\", h.Issue.ClaimIssue)          // 领取 Issue\n32\t\tmux.HandleFunc(\"/api/issue/release\", h.Issue.ReleaseIssue)      // 释放 Issue\n33\t\tmux.HandleFunc(\"/api/issue/release-session\", h.Issue.ReleaseSession) // 释放会话下所有 Issue\n34\t\tmux.HandleFunc(\"/api/issue/status\", h.Issue.UpdateStatus)       // 更新 Issue 状态\n35\t\tmux.HandleFunc(\"/api/issues\", h.Issue.ListIssues)               // 列出所有 Issue\n36\t\n37\t\t// Session 相关路由。\n38\t\tmux.HandleFunc(\"/api/session/register\", h.Session.Register) // 注册会话\n39\t\tmux.HandleFunc(\"/api/session/close\", h.Session.Close)       // 关闭会话\n40\t\tmux.HandleFunc(\"/api/sessions\", h.Session.List)             // 获取会话列表\n41\t\tmux.HandleFunc(\"/api/session/\", func(w http.ResponseWriter, r *http.Request) {\n42\t\t\tpath := r.URL.Path\n43\t\t\tswitch {\n44\t\t\tcase strings.HasSuffix(path, \"/issues\"):\n45\t\t\t\th.Session.GetIssues(w, r)\n46\t\t\tcase strings.HasSuffix(path, \"/tokens\"):\n47\t\t\t\th.Session.GetTokens(w, r)\n48\t\t\tcase strings.HasSuffix(path, \"/traces\"):\n49\t\t\t\th.Session.GetTraces(w, r)\n50\t\t\tdefault:\n51\t\t\t\th.Session.Get(w, r)\n52\t\t\t}\n53\t\t})\n54\t\n55\t\t// Proxy 相关路由（代理注册 + trace-init 转发 + 代理列表）。\n56\t\tif h.Proxy != nil {\n57\t\t\tmux.HandleFunc(\"/api/proxy/register\", h.Proxy.Register)     // 代理注册\n58\t\t\tmux.HandleFunc(\"/api/proxy/unregister\", h.Proxy.Unregister) // 代理注销\n59\t\t\tmux.HandleFunc(\"/api/proxy/trace-init\", h.Proxy.TraceInit)  // 转发 trace-init\n60\t\t\tmux.HandleFunc(\"/api/proxies\", h.Proxy.List)                // 代理列表\n61\t\t}\n62\t\n63\t\t// Machine 相关路由。\n64\t\tif h.Machine != nil {\n65\t\t\tmux.HandleFunc(\"/api/machines\", h.Machine.List) // 列出所有机器\n66\t\t}\n67\t\n68\t\t// Project 相关路由。\n69\t\tif h.Project != nil {\n70\t\t\tmux.HandleFunc(\"/api/projects\", h.Project.List) // 列出所有项目\n71\t\t}\n72\t\n73\t\t// Log 相关路由。\n74\t\tif h.Log != nil {\n75\t\t\tmux.HandleFunc(\"/api/logs\", h.Log.Query) // 查询日志\n76\t\t}\n77\t\n78\t\t// Config 相关路由（GET + PUT 分发）。\n79\t\tif h.Config != nil {\n80\t\t\tmux.HandleFunc(\"/api/config\", h.Config.ServeHTTP) // 获取/更新配置\n81\t\t}\n82\t\n83\t\t// Status 相关路由。\n84\t\tif h.Status != nil {\n85\t\t\tmux.HandleFunc(\"/api/status\", h.Status.Get) // 系统状态\n86\t\t}\n87\t\n88\t\tlogger.Debug(\"api\", \"routes registered: %d endpoints\", 15)\n89\t\treturn mux\n90\t}\n91\t"}]}
