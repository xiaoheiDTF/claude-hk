medAt    *time.Time  `json:\"claimed_at\"`     // 领取时间，idle 时为 null\n\tUpdatedAt    time.Time   `json:\"updated_at\"`     // 最后更新时间\n}\n","numLines":34,"startLine":1,"totalLines":34}},"tool_use_id":"call_1de96ad8869049e78c7a17b3","duration_ms":1}
