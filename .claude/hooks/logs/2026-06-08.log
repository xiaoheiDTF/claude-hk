  // 领取者的 session_id，idle 时为空\n\tClaimedAt    *time.Time  `json:\"claimed_at\"`     // 领取时间，idle 时为 null\n\tUpdatedAt    time.Time   `json:\"updated_at\"`     // 最后更新时间\n}\n","numLines":34,"startLine":1,"totalLines":34}},"tool_use_id":"call_215b6269ba7343e693b89cf5","duration_ms":0}
