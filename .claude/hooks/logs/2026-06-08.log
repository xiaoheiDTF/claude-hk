ng      `json:\"session_id\"`     // 领取者的 session_id，idle 时为空\n31\t\tClaimedAt    *time.Time  `json:\"claimed_at\"`     // 领取时间，idle 时为 null\n32\t\tUpdatedAt    time.Time   `json:\"updated_at\"`     // 最后更新时间\n33\t}\n34\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\errors.go"},"tool_use_id":"call_db4686e83d424c1e851e5ff2","tool_response":"1\t// Package backend 是后端服务的主包，提供 HTTP API 服务器及其配置。\n2\tpackage backend\n3\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\service\\status_service.go"},"tool_use_id":"call_75c86480204d48199f33b0c3","tool_response":"1\t// Package service 提供后端业务逻辑层。\n2\tpackage service\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"fmt\"\n7\t\t\"time\"\n8\t\n9\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n10\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n11\t)\n12\t\n13\t// SystemStats 是系统统计信息。\n14\ttype SystemStats struct {\n15\t\tActiveSessions int64 // 活跃会话数\n16\t\tActiveProxies  int64 // 活跃代理数\n17\t\tPendingIssues  int64 // 待处理 Issue 数\n18\t\tTotalMachines  int64 // 机器总数\n19\t\tTotalProjects  int64 // 项目总数\n20\t}\n21\t\n22\t// SystemStatus 表示系统整体状态。\n23\ttype SystemStatus struct {\n24\t\tStatus        string       // 系统状态：healthy\n25\t\tVersion       string       // 版本号\n26\t\tUptimeSeconds int64        // 运行时间（秒）\n27\t\tStats         SystemStats  // 统计信息\n28\t\tTimestamp     time.Time    // 当前时间戳\n29\t}\n30\t\n31\t// StatusService 聚合各子系统的统计数据。\n32\ttype StatusService struct {\n33\t\tsessionStore store.SessionStore\n34\t\tproxyStore   store.ProxyStore\n35\t\tissueStore   store.IssueStore\n36\t\tmachineStore store.MachineStore\n37\t\tprojectStore store.ProjectStore\n38\t\tstartTime    time.Time\n39\t}\n40\t\n41\t// NewStatusService 创建 StatusService 实例。\n42\tfunc NewStatusService(\n43\t\tsessionStore store.SessionStore,\n44\t\tproxyStore store.ProxyStore,\n45\t\tissueStore store.IssueStore,\n46\t\tmachineStore store.MachineStore,\n47\t\tprojectStore store.ProjectStore,\n48\t\tstartTime time.Time,\n49\t) *StatusService {\n50\t\treturn &StatusService{\n51\t\t\tsessionStore: sessionStore,\n52\t\t\tproxyStore:   proxyStore,\n53\t\t\tissueStore:   issueStore,\n54\t\t\tmachineStore: machineStore,\n55\t\t\tprojectStore: projectStore,\n56\t\t\tstartTime:    startTime,\n57\t\t}\n58\t}\n59\t\n60\t// Get 获取系统整体状态。\n61\tfunc (svc *StatusService) Get(ctx context.Context) (*SystemStatus, error) {\n62\t\tlogger.Debug(\"svc.status\", \"Get\")\n63\t\n64\t\tactiveSessions, err := svc.countActiveSessions(ctx)\n65\t\tif err != nil {\n66\t\t\treturn nil, fmt.Errorf(\"count active sessions: %w\", err)\n67\t\t}\n68\t\n69\t\tactiveProxies, err := svc.countActiveProxies(ctx)\n70\t\tif err != nil {\n71\t\t\treturn nil, fmt.Errorf(\"count active proxies: %w\", err)\n72\t\t}\n73\t\n74\t\tpendingIssues, err := svc.countPendingIssues(ctx)\n75\t\tif err != nil {\n76\t\t\treturn nil, fmt.Errorf(\"count pending issues: %w\", err)\n77\t\t}\n78\t\n79\t\ttotalMachines, err := svc.countMachines(ctx)\n80\t\tif err != nil {\n81\t\t\treturn nil, fmt.Errorf(\"count machines: %w\", err)\n82\t\t}\n83\t\n84\t\ttotalProjects, err := svc.countProjects(ctx)\n85\t\tif err != nil {\n86\t\t\treturn nil, fmt.Errorf(\"count projects: %w\", err)\n87\t\t}\n88\t\n89\t\tuptime := int64(time.Since(svc.startTime).Seconds())\n90\t\n91\t\treturn &SystemStatus{\n92\t\t\tStatus:        \"healthy\",\n93\t\t\tVersion:       \"1.0.0\",\n94\t\t\tUptimeSeconds: uptime,\n95\t\t\tStats: SystemStats{\n96\t\t\t\tActiveSessions: activeSessions,\n97\t\t\t\tActiveProxies:  activeProxies,\n98\t\t\t\tPendingIssues:  pendingIssues,\n99\t\t\t\tTotalMachines:  totalMachines,\n100\t\t\t\tTotalProjects:  totalProjects,\n101\t\t\t},\n102\t\t\tTimestamp: time.Now().UTC(),\n103\t\t}, nil\n104\t}\n105\t\n106\tfunc (svc *StatusService) countActiveSessions(ctx context.Context) (int64, error) {\n107\t\tactive := \"active\"\n108\t\tsessions, err := svc.sessionStore.ListSessions(ctx, store.SessionFilter{Status: &active})\n109\t\tif err != nil {\n110\t\t\treturn 0, err\n111\t\t}\n112\t\treturn int64(len(sessions)), nil\n113\t}\n114\t\n115\tfunc (svc *StatusService) countActiveProxies(ctx context.Context) (int64, error) {\n116\t\tactive := \"active\"\n117\t\tproxies, err := svc.proxyStore.ListProxies(ctx, store.ProxyFilter{Status: &active})\n118\t\tif err != nil {\n119\t\t\treturn 0, err\n120\t\t}\n121\t\treturn int64(len(proxies)), nil\n122\t}\n123\t\n124\tfunc (svc *StatusService) countPendingIssues(ctx context.Context) (int64, error) {\n125\t\tidle := \"idle\"\n126\t\t_, total, err := svc.issueStore.ListIssues(ctx, store.IssueFilter{Status: &idle})\n127\t\tif err != nil {\n128\t\t\treturn 0, err\n129\t\t}\n130\t\treturn int64(total), nil\n131\t}\n132\t\n133\tfunc (svc *StatusService) countMachines(ctx context.Context) (int64, error) {\n134\t\tmachines, err := svc.machineStore.ListMachines(ctx, store.MachineFilter{})\n135\t\tif err != nil {\n136\t\t\treturn 0, err\n137\t\t}\n138\t\treturn int64(len(machines)), nil\n139\t}\n140\t\n141\tfunc (svc *StatusService) countProjects(ctx context.Context) (int64, error) {\n142\t\tprojects, err := svc.projectStore.ListProjects(ctx)\n143\t\tif err != nil {\n144\t\t\treturn 0, err\n145\t\t}\n146\t\treturn int64(len(projects)), nil\n147\t}\n148\t"}]}
