    // Issue 标题（可为 NULL）\n49\t\tStatus       string     // 当前状态\n50\t\tSessionID    *string    // 领取者的 session ID\n51\t\tClaimedAt    *time.Time // 领取时间\n52\t\tUpdatedAt    time.Time  // 更新时间\n53\t}\n54\t\n55\t// IssueStore 定义 Issue 数据存储的接口。\n56\ttype IssueStore interface {\n57\t\tCheckIssues(ctx context.Context, repo string, numbers []int) ([]IssueCheckResult, error)\n58\t\tClaimIssue(ctx context.Context, repo string, number int, sessionID string, issueTitle string) (*ClaimResult, error)\n59\t\tUpdateIssueStatus(ctx context.Context, repo string, number int, sessionID string, newStatus string) (*UpdateStatusResult, error)\n60\t\tReleaseIssue(ctx context.Context, repo string, number int, sessionID string) (bool, error)\n61\t\tReleaseSessionIssues(ctx context.Context, sessionID string) ([]int, error)\n62\t\tListIssues(ctx context.Context, filter IssueFilter) ([]IssueListItem, int, error)\n63\t\tListIssuesBySession(ctx context.Context, sessionID string) ([]IssueListItem, error)\n64\t}\n65\t\n66\t// IssueCheckResult 表示单个 Issue 的状态查询结果。\n67\ttype IssueCheckResult struct {\n68\t\tNumber    int     // Issue 编号\n69\t\tStatus    string  // 当前状态\n70\t\tSessionID *string // 领取者 session ID\n71\t\tClaimedAt *string // 领取时间\n72\t}\n73\t\n74\t// --- Session types ---\n75\t\n76\t// Session 表示会话实体（对应数据库 sessions 表）。\n77\ttype Session struct {\n78\t\tSessionID      string     // 会话唯一 ID\n79\t\tMachineID      string     // 机器标识\n80\t\tOS             string     // 操作系统\n81\t\tProjectSlug    string     // 项目标识\n82\t\tProjectCwd     string     // 项目工作目录\n83\t\tTranscriptPath string     // 对话记录路径\n84\t\tLocalTracePath string     // 本地跟踪路径\n85\t\tModel          string     // 使用的模型\n86\t\tSource         string     // 来源\n87\t\tStatus         string     // 状态\n88\t\tRegisteredAt   time.Time  // 注册时间\n89\t\tClosedAt       *time.Time // 关闭时间\n90\t\tCloseReason    string     // 关闭原因\n91\t}\n92\t\n93\t// SessionFilter 是会话列表的过滤条件（指针类型支持省略条件）。\n94\ttype SessionFilter struct {\n95\t\tMachineID   *string // 按机器 ID 过滤\n96\t\tProjectSlug *string // 按项目标识过滤\n97\t\tStatus      *string // 按状态过滤\n98\t}\n99\t\n100\t// SessionStore 定义 Session 数据存储的接口。\n101\ttype SessionStore interface {\n102\t\tRegisterSession(ctx context.Context, s Session) error\n103\t\tCloseSession(ctx context.Context, sessionID string, reason string) error\n104\t\tListSessions(ctx context.Context, filter SessionFilter) ([]Session, error)\n105\t\tGetSession(ctx context.Context, sessionID string) (*Session, error)\n106\t\tCleanupTimedOut(ctx context.Context) (int, error)\n107\t}\n108\t\n109\t// --- Machine types ---\n110\t\n111\t// Machine 表示机器实体（对应数据库 machines 表）。\n112\ttype Machine struct {\n113\t\tID          int64      // 记录 ID\n114\t\tMachineID   string     // 机器标识，格式 username@hostname\n115\t\tOS          string     // 操作系统\n116\t\tHostname    string     // 主机名\n117\t\tUsername    string     // 用户名\n118\t\tFirstSeenAt time.Time  // 首次发现时间\n119\t\tLastSeenAt  *time.Time // 最后发现时间\n120\t}\n121\t\n122\t// MachineFilter 是机器列表的过滤条件。\n123\ttype MachineFilter struct {\n124\t\tOS       *string // 按操作系统过滤\n125\t\tHostname *string // 按主机名过滤\n126\t}\n127\t\n128\t// MachineStore 定义 Machine 数据存储的接口。\n129\ttype MachineStore interface {\n130\t\tListMachines(ctx context.Context, filter MachineFilter) ([]Machine, error)\n131\t\tGetMachine(ctx context.Context, machineID string) (*Machine, error)\n132\t}\n133\t\n134\t// --- Project types ---\n135\t\n136\t// Project 表示项目实体（对应数据库 projects 表）。\n137\ttype Project struct {\n138\t\tID          int64     // 记录 ID\n139\t\tProjectSlug string    // 项目标识\n140\t\tProjectCwd  string    // 项目工作目录\n141\t\tFirstSeenAt time.Time // 首次发现时间\n142\t\tLastSeenAt  time.Time // 最后发现时间\n143\t}\n144\t\n145\t// ProjectStore 定义 Project 数据存储的接口。\n146\ttype ProjectStore interface {\n147\t\tListProjects(ctx context.Context) ([]Project, error)\n148\t\tGetProject(ctx context.Context, projectSlug string) (*Project, error)\n149\t}\n150\t\n151\t// --- Config types ---\n152\t\n153\t// ConfigStore 定义系统配置存储的接口。\n154\ttype ConfigStore interface {\n155\t\tGetConfig(ctx context.Context) (map[string]interface{}, error)\n156\t\tUpdateConfig(ctx context.Context, updates map[string]interface{}) error\n157\t}\n158\t\n159\t// --- Proxy types ---\n160\t\n161\t// Proxy 表示代理实体（对应数据库 proxies 表）。\n162\ttype Proxy struct {\n163\t\tProxyID      string     // 代理唯一 ID\n164\t\tProjectSlug  string     // 项目标识\n165\t\tStatus       string     // 状态：active/offline\n166\t\tRegisteredAt time.Time  // 注册时间\n167\t\tLastPingAt   *time.Time // 最后心跳时间（可为 NULL）\n168\t}\n169\t\n170\t// ProxyFilter 是代理列表的过滤条件。\n171\ttype ProxyFilter struct {\n172\t\tStatus  *string // 按状态过滤\n173\t\tProject *string // 按 project_slug 过滤\n174\t}\n175\t\n176\t// ProxyStore 定义代理数据存储的接口。\n177\ttype ProxyStore interface {\n178\t\tListProxies(ctx context.Context, filter ProxyFilter) ([]Proxy, error)\n179\t}\n180\t\n181\t// --- Store aggregate ---\n182\t\n183\t// Store 是统一的数据存储聚合接口。\n184\ttype Store interface {\n185\t\tIssues() IssueStore     // 返回 Issue 存储\n186\t\tSessions() SessionStore // 返回 Session 存储\n187\t\tMachines() MachineStore // 返回 Machine 存储\n188\t\tProjects() ProjectStore // 返回 Project 存储\n189\t\tConfigs() ConfigStore   // 返回 Config 存储\n190\t\tProxies() ProxyStore    // 返回 Proxy 存储\n191\t\tClose() error           // 关闭存储连接\n192\t}\n193\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\server.go"},"tool_use_id":"call_89863026e41841059e7a08e3","tool_response":"1\t// Package backend 是后端服务的主包，提供 HTTP API 服务器及其配置。\n2\tpackage backend\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\t\"fmt\"\n7\t\t\"net/http\"\n8\t\t\"os\"\n9\t\t\"os/signal\"\n10\t\t\"syscall\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/api\"\n14\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/service\"\n15\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n16\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n17\t)\n18\t\n19\t// Server 是后端 HTTP 服务的主结构体，聚合配置和数据存储。\n20\ttype Server struct {\n21\t\tcfg   Config         // 服务配置\n22\t\tstore *store.SQLiteStore // SQLite 数据存储\n23\t}\n24\t\n25\t// NewServer 创建并初始化后端服务器。\n26\t// 根据配置打开 SQLite 数据库，失败时返回错误。\n27\tfunc NewServer(cfg Config) (*Server, error) {\n28\t\tlogger.Debug(\"backend\", \"creating server: host=%s port=%d db=%s\", cfg.Host, cfg.Port, cfg.DBPath)\n29\t\ts, err := store.NewSQLiteStore(cfg.DBPath)\n30\t\tif err != nil {\n31\t\t\treturn nil, fmt.Errorf(\"open database: %w\", err)\n32\t\t}\n33\t\treturn &Server{cfg: cfg, store: s}, nil\n34\t}\n35\t\n36\t// Start 启动 HTTP 服务器。\n37\t// 启动前会清理超时会话，然后注册路由并开始监听。支持优雅关闭（SIGINT/SIGTERM）。\n38\tfunc (s *Server) Start() error {\n39\t\t// 启动清理：将超时会话标记为已关闭\n40\t\tcleanupSvc := service.NewCleanupService(s.store.Sessions())\n41\t\tcleanupSvc.CleanupTimedOutSessions(context.Background())\n42\t\tlogger.Info(\"backend\", \"startup cleanup done\")\n43\t\n44\t\t// 初始化业务服务和处理器\n45\t\tissueSvc := service.NewIssueService(s.store.Issues())\n46\t\tsessionSvc := service.NewSessionService(s.store.Sessions())\n47\t\tmachineSvc := service.NewMachineService(s.store.Machines())\n48\t\tprojectSvc := service.NewProjectService(s.store.Projects())\n49\t\ttokenSvc := service.NewTokenService(s.store.Sessions())\n50\t\ttraceSvc := service.NewTraceService(s.store.Sessions())\n51\t\tlogSvc := service.NewLogService(s.cfg.LogDir)\n52\t\tconfigSvc := service.NewConfigService(s.store.Configs())\n53\t\tproxySvc := service.NewProxyService(s.store.Proxies())\n54\t\tstatusSvc := service.NewStatusService(\n55\t\t\ts.store.Sessions(), s.store.Proxies(),\n56\t\t\ts.store.Issues(), s.store.Machines(), s.store.Projects(),\n57\t\t\ttime.Now(),\n58\t\t)\n59\t\n60\t\trouter := api.NewRouter(api.Handlers{\n61\t\t\tIssue:   api.NewIssueHandler(issueSvc),\n62\t\t\tSession: api.NewSessionHandler(sessionSvc, issueSvc, tokenSvc, traceSvc),\n63\t\t\tProxy:   api.NewProxyHandlerWithService(proxySvc),\n64\t\t\tMachine: api.NewMachineHandler(machineSvc),\n65\t\t\tProject: api.NewProjectHandler(projectSvc),\n66\t\t\tLog:     api.NewLogHandler(logSvc),\n67\t\t\tConfig:  api.NewConfigHandler(configSvc),\n68\t\t\tStatus:  api.NewStatusHandler(statusSvc),\n69\t\t})\n70\t\n71\t\t// 创建 HTTP 服务器\n72\t\tsrv := &http.Server{\n73\t\t\tAddr:    s.cfg.Addr(),\n74\t\t\tHandler: router,\n75\t\t}\n76\t\n77\t\t// 监听系统信号以实现优雅关闭\n78\t\tquit := make(chan os.Signal, 1)\n79\t\tsignal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)\n80\t\n81\t\t// 创建可取消的 context 用于停止 watchdog\n82\t\tctx, cancel := context.WithCancel(context.Background())\n83\t\tdefer cancel()\n84\t\n85\t\t// 启动空闲 watchdog：每 30s 检查 proxy.json，持续空闲 10 分钟则关闭\n86\t\twatchdog := service.NewIdleWatchdog(30*time.Second, 10*time.Minute, func() {\n87\t\t\tlogger.Info(\"backend\", \"watchdog triggered shutdown\")\n88\t\t\tsrv.Shutdown(context.Background())\n89\t\t\tcancel() // 停止 watchdog 自身\n90\t\t})\n91\t\tgo watchdog.Run(ctx)\n92\t\n93\t\tgo func() {\n94\t\t\t<-quit\n95\t\t\tlogger.Info(\"backend\", \"shutdown signal received\")\n96\t\t\tcancel() // 停止 watchdog\n97\t\t\tsrv.Shutdown(context.Background())\n98\t\t}()\n99\t\n100\t\tlogger.Info(\"backend\", \"backend listening on %s\", s.cfg.Addr())\n101\t\tif err := srv.ListenAndServe(); err != http.ErrServerClosed {\n102\t\t\treturn err\n103\t\t}\n104\t\treturn nil\n105\t}\n106\t\n107\t// Close 关闭后端服务器及其数据库连接。\n108\tfunc (s *Server) Close() error {\n109\t\terr := s.store.Close()\n110\t\tlogger.Info(\"backend\", \"backend server closed\")\n111\t\treturn err\n112\t}\n113\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\CodeDevelopment\\CodeProject\\claude-hk\\claude_tap_plus\\internal\\backend\\service\\issue_service.go"},"tool_use_id":"call_42e6538ab02e4d68924d29ed","tool_response":"1\t// Package service 提供后端业务逻辑层。\n2\tpackage service\n3\t\n4\timport (\n5\t\t\"context\"\n6\t\n7\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/backend/store\"\n8\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n9\t)\n10\t\n11\t// IssueService 处理 Issue 相关的业务逻辑。\n12\ttype IssueService struct {\n13\t\tstore store.IssueStore // Issue 数据存储接口\n14\t}\n15\t\n16\t// NewIssueService 创建 IssueService 实例。\n17\tfunc NewIssueService(s store.IssueStore) *IssueService {\n18\t\treturn &IssueService{store: s}\n19\t}\n20\t\n21\t// Check 检查指定仓库中多个 Issue 的当前状态。\n22\tfunc (svc *IssueService) Check(ctx context.Context, repo string, numbers []int) ([]store.IssueCheckResult, error) {\n23\t\tlogger.Debug(\"svc.issue\", \"Check: repo=%s numbers=%v\", repo, numbers)\n24\t\treturn svc.store.CheckIssues(ctx, repo, numbers)\n25\t}\n26\t\n27\t// Claim 尝试用指定 session 领取某个 Issue。\n28\t// 返回领取结果：成功时包含状态和时间，失败时包含当前持有者信息。\n29\tfunc (svc *IssueService) Claim(ctx context.Context, repo string, number int, sessionID string, issueTitle string) (*store.ClaimResult, error) {\n30\t\tlogger.Debug(\"svc.issue\", \"Claim: repo=%s #%d session=%s\", repo, number, sessionID)\n31\t\treturn svc.store.ClaimIssue(ctx, repo, number, sessionID, issueTitle)\n32\t}\n33\t\n34\t// UpdateStatus 更新指定 Issue 的状态（仅当前持有者可更新）。\n35\tfunc (svc *IssueService) UpdateStatus(ctx context.Context, repo string, number int, sessionID string, newStatus string) (*store.UpdateStatusResult, error) {\n36\t\tlogger.Debug(\"svc.issue\", \"UpdateStatus: repo=%s #%d session=%s -> %s\", repo, number, sessionID, newStatus)\n37\t\treturn svc.store.UpdateIssueStatus(ctx, repo, number, sessionID, newStatus)\n38\t}\n39\t\n40\t// Release 释放指定 session 持有的某个 Issue（仅限非终态）。\n41\t// 返回是否成功释放。\n42\tfunc (svc *IssueService) Release(ctx context.Context, repo string, number int, sessionID string) (bool, error) {\n43\t\tlogger.Debug(\"svc.issue\", \"Release: repo=%s #%d session=%s\", repo, number, sessionID)\n44\t\treturn svc.store.ReleaseIssue(ctx, repo, number, sessionID)\n45\t}\n46\t\n47\t// ReleaseSession 释放指定 session 持有的所有非终态 Issue。\n48\t// 返回被释放的 Issue 编号列表。\n49\tfunc (svc *IssueService) ReleaseSession(ctx context.Context, sessionID string) ([]int, error) {\n50\t\tlogger.Debug(\"svc.issue\", \"ReleaseSession: session=%s\", sessionID)\n51\t\treturn svc.store.ReleaseSessionIssues(ctx, sessionID)\n52\t}\n53\t\n54\t// List 获取 Issue 列表，支持过滤和分页。\n55\t// 返回 Issue 列表和总数量。\n56\tfunc (svc *IssueService) List(ctx context.Context, filter store.IssueFilter) ([]store.IssueListItem, int, error) {\n57\t\tlogger.Debug(\"svc.issue\", \"List: filter applied\")\n58\t\treturn svc.store.ListIssues(ctx, filter)\n59\t}\n60\t\n61\t// ListBySession 获取指定 session 的 Issue 列表。\n62\tfunc (svc *IssueService) ListBySession(ctx context.Context, sessionID string) ([]store.IssueListItem, error) {\n63\t\tlogger.Debug(\"svc.issue\", \"ListBySession: session=%s\", sessionID)\n64\t\treturn svc.store.ListIssuesBySession(ctx, sessionID)\n65\t}\n66\t"}]}
