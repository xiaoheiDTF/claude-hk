ication/json\", strings.NewReader(initBody))\n43\t\tif err != nil {\n44\t\t\tt.Fatalf(\"trace-init: %v\", err)\n45\t\t}\n46\t\tdefer resp.Body.Close()\n47\t\n48\t\tvar initResult struct {\n49\t\t\tStatus    string `json:\"status\"`\n50\t\t\tTracePath string `json:\"trace_path\"`\n51\t\t}\n52\t\tif err := json.NewDecoder(resp.Body).Decode(&initResult); err != nil {\n53\t\t\tt.Fatalf(\"parse trace-init response: %v\", err)\n54\t\t}\n55\t\tif initResult.Status != \"ok\" {\n56\t\t\tt.Fatalf(\"trace-init failed: %s\", initResult.Status)\n57\t\t}\n58\t\n59\t\ttracePath := initResult.TracePath\n60\t\n61\t\treturn proxyURL, tracePath\n62\t}\n63\t\n64\t// TestNonStreamingRequest 验证：非流式请求正常转发，响应正确，且追踪记录包含脱敏后的请求头。\n65\tfunc TestNonStreamingRequest(t *testing.T) {\n66\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n67\t\tmockServer := testutil.CreateMockServer(t, fx)\n68\t\tdefer mockServer.Close()\n69\t\n70\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n71\t\n72\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n73\t\ttestutil.AssertResponseStatus(t, resp, 200)\n74\t\n75\t\tbody := testutil.DrainAndClose(t, resp)\n76\t\tvar respBody map[string]any\n77\t\tif err := json.Unmarshal(body, &respBody); err != nil {\n78\t\t\tt.Fatalf(\"parse response: %v\", err)\n79\t\t}\n80\t\n81\t\tif respBody[\"type\"] != \"message\" {\n82\t\t\tt.Errorf(\"response type: got %v, want message\", respBody[\"type\"])\n83\t\t}\n84\t\tif respBody[\"stop_reason\"] != \"tool_use\" {\n85\t\t\tt.Errorf(\"stop_reason: got %v, want tool_use\", respBody[\"stop_reason\"])\n86\t\t}\n87\t\n88\t\t// 验证追踪记录\n89\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n90\t\tif len(records) != 1 {\n91\t\t\tt.Fatalf(\"expected 1 trace record, got %d\", len(records))\n92\t\t}\n93\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n94\t\n95\t\t// 验证请求头中的敏感信息已被脱敏\n96\t\treqHeaders, _ := records[0][\"request\"].(map[string]any)[\"headers\"].(map[string]any)\n97\t\tif auth, ok := reqHeaders[\"Authorization\"].(string); ok {\n98\t\t\tif auth == \"Bearer sk-ant-test-key-12345678\" {\n99\t\t\t\tt.Error(\"Authorization header not redacted in trace\")\n100\t\t\t}\n101\t\t}\n102\t\tif apiKey, ok := reqHeaders[\"X-Api-Key\"].(string); ok {\n103\t\t\tif apiKey == \"sk-ant-test-key-12345678\" {\n104\t\t\t\tt.Error(\"X-Api-Key not redacted in trace\")\n105\t\t\t}\n106\t\t}\n107\t}\n108\t\n109\t// TestStreamingSSE 验证：SSE 流式请求正常转发，响应包含所有事件，且追踪记录正确。\n110\tfunc TestStreamingSSE(t *testing.T) {\n111\t\tfx := testutil.LoadFixture(t, \"streaming_anthropic.json\")\n112\t\tmockServer := testutil.CreateMockServer(t, fx)\n113\t\tdefer mockServer.Close()\n114\t\n115\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n116\t\n117\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n118\t\ttestutil.AssertResponseStatus(t, resp, 200)\n119\t\n120\t\tbody := testutil.DrainAndClose(t, resp)\n121\t\tbodyStr := string(body)\n122\t\n123\t\t// 验证响应中包含所有 SSE 事件\n124\t\tif !strings.Contains(bodyStr, \"message_start\") {\n125\t\t\tt.Error(\"response missing message_start event\")\n126\t\t}\n127\t\tif !strings.Contains(bodyStr, \"content_block_delta\") {\n128\t\t\tt.Error(\"response missing content_block_delta event\")\n129\t\t}\n130\t\tif !strings.Contains(bodyStr, \"message_stop\") {\n131\t\t\tt.Error(\"response missing message_stop event\")\n132\t\t}\n133\t\n134\t\t// 验证追踪记录\n135\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n136\t\tif len(records) != 1 {\n137\t\t\tt.Fatalf(\"expected 1 trace record, got %d\", len(records))\n138\t\t}\n139\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n140\t\n141\t\trespMap, _ := records[0][\"response\"].(map[string]any)\n142\t\tif sseEvents, ok := respMap[\"sse_events\"].([]any); ok {\n143\t\t\tif len(sseEvents) == 0 {\n144\t\t\t\tt.Error(\"trace has no sse_events for streaming response\")\n145\t\t\t}\n146\t\t}\n147\t}\n148\t\n149\t// TestMultiTurn 验证：多轮对话请求会在追踪文件中生成多条记录，且 turn 编号递增。\n150\tfunc TestMultiTurn(t *testing.T) {\n151\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n152\t\tmockServer := testutil.CreateMockServer(t, fx)\n153\t\tdefer mockServer.Close()\n154\t\n155\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n156\t\n157\t\t// 发送 3 轮请求\n158\t\tfor i := 0; i < 3; i++ {\n159\t\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n160\t\t\ttestutil.AssertResponseStatus(t, resp, 200)\n161\t\t\tio.ReadAll(resp.Body)\n162\t\t\tresp.Body.Close()\n163\t\t}\n164\t\n165\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n166\t\tif len(records) != 3 {\n167\t\t\tt.Fatalf(\"expected 3 trace records, got %d\", len(records))\n168\t\t}\n169\t\n170\t\t// 验证每轮记录的 turn 编号和 session_id\n171\t\tfor i, rec := range records {\n172\t\t\tturn, _ := rec[\"turn\"].(float64)\n173\t\t\tif int(turn) != i+1 {\n174\t\t\t\tt.Errorf(\"record %d: turn = %v, want %d\", i, turn, i+1)\n175\t\t\t}\n176\t\t\tsid, _ := rec[\"session_id\"].(string)\n177\t\t\tif sid != \"test-session-001\" {\n178\t\t\t\tt.Errorf(\"record %d: session_id = %q, want test-session-001\", i, sid)\n179\t\t\t}\n180\t\t}\n181\t}\n182\t\n183\t// TestSessionIDExtraction 验证：追踪记录中正确提取了 session_id。\n184\tfunc TestSessionIDExtraction(t *testing.T) {\n185\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n186\t\tmockServer := testutil.CreateMockServer(t, fx)\n187\t\tdefer mockServer.Close()\n188\t\n189\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n190\t\n191\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n192\t\tio.ReadAll(resp.Body)\n193\t\tresp.Body.Close()\n194\t\n195\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n196\t\tif len(records) == 0 {\n197\t\t\tt.Fatal(\"no trace records\")\n198\t\t}\n199\t\n200\t\tsid, _ := records[0][\"session_id\"].(string)\n201\t\tif sid != \"test-session-001\" {\n202\t\t\tt.Errorf(\"session_id: got %q, want %q\", sid, \"test-session-001\")\n203\t\t}\n204\t}\n205\t\n206\t// TestTokenStats 验证：代理正确统计 API 调用次数和输入/输出 token 数量。\n207\tfunc TestTokenStats(t *testing.T) {\n208\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n209\t\tmockServer := testutil.CreateMockServer(t, fx)\n210\t\tdefer mockServer.Close()\n211\t\n212\t\ttraceDir := t.TempDir()\n213\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n214\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n215\t\tif err != nil {\n216\t\t\tt.Fatalf(\"start proxy: %v\", err)\n217\t\t}\n218\t\tdefer rp.Stop()\n219\t\n220\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n221\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n222\t\tio.ReadAll(resp.Body)\n223\t\tresp.Body.Close()\n224\t\n225\t\tsummary := rp.Summary()\n226\t\n227\t\t// 验证 API 调用次数\n228\t\tapiCalls, _ := summary[\"api_calls\"].(int)\n229\t\tif apiCalls != 1 {\n230\t\t\tt.Errorf(\"api_calls: got %d, want 1\", apiCalls)\n231\t\t}\n232\t\n233\t\t// 验证输入 token 数\n234\t\tinputTokens, _ := summary[\"input_tokens\"].(int64)\n235\t\tif inputTokens != 1234 {\n236\t\t\tt.Errorf(\"input_tokens: got %d, want 1234\", inputTokens)\n237\t\t}\n238\t\n239\t\t// 验证输出 token 数\n240\t\toutputTokens, _ := summary[\"output_tokens\"].(int64)\n241\t\tif outputTokens != 56 {\n242\t\t\tt.Errorf(\"output_tokens: got %d, want 56\", outputTokens)\n243\t\t}\n244\t}\n245\t\n246\t// TestHeaderRedaction 验证：追踪记录中的敏感请求头（Authorization、X-Api-Key）已被脱敏。\n247\tfunc TestHeaderRedaction(t *testing.T) {\n248\t\tfx := testutil.LoadFixture(t, \"nonstreaming_anthropic.json\")\n249\t\tmockServer := testutil.CreateMockServer(t, fx)\n250\t\tdefer mockServer.Close()\n251\t\n252\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n253\t\n254\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n255\t\tio.ReadAll(resp.Body)\n256\t\tresp.Body.Close()\n257\t\n258\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n259\t\tif len(records) == 0 {\n260\t\t\tt.Fatal(\"no trace records\")\n261\t\t}\n262\t\n263\t\treqMap, _ := records[0][\"request\"].(map[string]any)\n264\t\theaders, _ := reqMap[\"headers\"].(map[string]any)\n265\t\n266\t\t// 验证 X-Api-Key 被脱敏\n267\t\tif apiKey, ok := headers[\"X-Api-Key\"].(string); ok {\n268\t\t\tif apiKey == \"sk-ant-test-key-12345678\" {\n269\t\t\t\tt.Error(\"X-Api-Key not redacted in trace\")\n270\t\t\t}\n271\t\t}\n272\t\t// 验证 Authorization 被脱敏\n273\t\tif auth, ok := headers[\"Authorization\"].(string); ok {\n274\t\t\tif auth == \"Bearer sk-ant-test-key-12345678\" {\n275\t\t\t\tt.Error(\"Authorization not redacted in trace\")\n276\t\t\t}\n277\t\t}\n278\t}\n279\t\n280\t// TestBlockedPath 验证：被屏蔽的路径（如 /admin/config）返回 404，不会转发到上游。\n281\tfunc TestBlockedPath(t *testing.T) {\n282\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n283\t\t\tw.WriteHeader(200)\n284\t\t\tw.Write([]byte(\"should not reach\"))\n285\t\t})\n286\t\tmockServer := httptest.NewServer(mockHandler)\n287\t\tdefer mockServer.Close()\n288\t\n289\t\ttraceDir := t.TempDir()\n290\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n291\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n292\t\tif err != nil {\n293\t\t\tt.Fatalf(\"start proxy: %v\", err)\n294\t\t}\n295\t\tdefer rp.Stop()\n296\t\n297\t\tresp, err := http.Get(\"http://127.0.0.1:\" + fmt.Sprint(port) + \"/admin/config\")\n298\t\tif err != nil {\n299\t\t\tt.Fatalf(\"send request: %v\", err)\n300\t\t}\n301\t\tdefer resp.Body.Close()\n302\t\n303\t\tif resp.StatusCode != 404 {\n304\t\t\tt.Errorf(\"blocked path status: got %d, want 404\", resp.StatusCode)\n305\t\t}\n306\t}\n307\t\n308\t// TestGzipResponse 验证：代理能正确处理 gzip 压缩的响应并解压。\n309\tfunc TestGzipResponse(t *testing.T) {\n310\t\tfx := testutil.LoadFixture(t, \"gzip_response.json\")\n311\t\tmockServer := testutil.CreateMockServer(t, fx)\n312\t\tdefer mockServer.Close()\n313\t\n314\t\tproxyURL, tracePath := setupProxyWithTrace(t, mockServer.URL)\n315\t\n316\t\tresp := testutil.SendRequestThroughProxy(t, fx, proxyURL)\n317\t\ttestutil.AssertResponseStatus(t, resp, 200)\n318\t\n319\t\tbody := testutil.DrainAndClose(t, resp)\n320\t\tvar respBody map[string]any\n321\t\tif err := json.Unmarshal(body, &respBody); err != nil {\n322\t\t\tt.Fatalf(\"parse response (should be decompressed): %v\", err)\n323\t\t}\n324\t\tif respBody[\"type\"] != \"message\" {\n325\t\t\tt.Errorf(\"response type: got %v, want message\", respBody[\"type\"])\n326\t\t}\n327\t\n328\t\trecords := testutil.ReadTraceRecords(t, tracePath)\n329\t\tif len(records) == 0 {\n330\t\t\tt.Fatal(\"no trace records\")\n331\t\t}\n332\t\ttestutil.AssertTrace(t, records[0], fx.ExpectedTrace)\n333\t}\n334\t\n335\t// TestTraceInitEndpoint 验证：/_internal/trace-init 端点能正确初始化追踪文件并返回路径。\n336\tfunc TestTraceInitEndpoint(t *testing.T) {\n337\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n338\t\t\tw.WriteHeader(200)\n339\t\t\tw.Write([]byte(`{\"id\":\"msg_test\"}`))\n340\t\t})\n341\t\tmockServer := httptest.NewServer(mockHandler)\n342\t\tdefer mockServer.Close()\n343\t\n344\t\ttraceDir := t.TempDir()\n345\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n346\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n347\t\tif err != nil {\n348\t\t\tt.Fatalf(\"start proxy: %v\", err)\n349\t\t}\n350\t\tdefer rp.Stop()\n351\t\n352\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n353\t\n354\t\t// 调用 trace-init\n355\t\tbody := `{\"session_id\":\"sess-abc\",\"machine_id\":\"user@host\",\"project_slug\":\"my-project\"}`\n356\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(body))\n357\t\tif err != nil {\n358\t\t\tt.Fatalf(\"trace-init: %v\", err)\n359\t\t}\n360\t\tdefer resp.Body.Close()\n361\t\n362\t\tif resp.StatusCode != 200 {\n363\t\t\tt.Fatalf(\"expected 200, got %d\", resp.StatusCode)\n364\t\t}\n365\t\n366\t\tvar result struct {\n367\t\t\tStatus    string `json:\"status\"`\n368\t\t\tTracePath string `json:\"trace_path\"`\n369\t\t}\n370\t\tif err := json.NewDecoder(resp.Body).Decode(&result); err != nil {\n371\t\t\tt.Fatalf(\"parse response: %v\", err)\n372\t\t}\n373\t\n374\t\tif result.Status != \"ok\" {\n375\t\t\tt.Errorf(\"status: got %q, want ok\", result.Status)\n376\t\t}\n377\t\n378\t\t// 验证追踪文件路径以 session_id 结尾\n379\t\tif !strings.HasSuffix(filepath.ToSlash(result.TracePath), \"sess-abc.jsonl\") {\n380\t\t\tt.Errorf(\"trace_path suffix: got %q, want ending with sess-abc.jsonl\", result.TracePath)\n381\t\t}\n382\t\n383\t\t// 验证追踪文件已被创建\n384\t\tif _, err := os.Stat(result.TracePath); os.IsNotExist(err) {\n385\t\t\tt.Errorf(\"trace file not created: %s\", result.TracePath)\n386\t\t}\n387\t\n388\t\t// 验证目录结构：{machine_id}/{project_slug}/{session_id}.jsonl\n389\t\trel, _ := filepath.Rel(traceDir, result.TracePath)\n390\t\tparts := strings.Split(filepath.ToSlash(rel), \"/\")\n391\t\tif len(parts) != 3 {\n392\t\t\tt.Errorf(\"expected 3 path components (machine/project/file), got %d: %v\", len(parts), parts)\n393\t\t}\n394\t\tif parts[0] != \"user@host\" {\n395\t\t\tt.Errorf(\"machine_id dir: got %q, want user@host\", parts[0])\n396\t\t}\n397\t\tif parts[1] != \"my-project\" {\n398\t\t\tt.Errorf(\"project_slug dir: got %q, want my-project\", parts[1])\n399\t\t}\n400\t}\n401\t\n402\t// TestTraceInitMissingSessionID 验证：trace-init 请求缺少 session_id 时返回 400。\n403\tfunc TestTraceInitMissingSessionID(t *testing.T) {\n404\t\tmockHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n405\t\t\tw.WriteHeader(200)\n406\t\t})\n407\t\tmockServer := httptest.NewServer(mockHandler)\n408\t\tdefer mockServer.Close()\n409\t\n410\t\ttraceDir := t.TempDir()\n411\t\trp := proxy.NewReverseProxy(mockServer.URL, traceDir)\n412\t\tport, err := rp.Start(\"127.0.0.1\", 0)\n413\t\tif err != nil {\n414\t\t\tt.Fatalf(\"start proxy: %v\", err)\n415\t\t}\n416\t\tdefer rp.Stop()\n417\t\n418\t\tproxyURL := \"http://127.0.0.1:\" + fmt.Sprint(port)\n419\t\n420\t\tresp, err := http.Post(proxyURL+\"/_internal/trace-init\", \"application/json\", strings.NewReader(`{\"session_id\":\"\"}`))\n421\t\tif err != nil {\n422\t\t\tt.Fatalf(\"trace-init: %v\", err)\n423\t\t}\n424\t\tdefer resp.Body.Close()\n425\t\n426\t\tif resp.StatusCode != 400 {\n427\t\t\tt.Errorf(\"expected 400, got %d\", resp.StatusCode)\n428\t\t}\n429\t}\n430\t"}]}
