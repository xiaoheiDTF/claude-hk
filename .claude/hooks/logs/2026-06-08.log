g              // 强制替换的模型名（空=不改写）\n35\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n36\t\tfallbackConfig     *FallbackConfig      // 兜底配置（上游不可用时切换）\n37\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfig 的并发安全\n38\t\tactualAddr         string              // 实际监听地址（启动后设置）\n39\t\treasoningCache     *ReasoningCache     // reasoning_content 缓存（仅 kimi 模式）\n40\t\tkimiMode           bool                // 是否为 kimi 上游\n41\t}\n42\t\n43\t// FallbackConfig 存储上游不可用时的兜底配置。\n44\ttype FallbackConfig struct {\n45\t\tBaseURL   string // 兜底上游 API 地址\n46\t\tModel     string // 兜底模型名\n47\t\tAuthToken string // 兜底认证 Token\n48\t\tAPIKey    string // 兜底 API Key\n49\t}\n50\t\n51\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n52\t// traceDir 为 Trace 文件存放的基础目录。\n53\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n54\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n55\t\treturn &ReverseProxy{\n56\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n57\t\t\tbaseDir:           traceDir,\n58\t\t\tupstreamAvailable: true,\n59\t\t\tclient: &http.Client{\n60\t\t\t\tTimeout: 0, // 流式场景不设超时\n61\t\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n62\t\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n63\t\t\t\t},\n64\t\t\t},\n65\t\t}\n66\t}\n67\t\n68\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n69\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n70\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n71\t\tmux := http.NewServeMux()\n72\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n73\t\tp.server = &http.Server{\n74\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n75\t\t\tHandler: mux,\n76\t\t}\n77\t\n78\t\tlistener, err := ioListener(p.server.Addr)\n79\t\tif err != nil {\n80\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n81\t\t}\n82\t\n83\t\t// 在后台 goroutine 中启动服务\n84\t\tgo func() {\n85\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n86\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n87\t\t\t}\n88\t\t}()\n89\t\n90\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n91\t\tp.actualAddr = fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n92\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n93\t\treturn actualPort, nil\n94\t}\n95\t\n96\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n97\tfunc (p *ReverseProxy) Stop() {\n98\t\tlogger.Info(\"proxy\", \"stopping\")\n99\t\tif p.writer != nil {\n100\t\t\tp.writer.Close()"}]}
