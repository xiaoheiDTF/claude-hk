\trunSessionPush(os.Args[2:])\n48\t\t\t\treturn\n49\t\t\tcase \"session-pull\":\n50\t\t\t\trunSessionPull(os.Args[2:])\n51\t\t\t\treturn\n52\t\t\tcase \"session-status\":\n53\t\t\t\trunSessionStatus(os.Args[2:])\n54\t\t\t\treturn\n55\t\t\tcase \"backend\":\n56\t\t\t\trunBackend(os.Args[2:])\n57\t\t\t\treturn\n58\t\t\tcase \"deploy\":\n59\t\t\t\trunDeploy(os.Args[2:])\n60\t\t\t\treturn\n61\t\t\tcase \"help\", \"--help\", \"-h\":\n62\t\t\t\tprintUsage()\n63\t\t\t\treturn\n64\t\t\t}\n65\t\t}\n66\t\n67\t\t// 默认进入代理模式，拦截并记录 Claude Code 的 API 请求\n68\t\trunProxy(os.Args[1:])\n69\t}\n70\t\n71\t// printUsage 打印命令行使用帮助信息到标准输出。\n72\tfunc printUsage() {\n73\t\tfmt.Println(\"claude-tap-plus — Claude Code proxy, trace recorder, and session sync\")\n74\t\tfmt.Println()\n75\t\tfmt.Println(\"Usage:\")\n76\t\tfmt.Println(\"  claude-tap-plus [flags] [-- claude-args...]      Run proxy mode (default)\")\n77\t\tfmt.Println(\"  claude-tap-plus session-push [flags]             Collect sessions to local storage\")\n78\t\tfmt.Println(\"  claude-tap-plus session-pull [flags]             Restore sessions to ~/.claude/\")\n79\t\tfmt.Println(\"  claude-tap-plus session-status [flags]           Show session storage state\")\n80\t\tfmt.Println()\n81\t\tfmt.Println(\"Proxy flags:\")\n82\t\tfmt.Println(\"  --tap-target URL       Upstream API target (default: auto-detect)\")\n83\t\tfmt.Println(\"  --tap-port PORT        Local proxy port (default: random)\")\n84\t\tfmt.Println(\"  --tap-output-dir DIR   Trace output directory\")\n85\t\tfmt.Println(\"  --tap-verbose          Enable verbose logging\")\n86\t\tfmt.Println(\"  --tap-console          Output logs to console (requires --tap-verbose)\")\n87\t\tfmt.Println(\"  --tap-profile NAME     Use named profile from profiles.json\")\n88\t\tfmt.Println(\"  --tap-api-key KEY      Override API key (highest priority)\")\n89\t\tfmt.Println(\"  --tap-auth-token TOKEN Override OAuth token (highest priority)\")\n90\t\tfmt.Println(\"  --tap-base-url URL     Override upstream API URL (highest priority)\")\n91\t\tfmt.Println(\"  --claude               Alias for -- (pass remaining args to claude)\")\n92\t\tfmt.Println(\"  claude-tap-plus deploy --target PATH             Deploy .claude/ template to project\")\n93\t\tfmt.Println()\n94\t\tfmt.Println(\"Deploy flags:\")\n95\t\tfmt.Println(\"  --target PATH, -t      Target project root directory (required)\")\n96\t\tfmt.Println(\"  --dry-run              Preview changes without copying files\")\n97\t\tfmt.Println()\n98\t\tfmt.Println(\"Session-push flags:\")\n99\t\tfmt.Println(\"  --all                  Collect all projects\")\n100\t\tfmt.Println(\"  --force                Overwrite existing files\")\n101\t\tfmt.Println(\"  --dry-run              Preview only\")\n102\t\tfmt.Println(\"  --project NAME         Override project name\")\n103\t\tfmt.Println()\n104\t\tfmt.Println(\"Session-pull flags:\")\n105\t\tfmt.Println(\"  --all                  Restore all projects\")\n106\t\tfmt.Println(\"  --project NAME         Override project name\")\n107\t\tfmt.Println(\"  --dry-run              Preview only\")\n108\t\tfmt.Println()\n109\t\tfmt.Println(\"Session-status flags:\")\n110\t\tfmt.Println(\"  --verbose              Show file-level details\")\n111\t}\n112\t\n113\t// runProxy 是默认的代理模式主逻辑。\n114\t//\n115\t// 工作流程：\n116\t//  1. 解析 --tap-* 系列标志，提取剩余的参数传递给 Claude Code\n117\t//  2. 自动探测上游 API 目标地址\n118\t//  3. 启动本地反向代理监听指定端口\n119\t//  4. 解析 Claude Code 可执行文件路径\n120\t//  5. 构建子进程环境变量（注入代理地址）\n121\t//  6. 启动 Claude Code 作为子进程\n122\t//  7. 监听系统信号并转发给子进程，支持优雅关闭\n123\t//  8. 子进程退出后打印 API 调用统计摘要\n124\tfunc runProxy(args []string) {\n125\t\t// 记录原始命令行参数，用于生成 resume 命令\n126\t\toriginalArgs := append([]string{}, args...)\n127\t\n128\t\t// 解析 --tap-* 标志，收集剩余参数作为传递给 Claude Code 的参数\n129\t\tvar (\n130\t\t\ttapTarget    string // 上游 API 目标地址\n131\t\t\ttapPort      int    // 本地代理监听端口\n132\t\t\ttapOutputDir string // 追踪记录输出目录\n133\t\t\ttapVerbose   bool   // 是否启用详细日志\n134\t\t\ttapConsole   bool   // 是否输出日志到终端（需配合 --tap-verbose）\n135\t\t\ttapProfile   string // 配置名（读取 profiles.json）\n136\t\t\ttapAPIKey    string // 直接传入 API Key\n137\t\t\ttapAuthToken string // 直接传入 OAuth Token\n138\t\t\ttapBaseURL   string // 直接传入上游地址\n139\t\t)\n140\t\n141\t\tvar claudeArgs []string\n142\t\tfor i := 0; i < len(args); i++ {\n143\t\t\targ := args[i]\n144\t\t\tswitch {\n145\t\t\t// 解析 --tap-target 参数（空格分隔形式）\n146\t\t\tcase arg == \"--tap-target\" && i+1 < len(args):\n147\t\t\t\ti++\n148\t\t\t\ttapTarget = args[i]\n149\t\t\t// 解析 --tap-target=URL 形式\n150\t\t\tcase strings.HasPrefix(arg, \"--tap-target=\"):\n151\t\t\t\ttapTarget = arg[len(\"--tap-target=\"):]\n152\t\t\t// 解析 --tap-port 参数（空格分隔形式）\n153\t\t\tcase arg == \"--tap-port\" && i+1 < len(args):\n154\t\t\t\ti++\n155\t\t\t\tfmt.Sscanf(args[i], \"%d\", &tapPort)\n156\t\t\t// 解析 --tap-port=PORT 形式\n157\t\t\tcase strings.HasPrefix(arg, \"--tap-port=\"):\n158\t\t\t\tfmt.Sscanf(arg[len(\"--tap-port=\"):], \"%d\", &tapPort)\n159\t\t\t// 解析 --tap-output-dir 参数（空格分隔形式）\n160\t\t\tcase arg == \"--tap-output-dir\" && i+1 < len(args):\n161\t\t\t\ti++\n162\t\t\t\ttapOutputDir = args[i]\n163\t\t\t// 解析 --tap-output-dir=DIR 形式\n164\t\t\tcase strings.HasPrefix(arg, \"--tap-output-dir=\"):\n165\t\t\t\ttapOutputDir = arg[len(\"--tap-output-dir=\"):]\n166\t\t\t// 启用详细日志\n167\t\t\tcase arg == \"--tap-verbose\":\n168\t\t\t\ttapVerbose = true\n169\t\t\t// 启用终端日志输出（需配合 --tap-verbose）\n170\t\t\tcase arg == \"--tap-console\":\n171\t\t\t\ttapConsole = true\n172\t\t\t// 解析 --tap-profile 参数（读取 profiles.json 中的配置）\n173\t\t\tcase arg == \"--tap-profile\" && i+1 < len(args):\n174\t\t\t\ti++\n175\t\t\t\ttapProfile = args[i]\n176\t\t\tcase strings.HasPrefix(arg, \"--tap-profile=\"):\n177\t\t\t\ttapProfile = arg[len(\"--tap-profile=\"):]\n178\t\t\t// 解析 --tap-api-key 参数（直接传入 API Key）\n179\t\t\tcase arg == \"--tap-api-key\" && i+1 < len(args):\n180\t\t\t\ti++\n181\t\t\t\ttapAPIKey = args[i]\n182\t\t\tcase strings.HasPrefix(arg, \"--tap-api-key=\"):\n183\t\t\t\ttapAPIKey = arg[len(\"--tap-api-key=\"):]\n184\t\t\t// 解析 --tap-auth-token 参数（直接传入 OAuth Token）\n185\t\t\tcase arg == \"--tap-auth-token\" && i+1 < len(args):\n186\t\t\t\ti++\n187\t\t\t\ttapAuthToken = args[i]\n188\t\t\tcase strings.HasPrefix(arg, \"--tap-auth-token=\"):\n189\t\t\t\ttapAuthToken = arg[len(\"--tap-auth-token=\"):]\n190\t\t\t// 解析 --tap-base-url 参数（直接传入上游地址，优先级高于 --tap-target）\n191\t\t\tcase arg == \"--tap-base-url\" && i+1 < len(args):\n192\t\t\t\ti++\n193\t\t\t\ttapBaseURL = args[i]\n194\t\t\tcase strings.HasPrefix(arg, \"--tap-base-url=\"):\n195\t\t\t\ttapBaseURL = arg[len(\"--tap-base-url=\"):]\n196\t\t\t// -- 或 --claude 或 claude 后的所有参数都传递给 Claude Code\n197\t\t\tcase arg == \"--\", arg == \"--claude\", arg == \"claude\":\n198\t\t\t\tclaudeArgs = append(claudeArgs, args[i+1:]...)\n199\t\t\t\ti = len(args) // 停止解析\n200\t\t\t// 未知的 --tap-* 标志，直接忽略\n201\t\t\tcase strings.HasPrefix(arg, \"--tap-\"):\n202\t\t\t// 其他参数视为 Claude Code 的参数\n203\t\t\tdefault:\n204\t\t\t\tclaudeArgs = append(claudeArgs, arg)\n205\t\t\t}\n206\t\t}\n207\t\n208\t\t// 如果未指定输出目录，使用默认追踪目录\n209\t\tif tapOutputDir == \"\" {\n210\t\t\ttapOutputDir = trace.DefaultTraceDir()\n211\t\t}\n212\t\n213\t\t// 校验：--tap-console 必须配合 --tap-verbose\n214\t\tif tapConsole && !tapVerbose {\n215\t\t\tfmt.Fprintf(os.Stderr, \"Error: --tap-console requires --tap-verbose\\n\")\n216\t\t\tos.Exit(1)\n217\t\t}\n218\t\n219\t\t// 根据详细程度重新初始化日志器\n220\t\tif tapVerbose {\n221\t\t\tlogger.Init(tapOutputDir, tapConsole, logger.DEBUG)\n222\t\t} else {\n223\t\t\tlogger.Init(tapOutputDir, false, logger.INFO)\n224\t\t}\n225\t\tlogger.Info(\"main\", \"proxy mode: output_dir=%s verbose=%v\", tapOutputDir, tapVerbose)\n226\t\n227\t\t// 按优先级解析上游 API 配置（--tap-base-url > --tap-target > profile > env > ~/.claude.json > default）\n228\t\tresolved, err := config.ResolveTargetConfig(\n229\t\t\tfirstNonEmpty(tapBaseURL, tapTarget),\n230\t\t\ttapAPIKey,\n231\t\t\ttapAuthToken,\n232\t\t\ttapProfile,\n233\t\t\t&config.ClaudeClient,\n234\t\t)\n235\t\tif err != nil {\n236\t\t\tlog.Fatalf(\"resolve config: %v\", err)\n237\t\t}\n238\t\ttarget := resolved.BaseURL\n239\t\tif tapVerbose {\n240\t\t\tlog.Printf(\"upstream target: %s\", target)\n241\t\t}\n242\t\n243\t\t// 创建反向代理实例，绑定上游目标和追踪输出目录\n244\t\trp := proxy.NewReverseProxy(target, tapOutputDir)\n245\t\n246\t\t// 设置 model 改写（契约 2：resolved.Model 优先级链）\n247\t\trp.SetModel(resolved.Model)\n248\t\n249\t\t// 检测是否为 kimi 上游，启用 reasoning_content 缓存\n250\t\tif proxy.IsKimiURL(resolved.BaseURL) {\n251\t\t\trp.SetKimiMode(true)\n252\t\t}\n253\t\n254\t\t// 加载兜底配置（契约 4：优先 profiles.json → 再 Claude settings）\n255\t\tfallbackCfgs := loadFallbackConfigs(resolved.Model, tapProfile)\n256\t\tif len(fallbackCfgs) > 0 {\n257\t\t\trp.SetFallbackConfigs(fallbackCfgs)\n258\t\t}\n259\t\n260\t\tport := tapPort\n261\t\t// 启动代理监听（如果 port 为 0 则随机分配端口）\n262\t\tactualPort, err := rp.Start(\"127.0.0.1\", port)\n263\t\tif err != nil {\n264\t\t\tlog.Fatalf(\"start proxy: %v\", err)\n265\t\t}\n266\t\t// 函数退出时停止代理\n267\t\tdefer rp.Stop()\n268\t\n269\t\tproxyURL := fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n270\t\tlog.Printf(\"proxy listening on %s\", proxyURL)\n271\t\n272\t\t// 自动检测并启动后端服务（如果未运行）\n273\t\tensureBackend()\n274\t\n275\t\t// 向后端注册本代理（hooks 通过环境变量直连 proxy，backend 用于 session/issue 管理）\n276\t\tregisterProxyWithBackend(proxyURL)\n277\t\t// 代理退出时注销\n278\t\tdefer unregisterProxyFromBackend()\n279\t\n280\t\t// 设置会话初始化回调：注册到 proxy.json\n281\t\trp.OnSessionInit = func(sessionID, projectSlug string) {\n282\t\t\tkey := ProxySessionKey(projectSlug, sessionID)\n283\t\t\tif err := RegisterProxySession(key, time.Now().Format(time.RFC3339)); err != nil {\n284\t\t\t\tlogger.Warn(\"main\", \"register proxy session failed: %v\", err)\n285\t\t\t}\n286\t\t}\n287\t\t// 代理退出时注销 proxy.json 中的会话\n288\t\tdefer func() {\n289\t\t\tif sid := rp.SessionID(); sid != \"\" {\n290\t\t\t\tslug := rp.ProjectSlug()\n291\t\t\t\tkey := ProxySessionKey(slug, sid)\n292\t\t\t\tif err := UnregisterProxySession(key); err != nil {\n293\t\t\t\t\tlogger.Warn(\"main\", \"unregister proxy session failed: %v\", err)\n294\t\t\t\t}\n295\t\t\t}\n296\t\t}()\n297\t\n298\t\t// 解析 Claude Code 可执行文件路径\n299\t\tclaudePath, err := config.ResolveCmd(&config.ClaudeClient)\n300\t\tif err != nil {\n301\t\t\tlog.Fatal(err)\n302\t\t}\n303\t\n304\t\t// 构建子进程环境变量，将 API 请求指向本地代理\n305\t\tchildEnv := config.BuildChildEnv(&config.ClaudeClient, proxyURL)\n306\t\n307\t\t// 注入代理 PID 和 URL 到子进程环境（hook 直接 curl proxy，无需 backend 中转）\n308\t\tchildEnv = append(childEnv, \"CLAUDE_TAP_PROXY_PID=\"+strconv.Itoa(os.Getpid()))\n309\t\tchildEnv = append(childEnv, \"CLAUDE_TAP_PROXY_URL=\"+proxyURL)\n310\t\n311\t\t// 注入认证信息：有 API Key 用 API Key，有 Token 用 Token，互斥避免冲突\n312\t\tif resolved.APIKey != \"\" {\n313\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_AUTH_TOKEN\")\n314\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_API_KEY=\"+resolved.APIKey)\n315\t\t} else if resolved.AuthToken != \"\" {\n316\t\t\tchildEnv = removeEnvVar(childEnv, \"ANTHROPIC_API_KEY\")\n317\t\t\tchildEnv = append(childEnv, \"ANTHROPIC_AUTH_TOKEN=\"+resolved.AuthToken)\n318\t\t}\n319\t\n320\t\t// 对于需要注入 --settings 参数的客户端（如 Claude Code），自动添加\n321\t\tfinalArgs := claudeArgs\n322\t\tif config.ClaudeClient.InjectSettingsEnv && !config.HasSettingsArg(claudeArgs) {\n323\t\t\tsettingsArgs := config.BuildSettingsArgs(&config.ClaudeClient, proxyURL)\n324\t\t\tfinalArgs = append(settingsArgs, claudeArgs...)\n325\t\t}\n326\t\n327\t\t// 启动 Claude Code 作为子进程\n328\t\tcmd := exec.Command(claudePath, finalArgs...)\n329\t\tcmd.Env = childEnv\n330\t\tcmd.Stdin = os.Stdin\n331\t\tcmd.Stdout = os.Stdout\n332\t\tcmd.Stderr = os.Stderr\n333\t\n334\t\tfmt.Printf(\"\\n🚀 Starting Claude Code: claude %s\\n\", formatArgs(claudeArgs))\n335\t\tfmt.Printf(\"   ANTHROPIC_BASE_URL=%s\\n\\n\", proxyURL)\n336\t\n337\t\tif err := cmd.Start(); err != nil {\n338\t\t\tlog.Fatalf(\"start claude: %v\", err)\n339\t\t}\n340\t\n341\t\t// 监听系统信号（SIGINT、SIGTERM），转发给子进程以实现优雅关闭\n342\t\tsigChan := make(chan os.Signal, 2)\n343\t\tsignal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)\n344\t\n345\t\tgo func() {\n346\t\t\tsigCount := 0\n347\t\t\tfor sig := range sigChan {\n348\t\t\t\tsigCount++\n349\t\t\t\tif sigCount == 1 {\n350\t\t\t\t\t// 第一次收到信号：发送给子进程请求优雅退出\n351\t\t\t\t\tfmt.Printf(\"\\n⏳ Shutting down Claude Code... (Ctrl+C again to force)\\n\")\n352\t\t\t\t\t_ = cmd.Process.Signal(sig)\n353\t\t\t\t} else {\n354\t\t\t\t\t// 再次收到信号：强制终止子进程\n355\t\t\t\t\t_ = cmd.Process.Kill()\n356\t\t\t\t}\n357\t\t\t}\n358\t\t}()\n359\t\n360\t\t// 等待子进程结束\n361\t\twaitErr := cmd.Wait()\n362\t\n363\t\t// 停止信号处理器，释放资源\n364\t\tsignal.Stop(sigChan)\n365\t\tclose(sigChan)\n366\t\n367\t\t// 打印运行摘要：API 调用次数和 token 使用情况\n368\t\tsummary := rp.Summary()\n369\t\ttracePath := rp.TracePath()\n370\t\n371\t\tfmt.Printf(\"\\n📋 Claude Code exited\")\n372\t\tif waitErr != nil {\n373\t\t\tfmt.Printf(\" with error: %v\", waitErr)\n374\t\t}\n375\t\tfmt.Printf(\"\\n\")\n376\t\tfmt.Printf(\"   API calls:      %v\\n\", summary[\"api_calls\"])\n377\t\tfmt.Printf(\"   Input tokens:    %v\\n\", summary[\"input_tokens\"])\n378\t\tfmt.Printf(\"   Output tokens:   %v\\n\", summary[\"output_tokens\"])\n379\t\tfmt.Printf(\"   Cache read:      %v\\n\", summary[\"cache_read_tokens\"])\n380\t\tfmt.Printf(\"   Cache create:    %v\\n\", summary[\"cache_create_tokens\"])\n381\t\tif tracePath != \"\" {\n382\t\t\tfmt.Printf(\"   Trace: %s\\n\", shortenPath(tracePath))\n383\t\t}\n384\t\tfmt.Printf(\"\\n\")\n385\t\n386\t\t// 生成 Resume 命令（仅在有 session_id 时）\n387\t\tsessionID := rp.SessionID()\n388\t\tif sessionID != \"\" {\n389\t\t\tresumeCmd := buildResumeCommand(originalArgs, sessionID)\n390\t\t\tfmt.Printf(\"📎 Resume:\\n\")\n391\t\t\tfmt.Printf(\"   %s\\n\", resumeCmd)\n392\t\t}\n393\t}\n394\t\n395\t// loadFallbackConfigs 按优先级加载兜底配置列表。\n396\t//\n397\t// 优先级（从高到低）：\n398\t//  1. profiles.json 中与 targetModel 同 model 的其他 profile\n399\t//  2. profiles.json 中其他 model 的 profile\n400\t//  3. ~/.claude/settings.json 中的配置（原始 fallback 逻辑）\n401\tfunc loadFallbackConfigs(targetModel, excludeProfile string) []*proxy.FallbackConfig {\n402\t\t// Level 1 & 2: 优先从 profiles.json 查找\n403\t\tprofiles, err := config.ResolveFallbackProfiles(targetModel, excludeProfile)\n404\t\tif err == nil && len(profiles) > 0 {\n405\t\t\tvar result []*proxy.FallbackConfig\n406\t\t\tfor _, p := range profiles {\n407\t\t\t\tresult = append(result, &proxy.FallbackConfig{\n408\t\t\t\t\tBaseURL:   p.BaseURL,\n409\t\t\t\t\tModel:     p.Model,\n410\t\t\t\t\tAuthToken: p.AuthToken,\n411\t\t\t\t\tAPIKey:    p.APIKey,\n412\t\t\t\t})\n413\t\t\t}\n414\t\t\tlogger.Info(\"main\", \"fallback loaded from profiles.json: %d candidates\", len(result))\n415\t\t\treturn result\n416\t\t}\n417\t\n418\t\t// Level 3: 回退到原始逻辑（Claude settings）\n419\t\ts, err := config.ReadClaudeSettings()\n420\t\tif err != nil || s == nil {\n421\t\t\treturn nil\n422\t\t}\n423\t\n424\t\tbaseURL := s.Env.AnthropicBaseURL\n425\t\tif baseURL == \"\" {\n426\t\t\tbaseURL = config.ClaudeClient.DefaultTarget\n427\t\t}\n428\t\n429\t\tlogger.Info(\"main\", \"fallback loaded from Claude settings\")\n430\t\treturn []*proxy.FallbackConfig{{\n431\t\t\tBaseURL:   baseURL,\n432\t\t\tModel:     s.Model,\n433\t\t\tAuthToken: s.Env.AnthropicAuthToken,\n434\t\t\tAPIKey:    s.Env.AnthropicAPIKey,\n435\t\t}}\n436\t}\n437\t\n438\t// runSessionPush 执行 session-push 子命令，收集本地 Claude 会话到集中存储。\n439\t//\n440\t// 支持的参数：\n441\t//   --all       收集所有项目的会话\n442\t//   --force     覆盖已存在的会话文件\n443\t//   --dry-run   仅预览，不实际执行\n444\t//   --project   指定项目名称，覆盖自动检测\n445\tfunc runSessionPush(args []string) {\n446\t\tvar opts session.PushOptions\n447\t\tfor i := 0; i < len(args); i++ {\n448\t\t\targ := args[i]\n449\t\t\tswitch {\n450\t\t\tcase arg == \"--all\":\n451\t\t\t\topts.All = true\n452\t\t\tcase arg == \"--force\":\n453\t\t\t\topts.Force = true\n454\t\t\tcase arg == \"--dry-run\":\n455\t\t\t\topts.DryRun = true\n456\t\t\tcase arg == \"--project\" && i+1 < len(args):\n457\t\t\t\ti++\n458\t\t\t\topts.Project = args[i]\n459\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n460\t\t\t\topts.Project = arg[len(\"--project=\"):]\n461\t\t\t}\n462\t\t}\n463\t\n464\t\tfmt.Println(\"📥 Collecting Claude sessions...\")\n465\t\tresults, err := session.SessionPush(opts)\n466\t\tif err != nil {\n467\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n468\t\t\tos.Exit(1)\n469\t\t}\n470\t\n471\t\t// 汇总各项目的收集结果\n472\t\tfmt.Println()\n473\t\ttotalNew, totalSkipped := 0, 0\n474\t\tfor _, r := range results {\n475\t\t\ttotalNew += r.SessionsNew\n476\t\t\ttotalSkipped += r.SessionsSkipped\n477\t\t\tif r.SessionsNew > 0 || r.SessionsSkipped > 0 {\n478\t\t\t\tfmt.Printf(\"  %s: %d new, %d skipped\\n\", r.Project, r.SessionsNew, r.SessionsSkipped)\n479\t\t\t}\n480\t\t}\n481\t\tfmt.Printf(\"Total: %d sessions collected, %d skipped\\n\", totalNew, totalSkipped)\n482\t}\n483\t\n484\t// runSessionPull 执行 session-pull 子命令，从集中存储恢复会话到本地 ~/.claude/ 目录。\n485\t//\n486\t// 支持的参数：\n487\t//   --all       恢复所有项目的会话\n488\t//   --dry-run   仅预览，不实际执行\n489\t//   --project   指定项目名称，覆盖自动检测\n490\tfunc runSessionPull(args []string) {\n491\t\tvar opts session.PullOptions\n492\t\tfor i := 0; i < len(args); i++ {\n493\t\t\targ := args[i]\n494\t\t\tswitch {\n495\t\t\tcase arg == \"--all\":\n496\t\t\t\topts.All = true\n497\t\t\tcase arg == \"--dry-run\":\n498\t\t\t\topts.DryRun = true\n499\t\t\tcase arg == \"--project\" && i+1 < len(args):\n500\t\t\t\ti++\n501\t\t\t\topts.Project = args[i]\n502\t\t\tcase strings.HasPrefix(arg, \"--project=\"):\n503\t\t\t\topts.Project = arg[len(\"--project=\"):]\n504\t\t\t}\n505\t\t}\n506\t\n507\t\tfmt.Println(\"📤 Restoring sessions...\")\n508\t\tresults, err := session.SessionPull(opts)\n509\t\tif err != nil {\n510\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n511\t\t\tos.Exit(1)\n512\t\t}\n513\t\n514\t\t// 汇总各项目的恢复结果\n515\t\tfmt.Println()\n516\t\ttotalRestored, totalSkipped := 0, 0\n517\t\tfor _, r := range results {\n518\t\t\ttotalRestored += r.SessionsRestored\n519\t\t\ttotalSkipped += r.SessionsSkipped\n520\t\t\tif r.SessionsRestored > 0 || r.SessionsSkipped > 0 {\n521\t\t\t\tfmt.Printf(\"  %s: %d restored, %d skipped\\n\", r.Project, r.SessionsRestored, r.SessionsSkipped)\n522\t\t\t}\n523\t\t}\n524\t\tfmt.Printf(\"Total: %d sessions restored, %d skipped\\n\", totalRestored, totalSkipped)\n525\t}\n526\t\n527\t// runSessionStatus 执行 session-status 子命令，显示会话存储的当前状态。\n528\t//\n529\t// 支持的参数：\n530\t//   --verbose   显示文件级别的详细信息\n531\tfunc runSessionStatus(args []string) {\n532\t\tvar opts session.StatusOptions\n533\t\tfor i := 0; i < len(args); i++ {\n534\t\t\targ := args[i]\n535\t\t\tswitch {\n536\t\t\tcase arg == \"--verbose\":\n537\t\t\t\topts.Verbose = true\n538\t\t\t}\n539\t\t}\n540\t\n541\t\tif err := session.SessionStatus(opts); err != nil {\n542\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n543\t\t\tos.Exit(1)\n544\t\t}\n545\t}\n546\t\n547\t// formatArgs 将字符串切片格式化为带空格分隔的命令行参数字符串。\n548\t// 如果参数中包含空格或制表符，则使用引号包裹。\n549\tfunc formatArgs(args []string) string {\n550\t\tresult := \"\"\n551\t\tfor _, a := range args {\n552\t\t\tif containsSpace(a) {\n553\t\t\t\tresult += fmt.Sprintf(\" %q\", a)\n554\t\t\t} else {\n555\t\t\t\tresult += \" \" + a\n556\t\t\t}\n557\t\t}\n558\t\treturn strings.TrimSpace(result)\n559\t}\n560\t\n561\t// containsSpace 检查字符串 s 中是否包含空格或制表符。\n562\tfunc containsSpace(s string) bool {\n563\t\tfor _, c := range s {\n564\t\t\tif c == ' ' || c == '\\t' {\n565\t\t\t\treturn true\n566\t\t\t}\n567\t\t}\n568\t\treturn false\n569\t}\n570\t\n571\t// firstNonEmpty 返回第一个非空字符串。如果所有参数都为空，返回空字符串。\n572\tfunc firstNonEmpty(ss ...string) string {\n573\t\tfor _, s := range ss {\n574\t\t\tif s != \"\" {\n575\t\t\t\treturn s\n576\t\t\t}\n577\t\t}\n578\t\treturn \"\"\n579\t}\n580\t\n581\t// buildResumeCommand 根据原始命令行参数和新的 session_id 生成 resume 命令。\n582\t//\n583\t// 逻辑：\n584\t//  1. 复制原始参数\n585\t//  2. 移除已有的 --resume <old-id>（如果存在）\n586\t//  3. 追加 --resume <new-session-id>\n587\tfunc buildResumeCommand(originalArgs []string, sessionID string) string {\n588\t\tfiltered := make([]string, 0, len(originalArgs))\n589\t\tskip := false\n590\t\tfor i, arg := range originalArgs {\n591\t\t\tif skip {\n592\t\t\t\tskip = false\n593\t\t\t\tcontinue\n594\t\t\t}\n595\t\t\tif arg == \"--resume\" && i+1 < len(originalArgs) {\n596\t\t\t\tskip = true // 跳过 --resume 及其值\n597\t\t\t\tcontinue\n598\t\t\t}\n599\t\t\tif strings.HasPrefix(arg, \"--resume=\") {\n600\t\t\t\tcontinue // 跳过 --resume=id 形式\n601\t\t\t}\n602\t\t\tfiltered = append(filtered, arg)\n603\t\t}\n604\t\tfiltered = append(filtered, \"--resume\", sessionID)\n605\t\treturn \"claude-tap-plus \" + formatArgs(filtered)\n606\t}\n607\t\n608\t// shortenPath 将路径中的用户主目录替换为 ~，使输出更简洁。\n609\tfunc shortenPath(path string) string {\n610\t\thome, err := os.UserHomeDir()\n611\t\tif err != nil {\n612\t\t\treturn path\n613\t\t}\n614\t\tif strings.HasPrefix(path, home) {\n615\t\t\treturn \"~\" + path[len(home):]\n616\t\t}\n617\t\treturn path\n618\t}\n619\t\n620\t// removeEnvVar 从环境变量列表中移除指定名称的变量。\n621\tfunc removeEnvVar(env []string, name string) []string {\n622\t\tprefix := name + \"=\"\n623\t\tresult := make([]string, 0, len(env))\n624\t\tfor _, e := range env {\n625\t\t\tif !strings.HasPrefix(e, prefix) {\n626\t\t\t\tresult = append(result, e)\n627\t\t\t}\n628\t\t}\n629\t\treturn result\n630\t}\n631\t"}]}
