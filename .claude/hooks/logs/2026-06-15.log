ding profiles: %s\", path)\n42\t\n43\t\tdata, err := os.ReadFile(path)\n44\t\tif err != nil {\n45\t\t\tif os.IsNotExist(err) {\n46\t\t\t\tlogger.Debug(\"config\", \"profiles.json not found\")\n47\t\t\t\treturn nil, nil\n48\t\t\t}\n49\t\t\treturn nil, fmt.Errorf(\"read profiles: %w\", err)\n50\t\t}\n51\t\n52\t\tvar pf ProfilesFile\n53\t\tif err := json.Unmarshal(data, &pf); err != nil {\n54\t\t\treturn nil, fmt.Errorf(\"parse profiles: %w\", err)\n55\t\t}\n56\t\n57\t\tlogger.Debug(\"config\", \"profiles loaded: default=%s count=%d\", pf.Default, len(pf.Profiles))\n58\t\treturn &pf, nil\n59\t}\n60\t\n61\t// ResolveProfileConfig 解析指定名称的配置。\n62\t// 如果 name 为空，使用 profiles.json 中的 default 字段。\n63\t// 如果 name 非空但未找到对应配置，返回错误。\n64\tfunc ResolveProfileConfig(name string) (*ProfileConfig, error) {\n65\t\tpf, err := ReadProfiles()\n66\t\tif err != nil {\n67\t\t\treturn nil, err\n68\t\t}\n69\t\tif pf == nil {\n70\t\t\treturn nil, fmt.Errorf(\"profiles.json not found\")\n71\t\t}\n72\t\n73\t\t// 使用默认配置名\n74\t\tif name == \"\" {\n75\t\t\tname = pf.Default\n76\t\t}\n77\t\tif name == \"\" {\n78\t\t\treturn nil, fmt.Errorf(\"no profile name specified and no default configured\")\n79\t\t}\n80\t\n81\t\tp, ok := pf.Profiles[name]\n82\t\tif !ok {\n83\t\t\treturn nil, fmt.Errorf(\"profile %q not found in profiles.json\", name)\n84\t\t}\n85\t\n86\t\tlogger.Info(\"config\", \"resolved profile: %s (base_url=%s)\", name, p.BaseURL)\n87\t\treturn &p, nil\n88\t}\n89\t\n90\t// ResolveFallbackProfiles 按优先级查找 fallback profile 列表。\n91\t//\n92\t// 优先级（从高到低）：\n93\t//  1. profiles.json 中与 targetModel 匹配的 profile（同 model）\n94\t//  2. profiles.json 中其他 model 的 profile（不同 model）\n95\t//  3. 返回空（调用方走原始 fallback 逻辑）\n96\t//\n97\t// excludeProfile 为当前使用的 profile 名称，查找时会被排除。\n98\t// 同 model 的多个 profile 按字母序排列，方便调用方轮询。\n99\tfunc ResolveFallbackProfiles(targetModel, excludeProfile string) ([]ProfileConfig, error) {\n100\t\tpf, err := ReadProfiles()\n101\t\tif err != nil {\n102\t\t\treturn nil, err\n103\t\t}\n104\t\tif pf == nil {\n105\t\t\treturn nil, fmt.Errorf(\"profiles.json not found\")\n106\t\t}\n107\t\n108\t\tvar sameModel []ProfileConfig\n109\t\tvar otherModel []ProfileConfig\n110\t\n111\t\tfor name, p := range pf.Profiles {\n112\t\t\t// 排除当前正在使用的 profile\n113\t\t\tif name == excludeProfile {\n114\t\t\t\tcontinue\n115\t\t\t}\n116\t\t\tif p.BaseURL == \"\" {\n117\t\t\t\tcontinue // base_url 为空无法作为 fallback\n118\t\t\t}\n119\t\t\tif p.Model == targetModel && targetModel != \"\" {\n120\t\t\t\tsameModel = append(sameModel, p)\n121\t\t\t} else {\n122\t\t\t\totherModel = append(otherModel, p)\n123\t\t\t}\n124\t\t}\n125\t\n126\t\t// 按优先级拼接：同 model 在前，其他 model 在后\n127\t\tvar result []ProfileConfig\n128\t\tif len(sameModel) > 0 {\n129\t\t\tlogger.Info(\"config\", \"fallback profiles: %d same-model candidates\", len(sameModel))\n130\t\t\tresult = append(result, sameModel...)\n131\t\t}\n132\t\tif len(otherModel) > 0 {\n133\t\t\tlogger.Info(\"config\", \"fallback profiles: %d other-model candidates\", len(otherModel))\n134\t\t\tresult = append(result, otherModel...)\n135\t\t}\n136\t\n137\t\tif len(result) > 0 {\n138\t\t\treturn result, nil\n139\t\t}\n140\t\n141\t\tlogger.Debug(\"config\", \"no fallback profiles found\")\n142\t\treturn nil, nil\n143\t}\n144\t"},{"tool_name":"Read","tool_input":{"file_path":"D:\\development\\code\\claude-hk\\claude_tap_plus\\internal\\proxy\\reverse.go"},"tool_use_id":"call_1489048053274c978e5767fd","tool_response":"1\t// Package proxy 提供 HTTP 代理功能，包括请求转发、SSE 流式处理与 Trace 记录。\n2\tpackage proxy\n3\t\n4\timport (\n5\t\t\"bytes\"\n6\t\t\"compress/gzip\"\n7\t\t\"compress/zlib\"\n8\t\t\"encoding/json\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"net\"\n12\t\t\"net/http\"\n13\t\t\"strings\"\n14\t\t\"sync\"\n15\t\t\"sync/atomic\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/logger\"\n19\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/sse\"\n20\t\t\"github.com/liaohch3/claude-tap/claude_tap_plus/internal/trace\"\n21\t)\n22\t\n23\tconst (\n24\t\tmaxUpstreamRetries = 5                    // 上游请求最大重试次数\n25\t\tretryInterval      = 30 * time.Second     // 重试间隔\n26\t\tproxyDialTimeout   = 10 * time.Second     // TCP 连接超时\n27\t\tproxyTLSHandshake  = 10 * time.Second     // TLS 握手超时\n28\t\tproxyResponseHdr   = 60 * time.Second     // 等待响应头超时\n29\t\tproxyIdleConn      = 90 * time.Second     // 空闲连接超时\n30\t)\n31\t\n32\t// ReverseProxy 拦截 HTTP 请求并转发到上游 API，同时记录请求/响应到 JSONL Trace，并处理 SSE 流式响应。\n33\ttype ReverseProxy struct {\n34\t\ttarget             string              // 上游 API 目标地址\n35\t\tbaseDir            string              // Trace 文件存放的基础目录\n36\t\twriter             *trace.TraceWriter  // 当前会话的 Trace 写入器（由 _internal/trace-init 创建）\n37\t\tclient             *http.Client        // 转发请求的 HTTP 客户端\n38\t\tturn               atomic.Int64        // 请求计数器，用于标记 Turn 编号\n39\t\tserver             *http.Server        // 本地代理 HTTP 服务器\n40\t\tstartOnce          sync.Once           // 确保 Start 只执行一次\n41\t\tsessionID          string              // 当前会话 ID（由 trace-init 设置）\n42\t\tprojectSlug        string              // 当前项目标识（由 trace-init 设置）\n43\t\tOnSessionInit      func(sessionID, projectSlug string) // 会话初始化回调（注册 proxy.json）\n44\t\tmodel              string              // 强制替换的模型名（空=不改写）\n45\t\tupstreamAvailable  bool                // 上游可用性标记，初始 true\n46\t\tfallbackConfigs    []*FallbackConfig   // 兜底配置列表（上游不可用时轮询）\n47\t\tavailableMu        sync.Mutex          // 保护 upstreamAvailable 和 fallbackConfigs 的并发安全\n48\t\tactualAddr         string              // 实际监听地址（启动后设置）\n49\t\treasoningCache     *ReasoningCache     // reasoning_content 缓存（仅 kimi 模式）\n50\t\tkimiMode           bool                // 是否为 kimi 上游\n51\t\tfallbackIndex      int                 // fallback 轮询索引\n52\t\tretryInterval      time.Duration       // 重试间隔（默认 retryInterval，测试可覆盖）\n53\t}\n54\t\n55\t// FallbackConfig 存储上游不可用时的兜底配置。\n56\ttype FallbackConfig struct {\n57\t\tBaseURL   string // 兜底上游 API 地址\n58\t\tModel     string // 兜底模型名\n59\t\tAuthToken string // 兜底认证 Token\n60\t\tAPIKey    string // 兜底 API Key\n61\t}\n62\t\n63\t// NewReverseProxy 创建一个代理实例，将请求转发到指定的 target URL。\n64\t// traceDir 为 Trace 文件存放的基础目录。\n65\tfunc NewReverseProxy(target, traceDir string) *ReverseProxy {\n66\t\tlogger.Debug(\"proxy\", \"new proxy: target=%s baseDir=%s\", target, traceDir)\n67\t\treturn &ReverseProxy{\n68\t\t\ttarget:            strings.TrimRight(target, \"/\"),\n69\t\t\tbaseDir:           traceDir,\n70\t\t\tupstreamAvailable: true,\n71\t\t\tclient:            newProxyHTTPClient(),\n72\t\t}\n73\t}\n74\t\n75\t// newProxyHTTPClient 创建带 Transport 超时的 HTTP 客户端。\n76\t// 流式场景整体不设超时，但连接建立阶段有保护。\n77\tfunc newProxyHTTPClient() *http.Client {\n78\t\treturn &http.Client{\n79\t\t\tTimeout: 0, // 流式场景不设整体超时\n80\t\t\tTransport: &http.Transport{\n81\t\t\t\tDialContext: (&net.Dialer{\n82\t\t\t\t\tTimeout: proxyDialTimeout,\n83\t\t\t\t}).DialContext,\n84\t\t\t\tTLSHandshakeTimeout:   proxyTLSHandshake,\n85\t\t\t\tResponseHeaderTimeout: proxyResponseHdr,\n86\t\t\t\tIdleConnTimeout:       proxyIdleConn,\n87\t\t\t},\n88\t\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {\n89\t\t\t\treturn http.ErrUseLastResponse // 不自动跟随重定向\n90\t\t\t},\n91\t\t}\n92\t}\n93\t\n94\t// Start 启动代理 HTTP 服务器，监听指定的 host:port。\n95\t// 若 port 为 0，则自动选择可用端口。返回实际监听的端口号。\n96\tfunc (p *ReverseProxy) Start(host string, port int) (int, error) {\n97\t\tmux := http.NewServeMux()\n98\t\tmux.HandleFunc(\"/\", p.serveHTTP)\n99\t\tp.server = &http.Server{\n100\t\t\tAddr:    fmt.Sprintf(\"%s:%d\", host, port),\n101\t\t\tHandler: mux,\n102\t\t}\n103\t\n104\t\tlistener, err := ioListener(p.server.Addr)\n105\t\tif err != nil {\n106\t\t\treturn 0, fmt.Errorf(\"listen: %w\", err)\n107\t\t}\n108\t\n109\t\t// 在后台 goroutine 中启动服务\n110\t\tgo func() {\n111\t\t\tif err := p.server.Serve(listener); err != nil && err != http.ErrServerClosed {\n112\t\t\t\tlogger.Error(\"proxy\", \"server error: %v\", err)\n113\t\t\t}\n114\t\t}()\n115\t\n116\t\tactualPort := listener.Addr().(*netTCPAddr).Port\n117\t\tp.actualAddr = fmt.Sprintf(\"http://127.0.0.1:%d\", actualPort)\n118\t\tlogger.Info(\"proxy\", \"listening on 127.0.0.1:%d\", actualPort)\n119\t\treturn actualPort, nil\n120\t}\n121\t\n122\t// Stop 优雅地关闭代理服务器，并关闭 Trace 写入器。\n123\tfunc (p *ReverseProxy) Stop() {\n124\t\tlogger.Info(\"proxy\", \"stopping\")\n125\t\tif p.writer != nil {\n126\t\t\tp.writer.Close()\n127\t\t}\n128\t\tif p.server != nil {\n129\t\t\t_ = p.server.Close()\n130\t\t}\n131\t}\n132\t\n133\t// URL 返回代理服务器的 HTTP 地址（如 http://127.0.0.1:8080）。\n134\tfunc (p *ReverseProxy) URL() string {\n135\t\treturn p.actualAddr\n136\t}\n137\t\n138\t// serveHTTP 是代理的核心 HTTP 处理函数。\n139\t// 处理流程：请求预处理 → 尝试主上游 → 失败则尝试 fallback 链 → 全部失败则友好错误。\n140\tfunc (p *ReverseProxy) serveHTTP(w http.ResponseWriter, r *http.Request) {\n141\t\t// 处理内部端点（绕过路径白名单）\n142\t\tif strings.HasPrefix(r.URL.Path, \"/_internal/\") {\n143\t\t\tp.handleInternal(w, r)\n144\t\t\treturn\n145\t\t}\n146\t\n147\t\t// 拒绝未知路径\n148\t\tif !IsAllowedPath(r.URL.Path) {\n149\t\t\thttp.NotFound(w, r)\n150\t\t\treturn\n151\t\t}\n152\t\n153\t\t// 读取请求体\n154\t\tbodyBytes, err := io.ReadAll(r.Body)\n155\t\tif err != nil {\n156\t\t\thttp.Error(w, \"read body: \"+err.Error(), http.StatusBadRequest)\n157\t\t\treturn\n158\t\t}\n159\t\t_ = r.Body.Close()\n160\t\n161\t\t// 保存原始请求体（改写 model 前），用于 fallback 时重新改写\n162\t\toriginalBody := make([]byte, len(bodyBytes))\n163\t\tcopy(originalBody, bodyBytes)\n164\t\n165\t\t// 解析请求体为 JSON（用于后续提取 model、stream 等字段）\n166\t\tvar reqBody any\n167\t\tif len(bodyBytes) > 0 {\n168\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n169\t\t}\n170\t\n171\t\t// 请求体 model 改写（契约 3）\n172\t\tbodyBytes = rewriteModel(bodyBytes, reqBody, p.model)\n173\t\n174\t\t// 重新解析改写后的请求体\n175\t\treqBody = nil\n176\t\tif len(bodyBytes) > 0 {\n177\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n178\t\t}\n179\t\n180\t\t// 为 thinking 模式下的 assistant tool_call 消息注入 reasoning_content\n181\t\tbodyBytes = injectReasoningContentCached(bodyBytes, reqBody, p.reasoningCache, p.kimiMode)\n182\t\treqBody = nil\n183\t\tif len(bodyBytes) > 0 {\n184\t\t\t_ = json.Unmarshal(bodyBytes, &reqBody)\n185\t\t}\n186\t\n187\t\t// 生成请求 ID 与 Turn 编号\n188\t\treqID := fmt.Sprintf(\"req_%d\", time.Now().UnixNano()%1e12)\n189\t\tturn := int(p.turn.Add(1))\n190\t\tt0 := time.Now()\n191\t\n192\t\tlogger.Debug(\"proxy\", \"[Turn %d] request: %s %s (%d bytes)\", turn, r.Method, r.URL.Path, len(bodyBytes))\n193\t\n194\t\t// 读取当前状态快照\n195\t\tp.availableMu.Lock()\n196\t\tupstreamAvailable := p.upstreamAvailable\n197\t\tfbConfigs := make([]*FallbackConfig, len(p.fallbackConfigs))\n198\t\tcopy(fbConfigs, p.fallbackConfigs)\n199\t\tfbIdx := p.fallbackIndex\n200\t\tp.availableMu.Unlock()\n201\t\thasFallback := len(fbConfigs) > 0\n202\t\n203\t\t// ========== Phase 1: 尝试主上游 ==========\n204\t\tif upstreamAvailable {\n205\t\t\tupstreamURL := p.target + r.URL.Path\n206\t\t\tif r.URL.RawQuery != \"\" {\n207\t\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n208\t\t\t}\n209\t\n210\t\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(bodyBytes))\n211\t\t\tif err != nil {\n212\t\t\t\tlogProxyError(w, turn, err, 0)\n213\t\t\t\treturn\n214\t\t\t}\n215\t\n216\t\t\t// 复制请求头，过滤逐跳头\n217\t\t\tfor k, vals := range r.Header {\n218\t\t\t\tlower := strings.ToLower(k)\n219\t\t\t\tif hopByHopHeaders[lower] {\n220\t\t\t\t\tcontinue\n221\t\t\t\t}\n222\t\t\t\tfor _, v := range vals {\n223\t\t\t\t\tupstreamReq.Header.Add(k, v)\n224\t\t\t\t}\n225\t\t\t}\n226\t\t\tupstreamReq.Header.Del(\"Host\")\n227\t\n228\t\t\tresp, err := p.doWithRetry(upstreamReq, turn, hasFallback)\n229\t\t\tif err != nil {\n230\t\t\t\t// 连接错误 → 标记不可用，进入 fallback 链\n231\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] primary connection error: %v\", turn, err)\n232\t\t\t\tp.markUnavailable()\n233\t\t\t\t// fall through to fallback chain\n234\t\t\t} else if !shouldFallback(resp.StatusCode) {\n235\t\t\t\t// 主上游成功（或非降级错误如 400），直接处理响应\n236\t\t\t\tdefer resp.Body.Close()\n237\t\t\t\tp.dispatchResponse(w, resp, reqID, turn, r, reqBody, t0)\n238\t\t\t\treturn\n239\t\t\t} else {\n240\t\t\t\t// 主上游返回需要降级的状态码 → 标记不可用，进入 fallback 链\n241\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] primary returned %d, triggering fallback\", turn, resp.StatusCode)\n242\t\t\t\tresp.Body.Close()\n243\t\t\t\tp.markUnavailable()\n244\t\t\t\t// fall through to fallback chain\n245\t\t\t}\n246\t\t}\n247\t\n248\t\t// ========== Phase 2: 尝试 Fallback 链 ==========\n249\t\tif hasFallback {\n250\t\t\tfor i := 0; i < len(fbConfigs); i++ {\n251\t\t\t\tidx := (fbIdx + i) % len(fbConfigs)\n252\t\t\t\tfb := fbConfigs[idx]\n253\t\n254\t\t\t\t// 从原始请求体重新改写 model\n255\t\t\t\tfbBody := make([]byte, len(originalBody))\n256\t\t\t\tcopy(fbBody, originalBody)\n257\t\t\t\tvar fbParsed any\n258\t\t\t\tif len(fbBody) > 0 {\n259\t\t\t\t\t_ = json.Unmarshal(fbBody, &fbParsed)\n260\t\t\t\t}\n261\t\t\t\tif fb.Model != \"\" {\n262\t\t\t\t\tfbBody = rewriteModel(fbBody, fbParsed, fb.Model)\n263\t\t\t\t\tfbParsed = nil\n264\t\t\t\t\tif len(fbBody) > 0 {\n265\t\t\t\t\t\t_ = json.Unmarshal(fbBody, &fbParsed)\n266\t\t\t\t\t}\n267\t\t\t\t}\n268\t\t\t\tfbBody = injectReasoningContentCached(fbBody, fbParsed, p.reasoningCache, IsKimiURL(fb.BaseURL))\n269\t\t\t\tfbParsed = nil\n270\t\t\t\tif len(fbBody) > 0 {\n271\t\t\t\t\t_ = json.Unmarshal(fbBody, &fbParsed)\n272\t\t\t\t}\n273\t\n274\t\t\t\t// 构建 fallback 请求\n275\t\t\t\tfbURL := fb.BaseURL + r.URL.Path\n276\t\t\t\tif r.URL.RawQuery != \"\" {\n277\t\t\t\t\tfbURL += \"?\" + r.URL.RawQuery\n278\t\t\t\t}\n279\t\n280\t\t\t\tfbReq, err := http.NewRequest(r.Method, fbURL, bytes.NewReader(fbBody))\n281\t\t\t\tif err != nil {\n282\t\t\t\t\tp.advanceFallback()\n283\t\t\t\t\tcontinue\n284\t\t\t\t}\n285\t\n286\t\t\t\tfor k, vals := range r.Header {\n287\t\t\t\t\tlower := strings.ToLower(k)\n288\t\t\t\t\tif hopByHopHeaders[lower] {\n289\t\t\t\t\t\tcontinue\n290\t\t\t\t\t}\n291\t\t\t\t\tfor _, v := range vals {\n292\t\t\t\t\t\tfbReq.Header.Add(k, v)\n293\t\t\t\t\t}\n294\t\t\t\t}\n295\t\t\t\tfbReq.Header.Del(\"Host\")\n296\t\n297\t\t\t\t// 替换认证头\n298\t\t\t\tif fb.APIKey != \"\" {\n299\t\t\t\t\tfbReq.Header.Set(\"x-api-key\", fb.APIKey)\n300\t\t\t\t}\n301\t\t\t\tif fb.AuthToken != \"\" {\n302\t\t\t\t\tfbReq.Header.Set(\"Authorization\", \"Bearer \"+fb.AuthToken)\n303\t\t\t\t}\n304\t\n305\t\t\t\t// 发送请求\n306\t\t\t\tfbResp, fbErr := p.client.Do(fbReq)\n307\t\t\t\tif fbErr != nil {\n308\t\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] fallback[%d] connection error: %v\", turn, idx, fbErr)\n309\t\t\t\t\tp.advanceFallback()\n310\t\t\t\t\tcontinue\n311\t\t\t\t}\n312\t\n313\t\t\t\tif shouldFallback(fbResp.StatusCode) {\n314\t\t\t\t\tfbResp.Body.Close()\n315\t\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] fallback[%d] returned %d, trying next\", turn, idx, fbResp.StatusCode)\n316\t\t\t\t\tp.advanceFallback()\n317\t\t\t\t\tcontinue\n318\t\t\t\t}\n319\t\n320\t\t\t\t// Fallback 成功！更新索引\n321\t\t\t\tp.availableMu.Lock()\n322\t\t\t\tp.fallbackIndex = idx\n323\t\t\t\tp.availableMu.Unlock()\n324\t\t\t\tlogger.Info(\"proxy\", \"[Turn %d] fallback[%d] succeeded (status %d)\", turn, idx, fbResp.StatusCode)\n325\t\n326\t\t\t\tdefer fbResp.Body.Close()\n327\t\t\t\tp.dispatchResponse(w, fbResp, reqID, turn, r, fbParsed, t0)\n328\t\t\t\treturn\n329\t\t\t}\n330\t\t}\n331\t\n332\t\t// ========== Phase 3: 所有目标失败 → 日志错误 ==========\n333\t\tlogProxyError(w, turn, fmt.Errorf(\"all targets failed\"), 0)\n334\t}\n335\t\n336\t// handleStreaming 处理 SSE 流式响应：\n337\t//   - 复制响应头并写入客户端\n338\t//   - 逐块读取上游响应体并实时转发给客户端\n339\t//   - 使用 SSE 重组器收集完整事件\n340\t//   - 将重组后的结果写入 Trace\n341\tfunc (p *ReverseProxy) handleStreaming(\n342\t\tw http.ResponseWriter,\n343\t\tupstreamResp *http.Response,\n344\t\treqID string, turn, durationMs int,\n345\t\tr *http.Request, reqBody any,\n346\t\tt0 time.Time, model string,\n347\t) {\n348\t\t// 复制响应头\n349\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n350\t\tfor k, vals := range respHeaders {\n351\t\t\tfor _, v := range vals {\n352\t\t\t\tw.Header().Add(k, v)\n353\t\t\t}\n354\t\t}\n355\t\tw.WriteHeader(upstreamResp.StatusCode)\n356\t\n357\t\tflusher, canFlush := w.(http.Flusher)\n358\t\treassembler := sse.NewSSEReassembler()\n359\t\n360\t\t// 逐块读取并转发流式数据\n361\t\tbuf := make([]byte, 32*1024)\n362\t\tfor {\n363\t\t\tn, err := upstreamResp.Body.Read(buf)\n364\t\t\tif n > 0 {\n365\t\t\t\t_, _ = w.Write(buf[:n])\n366\t\t\t\tif canFlush {\n367\t\t\t\t\tflusher.Flush()\n368\t\t\t\t}\n369\t\t\t\treassembler.FeedBytes(buf[:n])\n370\t\t\t}\n371\t\t\tif err != nil {\n372\t\t\t\tbreak\n373\t\t\t}\n374\t\t}\n375\t\n376\t\tdurationMs = int(time.Since(t0).Milliseconds())\n377\t\treconstructed := reassembler.Reconstruct()\n378\t\tlogger.Debug(\"proxy\", \"[Turn %d] stream done: %d SSE events, %dms\", turn, len(reassembler.Events), durationMs)\n379\t\n380\t\t// kimi 模式下缓存 SSE 响应中的 reasoning_content\n381\t\tif p.kimiMode && reconstructed != nil {\n382\t\t\tp.cacheFromResponse(reconstructed)\n383\t\t}\n384\t\n385\t\t// 构建 Trace 记录\n386\t\trecord := buildRecord(\n387\t\t\treqID, turn, durationMs,\n388\t\t\tr.Method, r.URL.RequestURI(),\n389\t\t\tr.Header, reqBody,\n390\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n391\t\t\treconstructed,\n392\t\t\treassembler.Events,\n393\t\t\tp.target,\n394\t\t)\n395\t\n396\t\tif w := p.getWriter(); w != nil {\n397\t\t\tif err := w.Write(record); err != nil {\n398\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n399\t\t\t}\n400\t\t} else {\n401\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n402\t\t}\n403\t\n404\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d stream done (%dms, model=%s)\", turn, upstreamResp.StatusCode, durationMs, model)\n405\t}\n406\t\n407\t// handleNonStreaming 处理普通（非流式）响应：\n408\t//   - 读取完整响应体\n409\t//   - 按需解压（gzip / deflate）\n410\t//   - 解析 JSON 响应体\n411\t//   - 写入 Trace 并返回给客户端\n412\tfunc (p *ReverseProxy) handleNonStreaming(\n413\t\tw http.ResponseWriter,\n414\t\tupstreamResp *http.Response,\n415\t\treqID string, turn, durationMs int,\n416\t\tr *http.Request, reqBody any, model string,\n417\t) {\n418\t\trespBytes, err := io.ReadAll(upstreamResp.Body)\n419\t\tif err != nil {\n420\t\t\thttp.Error(w, \"read upstream: \"+err.Error(), http.StatusBadGateway)\n421\t\t\treturn\n422\t\t}\n423\t\n424\t\t// 按需解压响应体\n425\t\tdecodeBytes := respBytes\n426\t\tencoding := strings.ToLower(upstreamResp.Header.Get(\"Content-Encoding\"))\n427\t\tif len(respBytes) > 0 && (encoding == \"gzip\" || encoding == \"deflate\") {\n428\t\t\tvar reader io.ReadCloser\n429\t\t\tif encoding == \"gzip\" {\n430\t\t\t\treader, _ = gzip.NewReader(bytes.NewReader(respBytes))\n431\t\t\t} else {\n432\t\t\t\treader, _ = zlib.NewReader(bytes.NewReader(respBytes))\n433\t\t\t}\n434\t\t\tif reader != nil {\n435\t\t\t\tif decoded, err := io.ReadAll(reader); err == nil {\n436\t\t\t\t\tlogger.Debug(\"proxy\", \"[Turn %d] decompressed: %d -> %d bytes (%s)\", turn, len(respBytes), len(decoded), encoding)\n437\t\t\t\t\tdecodeBytes = decoded\n438\t\t\t\t}\n439\t\t\t\t_ = reader.Close()\n440\t\t\t}\n441\t\t}\n442\t\n443\t\t// 解析解压后的 JSON 响应体\n444\t\tvar respBody any\n445\t\tif len(decodeBytes) > 0 {\n446\t\t\t_ = json.Unmarshal(decodeBytes, &respBody)\n447\t\t}\n448\t\n449\t\t// kimi 模式下缓存响应中的 reasoning_content\n450\t\tif p.kimiMode {\n451\t\t\tif respMap, ok := respBody.(map[string]any); ok {\n452\t\t\t\tp.cacheFromResponse(respMap)\n453\t\t\t}\n454\t\t}\n455\t\n456\t\t// 构建 Trace 记录\n457\t\trecord := buildRecord(\n458\t\t\treqID, turn, durationMs,\n459\t\t\tr.Method, r.URL.RequestURI(),\n460\t\t\tr.Header, reqBody,\n461\t\t\tupstreamResp.StatusCode, upstreamResp.Header,\n462\t\t\trespBody,\n463\t\t\tnil,\n464\t\t\tp.target,\n465\t\t)\n466\t\n467\t\tif w := p.getWriter(); w != nil {\n468\t\t\tif err := w.Write(record); err != nil {\n469\t\t\t\tlogger.Error(\"proxy\", \"[Turn %d] trace write error: %v\", turn, err)\n470\t\t\t}\n471\t\t} else {\n472\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] trace skipped: writer not initialized\", turn)\n473\t\t}\n474\t\n475\t\t// 将响应返回给客户端\n476\t\trespHeaders := FilterHeaders(upstreamResp.Header, false)\n477\t\tfor k, vals := range respHeaders {\n478\t\t\tfor _, v := range vals {\n479\t\t\t\tw.Header().Add(k, v)\n480\t\t\t}\n481\t\t}\n482\t\tw.WriteHeader(upstreamResp.StatusCode)\n483\t\t_, _ = w.Write(respBytes)\n484\t\n485\t\tlogger.Info(\"proxy\", \"[Turn %d] <- %d (%dms, %d bytes, model=%s)\", turn, upstreamResp.StatusCode, durationMs, len(respBytes), model)\n486\t}\n487\t\n488\t// buildRecord 构建一条 Trace 记录，包含请求/响应的完整信息。\n489\tfunc buildRecord(\n490\t\treqID string, turn, durationMs int,\n491\t\tmethod, path string,\n492\t\treqHeaders http.Header, reqBody any,\n493\t\tstatus int, respHeaders http.Header,\n494\t\trespBody any,\n495\t\tsseEvents []map[string]any,\n496\t\tupstreamBaseURL string,\n497\t) map[string]any {\n498\t\trecord := map[string]any{\n499\t\t\t\"timestamp\":   time.Now().UTC().Format(\"2006-01-02T15:04:05.000000Z\"),\n500\t\t\t\"request_id\":  reqID,\n501\t\t\t\"session_id\":  extractSessionID(reqBody),\n502\t\t\t\"turn\":        turn,\n503\t\t\t\"duration_ms\": durationMs,\n504\t\t\t\"request\": map[string]any{\n505\t\t\t\t\"method\":  method,\n506\t\t\t\t\"path\":    path,\n507\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(reqHeaders, true)),\n508\t\t\t\t\"body\":    reqBody,\n509\t\t\t},\n510\t\t\t\"response\": map[string]any{\n511\t\t\t\t\"status\":  status,\n512\t\t\t\t\"headers\": HeadersToMap(FilterHeaders(respHeaders, true)),\n513\t\t\t\t\"body\":    respBody,\n514\t\t\t},\n515\t\t}\n516\t\tif len(sseEvents) > 0 {\n517\t\t\trecord[\"response\"].(map[string]any)[\"sse_events\"] = sseEvents\n518\t\t}\n519\t\tif upstreamBaseURL != \"\" {\n520\t\t\trecord[\"upstream_base_url\"] = upstreamBaseURL\n521\t\t}\n522\t\treturn record\n523\t}\n524\t\n525\t// extractSessionID 从请求体的 metadata.user_id 字段中提取 session_id。\n526\t// Claude Code 发送的格式为：metadata.user_id = \"{\\\"session_id\\\": \\\"uuid\\\", ...}\"\n527\tfunc extractSessionID(reqBody any) string {\n528\t\tbody, ok := reqBody.(map[string]any)\n529\t\tif !ok {\n530\t\t\treturn \"\"\n531\t\t}\n532\t\tmetadata, _ := body[\"metadata\"].(map[string]any)\n533\t\tif metadata == nil {\n534\t\t\treturn \"\"\n535\t\t}\n536\t\tuserIDRaw, _ := metadata[\"user_id\"].(string)\n537\t\tif userIDRaw == \"\" {\n538\t\t\treturn \"\"\n539\t\t}\n540\t\tvar userData map[string]string\n541\t\tif json.Unmarshal([]byte(userIDRaw), &userData) != nil {\n542\t\t\treturn \"\"\n543\t\t}\n544\t\treturn userData[\"session_id\"]\n545\t}\n546\t\n547\t// handleInternal 分发内部代理端点请求。\n548\tfunc (p *ReverseProxy) handleInternal(w http.ResponseWriter, r *http.Request) {\n549\t\tswitch r.URL.Path {\n550\t\tcase \"/_internal/trace-init\":\n551\t\t\tp.handleTraceInit(w, r)\n552\t\tdefault:\n553\t\t\thttp.NotFound(w, r)\n554\t\t}\n555\t}\n556\t\n557\t// handleTraceInit 接收 SessionStart 钩子传来的会话信息，创建 Trace 写入器。\n558\tfunc (p *ReverseProxy) handleTraceInit(w http.ResponseWriter, r *http.Request) {\n559\t\tif r.Method != http.MethodPost {\n560\t\t\thttp.Error(w, \"use POST\", http.StatusMethodNotAllowed)\n561\t\t\treturn\n562\t\t}\n563\t\n564\t\tvar req struct {\n565\t\t\tSessionID      string `json:\"session_id\"`\n566\t\t\tMachineID      string `json:\"machine_id\"`\n567\t\t\tProjectSlug    string `json:\"project_slug\"`\n568\t\t\tTranscriptPath string `json:\"transcript_path\"`\n569\t\t}\n570\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {\n571\t\t\tlogger.Warn(\"proxy\", \"trace-init: invalid JSON: %v\", err)\n572\t\t\thttp.Error(w, \"invalid JSON\", http.StatusBadRequest)\n573\t\t\treturn\n574\t\t}\n575\t\n576\t\tif req.SessionID == \"\" {\n577\t\t\thttp.Error(w, \"session_id is required\", http.StatusBadRequest)\n578\t\t\treturn\n579\t\t}\n580\t\n581\t\t// 允许 session 重新绑定（/clear 后新 session 取代旧 session）\n582\t\tif p.sessionID != \"\" && p.sessionID != req.SessionID {\n583\t\t\tlogger.Debug(\"proxy\", \"trace-init: rebinding session %s -> %s\", p.sessionID, req.SessionID)\n584\t\t}\n585\t\n586\t\tlogger.Debug(\"proxy\", \"trace-init: session=%s machine=%s slug=%s\", req.SessionID, req.MachineID, req.ProjectSlug)\n587\t\n588\t\t// 若请求中未提供，则通过 trace 包自动检测\n589\t\tmachineID := req.MachineID\n590\t\tif machineID == \"\" {\n591\t\t\tmachineID = trace.MachineID()\n592\t\t}\n593\t\n594\t\tprojectSlug := req.ProjectSlug\n595\t\tif projectSlug == \"\" {\n596\t\t\tprojectSlug = trace.ExtractProjectSlug(req.TranscriptPath)\n597\t\t\tif projectSlug == \"\" {\n598\t\t\t\tprojectSlug = trace.DetectProjectName()\n599\t\t\t}\n600\t\t}\n601\t\n602\t\t// 创建会话专属的 Trace 写入器\n603\t\ttracePath := trace.NewSessionTracePath(p.baseDir, machineID, projectSlug, req.SessionID)\n604\t\twriter, err := trace.NewTraceWriter(tracePath)\n605\t\tp.sessionID = req.SessionID   // 记录当前会话 ID\n606\t\tp.projectSlug = projectSlug   // 记录当前项目标识\n607\t\tif err != nil {\n608\t\t\tlogger.Error(\"proxy\", \"trace-init: failed to create writer: %v\", err)\n609\t\t\thttp.Error(w, \"failed to create trace file\", http.StatusInternalServerError)\n610\t\t\treturn\n611\t\t}\n612\t\n613\t\t\t// 关闭之前的写入器（如果存在，如 session resume 场景）\n614\t\t\tif p.writer != nil {\n615\t\t\t\tp.writer.Close()\n616\t\t\t\tlogger.Debug(\"proxy\", \"previous writer closed\")\n617\t\t\t}\n618\t\tp.writer = writer\n619\t\tlogger.Info(\"proxy\", \"trace initialized: %s\", tracePath)\n620\t\n621\t\t// 通知外部注册 proxy.json\n622\t\tif p.OnSessionInit != nil {\n623\t\t\tp.OnSessionInit(req.SessionID, projectSlug)\n624\t\t}\n625\t\n626\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n627\t\tjson.NewEncoder(w).Encode(map[string]string{\n628\t\t\t\"status\":     \"ok\",\n629\t\t\t\"trace_path\": tracePath,\n630\t\t})\n631\t}\n632\t\n633\t// getWriter 返回当前会话的 Trace 写入器。\n634\t// trace-init 调用前返回 nil（由 SessionStart hook 触发，一定在首个 API 请求之前）。\n635\tfunc (p *ReverseProxy) getWriter() *trace.TraceWriter {\n636\t\treturn p.writer\n637\t}\n638\t\n639\t// Summary 返回当前 Trace 写入器的聚合统计信息。\n640\t// 若无有效写入器，返回零值统计。\n641\tfunc (p *ReverseProxy) Summary() map[string]any {\n642\t\tif w := p.getWriter(); w != nil {\n643\t\t\treturn w.Summary()\n644\t\t}\n645\t\treturn map[string]any{\n646\t\t\t\"api_calls\":           0,\n647\t\t\t\"input_tokens\":        int64(0),\n648\t\t\t\"output_tokens\":       int64(0),\n649\t\t\t\"cache_read_tokens\":   int64(0),\n650\t\t\t\"cache_create_tokens\": int64(0),\n651\t\t}\n652\t}\n653\t\n654\t// SessionID 返回当前会话的 session_id。\n655\t// 优先返回 trace-init 设置的值，其次回退到写入器中提取的值。\n656\tfunc (p *ReverseProxy) SessionID() string {\n657\t\tif p.sessionID != \"\" {\n658\t\t\treturn p.sessionID\n659\t\t}\n660\t\tif w := p.getWriter(); w != nil {\n661\t\t\treturn w.SessionID()\n662\t\t}\n663\t\treturn \"\"\n664\t}\n665\t\n666\t// ProjectSlug 返回当前项目的 project_slug（由 trace-init 设置）。\n667\tfunc (p *ReverseProxy) ProjectSlug() string {\n668\t\treturn p.projectSlug\n669\t}\n670\t\n671\t// TracePath 返回当前追踪文件的完整路径。\n672\tfunc (p *ReverseProxy) TracePath() string {\n673\t\tif w := p.getWriter(); w != nil {\n674\t\t\treturn w.Path()\n675\t\t}\n676\t\treturn \"\"\n677\t}\n678\t\n679\t// doWithRetry 向上游发送请求，连接错误或 5xx 时进行重试。\n680\t// 如果 hasFallback 为 true（有兜底配置），不重试直接返回错误，由调用方切换兜底。\n681\t// 如果 hasFallback 为 false（无兜底配置），重试 maxUpstreamRetries 次，间隔 retryInterval。\n682\tfunc (p *ReverseProxy) doWithRetry(req *http.Request, turn int, hasFallback bool) (*http.Response, error) {\n683\t\tvar lastErr error\n684\t\tvar savedBody []byte\n685\t\n686\t\tmaxRetries := maxUpstreamRetries\n687\t\tif hasFallback {\n688\t\t\tmaxRetries = 0 // 有兜底时不重试，让 serveHTTP 立即切换\n689\t\t}\n690\t\n691\t\tfor attempt := 0; attempt <= maxRetries; attempt++ {\n692\t\t\tif attempt > 0 {\n693\t\t\t\tinterval := p.retryInterval\n694\t\t\t\tif interval == 0 {\n695\t\t\t\t\tinterval = retryInterval\n696\t\t\t\t}\n697\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] retry %d/%d after %v\", turn, attempt, maxUpstreamRetries, interval)\n698\t\t\t\ttime.Sleep(interval)\n699\t\t\t}\n700\t\n701\t\t\t// 第一次读取时保存 body，后续复用\n702\t\t\tif savedBody == nil && req.Body != nil {\n703\t\t\t\tsavedBody, _ = io.ReadAll(req.Body)\n704\t\t\t\treq.Body.Close()\n705\t\t\t}\n706\t\n707\t\t\tretryReq, err := http.NewRequest(req.Method, req.URL.String(), bytes.NewReader(savedBody))\n708\t\t\tif err != nil {\n709\t\t\t\treturn nil, err\n710\t\t\t}\n711\t\t\tretryReq.Header = req.Header.Clone()\n712\t\n713\t\t\tresp, err := p.client.Do(retryReq)\n714\t\t\tif err != nil {\n715\t\t\t\tlastErr = err\n716\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] attempt %d failed: %v\", turn, attempt+1, err)\n717\t\t\t\tif attempt < maxRetries {\n718\t\t\t\t\tcontinue\n719\t\t\t\t}\n720\t\t\t\treturn nil, fmt.Errorf(\"all %d retries exhausted: %w\", maxRetries, lastErr)\n721\t\t\t}\n722\t\n723\t\t\t// 5xx 错误触发重试，4xx 不重试；最后一次直接返回（让 serveHTTP 透传）\n724\t\t\tif resp.StatusCode >= 500 {\n725\t\t\t\tlastErr = fmt.Errorf(\"upstream returned %d\", resp.StatusCode)\n726\t\t\t\tif attempt < maxRetries {\n727\t\t\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] attempt %d: status %d, will retry\", turn, attempt+1, resp.StatusCode)\n728\t\t\t\t\tresp.Body.Close()\n729\t\t\t\t\tcontinue\n730\t\t\t\t}\n731\t\t\t\t// 最后一次尝试，直接返回响应（serveHTTP 会标记不可用并透传）\n732\t\t\t\treturn resp, nil\n733\t\t\t}\n734\t\n735\t\t\treturn resp, nil\n736\t\t}\n737\t\n738\t\treturn nil, fmt.Errorf(\"all %d retries exhausted: %w\", maxRetries, lastErr)\n739\t}\n740\t\n741\t// shouldFallback reports whether the HTTP status code should trigger fallback to the next profile.\n742\t// 401 (认证失败)、403 (访问被拒)、429 (频率超限)、5xx (服务器错误) 均触发降级。\n743\tfunc shouldFallback(statusCode int) bool {\n744\t\treturn statusCode == http.StatusUnauthorized ||\n745\t\t\tstatusCode == http.StatusForbidden ||\n746\t\t\tstatusCode == http.StatusTooManyRequests ||\n747\t\t\tstatusCode >= http.StatusInternalServerError\n748\t}\n749\t\n750\t// logProxyError 将友好中文提示输出到日志，同时返回 Anthropic API 格式的 JSON 错误响应。\n751\t// 必须返回 JSON 而非纯文本，否则 Claude Code 解析会崩溃。\n752\tfunc logProxyError(w http.ResponseWriter, turn int, lastErr error, lastStatusCode int) {\n753\t\tmsg := \"上游服务暂时不可用，请稍后重试\"\n754\t\tswitch {\n755\t\tcase lastStatusCode == http.StatusForbidden:\n756\t\t\tmsg = \"API 访问被拒绝 (403)，可能是认证信息过期或无权限，已尝试所有可用配置\"\n757\t\tcase lastStatusCode == http.StatusUnauthorized:\n758\t\t\tmsg = \"API 认证失败 (401)，请检查 API Key 或 Token 配置，已尝试所有可用配置\"\n759\t\tcase lastStatusCode == http.StatusTooManyRequests:\n760\t\t\tmsg = \"API 请求频率超限 (429)，所有配置均已限流，请稍后重试\"\n761\t\tcase lastErr != nil:\n762\t\t\tmsg = \"上游连接失败: \" + lastErr.Error()\n763\t\t}\n764\t\n765\t\tlogger.Error(\"proxy\", \"[Turn %d] %s\", turn, msg)\n766\t\n767\t\tstatusCode := lastStatusCode\n768\t\tif statusCode == 0 {\n769\t\t\tstatusCode = http.StatusBadGateway\n770\t\t}\n771\t\n772\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n773\t\tw.WriteHeader(statusCode)\n774\t\tjson.NewEncoder(w).Encode(map[string]any{\n775\t\t\t\"type\": \"error\",\n776\t\t\t\"error\": map[string]any{\n777\t\t\t\t\"type\":    \"api_error\",\n778\t\t\t\t\"message\": msg,\n779\t\t\t},\n780\t\t})\n781\t}\n782\t\n783\t// dispatchResponse extracts model/stream info from reqBody and dispatches to the appropriate handler.\n784\tfunc (p *ReverseProxy) dispatchResponse(w http.ResponseWriter, resp *http.Response, reqID string, turn int, r *http.Request, reqBody any, t0 time.Time) {\n785\t\tdurationMs := int(time.Since(t0).Milliseconds())\n786\t\n787\t\tmodel := \"\"\n788\t\tisStreaming := false\n789\t\tif m, ok := reqBody.(map[string]any); ok {\n790\t\t\tif v, ok := m[\"model\"].(string); ok {\n791\t\t\t\tmodel = v\n792\t\t\t}\n793\t\t\tif s, ok := m[\"stream\"].(bool); ok {\n794\t\t\t\tisStreaming = s\n795\t\t\t}\n796\t\t}\n797\t\n798\t\tif isStreaming {\n799\t\t\tp.handleStreaming(w, resp, reqID, turn, durationMs, r, reqBody, t0, model)\n800\t\t} else {\n801\t\t\tp.handleNonStreaming(w, resp, reqID, turn, durationMs, r, reqBody, model)\n802\t\t}\n803\t}\n804\t\n805\t// markUnavailable 标记上游不可用（契约 4）。\n806\t// 首次失败后置 upstreamAvailable = false，进程生命周期内不再恢复。\n807\tfunc (p *ReverseProxy) markUnavailable() {\n808\t\tp.availableMu.Lock()\n809\t\tdefer p.availableMu.Unlock()\n810\t\tif p.upstreamAvailable {\n811\t\t\tp.upstreamAvailable = false\n812\t\t\tlogger.Warn(\"proxy\", \"upstream marked unavailable, switching to fallback\")\n813\t\t}\n814\t}\n815\t\n816\t// SetModel 设置强制替换的模型名。\n817\tfunc (p *ReverseProxy) SetModel(model string) {\n818\t\tp.model = model\n819\t}\n820\t\n821\t// SetFallbackConfigs 设置兜底配置列表，支持多 profile 轮询。\n822\tfunc (p *ReverseProxy) SetFallbackConfigs(cfgs []*FallbackConfig) {\n823\t\tp.availableMu.Lock()\n824\t\tdefer p.availableMu.Unlock()\n825\t\tp.fallbackConfigs = cfgs\n826\t\tp.fallbackIndex = 0\n827\t}\n828\t\n829\t// currentFallbackConfig 返回当前轮询的 fallback 配置。\n830\tfunc (p *ReverseProxy) currentFallbackConfig() *FallbackConfig {\n831\t\tif len(p.fallbackConfigs) == 0 {\n832\t\t\treturn nil\n833\t\t}\n834\t\tidx := p.fallbackIndex % len(p.fallbackConfigs)\n835\t\treturn p.fallbackConfigs[idx]\n836\t}\n837\t\n838\t// advanceFallback 切换到下一个 fallback 配置（轮询）。\n839\tfunc (p *ReverseProxy) advanceFallback() {\n840\t\tp.availableMu.Lock()\n841\t\tdefer p.availableMu.Unlock()\n842\t\tp.fallbackIndex++\n843\t\tlogger.Info(\"proxy\", \"fallback advanced to index %d\", p.fallbackIndex)\n844\t}\n845\t\n846\t// SetKimiMode 启用或禁用 kimi 模式。\n847\t// 启用时会自动创建 reasoning_content 缓存。\n848\tfunc (p *ReverseProxy) SetKimiMode(kimi bool) {\n849\t\tp.kimiMode = kimi\n850\t\tif kimi && p.reasoningCache == nil {\n851\t\t\tp.reasoningCache = NewReasoningCache()\n852\t\t\tlogger.Info(\"proxy\", \"reasoning_content mode enabled (kimi/deepseek), caching active\")\n853\t\t}\n854\t}\n855\t\n856\t// reasoningPrefixes 定义需要 reasoning_content 注入的上游 URL 前缀（scheme + host）。\n857\tvar reasoningPrefixes = []string{\n858\t\t\"https://api.kimi.com\",\n859\t\t\"https://api.moonshot.cn\",\n860\t\t\"https://api.deepseek.com\",\n861\t}\n862\t\n863\t// IsKimiURL 判断 URL 是否为需要 reasoning_content 注入的上游（kimi/moonshot/deepseek）。\n864\t// 基于 URL 前缀匹配，避免子串误判。\n865\tfunc IsKimiURL(url string) bool {\n866\t\tlower := strings.ToLower(url)\n867\t\tfor _, prefix := range reasoningPrefixes {\n868\t\t\tif strings.HasPrefix(lower, prefix) {\n869\t\t\t\treturn true\n870\t\t\t}\n871\t\t}\n872\t\treturn false\n873\t}\n874\t\n875\t// cacheFromResponse 从 API 响应快照中提取 reasoning_content 并存入缓存。\n876\t//\n877\t// 同时处理两种响应格式：\n878\t//   - OpenAI Chat Completions: snap[\"choices\"][0][\"message\"] 包含 reasoning_content/content/tool_calls\n879\t//   - Anthropic: snap[\"content\"] 包含 thinking 块和 tool_use 块\n880\t//\n881\t// 仅在 kimi 模式下调用。\n882\tfunc (p *ReverseProxy) cacheFromResponse(snap map[string]any) {\n883\t\tif p.reasoningCache == nil || snap == nil {\n884\t\t\treturn\n885\t\t}\n886\t\n887\t\t// 提取 reasoning_content 和消息内容\n888\t\tvar reasoningContent string\n889\t\tvar msgContent string    // 文本内容（用于 full key）\n890\t\tvar toolCallsJSON string // tool_calls JSON（用于 tc key 和 full key）\n891\t\n892\t\t// 路径 1: OpenAI Chat Completions 格式\n893\t\tchoices, _ := snap[\"choices\"].([]any)\n894\t\tif len(choices) > 0 {\n895\t\t\tchoice, _ := choices[0].(map[string]any)\n896\t\t\tif choice != nil {\n897\t\t\t\tmsg, _ := choice[\"message\"].(map[string]any)\n898\t\t\t\tif msg != nil {\n899\t\t\t\t\treasoningContent, _ = msg[\"reasoning_content\"].(string)\n900\t\t\t\t\tmsgContent, _ = msg[\"content\"].(string)\n901\t\t\t\t\tif tc, ok := msg[\"tool_calls\"]; ok && tc != nil {\n902\t\t\t\t\t\tif tcBytes, err := json.Marshal(tc); err == nil {\n903\t\t\t\t\t\t\ttoolCallsJSON = string(tcBytes)\n904\t\t\t\t\t\t}\n905\t\t\t\t\t}\n906\t\t\t\t}\n907\t\t\t}\n908\t\t}\n909\t\n910\t\t// 路径 2: Anthropic 格式（从 content 数组中的 thinking 块提取）\n911\t\tif reasoningContent == \"\" {\n912\t\t\tcontentArr, _ := snap[\"content\"].([]any)\n913\t\t\tfor _, blockRaw := range contentArr {\n914\t\t\t\tblock, ok := blockRaw.(map[string]any)\n915\t\t\t\tif !ok {\n916\t\t\t\t\tcontinue\n917\t\t\t\t}\n918\t\t\t\tif blockType, _ := block[\"type\"].(string); blockType == \"thinking\" {\n919\t\t\t\t\tif thinking, ok := block[\"thinking\"].(string); ok && thinking != \"\" {\n920\t\t\t\t\t\treasoningContent = thinking\n921\t\t\t\t\t\tbreak\n922\t\t\t\t\t}\n923\t\t\t\t}\n924\t\t\t}\n925\t\t\t// 同时从 Anthropic 格式提取 tool_use 块用于 key 计算\n926\t\t\tif toolCallsJSON == \"\" {\n927\t\t\t\tvar toolUseBlocks []any\n928\t\t\t\tfor _, blockRaw := range contentArr {\n929\t\t\t\t\tblock, ok := blockRaw.(map[string]any)\n930\t\t\t\t\tif !ok {\n931\t\t\t\t\t\tcontinue\n932\t\t\t\t\t}\n933\t\t\t\t\tif blockType, _ := block[\"type\"].(string); blockType == \"tool_use\" {\n934\t\t\t\t\t\ttoolUseBlocks = append(toolUseBlocks, block)\n935\t\t\t\t\t}\n936\t\t\t\t}\n937\t\t\t\tif len(toolUseBlocks) > 0 {\n938\t\t\t\t\tif tcBytes, err := json.Marshal(toolUseBlocks); err == nil {\n939\t\t\t\t\t\ttoolCallsJSON = string(tcBytes)\n940\t\t\t\t\t}\n941\t\t\t\t}\n942\t\t\t}\n943\t\t}\n944\t\n945\t\tif reasoningContent == \"\" {\n946\t\t\treturn // 无 reasoning_content 可缓存\n947\t\t}\n948\t\n949\t\tfullKey := MakeFullKey(msgContent, toolCallsJSON)\n950\t\ttcKey := MakeToolcallKey(toolCallsJSON)\n951\t\tp.reasoningCache.Store(fullKey, tcKey, reasoningContent)\n952\t\n953\t\tf, t := p.reasoningCache.Len()\n954\t\tlogger.Debug(\"proxy\", \"cached reasoning_content: rc_len=%d full=%d tc=%d\", len(reasoningContent), f, t)\n955\t}\n956\t\n957\t// rewriteModel 改写请求体 JSON 中的 model 字段（契约 3）。\n958\t// 如果 model 为空、body 为空、body 非 JSON 或 body 为 JSON 非对象，原样返回。\n959\tfunc rewriteModel(body []byte, parsed any, model string) []byte {\n960\t\tif model == \"\" || len(body) == 0 {\n961\t\t\treturn body\n962\t\t}\n963\t\n964\t\tm, ok := parsed.(map[string]any)\n965\t\tif !ok {\n966\t\t\treturn body // 非 JSON 或非对象\n967\t\t}\n968\t\n969\t\tm[\"model\"] = model\n970\t\trewritten, err := json.Marshal(m)\n971\t\tif err != nil {\n972\t\t\treturn body // 改写失败，原样返回\n973\t\t}\n974\t\treturn rewritten\n975\t}\n976\t\n977\t// injectReasoningContentCached 为 assistant tool_call 消息注入 reasoning_content 补丁。\n978\t//\n979\t// Kimi 等兼容 Anthropic 的端点要求：assistant tool_call 消息必须携带顶层字段 reasoning_content，\n980\t// 以及 content 数组中的 thinking 块。Claude Code 发送 tool_call 消息时不包含这些字段，导致上游 400 错误：\n981\t//\n982\t//\t400 thinking is enabled but reasoning_content is missing in assistant tool call message at index N\n983\t//\n984\t// 行为随 isKimi 参数变化：\n985\t//   - isKimi=false: 不做任何修改，直接透传\n986\t//   - isKimi=true + cache!=nil: 使用缓存的三级查找回填真实 reasoning_content\n987\t//   - isKimi=true + cache==nil: 注入空字符串（兜底行为，空字符串无害但能防止报错）\n988\tfunc injectReasoningContentCached(body []byte, parsed any, cache *ReasoningCache, isKimi bool) []byte {\n989\t\tif !isKimi {\n990\t\t\treturn body // 非 kimi 上游不做任何注入\n991\t\t}\n992\t\n993\t\tif len(body) == 0 {\n994\t\t\treturn body\n995\t\t}\n996\t\n997\t\tm, ok := parsed.(map[string]any)\n998\t\tif !ok {\n999\t\t\treturn body // 非 JSON 或非对象\n1000\t\t}\n1001\t\n1002\t\t// 获取 messages 数组（无 messages 则无需处理）\n1003\t\tmessages, ok := m[\"messages\"].([]any)\n1004\t\tif !ok || len(messages) == 0 {\n1005\t\t\treturn body\n1006\t\t}\n1007\t\n1008\t\tmodified := false\n1009\t\tfor i, msgRaw := range messages {\n1010\t\t\tmsg, ok := msgRaw.(map[string]any)\n1011\t\t\tif !ok {\n1012\t\t\t\tcontinue\n1013\t\t\t}\n1014\t\n1015\t\t\t// 只处理 assistant 消息\n1016\t\t\trole, _ := msg[\"role\"].(string)\n1017\t\t\tif role != \"assistant\" {\n1018\t\t\t\tcontinue\n1019\t\t\t}\n1020\t\n1021\t\t\t// 检查 content 是否为数组\n1022\t\t\tcontent, ok := msg[\"content\"].([]any)\n1023\t\t\tif !ok || len(content) == 0 {\n1024\t\t\t\tcontinue\n1025\t\t\t}\n1026\t\n1027\t\t\t// 检查是否有 tool_use 块、thinking 块、reasoning_content 字段\n1028\t\t\thasToolUse := false\n1029\t\t\thasThinking := false\n1030\t\t\tfor _, blockRaw := range content {\n1031\t\t\t\tblock, ok := blockRaw.(map[string]any)\n1032\t\t\t\tif !ok {\n1033\t\t\t\t\tcontinue\n1034\t\t\t\t}\n1035\t\t\t\tblockType, _ := block[\"type\"].(string)\n1036\t\t\t\tif blockType == \"tool_use\" {\n1037\t\t\t\t\thasToolUse = true\n1038\t\t\t\t}\n1039\t\t\t\tif blockType == \"thinking\" {\n1040\t\t\t\t\thasThinking = true\n1041\t\t\t\t}\n1042\t\t\t}\n1043\t\n1044\t\t\t// 检查已有的 reasoning_content\n1045\t\t\texistingRC, hasReasoningContent := msg[\"reasoning_content\"].(string)\n1046\t\n1047\t\t\t// 只处理含 tool_use 的 assistant 消息\n1048\t\t\tif !hasToolUse {\n1049\t\t\t\tcontinue\n1050\t\t\t}\n1051\t\n1052\t\t\tneedPatch := false\n1053\t\n1054\t\t\t// 如果已有非空的 reasoning_content，用它刷新缓存\n1055\t\t\tif hasReasoningContent && existingRC != \"\" && cache != nil {\n1056\t\t\t\tfullKey := MakeFullKeyFromMsg(msg)\n1057\t\t\t\ttcKey := MakeToolcallKeyFromMsg(msg)\n1058\t\t\t\tcache.Store(fullKey, tcKey, existingRC)\n1059\t\t\t\t// 已有完整 reasoning_content，不需要补丁\n1060\t\t\t\t// 但仍需确保 thinking 块存在\n1061\t\t\t}\n1062\t\n1063\t\t\t// 补丁 1: content 数组缺少 thinking 块 → 在开头插入\n1064\t\t\tif !hasThinking {\n1065\t\t\t\tthinkingBlock := map[string]any{\n1066\t\t\t\t\t\"type\":     \"thinking\",\n1067\t\t\t\t\t\"thinking\": \"\",\n1068\t\t\t\t}\n1069\t\t\t\tnewContent := make([]any, 0, len(content)+1)\n1070\t\t\t\tnewContent = append(newContent, thinkingBlock)\n1071\t\t\t\tnewContent = append(newContent, content...)\n1072\t\t\t\tmsg[\"content\"] = newContent\n1073\t\t\t\tneedPatch = true\n1074\t\t\t}\n1075\t\n1076\t\t\t// 补丁 2: 消息缺少顶层 reasoning_content 字段 → 尝试从缓存回填\n1077\t\t\tif !hasReasoningContent {\n1078\t\t\t\trcValue := \"\" // 兜底空字符串\n1079\t\t\t\tif cache != nil {\n1080\t\t\t\t\tfullKey := MakeFullKeyFromMsg(msg)\n1081\t\t\t\t\ttcKey := MakeToolcallKeyFromMsg(msg)\n1082\t\t\t\t\tif cached, found := cache.Lookup(fullKey, tcKey, true); found {\n1083\t\t\t\t\t\trcValue = cached\n1084\t\t\t\t\t}\n1085\t\t\t\t}\n1086\t\t\t\tmsg[\"reasoning_content\"] = rcValue\n1087\t\t\t\tneedPatch = true\n1088\t\t\t}\n1089\t\n1090\t\t\tif needPatch {\n1091\t\t\t\tmessages[i] = msg\n1092\t\t\t\tmodified = true\n1093\t\t\t}\n1094\t\t}\n1095\t\n1096\t\tif !modified {\n1097\t\t\treturn body\n1098\t\t}\n1099\t\n1100\t\tm[\"messages\"] = messages\n1101\t\trewritten, err := json.Marshal(m)\n1102\t\tif err != nil {\n1103\t\t\treturn body\n1104\t\t}\n1105\t\treturn rewritten\n1106\t}\n1107\t"}]}
