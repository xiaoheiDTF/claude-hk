n1101\t\t\tif a.Model == primary.Model {\n1102\t\t\t\tout = append(out, a)\n1103\t\t\t}\n1104\t\t}\n1105\t\treturn out\n1106\t}\n1107\t\n1108\t// forwardAlias 按单个别名转发一次请求。\n1109\t// 返回 (dispatched, lastStatus)：dispatched=true 表示已向客户端写出响应（成功或非降级状态如 400），调用方应停止重试；\n1110\t// dispatched=false 表示命中降级条件（连接错误或 401/403/429/5xx），调用方应尝试下一个候选。\n1111\tfunc (p *ReverseProxy) forwardAlias(w http.ResponseWriter, r *http.Request, a *Alias, originalBody []byte, reqID string, turn int, t0 time.Time) (bool, int) {\n1112\t\t// 改写 model 为真实 model\n1113\t\tbody := originalBody\n1114\t\tvar parsed any\n1115\t\tif len(body) > 0 {\n1116\t\t\t_ = json.Unmarshal(body, &parsed)\n1117\t\t}\n1118\t\tbody = rewriteModel(body, parsed, a.Model)\n1119\t\tparsed = nil\n1120\t\tif len(body) > 0 {\n1121\t\t\t_ = json.Unmarshal(body, &parsed)\n1122\t\t}\n1123\t\n1124\t\t// 按该别名注入 reasoning_content（kimi 系）\n1125\t\tbody = injectReasoningContentCached(body, parsed, p.reasoningCache, aliasKimiMode(a))\n1126\t\tparsed = nil\n1127\t\tif len(body) > 0 {\n1128\t\t\t_ = json.Unmarshal(body, &parsed)\n1129\t\t}\n1130\t\n1131\t\t// 构建上游请求\n1132\t\tupstreamURL := strings.TrimRight(a.BaseURL, \"/\") + r.URL.Path\n1133\t\tif r.URL.RawQuery != \"\" {\n1134\t\t\tupstreamURL += \"?\" + r.URL.RawQuery\n1135\t\t}\n1136\t\tlogger.Info(\"proxy\", \"[Turn %d] -> %s %s (alias=%s real_model=%s)\",\n1137\t\t\tturn, r.Method, upstreamURL, a.Name, a.Model)\n1138\t\tupstreamReq, err := http.NewRequest(r.Method, upstreamURL, bytes.NewReader(body))\n1139\t\tif err != nil {\n1140\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] alias %s build request error: %v\", turn, a.Name, err)\n1141\t\t\treturn false, 0\n1142\t\t}\n1143\t\tfor k, vals := range r.Header {\n1144\t\t\tif hopByHopHeaders[strings.ToLower(k)] {\n1145\t\t\t\tcontinue\n1146\t\t\t}\n1147\t\t\tfor _, v := range vals {\n1148\t\t\t\tupstreamReq.Header.Add(k, v)\n1149\t\t\t}\n1150\t\t}\n1151\t\tupstreamReq.Header.Del(\"Host\")\n1152\t\tapplyAliasAuth(upstreamReq.Header, a)\n1153\t\n1154\t\tresp, err := p.client.Do(upstreamReq)\n1155\t\tif err != nil {\n1156\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] alias %s connection error: %v\", turn, a.Name, err)\n1157\t\t\treturn false, 0\n1158\t\t}\n1159\t\tif shouldFallback(resp.StatusCode) {\n1160\t\t\tresp.Body.Close()\n1161\t\t\tlogger.Warn(\"proxy\", \"[Turn %d] alias %s returned %d, trying next\", turn, a.Name, resp.StatusCode)\n1162\t\t\treturn false, resp.StatusCode\n1163\t\t}\n1164\t\n1165\t\tlogger.Info(\"proxy\", \"[Turn %d] alias %s <- %d\", turn, a.Name, resp.StatusCode)\n1166\t\tdefer resp.Body.Close()\n1167\t\tp.dispatchResponse(w, resp, reqID, turn, r, parsed, t0, a.BaseURL)\n1168\t\treturn true, resp.StatusCode\n1169\t}\n1170\t\n1171\t// applyAliasAuth 按别名凭证与 provider 设置鉴权头（覆盖 Claude Code 自带的占位凭证）。\n1172\t// 决策 5：auth_token 优先于 api_key；provider 决定 api_key 走 x-api-key 还是 Bearer。\n1173\tfunc applyAliasAuth(h http.Header, a *Alias) {\n1174\t\th.Del(\"Authorization\")\n1175\t\th.Del(\"x-api-key\")\n1176\t\tswitch {\n1177\t\tcase a.AuthToken != \"\":\n1178\t\t\th.Set(\"Authorization\", \"Bearer \"+a.AuthToken)\n1179\t\tcase a.APIKey != \"\":\n1180\t\t\tif strings.EqualFold(a.Provider, \"openai\") || strings.EqualFold(a.Provider, \"gemini\") {\n1181\t\t\t\th.Set(\"Authorization\", \"Bearer \"+a.APIKey)\n1182\t\t\t} else {\n1183\t\t\t\th.Set(\"x-api-key\", a.APIKey)\n1184\t\t\t}\n1185\t\t}\n1186\t}\n1187\t\n1188\t// extractModel 从请求体解析 model 字段（即 Claude Code 发来的别名 name）。\n1189\tfunc extractModel(reqBody any) string {\n1190\t\tm, ok := reqBody.(map[string]any)\n1191\t\tif !ok {\n1192\t\t\treturn \"\"\n1193\t\t}\n1194\t\ts, _ := m[\"model\"].(string)\n1195\t\treturn s\n1196\t}\n1197\t\n1198\t// maskKey 脱敏凭证用于日志：保留前 4 后 4，过短则全掩。\n1199\tfunc maskKey(token, key string) string {\n1200\t\ts := token\n1201\t\tif s == \"\" {\n1202\t\t\ts = key\n1203\t\t}\n1204\t\tif s == \"\" {\n1205\t\t\treturn \"<none>\"\n1206\t\t}\n1207\t\tif len(s) <= 8 {\n1208\t\t\treturn strings.Repeat(\"*\", len(s))\n1209\t\t}\n1210\t\treturn s[:4] + \"...\" + s[len(s)-4:]\n1211\t}\n1212\t\n1213\t// SetKimiMode 启用或禁用 kimi 模式。\n1214\t// 启用时会自动创建 reasoning_content 缓存。\n1215\tfunc (p *ReverseProxy) SetKimiMode(kimi bool) {\n1216\t\tp.kimiMode = kimi\n1217\t\tif kimi && p.reasoningCache == nil {\n1218\t\t\tp.reasoningCache = NewReasoningCache()\n1219\t\t\tlogger.Info(\"proxy\", \"reasoning_content mode enabled (kimi/deepseek), caching active\")\n1220\t\t}\n1221\t}"}]}
